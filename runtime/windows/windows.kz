// The runtime's code for Windows (design record, section 2): the functions `runtime/common/` calls as
// `sys`, over the system's DLLs.

extern "C" in "kernel32" {
    void* GetStdHandle(uint which)
    int WriteFile(void* file, byte* bytes, uint count, uint* written, void* overlapped)
    void ExitProcess(uint code)
    void* VirtualAlloc(void* address, ulong size, uint type, uint protection)
    int VirtualFree(void* address, ulong size, uint type)
}

// The start of the process: Windows raises no signal at a write to a closed pipe, whose `WriteFile`
// returns the error itself.
pub void Start() {
}

// `count` bytes from `bytes` written to standard output (`fd` 1) or standard error (`fd` 2) in one
// call of `WriteFile`: the count written, or -1 where the system refused the write, and for any other
// `fd`, as Linux's `write` refuses a descriptor that is not open. One call takes at most the
// 4294967295 bytes a `uint` counts.
pub long Write(int fd, byte* bytes, long count) {
    if fd != 1 && fd != 2 {
        return -1
    }

    // STD_OUTPUT_HANDLE is the DWORD -11, STD_ERROR_HANDLE the DWORD -12
    mut uint which = 4294967285
    if fd == 2 {
        which = 4294967284
    }

    mut long chunk = count
    if chunk > 4294967295 {
        chunk = 4294967295
    }

    mut uint written = 0
    mut int done = 0
    raw {
        done = WriteFile(GetStdHandle(which), bytes, uint(chunk), &written, null)
    }

    if done == 0 {
        return -1
    }

    return long(written)
}

// The end of the process with the exit code, at once (design record, section 6). The code is 0 or
// above: `ExitProcess` takes a DWORD, and a negative `int` does not fit the `uint` it is converted to.
pub void Exit(int code) {
    raw {
        ExitProcess(uint(code))
    }
}

// `bytes` bytes of memory from the system, readable, writable and zeroed, by `VirtualAlloc`
// (`MEM_COMMIT | MEM_RESERVE` is 12288, `PAGE_READWRITE` 4): their address, or null where the system
// refuses.
pub byte* Memory(long bytes) {
    mut byte* p = null
    raw {
        p = Ptr<byte>(VirtualAlloc(null, ulong(bytes), 12288, 4))
    }

    return p
}

// Memory `Memory` gave, given back to the system by `VirtualFree`, which takes the whole of what one
// `VirtualAlloc` reserved (`MEM_RELEASE` is 32768, with the size 0); `bytes` is the size `Memory` was
// asked for, which the release does not need.
pub void Release(byte* p, long bytes) {
    raw {
        VirtualFree(Ptr<void>(p), 0, 32768)
    }
}

// Memory `Memory` gave, grown in place: not by this runtime on Windows, where a region `VirtualAlloc`
// reserved cannot grow, so null, and the allocator copies the block into a new one.
pub byte* Resize(byte* p, long bytes, long grown) {
    return null
}

// The trace of the calls below an error line (design record, section 6), which Windows reads through
// `dbghelp.dll` and the PDB: not written on Windows by this runtime, so the error line stands alone.
pub void Trace() {
}

// Marks the crash path as running, for the handler of a stack overflow (design record, section 6): no
// handler is installed on Windows by this runtime, so there is nothing to mark.
pub void Crashing() {
}
