// The runtime's code for Windows (design record, section 2): the functions `runtime/common/` calls as
// `sys`, over the system's DLLs.

extern "C" in "kernel32" {
    void* GetStdHandle(uint which)
    int WriteFile(void* file, byte* bytes, uint count, uint* written, void* overlapped)
    void ExitProcess(uint code)
    void* VirtualAlloc(void* address, ulong size, uint type, uint protection)
    int VirtualFree(void* address, ulong size, uint type)
    int SetThreadStackGuarantee(uint* size)
    void* LoadLibraryExA(byte* name, void* file, uint options)
    (extern "C" (byte*, ulong) => int)? GetProcAddress(void* module, byte* name)
    void GetSystemTimePreciseAsFileTime(long* time)
    int QueryPerformanceCounter(long* count)
    int QueryPerformanceFrequency(long* frequency)
    uint SleepEx(uint milliseconds, int alertable)
}

// The wait on a word and its wake, which Windows gives in `synchronization.lib`, as Rust's futex on Windows
// calls them (`library/std/src/sys/pal/windows/futex.rs`).
extern "C" in "synchronization" {
    int WaitOnAddress(void* address, void* compare, ulong size, uint milliseconds)
    void WakeByAddressSingle(void* address)
}

// The start of the process: Windows raises no signal at a write to a closed pipe, whose `WriteFile`
// returns the error itself. The main thread's stack takes a guarantee of 0x5000 bytes, the room the
// system keeps on it for the handling of its overflow, as Rust's standard library sets it at its start
// (design record, section 2); where the system refuses it the program carries on with the system's own
// room, as Rust's released library does. The arguments are not kept: the runtime of Windows gives no
// call that reads them (S11).
pub void Start(int count, byte* values) {
    mut uint room = 20480
    raw {
        SetThreadStackGuarantee(&room)
    }
}

// `Write` for `print` and `eprint` (A1, A17), as it is: a refused write is `print-failed` on Windows,
// where Linux counts a write that fails with `EBADF` as written (`WriteOut` of the Linux runtime;
// design record, section 12, the owner's answer of 2026-11-11, with Linux alone assumed there).
pub long WriteOut(int fd, byte* bytes, long count) {
    return Write(fd, bytes, count)
}

// `count` bytes from `bytes` written to standard output (`fd` 1) or standard error (`fd` 2) in one
// call of `WriteFile`: the count written, or -1 where the system refused the write, and for any other
// `fd`, as Linux's `write` refuses a descriptor that is not open. One call takes at most the
// 4294967295 bytes a `uint` counts.
pub long Write(int fd, byte* bytes, long count) {
    if fd != 1 && fd != 2 {
        return -1
    }

    // STD_OUTPUT_HANDLE is the DWORD -11, STD_ERROR_HANDLE the DWORD -12
    mut uint which = 4294967285
    if fd == 2 {
        which = 4294967284
    }

    mut long chunk = count
    if chunk > 4294967295 {
        chunk = 4294967295
    }

    mut uint written = 0
    mut int done = 0
    raw {
        done = WriteFile(GetStdHandle(which), bytes, uint(chunk), &written, null)
    }

    if done == 0 {
        return -1
    }

    return long(written)
}

// `count` bytes of the system's randomness at `bytes`, from `ProcessPrng` of `bcryptprimitives.dll`,
// as Rust's standard library takes the keys of a map's hash on Windows (`hashmap_random_keys` in
// `library/std/src/sys/pal/windows/rand.rs`, checked at the tag 1.82.0), and, as Rust does, without
// reading its result, which the system documents as always `TRUE` (M9; design record, section 4, the
// owner, 2026-10-30, "ProcessPrng, as Rust 1.82"). The system gives no import library for that DLL
// (Microsoft's page of `ProcessPrng` names the DLL and no library, checked 2026-10-30), so the
// function is found by its name, at each call, in the DLL loaded from the system's directory alone
// (`LOAD_LIBRARY_SEARCH_SYSTEM32` is 2048), as Go's runtime finds it (`runtime/os_windows.go`, checked
// at the tag go1.23.0), so that no file of that name beside the program is loaded in its place; a map
// asks for the keys once on each thread. Where the system, older than Windows 8 or Windows Server 2008 R2, the floor
// Microsoft's page of the function names, has no such function, the
// result is false, which the caller ends the program for, where a Rust program, which imports it, does
// not start.
pub bool Random(byte* bytes, long count) {
    string library = "bcryptprimitives.dll\0"
    string name = "ProcessPrng\0"
    raw {
        void* module = LoadLibraryExA(library.Pointer, null, 2048)
        if module == null {
            return false
        }

        (extern "C" (byte*, ulong) => int)? prng = GetProcAddress(module, name.Pointer)
        if prng == null {
            return false
        }

        prng(bytes, ulong(count))
    }

    return true
}

// The end of the process with the exit code, at once (design record, section 6). `ExitProcess` takes a
// DWORD: the code's 32 bits are passed on as one, read through a pointer so that no conversion checks
// them, and -1 ends with 4294967295, as Rust's `process::exit` passes its `i32` on as a `u32` (design
// record, section 12, assumed).
pub void Exit(int code) {
    int bits = code
    raw {
        ExitProcess(*Ptr<uint>(&bits))
    }
}

// `bytes` bytes of memory from the system, readable, writable and zeroed, by `VirtualAlloc`
// (`MEM_COMMIT | MEM_RESERVE` is 12288, `PAGE_READWRITE` 4): their address, or null where the system
// refuses.
pub byte* Memory(long bytes) {
    mut byte* p = null
    raw {
        p = Ptr<byte>(VirtualAlloc(null, ulong(bytes), 12288, 4))
    }

    return p
}

// Memory `Memory` gave, given back to the system by `VirtualFree`, which takes the whole of what one
// `VirtualAlloc` reserved (`MEM_RELEASE` is 32768, with the size 0); `bytes` is the size `Memory` was
// asked for, which the release does not need.
pub void Release(byte* p, long bytes) {
    raw {
        VirtualFree(Ptr<void>(p), 0, 32768)
    }
}

// Memory `Memory` gave, grown in place: not by this runtime on Windows, where a region `VirtualAlloc`
// reserved cannot grow, so null, and the allocator copies the block into a new one.
pub byte* Resize(byte* p, long bytes, long grown) {
    return null
}

// The system's page, 4 KiB on Windows on x86-64 and on 64-bit Arm.
pub long PageSize() => 4096

// An actor's stack of `size` bytes, laid out as the system lays out a fiber's (design record, section 2,
// round 17, "Fiber layout + guarantee"): reserved whole (`MEM_RESERVE` is 8192), its top page committed
// for reading and writing (`MEM_COMMIT` is 4096, `PAGE_READWRITE` 4) and the page below it the guard
// (`PAGE_READWRITE | PAGE_GUARD` is 260), so that the system commits it further from the reserve as it
// grows, as it grows a thread's; the four words of the thread environment block the switch sets for it
// in its save area, at 288 of its header, the 512 bytes at its base: the stack's base, its limit, the
// lowest page committed, the base of the reservation, which the system reads as the deallocation stack,
// and the guaranteed bytes, none until the stack first runs (`StackFirst`). The stack's base, its highest
// address, or null where the system refuses any of it.
pub byte* StackNew(long size) {
    raw {
        byte* low = Ptr<byte>(VirtualAlloc(null, ulong(size), 8192, 4))
        if low == null {
            return null
        }

        byte* top = low + size
        if VirtualAlloc(Ptr<void>(top - 4096), 4096, 4096, 4) == null || VirtualAlloc(Ptr<void>(top - 8192), 4096, 4096, 260) == null {
            VirtualFree(Ptr<void>(low), 0, 32768)
            return null
        }

        byte* side = top - 512
        *Ptr<byte*>(side + 288) = top
        *Ptr<byte*>(side + 296) = top - 4096
        *Ptr<byte*>(side + 304) = low
        *Ptr<long>(side + 312) = 0
        return top
    }
}

// The stack whose base is `top`, of `size` bytes, given back to the system, its whole reservation
// (`MEM_RELEASE` is 32768, with the size 0).
pub void StackFree(byte* top, long size) {
    raw {
        VirtualFree(Ptr<void>(top - size), 0, 32768)
    }
}

// The bounds of a stack's guard for a handler of a fault, set at each switch on Linux: none on Windows,
// where the system grows a stack through its `PAGE_GUARD` page and this runtime installs no handler.
pub void StackGuard(byte* top, long size) {
}

// The trim of the stack whose base is `top`, of `size` bytes, as it goes back to the pool, where the
// stack limit the switch saved with it, at 296 of its header, lies past the depth of 64 KiB, so that a
// message went past it (design record, section 6, the owner, 2026-11-13, #519, comment 6853074601): the
// pages below the depth decommitted (`MEM_DECOMMIT` is 16384) from the base of the reservation, at 304,
// which leaves them reserved, the page under the depth committed again as the guard page through which
// the system grows the stack (`PAGE_READWRITE | PAGE_GUARD` is 260), and the saved limit set to the depth,
// as Microsoft's C runtime puts a stack's guard page back with `_resetstkoflw` (section 6, assumed there).
pub void StackTrim(byte* top, long size) {
    raw {
        byte* edge = top - 65536
        if long(*Ptr<byte*>(top - 512 + 296)) < long(edge) {
            byte* low = *Ptr<byte*>(top - 512 + 304)
            VirtualFree(Ptr<void>(low), ulong(long(edge) - 4096 - long(low)), 16384)
            VirtualAlloc(Ptr<void>(edge - 4096), 4096, 4096, 260)
            *Ptr<byte*>(top - 512 + 296) = edge
        }
    }
}

// The target's first act on an actor's stack, on the stack itself once the switch set the thread
// environment block's words for it: the guarantee of 0x5000 bytes, the room the system keeps on it for
// the handling of its overflow, as `Start` sets it for the main thread's stack and Rust's standard
// library for every thread it starts, which the guaranteed bytes keep with the stack from then on (round
// 17, "Fiber layout + guarantee"); where the system refuses it the message runs with the system's own
// room, as the main thread does.
pub void StackFirst() {
    mut uint room = 20480
    raw {
        SetThreadStackGuarantee(&room)
    }
}

// The trace of the calls below an error line (design record, section 6), which Windows reads through
// `dbghelp.dll` and the PDB: not written on Windows by this runtime, so the error line stands alone.
pub void Trace() {
}

// Marks the crash path as running, for the handler of a stack overflow (design record, section 6): no
// handler is installed on Windows by this runtime, so there is nothing to mark.
pub void Crashing() {
}

// The time of the system's clock in nanoseconds since 1970, put in `nanoseconds`, for the log line of an
// actor's crash (U24): `GetSystemTimePreciseAsFileTime`, which counts 100 ns from 1601, as Rust's
// `SystemTime::now` reads it on Windows; true.
pub bool Now(mut long nanoseconds) {
    mut long time = 0
    raw {
        GetSystemTimePreciseAsFileTime(&time)
        nanoseconds = (time - 116444736000000000) * 100
    }

    return true
}

// Whether the page each thread of Linux reads its clock into is mapped (`WorkerMain`; issue 673, comment 7236862307, Q2): true,
// since Windows reads its clocks into no page of the thread (`MonotonicNow`).
pub bool StatusMapped() => true

// The monotonic clock in nanoseconds, put in `nanoseconds`, which a restart's pause reads (U23):
// `QueryPerformanceCounter` over `QueryPerformanceFrequency`, as Rust's `Instant::now` reads it on
// Windows; false where the system refuses either.
pub bool MonotonicNow(mut long nanoseconds) {
    mut long count = 0
    mut long frequency = 0
    raw {
        if QueryPerformanceCounter(&count) == 0 || QueryPerformanceFrequency(&frequency) == 0 || frequency <= 0 {
            return false
        }

        nanoseconds = count / frequency * 1000000000 + count % frequency * 1000000000 / frequency
    }

    return true
}

// `nanoseconds` slept, by `SleepEx`, in milliseconds rounded up (the top-level code's wait for the end of a
// restart's pause, U23).
pub void Sleep(long nanoseconds) {
    if nanoseconds <= 0 {
        return
    }

    raw {
        SleepEx(uint((nanoseconds + 999999) / 1000000), 0)
    }
}

// The poller of `runtime/common/` on Windows, where a build makes no call on a socket (S11), so that no call waits in the
// poller (issue 658): no waiter is kept, no registration is made, `ReadyNow` finds nothing ready, and the scheduler's wait
// never reaches `PollWait`, since the count of registrations stays 0; the byte of an event's data is none.
pub void Waiter(extern "C" (int, int, long) => int wait) {
}

pub long PollAdd(int fd, int events, long dataAt) => -4099

pub int ReadyNow(int fd, int events) => 0

pub void PollRemove(int fd) {
}

pub long PollWait(long nanoseconds, byte* ready, long count, long dataAt) => 0

pub long EpollDataAt() => 0

// The cores the process may use of `runtime/common/` on Windows (U35), where a build reads no `KURZ_THREADS`, so that nothing
// asks for them (`ThreadsRead`): 1.
pub int Cores() => 1

// The hint of a spin's wait of `runtime/common/` on Windows, where no worker thread spins, since none starts (U35): nothing.
pub void SpinHint() {
}

// The worker threads of `runtime/common/` on Windows, where a build reads no `KURZ_THREADS` and every actor runs on the main thread
// (U35, `compiler/README.md`), so that nothing starts one: no thread is started, no `eventfd` made and no thread woken.
pub long ThreadNew(extern "C" (byte*) => byte* entry, byte* argument) => -38

pub void ThreadStart() {
}

pub long EventNew() => -38

pub void EventSignal(long fd) {
}

pub void EventDrain(long fd) {
}

// The pool of threads for blocking calls of `runtime/common/` on Windows, where a build makes no call on a file (S11), so that no
// call is handed to it (issue 661): no waiter is kept, no pool is made and no job is done.
pub void BlockingWaiter(extern "C" (byte*) => long wait, extern "C" () => int offloads) {
}

pub void ManyWaiter(extern "C" (int*, int, long, byte*) => int wait) {
}

pub long PoolEvent() => -4099

pub int* PoolFlag() => null

pub long Submit(byte* job) => -4099

pub byte* PoolDone() => null

pub long PoolHeld() => -1

pub void JobDropped(byte* job) {
}

pub void ChildDropped(byte* record) {
}

// The bound of a call that waits where no `within` names another, 5 seconds in nanoseconds (U36), the value
// Linux's runtime gives its sockets and its calls, which a test holds equal.
pub long DefaultBound() => 5000000000

// The function of the runtime that takes the crash of an actor whose stack overflowed (U19), which no
// handler calls on Windows: an actor's overflow ends the process there, as the system ends it
// (compiler/README.md, "What the emitter does not emit").
pub void Overflowed(extern "C" (byte*, long) => void handler) {
}

// The count of the entries under way into the allocator and the scheduler on the thread, kept as on Linux
// (design record, section 6, "End the process"; O11), which no handler reads on Windows, where an actor's
// overflow ends the process as any overflow does.
thread static mut long inside = 0

// An entry into the allocator or the scheduler begun: the count of the entries under way raised.
pub void Entered() {
    raw {
        inside = inside + 1
    }
}

// An entry into the allocator or the scheduler ended: the count of the entries under way lowered.
pub void Left() {
    raw {
        inside = inside - 1
    }
}

// The count of the entries under way into the allocator and the scheduler set to `count` from now on: the
// count before, which the side of a switch puts back when the thread comes back to it.
pub long Inside(long count) {
    mut long before = 0
    raw {
        before = inside
        inside = count
    }

    return before
}

// The thread put to sleep while the lock word at `word` holds `expected`, by `WaitOnAddress` with no time limit
// (`INFINITE`), as Rust's `futex_wait` waits on Windows: 1 where it returned with no failure, the word already
// other than `expected` or a wake come, spurious or not, 0 where it failed, which the caller does not read, since
// it tries the lock again after every return (`Lock`).
pub long LockWait(int* word, int expected) {
    mut int compare = expected
    mut long result = 0
    raw {
        result = long(WaitOnAddress(Ptr<void>(word), Ptr<void>(&compare), 4, uint(4294967295)))
    }

    return result
}

// One thread that sleeps on the lock word at `word` woken, by `WakeByAddressSingle`, as Rust's `futex_wake`
// wakes one on Windows: 0 (`Unlock`).
pub long LockWake(int* word) {
    raw {
        WakeByAddressSingle(Ptr<void>(word))
    }

    return 0
}
