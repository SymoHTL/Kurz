// The runtime's code for Linux (design record, section 2): the functions `runtime/common/` calls as
// `sys`, and the calls on files and sockets a program makes (section 12), over the C library, which a program
// built for Linux links as the platform links it. It is the code of 64-bit Linux, where C's `size_t`
// and `ssize_t` are 64 bits as `long` is: the compiler builds for a 64-bit machine alone
// (compiler/README.md, "The runtime").

extern "C" {
    long write(int fd, byte* bytes, long count)
    void _exit(int status)
    void* mmap(void* address, long length, int protection, int options, int fd, long offset)
    int munmap(void* address, long length)
    void* mremap(void* address, long length, long grown, int options, ...)
    void* signal(int number, void* handler)
    int* __errno_location()
    int open(byte* path, int mode, ...)
    long pread(int fd, byte* bytes, long count, long offset)
    byte* getenv(byte* name)
    ulong getauxval(ulong type)
    int mprotect(void* address, long length, int protection)
    int sigaction(int number, void* action, void* old)
    int sigaltstack(void* stack, void* old)
    ulong pthread_self()
    int pthread_getattr_np(ulong thread, void* attributes)
    int pthread_attr_getstack(void* attributes, long* address, long* size)
    int pthread_attr_destroy(void* attributes)
    long read(int fd, byte* bytes, long count)
    int close(int fd)
    int unlink(byte* path)
    int rename(byte* from, byte* to)
    int mkdir(byte* path, int mode)
    int rmdir(byte* path)
    int stat(byte* path, void* status)
    void* opendir(byte* path)
    void* readdir(void* directory)
    int closedir(void* directory)
    long strlen(byte* text)
    int socket(int family, int type, int protocol)
    int setsockopt(int fd, int level, int name, void* value, int length)
    int bind(int fd, void* address, int length)
    int listen(int fd, int backlog)
    int getsockname(int fd, void* address, int* length)
    int connect(int fd, void* address, int length)
    int accept4(int fd, void* address, int* length, int options)
    int inet_pton(int family, byte* text, void* address)
    int getaddrinfo(byte* host, byte* service, void* hints, void* list)
    void freeaddrinfo(void* list)
}

// The platform's unwinder, libgcc_s's, which the trace walks the stack with (design record, section 6),
// linked as Rust's standard library links it on Linux with the GNU C library.
extern "C" in "gcc_s" {
    int _Unwind_Backtrace(extern "C" (void*, void*) => int trace, void* argument)
    ulong _Unwind_GetIPInfo(void* context, int* before)
}

// The start of the process: the signal of a closed pipe, `SIGPIPE` (13), set to ignored, so that a
// write to a closed pipe returns an error, which `print` raises as `print-failed` (design record,
// section 6); `SIG_IGN` is the handler 1. Then the handler of a fault, `Faults`.
pub void Start() {
    raw {
        signal(13, Ptr<void>(1))
        Faults()
    }
}

// `count` bytes from `bytes` written to the file descriptor `fd` by `write`, called again where a
// signal interrupted it (`EINTR`, 4), which is no error: the count written, or -1 where the system
// refused the write.
pub long Write(int fd, byte* bytes, long count) {
    mut long written = -1
    raw {
        int* error = __errno_location()
        written = write(fd, bytes, count)
        while written < 0 && *error == 4 {
            written = write(fd, bytes, count)
        }
    }

    return written
}

// `bytes` bytes of memory from the system, readable, writable and zeroed, by `mmap` (`PROT_READ |
// PROT_WRITE` is 3, `MAP_PRIVATE | MAP_ANONYMOUS` is 34): their address, or null where the system
// refuses (`MAP_FAILED`, the address -1).
pub byte* Memory(long bytes) {
    mut byte* p = null
    raw {
        void* got = mmap(null, bytes, 3, 34, -1, 0)
        if long(got) != -1 {
            p = Ptr<byte>(got)
        }
    }

    return p
}

// Memory `Memory` gave, `bytes` bytes of it from its start, given back to the system by `munmap`.
pub void Release(byte* p, long bytes) {
    raw {
        munmap(Ptr<void>(p), bytes)
    }
}

// Memory `Memory` gave, `bytes` bytes of it from its start, grown to `grown` bytes with what it holds
// by `mremap` (`MREMAP_MAYMOVE` is 1), which moves its pages to other addresses where the ones after it
// are taken, and copies none of them: its address, or null where the system refuses
// (`MAP_FAILED`), the memory then left as it was.
pub byte* Resize(byte* p, long bytes, long grown) {
    mut byte* q = null
    raw {
        void* got = mremap(Ptr<void>(p), bytes, grown, 1)
        if long(got) != -1 {
            q = Ptr<byte>(got)
        }
    }

    return q
}

// The end of the process with the exit code, at once: `_exit` runs no handler of the C library
// (design record, section 6).
pub void Exit(int code) {
    raw {
        _exit(code)
    }
}

// ---- the trace of the calls (design record, section 6) ---------------------------------------------

// The trace's state on its thread: two pages from the system, the first a window on the executable's
// file at `windowAt`, `windowHeld` bytes of it, the second the calls inlined at one frame; the file;
// whether a read of the file failed, and whether the debug information holds a form this reader does
// not know; the frames counted, and whether the trace reached `main`, the actor's entry, or a write
// failed; and whether the trace runs, so that a raise inside it writes no second one.
thread static mut byte* page = null
thread static mut long windowAt = 0
thread static mut long windowHeld = 0
thread static mut int image = -1
thread static mut bool readable = false
thread static mut bool broken = false
thread static mut bool lost = false
thread static mut long frames = 0
thread static mut bool ended = false
thread static mut bool failed = false
thread static mut bool tracing = false

// The handler's state on its thread: the guard page of the thread's stack, from `guardLow` up to
// `guardHigh`; whether the thread's crash path runs; where the walk of a stack overflow stands, 1 while
// it passes the handler's frames and the signal's, 2 while it looks for the frame that holds the line,
// and 0 from that frame on; and whether `KURZ_TRACE=0` switched the trace off.
thread static mut long guardLow = 0
thread static mut long guardHigh = 0
thread static mut bool crashing = false
thread static mut int seeking = 0
thread static mut bool quiet = false

// Where the sections the trace reads lie in the file, 0 for one the file lacks: the symbols and their
// names, the line tables and their names, the debug information and the tables it refers to; and what
// the system added to every address of the file where it loaded the program.
thread static mut long symbols = 0
thread static mut long symbolsEnd = 0
thread static mut long symbolNames = 0
thread static mut long lines = 0
thread static mut long linesEnd = 0
thread static mut long lineNames = 0
thread static mut long info = 0
thread static mut long infoEnd = 0
thread static mut long abbreviations = 0
thread static mut long strings = 0
thread static mut long stringOffsets = 0
thread static mut long addresses = 0
thread static mut long rangeLists = 0
thread static mut long bias = 0

// What the reads found: the row of the line tables at an address, its unit, its file and its line; the
// bases of the unit of the debug information last read, its first address and its line tables' unit;
// and the attributes of its entry last read, each -1 where the entry has none.
thread static mut long foundUnit = 0
thread static mut long foundFile = 0
thread static mut long foundLine = 0
thread static mut long stringBase = 0
thread static mut long addressBase = 0
thread static mut long rangeBase = 0
thread static mut long unitLow = 0
thread static mut long unitLines = 0
thread static mut long lowForm = -1
thread static mut long low = 0
thread static mut long highForm = -1
thread static mut long high = 0
thread static mut long rangesForm = -1
thread static mut long ranges = 0
thread static mut long origin = -1
thread static mut long originForm = -1
thread static mut long callFile = -1
thread static mut long callLine = -1
thread static mut long nameForm = -1
thread static mut long name = 0
thread static mut long stringsAttribute = -1
thread static mut long addressesAttribute = -1
thread static mut long rangesAttribute = -1
thread static mut long linesAttribute = -1

// The trace of the calls below the error line of an exception that ends the process (design record,
// section 6), on standard error, from the frame that raised to `main`, innermost first, the runtime's
// frames left out: `  at <function> in <file>:<n>`, `  at <function>` where the line tables hold no
// line there, and `  at <unknown> (0x55d2a8c5b2e4)` where the executable's file cannot be read or names
// no function there; a hundred frames, and a line that counts the rest, `  ... 12 more frames`. The
// walk, by the platform's unwinder, and the reads of the file run on the stack that raised (the owner,
// 2026-10-29, "Where it raised, as Rust"), through the two pages, from the system and not from the
// allocator. `KURZ_TRACE=0` switches it off, and a line whose write fails ends it.
pub void Trace() {
    raw {
        if tracing || Off() {
            return
        }

        tracing = true
        readable = Open()
        _Unwind_Backtrace(OnFrame, null)
        Cut()
    }
}

// The line that counts the frames past the hundredth (the owner, 2026-10-29), `  ... 12 more frames`,
// and `  ... 1 more frame` for one.
void Cut() {
    raw {
        if frames > 100 {
            long more = frames - 100
            Out("  ... ")
            Number(more)
            if more == 1 {
                Out(" more frame\n")
            } else {
                Out(" more frames\n")
            }
        }
    }
}

// Marks the thread's crash path as running, at the start of a raise (design record, section 6), so
// that a fault in the guard page while it runs ends the process with no second error line.
pub void Crashing() {
    raw {
        crashing = true
    }
}

// The handler of a fault and the stack it runs on, for the main thread, as Rust's standard library
// installs its own (checked 2026-10-30: `install_main_guard_linux` and `signal_handler` in Rust 1.82's
// `library/std/src/sys/pal/unix/stack_overflow.rs`). The guard page is the page below the lowest address
// the main thread's stack may grow to, which `pthread_getattr_np` gives, where the system refuses to
// grow it further. The handler's stack is 64 KiB from the system, with a page below it that faults, so
// that an overflow of the handler's own stack ends the process. The handler takes `SIGSEGV` (11) and
// `SIGBUS` (7) on that stack (`SA_ONSTACK`), with the fault's details (`SA_SIGINFO`), and with the
// signal not blocked while it runs (`SA_NODEFER`), since it never returns through the signal's frame
// (design record, section 6). Where any of it cannot be had, no handler is installed, and a stack
// overflow ends the process as the system ends it.
void Faults() {
    raw {
        // `AT_PAGESZ`
        long size = long(getauxval(6))
        void* got = mmap(null, size + 65536 + size, 3, 34, -1, 0)
        if long(got) == -1 || size <= 0 {
            return
        }

        // the handler's stack after its guard page, then a page for the structures handed to the system
        byte* block = Ptr<byte>(got)
        byte* scratch = block + size + 65536
        if pthread_getattr_np(pthread_self(), Ptr<void>(scratch)) != 0 {
            return
        }

        long* lowest = Ptr<long>(scratch + 512)
        long* extent = Ptr<long>(scratch + 520)
        int found = pthread_attr_getstack(Ptr<void>(scratch), lowest, extent)
        pthread_attr_destroy(Ptr<void>(scratch))
        // `PROT_NONE`
        if found != 0 || mprotect(got, size, 0) != 0 {
            return
        }

        // the lowest address rounded up to a page, as Rust's standard library rounds it
        mut long top = *lowest
        if top % size != 0 {
            top = top + size - top % size
        }

        guardLow = top - size
        guardHigh = top

        // `stack_t`: the stack's address, its flags and its size
        *Ptr<long>(scratch + 64) = long(block + size)
        *Ptr<int>(scratch + 72) = 0
        *Ptr<long>(scratch + 80) = 65536
        // `struct sigaction`: the handler, the mask of the signals blocked while it runs, empty, and the
        // flags, `SA_SIGINFO` (4) | `SA_ONSTACK` (0x08000000) | `SA_NODEFER` (0x40000000)
        *Ptr<extern "C" (int, void*, void*) => void>(scratch + 128) = OnFault
        *Ptr<int>(scratch + 264) = 1207959556
        if sigaltstack(Ptr<void>(scratch + 64), null) == 0 {
            sigaction(11, Ptr<void>(scratch + 128), null)
            sigaction(7, Ptr<void>(scratch + 128), null)
        }
    }
}

// The handler of a fault (design record, section 6), on its own stack. A fault whose address is
// outside the guard page is not the handler's: it sets the signal's default action back and returns,
// so that the instruction faults again and the system ends the process, as Rust's handler does (the
// owner, 2026-10-29, "Guard page first, as Rust"). A fault in the guard page while the thread's crash
// path runs, a walk of a raise that overflowed among it, ends the process with the exit code 1 of the
// error line and no second trace; any other is a stack overflow of the top-level code, the root actor,
// whose error line and trace `Overflow` writes before the process ends with the exit code 1.
extern "C" void OnFault(int number, void* details, void* context) {
    raw {
        // `si_addr` of `siginfo_t`
        long address = *Ptr<long>(Ptr<byte>(details) + 16)
        if address < guardLow || address >= guardHigh {
            signal(number, null)
            return
        }

        if !crashing {
            crashing = true
            Overflow()
        }

        _exit(1)
    }
}

// The error line and the trace of a stack overflow (design record, section 6), from the fault, on the
// handler's stack. The walk passes the handler's frames and the signal's to the frame the fault
// interrupted. Where the instruction that faulted is a call, whose push of its return address met the
// guard page, that frame holds the line, the call's own; otherwise the fault came in the prologue of the
// frame that did not fit, and the frame below it holds the line, at its return address less one. Where
// that frame is the runtime's, a helper's or the C library's, the innermost frame outside them holds it
// ("Caller outside runtime"). The trace starts at the frame that holds the line.
void Overflow() {
    raw {
        tracing = true
        quiet = Off()
        readable = Open()
        seeking = 1
        _Unwind_Backtrace(OnFrame, null)
        if seeking != 0 {
            Out("error: stack-overflow (no line: the stack could not be walked)\n")
            return
        }

        Cut()
    }
}

// Whether the instruction at `ip`, in the program's code, is a call: `E8` with a 32-bit offset, or `FF`
// with 2 in the register field of the byte after it, after an optional REX prefix (`40` to `4F`), the
// forms of a call on x86-64.
bool IsCall(long ip) {
    raw {
        byte* code = Ptr<byte>(ip)
        mut long i = 0
        if long(code[0]) >= 64 && long(code[0]) <= 79 {
            i = 1
        }

        mut bool call = long(code[i]) == 232
        if long(code[i]) == 255 {
            call = long(code[i + 1]) / 8 % 8 == 2
        }

        return call
    }
}

// Whether the frame at `at` holds the line of a stack overflow: a frame of the program or of the
// standard library does, one of the runtime, of the emitted code's helpers or of the C library is
// passed, and where the file cannot be read or names no function the first frame does. For that frame
// it writes the error line, `error: stack-overflow at <file>:<n>`, or with the note that stands in
// place of the place, the first that holds of the file's, the tables' and the frame's entry's (design
// record, section 6).
bool Located(long at) {
    raw {
        if readable && symbols > 0 {
            long symbol = FunctionAt(at)
            if symbol < 0 || KindOf(symbol) == 0 {
                return false
            }
        }

        Out("error: stack-overflow")
        mut long title = -1
        if readable && lines > 0 && LineAt(at) {
            title = FileAt(foundUnit, foundFile)
        }

        if !readable {
            Out(" (no line: the tables could not be read)\n")
        } else if lines == 0 {
            Out(" (no line tables: build with --lines)\n")
        } else if title < 0 {
            Out(" (no line: the frame has no entry in the tables)\n")
        } else {
            Out(" at ")
            FileBytes(title, End(title))
            Out(":")
            Number(foundLine)
            Out("\n")
        }

        return true
    }
}

// Whether `KURZ_TRACE` is `0`, read from the environment when the trace is written and never before
// (design record, section 6): every other value, the empty one among them, and its absence leave the
// trace on.
bool Off() {
    raw {
        string variable = "KURZ_TRACE\0"
        mut bool off = false
        byte* value = getenv(variable.Pointer)
        if value != null {
            off = value[0] == 48 && value[1] == 0
        }

        return off
    }
}

// Takes three pages from the system, opens the executable's file, `/proc/self/exe`, where Rust's
// backtrace finds it too, and reads where its sections lie and where the system loaded it: false where
// the pages, the file or its headers cannot be had, or the file is no 64-bit little-endian ELF file.
bool Open() {
    raw {
        void* got = mmap(null, 12288, 3, 34, -1, 0)
        if long(got) != -1 {
            page = Ptr<byte>(got)
        }

        if page == null {
            return false
        }

        string path = "/proc/self/exe\0"
        // O_RDONLY | O_CLOEXEC
        image = open(path.Pointer, 524288)

        if image < 0 || Read(0, 4) != 1179403647 || ByteAt(4) != 2 || ByteAt(5) != 1 {
            return false
        }

        long sections = Read(40, 8)
        long size = Read(58, 2)
        long count = Read(60, 2)
        long sectionNames = Read(sections + Read(62, 2) * size + 24, 8)
        mut long i = 0
        while i < count && !broken {
            long at = sections + i * size
            long kind = Read(at + 4, 4)
            long title = sectionNames + Read(at, 4)
            long offset = Read(at + 24, 8)
            long end = offset + Read(at + 32, 8)
            if kind == 2 {
                symbols = offset
                symbolsEnd = end
                symbolNames = Read(sections + Read(at + 40, 4) * size + 24, 8)
            } else if Starts(title, ".debug_line\0") {
                lines = offset
                linesEnd = end
            } else if Starts(title, ".debug_line_str\0") {
                lineNames = offset
            } else if Starts(title, ".debug_info\0") {
                info = offset
                infoEnd = end
            } else if Starts(title, ".debug_abbrev\0") {
                abbreviations = offset
            } else if Starts(title, ".debug_str\0") {
                strings = offset
            } else if Starts(title, ".debug_str_offsets\0") {
                stringOffsets = offset
            } else if Starts(title, ".debug_addr\0") {
                addresses = offset
            } else if Starts(title, ".debug_rnglists\0") {
                rangeLists = offset
            }

            i = i + 1
        }

        // where the system put the program's headers (`AT_PHDR`, 3) less where the file places them: the
        // header of the headers (`PT_PHDR`, 6), or the loaded part of the file that holds them (`PT_LOAD`, 1)
        long headers = Read(32, 8)
        long headerSize = Read(54, 2)
        long headerCount = Read(56, 2)
        mut long placed = -1
        mut long j = 0
        while j < headerCount && !broken {
            long at = headers + j * headerSize
            long kind = Read(at, 4)
            long offset = Read(at + 8, 8)
            if kind == 6 {
                placed = Read(at + 16, 8)
            } else if kind == 1 && placed < 0 && offset <= headers && headers < offset + Read(at + 32, 8) {
                placed = Read(at + 16, 8) + headers - offset
            }

            j = j + 1
        }

        if placed < 0 || broken {
            return false
        }

        bias = long(getauxval(3)) - placed

        return true
    }
}

// One frame of the walk, as the unwinder hands it over: its address, which is the return address, or
// the address of the instruction itself where the unwinder says so, and whose line is looked up at
// the call, the return address less one, as unwinders look a return address up (design record,
// section 6); the walk ends at `main`, at a write that failed, and where the unwinder has no frame.
extern "C" int OnFrame(void* context, void* argument) {
    raw {
        mut int before = 0
        mut long ip = 0
        ip = long(_Unwind_GetIPInfo(context, &before))

        if ip == 0 {
            return 1
        }

        mut long at = ip
        if before == 0 {
            at = at - 1
        }

        // a stack overflow's walk: the frame the fault interrupted is the first whose address is the
        // instruction's own, and where that instruction is no call, the frame did not fit and is passed
        if seeking == 1 {
            if before == 0 {
                return 0
            }

            seeking = 2
            if !IsCall(ip) {
                return 0
            }
        }

        if seeking == 2 {
            if !Located(at - bias) {
                return 0
            }

            seeking = 0
            if quiet || failed {
                return 1
            }
        }

        Frame(ip, at - bias)
        if ended || failed {
            return 1
        }

        return 0
    }
}

// The lines of one frame: none for a frame of the runtime, of the emitted code's helpers or of the C
// library's start; one for a frame of the program or of the standard library, named by its symbol,
// and before it one for each call inlined there, named by the debug information, innermost first (the
// owner, 2026-10-29, "As Rust: a frame each"), each with the line of its call in the frame outside it;
// `  at <unknown> (0x...)` with the return address where the file cannot be read or names no function
// there (the owner, 2026-10-29). The frame of `main`, the actor's entry, is the last.
void Frame(long ip, long at) {
    raw {
        if frames >= 100 {
            Count(at)
            return
        }

        mut long symbol = -1
        if readable {
            symbol = FunctionAt(at)
        }

        if symbol < 0 {
            if Counted() {
                Out("  at <unknown> (")
                Hex(ip)
                Out(")\n")
            }

            return
        }

        long kind = KindOf(symbol)
        if kind == 0 {
            return
        }

        if kind == 2 {
            ended = true
        }

        long depth = Inlined(at)
        mut bool known = LineAt(at)
        mut long unit = foundUnit
        mut long file = foundFile
        mut long line = foundLine
        mut long k = depth - 1
        while k >= 0 {
            long label = NameOf(Chained(k, 0), Chained(k, 1))
            if label >= 0 && !Starts(label, "rt.") && Counted() {
                Out("  at ")
                FileBytes(label, End(label))
                Place(known, unit, file, line)
            }

            unit = unitLines
            file = Chained(k, 2)
            line = Chained(k, 3)
            known = file >= 0 && line > 0
            k = k - 1
        }

        if Counted() {
            Out("  at ")
            Shown(symbol)
            Place(known, unit, file, line)
        }
    }
}

// A frame past the hundredth line of the trace, counted and not written: the lines it takes, one for
// each call inlined at it that the trace shows and one of its own, none for a frame the trace leaves
// out, kept in the third page in a table of 251 slots chosen by the address's remainder by 251, where
// two addresses whose difference is a multiple of 251 take turns, so that a recursion, whose frames
// repeat a few return addresses, reads the file one time per address on the walk that counts the rest.
// Where `Open` could not map the pages, no table is kept, and the file is not readable either, so that
// each frame counts one line.
void Count(long at) {
    raw {
        mut long* table = null
        if page != null {
            table = Ptr<long>(page + 8192)
        }

        long slot = at % 251 * 2
        // the lines times 4, plus the kind of `KindOf`, plus 1; 0 for an address not counted
        mut long known = 0
        if table != null && table[slot] == at {
            known = table[slot + 1]
        }

        if known == 0 {
            mut long symbol = -1
            if readable {
                symbol = FunctionAt(at)
            }

            mut long kind = 1
            mut long count = 1
            if symbol >= 0 {
                kind = KindOf(symbol)
                if kind == 0 {
                    count = 0
                } else {
                    long depth = Inlined(at)
                    mut long k = 0
                    while k < depth {
                        long label = NameOf(Chained(k, 0), Chained(k, 1))
                        if label >= 0 && !Starts(label, "rt.") {
                            count = count + 1
                        }

                        k = k + 1
                    }
                }
            }

            known = count * 4 + kind + 1
            if table != null {
                table[slot] = at
                table[slot + 1] = known
            }
        }

        frames = frames + (known - 1) / 4
        if (known - 1) % 4 == 2 {
            ended = true
        }
    }
}

// Counts a line of the trace: whether it is one of the first hundred, which are written.
bool Counted() {
    raw {
        frames = frames + 1
        return frames <= 100 && !failed
    }
}

// The end of a frame's line: ` in <file>:<n>` where the line is known, and the line feed.
void Place(bool known, long unit, long file, long line) {
    raw {
        if known {
            long title = FileAt(unit, file)
            if title >= 0 {
                Out(" in ")
                FileBytes(title, End(title))
                Out(":")
                Number(line)
            }
        }

        Out("\n")
    }
}

// What the symbol whose name is at `symbol` names: 1 a function of the program or of the standard
// library, whose symbol starts with `f.` or `std.`, 2 the top-level code, `kz.main`, and 0 the
// runtime's (`rt.`), the emitted code's helpers and the C library's start, which the trace leaves out.
long KindOf(long symbol) {
    raw {
        if Starts(symbol, "kz.main\0") {
            return 2
        }

        if Starts(symbol, "f.") || Starts(symbol, "std.") {
            return 1
        }

        return 0
    }
}

// The name a trace shows for a function of the program or of the standard library: its symbol without
// the part up to its first `.` and without the numbers that make it unique, `f.Max<int>.8` as
// `Max<int>` and `f.Twice.lambda.3.1` as `Twice.lambda`, and `main` for `kz.main` (design record,
// section 6).
void Shown(long symbol) {
    raw {
        if Starts(symbol, "kz.main\0") {
            Out("main")
            return
        }

        mut long from = symbol
        while ByteAt(from) > 0 && ByteAt(from) != 46 {
            from = from + 1
        }

        from = from + 1
        mut long to = End(from)
        mut bool cut = true
        while cut {
            cut = false
            mut long i = to - 1
            while i > from && ByteAt(i) >= 48 && ByteAt(i) <= 57 {
                i = i - 1
            }

            if i < to - 1 && i > from && ByteAt(i) == 46 {
                to = i
                cut = true
            }
        }

        FileBytes(from, to)
    }
}

// The name's place of the function whose code holds `at`, by the symbols of the file, a function's
// symbol being of the type `STT_FUNC` (2): -1 where none holds it.
long FunctionAt(long at) {
    raw {
        mut long p = symbols
        while p > 0 && p + 24 <= symbolsEnd && !broken {
            if (ByteAt(p + 4) & 15) == 2 {
                long start = Read(p + 8, 8)
                if at >= start && at < start + Read(p + 16, 8) {
                    return symbolNames + Read(p, 4)
                }
            }

            p = p + 24
        }

        return -1
    }
}

// ---- the line tables (DWARF 5, as the compiler writes them) ----------------------------------------

// The row of the line tables whose addresses hold `at`: true, with `foundUnit`, `foundFile` and
// `foundLine`, where a row of a line above 0 holds it.
bool LineAt(long at) {
    raw {
        mut long unit = lines
        while unit > 0 && unit + 4 <= linesEnd && !broken {
            long length = Read(unit, 4)
            if length >= 4294967280 {
                return false
            }

            long end = unit + 4 + length
            long minimum = ByteAt(unit + 12)
            mut long lineBase = ByteAt(unit + 15)
            if lineBase > 127 {
                lineBase = lineBase - 256
            }

            long lineRange = ByteAt(unit + 16)
            long opcodeBase = ByteAt(unit + 17)
            if Read(unit + 4, 2) == 5 && lineRange > 0 {
                mut long p = unit + 12 + Read(unit + 8, 4)
                mut long address = 0
                mut long file = 1
                mut long line = 1
                mut bool have = false
                mut long lastAddress = 0
                mut long lastFile = 0
                mut long lastLine = 0
                while p < end && !broken {
                    long op = Take(mut p, 1)
                    mut bool row = false
                    mut bool last = false
                    if op >= opcodeBase {
                        long step = op - opcodeBase
                        address = address + step / lineRange * minimum
                        line = line + lineBase + step % lineRange
                        row = true
                    } else if op == 0 {
                        long size = Uleb(mut p)
                        long next = p + size
                        long sub = ByteAt(p)
                        if sub == 1 {
                            row = true
                            last = true
                        } else if sub == 2 {
                            address = Read(p + 1, 8)
                        }

                        p = next
                    } else if op == 1 {
                        row = true
                    } else if op == 2 {
                        address = address + Uleb(mut p) * minimum
                    } else if op == 3 {
                        line = line + Sleb(mut p)
                    } else if op == 4 {
                        file = Uleb(mut p)
                    } else if op == 8 {
                        address = address + (255 - opcodeBase) / lineRange * minimum
                    } else if op == 9 {
                        address = address + Take(mut p, 2)
                    } else {
                        // the operands of a standard opcode this reader does not use, as its header counts them
                        mut long operands = ByteAt(unit + 17 + op)
                        while operands > 0 {
                            Uleb(mut p)
                            operands = operands - 1
                        }
                    }

                    if row {
                        if have && lastAddress <= at && at < address {
                            foundUnit = unit
                            foundFile = lastFile
                            foundLine = lastLine
                            return lastLine > 0
                        }

                        if last {
                            have = false
                            address = 0
                            file = 1
                            line = 1
                        } else {
                            have = true
                            lastAddress = address
                            lastFile = file
                            lastLine = line
                        }
                    }
                }
            }

            unit = end
        }

        return false
    }
}

// The place of the name of file `index` of the line tables' unit at `unit`, its `DW_LNCT_path` (1), as a
// compile error names the file: -1 where the unit names no such file.
long FileAt(long unit, long index) {
    raw {
        mut long p = unit + 17 + ByteAt(unit + 17)
        Entries(mut p, -1)
        return Entries(mut p, index)
    }
}

// The directories or the files of a unit's header at `p`, their format and then their entries, and `p`
// moved past them: the place of the name of entry `index`, or -1.
long Entries(mut long p, long index) {
    raw {
        long formatCount = Take(mut p, 1)
        long formats = p
        mut long k = 0
        while k < formatCount {
            Uleb(mut p)
            Uleb(mut p)
            k = k + 1
        }

        long count = Uleb(mut p)
        mut long found = -1
        mut long entry = 0
        while entry < count && !broken && !lost {
            mut long format = formats
            mut long j = 0
            while j < formatCount {
                long content = Uleb(mut format)
                long form = Uleb(mut format)
                long value = Value(mut p, form)
                if entry == index && content == 1 {
                    found = StringOf(form, value)
                }

                j = j + 1
            }

            entry = entry + 1
        }

        return found
    }
}

// ---- the debug information of the inlined calls (DWARF 5) ------------------------------------------

// The calls inlined at `at` (the owner, 2026-10-29, "As Rust: a frame each"): the entries of the debug
// information, `DW_TAG_inlined_subroutine` (29), whose code holds `at`, outermost first, in the second
// page, four numbers each, the entry, its unit, and the file and the line of its call; their count, 0
// where the information holds none, which is so in a build that inlines nothing.
long Inlined(long at) {
    raw {
        lost = false
        mut long depth = 0
        mut long unit = info
        while unit > 0 && unit + 12 <= infoEnd && abbreviations > 0 && !broken && !lost {
            long length = Read(unit, 4)
            if length >= 4294967280 {
                return 0
            }

            long end = unit + 4 + length
            if Read(unit + 4, 2) == 5 && ByteAt(unit + 6) == 1 {
                long table = abbreviations + Read(unit + 8, 4)
                mut long p = unit + 12
                mut bool first = true
                while p < end && !broken && !lost {
                    long entry = p
                    long code = Uleb(mut p)
                    if code != 0 {
                        mut long spec = Abbreviation(table, code)
                        if spec < 0 {
                            return 0
                        }

                        long tag = Uleb(mut spec)
                        spec = spec + 1
                        Attributes(mut p, mut spec)
                        if first {
                            first = false
                            stringBase = stringsAttribute
                            addressBase = addressesAttribute
                            rangeBase = rangesAttribute
                            unitLow = 0
                            if lowForm >= 0 {
                                unitLow = Address(lowForm, low)
                            }

                            unitLines = lines + linesAttribute
                        } else if tag == 29 && depth < 128 && Holds(at) {
                            long* chain = Ptr<long>(page + 4096)
                            chain[depth * 4] = entry
                            chain[depth * 4 + 1] = unit
                            chain[depth * 4 + 2] = callFile
                            chain[depth * 4 + 3] = callLine

                            depth = depth + 1
                        }
                    }
                }

                if depth > 0 {
                    return depth
                }
            }

            unit = end
        }

        if lost {
            return 0
        }

        return depth
    }
}

// Number `part` of entry `k` of the inlined calls.
long Chained(long k, long part) {
    raw {
        mut long value = 0
        long* chain = Ptr<long>(page + 4096)
        value = chain[k * 4 + part]

        return value
    }
}

// The place of the name of the function inlined by the entry at `entry` of the unit at `unit`: the name
// of the entry its `DW_AT_abstract_origin` names, followed as far as an entry with a name; -1 where none.
long NameOf(long entry, long unit) {
    raw {
        mut long at = entry
        mut long hops = 0
        while hops < 4 && !broken {
            mut long p = at
            long code = Uleb(mut p)
            mut long spec = Abbreviation(abbreviations + Read(unit + 8, 4), code)
            if code == 0 || spec < 0 {
                return -1
            }

            Uleb(mut spec)
            spec = spec + 1
            Attributes(mut p, mut spec)
            if lost {
                return -1
            }

            if nameForm >= 0 {
                return StringOf(nameForm, name)
            }

            if origin < 0 {
                return -1
            }

            // a reference into the unit, or with `DW_FORM_ref_addr` (16) into the section
            if originForm == 16 {
                at = info + origin
            } else {
                at = unit + origin
            }

            hops = hops + 1
        }

        return -1
    }
}

// The entry's specification of `code` in the table of abbreviations at `table`: the place of its tag,
// or -1.
long Abbreviation(long table, long code) {
    raw {
        mut long p = table
        while !broken {
            long found = Uleb(mut p)
            if found == 0 {
                return -1
            }

            if found == code {
                return p
            }

            Uleb(mut p)
            p = p + 1
            mut bool more = true
            while more && !broken {
                long attribute = Uleb(mut p)
                long form = Uleb(mut p)
                if form == 33 {
                    Sleb(mut p)
                }

                more = attribute != 0 || form != 0
            }
        }

        return -1
    }
}

// The attributes of an entry at `p` as its specification at `spec` lists them, `p` and `spec` moved
// past them: those the trace reads kept, each -1 where the entry has none.
void Attributes(mut long p, mut long spec) {
    raw {
        lowForm = -1
        highForm = -1
        rangesForm = -1
        origin = -1
        originForm = -1
        callFile = -1
        callLine = -1
        nameForm = -1
        stringsAttribute = -1
        addressesAttribute = -1
        rangesAttribute = -1
        linesAttribute = -1
        mut bool more = true
        while more && !broken && !lost {
            long attribute = Uleb(mut spec)
            long form = Uleb(mut spec)
            mut long constant = 0
            if form == 33 {
                constant = Sleb(mut spec)
            }

            if attribute == 0 && form == 0 {
                more = false
            } else {
                mut long value = Value(mut p, form)
                if form == 33 {
                    value = constant
                }

                if attribute == 3 {
                    nameForm = form
                    name = value
                } else if attribute == 16 {
                    linesAttribute = value
                } else if attribute == 17 {
                    lowForm = form
                    low = value
                } else if attribute == 18 {
                    highForm = form
                    high = value
                } else if attribute == 49 {
                    origin = value
                    originForm = form
                } else if attribute == 85 {
                    rangesForm = form
                    ranges = value
                } else if attribute == 88 {
                    callFile = value
                } else if attribute == 89 {
                    callLine = value
                } else if attribute == 114 {
                    stringsAttribute = value
                } else if attribute == 115 {
                    addressesAttribute = value
                } else if attribute == 116 {
                    rangesAttribute = value
                }
            }
        }
    }
}

// Whether the code of the entry last read holds `at`: by its `DW_AT_low_pc` and `DW_AT_high_pc`, the
// latter an address or, as a constant, the length, or by its range list.
bool Holds(long at) {
    raw {
        if lowForm >= 0 && highForm >= 0 {
            long start = Address(lowForm, low)
            mut long end = high
            if highForm != 1 && !Indexed(highForm) {
                end = start + high
            } else {
                end = Address(highForm, high)
            }

            return start <= at && at < end
        }

        if rangesForm < 0 {
            return false
        }

        // `DW_FORM_rnglistx` (35) indexes the unit's table of offsets; `DW_FORM_sec_offset` gives the place
        mut long p = rangeLists + ranges
        if rangesForm == 35 {
            p = rangeLists + rangeBase + Read(rangeLists + rangeBase + ranges * 4, 4)
        }

        mut long base = unitLow
        while rangeLists > 0 && !broken {
            long kind = Take(mut p, 1)
            mut long start = 0
            mut long end = 0
            if kind == 0 {
                return false
            } else if kind == 1 {
                base = Address(27, Uleb(mut p))
            } else if kind == 2 {
                start = Address(27, Uleb(mut p))
                end = Address(27, Uleb(mut p))
            } else if kind == 3 {
                start = Address(27, Uleb(mut p))
                end = start + Uleb(mut p)
            } else if kind == 4 {
                start = base + Uleb(mut p)
                end = base + Uleb(mut p)
            } else if kind == 5 {
                base = Take(mut p, 8)
            } else if kind == 6 {
                start = Take(mut p, 8)
                end = Take(mut p, 8)
            } else if kind == 7 {
                start = Take(mut p, 8)
                end = start + Uleb(mut p)
            } else {
                return false
            }

            if start <= at && at < end {
                return true
            }
        }

        return false
    }
}

// Whether a form is an index into the unit's addresses, `DW_FORM_addrx` and its fixed sizes.
bool Indexed(long form) {
    raw {
        return form == 27 || form == 41 || form == 42 || form == 43 || form == 44
    }
}

// The address an attribute of form `form` gives: the value of `DW_FORM_addr` (1), or the address at the
// index into the unit's table of addresses.
long Address(long form, long value) {
    raw {
        if Indexed(form) {
            return Read(addresses + addressBase + value * 8, 8)
        }

        return value
    }
}

// The place of the string an attribute of form `form` gives: in place (`DW_FORM_string`, 8), by an
// offset into the strings (14) or the line tables' strings (31), or by an index into the unit's offsets
// of the strings (`DW_FORM_strx` and its fixed sizes); -1 for another form.
long StringOf(long form, long value) {
    raw {
        if form == 8 {
            return value
        }

        if form == 14 {
            return strings + value
        }

        if form == 31 {
            return lineNames + value
        }

        if form == 26 || form == 37 || form == 38 || form == 39 || form == 40 {
            return strings + Read(stringOffsets + stringBase + value * 4, 4)
        }

        return -1
    }
}

// The value of an attribute of form `form` at `p`, as DWARF 5 writes it, and `p` moved past it: the
// number of a constant, an index or an offset, and for a string or a block written in place its place
// in the file; a form this reader does not know marks the information lost.
long Value(mut long p, long form) {
    raw {
        // DW_FORM_addr, data8, ref8, ref_sig8, ref_sup8
        if form == 1 || form == 7 || form == 20 || form == 32 || form == 36 {
            return Take(mut p, 8)
        }

        // DW_FORM_data4, strp, ref_addr, ref4, sec_offset, ref_sup4, strp_sup, line_strp, strx4, addrx4
        if form == 6 || form == 14 || form == 16 || form == 19 || form == 23 || form == 28 || form == 29 || form == 31 || form == 40 || form == 44 {
            return Take(mut p, 4)
        }

        // DW_FORM_data2, ref2, strx2, addrx2
        if form == 5 || form == 18 || form == 38 || form == 42 {
            return Take(mut p, 2)
        }

        // DW_FORM_data1, flag, ref1, strx1, addrx1
        if form == 11 || form == 12 || form == 17 || form == 37 || form == 41 {
            return Take(mut p, 1)
        }

        // DW_FORM_strx3, addrx3
        if form == 39 || form == 43 {
            return Take(mut p, 3)
        }

        // DW_FORM_udata, ref_udata, strx, addrx, loclistx, rnglistx
        if form == 15 || form == 21 || form == 26 || form == 27 || form == 34 || form == 35 {
            return Uleb(mut p)
        }

        // DW_FORM_sdata
        if form == 13 {
            return Sleb(mut p)
        }

        // DW_FORM_flag_present, and implicit_const, whose value stands in the specification
        if form == 25 || form == 33 {
            return 0
        }

        long at = p
        if form == 8 {
            p = End(p) + 1
        } else if form == 30 {
            p = p + 16
        } else if form == 10 {
            long count = Take(mut p, 1)
            p = p + count
        } else if form == 3 {
            long count = Take(mut p, 2)
            p = p + count
        } else if form == 4 {
            long count = Take(mut p, 4)
            p = p + count
        } else if form == 9 || form == 24 {
            long count = Uleb(mut p)
            p = p + count
        } else {
            lost = true
        }

        return at
    }
}

// ---- reading the file ------------------------------------------------------------------------------

// The byte of the file at `at`, read through the window, or -1 where it cannot be read.
long ByteAt(long at) {
    raw {
        if at < windowAt || at >= windowAt + windowHeld {
            if !Window(at) {
                return -1
            }
        }

        mut long b = 0
        b = long(page[at - windowAt])

        return b
    }
}

// The window moved to `at`: a page of the file from there, read by `pread`, called again where a signal
// interrupted it (`EINTR`, 4); false, and the file marked broken, where nothing can be read there.
bool Window(long at) {
    raw {
        mut long got = -1
        if at >= 0 {
            int* error = __errno_location()
            got = pread(image, page, 4096, at)
            while got < 0 && *error == 4 {
                got = pread(image, page, 4096, at)
            }
        }

        if got <= 0 {
            broken = true
            windowHeld = 0
            return false
        }

        windowAt = at
        windowHeld = got
        return true
    }
}

// The little-endian number of `size` bytes at `at`; 0 where they cannot be read.
long Read(long at, long size) {
    raw {
        mut long value = 0
        mut long i = size - 1
        while i >= 0 {
            long b = ByteAt(at + i)
            if b < 0 {
                return 0
            }

            value = (value << 8) | b
            i = i - 1
        }

        return value
    }
}

// The number of `size` bytes at `at`, and `at` moved past them.
long Take(mut long at, long size) {
    raw {
        long value = Read(at, size)
        at = at + size
        return value
    }
}

// An unsigned LEB128 number at `at`, as DWARF writes one, and `at` moved past it.
long Uleb(mut long at) {
    raw {
        mut long value = 0
        mut int shift = 0
        mut long b = 128
        while b >= 128 {
            b = ByteAt(at)
            if b < 0 {
                return 0
            }

            at = at + 1
            if shift < 64 {
                value = value | ((b & 127) << shift)
            }

            shift = shift + 7
        }

        return value
    }
}

// A signed LEB128 number at `at`, and `at` moved past it.
long Sleb(mut long at) {
    raw {
        mut long value = 0
        mut int shift = 0
        mut long b = 128
        while b >= 128 {
            b = ByteAt(at)
            if b < 0 {
                return 0
            }

            at = at + 1
            if shift < 64 {
                value = value | ((b & 127) << shift)
            }

            shift = shift + 7
        }

        if shift < 64 && (b & 64) != 0 {
            value = value | (long(-1) << shift)
        }

        return value
    }
}

// Whether the bytes of the file at `at` start with those of `text`, a zero at its end among them where
// the whole name is meant.
bool Starts(long at, string text) {
    raw {
        long count = long(text.Bytes.Count)
        mut long i = 0
        while i < count {
            mut long b = 0
            b = long(text.Pointer[i])

            if ByteAt(at + i) != b {
                return false
            }

            i = i + 1
        }

        return true
    }
}

// The place of the zero that ends the string at `at`.
long End(long at) {
    raw {
        mut long p = at
        while ByteAt(p) > 0 {
            p = p + 1
        }

        return p
    }
}

// ---- writing the trace -----------------------------------------------------------------------------

// A text written on standard error.
void Out(string text) {
    raw {
        TraceBytes(text.Pointer, long(text.Bytes.Count))
    }
}

// The file's bytes from `from` to `to` written on standard error, a window at a time.
void FileBytes(long from, long to) {
    raw {
        mut long at = from
        while at < to && !failed && Window(at) {
            mut long count = to - at
            if count > windowHeld {
                count = windowHeld
            }

            TraceBytes(page, count)
            at = at + count
        }
    }
}

// `count` bytes written on standard error in as many calls as it takes; a write the system refuses, or
// one that takes nothing, ends the trace there (design record, section 6).
void TraceBytes(byte* bytes, long count) {
    raw {
        mut long done = 0
        while done < count && !failed {
            long written = Write(2, bytes + done, count - done)
            if written <= 0 {
                failed = true
            } else {
                done = done + written
            }
        }
    }
}

// The decimal digits of a number, written one at a time.
void Number(long value) {
    raw {
        mut long unit = 1
        while value / unit >= 10 {
            unit = unit * 10
        }

        while unit > 0 {
            mut byte digit = byte(value / unit % 10 + 48)
            TraceBytes(&digit, 1)

            unit = unit / 10
        }
    }
}

// An address in hexadecimal after `0x`, as a frame without a name gives it (design record, section 6).
void Hex(long value) {
    raw {
        Out("0x")
        mut int shift = 60
        while shift > 0 && ((value >> shift) & 15) == 0 {
            shift = shift - 4
        }

        while shift >= 0 {
            long d = (value >> shift) & 15
            mut byte digit = byte(d + 48)
            if d >= 10 {
                digit = byte(d + 87)
            }

            TraceBytes(&digit, 1)

            shift = shift - 4
        }
    }
}

// ---- files (design record, section 12) --------------------------------------------------------------

// The calls on files of a program built for Linux (chapter 13 of the reference): the emitted code of
// the program calls them, and nothing of `runtime/common/` or `std/` does, so that the runtime of
// Windows gives none of them and a build for Windows says `not supported` at such a call (the owner,
// 2026-10-29, "Not supported on Windows"). Each takes a path as the address of its bytes ended by a
// NUL byte, read from the working directory where it does not start with `/`, and returns what it
// gives, a number of 0 or more, or a failure below 0: the system's error number negated, or -4096 for
// the name of a directory's entry that is not UTF-8, which no error number is, Linux's being below
// 4096. `ErrorKind` and `ErrorCode` read a failure. A call a signal interrupts (`EINTR`, 4) where it waits
// on a file is made again, as Rust's standard library makes it again.

// The page of each thread that `stat` fills, mapped at its first use.
thread static mut byte* status = null

// A system call's result: `result` where it is 0 or more, else the error number negated.
long Checked(long result) {
    mut long checked = result
    raw {
        if result < 0 {
            checked = -long(*__errno_location())
        }
    }

    return checked
}

// The descriptor of the file at `path`, opened to read, or with `create` created or emptied to write,
// with the permissions 0666 less the process's `umask`, as Rust's `File::open` and `File::create` open
// it: `O_RDONLY` is 0 and `O_WRONLY | O_CREAT | O_TRUNC` 577, each with `O_CLOEXEC`, 524288, since
// Rust's standard library opens every descriptor close-on-exec.
pub long OpenFile(byte* path, bool create) {
    mut int options = 524288
    if create {
        options = 524288 + 577
    }

    mut long result = -1
    raw {
        int* error = __errno_location()
        result = long(open(path, options, 438))
        while result < 0 && *error == 4 {
            result = long(open(path, options, 438))
        }
    }

    return Checked(result)
}

// Up to `count` bytes of the file `fd` read to `bytes`: their count, 0 at the end of the file.
pub long ReadFile(int fd, byte* bytes, long count) {
    mut long result = -1
    raw {
        int* error = __errno_location()
        result = read(fd, bytes, count)
        while result < 0 && *error == 4 {
            result = read(fd, bytes, count)
        }
    }

    return Checked(result)
}

// The `count` bytes at `bytes` written to the file `fd`, `write` called again with the rest where it
// took a part, as `print` writes and Rust's `write_all` does: `count`, or the bytes written before a
// call that took none, which is `WriteZero` to the caller, or the failure of the call that failed.
pub long WriteFile(int fd, byte* bytes, long count) {
    mut long done = 0
    while done < count {
        mut long written = -1
        raw {
            written = Write(fd, bytes + done, count - done)
        }

        if written < 0 {
            return Checked(written)
        }

        if written == 0 {
            return done
        }

        done = done + written
    }

    return done
}

// The file `fd` closed: 0, or the failure of `close`, of which an interrupt is none: Linux lets go of
// the descriptor before the signal, so that it is not closed again, as Rust's standard library does
// not close it again.
pub long CloseFile(int fd) {
    mut long result = 0
    raw {
        int* error = __errno_location()
        if close(fd) != 0 && *error != 4 {
            result = -long(*error)
        }
    }

    return result
}

// The file at `path` deleted, by `unlink`: 0, or the failure.
pub long DeleteFile(byte* path) {
    mut long result = 0
    raw {
        result = Checked(long(unlink(path)))
    }

    return result
}

// The file at `from` moved to `to`, over a file that `to` names, by `rename`: 0, or the failure.
pub long RenameFile(byte* from, byte* to) {
    mut long result = 0
    raw {
        result = Checked(long(rename(from, to)))
    }

    return result
}

// The empty directory at `path` deleted, by `rmdir`: 0, or the failure.
pub long DeleteDirectory(byte* path) {
    mut long result = 0
    raw {
        result = Checked(long(rmdir(path)))
    }

    return result
}

// The status of what has the path, by `stat`, which follows a link, as Rust's `fs::metadata` does,
// into the thread's page: 0, or the failure, `ENOMEM` (12) where the page cannot be mapped. The page
// holds x86-64's `struct stat` (the trace above reads x86-64's forms of a call): `st_mode` at its
// byte 24 and `st_size` at its byte 48.
long Status(byte* path) {
    mut long result = -12
    raw {
        if status == null {
            status = Memory(4096)
        }

        if status != null {
            result = Checked(long(stat(path, Ptr<void>(status))))
        }
    }

    return result
}

// The size in bytes of the file at `path`, or the failure.
pub long FileSize(byte* path) {
    long result = Status(path)
    if result < 0 {
        return result
    }

    mut long size = 0
    raw {
        size = *Ptr<long>(status + 48)
    }

    return size
}

// Whether anything has the path: 1, 0 where `stat` finds nothing (`ENOENT`, 2), as Rust's
// `fs::exists` answers `false` for `NotFound` alone, or the failure.
pub long FileExists(byte* path) {
    long result = Status(path)
    if result == -2 {
        return 0
    }

    if result < 0 {
        return result
    }

    return 1
}

// Whether a directory has the path: its type in `st_mode` (`S_IFMT`, 0o170000) is `S_IFDIR` (0o40000).
bool IsDirectory(byte* path) {
    if Status(path) < 0 {
        return false
    }

    mut bool directory = false
    raw {
        directory = (*Ptr<int>(status + 24) & 61440) == 16384
    }

    return directory
}

// `mkdir` of the path with the permissions 0777 (511) less the `umask`: 0 where it made the directory,
// or where a directory has the path and the failure is not `ENOENT` (2), as Rust's `create_dir_all`
// takes a directory that is there; else the failure.
long MakeDirectory(byte* path) {
    mut long result = 0
    raw {
        result = Checked(long(mkdir(path, 511)))
    }

    if result < 0 && result != -2 && IsDirectory(path) {
        return 0
    }

    return result
}

// The directory at the first `count` bytes of `path` created, with every directory above it that is
// missing, as Rust's `fs::create_dir_all` creates them: where `mkdir` finds no directory above, the
// one above is created first and `mkdir` made again. An empty path is created already. The byte after
// the `count` is written NUL while the call runs and given back after it, so that a path ends where the
// directory above ends: at its last `/` with bytes in front of it, without the `/`s at its end.
pub long CreateDirectories(byte* path, long count) {
    if count == 0 {
        return 0
    }

    mut long result = 0
    raw {
        byte kept = path[count]
        path[count] = 0
        result = MakeDirectory(path)
        if result == -2 {
            mut long end = count
            while end > 1 && path[end - 1] == 47 {
                end = end - 1
            }

            while end > 0 && path[end - 1] != 47 {
                end = end - 1
            }

            while end > 1 && path[end - 1] == 47 {
                end = end - 1
            }

            result = CreateDirectories(path, end)
            if result == 0 {
                result = MakeDirectory(path)
            }
        }

        path[count] = kept
    }

    return result
}

// The names of the entries of the directory at `path` added to `names` in the order `readdir` gives
// them, without `.` and `..`, as Rust's `fs::read_dir` leaves them out: 0, the failure of `opendir` or
// of `readdir`, or -4096 for a name that is not UTF-8, which a `string` does not hold. A name stands at
// byte 19 of the GNU C library's `struct dirent` of a 64-bit target.
pub long ListDirectory(byte* path, mut List<string> names) {
    mut long result = 0
    raw {
        int* error = __errno_location()
        void* directory = opendir(path)
        if directory == null {
            return -long(*error)
        }

        while result == 0 {
            *error = 0
            void* entry = readdir(directory)
            if entry == null {
                result = -long(*error)
                break
            }

            byte* entryName = Ptr<byte>(entry) + 19
            long count = strlen(entryName)
            bool dots = (count == 1 && entryName[0] == 46) || (count == 2 && entryName[0] == 46 && entryName[1] == 46)
            if !dots {
                byte* items = Bytes.Allocate(count)
                mut long i = 0
                while i < count {
                    items[i] = entryName[i]
                    i = i + 1
                }

                match string.FromUtf8(Bytes.FromRaw(items, count)) {
                    string text => names.Add(text)
                    InvalidUtf8 => result = -4096
                }
            }
        }

        closedir(directory)
    }

    return result
}

// ---- sockets (design record, section 12) ------------------------------------------------------------

// The calls on sockets of a program built for Linux (S9), over TCP, as Rust 1.82's `TcpListener` and
// `TcpStream` make them on Linux. An address is a host and a port after its last `:`, as Rust's
// `ToSocketAddrs` reads a `str`: a host that is a literal, of IPv4, or of IPv6 inside `[` and `]` with a scope
// id after a `%` and a port without a `+`, is read by `inet_pton` with no lookup, and any other is looked up
// by `getaddrinfo`, whose addresses are tried
// in its order until one binds or connects, the failure of the last being the call's, as Rust's
// `each_addr` tries them. Beside the system's numbers negated, a call fails with -4097 for an address
// that is no host and port, or a name that gives no address, `InvalidInput` to the caller, as Rust gives
// it, and with -4098 for a lookup that fails with no error of the system, `NotFound` (S9).

// The page of each thread that holds a call's address and what the calls of the system take by address,
// mapped at its first use: a literal address at its byte 0, with room for one of IPv6, 28 bytes; the
// length `getsockname` takes at 32; the 1 that `setsockopt` sets at 36; the hints for `getaddrinfo` at
// 64, 48 bytes; and the list it gives at 112.
thread static mut byte* endpoints = null

// The port written in the `count` bytes at `text`: a number from 0 to 65535 in decimal digits, after a
// `+` that may stand first, as Rust reads a `u16`, or -1.
long PortOf(byte* text, long count) {
    mut long port = -1
    raw {
        mut long i = 0
        if count > 0 && text[0] == 43 {
            i = 1
        }

        if i < count {
            port = 0
        }

        while i < count && port >= 0 {
            long digit = long(text[i]) - 48
            if digit < 0 || digit > 9 {
                port = -1
            } else {
                port = port * 10 + digit
                if port > 65535 {
                    port = -1
                }
            }

            i = i + 1
        }
    }

    return port
}

// The scope id written in the `count` bytes at `text`, after the `%` of an address of IPv6: a number from
// 0 to 4294967295 in decimal digits, zeros in front taken, as Rust's parse of a socket address reads a
// `u32` there, or -1.
long ScopeOf(byte* text, long count) {
    mut long scope = -1
    raw {
        if count > 0 {
            scope = 0
        }

        mut long i = 0
        while i < count && scope >= 0 {
            long digit = long(text[i]) - 48
            if digit < 0 || digit > 9 {
                scope = -1
            } else {
                scope = scope * 10 + digit
                if scope > 4294967295 {
                    scope = -1
                }
            }

            i = i + 1
        }
    }

    return scope
}

// A socket of the family of the address at `address`, of `length` bytes, for TCP (`SOCK_STREAM`, 1,
// with `SOCK_CLOEXEC`, 524288, as Rust's standard library opens every descriptor close-on-exec); with
// `listening`, bound to the address after `SO_REUSEADDR` (2, of `SOL_SOCKET`, 1) is set to 1, and
// listening with room for 128 connections that wait, as Rust's `TcpListener::bind` sets them; else
// connected to it, `connect` made again where a signal interrupted it (`EINTR`, 4) and a socket that is
// connected already (`EISCONN`, 106) taken, as Rust's `connect` takes it: the descriptor, or the
// failure with the socket closed.
long Attempt(byte* address, int length, bool listening) {
    mut long result = -1
    raw {
        int* error = __errno_location()
        int family = int(address[0]) + int(address[1]) * 256
        int fd = socket(family, 524289, 0)
        if fd < 0 {
            return -long(*error)
        }

        mut int done = 0
        if listening {
            done = setsockopt(fd, 1, 2, Ptr<void>(endpoints + 36), 4)
            if done == 0 {
                done = bind(fd, Ptr<void>(address), length)
            }

            if done == 0 {
                done = listen(fd, 128)
            }
        } else {
            done = connect(fd, Ptr<void>(address), length)
            while done != 0 && *error == 4 {
                done = connect(fd, Ptr<void>(address), length)
            }

            if done != 0 && *error == 106 {
                done = 0
            }
        }

        if done != 0 {
            long failure = -long(*error)
            close(fd)
            return failure
        }

        result = long(fd)
    }

    return result
}

// `Attempt` on each address of `text`, a host and a port after its last `:`, NUL-ended, in which the
// call writes a NUL over that `:` while it runs and gives it back after: the descriptor of the first
// that binds or connects, or the failure, `ENOMEM` (12) where the thread's page cannot be mapped. The port is
// written into each address in the order of the network, its high byte first.
long EachAddress(byte* text, bool listening) {
    mut long result = -12
    raw {
        if endpoints == null {
            endpoints = Memory(4096)
        }

        byte* held = endpoints
        if held == null {
            return result
        }

        long count = strlen(text)
        mut long colon = count - 1
        while colon >= 0 && text[colon] != 58 {
            colon = colon - 1
        }

        if colon < 0 {
            return -4097
        }

        long port = PortOf(text + colon + 1, count - colon - 1)
        if port < 0 {
            return -4097
        }

        byte portHigh = byte(port / 256)
        byte portLow = byte(port % 256)
        mut long i = 0
        while i < 112 {
            held[i] = 0
            i = i + 1
        }

        *Ptr<int>(held + 36) = 1

        text[colon] = 0
        mut int length = 0
        if colon >= 2 && text[0] == 91 && text[colon - 1] == 93 && text[colon + 1] != 43 {
            // `sockaddr_in6`: the family, `AF_INET6` (10), the port at its byte 2, the address at 8 and the
            // scope id after a `%` at 24, as Rust's parse of a socket address reads them, which takes no `+`
            // before the port: with one, the host is looked up as it is written, below, as Rust looks it up
            text[colon - 1] = 0
            mut long percent = 1
            while text[percent] != 0 && text[percent] != 37 {
                percent = percent + 1
            }

            mut long scope = 0
            if text[percent] == 37 {
                text[percent] = 0
                scope = ScopeOf(text + percent + 1, colon - 2 - percent)
            }

            if scope >= 0 && inet_pton(10, text + 1, Ptr<void>(held + 8)) == 1 {
                held[0] = 10
                held[24] = byte(scope % 256)
                held[25] = byte(scope / 256 % 256)
                held[26] = byte(scope / 65536 % 256)
                held[27] = byte(scope / 16777216)
                length = 28
            }

            if percent < colon - 1 {
                text[percent] = 37
            }

            text[colon - 1] = 93
        } else if inet_pton(2, text, Ptr<void>(held + 4)) == 1 {
            // `sockaddr_in`: the family, `AF_INET` (2), the port at its byte 2 and the address at 4
            held[0] = 2
            length = 16
        }

        if length > 0 {
            held[2] = portHigh
            held[3] = portLow
            result = Attempt(held, length, listening)
        } else {
            // the hints of `struct addrinfo`: `ai_socktype` at its byte 8 `SOCK_STREAM`, the family any,
            // as Rust's `LookupHost` asks; a failure other than `EAI_SYSTEM` (-11) names no error number
            *Ptr<int>(held + 72) = 1
            int looked = getaddrinfo(text, null, Ptr<void>(held + 64), Ptr<void>(held + 112))
            if looked == -11 {
                result = -long(*__errno_location())
            } else if looked != 0 {
                result = -4098
            } else {
                // each `struct addrinfo`: `ai_addrlen` at its byte 16, `ai_addr` at 24 and `ai_next` at 40
                byte* list = Ptr<byte>(*Ptr<long>(held + 112))
                mut byte* entry = list
                result = -4097
                while entry != null && result < 0 {
                    byte* address = Ptr<byte>(*Ptr<long>(entry + 24))
                    address[2] = portHigh
                    address[3] = portLow
                    result = Attempt(address, *Ptr<int>(entry + 16), listening)
                    entry = Ptr<byte>(*Ptr<long>(entry + 40))
                }

                freeaddrinfo(Ptr<void>(list))
            }
        }

        text[colon] = 58
    }

    return result
}

// A socket listening on the address `text` (S9): its descriptor, with the port it is bound to written
// to `port`, read by `getsockname` as Rust's `local_addr` reads it, which the system picks for the port
// 0; or the failure, the socket closed.
pub long Listen(byte* text, int* port) {
    long fd = EachAddress(text, true)
    if fd < 0 {
        return fd
    }

    mut long result = fd
    raw {
        byte* held = endpoints
        *Ptr<int>(held + 32) = 28
        if getsockname(int(fd), Ptr<void>(held), Ptr<int>(held + 32)) != 0 {
            result = -long(*__errno_location())
            close(int(fd))
        } else {
            *port = int(held[2]) * 256 + int(held[3])
        }
    }

    return result
}

// A socket connected to the address `text` (S9): its descriptor, or the failure.
pub long Connect(byte* text) => EachAddress(text, false)

// A connection that waits on the listening socket `fd`, taken by `accept4`, close-on-exec, and made again
// where a signal interrupted it, as Rust's `accept` takes it: its descriptor, or the failure.
pub long Accept(int fd) {
    mut long result = -1
    raw {
        int* error = __errno_location()
        result = long(accept4(fd, null, null, 524288))
        while result < 0 && *error == 4 {
            result = long(accept4(fd, null, null, 524288))
        }
    }

    return Checked(result)
}

// The kind of a failure of the calls above: the kind Rust 1.82's `decode_error_kind` gives the error
// number on Linux, each abbreviation written out, `AddrInUse` as `AddressInUse`, `Other` for a number
// it gives no kind, `InvalidData` for a name that is not UTF-8 (S1), `InvalidInput` for an address that
// is no host and port or gives no address, and `NotFound` for a lookup that failed (S9).
pub IoKind ErrorKind(long failure) => match -failure {
    1 => IoKind.PermissionDenied
    2 => IoKind.NotFound
    4 => IoKind.Interrupted
    7 => IoKind.ArgumentListTooLong
    11 => IoKind.WouldBlock
    12 => IoKind.OutOfMemory
    13 => IoKind.PermissionDenied
    16 => IoKind.ResourceBusy
    17 => IoKind.AlreadyExists
    18 => IoKind.CrossesDevices
    20 => IoKind.NotADirectory
    21 => IoKind.IsADirectory
    22 => IoKind.InvalidInput
    26 => IoKind.ExecutableFileBusy
    27 => IoKind.FileTooLarge
    28 => IoKind.StorageFull
    29 => IoKind.NotSeekable
    30 => IoKind.ReadOnlyFilesystem
    31 => IoKind.TooManyLinks
    32 => IoKind.BrokenPipe
    35 => IoKind.Deadlock
    36 => IoKind.InvalidFilename
    38 => IoKind.Unsupported
    39 => IoKind.DirectoryNotEmpty
    40 => IoKind.FilesystemLoop
    98 => IoKind.AddressInUse
    99 => IoKind.AddressNotAvailable
    100 => IoKind.NetworkDown
    101 => IoKind.NetworkUnreachable
    103 => IoKind.ConnectionAborted
    104 => IoKind.ConnectionReset
    107 => IoKind.NotConnected
    110 => IoKind.TimedOut
    111 => IoKind.ConnectionRefused
    113 => IoKind.HostUnreachable
    116 => IoKind.StaleNetworkFileHandle
    122 => IoKind.FilesystemQuotaExceeded
    4096 => IoKind.InvalidData
    4097 => IoKind.InvalidInput
    4098 => IoKind.NotFound
    else => IoKind.Other
}

// The number of a failure of the calls above (S1): the system's error number, or 0 for a name that is
// not UTF-8, an address or a lookup, which is no error of the system's.
pub int ErrorCode(long failure) {
    if failure <= -4096 {
        return 0
    }

    return int(-failure)
}
