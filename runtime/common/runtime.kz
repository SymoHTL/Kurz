// The part of the runtime every target shares (design record, section 2). It reaches the functions of
// the target the program is built for as the folder `sys`, the target's directory (the owner,
// 2026-10-23, "Rust's sys"), and the standard library's allocator as the folder `std` (the owner,
// 2026-10-24, "A std/ directory now" and "As built"). The emitted code calls its `pub` functions: `Start` before the
// program's first statement and `Finish` after its last, and the others where the program allocates,
// prints, makes the text of a value, joins or compares strings, computes with a `decimal`, raises an
// exception, or hands a path to a call on a file (compiler/README.md, "The runtime").
use std
use sys

// The buffer of each thread in which `Print` puts a line together before its write, and its size.
thread static mut byte* buffer = null
thread static mut long room = 0

// Called by the emitted `main` before the program's first statement, with the arguments the C library's
// start gave it (S13).
pub void Start(int count, byte* values) {
    sys.Start(count, values)
}

// Called by the emitted `main` after the program's last statement: the end of the process with the
// exit code 0 through the runtime's one exit (design record, section 6).
pub void Finish() {
    sys.Exit(0)
}

// `size` bytes from the allocator's entry (design record, section 2), at an address that is a multiple
// of 16. An allocation the system refuses ends the process with `error: allocation-failed (<n> bytes)`
// and the exit code 1 (O11; the owner, 2026-10-23, "Id + size"), as Rust's `handle_alloc_error` ends
// it for the null its allocator gives.
pub byte* Allocate(long size) {
    byte* p = std.Allocate(size)
    if p == null {
        AllocationFailed(size)
    }

    return p
}

// The bytes of a new string, `string.Allocate(size)` (R15): room for `size` bytes in a block that
// holds the count of the string values in front of them, which `string.FromRaw` takes over. More
// bytes than the largest `int` end the process as a refused allocation does, with the count asked
// for (T15); a block the system refuses ends it with the bytes the allocator was asked for, the
// block's counts among them, as a list's growth does (section 4).
pub byte* AllocateString(long size) {
    if size > 2147483647 {
        AllocationFailed(size)
    }

    byte* p = std.StringBlock(size)
    if p == null {
        AllocationFailed(16 + size)
    }

    return p
}

// The end of the process for an allocation refused, and for a string asked of more bytes than the
// largest `int` (T15; the owner, "C#'s limit" on 2026-10-23 and "allocation-failed" on 2026-10-24): `error:
// allocation-failed (<n> bytes)` and the exit code 1, with no place and no trace (O11).
pub void AllocationFailed(long size) {
    sys.Crashing()
    WriteError("error: allocation-failed (")
    WriteNumber(ulong(size))
    WriteError(" bytes)\n")
    sys.Exit(1)
}

// The end of the process at a thread's first map where the system gave no randomness for the keys of
// its hash, the target's `Random` false (M9; the owner, 2026-10-30, "End with an error, as Rust" and
// "Rust's full path"): `error: random-failed` and the exit code 1, with no place and no trace, as
// `allocation-failed` ends it, where Rust's standard library panics with "failed to retrieve random
// hash map seed".
pub void RandomFailed() {
    sys.Crashing()
    WriteError("error: random-failed\n")
    sys.Exit(1)
}

// The end of the process where an argument made before the program's first statement, `args`, is not
// UTF-8 (S13; the owner, 2026-10-30, "Refused, as Rust"): `error: invalid-argument` and the exit code 1,
// with no place and no trace, as `random-failed` ends it, the id and that end assumed in the record's
// marker of that answer.
pub void InvalidArgument() {
    sys.Crashing()
    WriteError("error: invalid-argument\n")
    sys.Exit(1)
}

// The bytes of a path as C reads them, for a call on a file (S1, S2): a copy of the string's bytes
// ended by a NUL byte, which `FreePath` gives back, or null where the string holds a NUL byte, which
// no path of the system holds and which is `InvalidInput` to the caller, as Rust's `run_path_with_cstr`
// refuses it.
pub byte* CPath(string path) {
    long count = long(path.Bytes.Count)
    byte* p = Allocate(count + 1)
    raw {
        byte* from = path.Pointer
        mut long i = 0
        while i < count {
            if from[i] == 0 {
                std.Free(p, count + 1)
                return null
            }

            p[i] = from[i]
            i = i + 1
        }

        p[count] = 0
    }

    return p
}

// The copy `CPath` made of the path, given back to the allocator.
pub void FreePath(byte* p, string path) {
    std.Free(p, long(path.Bytes.Count) + 1)
}

// `print` (A1): the text and a line feed, handed to the system's write call in one piece, which is
// called again for what a call did not take; a write the system refuses, or one that takes no byte,
// as Rust's `write_all` fails on a write of zero bytes, raises `print-failed` at the place of the
// `print`, which the emitted call passes (design record, section 6; the owner, 2026-10-23, "Caller
// passes it").
pub void Print(string text, string file, int line) {
    long count = long(text.Bytes.Count)
    long total = count + 1
    raw {
        if total > room {
            room = total
            if room < 4096 {
                room = 4096
            }

            buffer = Allocate(room)
        }

        byte* from = text.Pointer
        mut long i = 0
        while i < count {
            buffer[i] = from[i]
            i = i + 1
        }

        buffer[count] = 10
    }

    mut long done = 0
    while done < total {
        mut long written = -1
        raw {
            written = sys.Write(1, buffer + done, total - done)
        }

        if written <= 0 {
            Raise("print-failed", file, line)
        }

        done = done + written
    }
}

// The error line of an exception of the run-time table (chapter 12), `error: <id> at <file>:<n>`, on
// standard error, the trace of the calls below it, which the target's `Trace` writes, and the end of
// the process with the exit code 1 (design record, section 6). The target's `Crashing` marks the crash
// path as running first, so that a stack overflow in it ends the process with no second error line.
pub void Raise(string id, string file, int line) {
    sys.Crashing()
    WriteError("error: ")
    WriteError(id)
    WriteError(" at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// A `throw` (O6): the error line ends with a colon, and the text of the thrown value stands on the
// line below it, written as it is, with the trace below the text (design record, section 6).
pub void Throw(string text, string file, int line) {
    sys.Crashing()
    WriteError("error: thrown at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError(text)
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// The error line of `not-char-boundary` (X2, X10): `error: not-char-boundary at <file>:<n>:`, the
// position of the cut on the line below it, `byte <at> is inside a code point`, where the text of a
// `throw` stands (O6), the trace of the calls below that, and the end of the process with the exit code 1.
pub void NotCharBoundary(long at, string file, int line) {
    sys.Crashing()
    WriteError("error: not-char-boundary at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError("byte ")
    WriteNumber(ulong(at))
    WriteError(" is inside a code point\n")
    sys.Trace()
    sys.Exit(1)
}

// The text of a signed integer (A2): its decimal digits, with a leading `-` when it is negative.
pub string TextOfLong(long value) {
    if value >= 0 {
        return TextOfULong(ulong(value))
    }

    // the magnitude of the smallest `long` is no `long`: the digits of -(value + 1), plus one
    string digits = TextOfULong(ulong(-(value + 1)) + 1)
    long count = long(digits.Bytes.Count)
    mut string text = ""
    raw {
        byte* p = string.Allocate(count + 1)
        byte* from = digits.Pointer
        p[0] = 45
        mut long i = 0
        while i < count {
            p[i + 1] = from[i]
            i = i + 1
        }

        text = string.FromRaw(p, count + 1)
    }

    return text
}

// The text of an unsigned integer (A2): its decimal digits.
pub string TextOfULong(ulong value) {
    long count = DigitCount(value)
    mut string text = ""
    raw {
        byte* p = string.Allocate(count)
        WriteDigits(p, value, int(count))
        text = string.FromRaw(p, count)
    }

    return text
}

// The text of a `char` (A8): its code point in UTF-8, one to four bytes.
pub string TextOfChar(uint point) {
    mut long count = 4
    if point < 128 {
        count = 1
    } else if point < 2048 {
        count = 2
    } else if point < 65536 {
        count = 3
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(count)
        if count == 1 {
            p[0] = byte(point)
        } else if count == 2 {
            p[0] = byte(192 | (point >> 6))
            p[1] = byte(128 | (point & 63))
        } else if count == 3 {
            p[0] = byte(224 | (point >> 12))
            p[1] = byte(128 | ((point >> 6) & 63))
            p[2] = byte(128 | (point & 63))
        } else {
            p[0] = byte(240 | (point >> 18))
            p[1] = byte(128 | ((point >> 12) & 63))
            p[2] = byte(128 | ((point >> 6) & 63))
            p[3] = byte(128 | (point & 63))
        }

        text = string.FromRaw(p, count)
    }

    return text
}

// The text of a `double`, given its 64 bits, which the emitted code passes (A4, A14): the fewest digits
// that read back as the same number, of those the nearest to it, written as .NET Core 3.0 and later
// write a `double` with the invariant culture; `-0` for a negative zero, `Infinity`, `-Infinity` and
// `NaN`. The digits are Ryu's, as Rust's `ryu` crate computes them with its small table.
pub string TextOfDouble(ulong bits) {
    bool negative = bits >> 63 == 1
    int exponent = int((bits >> 52) & 2047)
    ulong mantissa = bits & 4503599627370495
    if exponent == 2047 {
        return NoDigits(mantissa != 0, negative)
    }

    if exponent == 0 && mantissa == 0 {
        return ZeroText(negative)
    }

    mut ulong digits = 0
    mut int power = 0
    DoubleDigits(mantissa, exponent, mut digits, mut power)
    return DecimalText(negative, digits, power, 17)
}

// The text of a `float`, given its 32 bits (A8, A11): the fewest digits that read back as the same
// `float`, written as .NET Core 3.0 and later write a `float`, and the values without digits as a
// `double` shows them.
pub string TextOfFloat(uint bits) {
    bool negative = bits >> 31 == 1
    int exponent = int((bits >> 23) & 255)
    ulong mantissa = ulong(bits & 8388607)
    if exponent == 255 {
        return NoDigits(mantissa != 0, negative)
    }

    if exponent == 0 && mantissa == 0 {
        return ZeroText(negative)
    }

    mut ulong digits = 0
    mut int power = 0
    FloatDigits(mantissa, exponent, mut digits, mut power)
    return DecimalText(negative, digits, power, 9)
}

// Two strings joined (T15): the bytes of the first, then those of the second; more bytes than the
// largest `int` end the process as a refused allocation does.
pub string Concat(string first, string second) {
    long a = long(first.Bytes.Count)
    long b = long(second.Bytes.Count)
    if b == 0 {
        return first
    }

    if a == 0 {
        return second
    }

    if a + b > 2147483647 {
        AllocationFailed(a + b)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(a + b)
        byte* x = first.Pointer
        byte* y = second.Pointer
        mut long i = 0
        while i < a {
            p[i] = x[i]
            i = i + 1
        }

        i = 0
        while i < b {
            p[a + i] = y[i]
            i = i + 1
        }

        text = string.FromRaw(p, a + b)
    }

    return text
}

// The text of a list (A4): the texts of its `count` items, one or more, which `texts` holds as a
// string is laid out, the address of its bytes and their count, 8 bytes each, the count's highest bit
// the mark of a string that holds a block (`std/std.kz`), between `[` and `]` and with `, ` between
// them; more bytes than the largest `int` end the process as a refused allocation does.
pub string ListText(byte* texts, long count) {
    mut long total = 2 * count
    raw {
        mut long i = 0
        while i < count {
            total = total + (*Ptr<long>(texts + i * 16 + 8) & 9223372036854775807)
            i = i + 1
        }
    }

    if total > 2147483647 {
        AllocationFailed(total)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(total)
        p[0] = 91
        mut long at = 1
        mut long i = 0
        while i < count {
            if i > 0 {
                p[at] = 44
                p[at + 1] = 32
                at = at + 2
            }

            byte* from = Ptr<byte>(*Ptr<long>(texts + i * 16))
            long n = *Ptr<long>(texts + i * 16 + 8) & 9223372036854775807
            mut long j = 0
            while j < n {
                p[at + j] = from[j]
                j = j + 1
            }

            at = at + n
            i = i + 1
        }

        p[at] = 93
        text = string.FromRaw(p, total)
    }

    return text
}

// Whether two strings hold the same bytes (T18).
pub bool Same(string first, string second) {
    long a = long(first.Bytes.Count)
    if a != long(second.Bytes.Count) {
        return false
    }

    mut bool same = true
    raw {
        byte* x = first.Pointer
        byte* y = second.Pointer
        mut long i = 0
        while i < a && same {
            if x[i] != y[i] {
                same = false
            }

            i = i + 1
        }
    }

    return same
}

// The order of two strings, below 0, 0 or above 0: the first byte in which they differ, and where one starts the other, the shorter
// first, as Rust's `Ord` for `str` compares them; in UTF-8 that is the order of their code points (T32).
pub int Order(string first, string second) {
    long a = long(first.Bytes.Count)
    long b = long(second.Bytes.Count)
    mut long shared = a
    if b < a {
        shared = b
    }

    mut int order = 0
    raw {
        byte* x = first.Pointer
        byte* y = second.Pointer
        mut long i = 0
        while i < shared && order == 0 {
            order = int(x[i]) - int(y[i])
            i = i + 1
        }
    }

    if order == 0 && a != b {
        order = 1
        if a < b {
            order = -1
        }
    }

    return order
}

// The byte at position `at` of the `count` bytes at `bytes`, and -1 past them.
long ByteAt(byte* bytes, long count, long at) {
    mut long b = -1
    if at < count {
        raw {
            b = long(bytes[at])
        }
    }

    return b
}

// The UTF-8 sequence that starts at position `at` of the `count` bytes at `bytes`, read as Rust's
// `str::from_utf8` reads it, which takes no overlong form, no surrogate and nothing above U+10FFFF:
// its length where it is valid, and else the negative of the count of its bytes that begin a valid
// sequence, at least 1, the maximal part of a sequence that Rust's `String::from_utf8_lossy` and the
// Unicode Standard's recommended practice read as one U+FFFD (T15).
long Utf8Sequence(byte* bytes, long count, long at) {
    long first = ByteAt(bytes, count, at)
    if first < 128 {
        return 1
    }

    mut long width = 0
    mut long low = 128
    mut long high = 191
    if first >= 194 && first <= 223 {
        width = 2
    } else if first >= 224 && first <= 239 {
        width = 3
        if first == 224 {
            low = 160
        } else if first == 237 {
            high = 159
        }
    } else if first >= 240 && first <= 244 {
        width = 4
        if first == 240 {
            low = 144
        } else if first == 244 {
            high = 143
        }
    } else {
        return -1
    }

    long second = ByteAt(bytes, count, at + 1)
    if second < low || second > high {
        return -1
    }

    mut long i = 2
    while i < width {
        long b = ByteAt(bytes, count, at + i)
        if b < 128 || b > 191 {
            return -i
        }

        i = i + 1
    }

    return width
}

// The count of the bytes in front of the first sequence of the `count` bytes at `bytes` that is not
// UTF-8, as Rust's `Utf8Error::valid_up_to` counts them, and -1 where every sequence is UTF-8: what
// `string.FromUtf8` puts into `InvalidUtf8` (T15; the owner, 2026-10-29, "Union, as Rust"). Every
// sequence is read through `Utf8Sequence`, and the first 16 bytes of a run of ASCII byte by byte; a
// longer run is skipped as Rust 1.82's `run_utf8_validation` skips one: byte by byte up to an address
// that is a multiple of 8, from there two words of 8 bytes at a time while both lie inside the bytes and
// neither holds a byte of 128 or more, then byte by byte up to the first byte of 128 or more. A word is
// read only at a multiple of 8, since the read through a pointer is emitted with no alignment written,
// which LLVM's language reference reads as the ABI alignment of the type, 8 for a `ulong`.
pub long Utf8Invalid(byte* bytes, long count) {
    long blocksEnd = count - 15
    mut long at = 0
    while at < count {
        long n = Utf8Sequence(bytes, count, at)
        if n < 0 {
            return at
        }

        at = at + n
        if n == 1 {
            mut long limit = at + 15
            if limit > count {
                limit = count
            }

            raw {
                while at < limit && bytes[at] < 128 {
                    at = at + 1
                }

                if at == limit {
                    while at < count && bytes[at] < 128 && (long(bytes + at) & 7) != 0 {
                        at = at + 1
                    }

                    if (long(bytes + at) & 7) == 0 {
                        while at < blocksEnd {
                            ulong u = *Ptr<ulong>(bytes + at)
                            ulong v = *Ptr<ulong>(bytes + at + 8)
                            if ((u | v) & 0x8080808080808080UL) != 0 {
                                break
                            }

                            at = at + 16
                        }
                    }

                    while at < count && bytes[at] < 128 {
                        at = at + 1
                    }
                }
            }
        }
    }

    return -1
}

// The text of the `count` bytes at `bytes` with each maximal part of a sequence that is not UTF-8 read
// as U+FFFD, the bytes 239, 191 and 189: `string.FromUtf8Lossy` of bytes that hold such a part (T15).
// A text of more bytes than the largest `int` ends the process as a longer string does.
pub string Utf8Lossy(byte* bytes, long count) {
    mut long size = 0
    mut long at = 0
    while at < count {
        long n = Utf8Sequence(bytes, count, at)
        if n < 0 {
            size = size + 3
            at = at - n
        } else {
            size = size + n
            at = at + n
        }
    }

    if size > 2147483647 {
        AllocationFailed(size)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(size)
        mut long to = 0
        at = 0
        while at < count {
            long n = Utf8Sequence(bytes, count, at)
            if n < 0 {
                p[to] = 239
                p[to + 1] = 191
                p[to + 2] = 189
                to = to + 3
                at = at - n
            } else {
                mut long i = 0
                while i < n {
                    p[to + i] = bytes[at + i]
                    i = i + 1
                }

                to = to + n
                at = at + n
            }
        }

        text = string.FromRaw(p, size)
    }

    return text
}

// The bytes of a text written to standard error, each piece in as many write calls as it takes; a
// write the system refuses ends the writing there, since nothing more can be said.
void WriteError(string text) {
    long count = long(text.Bytes.Count)
    mut long done = 0
    while done < count {
        mut long written = -1
        raw {
            written = sys.Write(2, text.Pointer + done, count - done)
        }

        if written <= 0 {
            return
        }

        done = done + written
    }
}

// The decimal digits of a number written to standard error one at a time, so that the error line
// allocates nothing.
void WriteNumber(ulong value) {
    mut ulong unit = 1
    while value / unit >= 10 {
        unit = unit * 10
    }

    while unit > 0 {
        mut byte digit = byte(value / unit % 10 + 48)
        raw {
            sys.Write(2, &digit, 1)
        }

        unit = unit / 10
    }
}

// The text of an infinity or of NaN (A14).
string NoDigits(bool nan, bool negative) {
    if nan {
        return "NaN"
    }

    if negative {
        return "-Infinity"
    }

    return "Infinity"
}

// The text of a zero, `-0` for a negative one (A14).
string ZeroText(bool negative) {
    if negative {
        return "-0"
    }

    return "0"
}

// The text of `digits` times ten to the `power`, `-` before it when `negative`, as .NET writes a
// `double` (`precision` 17) or a `float` (9) with the invariant culture: where the part before the
// point would take more places than both the count of the digits and the precision, or more than
// three zeros would stand between the point and the first digit, the exponent form `1.5E+09`, with
// `E`, the sign and two digits or more; otherwise the digits with the point among them, after `0.`
// and zeros, or before zeros.
string DecimalText(bool negative, ulong digits, int power, int precision) {
    mut int count = 1
    mut ulong rest = digits / 10
    while rest > 0 {
        count = count + 1
        rest = rest / 10
    }

    int scale = count + power
    mut long sign = 0
    if negative {
        sign = 1
    }

    mut string text = ""
    if (scale > count && scale > precision) || scale < -3 {
        mut int magnitude = scale - 1
        mut byte mark = 43
        if magnitude < 0 {
            magnitude = -magnitude
            mark = 45
        }

        mut int width = 2
        if magnitude >= 100 {
            width = 3
        }

        mut long point = 0
        if count > 1 {
            point = 1
        }

        long at = sign + point + long(count)
        long total = at + 2 + long(width)
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign + point, digits, count)
            if count > 1 {
                p[sign] = p[sign + 1]
                p[sign + 1] = 46
            }

            p[at] = 69
            p[at + 1] = mark
            WriteDigits(p + at + 2, ulong(magnitude), width)
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else if scale <= 0 {
        long zeros = long(-scale)
        long total = sign + 2 + zeros + long(count)
        raw {
            byte* p = string.Allocate(total)
            p[sign] = 48
            p[sign + 1] = 46
            mut long i = 0
            while i < zeros {
                p[sign + 2 + i] = 48
                i = i + 1
            }

            WriteDigits(p + sign + 2 + zeros, digits, count)
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else if scale >= count {
        long total = sign + long(scale)
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign, digits, count)
            mut long i = sign + long(count)
            while i < total {
                p[i] = 48
                i = i + 1
            }

            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else {
        long total = sign + long(count) + 1
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign + 1, digits, count)
            mut long i = 0
            while i < long(scale) {
                p[sign + i] = p[sign + 1 + i]
                i = i + 1
            }

            p[sign + long(scale)] = 46
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    }

    return text
}

// The `count` decimal digits of `value` at `p`, the last one at `p + count - 1`, which an interpolation
// writes an integer's digits into its block with (L6).
pub void WriteDigits(byte* p, ulong value, int count) {
    mut ulong v = value
    mut long i = long(count) - 1
    raw {
        while i >= 0 {
            p[i] = byte(v % 10 + 48)
            v = v / 10
            i = i - 1
        }
    }
}

// The digits of a finite nonzero `double`, given the fields of its 64 bits, and the power of ten they are
// multiplied by (Ryu's d2d): the 128-bit products of 5^q and of 2^k / 5^q bracket the value and its two
// bounds, and the digits are cut from the right while the bounds still differ.
void DoubleDigits(ulong mantissa, int exponent, mut ulong digits, mut int power) {
    mut int e2 = 1 - 1077
    mut ulong m2 = mantissa
    if exponent != 0 {
        e2 = exponent - 1077
        m2 = 4503599627370496 | mantissa
    }

    bool even = (m2 & 1) == 0
    ulong mv = 4 * m2
    mut ulong mmShift = 0
    if mantissa != 0 || exponent <= 1 {
        mmShift = 1
    }

    mut ulong vr = 0
    mut ulong vp = 0
    mut ulong vm = 0
    mut int e10 = 0
    mut bool vmZeros = false
    mut bool vrZeros = false
    mut ulong high = 0
    if e2 >= 0 {
        mut int q = Log10Pow2(e2)
        if e2 > 3 {
            q = q - 1
        }

        e10 = q
        int i = -e2 + q + 125 + Pow5Bits(q) - 1
        ulong low = InversePow5(q, mut high)
        vr = MulShift64(mv, low, high, i)
        vp = MulShift64(mv + 2, low, high, i)
        vm = MulShift64(mv - 1 - mmShift, low, high, i)
        if q <= 21 {
            if mv % 5 == 0 {
                vrZeros = Fives(mv) >= q
            } else if even {
                vmZeros = Fives(mv - 1 - mmShift) >= q
            } else if Fives(mv + 2) >= q {
                vp = vp - 1
            }
        }
    } else {
        mut int q = Log10Pow5(-e2)
        if -e2 > 1 {
            q = q - 1
        }

        e10 = q + e2
        int i = -e2 - q
        int j = q - Pow5Bits(i) + 125
        ulong low = Pow5(i, mut high)
        vr = MulShift64(mv, low, high, j)
        vp = MulShift64(mv + 2, low, high, j)
        vm = MulShift64(mv - 1 - mmShift, low, high, j)
        if q <= 1 {
            vrZeros = true
            if even {
                vmZeros = mmShift == 1
            } else {
                vp = vp - 1
            }
        } else if q < 63 {
            vrZeros = (mv & ((ulong(1) << q) - 1)) == 0
        }
    }

    mut int removed = 0
    digits = Shortest(vr, vp, vm, vmZeros, vrZeros, even, 0, mut removed)
    power = e10 + removed
}

// The same for a finite nonzero `float` (Ryu's f2d), through the high 64 bits of the same powers: one
// removed digit is computed beside them, since the 64-bit products give one digit fewer.
void FloatDigits(ulong mantissa, int exponent, mut ulong digits, mut int power) {
    mut int e2 = 1 - 152
    mut ulong m2 = mantissa
    if exponent != 0 {
        e2 = exponent - 152
        m2 = 8388608 | mantissa
    }

    bool even = (m2 & 1) == 0
    ulong mv = 4 * m2
    ulong mp = mv + 2
    mut ulong mmShift = 0
    if mantissa != 0 || exponent <= 1 {
        mmShift = 1
    }

    ulong mm = mv - 1 - mmShift
    mut ulong vr = 0
    mut ulong vp = 0
    mut ulong vm = 0
    mut int e10 = 0
    mut bool vmZeros = false
    mut bool vrZeros = false
    mut ulong last = 0
    if e2 >= 0 {
        int q = Log10Pow2(e2)
        e10 = q
        int i = -e2 + q + 61 + Pow5Bits(q) - 1
        ulong factor = InverseTop(q)
        vr = MulShift32(mv, factor, i)
        vp = MulShift32(mp, factor, i)
        vm = MulShift32(mm, factor, i)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            last = MulShift32(mv, InverseTop(q - 1), -e2 + q - 1 + 61 + Pow5Bits(q - 1) - 1) % 10
        }

        if q <= 9 {
            if mv % 5 == 0 {
                vrZeros = Fives(mv) >= q
            } else if even {
                vmZeros = Fives(mm) >= q
            } else if Fives(mp) >= q {
                vp = vp - 1
            }
        }
    } else {
        int q = Log10Pow5(-e2)
        e10 = q + e2
        int i = -e2 - q
        int j = q - Pow5Bits(i) + 61
        ulong factor = Pow5Top(i)
        vr = MulShift32(mv, factor, j)
        vp = MulShift32(mp, factor, j)
        vm = MulShift32(mm, factor, j)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            last = MulShift32(mv, Pow5Top(i + 1), q - 1 - Pow5Bits(i + 1) + 61) % 10
        }

        if q <= 1 {
            vrZeros = true
            if even {
                vmZeros = mmShift == 1
            } else {
                vp = vp - 1
            }
        } else if q < 31 {
            vrZeros = (mv & ((ulong(1) << (q - 1)) - 1)) == 0
        }
    }

    mut int removed = 0
    digits = Shortest(vr, vp, vm, vmZeros, vrZeros, even, last, mut removed)
    power = e10 + removed
}

// The end of Ryu's algorithm: the fewest digits between the bounds `vm` and `vp` (each one a bound
// itself where its zeros say the bound is exact and `even` lets it count), cut from the right of `vr`,
// rounded by the digits cut, half to even where the value ends in a 5 and zeros; `removed` counts the
// digits cut.
ulong Shortest(ulong r, ulong p, ulong m, bool mZeros, bool rZeros, bool even, ulong lastDigit, mut int removed) {
    mut ulong vr = r
    mut ulong vp = p
    mut ulong vm = m
    mut bool vmZeros = mZeros
    mut bool vrZeros = rZeros
    mut ulong last = lastDigit
    if vmZeros || vrZeros {
        while vp / 10 > vm / 10 {
            vmZeros = vmZeros && vm % 10 == 0
            vrZeros = vrZeros && last == 0
            last = vr % 10
            vr = vr / 10
            vp = vp / 10
            vm = vm / 10
            removed = removed + 1
        }

        if vmZeros {
            while vm % 10 == 0 {
                vrZeros = vrZeros && last == 0
                last = vr % 10
                vr = vr / 10
                vp = vp / 10
                vm = vm / 10
                removed = removed + 1
            }
        }

        if vrZeros && last == 5 && vr % 2 == 0 {
            last = 4
        }

        if (vr == vm && (!even || !vmZeros)) || last >= 5 {
            return vr + 1
        }

        return vr
    }

    while vp / 10 > vm / 10 {
        last = vr % 10
        vr = vr / 10
        vp = vp / 10
        vm = vm / 10
        removed = removed + 1
    }

    if vr == vm || last >= 5 {
        return vr + 1
    }

    return vr
}

// The top 125 bits of 5^i, i from 0 to 325: the low 64 returned, the high 64 into `high`. Computed from the
// power of its row and 5^offset, then corrected by the two bits of `Pow5Offsets`.
ulong Pow5(int i, mut ulong high) {
    int row = i / 26
    int offset = i - row * 26
    ulong low = Pow5Low(row)
    high = Pow5High(row)
    if offset == 0 {
        return low
    }

    ulong m = PowerOf5(offset)
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    ulong low0 = Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    int delta = Pow5Bits(i) - Pow5Bits(row * 26)
    high = ShiftRight(sum, high1, delta)
    return ShiftRight(low0, sum, delta) + ((ulong(Pow5Offsets(i / 16)) >> ((i % 16) * 2)) & 3)
}

// 2^(125 + n - 1) / 5^i plus one, n the bits of 5^i, i from 0 to 291: the low 64 returned, the high 64 into
// `high`. Computed from the inverse power of the row above it, itself, times 5^offset, where Rust's `ryu`
// multiplies it less one and adds one, so the two-bit corrections of `InversePow5Offsets` are a table of
// this function's own, each stored one above the difference. `FloatingTests` holds the texts they give
// against what .NET writes.
ulong InversePow5(int i, mut ulong high) {
    int row = (i + 25) / 26
    int offset = row * 26 - i
    ulong low = InversePow5Low(row)
    high = InversePow5High(row)
    if offset == 0 {
        return low
    }

    ulong m = PowerOf5(offset)
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    ulong low0 = Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    int delta = Pow5Bits(row * 26) - Pow5Bits(i)
    high = ShiftRight(sum, high1, delta)
    return ShiftRight(low0, sum, delta) +% ((ulong(InversePow5Offsets(i / 16)) >> ((i % 16) * 2)) & 3) -% 1
}

// The high 64 bits of 5^i, for a `float` (Ryu's f2s through the table of the `double`).
ulong Pow5Top(int i) {
    mut ulong high = 0
    Pow5(i, mut high)
    return high
}

// The high 64 bits of 2^(125 + n - 1) / 5^i plus one, for a `float`.
ulong InverseTop(int i) {
    mut ulong high = 0
    InversePow5(i, mut high)
    return high + 1
}

// 5^n, n from 0 to 25.
ulong PowerOf5(int n) {
    mut ulong p = 1
    mut int k = 0
    while k < n {
        p = p * 5
        k = k + 1
    }

    return p
}

// The 128-bit product of two 64-bit numbers, from the products of their 32-bit halves: the low 64 bits
// returned, the high 64 into `high`.
ulong Multiply(ulong a, ulong b, mut ulong high) {
    ulong a0 = a & 4294967295
    ulong a1 = a >> 32
    ulong b0 = b & 4294967295
    ulong b1 = b >> 32
    ulong b00 = a0 * b0
    ulong mid1 = a1 * b0 + (b00 >> 32)
    ulong mid2 = a0 * b1 + (mid1 & 4294967295)
    high = a1 * b1 + (mid1 >> 32) + (mid2 >> 32)
    return (mid2 << 32) | (b00 & 4294967295)
}

// The 64 bits of the 128-bit number `high`:`low` from bit `distance` up, 0 < distance < 64.
ulong ShiftRight(ulong low, ulong high, int distance) => (high << (64 - distance)) | (low >> distance)

// m times the 128-bit number `high`:`low`, shifted right by j bits, as 64 bits (m below 2^55); j lies above 64
// for every exponent, as `FloatingTests` reaches through the largest value with each, so that `ShiftRight` takes
// a distance from 1 to 63.
ulong MulShift64(ulong m, ulong low, ulong high, int j) {
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    return ShiftRight(sum, high1, j - 64)
}

// m times a 64-bit factor, shifted right by `shift` bits, more than 32 (m below 2^32).
ulong MulShift32(ulong m, ulong factor, int shift) {
    ulong low = m * (factor & 4294967295)
    ulong high = m * (factor >> 32)
    return ((low >> 32) + high) >> (shift - 32)
}

// How often 5 divides `value`, which is not zero.
int Fives(ulong value) {
    mut ulong v = value
    mut int count = 0
    while v % 5 == 0 {
        v = v / 5
        count = count + 1
    }

    return count
}

// The bits of 5^e, e from 1 to 3528, and 1 for e = 0.
int Pow5Bits(int e) => int((long(e) * 1217359) >> 19) + 1

// The decimal exponent of 2^e rounded down, e from 0 to 1650.
int Log10Pow2(int e) => (e * 78913) >> 18

// The decimal exponent of 5^e rounded down, e from 0 to 2620.
int Log10Pow5(int e) => (e * 732923) >> 20

// The low 64 bits of the top 125 bits of 5^(26 * row), rows 0 to 12 (Ryu's small table, DOUBLE_POW5_SPLIT2).
ulong Pow5Low(int row) => match row {
    0 => 0x0
    1 => 0x0
    2 => 0xE549208B31ADB10
    3 => 0x6DC6AD264D8F0866
    4 => 0xEB1DBD923D8596CA
    5 => 0xB4C1B80B22AE923C
    6 => 0x5BB28B4E8F7E4C30
    7 => 0xF08AED437682D4FB
    8 => 0xB4EE134AD99BF150
    9 => 0x16499ECB70C25F03
    10 => 0x85A56EAD360865B0
    11 => 0x93DB1D57999890B
    else => 0xCF38BB735E3F36AC
}

// Their high 64 bits.
ulong Pow5High(int row) => match row {
    0 => 0x1000000000000000
    1 => 0x14ADF4B7320334B9
    2 => 0x1ABA4714957D300D
    3 => 0x1145B7E285BF98F5
    4 => 0x1652EFDC6018A1FC
    5 => 0x1CDA62055B2D9D83
    6 => 0x12A5568B9F52F416
    7 => 0x1819651531F9E78F
    8 => 0x1F25C186A6F04C28
    9 => 0x1420EB449C8842E6
    10 => 0x1A03FDE214CAF085
    11 => 0x10CFEB353A97DAD8
    else => 0x15BAAF44FA52673E
}

// The low 64 bits of 2^(125 + n - 1) / 5^(26 * row) plus one, n the bits of the power, rows 0 to 12
// (Ryu's small table, DOUBLE_POW5_INV_SPLIT2).
ulong InversePow5Low(int row) => match row {
    0 => 0x1
    1 => 0x52A6C95FC0655034
    2 => 0x7CA8D50071DFC806
    3 => 0x6520247D3556476E
    4 => 0x6139CDD76802E6E9
    5 => 0xF951A7FF43DE8C79
    6 => 0x7BE8BEE8D6E957E8
    7 => 0x8BD3F9E999A423EA
    8 => 0x848F973CB3EE3CE
    9 => 0x153285EBB9EFBFA2
    10 => 0xADEEE7F86C07B696
    11 => 0x4D686A4EAF182222
    else => 0x98C0A106E09EBD9F
}

// Their high 64 bits.
ulong InversePow5High(int row) => match row {
    0 => 0x2000000000000000
    1 => 0x18C240C4AECB13BB
    2 => 0x1327FC58DA0F6FF5
    3 => 0x1DA48CE468E7C702
    4 => 0x16EF5B40C2FC7779
    5 => 0x11BEBDF578B2F391
    6 => 0x1B758D848FAC54B0
    7 => 0x153EDA614071A3B7
    8 => 0x10701BD527B4978C
    9 => 0x196FBB9BB44DB44D
    10 => 0x13AE3591F5B4D936
    11 => 0x1E74404F3DAADA91
    else => 0x17900EA4FDA7C257
}

// What the low 64 bits of 5^i computed from its row lack, two bits for each i, 16 to a word: words 0 to 20.
uint Pow5Offsets(int row) => match row {
    0 => 0x0
    1 => 0x0
    2 => 0x0
    3 => 0x0
    4 => 0x40000000
    5 => 0x59695995
    6 => 0x55545555
    7 => 0x56555515
    8 => 0x41150504
    9 => 0x40555410
    10 => 0x44555145
    11 => 0x44504540
    12 => 0x45555550
    13 => 0x40004000
    14 => 0x96440440
    15 => 0x55565565
    16 => 0x54454045
    17 => 0x40154151
    18 => 0x55559155
    19 => 0x51405555
    else => 0x105
}

// The same for 2^(125 + n - 1) / 5^i plus one, each plus one: words 0 to 18.
uint InversePow5Offsets(int row) => match row {
    0 => 0xAAAA9AA9
    1 => 0x5556AA5A
    2 => 0x25555555
    3 => 0x55955959
    4 => 0x9A666559
    5 => 0x9A6AAAAA
    6 => 0x554559A6
    7 => 0x515A5554
    8 => 0x55555554
    9 => 0x69555A96
    10 => 0x555A99A9
    11 => 0xAA655699
    12 => 0xA66965A9
    13 => 0x96959555
    14 => 0x56555566
    15 => 0x55965A55
    16 => 0xAAA6A955
    17 => 0x5AAAAAAA
    else => 0x56
}

// ---- decimal (T2) ----------------------------------------------------------------------------------
//
// A `decimal` is C#'s System.Decimal, which the emitted code passes as two 64-bit words: the low 64 bits of its 96-bit
// integer, then the high 32 bits with System.Decimal's flags above them, the scale in bits 48 to 55 and the sign in bit 63.
// Its value is the integer divided by ten to the scale, from 0 to 28. The arithmetic, the comparison and the conversion into
// a `double` compute what System.Decimal computes, digit for digit and scale for scale (section 4); the conversion from a
// `double` takes its exact binary value (the owner, 2026-10-28, "Exact binary value"), and `%` the exact remainder where
// System.Decimal throws for one that fits ("Exact remainder"); a zero they compute has no sign (the owner, 2026-10-28, "None, as
// rust_decimal"). A result that leaves the range makes them return false, which the emitted code raises as `overflow` in
// every build (the owner, 2026-10-28, "Raise in every build"); the emitted code raises `divide-by-zero` before a division
// or a remainder by zero (T25).

// The sum of two `decimal`s: the exact sum at the larger of the two scales, brought into 96 bits by `Fit`. The emitted code
// subtracts by turning the sign of the second.
pub bool DecimalAdd(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int aScale = DecimalScale(aHigh)
    int bScale = DecimalScale(bHigh)
    mut ulong a0 = aLow
    mut ulong a1 = aHigh & 4294967295
    mut ulong a2 = 0
    mut ulong b0 = bLow
    mut ulong b1 = bHigh & 4294967295
    mut ulong b2 = 0
    mut int scale = aScale
    if aScale < bScale {
        ScaleUp(mut a0, mut a1, mut a2, bScale - aScale)
        scale = bScale
    } else if bScale < aScale {
        ScaleUp(mut b0, mut b1, mut b2, aScale - bScale)
    }

    mut bool negative = aHigh >> 63 == 1
    if negative == (bHigh >> 63 == 1) {
        Add192(mut a0, mut a1, mut a2, b0, b1, b2)
    } else if Below192(a0, a1, a2, b0, b1, b2) {
        Subtract192(mut b0, mut b1, mut b2, a0, a1, a2)
        a0 = b0
        a1 = b1
        a2 = b2
        negative = !negative
    } else {
        Subtract192(mut a0, mut a1, mut a2, b0, b1, b2)
    }

    return Fit(a0, a1, a2, scale, negative, mut low, mut high)
}

// The product of two `decimal`s: the exact product at the sum of the two scales, brought into 96 bits and a scale of at most
// 28 by `Fit`. Two numbers of 32 bits whose scales add up to more than 47 give 0 at the scale 0, and so does a zero beside a
// number of more than 32 bits, as System.Decimal gives them.
pub bool DecimalMultiply(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int scale = DecimalScale(aHigh) + DecimalScale(bHigh)
    bool negative = (aHigh ^ bHigh) >> 63 == 1
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    low = 0
    high = 0
    if a1 == 0 && aLow <= 4294967295 && b1 == 0 && bLow <= 4294967295 {
        if scale > 47 {
            return true
        }

        return Fit(aLow * bLow, 0, 0, scale, negative, mut low, mut high)
    }

    mut ulong p1 = 0
    ulong p0 = Multiply(aLow, bLow, mut p1)
    mut ulong p2 = a1 * b1
    mut ulong h = 0
    ulong l = Multiply(aLow, b1, mut h)
    p1 = p1 +% l
    if p1 < l {
        h = h + 1
    }

    p2 = p2 + h
    h = 0
    ulong m = Multiply(a1, bLow, mut h)
    p1 = p1 +% m
    if p1 < m {
        h = h + 1
    }

    p2 = p2 + h
    if (p0 | p1 | p2) == 0 {
        return true
    }

    return Fit(p0, p1, p2, scale, negative, mut low, mut high)
}

// The quotient of two `decimal`s, the divisor not zero. The integer quotient at the difference of the scales; where it is
// exact, that, at the scale 0 where the difference is below 0. Otherwise as many more digits as fit 96 bits and the scale 28,
// up to nine at a time, rounded half to even by the remainder, and its zeros at the end removed down to the scale 0
// (System.Decimal's VarDecDiv).
pub bool DecimalDivide(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    mut int scale = DecimalScale(aHigh) - DecimalScale(bHigh)
    bool negative = (aHigh ^ bHigh) >> 63 == 1
    ulong b1 = bHigh & 4294967295
    mut ulong q0 = 0
    mut ulong q1 = 0
    mut ulong r0 = 0
    mut ulong r1 = 0
    Divide96(aLow, aHigh & 4294967295, bLow, b1, mut q0, mut q1, mut r0, mut r1)
    bool inexact = (r0 | r1) != 0
    low = 0
    high = 0
    mut bool going = true
    while going {
        if (r0 | r1) == 0 {
            if scale >= 0 {
                going = false
            } else {
                mut int step = -scale
                if step > 9 {
                    step = 9
                }

                if !MultiplyFits(mut q0, mut q1, Pow10(step)) {
                    return false
                }

                scale = scale + step
            }
        } else {
            int step = ScaleRoom(q0, q1, scale)
            if step == 0 {
                if scale < 0 {
                    return false
                }

                // round by the remainder: twice it beside the divisor, a tie to the even quotient
                ulong t0 = r0 << 1
                ulong t1 = (r1 << 1) | (r0 >> 63)
                if t1 > b1 || (t1 == b1 && (t0 > bLow || (t0 == bLow && (q0 & 1) == 1))) {
                    q0 = q0 +% 1
                    if q0 == 0 {
                        q1 = q1 + 1
                    }

                    if q1 > 4294967295 {
                        // 2^96, one digit too many: 2^96 / 10 rounded, 7922816251426433759354395034
                        if scale == 0 {
                            return false
                        }

                        q0 = 11068046444225730970
                        q1 = 429496729
                        scale = scale - 1
                    }
                }

                going = false
            } else {
                // q times 10^step fits; the digits the remainder gives are added to it
                ulong power = Pow10(step)
                MultiplyFits(mut q0, mut q1, power)
                mut ulong n0 = r0
                mut ulong n1 = r1
                mut ulong n2 = 0
                MultiplyBy(mut n0, mut n1, mut n2, power)
                ulong digits = DivideBy96(n0, n1, bLow, b1, mut r0, mut r1)
                q0 = q0 +% digits
                if q0 < digits {
                    q1 = q1 + 1
                }

                scale = scale + step
                if q1 > 4294967295 {
                    // one digit too many: the 97 bits divided by 10, rounded half to even by that digit and the remainder
                    scale = scale - 1
                    if scale < 0 {
                        return false
                    }

                    mut ulong w0 = q0
                    mut ulong w1 = q1
                    mut ulong w2 = 0
                    ulong digit = DivideSmall(mut w0, mut w1, mut w2, 10)
                    q0 = w0
                    q1 = w1
                    if digit > 5 || (digit == 5 && ((r0 | r1) != 0 || (q0 & 1) == 1)) {
                        q0 = q0 +% 1
                        if q0 == 0 {
                            q1 = q1 + 1
                        }
                    }

                    going = false
                }
            }
        }
    }

    if inexact {
        Unscale(mut q0, mut q1, mut scale)
    }

    low = q0
    high = Pack(q1, scale, negative && (q0 | q1) != 0)
    return true
}

// The remainder of two `decimal`s, the divisor not zero: the dividend itself where it is zero or below the divisor in
// magnitude; otherwise the exact remainder at the larger of the two scales, with the sign of the dividend (T18; System.Decimal's
// VarDecMod).
pub void DecimalRemainder(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int aScale = DecimalScale(aHigh)
    int bScale = DecimalScale(bHigh)
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    bool negative = aHigh >> 63 == 1
    low = aLow
    high = Pack(a1, aScale, negative && (aLow | a1) != 0)
    if (aLow | a1) == 0 {
        return
    }

    int order = CompareMagnitudes(aLow, a1, aScale, bLow, b1, bScale)
    if order < 0 {
        return
    }

    mut int scale = aScale
    if bScale > aScale {
        scale = bScale
    }

    low = 0
    high = Pack(0, scale, false)
    if order == 0 {
        return
    }

    mut ulong q0 = 0
    mut ulong q1 = 0
    mut ulong r0 = 0
    mut ulong r1 = 0
    if aScale >= bScale {
        // the divisor at the dividend's scale, which stays below the dividend
        mut ulong d0 = bLow
        mut ulong d1 = b1
        mut ulong d2 = 0
        ScaleUp(mut d0, mut d1, mut d2, aScale - bScale)
        Divide96(aLow, a1, d0, d1, mut q0, mut q1, mut r0, mut r1)
    } else {
        // the dividend at the divisor's scale, nine digits at a time, each time only its remainder kept
        Divide96(aLow, a1, bLow, b1, mut q0, mut q1, mut r0, mut r1)
        mut int rest = bScale - aScale
        while rest > 0 {
            mut int step = rest
            if step > 9 {
                step = 9
            }

            mut ulong n0 = r0
            mut ulong n1 = r1
            mut ulong n2 = 0
            MultiplyBy(mut n0, mut n1, mut n2, Pow10(step))
            DivideBy96(n0, n1, bLow, b1, mut r0, mut r1)
            rest = rest - step
        }
    }

    low = r0
    high = Pack(r1, scale, negative && (r0 | r1) != 0)
}

// -1, 0 or 1 as the first `decimal` is below, equal to or above the second, by their values: 1.5 equals 1.50, and 0 equals -0.
pub int DecimalCompare(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh) {
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    bool aZero = (aLow | a1) == 0
    bool bZero = (bLow | b1) == 0
    if aZero && bZero {
        return 0
    }

    bool aNegative = !aZero && aHigh >> 63 == 1
    bool bNegative = !bZero && bHigh >> 63 == 1
    if aNegative != bNegative {
        if aNegative {
            return -1
        }

        return 1
    }

    int order = CompareMagnitudes(aLow, a1, DecimalScale(aHigh), bLow, b1, DecimalScale(bHigh))
    if aNegative {
        return -order
    }

    return order
}

// A `double`, given its 64 bits, as a `decimal` (T26): its exact binary value, rounded half to even at the largest scale up to
// 28 at which the digits fit 96 bits, and its zeros at the end removed down to the scale 0 (the owner, 2026-10-28, "Exact
// binary value"); a zero has no sign. False for NaN, an infinity and a magnitude of 2^96 or more, which the emitted code raises
// as `overflow` in every build (the owner, 2026-10-28, "Raise in every build"). A `float` comes as the `double` that holds it.
pub bool DecimalFromDouble(ulong bits, mut ulong low, mut ulong high) {
    int exponent = int((bits >> 52) & 2047)
    ulong fraction = bits & 4503599627370495
    low = 0
    high = 0
    if exponent >= 1119 {
        return false
    }

    if exponent == 0 && fraction == 0 {
        return true
    }

    mut ulong m = fraction
    mut int e2 = -1074
    if exponent != 0 {
        m = fraction | 4503599627370496
        e2 = exponent - 1075
    }

    bool negative = bits >> 63 == 1
    if e2 >= 0 {
        // an integer below 2^96
        low = m << e2
        mut ulong top = 0
        if e2 > 0 {
            top = m >> (64 - e2)
        }

        high = Pack(top, 0, negative)
        return true
    }

    mut int scale = 28
    mut ulong d0 = 0
    mut ulong d1 = 0
    mut bool fits = false
    while !fits {
        mut ulong w0 = m
        mut ulong w1 = 0
        mut ulong w2 = 0
        ScaleUp(mut w0, mut w1, mut w2, scale)
        fits = ShiftRound(w0, w1, w2, -e2, mut d0, mut d1)
        if !fits {
            scale = scale - 1
        }
    }

    Unscale(mut d0, mut d1, mut scale)
    low = d0
    high = Pack(d1, scale, negative && (d0 | d1) != 0)
    return true
}

// A `decimal` as a `double`, as C# computes it (the owner, 2026-10-28, "As C# computes it"): the 96-bit integer as a `double`,
// its low 64 bits and its high 32 bits each converted, divided by ten to the scale as a `double`, the sign turned for a
// negative one. A `float` is this `double` rounded, as C# rounds it.
pub double DecimalToDouble(ulong low, ulong high) {
    double value = (double(low) + double(high & 4294967295) * 18446744073709551616.0) / DoublePower10(DecimalScale(high))
    if high >> 63 == 1 {
        return -value
    }

    return value
}

// The integer part of a `decimal`'s magnitude, its fraction dropped (T26), into `magnitude`; false where it takes more than
// 64 bits.
pub bool DecimalTruncate(ulong low, ulong high, mut ulong magnitude) {
    mut ulong q0 = low
    mut ulong q1 = high & 4294967295
    mut ulong q2 = 0
    mut int scale = DecimalScale(high)
    while scale > 0 {
        mut int step = scale
        if step > 9 {
            step = 9
        }

        DivideSmall(mut q0, mut q1, mut q2, Pow10(step))
        scale = scale - step
    }

    magnitude = q0
    return q1 == 0
}

// The text of a `decimal` (A8): the digits it holds, as many after the point as its scale says, `1.50` for 1.50m and `0.00` for
// a zero at the scale 2, and `-` before them where its sign is set, a negative zero's too (the owner, 2026-10-28, "Sign, as
// Rust").
pub string TextOfDecimal(ulong low, ulong high) {
    int scale = DecimalScale(high)
    bool negative = high >> 63 == 1
    mut ulong q0 = low
    mut ulong q1 = high & 4294967295
    mut ulong q2 = 0
    ulong r1 = DivideSmall(mut q0, mut q1, mut q2, 1000000000)
    ulong r2 = DivideSmall(mut q0, mut q1, mut q2, 1000000000)
    mut ulong bottom = r2 * 1000000000 + r1
    mut ulong top = q0
    mut long count = DigitCount(bottom)
    if top > 0 {
        count = 18 + DigitCount(top)
    }

    if count < long(scale) + 1 {
        count = long(scale) + 1
    }

    mut long length = count
    if scale > 0 {
        length = length + 1
    }

    if negative {
        length = length + 1
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(length)
        mut long i = length - 1
        mut long j = 0
        while j < count {
            if scale > 0 && j == long(scale) {
                p[i] = 46
                i = i - 1
            }

            mut ulong digit = 0
            if j < 18 {
                digit = bottom % 10
                bottom = bottom / 10
            } else {
                digit = top % 10
                top = top / 10
            }

            p[i] = byte(digit + 48)
            i = i - 1
            j = j + 1
        }

        if negative {
            p[0] = 45
        }

        text = string.FromRaw(p, length)
    }

    return text
}

// The scale of a `decimal`, from its high word.
int DecimalScale(ulong high) => int((high >> 48) & 255)

// The high word of a `decimal`: the high 32 bits of its integer, its scale and its sign.
ulong Pack(ulong top, int scale, bool negative) {
    mut ulong high = top | (ulong(scale) << 48)
    if negative {
        high = high | 9223372036854775808
    }

    return high
}

// The 192-bit magnitude w2:w1:w0 at `scale` (0 to 56) as a `decimal`, as System.Decimal brings a result into its 96 bits and its
// scales (ScaleResult): divided by the fewest powers of ten that leave at most 96 bits and a scale of at most 28, and rounded
// half to even once, by all the digits removed; where the rounding reaches 2^96, by one digit more. A zero has no sign. False
// where the scale would fall below 0.
bool Fit(ulong w0, ulong w1, ulong w2, int scale, bool negative, mut ulong low, mut ulong high) {
    mut ulong v0 = w0
    mut ulong v1 = w1
    mut ulong v2 = w2
    mut int s = scale
    mut int cut = 0
    if s > 28 {
        cut = s - 28
    }

    // a lower bound of the digits to remove: 77 / 256 is below log10(2)
    int bits = Bits192(v0, v1, v2)
    if bits > 96 {
        int least = ((bits - 96) * 77) >> 8
        if least > cut {
            cut = least
        }
    }

    if cut > s {
        return false
    }

    mut ulong remainder = 0
    mut ulong divisor = 1
    mut ulong sticky = 0
    while cut > 0 || v2 != 0 || v1 > 4294967295 {
        if cut == 0 {
            if s == 0 {
                return false
            }

            cut = 1
        }

        mut int step = cut
        if step > 9 {
            step = 9
        }

        sticky = sticky | remainder
        divisor = Pow10(step)
        remainder = DivideSmall(mut v0, mut v1, mut v2, divisor)
        cut = cut - step
        s = s - step
    }

    if divisor > 1 {
        ulong half = divisor / 2
        if remainder > half || (remainder == half && (sticky != 0 || (v0 & 1) == 1)) {
            v0 = v0 +% 1
            if v0 == 0 {
                v1 = v1 + 1
            }

            if v1 > 4294967295 {
                // 2^96, one digit too many: 2^96 / 10 rounded, 7922816251426433759354395034
                if s == 0 {
                    return false
                }

                v0 = 11068046444225730970
                v1 = 429496729
                s = s - 1
            }
        }
    }

    low = v0
    high = Pack(v1, s, negative && (v0 | v1) != 0)
    return true
}

// The trailing zeros of the 96-bit integer q1:q0 removed while the scale stays at least 0.
void Unscale(mut ulong q0, mut ulong q1, mut int scale) {
    while scale > 0 {
        mut ulong t0 = q0
        mut ulong t1 = q1
        mut ulong t2 = 0
        if DivideSmall(mut t0, mut t1, mut t2, 10) != 0 {
            return
        }

        q0 = t0
        q1 = t1
        scale = scale - 1
    }
}

// -1, 0 or 1 as the magnitude a1:a0 at `aScale` is below, equal to or above b1:b0 at `bScale`, compared at the larger scale.
int CompareMagnitudes(ulong a0, ulong a1, int aScale, ulong b0, ulong b1, int bScale) {
    mut ulong x0 = a0
    mut ulong x1 = a1
    mut ulong x2 = 0
    mut ulong y0 = b0
    mut ulong y1 = b1
    mut ulong y2 = 0
    if aScale < bScale {
        ScaleUp(mut x0, mut x1, mut x2, bScale - aScale)
    } else if bScale < aScale {
        ScaleUp(mut y0, mut y1, mut y2, aScale - bScale)
    }

    if Below192(x0, x1, x2, y0, y1, y2) {
        return -1
    }

    if Below192(y0, y1, y2, x0, x1, x2) {
        return 1
    }

    return 0
}

// The 96-bit a1:a0 divided by the 96-bit b1:b0, not zero: the quotient into q1:q0 and the remainder into r1:r0. A divisor of 32
// bits divides word by word; a wider one gives a quotient below 2^64, found 32 bits at a time.
void Divide96(ulong a0, ulong a1, ulong b0, ulong b1, mut ulong q0, mut ulong q1, mut ulong r0, mut ulong r1) {
    if b1 == 0 && b0 <= 4294967295 {
        mut ulong w0 = a0
        mut ulong w1 = a1
        mut ulong w2 = 0
        r0 = DivideSmall(mut w0, mut w1, mut w2, b0)
        r1 = 0
        q0 = w0
        q1 = w1
        return
    }

    mut ulong x0 = 0
    mut ulong x1 = 0
    ulong upper = DivideBy96((a1 << 32) | (a0 >> 32), 0, b0, b1, mut x0, mut x1)
    ulong lower = DivideBy96((x0 << 32) | (a0 & 4294967295), (x1 << 32) | (x0 >> 32), b0, b1, mut r0, mut r1)
    q0 = (upper << 32) | lower
    q1 = 0
}

// The 128-bit n1:n0 divided by the 96-bit b1:b0, not zero, where the quotient is below 2^32: the quotient returned and the
// remainder into r1:r0. A divisor of more than 32 bits: the quotient estimated from the top 32 bits of the divisor plus one,
// which is never above it and at most four below it, then corrected.
ulong DivideBy96(ulong n0, ulong n1, ulong b0, ulong b1, mut ulong r0, mut ulong r1) {
    if b1 == 0 && b0 <= 4294967295 {
        r0 = n0 % b0
        r1 = 0
        return n0 / b0
    }

    mut int shift = Bits(b0) - 32
    if b1 != 0 {
        shift = Bits(b1) + 32
    }

    mut ulong top = b1
    mut ulong head = n1
    if shift < 64 {
        top = ShiftRight(b0, b1, shift)
        head = ShiftRight(n0, n1, shift)
    }

    mut ulong q = head / (top + 1)
    mut ulong h = 0
    ulong m0 = Multiply(q, b0, mut h)
    ulong m1 = h + q * b1
    mut ulong x0 = n0 -% m0
    mut ulong x1 = n1 - m1
    if n0 < m0 {
        x1 = x1 - 1
    }

    while x1 > b1 || (x1 == b1 && x0 >= b0) {
        if x0 < b0 {
            x1 = x1 - 1
        }

        x0 = x0 -% b0
        x1 = x1 - b1
        q = q + 1
    }

    r0 = x0
    r1 = x1
    return q
}

// The largest power of ten, at most 9 and at most 28 - scale, by which the 96-bit q1:q0 can be multiplied and stay below
// 2^96: q at most (2^96 - 1) / 10^k (System.Decimal's SearchScale).
int ScaleRoom(ulong q0, ulong q1, int scale) {
    mut int k = 28 - scale
    if k > 9 {
        k = 9
    }

    while k > 0 && (q1 > RoomHigh(k) || (q1 == RoomHigh(k) && q0 > RoomLow(k))) {
        k = k - 1
    }

    return k
}

// (2^96 - 1) / 10^k rounded down, k from 1 to 9: the high 32 bits, then the low 64.
ulong RoomHigh(int k) => match k {
    1 => 429496729
    2 => 42949672
    3 => 4294967
    4 => 429496
    5 => 42949
    6 => 4294
    7 => 429
    8 => 42
    else => 4
}

ulong RoomLow(int k) => match k {
    1 => 11068046444225730969
    2 => 17708874310761169551
    3 => 5460236245818027278
    4 => 13458744476178488859
    5 => 12413920891843579855
    6 => 17843461755522954439
    7 => 9163043805036116090
    8 => 17518374046842208063
    else => 5441186219426131129
}

// The 96-bit q1:q0 times m, in place, where the product stays below 2^96; false where it does not.
bool MultiplyFits(mut ulong q0, mut ulong q1, ulong m) {
    mut ulong w0 = q0
    mut ulong w1 = q1
    mut ulong w2 = 0
    MultiplyBy(mut w0, mut w1, mut w2, m)
    if w2 != 0 || w1 > 4294967295 {
        return false
    }

    q0 = w0
    q1 = w1
    return true
}

// w2:w1:w0 divided by 2^k, k at least 1, rounded half to even into d1:d0; false where the result reaches 2^96.
bool ShiftRound(ulong w0, ulong w1, ulong w2, int k, mut ulong d0, mut ulong d1) {
    d0 = BitsFrom(w0, w1, w2, k)
    d1 = BitsFrom(w0, w1, w2, k + 64)
    ulong d2 = BitsFrom(w0, w1, w2, k + 128)
    bool half = (BitsFrom(w0, w1, w2, k - 1) & 1) == 1
    if half && (AnyBelow(w0, w1, w2, k - 1) || (d0 & 1) == 1) {
        d0 = d0 +% 1
        if d0 == 0 {
            d1 = d1 + 1
        }
    }

    return d2 == 0 && d1 <= 4294967295
}

// The 64 bits of w2:w1:w0 from bit `from` up; the bits above 191 are 0.
ulong BitsFrom(ulong w0, ulong w1, ulong w2, int from) {
    if from >= 192 {
        return 0
    }

    int bit = from % 64
    ulong low = Word192(w0, w1, w2, from / 64)
    if bit == 0 {
        return low
    }

    return (low >> bit) | (Word192(w0, w1, w2, from / 64 + 1) << (64 - bit))
}

// Whether any bit of w2:w1:w0 below bit `to` is set.
bool AnyBelow(ulong w0, ulong w1, ulong w2, int to) {
    if to >= 192 {
        return (w0 | w1 | w2) != 0
    }

    int word = to / 64
    if (word >= 1 && w0 != 0) || (word >= 2 && w1 != 0) {
        return true
    }

    return (Word192(w0, w1, w2, word) & ((ulong(1) << (to % 64)) -% 1)) != 0
}

// The word i, 0 to 2, of w2:w1:w0, and 0 above it.
ulong Word192(ulong w0, ulong w1, ulong w2, int i) => match i {
    0 => w0
    1 => w1
    2 => w2
    else => 0
}

// The 192-bit w2:w1:w0 times ten to the n, n from 0 to 28, in place.
void ScaleUp(mut ulong w0, mut ulong w1, mut ulong w2, int n) {
    mut int rest = n
    while rest > 0 {
        mut int step = rest
        if step > 19 {
            step = 19
        }

        MultiplyBy(mut w0, mut w1, mut w2, Pow10(step))
        rest = rest - step
    }
}

// The 192-bit w2:w1:w0 times m, in place; the bits above 192 returned.
ulong MultiplyBy(mut ulong w0, mut ulong w1, mut ulong w2, ulong m) {
    mut ulong h0 = 0
    ulong p0 = Multiply(w0, m, mut h0)
    mut ulong h1 = 0
    ulong p1 = Multiply(w1, m, mut h1)
    mut ulong h2 = 0
    ulong p2 = Multiply(w2, m, mut h2)
    w0 = p0
    w1 = p1 +% h0
    mut ulong carry = 0
    if w1 < h0 {
        carry = 1
    }

    ulong sum = p2 +% h1
    mut ulong over = h2
    if sum < h1 {
        over = over + 1
    }

    w2 = sum +% carry
    if w2 < carry {
        over = over + 1
    }

    return over
}

// The 192-bit w2:w1:w0 divided by d, from 1 to 2^32 - 1, in place; the remainder returned.
ulong DivideSmall(mut ulong w0, mut ulong w1, mut ulong w2, ulong d) {
    mut ulong r = 0
    w2 = DivideWord(w2, d, mut r)
    w1 = DivideWord(w1, d, mut r)
    w0 = DivideWord(w0, d, mut r)
    return r
}

// One word of a long division by d, below 2^32: the remainder so far, below d, in front of the word's two halves; the
// word of the quotient returned and the new remainder into r.
ulong DivideWord(ulong word, ulong d, mut ulong r) {
    ulong top = (r << 32) | (word >> 32)
    ulong upper = top / d
    ulong bottom = ((top - upper * d) << 32) | (word & 4294967295)
    ulong lower = bottom / d
    r = bottom - lower * d
    return (upper << 32) | lower
}

// a2:a1:a0 plus b2:b1:b0, in place, where the sum stays below 2^192.
void Add192(mut ulong a0, mut ulong a1, mut ulong a2, ulong b0, ulong b1, ulong b2) {
    ulong s0 = a0 +% b0
    mut ulong c0 = 0
    if s0 < b0 {
        c0 = 1
    }

    ulong t1 = a1 +% b1
    mut ulong c1 = 0
    if t1 < b1 {
        c1 = 1
    }

    ulong s1 = t1 +% c0
    if s1 < c0 {
        c1 = 1
    }

    a0 = s0
    a1 = s1
    a2 = a2 + b2 + c1
}

// a2:a1:a0 minus b2:b1:b0, in place, where a is not below b.
void Subtract192(mut ulong a0, mut ulong a1, mut ulong a2, ulong b0, ulong b1, ulong b2) {
    mut ulong borrow = 0
    if a0 < b0 {
        borrow = 1
    }

    mut ulong next = 0
    if a1 < b1 || (a1 == b1 && borrow == 1) {
        next = 1
    }

    a0 = a0 -% b0
    a1 = a1 -% b1 -% borrow
    a2 = a2 - b2 - next
}

// Whether a2:a1:a0 is below b2:b1:b0.
bool Below192(ulong a0, ulong a1, ulong a2, ulong b0, ulong b1, ulong b2) {
    if a2 != b2 {
        return a2 < b2
    }

    if a1 != b1 {
        return a1 < b1
    }

    return a0 < b0
}

// The count of bits of w2:w1:w0 up to its highest one.
int Bits192(ulong w0, ulong w1, ulong w2) {
    if w2 != 0 {
        return 128 + Bits(w2)
    }

    if w1 != 0 {
        return 64 + Bits(w1)
    }

    return Bits(w0)
}

// The count of bits of a word up to its highest one, 0 for 0.
int Bits(ulong value) {
    mut ulong v = value
    mut int n = 0
    if v >> 32 != 0 {
        v = v >> 32
        n = 32
    }

    if v >> 16 != 0 {
        v = v >> 16
        n = n + 16
    }

    if v >> 8 != 0 {
        v = v >> 8
        n = n + 8
    }

    if v >> 4 != 0 {
        v = v >> 4
        n = n + 4
    }

    if v >> 2 != 0 {
        v = v >> 2
        n = n + 2
    }

    if v >> 1 != 0 {
        v = v >> 1
        n = n + 1
    }

    return n + int(v)
}

// The count of decimal digits of a number, 1 for 0, which an interpolation counts an integer's with (L6).
pub long DigitCount(ulong value) {
    mut long count = 1
    mut ulong rest = value / 10
    while rest > 0 {
        count = count + 1
        rest = rest / 10
    }

    return count
}

// Ten to the n, n from 0 to 19.
ulong Pow10(int n) => match n {
    0 => 1
    1 => 10
    2 => 100
    3 => 1000
    4 => 10000
    5 => 100000
    6 => 1000000
    7 => 10000000
    8 => 100000000
    9 => 1000000000
    10 => 10000000000
    11 => 100000000000
    12 => 1000000000000
    13 => 10000000000000
    14 => 100000000000000
    15 => 1000000000000000
    16 => 10000000000000000
    17 => 100000000000000000
    18 => 1000000000000000000
    else => 10000000000000000000
}

// Ten to the n as a `double`, n from 0 to 28, each the `double` nearest it, as C#'s table of them.
double DoublePower10(int n) => match n {
    0 => 1.0
    1 => 1e1
    2 => 1e2
    3 => 1e3
    4 => 1e4
    5 => 1e5
    6 => 1e6
    7 => 1e7
    8 => 1e8
    9 => 1e9
    10 => 1e10
    11 => 1e11
    12 => 1e12
    13 => 1e13
    14 => 1e14
    15 => 1e15
    16 => 1e16
    17 => 1e17
    18 => 1e18
    19 => 1e19
    20 => 1e20
    21 => 1e21
    22 => 1e22
    23 => 1e23
    24 => 1e24
    25 => 1e25
    26 => 1e26
    27 => 1e27
    else => 1e28
}

// ---- the time types (T13, T29) -----------------------------------------------------------------------
//
// The emitted code passes a duration or a timestamp of either width as the two 64-bit words of its 128 bits, the low one
// first, a narrow one extended by its sign: a count of nanoseconds, that of a timestamp from 1970-01-01 in UTC (T24). Their
// arithmetic, its overflow and their conversions are the emitted code's (T31).

// The text of a duration (A12): its value split into `days`, `h`, `min`, `s`, `ms`, `us` and `ns`, from the largest down,
// each at most once and a zero count left out, `0ms` for zero and `-` before the whole of a negative one; the days of a
// `longduration` reach 25 digits.
pub string TextOfDuration(ulong low, ulong high) {
    mut ulong w0 = low
    mut ulong w1 = high
    bool negative = high >> 63 == 1
    if negative {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    ulong nanos = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong micros = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong millis = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong seconds = DivideSmall(mut w0, mut w1, mut w2, 60)
    ulong minutes = DivideSmall(mut w0, mut w1, mut w2, 60)
    ulong hours = DivideSmall(mut w0, mut w1, mut w2, 24)
    mut string text = ""
    raw {
        byte* p = string.Allocate(72)
        mut long n = 0
        if negative {
            p[0] = 45
            n = 1
        }

        long first = n
        if w0 != 0 || w1 != 0 {
            n = WideDigits(p, n, w0, w1, 1)
            n = PutText(p, n, "days")
        }

        n = TimePart(p, n, first, hours, "h")
        n = TimePart(p, n, first, minutes, "min")
        n = TimePart(p, n, first, seconds, "s")
        n = TimePart(p, n, first, millis, "ms")
        n = TimePart(p, n, first, micros, "us")
        n = TimePart(p, n, first, nanos, "ns")
        if n == first {
            n = PutText(p, n, "0ms")
        }

        text = string.FromRaw(p, n)
    }

    return text
}

// The text of a timestamp (A16): its instant in UTC as RFC 3339 writes it, `2026-10-28T09:30:00Z`, the fraction of a second in
// groups of three digits, as many as hold it and none for a whole second, and a year outside 0000 to 9999 with its sign and at
// least four digits, as Rust's chrono writes them; the date in the Gregorian calendar before its introduction as well, with a
// year 0 and no leap second, by Howard Hinnant's `civil_from_days`, which counts the days from 0000-03-01 in eras of 400 years.
pub string TextOfTimestamp(ulong low, ulong high) {
    mut ulong w0 = low
    mut ulong w1 = high
    ulong nanos = FloorDivide(mut w0, mut w1, 1000000000)
    ulong second = FloorDivide(mut w0, mut w1, 86400)
    Add128(mut w0, mut w1, 719468)
    ulong dayOfEra = FloorDivide(mut w0, mut w1, 146097)
    ulong yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    ulong dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    ulong shifted = (5 * dayOfYear + 2) / 153
    ulong day = dayOfYear - (153 * shifted + 2) / 5 + 1
    mut ulong month = shifted + 3
    mut ulong years = yearOfEra
    if shifted >= 10 {
        month = shifted - 9
        years = years + 1
    }

    // the year: the era times 400 and the years after its start, as a sign and a magnitude; an era before the year 0 holds
    // more than 400 years, so its sum is no positive year
    bool before = w1 >> 63 == 1
    if before {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    MultiplyBy(mut w0, mut w1, mut w2, 400)
    if before {
        Subtract128(mut w0, mut w1, years)
    } else {
        Add128(mut w0, mut w1, years)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(64)
        mut long n = 0
        if before && (w0 != 0 || w1 != 0) {
            p[0] = 45
            n = 1
        } else if w1 != 0 || w0 > 9999 {
            p[0] = 43
            n = 1
        }

        n = WideDigits(p, n, w0, w1, 4)
        p[n] = 45
        WriteDigits(p + n + 1, month, 2)
        p[n + 3] = 45
        WriteDigits(p + n + 4, day, 2)
        p[n + 6] = 84
        WriteDigits(p + n + 7, second / 3600, 2)
        p[n + 9] = 58
        WriteDigits(p + n + 10, second / 60 % 60, 2)
        p[n + 12] = 58
        WriteDigits(p + n + 13, second % 60, 2)
        n = n + 15
        if nanos != 0 {
            p[n] = 46
            if nanos % 1000000 == 0 {
                WriteDigits(p + n + 1, nanos / 1000000, 3)
                n = n + 4
            } else if nanos % 1000 == 0 {
                WriteDigits(p + n + 1, nanos / 1000, 6)
                n = n + 7
            } else {
                WriteDigits(p + n + 1, nanos, 9)
                n = n + 10
            }
        }

        p[n] = 90
        text = string.FromRaw(p, n + 1)
    }

    return text
}

// ` <count><name>` written at `p + n`, without the space where nothing stands after `first`, and nothing for a zero count; the
// place after it returned.
long TimePart(byte* p, long n, long first, ulong count, string name) {
    if count == 0 {
        return n
    }

    mut long at = n
    if at > first {
        raw {
            p[at] = 32
        }

        at = at + 1
    }

    long digits = DigitCount(count)
    WriteDigits(p + at, count, int(digits))
    return PutText(p, at + digits, name)
}

// The bytes of `s` written at `p + n`; the place after them returned.
long PutText(byte* p, long n, string s) {
    long count = long(s.Bytes.Count)
    raw {
        byte* from = s.Pointer
        mut long i = 0
        while i < count {
            p[n + i] = from[i]
            i = i + 1
        }
    }

    return n + count
}

// The decimal digits of the 128-bit high:low written at `p + n`, at least `least` of them, zeros before the first where it has
// fewer; the place after the last returned.
long WideDigits(byte* p, long n, ulong low, ulong high, long least) {
    mut ulong c0 = low
    mut ulong c1 = high
    mut ulong c2 = 0
    mut long count = 0
    while count == 0 || c0 != 0 || c1 != 0 {
        DivideSmall(mut c0, mut c1, mut c2, 10)
        count = count + 1
    }

    if count < least {
        count = least
    }

    mut ulong w0 = low
    mut ulong w1 = high
    mut ulong w2 = 0
    mut long i = n + count - 1
    raw {
        while i >= n {
            p[i] = byte(DivideSmall(mut w0, mut w1, mut w2, 10) + 48)
            i = i - 1
        }
    }

    return n + count
}

// The signed 128-bit w1:w0 divided by d, from 1 to 2^32 - 1, rounded toward negative infinity, in place; the remainder
// returned, from 0 to d - 1.
ulong FloorDivide(mut ulong w0, mut ulong w1, ulong d) {
    bool negative = w1 >> 63 == 1
    if negative {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    mut ulong r = DivideSmall(mut w0, mut w1, mut w2, d)
    if negative {
        if r != 0 {
            Add128(mut w0, mut w1, 1)
            r = d - r
        }

        Negate128(mut w0, mut w1)
    }

    return r
}

// The 128-bit w1:w0 negated in two's complement, in place.
void Negate128(mut ulong w0, mut ulong w1) {
    w0 = ~w0 +% 1
    w1 = ~w1
    if w0 == 0 {
        w1 = w1 +% 1
    }
}

// The 128-bit w1:w0 plus k, in place, wrapping as two's complement does.
void Add128(mut ulong w0, mut ulong w1, ulong k) {
    w0 = w0 +% k
    if w0 < k {
        w1 = w1 +% 1
    }
}

// The 128-bit w1:w0 minus k, in place, wrapping as two's complement does.
void Subtract128(mut ulong w0, mut ulong w1, ulong k) {
    bool borrow = w0 < k
    w0 = w0 -% k
    if borrow {
        w1 = w1 -% 1
    }
}
