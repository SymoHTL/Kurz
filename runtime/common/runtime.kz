// The part of the runtime every target shares (design record, section 2). It reaches the functions of
// the target the program is built for as the folder `sys`, the target's directory (the owner,
// 2026-10-23, "Rust's sys"), and the standard library's allocator as the folder `std` (the owner,
// 2026-10-24, "A std/ directory now" and "As built"). The emitted code calls its `pub` functions: `Start` before the
// program's first statement and `Finish` after its last, and the others where the program allocates,
// prints, makes the text of a value, joins or compares strings, computes with a `decimal`, raises an
// exception, or hands a path to a call on a file (compiler/README.md, "The runtime").
use std
use sys

// The buffer of each thread in which `Print` puts a line together before its write, and its size, in the
// thread's own heap (`AllocateOwn`).
thread static mut byte* buffer = null
thread static mut long room = 0

// The words the threads of the process share, in a block of 48 bytes, since an atomic view takes the address of
// its word (R19) and the runtime's code takes the address of no `static` (R10, R13): the lock of standard
// output, at 0, and of standard error, at 4, each an `int` that `Lock` takes, the lock of the table of the
// slots, at 8, of the queue of the pauses, at 12, and of the blocks the top-level code's wait runs, at 16, the
// count of the actors spawned, at 24 (`ActorNew`), and the table of every block's message, at 32 (`BlockTable`),
// whose first word holds the function that runs a block (`BlockRun`) from the moment the block of the words is
// made (`SharedCleared`), and whose second, at 40, the function that copies one, `SharedCleared` leaves null and
// nothing writes, since a block that waits in the inbox of an actor that crashes is dropped, never copied (`BlockLeft`).
// The start makes it in the thread's own heap, while the main thread is the one thread of the process, so that on
// that path its address is written once, before any other thread runs; where the system refuses it there, the
// first `spawn` makes it, before any actor runs (`Shared`), so that a program the system gives no memory ends at its
// own first allocation, as it did; that make takes no lock, which holds
// while one thread runs every program (U35): a thread the program started through C (R16) may run by then, and two
// threads could each make it (inferred).
static mut byte* sharedWords = null

// Called by the emitted `main` before the program's first statement, with the arguments the C library's
// start gave it (S13).
pub void Start(int count, byte* values) {
    sys.Start(count, values)
    sys.Waiter(SocketWaited)
    sys.BlockingWaiter(BlockingWaited, BlockingOffloads)
    sys.ManyWaiter(ManyWaited)
    raw {
        byte* words = std.AllocateIn(null, 48)
        if words != null {
            sharedWords = SharedCleared(words)
        }
    }
}

// The block of the shared words at `words`, each word 0 but the first of the blocks' table, the function that
// runs a block (`BlockTable`).
byte* SharedCleared(byte* words) {
    raw {
        mut long i = 0
        while i < 48 {
            *Ptr<long>(words + i) = 0
            i = i + 8
        }

        *Ptr<extern "C" (byte*, byte*) => void>(words + 32) = BlockRun
    }

    return words
}

// The block of the shared words, made where the start could not make it (`sharedWords`).
byte* Shared() {
    raw {
        if sharedWords == null {
            sharedWords = SharedCleared(AllocateOwn(48))
        }

        return sharedWords
    }
}

// The lock whose word is at `word` taken, as Rust's standard library takes its `Mutex` on a futex
// (`library/std/src/sys/sync/mutex/futex.rs`, not checked at source): 0 free, 1 taken, 2 taken with a thread
// that may sleep on it;
// a compare-exchange from 0 to 1 with acquire, and where it fails, a spin of one load and up to 100 more while the
// word holds 1 (`LockSpun`), then a swap to 2 with acquire, the thread put to sleep while the word holds 2 (`sys.LockWait`) and
// the spin and the swap made again after each wake, until a swap finds the word 0. The hold raises the count
// of the entries under way (`sys.Entered`) until `Unlock`, so that a stack fault while it holds the lock ends
// the process and leaves no lock taken behind an actor's crash (O11).
void Lock(int* word) {
    sys.Entered()
    raw {
        AtomicInt lock = AtomicInt.FromPtr(word)
        if LockTried(lock) == 0 {
            return
        }

        mut int state = LockSpun(lock)
        if state == 0 {
            state = LockTried(lock)
            if state == 0 {
                return
            }
        }

        while state == 2 || lock.Swap(2, MemoryOrder.Acquire) != 0 {
            sys.LockWait(word, 2)
            state = LockSpun(lock)
        }
    }
}

// The word the compare-exchange of the lock `lock` from 0 to 1 found there, with acquire where it stored: 0
// where it took the lock.
int LockTried(AtomicInt lock) {
    mut int found = 0
    raw {
        match lock.CompareExchange(0, 1, MemoryOrder.Acquire, MemoryOrder.Relaxed) {
            int stored => found = stored
            NotExchanged<int> missed => found = missed.Value
        }
    }

    return found
}

// The word of the lock `lock` once it holds no 1, or after 101 loads that found 1, one load and up to 100 more,
// as Rust's `spin` loads it (not checked at source).
int LockSpun(AtomicInt lock) {
    mut int spins = 100
    raw {
        mut int state = lock.Load(MemoryOrder.Relaxed)
        while state == 1 && spins > 0 {
            spins = spins - 1
            state = lock.Load(MemoryOrder.Relaxed)
        }

        return state
    }
}

// The lock whose word is at `word` let go: a swap to 0 with release, and where it found 2, one thread that
// sleeps on it woken (`sys.LockWake`), as Rust's `unlock` wakes one (not checked at source); the count of the entries under way
// lowered, which `Lock` raised.
void Unlock(int* word) {
    raw {
        if AtomicInt.FromPtr(word).Swap(0, MemoryOrder.Release) == 2 {
            sys.LockWake(word)
        }
    }

    sys.Left()
}

// Called by the emitted `main` after the program's last statement: the end of the process with the
// exit code 0 through the runtime's one exit (design record, section 6). A message still in an actor's
// inbox does not run (U13), and every actor's heap is freed whole (design record, section 6, assumed: the
// end of the root actor read as the end of every actor it stops, with section 3's freeing of the heap of
// an actor that ends).
pub void Finish() {
    EndActors()
    sys.Exit(0)
}

// `size` bytes from the allocator's entry (design record, section 2), at an address that is a multiple
// of 16. An allocation the system refuses ends the process with `error: allocation-failed (<n> bytes)`
// and the exit code 1 (O11; the owner, 2026-10-23, "Id + size"), as Rust's `handle_alloc_error` ends
// it for the null its allocator gives.
pub byte* Allocate(long size) {
    byte* p = std.Allocate(size)
    if p == null {
        AllocationFailed(size)
    }

    return p
}

// `size` bytes of the thread's own heap, outside every actor's (design record, section 3), as `Allocate`
// gives them, for what lives as long as the process whichever actor's code makes it first: the runtime's
// buffers, the copy's work list and its memo. A `static` value holds no block, as its initializer is a
// constant (R13), and the hash keys of the thread's maps are two words of the thread, not a block.
pub byte* AllocateOwn(long size) {
    byte* p = std.AllocateIn(null, size)
    if p == null {
        AllocationFailed(size)
    }

    return p
}

// `size` bytes of the heap `heap`, as `Allocate` gives them: a message in the heap of the actor it goes to.
pub byte* AllocateIn(byte* heap, long size) {
    byte* p = std.AllocateIn(heap, size)
    if p == null {
        AllocationFailed(size)
    }

    return p
}

// The bytes of a new string, `string.Allocate(size)` (R15): room for `size` bytes in a block that
// holds the count of the string values in front of them, which `string.FromRaw` takes over. More
// bytes than the largest `int` end the process as a refused allocation does, with the count asked
// for (T15); a block the system refuses ends it with the bytes the allocator was asked for, the
// block's counts among them, as a list's growth does (section 4).
pub byte* AllocateString(long size) {
    if size > 2147483647 {
        AllocationFailed(size)
    }

    byte* p = std.StringBlock(size)
    if p == null {
        AllocationFailed(16 + size)
    }

    return p
}

// The end of the process for an allocation refused, and for a string asked of more bytes than the
// largest `int` (T15; the owner, "C#'s limit" on 2026-10-23 and "allocation-failed" on 2026-10-24): `error:
// allocation-failed (<n> bytes)` and the exit code 1, with no place and no trace (O11).
pub void AllocationFailed(long size) {
    sys.Crashing()
    WriteError("error: allocation-failed (")
    WriteNumber(ulong(size))
    WriteError(" bytes)\n")
    sys.Exit(1)
}

// The end of the process at a thread's first map where the system gave no randomness for the keys of
// its hash, the target's `Random` false (M9; the owner, 2026-10-30, "End with an error, as Rust" and
// "Rust's full path"): `error: random-failed` and the exit code 1, with no place and no trace, as
// `allocation-failed` ends it, where Rust's standard library panics with "failed to retrieve random
// hash map seed".
pub void RandomFailed() {
    sys.Crashing()
    WriteError("error: random-failed\n")
    sys.Exit(1)
}

// The end of the process where an argument made before the program's first statement, `args`, is not
// UTF-8 (S13; the owner, 2026-10-30, "Refused, as Rust"): `error: invalid-argument` and the exit code 1,
// with no place and no trace, as `random-failed` ends it, the id and that end assumed in the record's
// marker of that answer.
pub void InvalidArgument() {
    sys.Crashing()
    WriteError("error: invalid-argument\n")
    sys.Exit(1)
}

// The bytes of a path as C reads them, for a call on a file (S1, S2): a copy of the string's bytes
// ended by a NUL byte, which `FreePath` gives back, or null where the string holds a NUL byte, which
// no path of the system holds and which is `InvalidInput` to the caller, as Rust's `run_path_with_cstr`
// refuses it.
pub byte* CPath(string path) {
    long count = long(path.Bytes.Count)
    byte* p = Allocate(count + 1)
    raw {
        byte* from = path.Pointer
        mut long i = 0
        while i < count {
            if from[i] == 0 {
                std.Free(p, count + 1)
                return null
            }

            p[i] = from[i]
            i = i + 1
        }

        p[count] = 0
    }

    return p
}

// The copy `CPath` made of the path, given back to the allocator.
pub void FreePath(byte* p, string path) {
    std.Free(p, long(path.Bytes.Count) + 1)
}

// `print` (A1) and `eprint` (A17): the text and a line feed, handed to the system's write call on
// `fd`, standard output (1) for `print` and standard error (2) for `eprint`, in one piece, which is
// called again for what a call did not take; a write the system refuses, or one that takes no byte,
// as Rust's `write_all` fails on a write of zero bytes, raises `print-failed` at the place of the
// call, which the emitted call passes (design record, section 6; the owner, 2026-10-23, "Caller
// passes it"); on Linux a write the system fails with `EBADF` counts as written (`sys.WriteOut`, the
// owner, 2026-11-11, "Success, as Rust"). Where `eprint`'s write failed, the report of `print-failed`
// goes to standard error too, and `Raise` drops it where that write is refused or takes no byte (A17). The
// writes of a line hold the lock of its stream (`StreamLock`), so that a line is written whole between the lines
// of other threads, as Rust's `println!` holds the lock of standard output for its line (not checked at source), and the raise comes
// after the lock was let go.
pub void Print(int fd, string text, string file, int line) {
    long count = long(text.Bytes.Count)
    long total = count + 1
    raw {
        if total > room {
            room = total
            if room < 4096 {
                room = 4096
            }

            buffer = AllocateOwn(room)
        }

        byte* from = text.Pointer
        mut long i = 0
        while i < count {
            buffer[i] = from[i]
            i = i + 1
        }

        buffer[count] = 10
    }

    mut long done = 0
    mut bool failed = false
    StreamLock(fd)
    while done < total && !failed {
        mut long written = -1
        raw {
            written = sys.WriteOut(fd, buffer + done, total - done)
        }

        failed = written <= 0
        if !failed {
            done = done + written
        }
    }

    StreamUnlock(fd)
    if failed {
        Raise("print-failed", file, line)
    }
}

// The lock of the stream `fd`, standard output (1) or standard error (2), taken where the shared words stand
// (`sharedWords`), and let go (`StreamUnlock`).
void StreamLock(int fd) {
    raw {
        if sharedWords != null {
            Lock(Ptr<int>(sharedWords + (long(fd) - 1) * 4))
        }
    }
}

void StreamUnlock(int fd) {
    raw {
        if sharedWords != null {
            Unlock(Ptr<int>(sharedWords + (long(fd) - 1) * 4))
        }
    }
}

// The error line of an exception of the run-time table (chapter 12), `error: <id> at <file>:<n>`, on
// standard error, the trace of the calls below it, which the target's `Trace` writes, and the end of
// the process with the exit code 1 (design record, section 6), where the top-level code raised it, the
// root actor's crash (U19); inside a message it is the crash of the actor that runs it (`CrashActor`). The
// target's `Crashing` marks the crash path as running first, so that a stack overflow in it ends the
// process with no second error line.
pub void Raise(string id, string file, int line) {
    CrashActor(id, file, line, false, "")
    sys.Crashing()
    WriteError("error: ")
    WriteError(id)
    WriteError(" at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// A check of the runtime's own code in a test build that fires (chapter 12, U19): the end of the process with its error line and
// the exit code 1 wherever it fires, the count of the entries under way raised first, so that the crash takes it as a fault inside
// the allocator or the scheduler, and no actor's crash runs its policy with a structure the runtime was changing half-changed
// (design record, section 6, "End the process", against the crash of the actor alone; the site of such a check asking for that end
// with no count, assumed there).
pub void RaiseOwn(string id, string file, int line) {
    sys.Entered()
    Raise(id, file, line)
}

// A `throw` (O6): the error line ends with a colon, and the text of the thrown value stands on the
// line below it, written as it is, with the trace below the text (design record, section 6); inside a
// message, the crash of the actor that runs it, which keeps that text for its log line (U19, U24).
pub void Throw(string text, string file, int line) {
    CrashActor("thrown", file, line, true, text)
    sys.Crashing()
    WriteError("error: thrown at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError(text)
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// A `check` whose condition was false (Y6): the error line `error: check-failed at <file>:<n>:`, the condition's text on the line
// after it, as the parser kept it with the values of its sides, as a thrown value's text follows a `throw`'s error line (O6), the
// trace after the text, and the end of the process with the exit code 1; inside a message, the crash of the actor that runs it, which
// keeps that text for its log line (U19, U24), and under `kurz test` for the line under its test's `FAILED` (Y3).
pub void CheckFailed(string text, string file, int line) {
    CrashActor("check-failed", file, line, true, text)
    sys.Crashing()
    WriteError("error: check-failed at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError(text)
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// The error line of `not-char-boundary` (X2, X10): `error: not-char-boundary at <file>:<n>:`, the
// position of the cut on the line below it, `byte <at> is inside a code point`, where the text of a
// `throw` stands (O6), the trace of the calls below that, and the end of the process with the exit code 1;
// inside a message, the crash of the actor that runs it, which keeps that position for its log line (U19, U24).
pub void NotCharBoundary(long at, string file, int line) {
    mut bool inside = false
    raw {
        inside = running != null
    }

    if inside {
        CrashActor("not-char-boundary", file, line, true, "byte {at} is inside a code point")
    }

    sys.Crashing()
    WriteError("error: not-char-boundary at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError("byte ")
    WriteNumber(ulong(at))
    WriteError(" is inside a code point\n")
    sys.Trace()
    sys.Exit(1)
}

// The error line of `invalid-input` for a bound of `within` of zero or less that is no literal, a block's or a call's clause's (U40,
// U41; design record, section 6, the owner, 2026-11-20, "T4 (2)"; assumed: T78 of comment 7055305138): `error: invalid-input at
// <file>:<n>:`, the bound on the line below it, `the bound of `within` is <bound>; a bound is positive`, written as a duration's text
// is (A12), where the text of a `throw` stands (O6), the trace of the calls below that, and the end of the process with the exit code
// 1; inside a message, the crash of the actor that runs it, which keeps that text for its log line (U19, U24).
pub void InvalidBound(long bound, string file, int line) {
    mut string sign = ""
    mut ulong magnitude = 0
    if bound < 0 {
        sign = "-"
        magnitude = ulong(-(bound + 1)) + 1
    }

    string text = "the bound of `within` is {sign}{TextOfDuration(magnitude, 0)}; a bound is positive"
    CrashActor("invalid-input", file, line, true, text)
    sys.Crashing()
    WriteError("error: invalid-input at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError(text)
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// The text of a signed integer (A2): its decimal digits, with a leading `-` when it is negative, in
// one block, as Rust's `Display` writes the sign and the digits into one `String`.
pub string TextOfLong(long value) {
    if value >= 0 {
        return TextOfULong(ulong(value))
    }

    // the magnitude of the smallest `long` is no `long`: that of value + 1, plus one
    ulong magnitude = ulong(-(value + 1)) + 1
    long count = DigitCount(magnitude) + 1
    mut string text = ""
    raw {
        byte* p = string.Allocate(count)
        p[0] = 45
        WriteDigits(p + 1, magnitude, int(count - 1))
        text = string.FromRaw(p, count)
    }

    return text
}

// The text of an unsigned integer (A2): its decimal digits.
pub string TextOfULong(ulong value) {
    long count = DigitCount(value)
    mut string text = ""
    raw {
        byte* p = string.Allocate(count)
        WriteDigits(p, value, int(count))
        text = string.FromRaw(p, count)
    }

    return text
}

// The text of a `char` (A8): its code point in UTF-8, one to four bytes.
pub string TextOfChar(uint point) {
    mut long count = 4
    if point < 128 {
        count = 1
    } else if point < 2048 {
        count = 2
    } else if point < 65536 {
        count = 3
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(count)
        if count == 1 {
            p[0] = byte(point)
        } else if count == 2 {
            p[0] = byte(192 | (point >> 6))
            p[1] = byte(128 | (point & 63))
        } else if count == 3 {
            p[0] = byte(224 | (point >> 12))
            p[1] = byte(128 | ((point >> 6) & 63))
            p[2] = byte(128 | (point & 63))
        } else {
            p[0] = byte(240 | (point >> 18))
            p[1] = byte(128 | ((point >> 12) & 63))
            p[2] = byte(128 | ((point >> 6) & 63))
            p[3] = byte(128 | (point & 63))
        }

        text = string.FromRaw(p, count)
    }

    return text
}

// The text of a `double`, given its 64 bits, which the emitted code passes (A4, A14): the fewest digits
// that read back as the same number, of those the nearest to it, written as .NET Core 3.0 and later
// write a `double` with the invariant culture; `-0` for a negative zero, `Infinity`, `-Infinity` and
// `NaN`. The digits are Ryu's, as Rust's `ryu` crate computes them with its small table.
pub string TextOfDouble(ulong bits) {
    bool negative = bits >> 63 == 1
    int exponent = int((bits >> 52) & 2047)
    ulong mantissa = bits & 4503599627370495
    if exponent == 2047 {
        return NoDigits(mantissa != 0, negative)
    }

    if exponent == 0 && mantissa == 0 {
        return ZeroText(negative)
    }

    mut ulong digits = 0
    mut int power = 0
    DoubleDigits(mantissa, exponent, mut digits, mut power)
    return DecimalText(negative, digits, power, 17)
}

// The text of a `float`, given its 32 bits (A8, A11): the fewest digits that read back as the same
// `float`, written as .NET Core 3.0 and later write a `float`, and the values without digits as a
// `double` shows them.
pub string TextOfFloat(uint bits) {
    bool negative = bits >> 31 == 1
    int exponent = int((bits >> 23) & 255)
    ulong mantissa = ulong(bits & 8388607)
    if exponent == 255 {
        return NoDigits(mantissa != 0, negative)
    }

    if exponent == 0 && mantissa == 0 {
        return ZeroText(negative)
    }

    mut ulong digits = 0
    mut int power = 0
    FloatDigits(mantissa, exponent, mut digits, mut power)
    return DecimalText(negative, digits, power, 9)
}

// The text of a list (A4): the texts of its `count` items, one or more, which `texts` holds as a
// string is laid out, the address of its bytes and their count, 8 bytes each, the count's highest bit
// the mark of a string that holds a block (`std/std.kz`), between `[` and `]` and with `, ` between
// them; more bytes than the largest `int` end the process as a refused allocation does.
pub string ListText(byte* texts, long count) {
    mut long total = 2 * count
    raw {
        mut long i = 0
        while i < count {
            total = total + (*Ptr<long>(texts + i * 16 + 8) & 9223372036854775807)
            i = i + 1
        }
    }

    if total > 2147483647 {
        AllocationFailed(total)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(total)
        p[0] = 91
        mut long at = 1
        mut long i = 0
        while i < count {
            if i > 0 {
                p[at] = 44
                p[at + 1] = 32
                at = at + 2
            }

            byte* from = Ptr<byte>(*Ptr<long>(texts + i * 16))
            long n = *Ptr<long>(texts + i * 16 + 8) & 9223372036854775807
            mut long j = 0
            while j < n {
                p[at + j] = from[j]
                j = j + 1
            }

            at = at + n
            i = i + 1
        }

        p[at] = 93
        text = string.FromRaw(p, total)
    }

    return text
}

// Whether two strings hold the same bytes (T18), on the runtime's own path (Rust's `==` of two `str` calls the C library's `bcmp`
// after the test of the lengths), reading no byte past the end of either: the counts, then the first bytes, where two
// different strings of one count most often differ; 1 to 3 bytes as their middle and last byte; 4 to 16 as four words of 4, the
// first two at 0 and at 4 (at 0 again below 8 bytes) and the last two ending 4 bytes before the end and at the end, so that every
// count from 4 to 16 takes one path, and their differences joined by `|` and tested once: `==` of 200k words of 3 to 10 letters and
// their copies took 28.9 ms so, against 47.3 ms when 4 to 7 and 8 or more bytes took two paths, whose tests mispredicted where the
// counts were mixed (Rust 27.0 ms). More than 16 bytes go to `SameBytes`, a call.
// LLVM puts `Same` into each caller and keeps `SameBytes` a call, which the emitter marks `noinline`. With everything past the
// first bytes in `SameBytes`, a hit in a map of the 200k words took 31.80 ms against 27.74 on `main`; with up to 16 bytes here,
// 30.00 and 30.23 against 29.24 and 26.79 on `main`, in two other runs.
pub bool Same(string first, string second) {
    long a = long(first.Bytes.Count)
    if a != long(second.Bytes.Count) {
        return false
    }

    mut bool same = true
    raw {
        byte* x = first.Pointer
        byte* y = second.Pointer
        if a > 0 && x[0] != y[0] {
            same = false
        } else if a > 16 {
            same = SameBytes(x, y, a)
        } else if a >= 4 {
            long q = ((a + 8) >> 4) << 2
            uint near = (std.LittleEndianWord(x) ^ std.LittleEndianWord(y)) | (std.LittleEndianWord(x + q) ^ std.LittleEndianWord(y + q))
            uint far = (std.LittleEndianWord(x + a - 4 - q) ^ std.LittleEndianWord(y + a - 4 - q)) | (std.LittleEndianWord(x + a - 4) ^ std.LittleEndianWord(y + a - 4))
            same = (near | far) == 0U
        } else if a > 0 {
            same = ulong((x[a / 2] ^ y[a / 2]) | (x[a - 1] ^ y[a - 1])) == 0UL
        }
    }

    return same
}

// The rest of `Same`, more than 16 bytes whose first bytes agree: 16 bytes at a time in two words of 8, their differences joined by
// `|`, and the 16 bytes that end the bytes. Rust's `==` of two `str` calls the C library's `bcmp` here, after the test of the
// lengths; the runtime of Kurz is written in Kurz (design record, section 2), so this function takes the place of that call, in
// words of 8 as `memcmp` compares a small count, where Rust's call leaves the bytes to the C library: `==` of 20k lines of ten words
// with their copies, 200 rounds, took 18.95 ms so against 28.41 on `main` (Rust 14.33 ms).
bool SameBytes(byte* x, byte* y, long a) {
    mut ulong diff = 0
    raw {
        mut long i = 0
        while i + 16 < a && diff == 0UL {
            diff = (std.WordAt(x + i) ^ std.WordAt(y + i)) | (std.WordAt(x + i + 8) ^ std.WordAt(y + i + 8))
            i = i + 16
        }

        diff = diff | (std.WordAt(x + a - 16) ^ std.WordAt(y + a - 16)) | (std.WordAt(x + a - 8) ^ std.WordAt(y + a - 8))
    }

    return diff == 0UL
}

// The order of two strings, below 0, 0 or above 0: the first byte in which they differ, and where one starts the other, the shorter
// first, as Rust's `Ord` for `str` compares them; in UTF-8 that is the order of their code points (T32). The first bytes are compared
// first, and where they differ the order is their difference, a value, as a compare a byte at a time gives it. A `-1` or a `1` chosen
// by a test of which byte is the lower became, where `Order` went into the loop of its one caller, a branch on that test, which
// mispredicted on every second pair of random words: `<` of 200k such words and the next took 35.2 ms so, 12.2 ms with the difference
// and 15.8 ms a byte at a time (Rust 18.1 ms). Where the first bytes agree, the shared bytes are compared on the runtime's own path
// (Rust's `Ord` calls the C library's `memcmp` here), reading no byte past the end of either, as words read with their first byte
// highest, so that the order of two words is the order of their bytes: 1 to 3 as their first, middle and last byte; 4 to 16 as four
// words of 4, the first two at 0 and at 4 (at 0 again below 8 bytes) and the last two ending 4 bytes before the end and at the end;
// more than 16 as 16 bytes at a time, then as four words of 8, the 16 bytes where that stopped and the 16 that end the shared bytes.
// The first word that differs holds the first byte that differs, and gives the order, `-1` or `1` by a test of which word is the
// lower, which LLVM made into a value with no branch (`setae` on x86-64) in the loop of one caller of `<` on strings that differ past
// their first byte, as likely one way as the other: 16.2 ms against 33.8 ms on `main` for 50 rounds of 82,000 pairs. A value
// made from the words' bits took 3.3 ms longer on 50 rounds of 200k sorted neighbours. Where no word differs, the counts give the order.
pub int Order(string first, string second) {
    long a = long(first.Bytes.Count)
    long b = long(second.Bytes.Count)
    mut long shared = a
    if b < a {
        shared = b
    }

    mut int order = first.Bytes.Count - second.Bytes.Count
    raw {
        byte* x = first.Pointer
        byte* y = second.Pointer
        if shared > 0 && x[0] != y[0] {
            order = int(x[0]) - int(y[0])
        } else {
            mut ulong u = 0
            mut ulong v = 0
            if shared > 16 {
                mut long i = 0
                while i + 32 < shared && std.WordAt(x + i) == std.WordAt(y + i) && std.WordAt(x + i + 8) == std.WordAt(y + i + 8) {
                    i = i + 16
                }

                u = std.HighWordAt(x + shared - 8)
                v = std.HighWordAt(y + shared - 8)
                ulong u3 = std.HighWordAt(x + shared - 16)
                ulong v3 = std.HighWordAt(y + shared - 16)
                if u3 != v3 {
                    u = u3
                    v = v3
                }

                ulong u2 = std.HighWordAt(x + i + 8)
                ulong v2 = std.HighWordAt(y + i + 8)
                if u2 != v2 {
                    u = u2
                    v = v2
                }

                ulong u1 = std.HighWordAt(x + i)
                ulong v1 = std.HighWordAt(y + i)
                if u1 != v1 {
                    u = u1
                    v = v1
                }
            } else if shared >= 4 {
                long q = ((shared + 8) >> 4) << 2
                ulong u1 = ulong(std.BigEndianWord(x)) << 32 | ulong(std.BigEndianWord(x + q))
                ulong v1 = ulong(std.BigEndianWord(y)) << 32 | ulong(std.BigEndianWord(y + q))
                u = ulong(std.BigEndianWord(x + shared - 4 - q)) << 32 | ulong(std.BigEndianWord(x + shared - 4))
                v = ulong(std.BigEndianWord(y + shared - 4 - q)) << 32 | ulong(std.BigEndianWord(y + shared - 4))
                if u1 != v1 {
                    u = u1
                    v = v1
                }
            } else if shared > 0 {
                u = ulong(x[0]) << 16 | ulong(x[shared / 2]) << 8 | ulong(x[shared - 1])
                v = ulong(y[0]) << 16 | ulong(y[shared / 2]) << 8 | ulong(y[shared - 1])
            }

            if u != v {
                order = 1
                if u < v {
                    order = -1
                }
            }
        }
    }

    return order
}

// The byte at position `at` of the `count` bytes at `bytes`, and -1 past them.
long ByteAt(byte* bytes, long count, long at) {
    mut long b = -1
    if at < count {
        raw {
            b = long(bytes[at])
        }
    }

    return b
}

// The UTF-8 sequence that starts at position `at` of the `count` bytes at `bytes`, read as Rust's
// `str::from_utf8` reads it, which takes no overlong form, no surrogate and nothing above U+10FFFF:
// its length where it is valid, and else the negative of the count of its bytes that begin a valid
// sequence, at least 1, the maximal part of a sequence that Rust's `String::from_utf8_lossy` and the
// Unicode Standard's recommended practice read as one U+FFFD (T15).
long Utf8Sequence(byte* bytes, long count, long at) {
    long first = ByteAt(bytes, count, at)
    if first < 128 {
        return 1
    }

    mut long width = 0
    mut long low = 128
    mut long high = 191
    if first >= 194 && first <= 223 {
        width = 2
    } else if first >= 224 && first <= 239 {
        width = 3
        if first == 224 {
            low = 160
        } else if first == 237 {
            high = 159
        }
    } else if first >= 240 && first <= 244 {
        width = 4
        if first == 240 {
            low = 144
        } else if first == 244 {
            high = 143
        }
    } else {
        return -1
    }

    long second = ByteAt(bytes, count, at + 1)
    if second < low || second > high {
        return -1
    }

    mut long i = 2
    while i < width {
        long b = ByteAt(bytes, count, at + i)
        if b < 128 || b > 191 {
            return -i
        }

        i = i + 1
    }

    return width
}

// The count of the bytes in front of the first sequence of the `count` bytes at `bytes` that is not
// UTF-8, as Rust's `Utf8Error::valid_up_to` counts them, and -1 where every sequence is UTF-8: what
// `string.FromUtf8` puts into `InvalidUtf8` (T15; the owner, 2026-10-29, "Union, as Rust"). A letter
// with three bytes after it is read in place, its bytes held to the ranges `Utf8Sequence` holds them to
// with no check of the end between them, and a letter nearer the end through `Utf8Sequence`; the first
// 16 bytes of a run of ASCII are read byte by byte, and a longer run is skipped as Rust 1.82's
// `run_utf8_validation` skips one: byte by byte up to an address that is a multiple of 8, from there
// two words of 8 bytes at a time while both lie inside the bytes and neither holds a byte of 128 or
// more, then byte by byte up to the first byte of 128 or more. The form leaves Rust's where it measures
// faster with the same results (design record, section 1: the owner, 2026-11-01, "Allow, faster wins"):
// `run_utf8_validation` itself checks each byte of a letter after its first against the end, and tries
// its words at every byte of ASCII that stands at a multiple of 8: that form, measured for pull request
// 154, read 1 MiB of text with 0 to 11 bytes of ASCII between letters of 2 to 4 bytes, 200 times, in
// 354 ms where the form before it, every sequence through `Utf8Sequence`, took 280 ms. A word is read
// only at a multiple of 8, since the read through a pointer is emitted with no alignment written, which
// LLVM's language reference reads as the ABI alignment of the type, 8 for a `ulong`.
pub long Utf8Invalid(byte* bytes, long count) {
    long blocksEnd = count - 15
    long lettersEnd = count - 3
    mut long bad = -1
    mut long at = 0
    raw {
        while at < count {
            long first = long(bytes[at])
            if first < 128 {
                at = at + 1
                mut long limit = at + 15
                if limit > count {
                    limit = count
                }

                while at < limit && bytes[at] < 128 {
                    at = at + 1
                }

                if at == limit {
                    while at < count && bytes[at] < 128 && (long(bytes + at) & 7) != 0 {
                        at = at + 1
                    }

                    if (long(bytes + at) & 7) == 0 {
                        while at < blocksEnd {
                            ulong u = *Ptr<ulong>(bytes + at)
                            ulong v = *Ptr<ulong>(bytes + at + 8)
                            if ((u | v) & 0x8080808080808080UL) != 0 {
                                break
                            }

                            at = at + 16
                        }
                    }

                    while at < count && bytes[at] < 128 {
                        at = at + 1
                    }
                }
            } else if at < lettersEnd {
                long second = long(bytes[at + 1])
                long third = long(bytes[at + 2])
                long fourth = long(bytes[at + 3])
                mut long width = 2
                if first >= 224 {
                    width = 3
                }

                if first >= 240 {
                    width = 4
                }

                mut long low = 128
                mut long high = 191
                if first == 224 {
                    low = 160
                }

                if first == 240 {
                    low = 144
                }

                if first == 237 {
                    high = 159
                }

                if first == 244 {
                    high = 143
                }

                bool continued = (width < 3 || (third & 192) == 128) && (width < 4 || (fourth & 192) == 128)
                if first >= 194 && first <= 244 && second >= low && second <= high && continued {
                    at = at + width
                } else {
                    bad = at
                    break
                }
            } else {
                long n = Utf8Sequence(bytes, count, at)
                if n < 0 {
                    bad = at
                    break
                }

                at = at + n
            }
        }
    }

    return bad
}

// The text of the `count` bytes at `bytes` with each maximal part of a sequence that is not UTF-8 read
// as U+FFFD, the bytes 239, 191 and 189: `string.FromUtf8Lossy` of bytes that hold such a part (T15).
// A text of more bytes than the largest `int` ends the process as a longer string does.
pub string Utf8Lossy(byte* bytes, long count) {
    mut long size = 0
    mut long at = 0
    while at < count {
        long n = Utf8Sequence(bytes, count, at)
        if n < 0 {
            size = size + 3
            at = at - n
        } else {
            size = size + n
            at = at + n
        }
    }

    if size > 2147483647 {
        AllocationFailed(size)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(size)
        mut long to = 0
        at = 0
        while at < count {
            long n = Utf8Sequence(bytes, count, at)
            if n < 0 {
                p[to] = 239
                p[to + 1] = 191
                p[to + 2] = 189
                to = to + 3
                at = at - n
            } else {
                mut long i = 0
                while i < n {
                    p[to + i] = bytes[at + i]
                    i = i + 1
                }

                to = to + n
                at = at + n
            }
        }

        text = string.FromRaw(p, size)
    }

    return text
}

// The bytes of a text written to standard error, each piece in as many write calls as it takes; a
// write the system refuses ends the writing there, since nothing more can be said.
void WriteError(string text) {
    long count = long(text.Bytes.Count)
    mut long done = 0
    while done < count {
        mut long written = -1
        raw {
            written = sys.Write(2, text.Pointer + done, count - done)
        }

        if written <= 0 {
            return
        }

        done = done + written
    }
}

// The decimal digits of a number written to standard error one at a time, so that the error line
// allocates nothing.
void WriteNumber(ulong value) {
    mut ulong unit = 1
    while value / unit >= 10 {
        unit = unit * 10
    }

    while unit > 0 {
        mut byte digit = byte(value / unit % 10 + 48)
        raw {
            sys.Write(2, &digit, 1)
        }

        unit = unit / 10
    }
}

// The text of an infinity or of NaN (A14).
string NoDigits(bool nan, bool negative) {
    if nan {
        return "NaN"
    }

    if negative {
        return "-Infinity"
    }

    return "Infinity"
}

// The text of a zero, `-0` for a negative one (A14).
string ZeroText(bool negative) {
    if negative {
        return "-0"
    }

    return "0"
}

// The text of `digits` times ten to the `power`, `-` before it when `negative`, as .NET writes a
// `double` (`precision` 17) or a `float` (9) with the invariant culture: where the part before the
// point would take more places than both the count of the digits and the precision, or more than
// three zeros would stand between the point and the first digit, the exponent form `1.5E+09`, with
// `E`, the sign and two digits or more; otherwise the digits with the point among them, after `0.`
// and zeros, or before zeros.
string DecimalText(bool negative, ulong digits, int power, int precision) {
    mut int count = 1
    mut ulong rest = digits / 10
    while rest > 0 {
        count = count + 1
        rest = rest / 10
    }

    int scale = count + power
    mut long sign = 0
    if negative {
        sign = 1
    }

    mut string text = ""
    if (scale > count && scale > precision) || scale < -3 {
        mut int magnitude = scale - 1
        mut byte mark = 43
        if magnitude < 0 {
            magnitude = -magnitude
            mark = 45
        }

        mut int width = 2
        if magnitude >= 100 {
            width = 3
        }

        mut long point = 0
        if count > 1 {
            point = 1
        }

        long at = sign + point + long(count)
        long total = at + 2 + long(width)
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign + point, digits, count)
            if count > 1 {
                p[sign] = p[sign + 1]
                p[sign + 1] = 46
            }

            p[at] = 69
            p[at + 1] = mark
            WriteDigits(p + at + 2, ulong(magnitude), width)
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else if scale <= 0 {
        long zeros = long(-scale)
        long total = sign + 2 + zeros + long(count)
        raw {
            byte* p = string.Allocate(total)
            p[sign] = 48
            p[sign + 1] = 46
            mut long i = 0
            while i < zeros {
                p[sign + 2 + i] = 48
                i = i + 1
            }

            WriteDigits(p + sign + 2 + zeros, digits, count)
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else if scale >= count {
        long total = sign + long(scale)
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign, digits, count)
            mut long i = sign + long(count)
            while i < total {
                p[i] = 48
                i = i + 1
            }

            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    } else {
        long total = sign + long(count) + 1
        raw {
            byte* p = string.Allocate(total)
            WriteDigits(p + sign + 1, digits, count)
            mut long i = 0
            while i < long(scale) {
                p[sign + i] = p[sign + 1 + i]
                i = i + 1
            }

            p[sign + long(scale)] = 46
            if negative {
                p[0] = 45
            }

            text = string.FromRaw(p, total)
        }
    }

    return text
}

// The `count` decimal digits of `value` at `p`, the last one at `p + count - 1`, which an interpolation
// writes an integer's digits into its block with (L6): four at a time and then two from the table of
// the pairs 00 to 99, as Rust's `Display` of an integer writes them, and the first alone.
pub void WriteDigits(byte* p, ulong value, int count) {
    mut ulong v = value
    mut long i = long(count)
    raw {
        byte* pairs = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899".Pointer
        while i >= 4 {
            ulong four = v % 10000
            v = v / 10000
            long high = long(four / 100) * 2
            long low = long(four % 100) * 2
            p[i - 4] = pairs[high]
            p[i - 3] = pairs[high + 1]
            p[i - 2] = pairs[low]
            p[i - 1] = pairs[low + 1]
            i = i - 4
        }

        if i >= 2 {
            long two = long(v % 100) * 2
            v = v / 100
            p[i - 2] = pairs[two]
            p[i - 1] = pairs[two + 1]
            i = i - 2
        }

        if i == 1 {
            p[0] = byte(v % 10 + 48)
        }
    }
}

// The digits of a finite nonzero `double`, given the fields of its 64 bits, and the power of ten they are
// multiplied by (Ryu's d2d): the 128-bit products of 5^q and of 2^k / 5^q bracket the value and its two
// bounds, and the digits are cut from the right while the bounds still differ.
void DoubleDigits(ulong mantissa, int exponent, mut ulong digits, mut int power) {
    mut int e2 = 1 - 1077
    mut ulong m2 = mantissa
    if exponent != 0 {
        e2 = exponent - 1077
        m2 = 4503599627370496 | mantissa
    }

    bool even = (m2 & 1) == 0
    ulong mv = 4 * m2
    mut ulong mmShift = 0
    if mantissa != 0 || exponent <= 1 {
        mmShift = 1
    }

    mut ulong vr = 0
    mut ulong vp = 0
    mut ulong vm = 0
    mut int e10 = 0
    mut bool vmZeros = false
    mut bool vrZeros = false
    mut ulong high = 0
    if e2 >= 0 {
        mut int q = Log10Pow2(e2)
        if e2 > 3 {
            q = q - 1
        }

        e10 = q
        int i = -e2 + q + 125 + Pow5Bits(q) - 1
        ulong low = InversePow5(q, mut high)
        vr = MulShift64(mv, low, high, i)
        vp = MulShift64(mv + 2, low, high, i)
        vm = MulShift64(mv - 1 - mmShift, low, high, i)
        if q <= 21 {
            if mv % 5 == 0 {
                vrZeros = Fives(mv) >= q
            } else if even {
                vmZeros = Fives(mv - 1 - mmShift) >= q
            } else if Fives(mv + 2) >= q {
                vp = vp - 1
            }
        }
    } else {
        mut int q = Log10Pow5(-e2)
        if -e2 > 1 {
            q = q - 1
        }

        e10 = q + e2
        int i = -e2 - q
        int j = q - Pow5Bits(i) + 125
        ulong low = Pow5(i, mut high)
        vr = MulShift64(mv, low, high, j)
        vp = MulShift64(mv + 2, low, high, j)
        vm = MulShift64(mv - 1 - mmShift, low, high, j)
        if q <= 1 {
            vrZeros = true
            if even {
                vmZeros = mmShift == 1
            } else {
                vp = vp - 1
            }
        } else if q < 63 {
            vrZeros = (mv & ((ulong(1) << q) - 1)) == 0
        }
    }

    mut int removed = 0
    digits = Shortest(vr, vp, vm, vmZeros, vrZeros, even, 0, mut removed)
    power = e10 + removed
}

// The same for a finite nonzero `float` (Ryu's f2d), through the high 64 bits of the same powers: one
// removed digit is computed beside them, since the 64-bit products give one digit fewer.
void FloatDigits(ulong mantissa, int exponent, mut ulong digits, mut int power) {
    mut int e2 = 1 - 152
    mut ulong m2 = mantissa
    if exponent != 0 {
        e2 = exponent - 152
        m2 = 8388608 | mantissa
    }

    bool even = (m2 & 1) == 0
    ulong mv = 4 * m2
    ulong mp = mv + 2
    mut ulong mmShift = 0
    if mantissa != 0 || exponent <= 1 {
        mmShift = 1
    }

    ulong mm = mv - 1 - mmShift
    mut ulong vr = 0
    mut ulong vp = 0
    mut ulong vm = 0
    mut int e10 = 0
    mut bool vmZeros = false
    mut bool vrZeros = false
    mut ulong last = 0
    if e2 >= 0 {
        int q = Log10Pow2(e2)
        e10 = q
        int i = -e2 + q + 61 + Pow5Bits(q) - 1
        ulong factor = InverseTop(q)
        vr = MulShift32(mv, factor, i)
        vp = MulShift32(mp, factor, i)
        vm = MulShift32(mm, factor, i)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            last = MulShift32(mv, InverseTop(q - 1), -e2 + q - 1 + 61 + Pow5Bits(q - 1) - 1) % 10
        }

        if q <= 9 {
            if mv % 5 == 0 {
                vrZeros = Fives(mv) >= q
            } else if even {
                vmZeros = Fives(mm) >= q
            } else if Fives(mp) >= q {
                vp = vp - 1
            }
        }
    } else {
        int q = Log10Pow5(-e2)
        e10 = q + e2
        int i = -e2 - q
        int j = q - Pow5Bits(i) + 61
        ulong factor = Pow5Top(i)
        vr = MulShift32(mv, factor, j)
        vp = MulShift32(mp, factor, j)
        vm = MulShift32(mm, factor, j)
        if q != 0 && (vp - 1) / 10 <= vm / 10 {
            last = MulShift32(mv, Pow5Top(i + 1), q - 1 - Pow5Bits(i + 1) + 61) % 10
        }

        if q <= 1 {
            vrZeros = true
            if even {
                vmZeros = mmShift == 1
            } else {
                vp = vp - 1
            }
        } else if q < 31 {
            vrZeros = (mv & ((ulong(1) << (q - 1)) - 1)) == 0
        }
    }

    mut int removed = 0
    digits = Shortest(vr, vp, vm, vmZeros, vrZeros, even, last, mut removed)
    power = e10 + removed
}

// The end of Ryu's algorithm: the fewest digits between the bounds `vm` and `vp` (each one a bound
// itself where its zeros say the bound is exact and `even` lets it count), cut from the right of `vr`,
// rounded by the digits cut, half to even where the value ends in a 5 and zeros; `removed` counts the
// digits cut.
ulong Shortest(ulong r, ulong p, ulong m, bool mZeros, bool rZeros, bool even, ulong lastDigit, mut int removed) {
    mut ulong vr = r
    mut ulong vp = p
    mut ulong vm = m
    mut bool vmZeros = mZeros
    mut bool vrZeros = rZeros
    mut ulong last = lastDigit
    if vmZeros || vrZeros {
        while vp / 10 > vm / 10 {
            vmZeros = vmZeros && vm % 10 == 0
            vrZeros = vrZeros && last == 0
            last = vr % 10
            vr = vr / 10
            vp = vp / 10
            vm = vm / 10
            removed = removed + 1
        }

        if vmZeros {
            while vm % 10 == 0 {
                vrZeros = vrZeros && last == 0
                last = vr % 10
                vr = vr / 10
                vp = vp / 10
                vm = vm / 10
                removed = removed + 1
            }
        }

        if vrZeros && last == 5 && vr % 2 == 0 {
            last = 4
        }

        if (vr == vm && (!even || !vmZeros)) || last >= 5 {
            return vr + 1
        }

        return vr
    }

    while vp / 10 > vm / 10 {
        last = vr % 10
        vr = vr / 10
        vp = vp / 10
        vm = vm / 10
        removed = removed + 1
    }

    if vr == vm || last >= 5 {
        return vr + 1
    }

    return vr
}

// The top 125 bits of 5^i, i from 0 to 325: the low 64 returned, the high 64 into `high`. Computed from the
// power of its row and 5^offset, then corrected by the two bits of `Pow5Offsets`.
ulong Pow5(int i, mut ulong high) {
    int row = i / 26
    int offset = i - row * 26
    ulong low = Pow5Low(row)
    high = Pow5High(row)
    if offset == 0 {
        return low
    }

    ulong m = PowerOf5(offset)
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    ulong low0 = Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    int delta = Pow5Bits(i) - Pow5Bits(row * 26)
    high = ShiftRight(sum, high1, delta)
    return ShiftRight(low0, sum, delta) + ((ulong(Pow5Offsets(i / 16)) >> ((i % 16) * 2)) & 3)
}

// 2^(125 + n - 1) / 5^i plus one, n the bits of 5^i, i from 0 to 291: the low 64 returned, the high 64 into
// `high`. Computed from the inverse power of the row above it, itself, times 5^offset, where Rust's `ryu`
// multiplies it less one and adds one, so the two-bit corrections of `InversePow5Offsets` are a table of
// this function's own, each stored one above the difference. `FloatingTests` holds the texts they give
// against what .NET writes.
ulong InversePow5(int i, mut ulong high) {
    int row = (i + 25) / 26
    int offset = row * 26 - i
    ulong low = InversePow5Low(row)
    high = InversePow5High(row)
    if offset == 0 {
        return low
    }

    ulong m = PowerOf5(offset)
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    ulong low0 = Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    int delta = Pow5Bits(row * 26) - Pow5Bits(i)
    high = ShiftRight(sum, high1, delta)
    return ShiftRight(low0, sum, delta) +% ((ulong(InversePow5Offsets(i / 16)) >> ((i % 16) * 2)) & 3) -% 1
}

// The high 64 bits of 5^i, for a `float` (Ryu's f2s through the table of the `double`).
ulong Pow5Top(int i) {
    mut ulong high = 0
    Pow5(i, mut high)
    return high
}

// The high 64 bits of 2^(125 + n - 1) / 5^i plus one, for a `float`.
ulong InverseTop(int i) {
    mut ulong high = 0
    InversePow5(i, mut high)
    return high + 1
}

// 5^n, n from 0 to 25.
ulong PowerOf5(int n) {
    mut ulong p = 1
    mut int k = 0
    while k < n {
        p = p * 5
        k = k + 1
    }

    return p
}

// The 128-bit product of two 64-bit numbers, from the products of their 32-bit halves: the low 64 bits
// returned, the high 64 into `high`.
ulong Multiply(ulong a, ulong b, mut ulong high) {
    ulong a0 = a & 4294967295
    ulong a1 = a >> 32
    ulong b0 = b & 4294967295
    ulong b1 = b >> 32
    ulong b00 = a0 * b0
    ulong mid1 = a1 * b0 + (b00 >> 32)
    ulong mid2 = a0 * b1 + (mid1 & 4294967295)
    high = a1 * b1 + (mid1 >> 32) + (mid2 >> 32)
    return (mid2 << 32) | (b00 & 4294967295)
}

// The 64 bits of the 128-bit number `high`:`low` from bit `distance` up, 0 < distance < 64.
ulong ShiftRight(ulong low, ulong high, int distance) => (high << (64 - distance)) | (low >> distance)

// m times the 128-bit number `high`:`low`, shifted right by j bits, as 64 bits (m below 2^55); j lies above 64
// for every exponent, as `FloatingTests` reaches through the largest value with each, so that `ShiftRight` takes
// a distance from 1 to 63.
ulong MulShift64(ulong m, ulong low, ulong high, int j) {
    mut ulong high1 = 0
    ulong low1 = Multiply(m, high, mut high1)
    mut ulong high0 = 0
    Multiply(m, low, mut high0)
    ulong sum = high0 +% low1
    if sum < high0 {
        high1 = high1 + 1
    }

    return ShiftRight(sum, high1, j - 64)
}

// m times a 64-bit factor, shifted right by `shift` bits, more than 32 (m below 2^32).
ulong MulShift32(ulong m, ulong factor, int shift) {
    ulong low = m * (factor & 4294967295)
    ulong high = m * (factor >> 32)
    return ((low >> 32) + high) >> (shift - 32)
}

// How often 5 divides `value`, which is not zero.
int Fives(ulong value) {
    mut ulong v = value
    mut int count = 0
    while v % 5 == 0 {
        v = v / 5
        count = count + 1
    }

    return count
}

// The bits of 5^e, e from 1 to 3528, and 1 for e = 0.
int Pow5Bits(int e) => int((long(e) * 1217359) >> 19) + 1

// The decimal exponent of 2^e rounded down, e from 0 to 1650.
int Log10Pow2(int e) => (e * 78913) >> 18

// The decimal exponent of 5^e rounded down, e from 0 to 2620.
int Log10Pow5(int e) => (e * 732923) >> 20

// The low 64 bits of the top 125 bits of 5^(26 * row), rows 0 to 12 (Ryu's small table, DOUBLE_POW5_SPLIT2).
ulong Pow5Low(int row) => match row {
    0 => 0x0
    1 => 0x0
    2 => 0xE549208B31ADB10
    3 => 0x6DC6AD264D8F0866
    4 => 0xEB1DBD923D8596CA
    5 => 0xB4C1B80B22AE923C
    6 => 0x5BB28B4E8F7E4C30
    7 => 0xF08AED437682D4FB
    8 => 0xB4EE134AD99BF150
    9 => 0x16499ECB70C25F03
    10 => 0x85A56EAD360865B0
    11 => 0x93DB1D57999890B
    else => 0xCF38BB735E3F36AC
}

// Their high 64 bits.
ulong Pow5High(int row) => match row {
    0 => 0x1000000000000000
    1 => 0x14ADF4B7320334B9
    2 => 0x1ABA4714957D300D
    3 => 0x1145B7E285BF98F5
    4 => 0x1652EFDC6018A1FC
    5 => 0x1CDA62055B2D9D83
    6 => 0x12A5568B9F52F416
    7 => 0x1819651531F9E78F
    8 => 0x1F25C186A6F04C28
    9 => 0x1420EB449C8842E6
    10 => 0x1A03FDE214CAF085
    11 => 0x10CFEB353A97DAD8
    else => 0x15BAAF44FA52673E
}

// The low 64 bits of 2^(125 + n - 1) / 5^(26 * row) plus one, n the bits of the power, rows 0 to 12
// (Ryu's small table, DOUBLE_POW5_INV_SPLIT2).
ulong InversePow5Low(int row) => match row {
    0 => 0x1
    1 => 0x52A6C95FC0655034
    2 => 0x7CA8D50071DFC806
    3 => 0x6520247D3556476E
    4 => 0x6139CDD76802E6E9
    5 => 0xF951A7FF43DE8C79
    6 => 0x7BE8BEE8D6E957E8
    7 => 0x8BD3F9E999A423EA
    8 => 0x848F973CB3EE3CE
    9 => 0x153285EBB9EFBFA2
    10 => 0xADEEE7F86C07B696
    11 => 0x4D686A4EAF182222
    else => 0x98C0A106E09EBD9F
}

// Their high 64 bits.
ulong InversePow5High(int row) => match row {
    0 => 0x2000000000000000
    1 => 0x18C240C4AECB13BB
    2 => 0x1327FC58DA0F6FF5
    3 => 0x1DA48CE468E7C702
    4 => 0x16EF5B40C2FC7779
    5 => 0x11BEBDF578B2F391
    6 => 0x1B758D848FAC54B0
    7 => 0x153EDA614071A3B7
    8 => 0x10701BD527B4978C
    9 => 0x196FBB9BB44DB44D
    10 => 0x13AE3591F5B4D936
    11 => 0x1E74404F3DAADA91
    else => 0x17900EA4FDA7C257
}

// What the low 64 bits of 5^i computed from its row lack, two bits for each i, 16 to a word: words 0 to 20.
uint Pow5Offsets(int row) => match row {
    0 => 0x0
    1 => 0x0
    2 => 0x0
    3 => 0x0
    4 => 0x40000000
    5 => 0x59695995
    6 => 0x55545555
    7 => 0x56555515
    8 => 0x41150504
    9 => 0x40555410
    10 => 0x44555145
    11 => 0x44504540
    12 => 0x45555550
    13 => 0x40004000
    14 => 0x96440440
    15 => 0x55565565
    16 => 0x54454045
    17 => 0x40154151
    18 => 0x55559155
    19 => 0x51405555
    else => 0x105
}

// The same for 2^(125 + n - 1) / 5^i plus one, each plus one: words 0 to 18.
uint InversePow5Offsets(int row) => match row {
    0 => 0xAAAA9AA9
    1 => 0x5556AA5A
    2 => 0x25555555
    3 => 0x55955959
    4 => 0x9A666559
    5 => 0x9A6AAAAA
    6 => 0x554559A6
    7 => 0x515A5554
    8 => 0x55555554
    9 => 0x69555A96
    10 => 0x555A99A9
    11 => 0xAA655699
    12 => 0xA66965A9
    13 => 0x96959555
    14 => 0x56555566
    15 => 0x55965A55
    16 => 0xAAA6A955
    17 => 0x5AAAAAAA
    else => 0x56
}

// ---- decimal (T2) ----------------------------------------------------------------------------------
//
// A `decimal` is C#'s System.Decimal, which the emitted code passes as two 64-bit words: the low 64 bits of its 96-bit
// integer, then the high 32 bits with System.Decimal's flags above them, the scale in bits 48 to 55 and the sign in bit 63.
// Its value is the integer divided by ten to the scale, from 0 to 28. The arithmetic, the comparison and the conversion into
// a `double` compute what System.Decimal computes, digit for digit and scale for scale (section 4); the conversion from a
// `double` takes its exact binary value (the owner, 2026-10-28, "Exact binary value"), and `%` the exact remainder where
// System.Decimal throws for one that fits ("Exact remainder"); a zero they compute has no sign (the owner, 2026-10-28, "None, as
// rust_decimal"). A result that leaves the range makes them return false, which the emitted code raises as `overflow` in
// every build (the owner, 2026-10-28, "Raise in every build"); the emitted code raises `divide-by-zero` before a division
// or a remainder by zero (T25).

// The sum of two `decimal`s: the exact sum at the larger of the two scales, brought into 96 bits by `Fit`. The emitted code
// subtracts by turning the sign of the second.
pub bool DecimalAdd(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int aScale = DecimalScale(aHigh)
    int bScale = DecimalScale(bHigh)
    mut ulong a0 = aLow
    mut ulong a1 = aHigh & 4294967295
    mut ulong a2 = 0
    mut ulong b0 = bLow
    mut ulong b1 = bHigh & 4294967295
    mut ulong b2 = 0
    mut int scale = aScale
    if aScale < bScale {
        ScaleUp(mut a0, mut a1, mut a2, bScale - aScale)
        scale = bScale
    } else if bScale < aScale {
        ScaleUp(mut b0, mut b1, mut b2, aScale - bScale)
    }

    mut bool negative = aHigh >> 63 == 1
    if negative == (bHigh >> 63 == 1) {
        Add192(mut a0, mut a1, mut a2, b0, b1, b2)
    } else if Below192(a0, a1, a2, b0, b1, b2) {
        Subtract192(mut b0, mut b1, mut b2, a0, a1, a2)
        a0 = b0
        a1 = b1
        a2 = b2
        negative = !negative
    } else {
        Subtract192(mut a0, mut a1, mut a2, b0, b1, b2)
    }

    return Fit(a0, a1, a2, scale, negative, mut low, mut high)
}

// The product of two `decimal`s: the exact product at the sum of the two scales, brought into 96 bits and a scale of at most
// 28 by `Fit`. Two numbers of 32 bits whose scales add up to more than 47 give 0 at the scale 0, and so does a zero beside a
// number of more than 32 bits, as System.Decimal gives them.
pub bool DecimalMultiply(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int scale = DecimalScale(aHigh) + DecimalScale(bHigh)
    bool negative = (aHigh ^ bHigh) >> 63 == 1
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    low = 0
    high = 0
    if a1 == 0 && aLow <= 4294967295 && b1 == 0 && bLow <= 4294967295 {
        if scale > 47 {
            return true
        }

        return Fit(aLow * bLow, 0, 0, scale, negative, mut low, mut high)
    }

    mut ulong p1 = 0
    ulong p0 = Multiply(aLow, bLow, mut p1)
    mut ulong p2 = a1 * b1
    mut ulong h = 0
    ulong l = Multiply(aLow, b1, mut h)
    p1 = p1 +% l
    if p1 < l {
        h = h + 1
    }

    p2 = p2 + h
    h = 0
    ulong m = Multiply(a1, bLow, mut h)
    p1 = p1 +% m
    if p1 < m {
        h = h + 1
    }

    p2 = p2 + h
    if (p0 | p1 | p2) == 0 {
        return true
    }

    return Fit(p0, p1, p2, scale, negative, mut low, mut high)
}

// The quotient of two `decimal`s, the divisor not zero. The integer quotient at the difference of the scales; where it is
// exact, that, at the scale 0 where the difference is below 0. Otherwise as many more digits as fit 96 bits and the scale 28,
// up to nine at a time, rounded half to even by the remainder, and its zeros at the end removed down to the scale 0
// (System.Decimal's VarDecDiv).
pub bool DecimalDivide(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    mut int scale = DecimalScale(aHigh) - DecimalScale(bHigh)
    bool negative = (aHigh ^ bHigh) >> 63 == 1
    ulong b1 = bHigh & 4294967295
    mut ulong q0 = 0
    mut ulong q1 = 0
    mut ulong r0 = 0
    mut ulong r1 = 0
    Divide96(aLow, aHigh & 4294967295, bLow, b1, mut q0, mut q1, mut r0, mut r1)
    bool inexact = (r0 | r1) != 0
    low = 0
    high = 0
    mut bool going = true
    while going {
        if (r0 | r1) == 0 {
            if scale >= 0 {
                going = false
            } else {
                mut int step = -scale
                if step > 9 {
                    step = 9
                }

                if !MultiplyFits(mut q0, mut q1, Pow10(step)) {
                    return false
                }

                scale = scale + step
            }
        } else {
            int step = ScaleRoom(q0, q1, scale)
            if step == 0 {
                if scale < 0 {
                    return false
                }

                // round by the remainder: twice it beside the divisor, a tie to the even quotient
                ulong t0 = r0 << 1
                ulong t1 = (r1 << 1) | (r0 >> 63)
                if t1 > b1 || (t1 == b1 && (t0 > bLow || (t0 == bLow && (q0 & 1) == 1))) {
                    q0 = q0 +% 1
                    if q0 == 0 {
                        q1 = q1 + 1
                    }

                    if q1 > 4294967295 {
                        // 2^96, one digit too many: 2^96 / 10 rounded, 7922816251426433759354395034
                        if scale == 0 {
                            return false
                        }

                        q0 = 11068046444225730970
                        q1 = 429496729
                        scale = scale - 1
                    }
                }

                going = false
            } else {
                // q times 10^step fits; the digits the remainder gives are added to it
                ulong power = Pow10(step)
                MultiplyFits(mut q0, mut q1, power)
                mut ulong n0 = r0
                mut ulong n1 = r1
                mut ulong n2 = 0
                MultiplyBy(mut n0, mut n1, mut n2, power)
                ulong digits = DivideBy96(n0, n1, bLow, b1, mut r0, mut r1)
                q0 = q0 +% digits
                if q0 < digits {
                    q1 = q1 + 1
                }

                scale = scale + step
                if q1 > 4294967295 {
                    // one digit too many: the 97 bits divided by 10, rounded half to even by that digit and the remainder
                    scale = scale - 1
                    if scale < 0 {
                        return false
                    }

                    mut ulong w0 = q0
                    mut ulong w1 = q1
                    mut ulong w2 = 0
                    ulong digit = DivideSmall(mut w0, mut w1, mut w2, 10)
                    q0 = w0
                    q1 = w1
                    if digit > 5 || (digit == 5 && ((r0 | r1) != 0 || (q0 & 1) == 1)) {
                        q0 = q0 +% 1
                        if q0 == 0 {
                            q1 = q1 + 1
                        }
                    }

                    going = false
                }
            }
        }
    }

    if inexact {
        Unscale(mut q0, mut q1, mut scale)
    }

    low = q0
    high = Pack(q1, scale, negative && (q0 | q1) != 0)
    return true
}

// The remainder of two `decimal`s, the divisor not zero: the dividend itself where it is zero or below the divisor in
// magnitude; otherwise the exact remainder at the larger of the two scales, with the sign of the dividend (T18; System.Decimal's
// VarDecMod).
pub void DecimalRemainder(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh, mut ulong low, mut ulong high) {
    int aScale = DecimalScale(aHigh)
    int bScale = DecimalScale(bHigh)
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    bool negative = aHigh >> 63 == 1
    low = aLow
    high = Pack(a1, aScale, negative && (aLow | a1) != 0)
    if (aLow | a1) == 0 {
        return
    }

    int order = CompareMagnitudes(aLow, a1, aScale, bLow, b1, bScale)
    if order < 0 {
        return
    }

    mut int scale = aScale
    if bScale > aScale {
        scale = bScale
    }

    low = 0
    high = Pack(0, scale, false)
    if order == 0 {
        return
    }

    mut ulong q0 = 0
    mut ulong q1 = 0
    mut ulong r0 = 0
    mut ulong r1 = 0
    if aScale >= bScale {
        // the divisor at the dividend's scale, which stays below the dividend
        mut ulong d0 = bLow
        mut ulong d1 = b1
        mut ulong d2 = 0
        ScaleUp(mut d0, mut d1, mut d2, aScale - bScale)
        Divide96(aLow, a1, d0, d1, mut q0, mut q1, mut r0, mut r1)
    } else {
        // the dividend at the divisor's scale, nine digits at a time, each time only its remainder kept
        Divide96(aLow, a1, bLow, b1, mut q0, mut q1, mut r0, mut r1)
        mut int rest = bScale - aScale
        while rest > 0 {
            mut int step = rest
            if step > 9 {
                step = 9
            }

            mut ulong n0 = r0
            mut ulong n1 = r1
            mut ulong n2 = 0
            MultiplyBy(mut n0, mut n1, mut n2, Pow10(step))
            DivideBy96(n0, n1, bLow, b1, mut r0, mut r1)
            rest = rest - step
        }
    }

    low = r0
    high = Pack(r1, scale, negative && (r0 | r1) != 0)
}

// -1, 0 or 1 as the first `decimal` is below, equal to or above the second, by their values: 1.5 equals 1.50, and 0 equals -0.
pub int DecimalCompare(ulong aLow, ulong aHigh, ulong bLow, ulong bHigh) {
    ulong a1 = aHigh & 4294967295
    ulong b1 = bHigh & 4294967295
    bool aZero = (aLow | a1) == 0
    bool bZero = (bLow | b1) == 0
    if aZero && bZero {
        return 0
    }

    bool aNegative = !aZero && aHigh >> 63 == 1
    bool bNegative = !bZero && bHigh >> 63 == 1
    if aNegative != bNegative {
        if aNegative {
            return -1
        }

        return 1
    }

    int order = CompareMagnitudes(aLow, a1, DecimalScale(aHigh), bLow, b1, DecimalScale(bHigh))
    if aNegative {
        return -order
    }

    return order
}

// A `double`, given its 64 bits, as a `decimal` (T26): its exact binary value, rounded half to even at the largest scale up to
// 28 at which the digits fit 96 bits, and its zeros at the end removed down to the scale 0 (the owner, 2026-10-28, "Exact
// binary value"); a zero has no sign. False for NaN, an infinity and a magnitude of 2^96 or more, which the emitted code raises
// as `overflow` in every build (the owner, 2026-10-28, "Raise in every build"). A `float` comes as the `double` that holds it.
pub bool DecimalFromDouble(ulong bits, mut ulong low, mut ulong high) {
    int exponent = int((bits >> 52) & 2047)
    ulong fraction = bits & 4503599627370495
    low = 0
    high = 0
    if exponent >= 1119 {
        return false
    }

    if exponent == 0 && fraction == 0 {
        return true
    }

    mut ulong m = fraction
    mut int e2 = -1074
    if exponent != 0 {
        m = fraction | 4503599627370496
        e2 = exponent - 1075
    }

    bool negative = bits >> 63 == 1
    if e2 >= 0 {
        // an integer below 2^96
        low = m << e2
        mut ulong top = 0
        if e2 > 0 {
            top = m >> (64 - e2)
        }

        high = Pack(top, 0, negative)
        return true
    }

    mut int scale = 28
    mut ulong d0 = 0
    mut ulong d1 = 0
    mut bool fits = false
    while !fits {
        mut ulong w0 = m
        mut ulong w1 = 0
        mut ulong w2 = 0
        ScaleUp(mut w0, mut w1, mut w2, scale)
        fits = ShiftRound(w0, w1, w2, -e2, mut d0, mut d1)
        if !fits {
            scale = scale - 1
        }
    }

    Unscale(mut d0, mut d1, mut scale)
    low = d0
    high = Pack(d1, scale, negative && (d0 | d1) != 0)
    return true
}

// A `decimal` as a `double`, as C# computes it (the owner, 2026-10-28, "As C# computes it"): the 96-bit integer as a `double`,
// its low 64 bits and its high 32 bits each converted, divided by ten to the scale as a `double`, the sign turned for a
// negative one. A `float` is this `double` rounded, as C# rounds it.
pub double DecimalToDouble(ulong low, ulong high) {
    double value = (double(low) + double(high & 4294967295) * 18446744073709551616.0) / DoublePower10(DecimalScale(high))
    if high >> 63 == 1 {
        return -value
    }

    return value
}

// The integer part of a `decimal`'s magnitude, its fraction dropped (T26), into `magnitude`; false where it takes more than
// 64 bits.
pub bool DecimalTruncate(ulong low, ulong high, mut ulong magnitude) {
    mut ulong q0 = low
    mut ulong q1 = high & 4294967295
    mut ulong q2 = 0
    mut int scale = DecimalScale(high)
    while scale > 0 {
        mut int step = scale
        if step > 9 {
            step = 9
        }

        DivideSmall(mut q0, mut q1, mut q2, Pow10(step))
        scale = scale - step
    }

    magnitude = q0
    return q1 == 0
}

// The text of a `decimal` (A8): the digits it holds, as many after the point as its scale says, `1.50` for 1.50m and `0.00` for
// a zero at the scale 2, and `-` before them where its sign is set, a negative zero's too (the owner, 2026-10-28, "Sign, as
// Rust").
pub string TextOfDecimal(ulong low, ulong high) {
    int scale = DecimalScale(high)
    bool negative = high >> 63 == 1
    mut ulong q0 = low
    mut ulong q1 = high & 4294967295
    mut ulong q2 = 0
    ulong r1 = DivideSmall(mut q0, mut q1, mut q2, 1000000000)
    ulong r2 = DivideSmall(mut q0, mut q1, mut q2, 1000000000)
    mut ulong bottom = r2 * 1000000000 + r1
    mut ulong top = q0
    mut long count = DigitCount(bottom)
    if top > 0 {
        count = 18 + DigitCount(top)
    }

    if count < long(scale) + 1 {
        count = long(scale) + 1
    }

    mut long length = count
    if scale > 0 {
        length = length + 1
    }

    if negative {
        length = length + 1
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(length)
        mut long i = length - 1
        mut long j = 0
        while j < count {
            if scale > 0 && j == long(scale) {
                p[i] = 46
                i = i - 1
            }

            mut ulong digit = 0
            if j < 18 {
                digit = bottom % 10
                bottom = bottom / 10
            } else {
                digit = top % 10
                top = top / 10
            }

            p[i] = byte(digit + 48)
            i = i - 1
            j = j + 1
        }

        if negative {
            p[0] = 45
        }

        text = string.FromRaw(p, length)
    }

    return text
}

// The scale of a `decimal`, from its high word.
int DecimalScale(ulong high) => int((high >> 48) & 255)

// The high word of a `decimal`: the high 32 bits of its integer, its scale and its sign.
ulong Pack(ulong top, int scale, bool negative) {
    mut ulong high = top | (ulong(scale) << 48)
    if negative {
        high = high | 9223372036854775808
    }

    return high
}

// The 192-bit magnitude w2:w1:w0 at `scale` (0 to 56) as a `decimal`, as System.Decimal brings a result into its 96 bits and its
// scales (ScaleResult): divided by the fewest powers of ten that leave at most 96 bits and a scale of at most 28, and rounded
// half to even once, by all the digits removed; where the rounding reaches 2^96, by one digit more. A zero has no sign. False
// where the scale would fall below 0.
bool Fit(ulong w0, ulong w1, ulong w2, int scale, bool negative, mut ulong low, mut ulong high) {
    mut ulong v0 = w0
    mut ulong v1 = w1
    mut ulong v2 = w2
    mut int s = scale
    mut int cut = 0
    if s > 28 {
        cut = s - 28
    }

    // a lower bound of the digits to remove: 77 / 256 is below log10(2)
    int bits = Bits192(v0, v1, v2)
    if bits > 96 {
        int least = ((bits - 96) * 77) >> 8
        if least > cut {
            cut = least
        }
    }

    if cut > s {
        return false
    }

    mut ulong remainder = 0
    mut ulong divisor = 1
    mut ulong sticky = 0
    while cut > 0 || v2 != 0 || v1 > 4294967295 {
        if cut == 0 {
            if s == 0 {
                return false
            }

            cut = 1
        }

        mut int step = cut
        if step > 9 {
            step = 9
        }

        sticky = sticky | remainder
        divisor = Pow10(step)
        remainder = DivideSmall(mut v0, mut v1, mut v2, divisor)
        cut = cut - step
        s = s - step
    }

    if divisor > 1 {
        ulong half = divisor / 2
        if remainder > half || (remainder == half && (sticky != 0 || (v0 & 1) == 1)) {
            v0 = v0 +% 1
            if v0 == 0 {
                v1 = v1 + 1
            }

            if v1 > 4294967295 {
                // 2^96, one digit too many: 2^96 / 10 rounded, 7922816251426433759354395034
                if s == 0 {
                    return false
                }

                v0 = 11068046444225730970
                v1 = 429496729
                s = s - 1
            }
        }
    }

    low = v0
    high = Pack(v1, s, negative && (v0 | v1) != 0)
    return true
}

// The trailing zeros of the 96-bit integer q1:q0 removed while the scale stays at least 0.
void Unscale(mut ulong q0, mut ulong q1, mut int scale) {
    while scale > 0 {
        mut ulong t0 = q0
        mut ulong t1 = q1
        mut ulong t2 = 0
        if DivideSmall(mut t0, mut t1, mut t2, 10) != 0 {
            return
        }

        q0 = t0
        q1 = t1
        scale = scale - 1
    }
}

// -1, 0 or 1 as the magnitude a1:a0 at `aScale` is below, equal to or above b1:b0 at `bScale`, compared at the larger scale.
int CompareMagnitudes(ulong a0, ulong a1, int aScale, ulong b0, ulong b1, int bScale) {
    mut ulong x0 = a0
    mut ulong x1 = a1
    mut ulong x2 = 0
    mut ulong y0 = b0
    mut ulong y1 = b1
    mut ulong y2 = 0
    if aScale < bScale {
        ScaleUp(mut x0, mut x1, mut x2, bScale - aScale)
    } else if bScale < aScale {
        ScaleUp(mut y0, mut y1, mut y2, aScale - bScale)
    }

    if Below192(x0, x1, x2, y0, y1, y2) {
        return -1
    }

    if Below192(y0, y1, y2, x0, x1, x2) {
        return 1
    }

    return 0
}

// The 96-bit a1:a0 divided by the 96-bit b1:b0, not zero: the quotient into q1:q0 and the remainder into r1:r0. A divisor of 32
// bits divides word by word; a wider one gives a quotient below 2^64, found 32 bits at a time.
void Divide96(ulong a0, ulong a1, ulong b0, ulong b1, mut ulong q0, mut ulong q1, mut ulong r0, mut ulong r1) {
    if b1 == 0 && b0 <= 4294967295 {
        mut ulong w0 = a0
        mut ulong w1 = a1
        mut ulong w2 = 0
        r0 = DivideSmall(mut w0, mut w1, mut w2, b0)
        r1 = 0
        q0 = w0
        q1 = w1
        return
    }

    mut ulong x0 = 0
    mut ulong x1 = 0
    ulong upper = DivideBy96((a1 << 32) | (a0 >> 32), 0, b0, b1, mut x0, mut x1)
    ulong lower = DivideBy96((x0 << 32) | (a0 & 4294967295), (x1 << 32) | (x0 >> 32), b0, b1, mut r0, mut r1)
    q0 = (upper << 32) | lower
    q1 = 0
}

// The 128-bit n1:n0 divided by the 96-bit b1:b0, not zero, where the quotient is below 2^32: the quotient returned and the
// remainder into r1:r0. A divisor of more than 32 bits: the quotient estimated from the top 32 bits of the divisor plus one,
// which is never above it and at most four below it, then corrected.
ulong DivideBy96(ulong n0, ulong n1, ulong b0, ulong b1, mut ulong r0, mut ulong r1) {
    if b1 == 0 && b0 <= 4294967295 {
        r0 = n0 % b0
        r1 = 0
        return n0 / b0
    }

    mut int shift = Bits(b0) - 32
    if b1 != 0 {
        shift = Bits(b1) + 32
    }

    mut ulong top = b1
    mut ulong head = n1
    if shift < 64 {
        top = ShiftRight(b0, b1, shift)
        head = ShiftRight(n0, n1, shift)
    }

    mut ulong q = head / (top + 1)
    mut ulong h = 0
    ulong m0 = Multiply(q, b0, mut h)
    ulong m1 = h + q * b1
    mut ulong x0 = n0 -% m0
    mut ulong x1 = n1 - m1
    if n0 < m0 {
        x1 = x1 - 1
    }

    while x1 > b1 || (x1 == b1 && x0 >= b0) {
        if x0 < b0 {
            x1 = x1 - 1
        }

        x0 = x0 -% b0
        x1 = x1 - b1
        q = q + 1
    }

    r0 = x0
    r1 = x1
    return q
}

// The largest power of ten, at most 9 and at most 28 - scale, by which the 96-bit q1:q0 can be multiplied and stay below
// 2^96: q at most (2^96 - 1) / 10^k (System.Decimal's SearchScale).
int ScaleRoom(ulong q0, ulong q1, int scale) {
    mut int k = 28 - scale
    if k > 9 {
        k = 9
    }

    while k > 0 && (q1 > RoomHigh(k) || (q1 == RoomHigh(k) && q0 > RoomLow(k))) {
        k = k - 1
    }

    return k
}

// (2^96 - 1) / 10^k rounded down, k from 1 to 9: the high 32 bits, then the low 64.
ulong RoomHigh(int k) => match k {
    1 => 429496729
    2 => 42949672
    3 => 4294967
    4 => 429496
    5 => 42949
    6 => 4294
    7 => 429
    8 => 42
    else => 4
}

ulong RoomLow(int k) => match k {
    1 => 11068046444225730969
    2 => 17708874310761169551
    3 => 5460236245818027278
    4 => 13458744476178488859
    5 => 12413920891843579855
    6 => 17843461755522954439
    7 => 9163043805036116090
    8 => 17518374046842208063
    else => 5441186219426131129
}

// The 96-bit q1:q0 times m, in place, where the product stays below 2^96; false where it does not.
bool MultiplyFits(mut ulong q0, mut ulong q1, ulong m) {
    mut ulong w0 = q0
    mut ulong w1 = q1
    mut ulong w2 = 0
    MultiplyBy(mut w0, mut w1, mut w2, m)
    if w2 != 0 || w1 > 4294967295 {
        return false
    }

    q0 = w0
    q1 = w1
    return true
}

// w2:w1:w0 divided by 2^k, k at least 1, rounded half to even into d1:d0; false where the result reaches 2^96.
bool ShiftRound(ulong w0, ulong w1, ulong w2, int k, mut ulong d0, mut ulong d1) {
    d0 = BitsFrom(w0, w1, w2, k)
    d1 = BitsFrom(w0, w1, w2, k + 64)
    ulong d2 = BitsFrom(w0, w1, w2, k + 128)
    bool half = (BitsFrom(w0, w1, w2, k - 1) & 1) == 1
    if half && (AnyBelow(w0, w1, w2, k - 1) || (d0 & 1) == 1) {
        d0 = d0 +% 1
        if d0 == 0 {
            d1 = d1 + 1
        }
    }

    return d2 == 0 && d1 <= 4294967295
}

// The 64 bits of w2:w1:w0 from bit `from` up; the bits above 191 are 0.
ulong BitsFrom(ulong w0, ulong w1, ulong w2, int from) {
    if from >= 192 {
        return 0
    }

    int bit = from % 64
    ulong low = Word192(w0, w1, w2, from / 64)
    if bit == 0 {
        return low
    }

    return (low >> bit) | (Word192(w0, w1, w2, from / 64 + 1) << (64 - bit))
}

// Whether any bit of w2:w1:w0 below bit `to` is set.
bool AnyBelow(ulong w0, ulong w1, ulong w2, int to) {
    if to >= 192 {
        return (w0 | w1 | w2) != 0
    }

    int word = to / 64
    if (word >= 1 && w0 != 0) || (word >= 2 && w1 != 0) {
        return true
    }

    return (Word192(w0, w1, w2, word) & ((ulong(1) << (to % 64)) -% 1)) != 0
}

// The word i, 0 to 2, of w2:w1:w0, and 0 above it.
ulong Word192(ulong w0, ulong w1, ulong w2, int i) => match i {
    0 => w0
    1 => w1
    2 => w2
    else => 0
}

// The 192-bit w2:w1:w0 times ten to the n, n from 0 to 28, in place.
void ScaleUp(mut ulong w0, mut ulong w1, mut ulong w2, int n) {
    mut int rest = n
    while rest > 0 {
        mut int step = rest
        if step > 19 {
            step = 19
        }

        MultiplyBy(mut w0, mut w1, mut w2, Pow10(step))
        rest = rest - step
    }
}

// The 192-bit w2:w1:w0 times m, in place; the bits above 192 returned.
ulong MultiplyBy(mut ulong w0, mut ulong w1, mut ulong w2, ulong m) {
    mut ulong h0 = 0
    ulong p0 = Multiply(w0, m, mut h0)
    mut ulong h1 = 0
    ulong p1 = Multiply(w1, m, mut h1)
    mut ulong h2 = 0
    ulong p2 = Multiply(w2, m, mut h2)
    w0 = p0
    w1 = p1 +% h0
    mut ulong carry = 0
    if w1 < h0 {
        carry = 1
    }

    ulong sum = p2 +% h1
    mut ulong over = h2
    if sum < h1 {
        over = over + 1
    }

    w2 = sum +% carry
    if w2 < carry {
        over = over + 1
    }

    return over
}

// The 192-bit w2:w1:w0 divided by d, from 1 to 2^32 - 1, in place; the remainder returned.
ulong DivideSmall(mut ulong w0, mut ulong w1, mut ulong w2, ulong d) {
    mut ulong r = 0
    w2 = DivideWord(w2, d, mut r)
    w1 = DivideWord(w1, d, mut r)
    w0 = DivideWord(w0, d, mut r)
    return r
}

// One word of a long division by d, below 2^32: the remainder so far, below d, in front of the word's two halves; the
// word of the quotient returned and the new remainder into r.
ulong DivideWord(ulong word, ulong d, mut ulong r) {
    ulong top = (r << 32) | (word >> 32)
    ulong upper = top / d
    ulong bottom = ((top - upper * d) << 32) | (word & 4294967295)
    ulong lower = bottom / d
    r = bottom - lower * d
    return (upper << 32) | lower
}

// a2:a1:a0 plus b2:b1:b0, in place, where the sum stays below 2^192.
void Add192(mut ulong a0, mut ulong a1, mut ulong a2, ulong b0, ulong b1, ulong b2) {
    ulong s0 = a0 +% b0
    mut ulong c0 = 0
    if s0 < b0 {
        c0 = 1
    }

    ulong t1 = a1 +% b1
    mut ulong c1 = 0
    if t1 < b1 {
        c1 = 1
    }

    ulong s1 = t1 +% c0
    if s1 < c0 {
        c1 = 1
    }

    a0 = s0
    a1 = s1
    a2 = a2 + b2 + c1
}

// a2:a1:a0 minus b2:b1:b0, in place, where a is not below b.
void Subtract192(mut ulong a0, mut ulong a1, mut ulong a2, ulong b0, ulong b1, ulong b2) {
    mut ulong borrow = 0
    if a0 < b0 {
        borrow = 1
    }

    mut ulong next = 0
    if a1 < b1 || (a1 == b1 && borrow == 1) {
        next = 1
    }

    a0 = a0 -% b0
    a1 = a1 -% b1 -% borrow
    a2 = a2 - b2 - next
}

// Whether a2:a1:a0 is below b2:b1:b0.
bool Below192(ulong a0, ulong a1, ulong a2, ulong b0, ulong b1, ulong b2) {
    if a2 != b2 {
        return a2 < b2
    }

    if a1 != b1 {
        return a1 < b1
    }

    return a0 < b0
}

// The count of bits of w2:w1:w0 up to its highest one.
int Bits192(ulong w0, ulong w1, ulong w2) {
    if w2 != 0 {
        return 128 + Bits(w2)
    }

    if w1 != 0 {
        return 64 + Bits(w1)
    }

    return Bits(w0)
}

// The count of bits of a word up to its highest one, 0 for 0.
int Bits(ulong value) {
    mut ulong v = value
    mut int n = 0
    if v >> 32 != 0 {
        v = v >> 32
        n = 32
    }

    if v >> 16 != 0 {
        v = v >> 16
        n = n + 16
    }

    if v >> 8 != 0 {
        v = v >> 8
        n = n + 8
    }

    if v >> 4 != 0 {
        v = v >> 4
        n = n + 4
    }

    if v >> 2 != 0 {
        v = v >> 2
        n = n + 2
    }

    if v >> 1 != 0 {
        v = v >> 1
        n = n + 1
    }

    return n + int(v)
}

// The count of decimal digits of a number, 1 for 0, which an interpolation counts an integer's with (L6),
// as Rust's `ilog10` counts them: ten digits and five at a time, then the last five from the bits that
// four sums set above the 17th, as its `less_than_5` reads them.
pub long DigitCount(ulong value) {
    mut ulong v = value
    mut long count = 1
    if v >= 10000000000 {
        v = v / 10000000000
        count = count + 10
    }

    if v >= 100000 {
        v = v / 100000
        count = count + 5
    }

    // each sum reaches the bits above the 17th by whether `v` reaches 10, 100, 1000 and 10000
    ulong tens = (v + 393206) & (v + 524188)
    ulong thousands = (v + 916504) & (v + 514288)
    return count + long((tens ^ thousands) >> 17)
}

// Ten to the n, n from 0 to 19.
ulong Pow10(int n) => match n {
    0 => 1
    1 => 10
    2 => 100
    3 => 1000
    4 => 10000
    5 => 100000
    6 => 1000000
    7 => 10000000
    8 => 100000000
    9 => 1000000000
    10 => 10000000000
    11 => 100000000000
    12 => 1000000000000
    13 => 10000000000000
    14 => 100000000000000
    15 => 1000000000000000
    16 => 10000000000000000
    17 => 100000000000000000
    18 => 1000000000000000000
    else => 10000000000000000000
}

// Ten to the n as a `double`, n from 0 to 28, each the `double` nearest it, as C#'s table of them.
double DoublePower10(int n) => match n {
    0 => 1.0
    1 => 1e1
    2 => 1e2
    3 => 1e3
    4 => 1e4
    5 => 1e5
    6 => 1e6
    7 => 1e7
    8 => 1e8
    9 => 1e9
    10 => 1e10
    11 => 1e11
    12 => 1e12
    13 => 1e13
    14 => 1e14
    15 => 1e15
    16 => 1e16
    17 => 1e17
    18 => 1e18
    19 => 1e19
    20 => 1e20
    21 => 1e21
    22 => 1e22
    23 => 1e23
    24 => 1e24
    25 => 1e25
    26 => 1e26
    27 => 1e27
    else => 1e28
}

// ---- the time types (T13, T29) -----------------------------------------------------------------------
//
// The emitted code passes a duration or a timestamp of either width as the two 64-bit words of its 128 bits, the low one
// first, a narrow one extended by its sign: a count of nanoseconds, that of a timestamp from 1970-01-01 in UTC (T24). Their
// arithmetic, its overflow and their conversions are the emitted code's (T31).

// The text of a duration (A12): its value split into `days`, `h`, `min`, `s`, `ms`, `us` and `ns`, from the largest down,
// each at most once and a zero count left out, `0ms` for zero and `-` before the whole of a negative one; the days of a
// `longduration` reach 25 digits.
pub string TextOfDuration(ulong low, ulong high) {
    mut ulong w0 = low
    mut ulong w1 = high
    bool negative = high >> 63 == 1
    if negative {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    ulong nanos = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong micros = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong millis = DivideSmall(mut w0, mut w1, mut w2, 1000)
    ulong seconds = DivideSmall(mut w0, mut w1, mut w2, 60)
    ulong minutes = DivideSmall(mut w0, mut w1, mut w2, 60)
    ulong hours = DivideSmall(mut w0, mut w1, mut w2, 24)
    mut string text = ""
    raw {
        byte* p = string.Allocate(72)
        mut long n = 0
        if negative {
            p[0] = 45
            n = 1
        }

        long first = n
        if w0 != 0 || w1 != 0 {
            n = WideDigits(p, n, w0, w1, 1)
            n = PutText(p, n, "days")
        }

        n = TimePart(p, n, first, hours, "h")
        n = TimePart(p, n, first, minutes, "min")
        n = TimePart(p, n, first, seconds, "s")
        n = TimePart(p, n, first, millis, "ms")
        n = TimePart(p, n, first, micros, "us")
        n = TimePart(p, n, first, nanos, "ns")
        if n == first {
            n = PutText(p, n, "0ms")
        }

        text = string.FromRaw(p, n)
    }

    return text
}

// The text of a timestamp (A16): its instant in UTC as RFC 3339 writes it, `2026-10-28T09:30:00Z`, the fraction of a second in
// groups of three digits, as many as hold it and none for a whole second, and a year outside 0000 to 9999 with its sign and at
// least four digits, as Rust's chrono writes them; the date in the Gregorian calendar before its introduction as well, with a
// year 0 and no leap second, by Howard Hinnant's `civil_from_days`, which counts the days from 0000-03-01 in eras of 400 years.
pub string TextOfTimestamp(ulong low, ulong high) {
    mut ulong w0 = low
    mut ulong w1 = high
    ulong nanos = FloorDivide(mut w0, mut w1, 1000000000)
    ulong second = FloorDivide(mut w0, mut w1, 86400)
    Add128(mut w0, mut w1, 719468)
    ulong dayOfEra = FloorDivide(mut w0, mut w1, 146097)
    ulong yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    ulong dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    ulong shifted = (5 * dayOfYear + 2) / 153
    ulong day = dayOfYear - (153 * shifted + 2) / 5 + 1
    mut ulong month = shifted + 3
    mut ulong years = yearOfEra
    if shifted >= 10 {
        month = shifted - 9
        years = years + 1
    }

    // the year: the era times 400 and the years after its start, as a sign and a magnitude; an era before the year 0 holds
    // more than 400 years, so its sum is no positive year
    bool before = w1 >> 63 == 1
    if before {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    MultiplyBy(mut w0, mut w1, mut w2, 400)
    if before {
        Subtract128(mut w0, mut w1, years)
    } else {
        Add128(mut w0, mut w1, years)
    }

    mut string text = ""
    raw {
        byte* p = string.Allocate(64)
        mut long n = 0
        if before && (w0 != 0 || w1 != 0) {
            p[0] = 45
            n = 1
        } else if w1 != 0 || w0 > 9999 {
            p[0] = 43
            n = 1
        }

        n = WideDigits(p, n, w0, w1, 4)
        p[n] = 45
        WriteDigits(p + n + 1, month, 2)
        p[n + 3] = 45
        WriteDigits(p + n + 4, day, 2)
        p[n + 6] = 84
        WriteDigits(p + n + 7, second / 3600, 2)
        p[n + 9] = 58
        WriteDigits(p + n + 10, second / 60 % 60, 2)
        p[n + 12] = 58
        WriteDigits(p + n + 13, second % 60, 2)
        n = n + 15
        if nanos != 0 {
            p[n] = 46
            if nanos % 1000000 == 0 {
                WriteDigits(p + n + 1, nanos / 1000000, 3)
                n = n + 4
            } else if nanos % 1000 == 0 {
                WriteDigits(p + n + 1, nanos / 1000, 6)
                n = n + 7
            } else {
                WriteDigits(p + n + 1, nanos, 9)
                n = n + 10
            }
        }

        p[n] = 90
        text = string.FromRaw(p, n + 1)
    }

    return text
}

// ` <count><name>` written at `p + n`, without the space where nothing stands after `first`, and nothing for a zero count; the
// place after it returned.
long TimePart(byte* p, long n, long first, ulong count, string name) {
    if count == 0 {
        return n
    }

    mut long at = n
    if at > first {
        raw {
            p[at] = 32
        }

        at = at + 1
    }

    long digits = DigitCount(count)
    WriteDigits(p + at, count, int(digits))
    return PutText(p, at + digits, name)
}

// The bytes of `s` written at `p + n`; the place after them returned.
long PutText(byte* p, long n, string s) {
    long count = long(s.Bytes.Count)
    raw {
        byte* from = s.Pointer
        mut long i = 0
        while i < count {
            p[n + i] = from[i]
            i = i + 1
        }
    }

    return n + count
}

// The decimal digits of the 128-bit high:low written at `p + n`, at least `least` of them, zeros before the first where it has
// fewer; the place after the last returned.
long WideDigits(byte* p, long n, ulong low, ulong high, long least) {
    mut ulong c0 = low
    mut ulong c1 = high
    mut ulong c2 = 0
    mut long count = 0
    while count == 0 || c0 != 0 || c1 != 0 {
        DivideSmall(mut c0, mut c1, mut c2, 10)
        count = count + 1
    }

    if count < least {
        count = least
    }

    mut ulong w0 = low
    mut ulong w1 = high
    mut ulong w2 = 0
    mut long i = n + count - 1
    raw {
        while i >= n {
            p[i] = byte(DivideSmall(mut w0, mut w1, mut w2, 10) + 48)
            i = i - 1
        }
    }

    return n + count
}

// The signed 128-bit w1:w0 divided by d, from 1 to 2^32 - 1, rounded toward negative infinity, in place; the remainder
// returned, from 0 to d - 1.
ulong FloorDivide(mut ulong w0, mut ulong w1, ulong d) {
    bool negative = w1 >> 63 == 1
    if negative {
        Negate128(mut w0, mut w1)
    }

    mut ulong w2 = 0
    mut ulong r = DivideSmall(mut w0, mut w1, mut w2, d)
    if negative {
        if r != 0 {
            Add128(mut w0, mut w1, 1)
            r = d - r
        }

        Negate128(mut w0, mut w1)
    }

    return r
}

// The 128-bit w1:w0 negated in two's complement, in place.
void Negate128(mut ulong w0, mut ulong w1) {
    w0 = ~w0 +% 1
    w1 = ~w1
    if w0 == 0 {
        w1 = w1 +% 1
    }
}

// The 128-bit w1:w0 plus k, in place, wrapping as two's complement does.
void Add128(mut ulong w0, mut ulong w1, ulong k) {
    w0 = w0 +% k
    if w0 < k {
        w1 = w1 +% 1
    }
}

// The 128-bit w1:w0 minus k, in place, wrapping as two's complement does.
void Subtract128(mut ulong w0, mut ulong w1, ulong k) {
    bool borrow = w0 < k
    w0 = w0 -% k
    if borrow {
        w1 = w1 -% 1
    }
}

// ---- logging (chapter 17) -------------------------------------------------------------------------

// The text of `KURZ_LOG` that `LogFilter` kept (P4), whose string the start holds to the end of the process, and the count of its
// bytes; none where the variable is not set.
static mut byte* logFilter = null
static mut long logFilterCount = 0

// The lines dropped since the last line written: a line whose write the system refused, or took in part (P9).
static mut long logDropped = 0

// A line the system took in part before a write that took nothing (P9): the stream stands inside it, and a line feed ends it before
// the next line written.
// Both are read and written under the lock of standard error, which a line's write holds from its first read of them to its last write
// (`LogLine`, `StreamLock`), so that two threads that log at once neither both write the line feed nor lose a line of the count.
static mut bool logCut = false

// The buffer of each thread in which `LogLine` puts a line together before its write, and its size, in the
// thread's own heap (`AllocateOwn`).
thread static mut byte* logBuffer = null
thread static mut long logRoom = 0

// The filter of a program with a log call (P4, P5), `found` as the target's `Variable` gave it for `KURZ_LOG`: kept, and the lowest
// level a call site can be on at, from 0 for `Trace` to 6 for `None`, `Information`'s where the variable is not set. An entry that is
// neither a level nor `prefix=level` ends the process before the program's first statement with `error: log-filter (<the entry>)` on
// standard error and the exit code 1, and a value that is not UTF-8 with `error: log-filter (not unicode)`.
pub int LogFilter(int found, string text) {
    if found == 2 {
        raw {
            LogRefused("not unicode".Pointer, 11)
        }
    }

    if found != 0 {
        return 2
    }

    long count = long(text.Bytes.Count)
    raw {
        logFilter = text.Pointer
        logFilterCount = count
    }

    mut int bare = 2
    mut int lowest = 6
    mut long at = 0
    while at < count {
        mut long first = 0
        mut long last = 0
        mut long equals = -1
        long next = LogEntry(at, mut first, mut last, mut equals)
        if first < last {
            if equals < 0 {
                bare = LogLevelOf(first, last)
                if bare < 0 {
                    raw {
                        LogRefused(logFilter + first, last - first)
                    }
                }
            } else {
                int level = LogLevelOf(equals + 1, last)
                if equals == first || level < 0 {
                    raw {
                        LogRefused(logFilter + first, last - first)
                    }
                }

                if level < lowest {
                    lowest = level
                }
            }
        }

        at = next
    }

    if bare < lowest {
        lowest = bare
    }

    return lowest
}

// Whether a call site of the category and the level is on (P4, P5): the level of the entry `prefix=level` whose prefix the category
// starts with, the longest such prefix, the last of two alike, as .NET's rule selector picks a rule; else the level of the last bare
// entry, else `Information`'s. Letters are compared with no regard to case, as .NET compares a category.
pub bool LogEnabled(string category, int level) {
    mut int bare = 2
    mut int matched = 2
    mut long longest = -1
    mut long count = 0
    raw {
        count = logFilterCount
    }

    mut long at = 0
    while at < count {
        mut long first = 0
        mut long last = 0
        mut long equals = -1
        long next = LogEntry(at, mut first, mut last, mut equals)
        if first < last {
            if equals < 0 {
                bare = LogLevelOf(first, last)
            } else if equals - first >= longest && LogStartsWith(category, first, equals) {
                longest = equals - first
                matched = LogLevelOf(equals + 1, last)
            }
        }

        at = next
    }

    if longest >= 0 {
        return level >= matched
    }

    return level >= bare
}

// The entry of the filter that starts at `at` and ends at the next comma or at the end: its first byte and the byte after its last,
// the spaces around it left out, in `first` and `last`, and the place of its first `=`, or -1, in `equals`; the place after the comma.
long LogEntry(long at, mut long first, mut long last, mut long equals) {
    mut long end = at
    raw {
        while end < logFilterCount && logFilter[end] != 44 {
            end = end + 1
        }

        first = at
        while first < end && logFilter[first] == 32 {
            first = first + 1
        }

        last = end
        while last > first && logFilter[last - 1] == 32 {
            last = last - 1
        }

        equals = -1
        mut long i = first
        while i < last && equals < 0 {
            if logFilter[i] == 61 {
                equals = i
            }

            i = i + 1
        }
    }

    return end + 1
}

// The level the bytes of the filter from `first` to `last` name, with no regard to case, from 0 for `Trace` to 6 for `None`; -1 where
// they name none.
int LogLevelOf(long first, long last) {
    if LogNamed(first, last, "trace") {
        return 0
    }

    if LogNamed(first, last, "debug") {
        return 1
    }

    if LogNamed(first, last, "information") {
        return 2
    }

    if LogNamed(first, last, "warning") {
        return 3
    }

    if LogNamed(first, last, "error") {
        return 4
    }

    if LogNamed(first, last, "critical") {
        return 5
    }

    if LogNamed(first, last, "none") {
        return 6
    }

    return -1
}

// Whether the bytes of the filter from `first` to `last` are `name`, a word in lower case, with no regard to the case of a letter.
bool LogNamed(long first, long last, string name) {
    if last - first != long(name.Bytes.Count) {
        return false
    }

    raw {
        byte* p = name.Pointer
        mut long i = 0
        while i < last - first {
            if LogLower(logFilter[first + i]) != p[i] {
                return false
            }

            i = i + 1
        }
    }

    return true
}

// Whether the category starts with the bytes of the filter from `first` to `end`, with no regard to the case of a letter.
bool LogStartsWith(string category, long first, long end) {
    if long(category.Bytes.Count) < end - first {
        return false
    }

    raw {
        byte* p = category.Pointer
        mut long i = 0
        while i < end - first {
            if LogLower(logFilter[first + i]) != LogLower(p[i]) {
                return false
            }

            i = i + 1
        }
    }

    return true
}

// A letter of ASCII in lower case, every other byte as it is.
byte LogLower(byte b) {
    if b >= 65 && b <= 90 {
        return byte(b | 32)
    }

    return b
}

// The end of a start whose filter is refused (P4): `error: log-filter (<the entry>)` on standard error and the exit code 1.
void LogRefused(byte* entry, long count) {
    WriteError("error: log-filter (")
    mut long done = 0
    while done < count {
        mut long written = -1
        raw {
            written = sys.Write(2, entry + done, count - done)
        }

        if written <= 0 {
            sys.Exit(1)
        }

        done = done + written
    }

    WriteError(")\n")
    sys.Exit(1)
}

// A `string` field's value (P7): the text in double quotes, each `"` and `\` in it after a `\`; `LogLine` writes a line break as `\n`.
pub string LogQuoted(string text) {
    long count = long(text.Bytes.Count)
    mut string quoted = ""
    raw {
        byte* from = text.Pointer
        byte* p = string.Allocate(2 * count + 2)
        p[0] = 34
        mut long n = 1
        mut long i = 0
        while i < count {
            if from[i] == 34 || from[i] == 92 {
                p[n] = 92
                n = n + 1
            }

            p[n] = from[i]
            n = n + 1
            i = i + 1
        }

        p[n] = 34
        quoted = string.FromRaw(p, n + 1)
    }

    return quoted
}

// The line of a call site that is on (P6, P7, P9), `<time> <level> <category>: <message><fields>` and a line feed, a line feed in the
// message or a field written as `\n`, a carriage return as `\r` and a `\` in the message as `\\`, handed to the system's write call in
// one piece, which is called again for what a call did not take. Where lines were dropped, the line
// `<time> Warning Kurz.Log: dropped <n> lines` stands before it, in the same write, and where a line was cut short, a line feed before
// both. A write the system refuses, or one that takes no byte, raises nothing: the line is counted as dropped, and the stream stands
// inside a line where the bytes taken end inside one; a line of the dropped lines taken whole is not counted again. The line is put
// together and written under the lock of standard error (`StreamLock`), which keeps the count and the flag with it.
pub void LogLine(int level, string category, string message, string fields, long nanoseconds) {
    long size = 128 + long(category.Bytes.Count) + 2 * long(message.Bytes.Count) + 2 * long(fields.Bytes.Count)
    mut long n = 0
    mut long feed = 0
    mut long notice = 0
    raw {
        if size > logRoom {
            if logBuffer != null {
                std.Free(logBuffer, logRoom)
            }

            logRoom = size
            if logRoom < 4096 {
                logRoom = 4096
            }

            logBuffer = AllocateOwn(logRoom)
        }
    }

    StreamLock(2)
    raw {
        if logCut {
            logBuffer[0] = 10
            n = 1
        }

        feed = n
        if logDropped > 0 {
            n = LogStamp(logBuffer, n, nanoseconds)
            n = LogPut(logBuffer, n, " Warning Kurz.Log: dropped ")
            long digits = DigitCount(ulong(logDropped))
            WriteDigits(logBuffer + n, ulong(logDropped), int(digits))
            n = n + digits
            if logDropped == 1 {
                n = LogPut(logBuffer, n, " line\n")
            } else {
                n = LogPut(logBuffer, n, " lines\n")
            }
        }

        notice = n
        n = LogStamp(logBuffer, n, nanoseconds)
        logBuffer[n] = 32
        n = LogPut(logBuffer, n + 1, LogLevelName(level))
        logBuffer[n] = 32
        n = LogPut(logBuffer, n + 1, category)
        logBuffer[n] = 58
        logBuffer[n + 1] = 32
        n = LogEscaped(logBuffer, n + 2, message, true)
        n = LogEscaped(logBuffer, n, fields, false)
        logBuffer[n] = 10
        n = n + 1
    }

    mut long done = 0
    while done < n {
        mut long written = -1
        raw {
            written = sys.Write(2, logBuffer + done, n - done)
        }

        if written <= 0 {
            raw {
                if done >= notice {
                    logDropped = 1
                } else {
                    logDropped = logDropped + 1
                }

                logCut = done != feed && done != notice
            }

            StreamUnlock(2)
            return
        }

        done = done + written
    }

    raw {
        logDropped = 0
        logCut = false
    }

    StreamUnlock(2)
}

// The name of a level as C#'s `LogLevel` writes it (P7).
string LogLevelName(int level) {
    if level == 0 {
        return "Trace"
    }

    if level == 1 {
        return "Debug"
    }

    if level == 2 {
        return "Information"
    }

    if level == 3 {
        return "Warning"
    }

    if level == 4 {
        return "Error"
    }

    return "Critical"
}

// The bytes of the text at `p + n`; the place after them.
long LogPut(byte* p, long n, string text) {
    long count = long(text.Bytes.Count)
    raw {
        byte* from = text.Pointer
        mut long i = 0
        while i < count {
            p[n + i] = from[i]
            i = i + 1
        }
    }

    return n + count
}

// The bytes of the text at `p + n`, a line feed as `\n` and a carriage return as `\r`, so that no value makes a second line, and where
// `backslash` holds, a `\` as `\\`, so that a `\n` in the message is a line feed (P7); the place after them.
long LogEscaped(byte* p, long n, string text, bool backslash) {
    long count = long(text.Bytes.Count)
    mut long at = n
    raw {
        byte* from = text.Pointer
        mut long i = 0
        while i < count {
            if from[i] == 10 {
                p[at] = 92
                p[at + 1] = 110
                at = at + 2
            } else if from[i] == 13 {
                p[at] = 92
                p[at + 1] = 114
                at = at + 2
            } else if backslash && from[i] == 92 {
                p[at] = 92
                p[at + 1] = 92
                at = at + 2
            } else {
                p[at] = from[i]
                at = at + 1
            }

            i = i + 1
        }
    }

    return at
}

// The time of a line at `p + at` (P6, P7): the instant in UTC as RFC 3339 writes it, with three digits of milliseconds,
// `2026-11-05T01:23:45.678Z`, the date by Howard Hinnant's `civil_from_days`, as `TextOfTimestamp` counts it, for the years a time of
// 64 bits in nanoseconds holds, 1677 to 2262; the place after it.
long LogStamp(byte* p, long at, long nanoseconds) {
    mut long seconds = nanoseconds / 1000000000
    mut long fraction = nanoseconds % 1000000000
    if fraction < 0 {
        fraction = fraction + 1000000000
        seconds = seconds - 1
    }

    mut long days = seconds / 86400
    mut long second = seconds % 86400
    if second < 0 {
        second = second + 86400
        days = days - 1
    }

    long shifted = days + 719468
    long era = shifted / 146097
    long dayOfEra = shifted - era * 146097
    long yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    long dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    long monthShifted = (5 * dayOfYear + 2) / 153
    long day = dayOfYear - (153 * monthShifted + 2) / 5 + 1
    mut long month = monthShifted + 3
    mut long year = era * 400 + yearOfEra
    if monthShifted >= 10 {
        month = monthShifted - 9
        year = year + 1
    }

    raw {
        WriteDigits(p + at, ulong(year), 4)
        p[at + 4] = 45
        WriteDigits(p + at + 5, ulong(month), 2)
        p[at + 7] = 45
        WriteDigits(p + at + 8, ulong(day), 2)
        p[at + 10] = 84
        WriteDigits(p + at + 11, ulong(second / 3600), 2)
        p[at + 13] = 58
        WriteDigits(p + at + 14, ulong(second / 60 % 60), 2)
        p[at + 16] = 58
        WriteDigits(p + at + 17, ulong(second % 60), 2)
        p[at + 19] = 46
        WriteDigits(p + at + 20, ulong(fraction / 1000000), 3)
        p[at + 23] = 90
    }

    return at + 24
}

// ---- running a program (design record, section 12) ---------------------------------------------------

// A command (S17), as the emitted code lays it out: a list of strings, the program first, then three
// strings for each member in the order of its calls, the member's tag and its two values: `a` an
// argument, `d` the working directory, `e` a variable of the environment and its value, `r` a variable
// taken away, `c` the environment cleared, and `0`, `1` and `2` standard input, output and error with
// the letter of their `Stdio`, `i`, `p` or `n`, `b` the child's input, as `CommandInput` writes it, and `t`
// a bound on its time in nanoseconds. A member appends to the list the emitted code gives it: a command no other value holds, the result of the
// member before it in a chain or the variable that `cmd = cmd.Arg(x)` writes, is changed in place, and
// one another value holds is copied by the first `Add`, as any list a write finds shared (M3), so that
// the command the member was called on stays as it was.
pub List<string> CommandNew(string program) {
    mut command = List<string>()
    command.Add(program)
    return command
}

// One member more on the command, its tag and its two values.
pub void CommandAdd(mut List<string> command, string tag, string first, string second) {
    command.Add(tag)
    command.Add(first)
    command.Add(second)
}

// An argument more on the command for each word of the list, in its order (`Args`, S17).
pub void CommandArgs(mut List<string> command, List<string> words) {
    for word in words {
        CommandAdd(mut command, "a", word, "")
    }
}

// One of the command's streams set, 0 standard input, 1 output and 2 error (`Stdin`, `Stdout` and
// `Stderr`, S17).
pub void CommandStream(mut List<string> command, int stream, Stdio mode) {
    mut letter = "n"
    if mode == Stdio.Inherit {
        letter = "i"
    } else if mode == Stdio.Piped {
        letter = "p"
    }

    CommandAdd(mut command, "{stream}", letter, "")
}

// The child's input, `Input(bytes)` (S19), held in the command as a string, since the command is a list of
// strings and a string holds UTF-8 alone (R15): each byte below 128 as it is, and each other one as the two
// bytes of the code point of its number, as Latin-1 reads a byte, so that text of ASCII takes no byte more.
pub void CommandInput(mut List<string> command, Bytes bytes) {
    mut long size = 0
    for b in bytes {
        size = size + 1
        if b >= 128 {
            size = size + 1
        }
    }

    mut string text = ""
    if size > 0 {
        raw {
            byte* p = string.Allocate(size)
            mut long at = 0
            for b in bytes {
                if b < 128 {
                    p[at] = b
                    at = at + 1
                } else {
                    p[at] = byte(192 | (int(b) >> 6))
                    p[at + 1] = byte(128 | (int(b) & 63))
                    at = at + 2
                }
            }

            text = string.FromRaw(p, size)
        }
    }

    CommandAdd(mut command, "b", text, "")
}

// S19: the input as a `string`, whose UTF-8 bytes the child reads (the owner, 2026-11-11, "Bytes and string")
pub void CommandInputText(mut List<string> command, string text) {
    CommandInput(mut command, text.Bytes)
}

// A bound on the command's time, its nanoseconds, a `duration` as the emitted code gives it (`Timeout`,
// S20).
pub void CommandTimeout(mut List<string> command, long nanoseconds) {
    CommandAdd(mut command, "t", "{nanoseconds}", "")
}

// The text of an `ExitError` (S18): what ended the child and the program, `exit status 3: sh` or
// `signal 15: sh`.
pub string ExitErrorText(ExitError e) {
    mut text = "exit status {e.Output.Status.Code}: {e.Program}"
    match e.Output.Status.Signal {
        int signal => text = "signal {signal}: {e.Program}"
        null => {}
    }

    return text
}

// ---- actors (chapter 19) -----------------------------------------------------------------------------

// The actors of a program run on the one thread the runtime runs, while the top-level code waits for a
// call's result (U4), as tokio's `current_thread` runtime runs its tasks inside `block_on`
// (compiler/README.md, "What the emitter emits"). An actor's state, which the emitted code constructs, has
// the actor's record in the 144 bytes in front of it, as a string's block stands in front of its bytes, and its
// reference is the index of its slot in the table of the process and its number (below), a multiple of 16
// so that the state keeps the alignment of the allocator's
// block, as Rust's `ArcInner` pads its counts to what it holds: the queue of many senders its messages are
// put on and the queue its blocks are posted on, 24 bytes each (`Pushed`), the name of the actor's type, whether the
// actor runs (0), waits for its restart (1), ended (3) (U19, U22), has its constructor run at its `spawn` (4)
// (U3, U25) or waits for the decision of the block of its policy (5) (U28), an `int`, and beside it the actor's
// state word, an `int`
// set once by a plain store before the actor can be reached (`ActorNew`) and read and changed only by atomic
// operations after that, which says whether a thread holds the actor and whether an
// entry of it stands in the run queue (`StateWord`), the block of its
// restart, which its supervisor's heap holds (U22), a block that names no function to run where its policy
// is `escalate`, null where it does not restart (U25), its supervisor, null for the top-level code (U13), the actor's heap
// (design record, section 3), the index of its slot in the table, the size of the actor's stack its clause asked
// for (U1), the actor's number (U2), the first message of its inbox, the last, the actor after it in the
// run queue, and its top activation, null while it is idle. Every test and change of whether the actor stands
// in the run queue or a thread runs it goes through its state word, and every answer to a call takes the
// message's reply by an atomic swap (`ReplyTaken`), so that both hold on any number of threads, as tokio's
// task state and its `oneshot` hold on its threads (not checked at source), while the build runs every actor
// on one thread. The record and the state are the first block of
// the actor's heap, and every block the actor's code allocates is a block of that heap, which `Run` has the
// allocation entry serve while the actor's activation runs; a message is a block of the heap of the actor it
// goes to, and what crosses into it a copy there (U12). After a crash the first block stays in the first
// page of the heap it was made in, and every other block of the actor is a block of a new heap (U21); an
// actor that ends frees its heap whole, that first page with it (`EndActor`). An
// actor stands in the run queue where an actor stands after it or it is the last, as an intrusive list
// tells its members by their links. A message is a block the emitted code makes: the message after it in
// its list, the table of its call site, the function that runs it, the one that copies it into another
// heap (U21) and the one that drops it unrun (U37), its reply, null after `send`, its chain ID, 16 bytes, its
// deadline, the largest `long` for none (`Never`), the deadline of the `within` block that runs while the
// message runs, 0 for none (U38), and its arguments; the function that runs it frees it.
//
// A message runs in an activation, which lives in the header of a stack of the actor's own that the
// thread switches to and back from (design record, section 6, "Own stack"), below. A call that waits
// inside a message parks its activation on its stack, the thread switching back to the scheduler, until
// the call's reply is set (section 6, "Every call looks synchronous"), as Rust's stackful coroutines
// suspend (corosensei's `Yielder::suspend`). Every call carries a chain ID, and an actor whose activation
// waits in a chain takes the waiting calls of that chain on a side list as they are queued, each run in
// an activation of its own above the waiting one, on a pooled stack, while every other message, a `send`
// of the chain among them, waits in its inbox (section 6, "Deadlocks", layer 1; U17; the owner,
// 2026-11-15, #519, comment 6892835500, Q6, "Own pooled stack"). An activation below another resumes
// once the ones above it end, as a nested call returns before its caller goes on.
//
// The scheduler's entries that change its records, inboxes, run queue and replies, `ActorNew`, `Enqueue`,
// `MessageHeapNew`, `MessageHeapFree`, `ReplyWaiter`, `ReplyTaken`, `Replied` and `Wait`, and the copy of a
// crossing, from `CopyUse` to
// `CopyLeft`, the emitted functions that fill the copies among it, with `CopyOpen` and `CopyAbort`, raise the
// target's count of the entries under way at their start and lower it at each exit (`sys.Entered`,
// `sys.Left`), and each side of a switch to an actor's stack saves the count and puts it back when the thread
// comes back to it, the scheduler's clearing it on its way to the actor (`Run`, `Wait`, `sys.Inside`), so
// that a stack fault inside the scheduler or the allocator ends the process and one in an actor's code is
// that actor's crash (design record, section 6, "End the process"; O11).

// The first and the last actor of the run queue, plain `static mut`s with no lock and no atomic operation, which hold
// while one thread runs every program (U35): a waker on another thread would change them (`Wake`, `Queue`) while
// the thread that runs the actors takes the first off (`RunOne`).
static mut byte* runFirst = null
static mut byte* runLast = null

// The table of the slots of the actors of the process (design record, section 6, the owner, 2026-11-16, #519,
// comment 6919351399, "Erlang: id + generation"): an actor's reference is the index of its slot and its number,
// and a slot holds the state of the actor in it and that actor's number, 16 bytes, or, while it is free, 0 for
// the number and the index of the free slot freed before it, so that a reference whose actor ended, its slot
// cleared or given to an actor spawned since, whose number is larger, finds no actor (`Lookup`), as Erlang's
// table of processes finds none for a pid whose serial no longer matches. The slots stand in pages that never
// move, 64 slots the first and each page twice the one before, as tokio's slab grows, a slot's page found from
// the bit length of its index plus 64, each made at the first slot it gives, in the own heap of the thread whose
// take makes it (`AllocateOwn`), so that a lookup never meets a page moved under it. The directory, `slotPages`,
// holds a page for every bit length an index can have, 64 words: the first take makes it under the lock of the
// table, in the own heap of that take's thread, the main thread's while one thread runs every program (U35), and
// nothing moves, grows or frees it while the process runs, so that a lookup reads it with no lock and finds it
// made, since an index it reads was given by a take after the directory was stored, and reaches the lookup
// through a reference that take made or through `slotsUsed` read under the lock (inferred).
// A free slot is taken again first, the one freed last first, as slotmap's free list takes them; `slotsUsed`
// counts the slots ever taken (section 6, assumed there). A take and a free of a slot, and the read of
// `slotsUsed`, hold the lock of the table (`Lock`), but for the end of the process, the one free made once only
// the main thread is left (U35), which clears each slot with plain stores and no lock (`EndActors`); a lookup holds
// none: it reads the slot's number, its
// state and its number again, each load with acquire, against the take's and the free's stores with release,
// which write the number after the state and the state after the number, so that a lookup that finds the
// same number twice found the state that number names, as a seqlock's reader checks its sequence again.
static mut byte* slotPages = null
static mut long slotsUsed = 0
static mut long slotFree = -1

// The header of the activation whose message runs on the thread, null while the top-level code runs,
// the scheduler's loop in its wait among it.
thread static mut byte* running = null

// The actor whose crash the thread takes, which it holds (`Run`, `Crashed`), null where it takes none, so that
// the end of a supervisor that crash reaches acts on it under that hold, with no second one (`EndChildren`).
thread static mut byte* holding = null

// The heap of an actor `spawn` makes, whose first block holds the actor's record and a state of `size`
// bytes behind it (design record, section 3), made just before the first argument of `spawn` that crosses
// into it (U12), or after the last where none crosses (section 6, T87 3). A heap the system refuses ends the
// process as a refused allocation does.
pub byte* ActorHeapNew(long size) {
    byte* heap = std.HeapNew(144 + size)
    if heap == null {
        AllocationFailed(144 + size)
    }

    return heap
}

// The first of the heaps of their own that messages are built in by the actors of the thread
// (`MessageHeapNew`), and of the heaps of the `spawn`s whose arguments they evaluate (`SpawnHeapNew`), each
// one's first block the heap after it, the one before it and the actor whose code builds the message or
// spawns, so that a crash of that actor frees them (`Crashed`).
thread static mut byte* messageHeaps = null

// The heap of its own a message is built in where any of its arguments or the bound of its call's clause
// can wait, or that bound can raise with no call in it (`Emitter.EmitMessage`), which
// the copy at its queueing leaves and the emitted code then frees, as Erlang copies a message into the
// receiver's heap at its send (U12, U21): a crash or an end of the actor it goes to, during that wait, frees
// no block of it. Built inside a message, it is listed with the running actor (`Listed`), so that the crash
// of the builder frees it, as a crashed Erlang process takes the message it was building with its heap. A
// heap the system refuses ends the process as a refused allocation does.
pub byte* MessageHeapNew() {
    byte* heap = std.HeapNew(24)
    if heap == null {
        AllocationFailed(24)
    }

    Listed(heap)
    return heap
}

// The heap of a `spawn` whose first argument that crosses into it (U12), or one after it, can raise or wait
// (`Emitter.EmitActorSpawn`), made as `ActorHeapNew` makes it, just before that first crossing argument, and
// listed with the running actor as a message's heap of its own is (`Listed`), so that a raise of such an
// argument, which crashes the actor whose code spawns, frees it with the copies made into it (`Fall`), as
// Rust drops the parts of a value it was building (design record, section 6, T82 1, T87 3); `SpawnHeapTaken` takes it off the list
// once the last argument is evaluated, and a case propagated out of a later argument frees it as a
// message's (`MessageHeapFree`).
pub byte* SpawnHeapNew(long size) {
    byte* heap = ActorHeapNew(size)
    Listed(heap)
    return heap
}

// The heap of a `spawn` (`SpawnHeapNew`) taken off the list of the heaps being built once its last argument
// is evaluated, before `ActorNew` writes the actor's record over the words that list it.
pub void SpawnHeapTaken(byte* heap) {
    Unlisted(heap)
}

// The heap `heap`, of a message's own or of a `spawn`, listed with the running actor in the first 24 bytes of
// its first block, the heap after it, the one before it and that actor; the top-level code's is not, its
// raise ending the process. The change of the list raises the count of the entries under way, as `Enqueue`
// does, so that a stack fault between its writes ends the process and is no crash whose walk meets the list
// half changed (O11).
void Listed(byte* heap) {
    sys.Entered()
    raw {
        byte* first = std.HeapFirst(heap)
        *Ptr<byte*>(first) = null
        *Ptr<byte*>(first + 8) = null
        *Ptr<byte*>(first + 16) = null
        if running != null {
            *Ptr<byte*>(first) = messageHeaps
            if messageHeaps != null {
                *Ptr<byte*>(std.HeapFirst(messageHeaps) + 8) = heap
            }

            *Ptr<byte*>(first + 16) = *Ptr<byte*>(running + 320)
            messageHeaps = heap
        }
    }

    sys.Left()
}

// The heap of its own of a message, or of a `spawn` (`SpawnHeapNew`), taken off the list of the heaps being
// built where it stands there, and freed whole: after the copy at the message's queueing, at the end of a
// region a case propagated out of an argument after it left, and at the crash of its builder; nothing for
// null, the heap of a message that was queued or of a `spawn` whose actor took it.
pub void MessageHeapFree(byte* heap) {
    if heap == null {
        return
    }

    Unlisted(heap)
    std.HeapFree(heap)
}

// The heap `heap` taken off the list of the heaps being built where it stands there (`Listed`). The change of
// the list raises the count of the entries under way, as in `Listed`.
void Unlisted(byte* heap) {
    sys.Entered()
    raw {
        byte* first = std.HeapFirst(heap)
        if *Ptr<byte*>(first + 16) != null {
            byte* after = *Ptr<byte*>(first)
            byte* before = *Ptr<byte*>(first + 8)
            if before == null {
                messageHeaps = after
            } else {
                *Ptr<byte*>(std.HeapFirst(before)) = after
            }

            if after != null {
                *Ptr<byte*>(std.HeapFirst(after) + 8) = before
            }
        }
    }

    sys.Left()
}

// The heap of a `spawn` whose arguments did not all cross, by a case propagated out of a later one,
// freed whole once the region let go of the copies made into it; nothing where the actor took it
// (`ActorNew`), which gives null.
pub void HeapLeft(byte* heap) {
    if heap != null {
        std.HeapFree(heap)
    }
}

// The record of a new actor in the first block of its heap `heap`, numbered after the last one spawned,
// its inbox empty, outside the run queue and idle, with room for a state of `size` bytes behind it, and
// the bytes of its stack, `stack`, the size its clause wrote or 2 MiB (U1): the address of that room,
// the state, whose record holds the actor's reference, the index of the slot of the table it takes and its
// number (U2). The count of the actors spawned, which is the number of the last one, is raised by one atomic
// add (`Shared`, at 24), as Rust's `Arc` raises its count (not checked at source); a spawn whose add found the largest `long` ends the
// process as a refused allocation does, as a string past the largest `int` does (T15), so that no two actors of
// the process have one number (design record, section 6, assumed there). No message reaches the actor while `spawn` constructs it, as
// section 6 has it (assumed there): its reference is the spawner's once `spawn` returns, and a default of
// its body reads neither `this` nor its methods (K7). The record names the name of the actor's type,
// `name`, for the log line of its crash (U24), the block `side` of its restart (U22), and its supervisor,
// the actor whose code spawns it (`Supervisor`), and says that its constructor runs, to `ActorBuilt`, in
// its life and in its state word (BUILDING).
pub byte* ActorNew(byte* heap, long size, long stack, byte* side, byte* name) {
    mut long number = 0
    raw {
        number = AtomicLong.FromPtr(Ptr<long>(Shared() + 24)).FetchAdd(1, MemoryOrder.Relaxed)
        if number == 9223372036854775807 {
            AllocationFailed(144 + size)
        }

        number = number + 1
    }

    sys.Entered()
    mut byte* state = std.HeapFirst(heap)
    raw {
        state = state + 144
        *Ptr<byte*>(state - 144) = state - 128
        *Ptr<byte*>(state - 136) = state - 128
        *Ptr<byte*>(state - 128) = null
        *Ptr<byte*>(state - 120) = state - 104
        *Ptr<byte*>(state - 112) = state - 104
        *Ptr<byte*>(state - 104) = null
        *Ptr<byte*>(state - 96) = name
        *Ptr<int>(state - 88) = 4
        *Ptr<int>(state - 84) = 8
        *Ptr<byte*>(state - 80) = side
        *Ptr<byte*>(state - 72) = Supervisor()
        *Ptr<byte*>(state - 64) = heap
        *Ptr<long>(state - 48) = stack
        *Ptr<long>(state - 40) = number
        *Ptr<long>(state - 56) = SlotTake(state, number)
        *Ptr<byte*>(state - 32) = null
        *Ptr<byte*>(state - 24) = null
        *Ptr<byte*>(state - 16) = null
        *Ptr<byte*>(state - 8) = null
    }

    sys.Left()
    return state
}

// The slot of the table whose index is `index`, in its page, which is made at the first slot it gives (`slotPages`),
// under the lock of the table, and stored with release, so that a lookup that loads it with acquire finds it made.
byte* SlotMade(long index) {
    raw {
        mut long page = 0
        mut long first = 64
        while index + 64 >= first * 2 {
            first = first * 2
            page = page + 1
        }

        AtomicPtr<byte> at = AtomicPtr<byte>.FromPtr(Ptr<byte*>(slotPages + page * 8))
        if at.Load(MemoryOrder.Relaxed) == null {
            at.Store(AllocateOwn(first * 16), MemoryOrder.Release)
        }

        return at.Load(MemoryOrder.Relaxed) + (index + 64 - first) * 16
    }
}

// The slot of the table whose index is `index`, whose page a take made before the index left it.
byte* Slot(long index) {
    raw {
        mut long page = 0
        mut long first = 64
        while index + 64 >= first * 2 {
            first = first * 2
            page = page + 1
        }

        return AtomicPtr<byte>.FromPtr(Ptr<byte*>(slotPages + page * 8)).Load(MemoryOrder.Acquire) + (index + 64 - first) * 16
    }
}

// The lock of the table of the slots.
int* SlotLock() {
    raw {
        return Ptr<int>(Shared() + 8)
    }
}

// The count of the slots ever taken, 0 where no actor was spawned, read under the lock of the table.
long SlotsUsed() {
    mut long used = 0
    raw {
        if sharedWords != null {
            Lock(SlotLock())
            used = slotsUsed
            Unlock(SlotLock())
        }
    }

    return used
}

// A slot of the table taken for the actor whose state is `state` and whose number is `number`: the free slot
// freed last, else the one after the slots ever taken; its index.
long SlotTake(byte* state, long number) {
    Lock(SlotLock())
    raw {
        if slotPages == null {
            slotPages = AllocateOwn(512)
            mut long i = 0
            while i < 64 {
                *Ptr<byte*>(slotPages + i * 8) = null
                i = i + 1
            }
        }

        mut long index = slotFree
        if index >= 0 {
            slotFree = *Ptr<long>(SlotMade(index))
        } else {
            index = slotsUsed
            slotsUsed = slotsUsed + 1
        }

        byte* slot = SlotMade(index)
        AtomicPtr<byte>.FromPtr(Ptr<byte*>(slot)).Store(state, MemoryOrder.Release)
        AtomicLong.FromPtr(Ptr<long>(slot + 8)).Store(number, MemoryOrder.Release)
        Unlock(SlotLock())
        return index
    }
}

// The slot of the index `index` freed at its actor's end: no number, which no reference holds, and the free
// slot freed before it named, so that a spawn takes it first.
void SlotFree(long index) {
    Lock(SlotLock())
    raw {
        byte* slot = Slot(index)
        AtomicLong.FromPtr(Ptr<long>(slot + 8)).Store(0, MemoryOrder.Release)
        AtomicLong.FromPtr(Ptr<long>(slot)).Store(slotFree, MemoryOrder.Release)
        slotFree = index
    }

    Unlock(SlotLock())
}

// The state of the actor in the slot of the index `index`, null where the slot is free (`Lookup`).
byte* SlotState(long index) {
    raw {
        long number = AtomicLong.FromPtr(Ptr<long>(Slot(index) + 8)).Load(MemoryOrder.Acquire)
        if number == 0 {
            return null
        }

        return Lookup(index, number)
    }
}

// The state of the actor whose reference is the slot of the index `index` and the number `number`, null where
// that actor ended, its slot then holding no number or a later actor's (design record, section 6), with no lock:
// the number, the state and the number again, each loaded with acquire against the release stores of `SlotTake`
// and `SlotFree`.
byte* Lookup(long index, long number) {
    raw {
        byte* slot = Slot(index)
        AtomicLong held = AtomicLong.FromPtr(Ptr<long>(slot + 8))
        if held.Load(MemoryOrder.Acquire) != number {
            return null
        }

        byte* state = AtomicPtr<byte>.FromPtr(Ptr<byte*>(slot)).Load(MemoryOrder.Acquire)
        if held.Load(MemoryOrder.Acquire) != number {
            return null
        }

        return state
    }
}

// The end of the constructor of the actor whose state is `state` at its `spawn`, which the emitted `spawn`
// calls once the constructor returned: its record no longer says that its constructor runs (U3, U25), and its
// state word clears BUILDING, by a compare-exchange made again on what it found where a take changed the word
// meanwhile, and where a take found it building and dropped its entry (NOTIFIED) while none stands, the actor
// is marked QUEUED and put at the end of the run queue, so that a message that reached it while its constructor
// ran starts once its `spawn` returned, and none before (U3, U17), as Elixir's `init/1` takes none.
pub void ActorBuilt(byte* state) {
    raw {
        if *Ptr<int>(state - 88) == 4 {
            *Ptr<int>(state - 88) = 0
        }
    }

    AtomicInt word = StateWord(state)
    mut int seen = 0
    raw {
        seen = word.Load(MemoryOrder.Acquire)
    }

    mut bool queue = false
    mut bool stored = false
    while !stored {
        queue = (seen & 6) == 4
        mut int wanted = seen & ~12
        if queue {
            wanted = wanted | 2
        }

        int found = Exchanged(word, seen, wanted)
        stored = found == seen
        seen = found
    }

    if queue {
        Queue(state)
    }
}

// The cell of a `per node` actor type (U51, U52), a global of the emitted program, 24 bytes: a lock word, then
// the index of the slot of its one actor and that actor's number, which a reference holds (`Lookup`), 0 before
// its first start, the slot stored before the number and the number with release (`PerStarted`). The actor of
// the cell `cell` where one stands and has not ended, its state found by its slot and its number as a reference finds
// its actor, null where it ended and `EndActor` freed its slot (`Lookup`), with no lock, as Rust's `OnceLock`
// reads its value after one acquire load of its state (not checked at source); else the cell's lock taken and
// the cell read again under it, and null, the lock still held, where no actor stands there either, so that the
// code that called starts one (the emitter's `PerStart`) and `PerStarted` lets go of the lock once that actor
// stands in the cell: the lock is held around the check, the making of the actor's heap and record and the
// publication, never around the constructor or a wait (assumed: T27 to T33 of issue 519, comment 6983903100, the
// defaults said back, a lock of the type on the threads of section 6 "around the check and the publication alone",
// the making of the heap and the record under it a reading of the build beyond those words). A number of 0 is no actor's,
// and is read before the slot, since `Slot` reads the directory of the table, which no take made before the first
// actor's.
pub byte* PerFind(byte* cell) {
    raw {
        long number = AtomicLong.FromPtr(Ptr<long>(cell + 16)).Load(MemoryOrder.Acquire)
        if number != 0 {
            byte* state = Lookup(AtomicLong.FromPtr(Ptr<long>(cell + 8)).Load(MemoryOrder.Relaxed), number)
            if state != null {
                return state
            }
        }
    }

    raw {
        Lock(Ptr<int>(cell))
        long again = AtomicLong.FromPtr(Ptr<long>(cell + 16)).Load(MemoryOrder.Acquire)
        if again != 0 {
            byte* state = Lookup(AtomicLong.FromPtr(Ptr<long>(cell + 8)).Load(MemoryOrder.Relaxed), again)
            if state != null {
                Unlock(Ptr<int>(cell))
                return state
            }
        }
    }

    return null
}

// The actor whose state is `state`, which `ActorNew` made for the cell `cell`, whose lock `PerFind` holds, the
// one actor of its type from now on (U52): the pause of its block of a restart and the count of the ring of its
// knobs set to 0, since that block and those knobs are the type's own, globals of the emitted program, which the
// actor that ended past its limit left as they were, so that a fresh one pauses first as `Pause` does after no
// crash and counts its window from its start (assumed: a reading of the build, proposed with this record and not
// put to the owner); a pause writes the other words of the block before it reads them, and the ring's first,
// with a count of 0, names a slot the ring has (`Limited`). Then its slot and its number stored in the cell, the number with
// release, and the lock let go of, before its constructor runs, so that a message that reaches it while it builds
// waits for it (BUILDING, `Claimed`, `ActorBuilt`).
pub void PerStarted(byte* cell, byte* state) {
    raw {
        byte* side = *Ptr<byte*>(state - 80)
        if side != null {
            *Ptr<long>(side + 16) = 0
            byte* knobs = *Ptr<byte*>(side + 48)
            if knobs != null {
                *Ptr<long>(knobs + 48) = 0
            }
        }

        AtomicLong.FromPtr(Ptr<long>(cell + 8)).Store(*Ptr<long>(state - 56), MemoryOrder.Relaxed)
        AtomicLong.FromPtr(Ptr<long>(cell + 16)).Store(*Ptr<long>(state - 40), MemoryOrder.Release)
        Unlock(Ptr<int>(cell))
    }
}

// The end of the constructor of the one actor of a `per node` type, whose state is `state`, at its start (U52,
// U53): its supervisor, the code that sent its first message while its constructor ran, so that a crash of that
// code ended it, half built, becomes the top-level code, the root, so that it outlives that code and ends with
// the process; then the end of its constructor as at a `spawn` (`ActorBuilt`). The store is a plain one, which
// holds while one thread runs every program (U35), as `EndChildren` reads the supervisor by a plain load.
pub void PerBuilt(byte* state) {
    raw {
        *Ptr<byte*>(state - 72) = null
    }

    ActorBuilt(state)
}

// The actor whose constructor runs in the code of the thread, which the emitted `spawn` sets around the
// constructor it runs, so that an actor that constructor spawns is a child of the actor it constructs (U13):
// the top-level code's here, and each activation's at 424 of its header.
thread static mut byte* rootBuilding = null

// The supervisor of an actor the running code spawns (U13, U22): the actor whose constructor that code runs,
// else the actor whose activation runs, null for the top-level code.
byte* Supervisor() {
    raw {
        mut byte* building = rootBuilding
        if running != null {
            building = *Ptr<byte*>(running + 424)
            if building == null {
                building = *Ptr<byte*>(running + 320)
            }
        }

        return building
    }
}

// The actor whose state is `state` the one whose constructor the running code runs from now on, null for
// none: the one it was before.
pub byte* Building(byte* state) {
    raw {
        mut byte* before = rootBuilding
        if running == null {
            rootBuilding = state
        } else {
            before = *Ptr<byte*>(running + 424)
            *Ptr<byte*>(running + 424) = state
        }

        return before
    }
}

// The heap of the actor whose reference is the slot `index` and the number `number`, which a message to it is
// made in (U12); where that actor ended, the heap the running code allocates in, which the message and its
// copies then stay in at the raise of `actor-gone` at its queueing (`Enqueue`), to the crash that raise is or
// to the end of the process.
pub byte* ActorHeap(long index, long number) {
    byte* state = Lookup(index, number)
    if state == null {
        return std.HeapCurrent()
    }

    mut byte* heap = null
    raw {
        heap = *Ptr<byte*>(state - 64)
    }

    return heap
}

// The end of every actor at the end of the program (U13): the record of each actor that ended while it stood
// in the run queue (`EndActor`), and each actor of the table, its heap freed whole, as section 3 frees the
// heap of an actor that ends (design record, section 6, assumed: the end of the root actor read as the end
// of every actor it stops), the messages queued in it with it, as tokio drops its tasks when its runtime
// shuts down, and, after a crash, the first heap, which holds its record, its slot cleared; no message runs
// after it, and no restart whose pause runs (U22).
void EndActors() {
    raw {
        mut byte* queued = runFirst
        while queued != null {
            byte* after = *Ptr<byte*>(queued - 16)
            if *Ptr<int>(queued - 88) == 3 {
                std.HeapFree(queued - 192)
            }

            queued = after
        }

        mut long index = 0
        long used = SlotsUsed()
        while index < used {
            byte* slot = Slot(index)
            if *Ptr<long>(slot + 8) != 0 {
                byte* at = *Ptr<byte*>(slot)
                byte* heap = *Ptr<byte*>(at - 64)
                if heap != at - 192 {
                    std.HeapFree(heap)
                }

                std.HeapFree(at - 192)
                *Ptr<long>(slot + 8) = 0
            }

            index = index + 1
        }

        runFirst = null
        runLast = null
        if sharedWords != null {
            Lock(PauseLock())
            paused = null
            Unlock(PauseLock())
        }
    }
}

// The text of the actor whose number is `number`, of the type named `name` (U2): the name, `#` and the
// number, `Counter#1`, which reads no record, so that a reference whose actor ended has it too.
pub string ActorText(string name, long number) {
    return "{name}#{number}"
}

// A message to the actor whose reference is the slot `index` and the number `number`, stamped with its chain
// ID: the running message's,
// or a new one where the top-level code makes it, so that each waiting call and each `send` of the
// top-level code starts a chain of its own (section 6, "Deadlocks", layer 1, assumed there). The message goes
// on the actor's queue of many senders by one atomic swap (`Pushed`), which reads nothing of the actor but the
// queue, and the thread that holds the actor moves it at its next take to the side list of the activation that
// waits in its chain, or to the end of the inbox (`Moved`); the actor is woken (`Wake`) where it waits neither
// for its restart (U22) nor for the decision of its block (U34), which the sender reads from the actor's life by
// a plain load after the push, a word the thread that holds the actor writes with plain stores (`Fall`,
// `Restart`, `Decided`): the read holds while one thread runs every program (U35), and on more than one it would
// race those stores, as `Post`'s read of its supervisor's life would. A call or a
// `send` to an actor that ended raises `actor-gone` at its line `line` of the file `file`, the message and what
// crossed into it staying in the heap the running code allocates in (`ActorHeap`) (U6, U20; design record,
// section 6, the owner, 2026-11-16, #519, comments 6919351399 and 6923513534), before its deadline is
// compared, so that a call past its deadline to an actor that ended raises `actor-gone` (U43; assumed: T14 of
// comment 6972461413). The message is stamped with its deadline too (U37): a `send` carries
// the running message's, none in the top-level code (section 6, comment 6880404917, Q13; assumed: T9 of
// comment 6967625156); a call the smaller of that deadline and its own bound, the deadline of the `within`
// block that runs, else `bound` from now where `bounded`, the bound of the call's clause or of its method's
// declaration (U39; the block over the call's clause over the declaration's, assumed in section 6), else the
// default bound from now, 5 seconds (U36, U38, U44; assumed: T8 of that comment), which
// its reply holds too, for its wait (`Wait`). A message whose deadline passed at its queueing is dropped
// unqueued (`Discard`), and a call raises `call-timeout` at its line, the crash of the actor that makes it,
// while a `send` raises nothing (U37, U45; assumed: T1 of comment 6967147952, T10 of comment 6967625156), as
// tonic's client fails a call whose deadline passed and a send on tokio's channel reads no deadline (neither
// checked at source). A call's reply holds its place too, the file `file` at 48 and 56 and the line `line` at 64,
// which the top-level code's wait that finds nothing left to run names where an actor's start keeps the call out
// (`Kept`; U18, U22, U52; section 6, the owner, 2026-11-21, #599, comment 7060156109, Q6 1), and the actor it reaches
// at 72, the edge of its wait, whose place the wait line reads too (`Looped`, `LoopText`; U60, U63).
pub void Enqueue(long index, long number, byte* message, bool bounded, long bound, string file, int line) {
    sys.Entered()
    long fileCount = long(file.Bytes.Count)
    byte* state = Lookup(index, number)
    if state == null {
        sys.Left()
        Raise("actor-gone", file, line)
    }

    raw {
        *Ptr<byte*>(message) = null
        long now = PauseClock()
        mut long deadline = Never()
        mut long block = rootBlock
        if running == null {
            NewChain(message + 24)
        } else {
            *Ptr<long>(message + 24) = *Ptr<long>(running + 344)
            *Ptr<long>(message + 32) = *Ptr<long>(running + 352)
            byte* from = *Ptr<byte*>(running + 328)
            deadline = *Ptr<long>(from + 40)
            block = *Ptr<long>(from + 48)
        }

        byte* reply = *Ptr<byte*>(message + 16)
        if reply != null {
            mut long own = block
            if own == 0 && bounded {
                own = Due(now, bound)
            } else if own == 0 {
                own = Due(now, sys.DefaultBound())
            }

            if own < deadline {
                deadline = own
            }

            *Ptr<long>(reply + 16) = deadline
            *Ptr<byte*>(reply + 24) = null
            *Ptr<byte*>(reply + 32) = null
            *Ptr<byte*>(reply + 48) = file.Pointer
            *Ptr<long>(reply + 56) = fileCount
            *Ptr<long>(reply + 64) = long(line)
            *Ptr<byte*>(reply + 72) = state
        }

        *Ptr<long>(message + 40) = deadline
        *Ptr<long>(message + 48) = 0
        if deadline <= now {
            Discard(message)
            sys.Left()
            if reply != null {
                Raise("call-timeout", file, line)
            }

            return
        }

        Pushed(state - 144, message)
        int life = *Ptr<int>(state - 88)
        if life != 1 && life != 5 {
            Wake(state)
        }
    }

    sys.Left()
}

// The message `message` at the end of the queue of many senders at `queue`, whose end the senders swap at 0, whose
// next message its holder takes at 8 and whose stub, a message's link alone, stands at 16, as an intrusive queue
// of many producers and one consumer, whose producers append by one atomic swap of its tail, pushes (not checked
// at source): the message's link cleared, one atomic swap of the
// end with acquire and release, which orders the senders, then the link of the message the swap gave stored
// with release, which the holder loads with acquire (`Popped`), so that a sender never waits for another.
void Pushed(byte* queue, byte* message) {
    raw {
        AtomicPtr<byte>.FromPtr(Ptr<byte*>(message)).Store(null, MemoryOrder.Relaxed)
        byte* before = AtomicPtr<byte>.FromPtr(Ptr<byte*>(queue)).Swap(message, MemoryOrder.AcqRel)
        AtomicPtr<byte>.FromPtr(Ptr<byte*>(before)).Store(message, MemoryOrder.Release)
    }
}

// The first message of the queue of many senders at `queue` taken off it by its one holder, as that intrusive queue
// of many producers and one consumer (`Pushed`) pops one (not checked at source): null where the queue holds none, and where a sender's swap stands before its link, which that sender's
// wake follows (`Enqueue`, `Post`), so that the holder takes the message at its next turn. A message taken has its link
// cleared, which the push that followed the message stored before the holder could take it, a sender's or the
// stub's (`Pushed`).
byte* Popped(byte* queue) {
    raw {
        byte* stub = queue + 16
        mut byte* first = *Ptr<byte*>(queue + 8)
        mut byte* next = AtomicPtr<byte>.FromPtr(Ptr<byte*>(first)).Load(MemoryOrder.Acquire)
        if first == stub {
            if next == null {
                return null
            }

            *Ptr<byte*>(queue + 8) = next
            first = next
            next = AtomicPtr<byte>.FromPtr(Ptr<byte*>(first)).Load(MemoryOrder.Acquire)
        }

        if next == null {
            if first != AtomicPtr<byte>.FromPtr(Ptr<byte*>(queue)).Load(MemoryOrder.Acquire) {
                return null
            }

            Pushed(queue, stub)
            next = AtomicPtr<byte>.FromPtr(Ptr<byte*>(first)).Load(MemoryOrder.Acquire)
            if next == null {
                return null
            }
        }

        *Ptr<byte*>(queue + 8) = next
        *Ptr<byte*>(first) = null
        return first
    }
}

// The messages the senders put on the queues of the actor whose state is `state` moved by the thread that holds
// it into its own lists, at a take of the actor and before its holder reads them (`RunOne`, `Ready`, `Fall`,
// `EndActor`): each block at the front of the inbox, after the blocks there, in the order of its posts, so that
// it runs after the current message and before the queued ones (U28, U34); then each message, a call that waits
// of the chain the actor's top activation waits in to the end of that activation's side list (layer 1; section
// 6, "One-shot reply slot"), except while its constructor runs at a restart (`Rebuilding`), when such a call
// waits in the inbox for that constructor's end, so that a constructor that waits for it is `deadlock`, which the
// top-level code's wait names at that call's line (`Kept`; U22; section 6, the owner, 2026-11-20, #599, comment
// 7051501153, "Option 1", and 2026-11-21, comment 7060156109, Q6 1), and every
// other message to the end of the inbox, as tokio's `mpsc` channel pushes a
// value at the tail of its list (not checked at source), so that an inbox keeps the order in which its messages were sent (U5, U15).
// `Fall` and `EndActor` move them on a supervisor that the thread does not hold too, where a child's crash
// escalates through it or ends it as the crash's taker (`Fell`): that holds while one thread runs every program
// (U35), and on more than one it would make the thread a second consumer of a queue of one consumer.
void Moved(byte* state) {
    raw {
        mut byte* block = Popped(state - 120)
        while block != null {
            mut byte* before = null
            mut byte* at = *Ptr<byte*>(state - 32)
            while at != null && *Ptr<byte*>(at + 8) == BlockTable() {
                before = at
                at = *Ptr<byte*>(at)
            }

            *Ptr<byte*>(block) = at
            if before == null {
                *Ptr<byte*>(state - 32) = block
            } else {
                *Ptr<byte*>(before) = block
            }

            if at == null {
                *Ptr<byte*>(state - 24) = block
            }

            block = Popped(state - 120)
        }

        bool rebuilding = Rebuilding(state)
        mut byte* message = Popped(state - 144)
        while message != null {
            byte* top = *Ptr<byte*>(state - 8)
            if top != null && !rebuilding && CallOf(message, *Ptr<long>(top + 344), *Ptr<long>(top + 352)) {
                Append(top + 376, message)
            } else {
                Append(state - 32, message)
            }

            message = Popped(state - 144)
        }
    }
}

// Whether the message `message` is a call that waits, its reply named, made in the chain whose ID is `high` and `low`, the words a
// message carries at 24 and 32 and an activation at 344 and 352 (`Enqueue`; section 6, "Deadlocks", layer 1): the test by which a
// waiting chain lets a call in (`Moved`) and by which a start keeps one out (`Kept`).
bool CallOf(byte* message, long high, long low) {
    raw {
        return *Ptr<byte*>(message + 16) != null && *Ptr<long>(message + 24) == high && *Ptr<long>(message + 32) == low
    }
}

// `message` at the end of the list whose first message stands at `list` and whose last at `list + 8`.
void Append(byte* list, byte* message) {
    raw {
        byte* last = *Ptr<byte*>(list + 8)
        if last == null {
            *Ptr<byte*>(list) = message
        } else {
            *Ptr<byte*>(last) = message
        }

        *Ptr<byte*>(list + 8) = message
    }
}

// The first message of the list at `list`, which holds one, taken off it.
byte* Taken(byte* list) {
    raw {
        byte* message = *Ptr<byte*>(list)
        byte* next = *Ptr<byte*>(message)
        *Ptr<byte*>(list) = next
        if next == null {
            *Ptr<byte*>(list + 8) = null
        }

        return message
    }
}

// The state word of the actor whose state is `state`, the `int` at 84 in front of its state, beside its
// life, set once by a plain store before the actor can be reached (`ActorNew`) and read and changed only
// through this view after that (R19), as tokio keeps a task's state in one atomic word whose
// `RUNNING` and `NOTIFIED` bits it sets and clears by compare-exchange (not checked at source); each of its
// bits set or clear: 1 RUNNING, a thread holds the actor, from its take off the run queue (`Claimed`) or its
// restart (`Restart`) to the end of that hold (`LetGo`); 2 QUEUED, an entry of the actor stands in the run
// queue; 4 NOTIFIED, a take found the actor held and dropped its entry, so that whoever holds it queues it
// again as it lets go of it (`LetGo`, `ActorBuilt`); 8 BUILDING, its constructor runs at its `spawn` (U3); 16
// ENDING, the actor ends after its current message, which the end of its supervisor sets by one atomic `or` and
// no thread clears (`EndChildren`, `Ending`); 32 REBUILDING, its constructor runs at a restart (U22), set by one
// atomic `or` where the thread that holds it starts the restart (`Restart`) and cleared by one atomic `and` at the
// end of that constructor (`Rebuilt`), so that a call of its chain waits in its inbox (`Moved`, `Rebuilding`). With
// none of the first four set the actor is idle.
AtomicInt StateWord(byte* state) {
    raw {
        return AtomicInt.FromPtr(Ptr<int>(state - 84))
    }
}

// Whether the end of the actor's supervisor set its ENDING bit (`EndChildren`), loaded with acquire.
bool Ending(byte* state) {
    mut int word = 0
    raw {
        word = StateWord(state).Load(MemoryOrder.Acquire)
    }

    return (word & 16) != 0
}

// Whether the constructor of the actor runs at its restart, its REBUILDING bit set (`Restart`, `Rebuilt`), loaded with
// acquire.
bool Rebuilding(byte* state) {
    mut int word = 0
    raw {
        word = StateWord(state).Load(MemoryOrder.Acquire)
    }

    return (word & 32) != 0
}

// Whether the constructor of the actor runs at its `spawn` or at the first start of a `per node` actor, its BUILDING bit set
// (`ActorNew`, `ActorBuilt`), loaded with acquire.
bool Constructing(byte* state) {
    mut int word = 0
    raw {
        word = StateWord(state).Load(MemoryOrder.Acquire)
    }

    return (word & 8) != 0
}

// The value the compare-exchange of the state word `word` from `seen` to `wanted` found there, `seen` where
// it stored, as Rust's `compare_exchange` gives `Ok` or `Err` of it: acquire and release where it stored,
// acquire where it did not, so that a loop over it reads what it found and decides again.
int Exchanged(AtomicInt word, int seen, int wanted) {
    mut int found = seen
    raw {
        match word.CompareExchange(seen, wanted, MemoryOrder.AcqRel, MemoryOrder.Acquire) {
            int stored => found = stored
            NotExchanged<int> missed => found = missed.Value
        }
    }

    return found
}

// The wake of the actor whose state is `state`, whose inbox, side list or awaited reply its waker
// changed first: one atomic `or` marks it QUEUED, and the waker that found the mark clear puts it at the end
// of the run queue, whether a thread holds it or not, so that an entry of it stands there once; a take that
// finds it held drops that entry and leaves it to whoever holds it (`Claimed`), which queues it again at the
// end as it lets go of it (`LetGo`, `ActorBuilt`).
void Wake(byte* state) {
    mut int before = 0
    raw {
        before = StateWord(state).FetchOr(2, MemoryOrder.AcqRel)
    }

    if (before & 2) == 0 {
        Queue(state)
    }
}

// Whether the thread that took the entry of the actor whose state is `state` off the run queue holds the
// actor now: QUEUED cleared, and RUNNING set where neither RUNNING nor BUILDING is, else NOTIFIED set, so that
// whoever holds it queues it again as it lets go of it (`LetGo`, `ActorBuilt`), as tokio's worker leaves a
// notified task that runs to the worker that polls it (not checked at source): no two threads run one actor,
// and no message starts while its constructor runs (U17). A compare-exchange that finds the word changed is
// made again on what it found.
bool Claimed(byte* state) {
    AtomicInt word = StateWord(state)
    mut int seen = 0
    raw {
        seen = word.Load(MemoryOrder.Acquire)
    }

    mut bool held = false
    mut bool stored = false
    while !stored {
        held = (seen & 9) != 0
        mut int wanted = (seen & ~2) | 1
        if held {
            wanted = (seen & ~2) | 4
        }

        int found = Exchanged(word, seen, wanted)
        stored = found == seen
        seen = found
    }

    return !held
}

// The end of the hold of the thread on the actor whose state is `state`, after the switch back from its
// activation or a take that found nothing it can go on with: RUNNING and NOTIFIED cleared, and where no entry
// of it stands in the run queue while a take dropped one during the hold (NOTIFIED) or it can go on, `ready`,
// which the caller read first (`Ready`), the actor marked QUEUED and put at the end of the queue, as tokio's
// worker schedules a task again whose word it finds notified after its poll (not checked at source). A
// compare-exchange that finds the word changed, by a wake or a take after `ready` was read, is made again on
// what it found, so that no wake is lost. An actor that ended while the thread held it (`EndActor`) is never
// queued again, and has the first page of its heap, which holds its record, freed here where no entry of it
// stands in the run queue, NOTIFIED set or not, and else when the scheduler takes it off (`RunOne`) (design
// record, section 6, assumed there); an ended actor let go of with NOTIFIED set is a shape the build's one
// thread does not reach, since a take sets NOTIFIED only on an actor that another thread holds or whose
// constructor runs, which no thread holds.
void LetGo(byte* state, bool ready) {
    AtomicInt word = StateWord(state)
    mut int seen = 0
    mut bool ended = false
    raw {
        ended = *Ptr<int>(state - 88) == 3
        seen = word.Load(MemoryOrder.Acquire)
    }

    mut bool queue = false
    mut bool stored = false
    while !stored {
        queue = (seen & 2) == 0 && ((seen & 4) != 0 || ready) && !ended
        mut int wanted = seen & ~5
        if queue {
            wanted = wanted | 2
        }

        int found = Exchanged(word, seen, wanted)
        stored = found == seen
        seen = found
    }

    if queue {
        Queue(state)
    } else if ended && (seen & 2) == 0 {
        raw {
            std.HeapFree(state - 192)
        }
    }
}

// The actor whose state is `state` at the end of the run queue, which its state word marks QUEUED.
void Queue(byte* state) {
    raw {
        *Ptr<byte*>(state - 16) = null
        if runLast == null {
            runFirst = state
        } else {
            *Ptr<byte*>(runLast - 16) = state
        }

        runLast = state
    }
}

// Whether the actor whose state is `state` has a message that can go on, once the messages on its queues were
// moved (`Moved`): a call of its chain on the side list of its top activation, that activation's reply set or
// its deadline passed at the scheduler's turn (`Waited`), or, where it is idle, a message in its inbox.
bool Ready(byte* state) {
    Moved(state)
    raw {
        byte* top = *Ptr<byte*>(state - 8)
        if top == null {
            return *Ptr<byte*>(state - 32) != null
        }

        byte* reply = *Ptr<byte*>(top + 360)
        return *Ptr<byte*>(top + 376) != null || (reply != null && (ReplyState(reply) != 0 || Waited(reply)))
    }
}

// The waiter of the reply `reply` of a call that waits, the activation whose message runs, null for the
// top-level code, which the emitted call stores before `Enqueue` queues its message, so that whoever answers
// the call, on any thread, finds it there and no answer comes before it (section 6, "One-shot reply slot").
pub void ReplyWaiter(byte* reply) {
    sys.Entered()
    raw {
        *Ptr<byte*>(reply + 8) = running
    }

    sys.Left()
}

// The reply of the message `message`, taken off it by an atomic swap that leaves null there, so that of those
// that can answer it exactly one owns it: the message's function once its method returned (the emitted code),
// the crash or the end of the actor that was to answer (`Fall`, `EndActor`),
// and the crash of the actor that waits on it, which unhooks it (`Fall`; U20); null where one of
// them took it, and for a `send`, which has none. The owner reads the reply's waiter first, then stores the
// reply's word with release (`Replied`, `Signal`), then wakes the waiter's actor, as tokio's `oneshot` decides
// between its two ends by one atomic word, `VALUE_SENT` against `CLOSED` (not checked at source).
pub byte* ReplyTaken(byte* message) {
    sys.Entered()
    mut byte* reply = null
    raw {
        reply = AtomicPtr<byte>.FromPtr(Ptr<byte*>(message + 16)).Swap(null, MemoryOrder.AcqRel)
    }

    sys.Left()
    return reply
}

// The word of the reply `reply`, loaded with acquire, so that what its owner stored before the word's release
// store, the result among it, is the waiter's to read: 0 while no answer stands, 1 once the result stands, 2
// where its callee crashed (U20), 3 where the actor that was to answer ended, 4 where its message was dropped
// at its deadline (U37).
int ReplyState(byte* reply) {
    raw {
        return AtomicInt.FromPtr(Ptr<int>(reply)).Load(MemoryOrder.Acquire)
    }
}

// The reply `reply` of a call set, once the message's function took it (`ReplyTaken`) and stored its result
// beside it, and the actor of the activation that waits on it woken where that activation is its top, as
// tokio's `oneshot::Sender::send` stores the value and wakes the receiver's task; it never switches. The waiter
// and its actor are read before the word's release store, since after it the waiter may go on and its frame
// and its stack be gone, while the actor's record stays, which holds on the build's one thread alone, where
// nothing runs between the store and the wake: on threads of their own the waiter's message could end its
// actor and free that record before the wake reads it (compiler/README.md). An activation below another goes on once the ones
// above it end (`Run`); the top-level code reads the word in its loop (`Wait`). A reply is that word, an `int`,
// the activation that waits on it, null for the top-level code (`ReplyWaiter`), and the result.
pub void Replied(byte* reply) {
    sys.Entered()
    raw {
        byte* waiter = *Ptr<byte*>(reply + 8)
        mut byte* state = null
        if waiter != null {
            state = *Ptr<byte*>(waiter + 320)
        }

        AtomicInt.FromPtr(Ptr<int>(reply)).Store(1, MemoryOrder.Release)
        if state != null && *Ptr<byte*>(state - 8) == waiter {
            Wake(state)
        }
    }

    sys.Left()
}

// The reply `reply` of a call, which its owner took (`ReplyTaken`), set to `kind` with no result: 2 where its
// callee crashed (U20), 3 where the actor that was to answer ended, 4 where its message was dropped at its
// deadline (`Dropped`; U37); the waiter and its actor read before the
// word's release store, and the clock at the set stored in the reply at 40 before it too, the time that `Wait`
// holds a crash or an end to the call's deadline by, not the time the waiter reads the word (U43; assumed: T7 of
// comment 6967625156, "the earlier of the two"); and the activation that waits on it woken as `Replied` wakes it, where its actor
// neither waits for its restart or for the decision of its block nor ended, as C#'s `TaskCompletionSource` is
// set faulted; its reads of that actor's record after the store hold on the build's one thread alone, as
// `Replied`'s do.
void Signal(byte* reply, int kind) {
    raw {
        byte* waiter = *Ptr<byte*>(reply + 8)
        mut byte* state = null
        if waiter != null {
            state = *Ptr<byte*>(waiter + 320)
        }

        *Ptr<long>(reply + 40) = PauseClock()
        AtomicInt.FromPtr(Ptr<int>(reply)).Store(kind, MemoryOrder.Release)
        if state != null {
            int life = *Ptr<int>(state - 88)
            if life != 1 && life != 3 && life != 5 && *Ptr<byte*>(state - 8) == waiter {
                Wake(state)
            }
        }
    }
}

// ---- the deadlines of the calls (U36 to U45) ----------------------------------------------------------------

// The deadline of none, the largest `long`, which no clock reaches (U37).
long Never() => 9223372036854775807

// The deadline `bound` nanoseconds after `now`, the bound rounded up to whole milliseconds (U36): `now` for a
// bound of zero or less, a deadline that has passed, which no bound of a `within` gives it, since the emitted code refuses
// one where it is read (U40, U41), and none where it
// would pass the largest time the clock holds, as Tokio's `timeout` falls back on a far future where its sum
// overflows (not checked at source) (U40; assumed in section 6, proposed with the record and not put to the owner).
long Due(long now, long bound) {
    if bound <= 0 {
        return now
    }

    mut long milliseconds = bound / 1000000
    if bound % 1000000 != 0 {
        milliseconds = milliseconds + 1
    }

    if milliseconds > (Never() - now) / 1000000 {
        return Never()
    }

    return now + milliseconds * 1000000
}

// The earlier of two deadlines.
long Earliest(long a, long b) {
    if a < b {
        return a
    }

    return b
}

// The clock the scheduler read at its turn, which the deadlines of the activations that wait and of the
// messages it takes are held to (`Waited`, `RunOne`), and the deadline of the `within` block of the top-level
// code that runs, 0 for none (U38); a running message's stands in the message (`Enqueue`).
thread static mut long tick = 0
thread static mut long rootBlock = 0

// The entry of a `within` block (U38): its deadline, `bound` from now (`Due`), the smaller of it and the
// deadline of the block it stands in (U38, assumed), set for the running code, the top-level code's or the
// running message's, and the deadline it replaces, which its exit puts back (`BlockExit`); the emitted code calls
// it at the block's entry, and `BlockExit` at every way out of the block that goes on running. A deadline of 0
// is no block (`rootBlock`, `Enqueue`); `Due` gives 0 only where the clock reads 0, which `PauseClock` gives only
// where the clock cannot be read, and a `within` entered then reads as no block, its calls taking their own bounds.
pub long BlockEnter(long bound) {
    mut long before = 0
    raw {
        if running == null {
            before = rootBlock
        } else {
            before = *Ptr<long>(*Ptr<byte*>(running + 328) + 48)
        }

        mut long deadline = Due(PauseClock(), bound)
        if before != 0 && before < deadline {
            deadline = before
        }

        BlockExit(deadline)
    }

    return before
}

// The exit of a `within` block (U38): the deadline its entry replaced, `before`, set again for the running
// code; its entry sets its own deadline through it too.
pub void BlockExit(long before) {
    raw {
        if running == null {
            rootBlock = before
        } else {
            *Ptr<long>(*Ptr<byte*>(running + 328) + 48) = before
        }
    }
}

// The timers of the thread: the replies of the activations that wait inside a message with a deadline, from the
// earliest deadline on, each reply holding the one before it at 24 and the one after it at 32, as Tokio's timer
// keeps its entries in lists through the entries themselves (not checked at source); a reply leaves them where
// its wait ends and at the fall of its actor (`Fall`), so that none outlives the frame that holds it. An
// insertion walks from the latest deadline back, which a deadline of 5 seconds from now passes at once.
thread static mut byte* timers = null
thread static mut byte* timersLast = null

// The reply `reply` of an activation that parks among the timers, after every reply whose deadline is not later,
// where it has a deadline.
void TimerAdd(byte* reply) {
    raw {
        long deadline = *Ptr<long>(reply + 16)
        if deadline == Never() {
            return
        }

        mut byte* before = timersLast
        while before != null && *Ptr<long>(before + 16) > deadline {
            before = *Ptr<byte*>(before + 24)
        }

        mut byte* after = timers
        if before != null {
            after = *Ptr<byte*>(before + 32)
            *Ptr<byte*>(before + 32) = reply
        } else {
            timers = reply
        }

        *Ptr<byte*>(reply + 24) = before
        *Ptr<byte*>(reply + 32) = after
        if after != null {
            *Ptr<byte*>(after + 24) = reply
        } else {
            timersLast = reply
        }
    }
}

// The reply `reply` taken off the timers, where it stands among them.
void TimerRemove(byte* reply) {
    raw {
        byte* before = *Ptr<byte*>(reply + 24)
        byte* after = *Ptr<byte*>(reply + 32)
        if before == null && timers != reply {
            return
        }

        if before != null {
            *Ptr<byte*>(before + 32) = after
        } else {
            timers = after
        }

        if after != null {
            *Ptr<byte*>(after + 24) = before
        } else {
            timersLast = before
        }

        *Ptr<byte*>(reply + 24) = null
        *Ptr<byte*>(reply + 32) = null
    }
}

// The first deadline of the timers, none where none stands.
long Next() {
    raw {
        if timers == null {
            return Never()
        }

        return *Ptr<long>(timers + 16)
    }
}

// The timers whose deadline passed at `now` fired, the earliest first: each reply taken off them, and the
// actor of the activation that waits on it woken, which goes on where that activation is its top (`Waited`);
// the timer owns no reply and sets no word, so that the activation's own fall unhooks its reply (`Fall`).
void Fire(long now) {
    raw {
        while timers != null && *Ptr<long>(timers + 16) <= now {
            byte* reply = timers
            TimerRemove(reply)
            Wake(*Ptr<byte*>(*Ptr<byte*>(reply + 8) + 320))
        }
    }
}

// Whether the deadline of the reply `reply` passed at the scheduler's turn.
bool Waited(byte* reply) {
    raw {
        return *Ptr<long>(reply + 16) <= tick
    }
}

// The message `message`, whose deadline passed before its callee took it, dropped (U37; assumed: T3 of comment
// 6967147952): its reply, where it has one, taken off it by the swap the callee takes it by (`ReplyTaken`) and
// set `dropped`, which wakes its waiter, whose wait raises `call-timeout` (`Wait`), and the message let go of.
void Dropped(byte* message) {
    raw {
        byte* reply = ReplyTaken(message)
        if reply != null {
            Signal(reply, 4)
        }

        Discard(message)
    }
}

// The message `message` let go of unrun, by the third function of its call site's table, which lets go of its
// arguments and frees its block.
void Discard(byte* message) {
    raw {
        extern "C" (byte*) => void drop = *Ptr<extern "C" (byte*) => void>(*Ptr<byte*>(message + 8) + 16)
        drop(message)
    }
}

// A call that waits for its result (U4), its reply `reply`, at the line `line` of the file `file`. In the
// top-level code the messages of the run queue run one at a time, in its order, until the reply is set,
// as tokio's `block_on` runs the tasks of its queue in a loop until its future is ready, on the main
// thread's stack, which never parks (section 6, "Deadlocks", assumed there); where the run queue is empty
// and the reply is not set, nothing is left that could set it, and the process ends with
// `error: deadlock at <file>:<n>` at that call's line and the exit code 1 (section 6, the owner,
// 2026-11-15, #519, comment 6892812780, Q4, "deadlock at top-level wait"), or at the place of a call that an
// actor's start keeps out where one waits, the call that closes the loop (`Kept`; U22, U52; section 6, the owner,
// 2026-11-21, #599, comment 7060156109, Q6 1), and where more than one waits at the first's in source order, each
// further place on a line of its own under it, at most 10 (`DeadlockKept`, `KeptLines`; section 6, the owner, 2026-11-21,
// #599, comment 7067131310, several 2, and comment 7067139953, the form 1; comment 7067639209, the order 1, the same
// place 1 and the cap 1), the chain of the top-level code's call read before the wait, since a
// crash of its callee moves the message into a new heap. The reply's waiter stands in it
// since before the call's `Enqueue` (`ReplyWaiter`), and its word is loaded with acquire (`ReplyState`), so
// that the answer is seen with the result stored before it. Inside a message the
// activation parks: the thread switches from its stack to the scheduler's, as corosensei's
// `Yielder::suspend` switches back to the stack that resumed it, and comes back here once the scheduler
// resumes it with the reply set, to the heap it allocated in before, which is another actor's where it
// waits inside the constructor of an actor it spawns (`Run` serves the heap of the actor it resumes); its
// header names the message `message` it waits on, so that its actor's crash unhooks the reply from it (U20).
// While a restart's pause runs, the top-level code restarts each actor whose pause ended, before the
// messages of the run queue, and where that queue is empty it sleeps until the first pause ends, and raises
// no `deadlock` (U23). The top-level code runs the block of a child it spawned, which a crash of that child
// left pending, before each of these (`RootBlock`; U33). A reply set `callee crashed` raises `callee-crashed`
// at the call's line, the crash of the waiting actor in its turn (U20), and one set `gone` raises
// `actor-gone` there, a call that waits on an actor that ended (U20).
//
// A call waits until its deadline, which its reply holds (`Enqueue`; U36, U37). The top-level code reads the
// clock at each turn of its loop and leaves the loop where the deadline passed with no answer set, the
// scheduler's tick the clock it read, and before anything else in the turn it fires the timers of the
// activations that wait (`Fire`); with nothing left to run it raises `deadlock` all the same, with timers that
// stand (U18, U42; assumed: T6 of comment 6967625156), and a restart's pause sleeps to the first of its end, the
// first timer and the deadline. Inside a message the activation's reply joins the thread's timers while it
// parks (`TimerAdd`), and the activation goes on where its deadline passed at the scheduler's turn (`Waited`),
// its reply leaving the timers at every way out (`TimerRemove`). The reply's word is read once after the wait, and
// a result set before that read is the call's result (U36), the header then naming no reply. A call that left
// its wait with no answer raises `call-timeout` at its line, the crash of the waiting actor in its turn, whose
// fall unhooks the reply, which the header still names (`Fall`; U20); so does a reply set `dropped` (`Dropped`),
// and a reply set `callee crashed` or `gone` at a time, which `Signal` stored in it, at or past the call's own
// deadline, whenever the waiter reads it (U43; assumed: T7 of comment 6967625156), as tonic reports a call's own
// deadline (not checked at source).
//
// Before the activation of a message parks, its wait follows the wait line from its call (`Looped`; U60, U61), its bound
// aside, and where the line leads back to the waiting actor, the wait closes a loop: the waiter raises `deadlock` at its
// call's line, with the loop's waits below its error line (`LoopText`, `Deadlocked`; U62, U63), the header still naming the
// reply and the message, so that its fall unhooks the reply as at any raise after a wait (section 6, "Deadlocks", layer 3; the
// owner, 2026-11-20, #519, comment 7051071630, T63 to T69). The top-level code's waits follow no line (T64), U18 ending what layer
// 3 does not see (T70), with the loop that one walk from its call finds below its error line (`Stuck`; the owner, 2026-11-21,
// #519, comment 7060155980, T85 2).
pub void Wait(byte* reply, byte* message, string file, int line) {
    int kind = Answer(reply, message, file, line)
    raw {
        if kind == 0 || kind == 4 || (kind != 1 && *Ptr<long>(reply + 16) <= *Ptr<long>(reply + 40)) {
            Raise("call-timeout", file, line)
        }

        if kind == 2 {
            Raise("callee-crashed", file, line)
        }

        if kind == 3 {
            Raise("actor-gone", file, line)
        }
    }
}

// The wait of `Wait` for the reply `reply` of the message `message`, at the line `line` of the file `file`, to an
// answer or to its deadline, and the reply's word read once after it, which it gives, the header then naming no
// reply where one stands; the raises are the caller's, a call's (`Wait`) and an `attempt`'s (`Attempted`).
int Answer(byte* reply, byte* message, string file, int line) {
    sys.Entered()
    raw {
        if running == null {
            long high = *Ptr<long>(message + 24)
            long low = *Ptr<long>(message + 32)
            if !RootWait(reply) {
                mut found = List<long>()
                Kept(high, low, mut found)
                if found.Count > 0 {
                    DeadlockKept(found)
                }

                Stuck(reply, file, line)
            }
        } else {
            byte* header = running
            *Ptr<byte*>(header + 360) = reply
            *Ptr<byte*>(header + 432) = message
            long hops = Looped(header, reply)
            if hops > 0 {
                sys.Left()
                Deadlocked(LoopText(*Ptr<byte*>(header + 320), hops), file, line)
            }

            TimerAdd(reply)
            byte* heap = std.HeapUse(null)
            while ReplyState(reply) == 0 && !Waited(reply) {
                long entries = sys.Inside(0)
                sys.Switch(header, threadSide)
                sys.Inside(entries)
            }

            TimerRemove(reply)
            std.HeapUse(heap)
        }

        sys.Left()
        int kind = ReplyState(reply)
        if kind != 0 && running != null {
            *Ptr<byte*>(running + 360) = null
            *Ptr<byte*>(running + 432) = null
        }

        return kind
    }
}

// The loop of the top-level code's wait for the reply `reply` (`Answer`; U18, U23, U33, U36): at each turn the clock read, the timers
// fired, then the block of a child the top-level code spawned, a restart whose pause ended, the sleep to the first pause's end, the
// first timer or the deadline, or the run queue's first actor, as long as the reply is not set and its deadline has not passed; true
// where one of those ends the loop, false where none of them is left, so that nothing could set the reply, where `Answer` raises
// `deadlock` at the call's line and the test runner fails the test at its own (`RunTests`; Y5), or each at the lines of the calls
// an actor's start keeps out where such calls close the loop (`Kept`). An actor that sleeps is something left: with nothing else
// to run, the loop sleeps to the first timer or the deadline (`Sleeping`; S28); so is a registration of the poller, a call on a
// socket that waits, with no deadline among them, and the loop then waits in the poller (`polled`, `IdleWait`; issue 658).
bool RootWait(byte* reply) {
    raw {
        return RootLoop(reply, *Ptr<long>(reply + 16))
    }
}

// The loop of `RootWait` for the reply `reply` to the deadline `deadline`, or, where `reply` is null, the top-level code's sleep to
// that deadline (`Slept`; S28), which runs what the loop runs and, with nothing left, sleeps to the first timer or the deadline.
bool RootLoop(byte* reply, long deadline) {
    raw {
        while reply == null || ReplyState(reply) == 0 {
            long now = PauseClock()
            if deadline <= now {
                return true
            }

            tick = now
            Fire(now)
            byte* block = RootTaken()
            long due = PauseDue()
            if block != null {
                RootBlock(block)
            } else if due != Never() {
                byte* ended = PauseEnded(now)
                if ended != null {
                    // the restart runs the constructor through `Start` and `Run`, which clears the count of the
                    // entries under way on its way to the actor's stack, so that the count raised here is not the
                    // constructor's (O11)
                    Restart(ended)
                } else if runFirst == null {
                    IdleWait(Earliest(Earliest(due, deadline), Next()) - now)
                } else {
                    RunTurn()
                }
            } else if runFirst != null {
                RunTurn()
            } else if reply == null || Sleeping() || polled > 0 {
                IdleWait(Earliest(deadline, Next()) - now)
            } else {
                return false
            }
        }
    }

    return true
}

// Whether an actor's activation sleeps among the timers (`Slept`), its waiter naming no message, where one that waits for a call
// names the message it waits on (`Answer`).
bool Sleeping() {
    raw {
        mut byte* at = timers
        while at != null {
            if *Ptr<byte*>(*Ptr<byte*>(at + 8) + 432) == null {
                return true
            }

            at = *Ptr<byte*>(at + 32)
        }
    }

    return false
}

// S28: `Environment.Sleep(time)`, `nanoseconds` slept from now, none for zero or less (section 12, the owner, 2026-11-25, issue 627,
// comment 7158347789, Q3, as Go's `time.Sleep`). Inside a message the activation parks, as a call that waits parks it (`Answer`; Q2, U4),
// on a block of its heap shaped as a reply that is never set: its word 0, its waiter, its deadline, and its links among the
// timers, which the scheduler's turn fires (`Fire`, `Waited`); its header names the block and no message, so that its actor's fall
// takes it off the timers and waits for no answer (`Fall`), and the calls of its chain are let in above it while it parks, as above
// an activation that waits (`Moved`; U17). The top-level code runs what its wait on a call runs to the deadline, and sleeps where
// nothing is left (`RootLoop`), since every actor runs on its thread (U35), as tokio's `sleep` in `block_on` lets the runtime's
// other tasks run; a deadline past the clock's range is the largest one, a sleep with no end.
pub void Slept(long nanoseconds) {
    if nanoseconds <= 0 {
        return
    }

    long now = PauseClock()
    mut long deadline = Never()
    if nanoseconds < Never() - now {
        deadline = now + nanoseconds
    }

    Park(deadline)
}

// The wait of `Slept` to the clock's `deadline`, and of `Advance` to the turn after it (Y10): inside a message the activation parked
// among the timers, after every one whose deadline is not later (`TimerAdd`), which the scheduler's turn fires in that order (`Fire`);
// the top-level code's run of what its wait runs to the deadline (`RootLoop`).
void Park(long deadline) {
    sys.Entered()
    raw {
        if running == null {
            RootLoop(null, deadline)
            sys.Left()
            return
        }

        byte* sleep = Allocate(48)
        byte* header = running
        *Ptr<long>(sleep) = 0
        *Ptr<byte*>(sleep + 8) = header
        *Ptr<long>(sleep + 16) = deadline
        *Ptr<byte*>(sleep + 24) = null
        *Ptr<byte*>(sleep + 32) = null
        *Ptr<long>(sleep + 40) = 0
        *Ptr<byte*>(header + 360) = sleep
        *Ptr<byte*>(header + 432) = null
        TimerAdd(sleep)
        byte* heap = std.HeapUse(null)
        while !Waited(sleep) {
            long entries = sys.Inside(0)
            sys.Switch(header, threadSide)
            sys.Inside(entries)
        }

        TimerRemove(sleep)
        std.HeapUse(heap)
        *Ptr<byte*>(header + 360) = null
        std.Free(sleep, 48)
    }

    sys.Left()
}

// The registrations of the poller whose wait has not ended (`SocketWaited`): where it is above 0, the scheduler that has nothing
// to run waits in the poller (`IdleWait`), and the top-level code's wait that finds nothing else left waits there too and
// raises no `deadlock` (`RootLoop`; section 6: a deadlock where no timer is pending and the poller holds no registration, as Go's
// `checkdead` counts its netpoller). The count and the waits are the thread's, and the poller is the process's: this build runs
// every actor on its one thread (U35, `compiler/README.md`), where the two are the same; a second thread that waited in the
// poller would take the events of the first one's registrations.
thread static mut long polled = 0

// The events that `sys.PollWait` gives, at most 64 of two words, a descriptor and the events it gives, taken of the thread's own
// heap at the first wait (`Polled`).
thread static mut byte* readied = null

// The waits of each descriptor that waits in the poller (`SocketWaited`), the first wait of `fd` at `waits + fd * 8` and each
// wait's block linking the next at 48: the one registration of a descriptor carries the union of its waits' events and the
// descriptor as its data, and an event wakes the waits whose direction it gives, as Tokio's `ScheduledIo` keeps the readers and the
// writers of one registration apart, so that a read and a write of one socket, or two `Accept`s of one listener, each wait for
// their own (issue 658). Mapped at the first wait and grown to the descriptor's number (`WaitsOf`), with `waitSlots` slots.
thread static mut byte* waits = null

// The slots of `waits`.
thread static mut long waitSlots = 0

// The slot of the first wait of `fd` (`waits`), the table grown to hold it, to twice its slots or to the descriptor's number and
// 1024 more, whichever is more, the slots it held copied; null where the system refuses the memory.
byte* WaitsOf(int fd) {
    raw {
        if long(fd) >= waitSlots {
            mut long slots = waitSlots * 2
            if slots < long(fd) + 1024 {
                slots = long(fd) + 1024
            }

            byte* grown = sys.Memory(slots * 8)
            if grown == null {
                return null
            }

            mut long i = 0
            while i < waitSlots {
                *Ptr<byte*>(grown + i * 8) = *Ptr<byte*>(waits + i * 8)
                i = i + 1
            }

            if waits != null {
                sys.Release(waits, waitSlots * 8)
            }

            waits = grown
            waitSlots = slots
        }

        return waits + long(fd) * 8
    }
}

// The union of the events of the waits from `first` on, linked at 48 (`waits`).
int Interest(byte* first) {
    mut long events = 0
    raw {
        mut byte* at = first
        while at != null {
            events = events | *Ptr<long>(at + 56)
            at = *Ptr<byte*>(at + 48)
        }
    }

    return int(events)
}

// The wait `block` ended with `result`, 1 where its event came, the failure of the poller below 0: its word set, with the word of the
// block that holds it where it is one of the waits of `Drive` (`ManyWaited`, -3 at 40) and no other wait of it set that word first,
// and the actor of the activation that waits on it woken, which goes on where that activation is its top (`SocketWaited`); the
// top-level code's block names no waiter, and its wait reads the word (`RootLoop`).
void Ended(byte* block, long result) {
    raw {
        *Ptr<long>(block) = result
        if *Ptr<long>(block + 40) == -3 {
            byte* holder = *Ptr<byte*>(block + 16)
            if *Ptr<long>(holder) == 0 {
                *Ptr<long>(holder) = result
            }
        }

        byte* header = *Ptr<byte*>(block + 8)
        if header != null {
            Wake(*Ptr<byte*>(header + 320))
        }
    }
}

// Each wait of `fd`, whose first stands in `slot`, ended with the poller's `failure` (`Ended`), the list emptied and the
// registration taken out, so that no wait is held to its bound, or without end, by a poller that cannot give its event.
void Fail(int fd, byte* slot, long failure) {
    raw {
        mut byte* at = *Ptr<byte*>(slot)
        *Ptr<byte*>(slot) = null
        while at != null {
            byte* next = *Ptr<byte*>(at + 48)
            Ended(at, failure)
            at = next
        }

        sys.PollRemove(fd)
    }
}

// The registration of `fd` set to the waits whose first stands in `slot`: taken out of the poller where none is left, armed again
// for the union of their events otherwise (`EPOLLONESHOT` disarms it at each event), and where the poller refuses that, each wait
// given the failure (`Fail`).
void Rearm(int fd, byte* slot) {
    raw {
        byte* first = *Ptr<byte*>(slot)
        if first == null {
            sys.PollRemove(fd)
            return
        }

        long added = sys.PollAdd(fd, Interest(first), sys.EpollDataAt())
        if added < 0 {
            Fail(fd, slot, added)
        }
    }
}

// The wait `block` of `fd` taken out of its descriptor's list (`waits`), where its bound passed or its actor fell, and the
// registration set to the waits left (`Rearm`); a block no longer in the list, which an event or a failure took out before, takes
// nothing out.
void Unwait(int fd, byte* block) {
    raw {
        byte* slot = WaitsOf(fd)
        if slot == null {
            return
        }

        mut byte* at = slot
        while *Ptr<byte*>(at) != null && *Ptr<byte*>(at) != block {
            at = *Ptr<byte*>(at) + 48
        }

        if *Ptr<byte*>(at) == block {
            *Ptr<byte*>(at) = *Ptr<byte*>(block + 48)
        }

        Rearm(fd, slot)
    }
}

// The wait of a call on the socket `fd` that would block, which the runtime's code for the system calls (`sys.Waiter`; section 6,
// "the poller"; section 12, 2026-11-13, "Same bounds, poller timer"; issue 658): the descriptor registered in the poller for
// `events` (`sys.PollAdd`), with a block shaped as a reply that is never answered: its word, which the poller sets to 1 at the
// descriptor's event (`Polled`), its waiter, the deadline `nanoseconds` from now on the runtime's clock, which `advance` moves
// (Y10, section 11), its links among the timers, at 40 the descriptor plus one, so that a fall unhooks the wait (`Fall`), at 48 the
// next wait of the same descriptor and at 56 its `events` (`waits`), the registration then armed for the union of the descriptor's
// waits. Inside a message the activation parks as a sleep does (`Park`), among the timers, until the event or the deadline,
// and the calls of its chain are let in above it; the top-level code runs what its wait on a call runs, to the event or the
// deadline (`RootLoop`). 1 where the descriptor is ready, 0 where the deadline passed first, the wait then taken out of its list
// and the registration set to the waits left (`Unwait`); the failure of the poller, below 0. A descriptor ready when the deadline
// passed is the call's (`sys.ReadyNow`), as Tokio's `timeout` polls its future before its timer, so that a scheduler that read
// no event for it since gives no `TimedOut` for a call the descriptor would answer.
extern "C" int SocketWaited(int fd, int events, long nanoseconds) {
    long now = PauseClock()
    mut long deadline = Never()
    if nanoseconds < Never() - now {
        deadline = now + nanoseconds
    }

    mut int result = 0
    sys.Entered()
    raw {
        byte* slot = WaitsOf(fd)
        if slot == null {
            sys.Left()
            return -12
        }

        byte* block = Allocate(64)
        byte* header = running
        *Ptr<long>(block) = 0
        *Ptr<byte*>(block + 8) = header
        *Ptr<long>(block + 16) = deadline
        *Ptr<byte*>(block + 24) = null
        *Ptr<byte*>(block + 32) = null
        *Ptr<long>(block + 40) = long(fd) + 1
        *Ptr<byte*>(block + 48) = *Ptr<byte*>(slot)
        *Ptr<long>(block + 56) = long(events)
        *Ptr<byte*>(slot) = block
        long added = sys.PollAdd(fd, Interest(block), sys.EpollDataAt())
        if added < 0 {
            *Ptr<byte*>(slot) = *Ptr<byte*>(block + 48)
            std.Free(block, 64)
            sys.Left()
            return int(added)
        }

        polled = polled + 1
        if header == null {
            RootLoop(block, deadline)
        } else {
            *Ptr<byte*>(header + 360) = block
            *Ptr<byte*>(header + 432) = null
            TimerAdd(block)
            byte* heap = std.HeapUse(null)
            while *Ptr<long>(block) == 0 && !Waited(block) {
                long entries = sys.Inside(0)
                sys.Switch(header, threadSide)
                sys.Inside(entries)
            }

            TimerRemove(block)
            std.HeapUse(heap)
            *Ptr<byte*>(header + 360) = null
        }

        polled = polled - 1
        long word = *Ptr<long>(block)
        if word == 1 {
            result = 1
        } else if word < 0 {
            result = int(word)
        } else {
            if sys.ReadyNow(fd, events) != 0 {
                result = 1
            }

            Unwait(fd, block)
        }

        std.Free(block, 64)
    }

    sys.Left()
    return result
}

// The wait of `Drive` for its child and its output in the poller (`sys.ManyWaiter`; issue 661, Q14 (a); S10, S18): each of the
// `count` `struct pollfd`s of `poll` at `pollfds` whose descriptor is not below 0 registered for its events with a block shaped as
// `SocketWaited`'s, whose word its event sets (`Polled`), at 16 the block `holder` that holds the waits, at 24 the descriptor and at
// 40 the mark -3, so that its event sets the word of `holder` too (`Ended`); `holder` shaped as `SocketWaited`'s block, with the
// deadline `nanoseconds` from now, at 40 the mark -2, so that a fall takes each wait out (`Fall`, `ManyUnwait`), at 48 the waits, at
// 56 their count and at 64 `dropped`, the room of the call of `Drive`, which a fall gives back (`sys.ChildDropped`). Inside a
// message the activation parks until the first event or the deadline, as a call on a socket does, and the
// calls of its chain are let in above it (U17); the top-level code runs what its wait on a call runs (`RootLoop`). Each wait whose
// event came gives back at 6 of its `struct pollfd` the events it waited for, and the others are taken out of their lists
// (`Unwait`), so that no thread of the pool waits for a child, as Go's `os/exec` reads a child's pipes through its netpoller: the count
// of descriptors whose event came, 0 where the deadline passed first, or the failure of the poller, each wait registered before it
// taken out again where the poller refuses one.
extern "C" int ManyWaited(int* pollfds, int count, long nanoseconds, byte* dropped) {
    long now = PauseClock()
    mut long deadline = Never()
    if nanoseconds < Never() - now {
        deadline = now + nanoseconds
    }

    mut long result = 0
    sys.Entered()
    raw {
        byte* header = running
        byte* holder = Allocate(72)
        byte* each = Allocate(long(count) * 64)
        *Ptr<long>(holder) = 0
        *Ptr<byte*>(holder + 8) = header
        *Ptr<long>(holder + 16) = deadline
        *Ptr<byte*>(holder + 24) = null
        *Ptr<byte*>(holder + 32) = null
        *Ptr<long>(holder + 40) = -2
        *Ptr<byte*>(holder + 48) = each
        *Ptr<long>(holder + 56) = long(count)
        *Ptr<byte*>(holder + 64) = dropped
        byte* at = Ptr<byte>(pollfds)
        mut long i = 0
        while i < long(count) {
            byte* block = each + i * 64
            int fd = *Ptr<int>(at + i * 8)
            *Ptr<long>(block) = 0
            *Ptr<long>(block + 40) = 0
            *Ptr<short>(at + i * 8 + 6) = 0
            if fd >= 0 && result == 0 {
                byte* slot = WaitsOf(fd)
                if slot == null {
                    result = -12
                } else {
                    *Ptr<byte*>(block + 8) = header
                    *Ptr<byte*>(block + 16) = holder
                    *Ptr<long>(block + 24) = long(fd)
                    *Ptr<byte*>(block + 32) = null
                    *Ptr<long>(block + 40) = -3
                    *Ptr<byte*>(block + 48) = *Ptr<byte*>(slot)
                    *Ptr<long>(block + 56) = long(*Ptr<short>(at + i * 8 + 4))
                    *Ptr<byte*>(slot) = block
                    long added = sys.PollAdd(fd, Interest(block), sys.EpollDataAt())
                    if added < 0 {
                        *Ptr<byte*>(slot) = *Ptr<byte*>(block + 48)
                        *Ptr<long>(block + 40) = 0
                        result = added
                    }
                }
            }

            i = i + 1
        }

        if result == 0 {
            polled = polled + 1
            if header == null {
                RootLoop(holder, deadline)
            } else {
                *Ptr<byte*>(header + 360) = holder
                *Ptr<byte*>(header + 432) = null
                TimerAdd(holder)
                byte* heap = std.HeapUse(null)
                while *Ptr<long>(holder) == 0 && !Waited(holder) {
                    long entries = sys.Inside(0)
                    sys.Switch(header, threadSide)
                    sys.Inside(entries)
                }

                TimerRemove(holder)
                std.HeapUse(heap)
                *Ptr<byte*>(header + 360) = null
            }

            polled = polled - 1
        }

        i = 0
        while i < long(count) {
            byte* block = each + i * 64
            long word = *Ptr<long>(block)
            if *Ptr<long>(block + 40) == -3 && word == 1 {
                *Ptr<short>(at + i * 8 + 6) = *Ptr<short>(at + i * 8 + 4)
                if result >= 0 {
                    result = result + 1
                }
            } else if *Ptr<long>(block + 40) == -3 && word < 0 {
                result = word
            }

            i = i + 1
        }

        ManyUnwait(holder)
        std.Free(each, long(count) * 64)
        std.Free(holder, 72)
    }

    sys.Left()
    return int(result)
}

// Each wait of `Drive` that `holder` holds (`ManyWaited`) whose event did not come taken out of its descriptor's list and the
// registration set to the waits left (`Unwait`), where the bound passed, an event of another descriptor came, the poller refused a
// registration or the actor fell.
void ManyUnwait(byte* holder) {
    raw {
        byte* each = *Ptr<byte*>(holder + 48)
        mut long i = 0
        while i < *Ptr<long>(holder + 56) {
            byte* block = each + i * 64
            if *Ptr<long>(block + 40) == -3 && *Ptr<long>(block) == 0 {
                Unwait(int(*Ptr<long>(block + 24)), block)
            }

            i = i + 1
        }
    }
}

// The jobs handed to the pool of threads for blocking calls whose end the scheduler has not taken (`BlockingWaited`, `PoolDrain`),
// those whose actor fell among them.
thread static mut long handed = 0

// The `eventfd` of the pool of threads for blocking calls, which the scheduler registers in the poller (`BlockingWaited`), -1
// before the first job.
thread static mut long poolEvent = -1

// The waits on the pool of threads for blocking calls whose call has not read its end (`BlockingWaited`), linked through their
// blocks, at 64 the one before and at 72 the one after, so that the child of a `fork`, which has no thread of the pool, ends them
// (`PoolLost`); a wait leaves them where its call goes on and where its actor falls (`Fall`).
thread static mut byte* handedWaits = null

// The wait `block` taken out of `handedWaits`, where it stands among them.
void HandedOut(byte* block) {
    raw {
        byte* before = *Ptr<byte*>(block + 64)
        byte* after = *Ptr<byte*>(block + 72)
        if before == null && handedWaits != block {
            return
        }

        if before != null {
            *Ptr<byte*>(before + 72) = after
        } else {
            handedWaits = after
        }

        if after != null {
            *Ptr<byte*>(after + 64) = before
        }

        *Ptr<byte*>(block + 64) = null
        *Ptr<byte*>(block + 72) = null
    }
}

// The waits on the pool of threads for blocking calls in the child of a `fork`, which drops the pool and has none of its threads
// (`sys.Forked`), found where jobs are handed while the pool's `eventfd` is not the one the scheduler armed: each wait whose end the
// scheduler had not taken ended with -125, `ECANCELED`, put as its job's result too, so that its call gets `Other` with the number
// 125 (S1) and gives its job back, and no wait waits without end for a job no thread makes *(assumed: the number, which no answer
// names)*; the count of jobs handed set to 0 and the `eventfd` to none, so that the child's
// first call makes a pool of its own (`sys.PoolEvent`). A job the parent's pool ended before the `fork` whose end the scheduler had
// not taken is ended so too, and a descriptor its opening gave stays open in the child (inferred).
void PoolLost() {
    raw {
        if handed == 0 || poolEvent == sys.PoolHeld() {
            return
        }

        mut byte* at = handedWaits
        while at != null {
            byte* next = *Ptr<byte*>(at + 72)
            *Ptr<byte*>(at + 64) = null
            *Ptr<byte*>(at + 72) = null
            if *Ptr<long>(at) == 0 {
                *Ptr<long>(*Ptr<byte*>(at + 48) + 16) = -125
                Ended(at, -125)
            }

            at = next
        }

        handedWaits = null
        handed = 0
        poolEvent = -1
    }
}

// The wait of a call on a file or a pipe handed to the pool of threads for blocking calls (`sys.BlockingWaiter`; issue 661; section
// 12, the owner, 2026-10-30, "Readiness I/O, as Tokio"; S10): the pool's `eventfd` armed in the poller (`PoolArm`), and the
// job queued (`sys.Submit`) with a block shaped as `SocketWaited`'s, with no deadline, at 40 the mark -1, so that a fall drops the
// job (`Fall`), at 48 the job, whose block at 24 it is, and at 64 and 72 its links among the waits on the pool (`handedWaits`),
// whose jobs the child of a `fork` drops first (`PoolLost`). Inside a message the activation parks until the job is done, and the
// calls of its chain are let in above it (U17); the top-level code runs what its wait on a call runs (`RootLoop`); and the wait
// counts among the registrations of the poller (`polled`), so that it raises no `deadlock` (U18). The job's result, or the failure
// of the pool or of the poller, or the failure that ended the wait (`PoolLost`); a thread the system refuses while no thread of the pool runs ends the process with
// `error: thread-refused (1)` on standard error and the exit code 1, as U35 ends it at a worker thread the system refuses (issue
// 661, the product pass, comment 7182792402, Q2, kept as built, comment 7189038013).
extern "C" long BlockingWaited(byte* job) {
    mut long result = 0
    sys.Entered()
    raw {
        PoolLost()
        long event = sys.PoolEvent()
        if event < 0 {
            sys.Left()
            return event
        }

        long armed = PoolArm(event)
        if armed < 0 {
            sys.Left()
            return armed
        }

        poolEvent = event
        byte* block = Allocate(80)
        byte* header = running
        *Ptr<long>(block) = 0
        *Ptr<byte*>(block + 8) = header
        *Ptr<long>(block + 16) = Never()
        *Ptr<byte*>(block + 24) = null
        *Ptr<byte*>(block + 32) = null
        *Ptr<long>(block + 40) = -1
        *Ptr<byte*>(block + 48) = job
        *Ptr<long>(block + 56) = 0
        *Ptr<byte*>(block + 64) = null
        *Ptr<byte*>(block + 72) = null
        *Ptr<byte*>(job + 24) = block
        long submitted = sys.Submit(job)
        if submitted < 0 {
            std.Free(block, 80)
            sys.Left()
            if submitted == -4101 {
                WriteError("error: thread-refused (1)\n")
                sys.Exit(1)
            }

            return submitted
        }

        if handedWaits != null {
            *Ptr<byte*>(block + 72) = handedWaits
            *Ptr<byte*>(handedWaits + 64) = block
        }

        handedWaits = block
        handed = handed + 1
        polled = polled + 1
        if header == null {
            RootLoop(block, Never())
        } else {
            *Ptr<byte*>(header + 360) = block
            *Ptr<byte*>(header + 432) = null
            byte* heap = std.HeapUse(null)
            while *Ptr<long>(block) == 0 {
                long entries = sys.Inside(0)
                sys.Switch(header, threadSide)
                sys.Inside(entries)
            }

            std.HeapUse(heap)
            *Ptr<byte*>(header + 360) = null
        }

        polled = polled - 1
        HandedOut(block)
        result = *Ptr<long>(job + 16)
        std.Free(block, 80)
    }

    sys.Left()
    return result
}

// Whether a call on a file or a pipe is handed to the pool of threads for blocking calls (`sys.BlockingWaiter`): 0 where the
// top-level code makes it with nothing else left to run, no actor queued, asleep among the timers, waiting in the poller or on the
// pool, no restart pausing and no child's block for the top-level code to run, since no actor could run while it waits, so that a
// program with no other actor that runs pays no hop between threads; 1 otherwise, an actor's message always handing it.
extern "C" int BlockingOffloads() {
    raw {
        if running == null && runFirst == null && timers == null && polled == 0 && PauseDue() == Never() &&
            (rootBlocks == null || *Ptr<byte*>(rootBlocks) == null) {
            return 0
        }
    }

    return 1
}

// The jobs of the pool of threads for blocking calls done since the last look (`sys.PoolDone`), at the event of the pool's
// `eventfd` (`Polled`): each job's wait ended with 1 (`Ended`), whose call reads the job's result (`BlockingWaited`), or the job
// given back where its actor fell while it ran (`Fall`); the `eventfd`'s registration is armed again while a job is handed
// (`PoolArm`), since `EPOLLONESHOT` disarms it at each event, and an arming the poller refuses leaves the jobs to the next look
// (`Polled`).
void PoolDrain() {
    raw {
        mut byte* done = sys.PoolDone()
        while done != null {
            byte* next = *Ptr<byte*>(done)
            handed = handed - 1
            byte* block = *Ptr<byte*>(done + 24)
            if block == null {
                sys.JobDropped(done)
            } else {
                Ended(block, 1)
            }

            done = next
        }

        if handed > 0 {
            PoolArm(poolEvent)
        }
    }
}

// The registration of the pool's `eventfd` `event` in the poller for `EPOLLIN` (1) armed where it is not (`sys.PoolFlag`, which
// `sys.PoolDone` clears at its event, `EPOLLONESHOT`), so that a call handed while a job runs makes no call of `epoll_ctl`: 0, or the
// failure of the poller.
long PoolArm(long event) {
    raw {
        int* armed = sys.PoolFlag()
        if *armed == 0 {
            long added = sys.PollAdd(int(event), 1, sys.EpollDataAt())
            if added < 0 {
                return added
            }

            *armed = 1
        }
    }

    return 0
}

// The scheduler's wait in the poller for at most `nanoseconds` (`IdleWait`), or its look with no wait (`RunTurn`): each wait of a
// descriptor an event gave whose events it gives, or every wait of it at an error or a hang-up (`EPOLLERR` 8, `EPOLLHUP` 16),
// taken out of its list and ended with 1 (`Ended`), and the registration armed again for the waits left (`Rearm`), as Tokio's
// `ScheduledIo` wakes the readers at a read's readiness and the writers at a write's; where the poller fails, every wait of every
// descriptor ended with the failure (`Fail`), as each call's `IoError` of the system's kind and number (S1). The event of the pool's
// `eventfd` takes the jobs done (`PoolDrain`) where that descriptor is the pool's still (`sys.PoolHeld`): the child of a `fork`
// drops the pool, and a descriptor that takes its number there reaches its own waits, while the waits on the pool end first
// (`PoolLost`). Where the registration of that `eventfd` could not be armed again while jobs are handed (`PoolDrain`), each look
// takes the jobs done and tries the arming again, and the wait is held to 1 millisecond while it fails, so that no wait on the pool
// waits without end and no call that ran loses its result; a look that took a job or ended a wait returns at once, so that what
// it woke runs.
void Polled(long nanoseconds) {
    mut long bound = nanoseconds
    raw {
        if handed > 0 {
            long before = handed
            PoolLost()
            if handed > 0 && *sys.PoolFlag() == 0 {
                PoolDrain()
                if *sys.PoolFlag() == 0 && bound > 1000000 {
                    bound = 1000000
                }
            }

            if handed != before {
                return
            }
        }

        if readied == null {
            readied = AllocateOwn(1024)
        }

        long count = sys.PollWait(bound, readied, 64, sys.EpollDataAt())
        if count < 0 {
            mut long each = 0
            while each < waitSlots {
                byte* failing = waits + each * 8
                if *Ptr<byte*>(failing) != null {
                    Fail(int(each), failing, count)
                }

                each = each + 1
            }

            return
        }

        mut long i = 0
        while i < count {
            long fd = *Ptr<long>(readied + i * 16)
            long given = *Ptr<long>(readied + i * 16 + 8)
            if fd == poolEvent && fd == sys.PoolHeld() {
                PoolDrain()
            } else if fd >= 0 && fd < waitSlots {
                byte* slot = waits + fd * 8
                mut byte* at = slot
                while *Ptr<byte*>(at) != null {
                    byte* block = *Ptr<byte*>(at)
                    if (*Ptr<long>(block + 56) & given) != 0 || (given & 24) != 0 {
                        *Ptr<byte*>(at) = *Ptr<byte*>(block + 48)
                        Ended(block, 1)
                    } else {
                        at = block + 48
                    }
                }

                if *Ptr<byte*>(slot) != null {
                    Rearm(int(fd), slot)
                }
            }

            i = i + 1
        }
    }
}

// The turns of the run queue since the last look at the poller (`RunTurn`).
thread static mut long turns = 0

// One actor's turn of the run queue (`RunOne`), and at every 61st turn, while a registration waits, a look at the poller with no
// wait (`Polled`), so that a scheduler that never runs out of work still reads the events of the descriptors that wait, as Tokio's
// scheduler reads its driver every `event_interval` ticks, 61 by default.
void RunTurn() {
    raw {
        turns = turns + 1
        if turns >= 61 {
            turns = 0
            if polled > 0 {
                Polled(0)
            }
        }
    }

    RunOne()
}

// The replies of the calls that an actor's start keeps out, each address added to `found` in the order the walk finds them, which the
// top-level code's wait that found nothing left to run names in place of its own call, in source order and not in the walk's, the
// first on the error line and every further place under it (`KeptSorted`, `DeadlockKept`; section 6, the owner, 2026-11-21, #599,
// comment 7067131310, several 2, and comment 7067139953, the form 1; comment 7067639209, the order 1), since such a call closes a
// loop: a call that waits in the actor's lists, made in the chain of the code that runs the
// constructor, which that chain would let in were the actor not starting (U17), so that the error names the call a developer changes
// (`Wait`; U18, U22, U52; section 6, the owner, 2026-11-21, #599, comment 7060156109, Q6 1), and so the words under a test's `FAILED`
// line where the runner's wait for it finds nothing left to run (`TestRan`; Y5; section 11, the owner, 2026-11-21, #599, comment
// 7063693195, Y5's line 1). The code that runs the constructor is the
// actor's own top activation at a restart (REBUILDING); at a first start (BUILDING) it is the top-level code, whose chain is that of its
// call that waits, `high` and `low`, where the top-level code runs it, else the activation whose header names the actor at 424
// (`Building`), each walked from the actor its stack builds up the supervisors that stack builds too (`KeptBuilt`). The walk's order:
// the starts the top-level code runs, then the actors by the index of their slots, each actor's restart before the starts its
// activations run, from its top activation down. None is added where none waits, a loop of chains that passes no start among them.
// The lists are read with plain loads, which holds while one thread runs every program (U35): nothing runs while the top-level
// code's wait finds nothing left to run.
void Kept(long high, long low, mut List<long> found) {
    raw {
        KeptBuilt(rootBuilding, high, low, mut found)
    }

    long used = SlotsUsed()
    mut long index = 0
    while index < used {
        raw {
            byte* slot = Slot(index)
            if *Ptr<long>(slot + 8) != 0 {
                byte* state = *Ptr<byte*>(slot)
                mut byte* at = *Ptr<byte*>(state - 8)
                if at != null && Rebuilding(state) {
                    KeptIn(state, *Ptr<long>(at + 344), *Ptr<long>(at + 352), mut found)
                }

                while at != null {
                    KeptBuilt(*Ptr<byte*>(at + 424), *Ptr<long>(at + 344), *Ptr<long>(at + 352), mut found)
                    at = *Ptr<byte*>(at + 368)
                }
            }
        }

        index = index + 1
    }
}

// The replies of the calls of the chain `high` and `low` that the start of the actor whose state is `state`, built on a stack of that
// chain, keeps out, then those of the start of each actor whose constructor that stack runs around it, its supervisor while it is
// built (`ActorNew`, `Supervisor`), as a start nested in a constructor has it, added to `found`; none where none waits, and none for an
// actor whose constructor no longer runs.
void KeptBuilt(byte* state, long high, long low, mut List<long> found) {
    mut byte* at = state
    while at != null && Constructing(at) {
        KeptIn(at, high, low, mut found)
        raw {
            at = *Ptr<byte*>(at - 72)
        }
    }
}

// The replies of the calls of the chain `high` and `low` that wait in the inbox of the actor whose state is `state`, then on its queue
// of many senders, read from the message its holder takes next (`Popped`), since an actor whose constructor runs at its first start
// is not taken (`Claimed`), added to `found`; none where none waits. A block of a decision has no reply (`Pending`).
void KeptIn(byte* state, long high, long low, mut List<long> found) {
    raw {
        KeptFrom(*Ptr<byte*>(state - 32), null, high, low, mut found)
        KeptFrom(*Ptr<byte*>(state - 136), state - 128, high, low, mut found)
    }
}

// The replies of the calls of the chain `high` and `low` among the messages linked from `first`, in their order, the stub `stub` of a
// queue of many senders passed over, which links its messages and is none (`Pushed`), each address added to `found`; none where none
// stands there.
void KeptFrom(byte* first, byte* stub, long high, long low, mut List<long> found) {
    raw {
        mut byte* at = first
        while at != null {
            if at != stub && CallOf(at, high, low) {
                found.Add(long(*Ptr<byte*>(at + 16)))
            }

            at = *Ptr<byte*>(at)
        }
    }
}

// The place of a call whose reply's address is `reply` (`Kept`), `<file>:<n>`, the file at 48 and 56 and the line at 64, which
// `Enqueue` stores.
string KeptPlace(long reply) {
    mut string file = ""
    mut long line = 0
    raw {
        byte* at = Ptr<byte>(reply)
        file = TextAt(*Ptr<byte*>(at + 48), *Ptr<long>(at + 56))
        line = *Ptr<long>(at + 64)
    }

    return "{file}:{line}"
}

// The order of the places of two calls an actor's start keeps out, their replies `first` and `second` (`Kept`), less than 0, 0 or
// more than 0: by the file, its path as the error line writes it, compared byte for byte as `<` compares two strings (`Order`; T32; assumed in
// section 6), then by the line (section 6, the owner, 2026-11-21, #599, comment 7067639209, the order 1).
int KeptOrder(long first, long second) {
    mut string firstFile = ""
    mut string secondFile = ""
    mut long firstLine = 0
    mut long secondLine = 0
    raw {
        byte* a = Ptr<byte>(first)
        byte* b = Ptr<byte>(second)
        firstFile = TextAt(*Ptr<byte*>(a + 48), *Ptr<long>(a + 56))
        secondFile = TextAt(*Ptr<byte*>(b + 48), *Ptr<long>(b + 56))
        firstLine = *Ptr<long>(a + 64)
        secondLine = *Ptr<long>(b + 64)
    }

    int order = Order(firstFile, secondFile)
    if order != 0 {
        return order
    }

    if firstLine < secondLine {
        return -1
    }

    if firstLine > secondLine {
        return 1
    }

    return 0
}

// The replies `found` as `Kept` gives them, in the walk's order, put in source order (`KeptOrder`), each inserted in its turn after
// those of its place, so that the walk's order stays among the calls of one place (section 6, the owner, 2026-11-21, #599, comment
// 7067639209, the order 1).
List<long> KeptSorted(List<long> found) {
    mut sorted = List<long>()
    for reply in found {
        mut int at = sorted.Count
        while at > 0 && KeptOrder(sorted[at - 1], reply) > 0 {
            at = at - 1
        }

        sorted.Insert(at, reply)
    }

    return sorted
}

// The words that name the calls an actor's start keeps out, `sorted` as `KeptSorted` gives them, at least one (`DeadlockKept`,
// `RunTests`): one for each place, in that order, `<file>:<n>` followed by ` (<k> calls)` where k calls stand at it, more than one,
// and by nothing where one does (the same place 1); the first is the place the error line names, each further one stands on a line
// `kept out at <place>`, at most 10 such lines, and one line `... and <k> more` follows them for the k places past those (the cap 1),
// places and not calls (assumed in section 6) (section 6, the owner, 2026-11-21, #599, comment 7067639209).
List<string> KeptLines(List<long> sorted) {
    mut lines = List<string>()
    mut int more = 0
    mut int index = 0
    while index < sorted.Count {
        mut int calls = 1
        while index + calls < sorted.Count && KeptOrder(sorted[index], sorted[index + calls]) == 0 {
            calls = calls + 1
        }

        mut string place = KeptPlace(sorted[index])
        if calls > 1 {
            place = "{place} ({calls} calls)"
        }

        if lines.Count == 0 {
            lines.Add(place)
        } else if lines.Count <= 10 {
            lines.Add("kept out at {place}")
        } else {
            more = more + 1
        }

        index = index + calls
    }

    if more > 0 {
        lines.Add("... and {more} more")
    }

    return lines
}

// The `deadlock` of the top-level code's wait that names the calls an actor's start keeps out, `found` as `Kept` gives them (`Wait`):
// one keeps the error line of `Raise`, at its place (section 6, the owner, 2026-11-21, #599, comment 7060156109, Q6 1); of more than
// one, the error line names the first place in source order, with the count of its calls where more than one, and ends with a colon,
// as a thrown value's does (`Throw`), also where that place is the only one, and the further lines of `KeptLines` stand under it,
// before the trace, the exit code 1 as `Raise` ends (U18, U22, U52; section 6, the owner, 2026-11-21, #599, comment 7067131310,
// several 2, and comment 7067139953, the form 1; comment 7067639209, the order 1, the same place 1 and the cap 1).
void DeadlockKept(List<long> found) {
    sorted = KeptSorted(found)
    mut string file = ""
    mut int line = 0
    raw {
        byte* first = Ptr<byte>(sorted[0])
        file = TextAt(*Ptr<byte*>(first + 48), *Ptr<long>(first + 56))
        line = int(*Ptr<long>(first + 64))
    }

    if found.Count == 1 {
        Raise("deadlock", file, line)
    }

    lines = KeptLines(sorted)
    string place = lines[0]
    mut string under = ""
    mut int further = 1
    while further < lines.Count {
        under = "{under}{lines[further]}\n"
        further = further + 1
    }

    CrashActor("deadlock", file, line, false, "")
    sys.Crashing()
    WriteError("error: deadlock at ")
    WriteError(place)
    WriteError(":\n")
    WriteError(under)
    sys.Trace()
    sys.Exit(1)
}

// The wait line from the call that the activation `header` of a message waits on, whose reply is `reply` (U60, U61; section 6,
// "Deadlocks", layer 3; the owner, 2026-11-20, #519, comment 7051071630, T63 2, T65 1, T66 1): the count of the waits of the loop
// that the call closes where the line leads back to the actor of `header`, else 0. The line goes from actor to actor (`Along`),
// its bound aside. A line that runs into a loop its waiter is not in ends where it meets an actor again that a tortoise holds,
// moved to the line's actor at each power of two of its hops, as Brent's check of a cycle moves it (not checked at source), so
// that a walk takes at most about twice the actors that wait, and no memory. It reads the records and the activations of other
// actors with plain loads, a reading that holds while one thread runs every program (U35).
long Looped(byte* header, byte* reply) {
    raw {
        byte* home = *Ptr<byte*>(header + 320)
        mut byte* callee = *Ptr<byte*>(reply + 72)
        if !Reached(callee, header) {
            return 0
        }

        mut byte* tortoise = null
        mut long steps = 0
        mut long limit = 1
        mut long hops = 1
        while true {
            if callee == home {
                return hops
            }

            if callee == tortoise {
                return 0
            }

            steps = steps + 1
            if steps == limit {
                tortoise = callee
                limit = limit * 2
                steps = 0
            }

            callee = Along(callee)
            if callee == null {
                return 0
            }

            hops = hops + 1
        }
    }
}

// The actor after the actor whose record is `callee` on the wait line, where the line goes on from it (`Onward`) and reaches
// that actor (`Reached`), the waiter the actor's top activation or, for a child whose block waits, none (U60); null where the
// line ends.
byte* Along(byte* callee) {
    raw {
        byte* next = Onward(callee)
        if next == null {
            return null
        }

        mut byte* waiter = null
        if *Ptr<int>(callee - 88) != 5 {
            waiter = *Ptr<byte*>(callee - 8)
        }

        if !Reached(next, waiter) {
            return null
        }

        return next
    }
}

// Whether the wait line reaches the actor whose record is `callee` by the call that the activation `waiter` waits on, or, where
// `waiter` is null, by the top-level code's call or as the supervisor of a child whose block waits (U60): a child whose block of
// `on crash` waits (U34) is reached, and so is an actor that runs or waits, but by a call that got in by its chain, the chain its
// top activation runs in (U17), which no activation of the actor runs yet: the waiter's own call that gets in makes no edge, and
// the line goes on through the activation that runs a call that got in by its chain, where that activation is newer in the chain
// than the hop's (the owner, 2026-11-21, #519, comment 7060155980, T86 2), read as an activation of the actor, at or under its
// top activation, that runs the very call the waiter waits on (`Runs`; assumed: a reading of the build of T86 2, comment
// 7059356106). An actor that waits for its restart (U23), that ended or whose constructor runs at its `spawn` (U3), and an idle
// one end the line.
bool Reached(byte* callee, byte* waiter) {
    raw {
        int life = *Ptr<int>(callee - 88)
        if life == 5 {
            return true
        }

        byte* top = *Ptr<byte*>(callee - 8)
        if life != 0 || top == null {
            return false
        }

        if waiter != null && *Ptr<long>(top + 344) == *Ptr<long>(waiter + 344) && *Ptr<long>(top + 352) == *Ptr<long>(waiter + 352) {
            return Runs(callee, *Ptr<byte*>(waiter + 432))
        }

        return true
    }
}

// Whether an activation of the actor whose record is `state`, at or below its top activation, runs the message `message`, a call
// that got in by its chain and started (`Start`; U17, U60). The owner's T86 2 (2026-11-21, #519, comment 7060155980) has the line
// go on through the activation that runs a call that got in by its chain, where that activation is newer in the chain than the
// hop's; `Reached` reads that as the activation that runs the very call the hop's waiter waits on (assumed: a reading of the build
// of T86 2, comment 7059356106).
bool Runs(byte* state, byte* message) {
    raw {
        mut byte* at = *Ptr<byte*>(state - 8)
        while at != null {
            if *Ptr<byte*>(at + 328) == message {
                return true
            }

            at = *Ptr<byte*>(at + 368)
        }

        return false
    }
}

// The actor the wait line goes on to from the actor whose record is `callee`, which it reached (`Reached`; U60): the supervisor of
// a child whose block of `on crash` waits, whose block runs after the supervisor's current message (U28), and the actor that the
// reply of the top activation reaches, which `Enqueue` stored in it; null where the line ends: at a child whose block the
// top-level code runs (U33), at a top activation that runs, whose reply is set or whose deadline passed, and at one that waits on
// no call, a sleep (`Park`) or a wait in the poller (`SocketWaited`), whose block at 360 is no reply, the sleep's of 48 bytes and
// the poller wait's of 64 (its link to the next wait of its descriptor at 48, its events at 56), read only after the word at
// 432, which names the message of a call's wait (`Answer`) and no message of those (U60; assumed: a sleep and a wait in the
// poller wait on no actor, so that the line ends there).
byte* Onward(byte* callee) {
    raw {
        if *Ptr<int>(callee - 88) == 5 {
            return *Ptr<byte*>(callee - 72)
        }

        byte* top = *Ptr<byte*>(callee - 8)
        if *Ptr<byte*>(top + 432) == null {
            return null
        }

        byte* next = *Ptr<byte*>(top + 360)
        if next == null || ReplyState(next) != 0 || Waited(next) {
            return null
        }

        return *Ptr<byte*>(next + 72)
    }
}

// The text of the loop of `hops` waits on the wait line from the actor whose record is `first` (`Onward`; U63, U64; the owner,
// 2026-11-20, #519, comment 7051071630, T68 3): the lines of `LoopLines`, one apart from the next by a line break, built in the
// heap of the code that raises, at the raise alone.
string LoopText(byte* first, long hops) {
    mut string text = ""
    mut string gap = ""
    for one in LoopLines(first, hops) {
        text = "{text}{gap}{one}"
        gap = "\n"
    }

    return text
}

// The lines of the loop of `hops` waits on the wait line from the actor whose record is `first` (`Onward`; U63): one for each
// wait of the loop, from the wait of `first` (`WaitText`), which `LoopText` joins and the runner writes under a test's `FAILED`
// line (`RunTests`; Y5). The first hop from a waiter goes through `Onward`, which ends the line where the waiter's own reply
// passed its deadline, while `Looped` takes it with that bound aside (T66 1): the two agree, since no reply reaches the walk past
// its deadline, `Enqueue` raising `call-timeout` at once for one whose deadline the clock reached and `Waited` reading the clock of
// a turn of the scheduler before it.
List<string> LoopLines(byte* first, long hops) {
    mut lines = List<string>()
    mut byte* callee = first
    mut long count = 0
    while count < hops {
        lines.Add(WaitText(callee))
        raw {
            callee = Onward(callee)
        }

        count = count + 1
    }

    return lines
}

// The line of the wait of the actor whose record is `state` on the wait line (U63; T68 3 of comment 7051071630):
// `<Type>#<n> waits at <file>:<line> on <Type>#<m>` for the call its top activation waits on, `<Type>#<n> waits for the decision
// of <Type>#<m> on its crash` for a child whose block waits, each actor by its text (U2), as its log line names it (U24), each
// line ending with ` in chain ` and a chain's ID, 32 lowercase hexadecimal digits as `Crashed.Chain` writes one (`ChainText`):
// for a call the chain the waiting activation runs in, for a child the chain of the message whose crash its block decides on
// (`Pending`) (the owner, 2026-11-21, #519, comment 7060155980, T84 1), and none where no block holds that message (`BlockOf`;
// assumed: a reading of the build of T68 3 and T84 1, comment 7058660596).
string WaitText(byte* state) {
    mut string from = ""
    mut string to = ""
    mut string chain = ""
    mut string place = ""
    mut long line = 0
    mut bool child = false
    mut bool found = false
    raw {
        from = ActorNamed(state)
        child = *Ptr<int>(state - 88) == 5
        if child {
            to = ActorNamed(*Ptr<byte*>(state - 72))
            byte* block = BlockOf(state)
            found = block != null
            if found {
                chain = ChainText(block + 136)
            }
        } else {
            byte* top = *Ptr<byte*>(state - 8)
            byte* at = *Ptr<byte*>(top + 360)
            to = ActorNamed(*Ptr<byte*>(at + 72))
            chain = ChainText(top + 344)
            place = TextAt(*Ptr<byte*>(at + 48), *Ptr<long>(at + 56))
            line = *Ptr<long>(at + 64)
        }
    }

    if !child {
        return "{from} waits at {place}:{line} on {to} in chain {chain}"
    }

    if found {
        return "{from} waits for the decision of {to} on its crash in chain {chain}"
    }

    return "{from} waits for the decision of {to} on its crash"
}

// U18's end of the process (section 6, "Deadlocks"; the owner, 2026-11-15, #519, comment 6892812780, Q4): the top-level code's
// wait on the call whose reply is `reply` finds nothing left to run, and no call that an actor's start keeps out closes the loop
// (`Kept`, `DeadlockKept`; U22). One walk follows the wait line from that call (`Along`), the
// top-level code no point of it (T64 of comment 7051071630), and where it runs into a loop, the error line ends with a colon and
// the loop's waits stand below it as layer 3 writes them, from the first wait of the loop the walk meets (`LoopText`,
// `Deadlocked`; U64; the owner, 2026-11-21, #519, comment 7060155980, T85 2): Brent's check finds the loop's length, and a second
// pass from the call, one pointer that length ahead of the other, its first actor, as Brent's algorithm finds the start of a
// cycle (not checked at source) (`LoopFirst`). Where the line ends, the error line stands alone (`Raise`).
void Stuck(byte* reply, string file, int line) {
    mut long length = 0
    byte* first = LoopFirst(reply, mut length)
    if first == null {
        Raise("deadlock", file, line)
    }

    sys.Left()
    Deadlocked(LoopText(first, length), file, line)
}

// The first actor of the loop that one walk from the call whose reply is `reply` runs into (`Along`), the count of its waits set
// in `length`, as `Stuck` reads them, and null where the line ends (`Stuck`, `TestRan`; U64). It allocates nothing.
byte* LoopFirst(byte* reply, mut long length) {
    mut byte* first = null
    raw {
        byte* start = *Ptr<byte*>(reply + 72)
        if Reached(start, null) {
            mut byte* tortoise = start
            mut byte* hare = Along(start)
            mut long power = 1
            length = 1
            while hare != null && hare != tortoise {
                if power == length {
                    tortoise = hare
                    power = power * 2
                    length = 0
                }

                hare = Along(hare)
                length = length + 1
            }

            if hare != null {
                first = start
                hare = start
                mut long i = 0
                while i < length {
                    hare = Along(hare)
                    i = i + 1
                }

                while first != hare {
                    first = Along(first)
                    hare = Along(hare)
                }
            }
        }
    }

    return first
}

// The text of the actor whose record is `state`: the name of its type, `#` and its number (U2), as its log line names it (U24).
string ActorNamed(byte* state) {
    mut string name = ""
    mut long number = 0
    raw {
        byte* written = *Ptr<byte*>(state - 96)
        name = TextAt(*Ptr<byte*>(written), *Ptr<long>(written + 8))
        number = *Ptr<long>(state - 40)
    }

    return ActorText(name, number)
}

// The message of the block that decides on the crash of the child `child`, which waits for that decision (U34): on its
// supervisor's queue of the blocks, where the supervisor's holder has not moved it yet, at the front of the supervisor's inbox, or
// run by one of the supervisor's activations (`Post`, `Moved`, `Start`); null where none holds it. It reads the supervisor's
// queue by plain loads from its holder's end, a reading that holds while one thread runs every program (U35).
byte* BlockOf(byte* child) {
    raw {
        byte* parent = *Ptr<byte*>(child - 72)
        byte* stub = parent - 104
        mut byte* at = *Ptr<byte*>(parent - 112)
        while at != null {
            if at != stub && *Ptr<byte*>(at + 56) == child {
                return at
            }

            at = *Ptr<byte*>(at)
        }

        at = *Ptr<byte*>(parent - 32)
        while at != null && *Ptr<byte*>(at + 8) == BlockTable() {
            if *Ptr<byte*>(at + 56) == child {
                return at
            }

            at = *Ptr<byte*>(at)
        }

        at = *Ptr<byte*>(parent - 8)
        while at != null {
            byte* message = *Ptr<byte*>(at + 328)
            if *Ptr<byte*>(message + 8) == BlockTable() && *Ptr<byte*>(message + 56) == child {
                return message
            }

            at = *Ptr<byte*>(at + 368)
        }

        return null
    }
}

// Layer 3's `deadlock` (U62, U63; section 6, "Deadlocks", layer 3): the crash of the actor whose wait closed a loop, at the line
// of its call, with the loop's text `text` below its error line, as a `throw` keeps its text (`Throw`), so that its log line
// holds the text in double quotes and a block of `on crash` reads it as the `Detail` of its `RuntimeError` (U24, U30); where its
// policy and its supervisors' escalate the crash to the top-level code, the process ends here with the error line ending in a
// colon, the text below it, the trace of this stack and the exit code 1 (U25).
void Deadlocked(string text, string file, int line) {
    CrashActor("deadlock", file, line, true, text)
    sys.Crashing()
    WriteError("error: deadlock at ")
    WriteError(file)
    WriteError(":")
    WriteNumber(ulong(line))
    WriteError(":\n")
    WriteError(text)
    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// The first actor of the run queue taken off it, and what it can go on with run: a call of its chain on
// its top activation's side list, which starts an activation above that one; its top activation, whose
// reply is set; or, where it is idle, the first message of its inbox; an actor with none of them is
// passed over, a message sent to it while it waits staying in its inbox, and so is an actor that waits for
// its restart or for the decision of its block (U22, U34); an actor that ended while it stood there has its
// record freed here, the first page of its heap (`EndActor`), before the take where no thread holds it, so
// that one whose spawner's crash ended it while its constructor waited, BUILDING left in its state word since
// that constructor never ends, is freed as well, and after the take where a thread let go of it meanwhile.
// The thread holds the actor from the take
// of its entry (`Claimed`), which a thread that holds it already, or its constructor, refuses, to the end of
// its turn (`LetGo`, in `Run` where it runs); a passed-over actor is let go at once and not queued again for
// its own inbox. A message whose deadline passed at the scheduler's turn is dropped at its take, from the inbox
// and from the side list, before the next is taken (`Dropped`; U37), and a top activation whose deadline
// passed goes on (`Waited`).
void RunOne() {
    raw {
        byte* state = runFirst
        runFirst = *Ptr<byte*>(state - 16)
        if runFirst == null {
            runLast = null
        }

        *Ptr<byte*>(state - 16) = null
        if (StateWord(state).Load(MemoryOrder.Acquire) & 1) == 0 && *Ptr<int>(state - 88) == 3 {
            std.HeapFree(state - 192)
            return
        }

        if !Claimed(state) {
            return
        }

        int life = *Ptr<int>(state - 88)
        if life == 3 {
            std.HeapFree(state - 192)
            return
        }

        Moved(state)
        if life == 1 || life == 5 {
            LetGo(state, false)
            return
        }

        byte* top = *Ptr<byte*>(state - 8)
        if top == null {
            while *Ptr<byte*>(state - 32) != null {
                byte* message = Taken(state - 32)
                if *Ptr<long>(message + 40) > tick {
                    Start(state, message, null)
                    return
                }

                Dropped(message)
            }
        } else {
            byte* reply = *Ptr<byte*>(top + 360)
            while *Ptr<byte*>(top + 376) != null {
                byte* message = Taken(top + 376)
                if *Ptr<long>(message + 40) > tick {
                    Start(state, message, top)
                    return
                }

                Dropped(message)
            }

            if reply != null && (ReplyState(reply) != 0 || Waited(reply)) {
                Run(state, top)
                return
            }
        }

        LetGo(state, false)
    }
}

// A new activation of the actor whose state is `state` for `message`, on a stack of the size the
// actor asked for, above the activation `below`, null where the actor is idle, whose chain it takes and
// whose side list it takes over, and its run from its first frame, `ActorStart`.
void Start(byte* state, byte* message, byte* below) {
    raw {
        byte* header = Held(*Ptr<long>(state - 48))
        *Ptr<byte*>(header + 320) = state
        *Ptr<byte*>(header + 328) = message
        *Ptr<long>(header + 344) = *Ptr<long>(message + 24)
        *Ptr<long>(header + 352) = *Ptr<long>(message + 32)
        *Ptr<byte*>(header + 360) = null
        *Ptr<byte*>(header + 368) = below
        *Ptr<byte*>(header + 376) = null
        *Ptr<byte*>(header + 384) = null
        mut long word = 424
        while word < 512 {
            *Ptr<long>(header + word) = 0
            word = word + 8
        }

        if below != null {
            *Ptr<byte*>(header + 376) = *Ptr<byte*>(below + 376)
            *Ptr<byte*>(header + 384) = *Ptr<byte*>(below + 384)
            *Ptr<byte*>(below + 376) = null
            *Ptr<byte*>(below + 384) = null
        }

        *Ptr<byte*>(state - 8) = header
        sys.Enter(header, header, ActorStart)
        Run(state, header)
    }
}

// The activation `header` of the actor whose state is `state` run on its stack until it waits or
// ends: the actor's heap the one the allocation entry serves (section 3), the bounds of that stack's guard
// set for the target's handler of a fault (section 2), the switch to it and back, and the heap served
// before it served again. An activation that ended gives the actor's top to the one below it, with its side list,
// and its stack back to the pool; the thread then lets go of the actor (`LetGo`), which goes to the end of the
// run queue where it can go on (`Ready`) or a take found it held, and no entry of it stands there, and an actor
// that ends after its current message ends where its last activation ended (U13), let go as one that crashed
// is, once its crash was taken (`Crashed`), with no new entry.
void Run(byte* state, byte* header) {
    raw {
        byte* before = std.HeapUse(*Ptr<byte*>(state - 64))
        sys.StackGuard(header + 512, *Ptr<long>(header + 400))
        running = header
        long entries = sys.Inside(0)
        sys.Switch(threadSide, header)
        sys.Inside(entries)
        running = null
        sys.StackGuard(null, 0)
        std.HeapUse(before)
        if *Ptr<long>(header + 448) != 0 {
            holding = state
            Crashed(state, header)
            holding = null
            LetGo(state, false)
            return
        }

        if *Ptr<byte*>(header + 360) == null {
            byte* below = *Ptr<byte*>(header + 368)
            *Ptr<byte*>(state - 8) = below
            if below != null {
                *Ptr<byte*>(below + 376) = *Ptr<byte*>(header + 376)
                *Ptr<byte*>(below + 384) = *Ptr<byte*>(header + 384)
            }

            Give(header)
            if below == null && Ending(state) {
                EndActor(state)
                LetGo(state, false)
                return
            }
        }

        LetGo(state, Ready(state))
    }
}

// The chain ID of a chain the top-level code starts, 16 bytes at `at`: the size of W3C's trace-id, which
// the chain ID is for a trace the program starts (section 6, "Deadlocks"; section 12, assumed there),
// drawn from a generator of the thread, xoshiro256++, seeded once from the system's randomness at the
// thread's first chain, as Rust's `opentelemetry` draws a trace-id from a `SmallRng` of its thread seeded
// from the system (`RandomIdGenerator`, not checked at source), so that a chain costs two steps of the
// generator and no call of the system (section 6, assumed there). Where the system gives no randomness,
// the process ends with `random-failed`, as at a thread's first map (M9).
thread static mut byte* chains = null

void NewChain(byte* at) {
    raw {
        byte* s = Generator()
        *Ptr<ulong>(at) = NextChainWord(s)
        *Ptr<ulong>(at + 8) = NextChainWord(s)
    }
}

// The four words of the thread's generator, seeded at its first use (above), which a chain ID and the
// variation of a restart's pause draw from (U23).
byte* Generator() {
    raw {
        if chains == null {
            chains = AllocateOwn(32)
            if !sys.Random(chains, 32) {
                RandomFailed()
            }
        }

        return chains
    }
}

// The next 64 bits of the generator whose four words stand at `s`, xoshiro256++ as its authors give it
// (Blackman and Vigna, `xoshiro256plusplus.c`), the generator of Rust's `SmallRng` on a 64-bit machine.
ulong NextChainWord(byte* s) {
    raw {
        ulong s0 = *Ptr<ulong>(s)
        ulong s1 = *Ptr<ulong>(s + 8)
        ulong s2 = *Ptr<ulong>(s + 16) ^ s0
        ulong s3 = *Ptr<ulong>(s + 24) ^ s1
        ulong sum = s0 +% *Ptr<ulong>(s + 24)
        ulong result = (sum << 23 | sum >> 41) +% s0
        ulong t = s1 << 17
        *Ptr<ulong>(s + 8) = s1 ^ s2
        *Ptr<ulong>(s) = s0 ^ s3
        *Ptr<ulong>(s + 16) = s2 ^ t
        *Ptr<ulong>(s + 24) = s3 << 45 | s3 >> 19
        return result
    }
}

// ---- crashes and restarts (chapter 19, U19 to U24) ----------------------------------------------

// An exception kills only the actor it happens in (design record, section 6): a raise inside a message,
// a `throw`, a check of the run-time table and `print-failed` among them, and on Linux a stack overflow in
// the guard page of an actor's stack, stores the crash in the header of the activation that runs and
// switches the thread to the scheduler's stack, which never comes back to it, so that no frame of the actor
// runs again and none is unwound, as BEAM ends a process with no unwinding of its own (U19). The actor's
// supervisor, the actor whose code spawned it or the top-level code, restarts it after a pause that grows
// with each crash, the default of section 6, `on crash restart` (U22, U23), as Akka's backoff supervisor
// restarts its child.

// The actors that wait for their restart, by the time their pause ends, the soonest first, linked through
// the block of each one's restart (`Pause`), read and changed under the lock of the pauses (`PauseLock`).
static mut byte* paused = null

// The lock of the queue of the pauses.
int* PauseLock() {
    raw {
        return Ptr<int>(Shared() + 12)
    }
}

// The time the first pause of the queue ends, none where no actor waits for its restart (`Never`).
long PauseDue() {
    mut long due = Never()
    raw {
        if sharedWords != null {
            Lock(PauseLock())
            if paused != null {
                due = *Ptr<long>(*Ptr<byte*>(paused - 80) + 32)
            }

            Unlock(PauseLock())
        }
    }

    return due
}

// The first actor of the queue of the pauses taken off it where its pause ended at `now`, null where none did.
byte* PauseEnded(long now) {
    mut byte* ended = null
    raw {
        Lock(PauseLock())
        if paused != null && *Ptr<long>(*Ptr<byte*>(paused - 80) + 32) <= now {
            ended = paused
            paused = *Ptr<byte*>(*Ptr<byte*>(paused - 80) + 40)
        }

        Unlock(PauseLock())
    }

    return ended
}

// The crash of the actor whose message runs, at a raise inside it (U19): its id, its place and, where
// `hasText` holds, the text that stands below the error line, a thrown value's or the position of a cut,
// stored in the activation's header, and the thread switched to the scheduler's stack, which never comes
// back here (`Run` reads the crash), but where the block of a supervisor escalates the crash to the
// top-level code, which ends the process on this stack with the error line of the crash and the trace of
// this stack (`Escalate`; U29, U25). Nothing in the top-level code, whose raise ends the process, but the log
// line of the child whose block runs in its wait, written first, as for a `stop` (U32; assumed: S10 of issue
// 519, comment 6907441402); nor where the count of the entries under way is above 0, a check in a test build
// that fires inside the allocator, the scheduler or the copy of a crossing, or one of the runtime's own code
// wherever it fires, which raises the count first (`RaiseOwn`), and which ends the process as a stack fault
// there does, with the lists those change left as they are (chapter 12; O11); nor where the actor's policy, and its supervisors' on the way up, escalate the
// crash to the top-level code, which ends the process with this error line and the trace of this stack (U25;
// design record, section 6, the trace from the stack of the actor that raised).
void CrashActor(string id, string file, int line, bool hasText, string text) {
    long idCount = long(id.Bytes.Count)
    long fileCount = long(file.Bytes.Count)
    long textCount = long(text.Bytes.Count)
    raw {
        byte* header = running
        if header == null {
            if rootRunning != null && *Ptr<long>(rootRunning + 176) == 0 {
                BlockLogged(rootRunning)
            }

            return
        }

        long entries = sys.Inside(0)
        sys.Inside(entries)
        if entries > 0 {
            return
        }

        if Taker(*Ptr<byte*>(header + 320)) == null {
            return
        }

        *Ptr<long>(header + 448) = 1
        if hasText {
            *Ptr<long>(header + 448) = 2
        }

        *Ptr<byte*>(header + 456) = id.Pointer
        *Ptr<long>(header + 464) = idCount
        *Ptr<byte*>(header + 472) = file.Pointer
        *Ptr<long>(header + 480) = fileCount
        *Ptr<long>(header + 488) = long(line)
        *Ptr<byte*>(header + 496) = text.Pointer
        *Ptr<long>(header + 504) = textCount
        sys.Switch(header, threadSide)
    }

    EndsEscalated()
}

// The crash of the actor whose message overflowed its stack (U19), which the target's handler of the fault
// calls on its own stack with the error line it wrote of the overflow, from its id on, `count` bytes at
// `line`, the place in it, which the log line carries (U24); where the policies escalate it to the top-level
// code, it returns, and the handler ends the process with that error line and its trace (U25). The header
// marks the crash as an overflow, 3, so that the stack that raised is not kept (`Crashed`).
extern "C" void ActorOverflow(byte* line, long count) {
    raw {
        byte* header = running
        if Taker(*Ptr<byte*>(header + 320)) == null {
            return
        }

        *Ptr<long>(header + 448) = 3
        *Ptr<byte*>(header + 456) = line
        *Ptr<long>(header + 464) = count
        *Ptr<long>(header + 480) = 0
        *Ptr<long>(header + 504) = 0
        sys.Switch(header, threadSide)
    }
}

// The crash of the actor whose state is `state` in its activation `header`, on the scheduler's stack
// (U19): its id, its place and the text below its error line, as the header holds them (`CrashActor`),
// taken by the policies above it (`Fell`), with the value a `throw` named (`Thrown`) and, but for a stack
// overflow, which its header marks (`ActorOverflow`) and whose switch left from the stack of the fault's
// handler, the stack that raised, which a block keeps for the trace of a crash it escalates to the top-level
// code (U29, U25).
void Crashed(byte* state, byte* header) {
    mut bool hasText = false
    mut byte* id = null
    mut long idCount = 0
    mut byte* file = null
    mut long fileCount = 0
    mut long line = 0
    mut byte* text = null
    mut long count = 0
    raw {
        hasText = *Ptr<long>(header + 448) == 2
        id = *Ptr<byte*>(header + 456)
        idCount = *Ptr<long>(header + 464)
        file = *Ptr<byte*>(header + 472)
        fileCount = *Ptr<long>(header + 480)
        line = *Ptr<long>(header + 488)
        text = *Ptr<byte*>(header + 496)
        count = *Ptr<long>(header + 504)
        if !hasText {
            thrownNumber = 0
        }

        raising = null
        if *Ptr<long>(header + 448) != 3 {
            raising = header
        }
    }

    Fell(state, header, hasText, id, idCount, file, fileCount, line, text, count)
}

// The crash of the actor whose state is `state`, `header` its top activation, null where it has none,
// with the id `id`, `idCount` bytes, its place, and, where `hasText` holds, the text below the error line,
// `count` bytes at `from` (U19). The actor that takes the crash is found first (`Taker`): where it is the
// top-level code, the process ends with that error line (`Ends`). The text is copied into the heap of the
// supervisor of the actor that takes it, as the taken points of comment 6899225864 have it; then the actor
// falls (`Fall`), and after it each supervisor its policy crashes on the way up, `escalate` passing the
// crash up whole, and an actor whose constructor runs at its `spawn` passing it to its spawner, whose fall
// ends it (U3, U25). The actor that takes the crash writes the log line (U24), the supervisor that escalated
// writing none (nor does a test's own actor, whose crash's words the test runner keeps, `TestCrashKept`; Y5), and
// restarts after its pause (U22, U23), or ends where its policy is `stop`, where it was to
// end after its current message or where its supervisor crashed (U25); where its crash passes the limit of
// its `max N in`, its supervisor crashes with `restart-limit` at the line of its `spawn` (U26), and it ends in
// that fall, as a child with no activation, its own fall having cleared it, which `EndChildren` ends at once,
// a call queued to it set `gone`; at the top level the process ends; but the one actor of a `per node` type,
// whose knobs hold 1 at 80, which ends there as at a `stop`, with no `restart-limit`, so that the first message
// to its name after that starts a fresh one (U54; section 6, the owner, 2026-11-17, #561, comment 6945857315, Q2;
// assumed: the one actor of a `per node` type read as the key of that answer, the product pass, comment 6983506072).
// Where the actor that takes the crash runs and its policy is a block, the crash, the thrown value among it,
// is copied into that heap, the actor waits for the block's decision, its stack that raised kept, and the
// block runs as a message of its supervisor, or in the wait of the top-level code (`Pending`; U28, U33).
void Fell(byte* state, byte* header, bool hasText, byte* id, long idCount, byte* file, long fileCount, long line, byte* from, long count) {
    mut long number = 0
    mut byte* slot = null
    mut byte* copy = null
    mut byte* kept = null
    raw {
        number = thrownNumber
        slot = thrownSlot
        copy = thrownCopy
        kept = raising
        thrownNumber = 0
        raising = null
    }

    byte* taker = Taker(state)
    if taker == null {
        Ends(hasText, id, idCount, file, fileCount, line, from, count)
    }

    raw {
        int life = *Ptr<int>(taker - 88)
        byte* parent = *Ptr<byte*>(taker - 72)
        mut byte* above = null
        if parent != null {
            above = *Ptr<byte*>(parent - 64)
        }

        byte* policy = *Ptr<byte*>(taker - 80)
        if policy == taker {
            // U46, U50: the child of an `attempt`, whose policy word names its own state (`AttemptNew`): the crash's
            // copy, the thrown value's among it, made in the heap of the parent as a block's is (`Pending`), in the
            // reply of the child's one message before its fall sets that reply `callee crashed`, which wakes the
            // parent (`Attempted`); the log line written as the crash reaches the parent, and the child ended, its
            // heap and its stacks freed as a stopped actor's are
            byte* message = Pending(taker, above, null, header, hasText, id, idCount, file, fileCount, line, from, count, number, slot, copy)
            byte* reply = *Ptr<byte*>(*Ptr<byte*>(*Ptr<byte*>(taker - 8) + 328) + 16)
            if reply != null {
                *Ptr<byte*>(reply + 88) = message
            }

            Fall(state, header, null)
            mut byte* up = state
            while up != taker {
                up = *Ptr<byte*>(up - 72)
                Fall(up, *Ptr<byte*>(up - 8), null)
            }

            BlockLogged(message)
            EndActor(taker)
            return
        }

        if life == 0 && policy != null && *Ptr<byte*>(policy + 56) != null {
            byte* message = Pending(taker, above, kept, header, hasText, id, idCount, file, fileCount, line, from, count, number, slot, copy)
            Fall(state, header, kept)
            mut byte* up = state
            while up != taker {
                up = *Ptr<byte*>(up - 72)
                Fall(up, *Ptr<byte*>(up - 8), null)
            }

            *Ptr<int>(taker - 88) = 5
            Post(parent, message)
            return
        }

        byte* what = Copied(id, idCount, above)
        mut byte* text = null
        if count > 0 {
            text = AllocateIn(above, count)
            mut long i = 0
            while i < count {
                text[i] = from[i]
                i = i + 1
            }
        }

        Fall(state, header, null)
        mut byte* at = state
        while at != taker {
            byte* up = *Ptr<byte*>(at - 72)
            Fall(up, *Ptr<byte*>(up - 8), null)
            at = up
        }

        if taker == testActor {
            TestCrashKept(what, idCount, file, fileCount, line, hasText, text, count)
        } else {
            Logged(taker, what, idCount, file, fileCount, line, hasText, text, count)
        }

        if what != null {
            std.Free(what, idCount)
        }

        if text != null {
            std.Free(text, count)
        }

        byte* side = *Ptr<byte*>(taker - 80)
        if side == null {
            EndActor(taker)
            return
        }

        byte* knobs = *Ptr<byte*>(side + 48)
        if knobs != null && Limited(knobs, above, PauseClock()) {
            if *Ptr<long>(knobs + 80) == 1 {
                EndActor(taker)
                return
            }

            if parent == null {
                Ends(false, "restart-limit".Pointer, 13, *Ptr<byte*>(knobs + 56), *Ptr<long>(knobs + 64), *Ptr<long>(knobs + 72), null, 0)
            }

            Fell(parent, *Ptr<byte*>(parent - 8), false, "restart-limit".Pointer, 13, *Ptr<byte*>(knobs + 56), *Ptr<long>(knobs + 64), *Ptr<long>(knobs + 72), null, 0)
            return
        }

        Pause(taker)
    }
}

// The actor that takes the crash of the actor whose state is `state` (U25): the first, from it up through
// its supervisors, whose own policy restarts or stops it, or which ends after its current message or ended;
// null where the top-level code takes it. An actor whose policy is `escalate` passes its crash to its
// supervisor, which crashes too, and so does one whose constructor runs at its `spawn`, whose crash is the
// spawner's (U3).
byte* Taker(byte* state) {
    raw {
        mut byte* at = state
        while at != null {
            int life = *Ptr<int>(at - 88)
            byte* side = *Ptr<byte*>(at - 80)
            if life != 4 && (life != 0 || side == null || *Ptr<byte*>(side) != null) {
                return at
            }

            at = *Ptr<byte*>(at - 72)
        }

        return null
    }
}

// The end of the process at a crash that the top-level code takes from the scheduler's side, while it
// waits (U25, U26): the error line of the id `id` at its place, with the text below it where `hasText`
// holds, `count` bytes at `text`, the trace of the calls of the top-level code that waits, and the exit
// code 1, as `Raise` and `Throw` end it at a raise of the top-level code.
void Ends(bool hasText, byte* id, long idCount, byte* file, long fileCount, long line, byte* text, long count) {
    string what = TextAt(id, idCount)
    string place = TextAt(file, fileCount)
    string below = TextAt(text, count)
    sys.Crashing()
    WriteError("error: ")
    WriteError(what)
    if fileCount > 0 {
        WriteError(" at ")
        WriteError(place)
        WriteError(":")
        WriteNumber(ulong(line))
    }

    if hasText {
        WriteError(":\n")
        WriteError(below)
    }

    WriteError("\n")
    sys.Trace()
    sys.Exit(1)
}

// The fall of the actor whose state is `state` at its crash, `header` its top activation, null where it
// has none (U19, U21). Each activation of the actor, from the top down, has its open copy sessions ended
// (`CopyAbort`); where it waits, its reply leaves the timers (`TimerRemove`); where its reply's word is 0, which
// a wait that its deadline ended leaves (`Wait`), the reply is taken off the message it waits on by
// the swap the callee takes it by (`ReplyTaken`), so that the callee runs to its end and its reply goes
// nowhere, and where the callee took it first, the callee owns it and writes into the activation's frame,
// whose stack stays out of the pool while the word is 0, but for the reply of a sleep, which names no message
// and is only taken off the timers (`Slept`; S28); the call it runs, whose reply it takes the same
// way, is answered `callee crashed`, which wakes its caller (U20); and its stack goes back to the pool. The
// heaps of their own of the messages the actor's code was building are freed (`MessageHeapNew`). The calls
// of the top activation's side list go to the front of the inbox, which is kept, the crashing message
// dropped (U21), and the actor's children end after their current message (U13). The inbox's messages are
// copied into a new heap, each by the function its call site's table names, and the actor's heap is freed
// whole but for its first block (`Emptied`). The stack of the activation `kept`, the one that raised, stays
// out of the pool while a block decides (U29, U25). A block that runs in an activation of the actor, whose throw
// is the actor's crash, writes the log line of its child as a `stop` does (U32; assumed: S10 of comment
// 6907441402), and a block that waits in the inbox is dropped, with no line, its child ended with the actor's
// other children (U34; assumed: S11 of that comment).
void Fall(byte* state, byte* header, byte* kept) {
    Moved(state)
    raw {
        *Ptr<int>(state - 88) = 1
        mut byte* sideFirst = null
        mut byte* sideLast = null
        if header != null {
            sideFirst = *Ptr<byte*>(header + 376)
            sideLast = *Ptr<byte*>(header + 384)
        }

        mut byte* at = header
        while at != null {
            while *Ptr<byte*>(at + 440) != null {
                byte* session = *Ptr<byte*>(at + 440)
                CopyAbort(session)
                if *Ptr<byte*>(at + 440) == session {
                    *Ptr<byte*>(at + 440) = *Ptr<byte*>(session + 72)
                }
            }

            byte* waited = *Ptr<byte*>(at + 360)
            if waited != null {
                TimerRemove(waited)
            }

            // a call on a socket that waits in the poller (`SocketWaited`): its wait taken out of its descriptor's list and the
            // registration set to the waits left (`Unwait`), so that no event writes the block, which the fall frees with the heap;
            // a sleep's block (`Park`) holds 0 at 40
            if waited != null && *Ptr<byte*>(at + 432) == null && *Ptr<long>(waited + 40) > 0 {
                Unwait(int(*Ptr<long>(waited + 40) - 1), waited)
                polled = polled - 1
            }

            // a call handed to the pool of threads for blocking calls (`BlockingWaited`): its wait taken out of `handedWaits` and its
            // job dropped, which the pool's thread makes to its end in the job's own bytes and the scheduler gives back once it is
            // done (`PoolDrain`), or given back here where the wait's word is set, the job's end taken before the fall
            // (`PoolDrain`, `PoolLost`)
            if waited != null && *Ptr<byte*>(at + 432) == null && *Ptr<long>(waited + 40) == -1 {
                HandedOut(waited)
                byte* job = *Ptr<byte*>(waited + 48)
                if *Ptr<long>(waited) == 0 {
                    *Ptr<byte*>(job + 24) = null
                } else {
                    sys.JobDropped(job)
                }

                polled = polled - 1
            }

            // the wait of `Drive` for its child (`ManyWaited`): each of its waits whose event did not come taken out of its
            // descriptor's list (`ManyUnwait`), so that no event writes a block the fall frees with the heap, and then the call's
            // pipes to the child, the descriptor of its process and its memory given back (`sys.ChildDropped`)
            if waited != null && *Ptr<byte*>(at + 432) == null && *Ptr<long>(waited + 40) == -2 {
                ManyUnwait(waited)
                sys.ChildDropped(*Ptr<byte*>(waited + 64))
                polled = polled - 1
            }

            if waited != null && ReplyState(waited) == 0 && *Ptr<byte*>(at + 432) != null && ReplyTaken(*Ptr<byte*>(at + 432)) == null {
                while ReplyState(waited) == 0 {
                }
            }

            byte* taken = *Ptr<byte*>(at + 328)
            byte* reply = ReplyTaken(taken)
            if reply != null {
                Signal(reply, 2)
            }

            if *Ptr<byte*>(taken + 8) == BlockTable() {
                if *Ptr<long>(taken + 176) == 0 {
                    BlockLogged(taken)
                }

                BlockLeft(taken)
            }

            byte* below = *Ptr<byte*>(at + 368)
            if at != kept {
                Give(at)
            }

            at = below
        }

        mut byte* built = messageHeaps
        while built != null {
            byte* following = *Ptr<byte*>(std.HeapFirst(built))
            if *Ptr<byte*>(std.HeapFirst(built) + 16) == state {
                MessageHeapFree(built)
            }

            built = following
        }

        *Ptr<byte*>(state - 8) = null
        if sideFirst != null {
            *Ptr<byte*>(sideLast) = *Ptr<byte*>(state - 32)
            if *Ptr<byte*>(state - 32) == null {
                *Ptr<byte*>(state - 24) = sideLast
            }

            *Ptr<byte*>(state - 32) = sideFirst
        }

        EndChildren(state)
        byte* heap = std.HeapNew(0)
        if heap == null {
            AllocationFailed(0)
        }

        mut byte* m = *Ptr<byte*>(state - 32)
        *Ptr<byte*>(state - 32) = null
        *Ptr<byte*>(state - 24) = null
        while m != null {
            byte* next = *Ptr<byte*>(m)
            if *Ptr<byte*>(m + 8) == BlockTable() {
                BlockLeft(m)
                m = next
                continue
            }

            extern "C" (byte*, byte*) => byte* copy = *Ptr<extern "C" (byte*, byte*) => byte*>(*Ptr<byte*>(m + 8) + 8)
            byte* moved = copy(m, heap)
            byte* reply = *Ptr<byte*>(moved + 16)
            if reply != null && *Ptr<byte*>(reply + 8) != null {
                *Ptr<byte*>(*Ptr<byte*>(reply + 8) + 432) = moved
            }

            *Ptr<byte*>(moved) = null
            Append(state - 32, moved)
            m = next
        }

        Emptied(state)
        *Ptr<byte*>(state - 64) = heap
    }
}

// Whether the crash at `now` of the actor whose block of its knobs is `knobs` passes the limit of its
// `max N in <duration>`, N at 8 of the block and the window at 16, where N is not 0 (U26): the times of its
// crashes in the window, older ones dropped first, as Erlang's `supervisor` keeps the times of its restarts
// in its period and keeps one that falls at its start (`add_restart`), so that the crash passes the limit
// where N of them still stand; else its time joins them. The times stand in a ring in the heap `heap`, the
// supervisor's, its address at 24, its slots at 32, its first at 40 and its count at 48, which grows by
// doubling up to N slots, so that it holds no more times than the crashes in the window.
bool Limited(byte* knobs, byte* heap, long now) {
    raw {
        long max = *Ptr<long>(knobs + 8)
        if max == 0 {
            return false
        }

        mut byte* ring = *Ptr<byte*>(knobs + 24)
        mut long slots = *Ptr<long>(knobs + 32)
        mut long head = *Ptr<long>(knobs + 40)
        mut long count = *Ptr<long>(knobs + 48)
        long oldest = now - *Ptr<long>(knobs + 16)
        while count > 0 && *Ptr<long>(ring + head * 8) < oldest {
            head = (head + 1) % slots
            count = count - 1
        }

        *Ptr<long>(knobs + 40) = head
        *Ptr<long>(knobs + 48) = count
        if count >= max {
            return true
        }

        if count == slots {
            mut long grown = slots * 2
            if grown < 4 {
                grown = 4
            }

            if grown > max {
                grown = max
            }

            byte* larger = AllocateIn(heap, grown * 8)
            mut long i = 0
            while i < count {
                *Ptr<long>(larger + i * 8) = *Ptr<long>(ring + (head + i) % slots * 8)
                i = i + 1
            }

            if ring != null {
                std.Free(ring, slots * 8)
            }

            ring = larger
            slots = grown
            head = 0
            *Ptr<byte*>(knobs + 24) = ring
            *Ptr<long>(knobs + 32) = slots
            *Ptr<long>(knobs + 40) = 0
        }

        *Ptr<long>(ring + (head + count) % slots * 8) = now
        *Ptr<long>(knobs + 48) = count + 1
        return false
    }
}

// The heap of the actor whose state is `state` freed whole but for its first block, the record and the
// state, which stays in the first page of the heap it was made in, so that the actor's reference names the
// same actor after its restart (U2, U21): a heap made since then freed, and that first heap emptied but for
// its first page (`HeapReset`), which then holds no other block.
void Emptied(byte* state) {
    raw {
        byte* heap = *Ptr<byte*>(state - 64)
        if heap != state - 192 {
            std.HeapFree(heap)
        }

        std.HeapReset(state - 192)
        *Ptr<byte*>(state - 64) = state - 192
    }
}

// The end of the actor whose state is `state`, which has no activation (U13): it waits for no restart,
// each message of its inbox is dropped, a call's reply taken (`ReplyTaken`) and set `gone`, and a block that
// waits there with its
// child's stack (U34), its children end, its slot of the table is freed, so that a call or a `send` that still
// names it raises `actor-gone` (U6, U20), and its heap is freed whole, the first page, which holds its record,
// at once (design record, section 6, the owner, 2026-11-16, #519, comment 6919351399), or, where it stands in
// the run queue, when the scheduler takes it off (`RunOne`), or, where a thread holds it, when that thread lets
// go of it (`LetGo`) (section 6, both assumed there).
void EndActor(byte* state) {
    Moved(state)
    raw {
        if *Ptr<int>(state - 88) == 1 {
            Unpause(state)
        }

        *Ptr<int>(state - 88) = 3
        *Ptr<byte*>(state - 80) = null
        mut byte* m = *Ptr<byte*>(state - 32)
        while m != null {
            byte* reply = ReplyTaken(m)
            if reply != null {
                Signal(reply, 3)
            }

            if *Ptr<byte*>(m + 8) == BlockTable() {
                BlockLeft(m)
            }

            m = *Ptr<byte*>(m)
        }

        *Ptr<byte*>(state - 32) = null
        *Ptr<byte*>(state - 24) = null
        EndChildren(state)
        Emptied(state)
        SlotFree(*Ptr<long>(state - 56))
        if (StateWord(state).Load(MemoryOrder.Acquire) & 3) == 0 {
            std.HeapFree(state - 192)
        }
    }
}

// Each child of the actor whose state is `state`, each actor of the table its code spawned, from the highest
// index down, ended at once where it has no activation, and else after its current message, with no restart
// left to it and no supervisor, whose record its own end may free first, so that its crash is taken by its own
// end (`Taker`) (U13; design record, section 6, assumed there). One actor acts on another through the other's
// state word, or under its hold (design record, section 6, the default for the acts of one actor on another):
// the child's ENDING bit set by one atomic `or`, which its holder reads where its last activation ends (`Run`,
// `Ending`), as tokio's `abort` sets a bit of the task's state (not checked at source); then, held as a restart
// holds an actor (`HeldAlone`), the child, where its holder did not end it meanwhile, ended at once or its policy
// and its supervisor cleared, and let go (`LetGo`), which frees the record of a child that ended where no entry of
// it stands in the run queue. The child whose crash the thread takes is held by the thread already (`holding`),
// and acted on under that hold, which `Run` lets go of once the crash was taken. Three of these acts hold while
// one thread runs every program (U35), and not on more than one: the test of which actors are children reads the
// child's supervisor and its life by plain loads before any hold, and reads only the life again under it; the bit
// is set before the hold, so that the child's holder could end the child and its `LetGo` free the record this
// thread then holds; and the thread that takes a child's crash holds that child and then each of its siblings,
// so that two threads that each hold one sibling would each wait on the other's hold.
void EndChildren(byte* state) {
    raw {
        mut long index = SlotsUsed() - 1
        while index >= 0 {
            byte* at = SlotState(index)
            if at != null {
                if *Ptr<byte*>(at - 72) == state && *Ptr<int>(at - 88) != 3 {
                    StateWord(at).FetchOr(16, MemoryOrder.AcqRel)
                    if at != holding {
                        HeldAlone(at)
                    }

                    if *Ptr<int>(at - 88) != 3 {
                        if *Ptr<byte*>(at - 8) == null {
                            EndActor(at)
                        } else {
                            *Ptr<byte*>(at - 80) = null
                            *Ptr<byte*>(at - 72) = null
                        }
                    }

                    if at != holding {
                        LetGo(at, false)
                    }
                }
            }

            index = index - 1
        }
    }
}

// The pause before the restart of the actor whose state is `state` (U23), as the record has it: 100 ms,
// or the first pause its `after` sets, which the block of its knobs holds (U26), and which holds 100 ms where
// `max N in` alone is written (the emitter's `Knobs`), at its first crash, and at each crash after it twice
// the one before, up to 30 s, where it crashes before it ran 30 s since its last restart, else that first
// pause again; each varied at random by up to 20% either way,
// drawn from the thread's generator, as Akka's `BackoffSupervisor` varies its pause by its random factor.
// The block of the restart holds the pause, the time of the last restart, the time the pause ends and the
// next actor of the queue of the pauses, in which the actor waits by that time.
void Pause(byte* state) {
    raw {
        byte* side = *Ptr<byte*>(state - 80)
        long now = PauseClock()
        mut long pause = *Ptr<long>(side + 16)
        if pause == 0 || now - *Ptr<long>(side + 24) >= 30000000000 {
            pause = 100000000
            byte* knobs = *Ptr<byte*>(side + 48)
            if knobs != null {
                pause = *Ptr<long>(knobs)
            }
        } else {
            pause = pause * 2
            if pause > 30000000000 {
                pause = 30000000000
            }
        }

        *Ptr<long>(side + 16) = pause
        long span = pause / 5
        long varied = long(NextChainWord(Generator()) % ulong(2 * span + 1)) - span
        long due = now + pause + varied
        *Ptr<long>(side + 32) = due
        Lock(PauseLock())
        mut byte* before = null
        mut byte* at = paused
        while at != null && *Ptr<long>(*Ptr<byte*>(at - 80) + 32) <= due {
            before = at
            at = *Ptr<byte*>(*Ptr<byte*>(at - 80) + 40)
        }

        *Ptr<byte*>(side + 40) = at
        if before == null {
            paused = state
        } else {
            *Ptr<byte*>(*Ptr<byte*>(before - 80) + 40) = state
        }

        Unlock(PauseLock())
    }
}

// The actor whose state is `state` taken off the queue of the pauses.
void Unpause(byte* state) {
    raw {
        Lock(PauseLock())
        mut byte* before = null
        mut byte* at = paused
        while at != null && at != state {
            before = at
            at = *Ptr<byte*>(*Ptr<byte*>(at - 80) + 40)
        }

        if at != null {
            byte* after = *Ptr<byte*>(*Ptr<byte*>(state - 80) + 40)
            if before == null {
                paused = after
            } else {
                *Ptr<byte*>(*Ptr<byte*>(before - 80) + 40) = after
            }
        }

        Unlock(PauseLock())
    }
}

// The hold of the actor whose state is `state` by a thread that takes it outside the run queue, a restart's
// (`Restart`): RUNNING set by a compare-exchange from a word in which no thread holds it, made again on what it
// found, and waited for where a take holds it, which lets go at once of an actor that waits for its restart
// (`RunOne`), as tokio's `transition_to_running` refuses a task that another worker runs (not checked at
// source), so that no two threads hold one actor.
void HeldAlone(byte* state) {
    AtomicInt word = StateWord(state)
    mut int seen = 0
    raw {
        seen = word.Load(MemoryOrder.Acquire)
    }

    mut bool stored = false
    while !stored {
        if (seen & 1) == 0 {
            int found = Exchanged(word, seen, seen | 1)
            stored = found == seen
            seen = found
        } else {
            raw {
                seen = word.Load(MemoryOrder.Acquire)
            }
        }
    }
}

// The restart of the actor whose state is `state`, which its pause's end took off the queue of the pauses
// (`PauseEnded`) (U22): its constructor run again in an activation of its own, before any message of its inbox, on a
// copy of the kept arguments of its `spawn` (section 6, Q13), by the function the first word of the block of
// its restart names, which takes the block as a message's table and the actor's heap, in a message with a
// chain of its own and no deadline (U45; assumed: T9 of comment 6967625156); the runtime runs it,
// and no message of the supervisor does (section 6, assumed there), the thread holding the actor (RUNNING in
// its state word, `HeldAlone`) outside the run queue, where an entry of it can still stand, before the actor
// runs again. A crash there is the actor's own (U3). The take off the queue of the pauses lets go of that
// queue's lock before this hold, and the life is not read again under it, which holds while one thread runs
// every program (U35): on more than one, the end of the actor's supervisor could end and free it in that gap.
// Its state word says REBUILDING from before the activation starts to the end of the constructor (`Rebuilt`), so
// that a call of the restart's chain that reaches the actor meanwhile waits in its inbox (`Moved`; U22; section
// 6, the owner, 2026-11-20, #599, comment 7051501153, "Option 1"); a crash of the constructor leaves the bit set,
// which `Moved` reads only while the actor has an activation, and a crashed actor has none: it waits for a restart,
// which sets the bit again, or it ends.
void Restart(byte* state) {
    HeldAlone(state)
    raw {
        StateWord(state).FetchOr(32, MemoryOrder.AcqRel)
        byte* side = *Ptr<byte*>(state - 80)
        *Ptr<int>(state - 88) = 0
        *Ptr<long>(side + 24) = PauseClock()
        byte* message = AllocateIn(*Ptr<byte*>(state - 64), 56)
        *Ptr<byte*>(message) = null
        *Ptr<byte*>(message + 8) = side
        *Ptr<byte*>(message + 16) = null
        NewChain(message + 24)
        *Ptr<long>(message + 40) = Never()
        *Ptr<long>(message + 48) = 0
        Start(state, message, null)
    }
}

// The end of the constructor of the actor whose state is `state` at its restart, which the function of its restart
// calls once the constructor and the defaults of its body ran (U22): its state word clears REBUILDING by one atomic
// `and`, so that a call of its chain gets in again where layer 1 lets it in (`Moved`; U17).
pub void Rebuilt(byte* state) {
    raw {
        StateWord(state).FetchAnd(~32, MemoryOrder.AcqRel)
    }
}

// The clock every pause and every deadline reads (U23, U36): the system's monotonic clock, in nanoseconds, with the offset that
// `advance` added in a test (`ahead`; Y10), 0 where it cannot be read.
long PauseClock() {
    mut long now = 0
    if !sys.MonotonicNow(mut now) {
        return 0
    }

    raw {
        return now + ahead
    }
}

// The offset that `advance` adds to the runtime's clock in a test, in nanoseconds (Y10, section 11): `PauseClock`, the program's
// `instant.Now` and `timestamp.Now` and the time stamp of a crash's log line read it in the build `kurz test` makes, and only that
// build writes it, through `Advance` and at each test's end (`TestEnded`; F6 of issue 586, comment 6993110710), so that in every
// other build nothing writes it and it stays 0, and the program's own reads of the clock read the system's alone (D8 of comment
// 6992687784). The build runs the actors on one thread (U35, compiler/README.md), so that no read of it races the write of
// `Advance` and a plain word holds it.
static mut long ahead = 0

// `advance d` (Y10, section 11): the runtime's clock moved by `nanoseconds`, zero or more, which the emitted code checked; false where
// the monotonic or the wall clock it moves would come within a year of the end of a `long`'s range, so that a clock that keeps running
// for a year after it reads no value past that range (Y10, assumed), which the emitted code raises as `overflow` at the statement
// (section 4), the offset left as it was and nothing parked. The timers and the pauses the moved clock passed fire at the scheduler's turn after it, in the order of their
// deadlines (F12 of comment 6993110710): the test's actor parks to the moved clock, after every timer whose deadline is not later
// (`Park`), so that the actors they wake run before it goes on, as tokio's `time::advance` yields once after it moves the clock.
pub bool Advance(long nanoseconds) {
    mut long wall = 0
    if !sys.Now(mut wall) {
        wall = 0
    }

    mut long now = 0
    if !sys.MonotonicNow(mut now) {
        now = 0
    }

    if now > wall {
        wall = now
    }

    raw {
        if nanoseconds > 9223372036854775807 - 31536000000000000 - wall - ahead {
            return false
        }

        ahead = ahead + nanoseconds
    }

    Park(PauseClock())
    return true
}

// The offset of `ahead`, which the build `kurz test` adds to the program's reads of the clock (Y10).
pub long Ahead() {
    raw {
        return ahead
    }
}

// The wait of the scheduler that has nothing to run, `nanoseconds` from now (`RootLoop`): a wait in the poller where a
// registration waits (`polled`, `Polled`), so that a descriptor's event ends it as the deadline does (section 6, the scheduler
// that runs out of work waits on the poller; issue 658), the sleep of `PauseSleep` otherwise.
void IdleWait(long nanoseconds) {
    raw {
        if polled > 0 {
            Polled(nanoseconds)
            return
        }
    }

    PauseSleep(nanoseconds)
}

// The sleep of the top-level code until a restart's pause ends, or a deadline before it passes, `nanoseconds`
// from now (U23, U36).
void PauseSleep(long nanoseconds) {
    sys.Sleep(nanoseconds)
}

// The log line of the crash of the actor whose state is `state` (U24): `<time> Error Kurz.Actor:
// <Type>#<n> crashed: <id>`, then the text that stands below the error line, a thrown value's, in double
// quotes as a `string` field is written (P7), and the place, ` at <file>:<n>`, as the error line of a `throw`
// at the root carries them, `Counter#3 crashed: thrown "no stock" at shop.kz:12`; for a stack overflow the
// id and the place as its error line writes them. One line at `Error` through the runtime's writer, where
// the filter leaves `Kurz.Actor` on at `Error` (P4), with no chain ID while P8 is open. The fields after the id are `CrashFields`'s,
// which the crash of a test's own actor keeps for the line under its `FAILED` in place of this line (`TestCrashKept`; Y3, Y5).
void Logged(byte* state, byte* id, long idCount, byte* file, long fileCount, long line, bool hasText, byte* text, long count) {
    if !LogEnabled("Kurz.Actor", 4) {
        return
    }

    mut string name = ""
    mut string what = ""
    mut long number = 0
    raw {
        byte* written = *Ptr<byte*>(state - 96)
        name = TextAt(*Ptr<byte*>(written), *Ptr<long>(written + 8))
        what = TextAt(id, idCount)
        number = *Ptr<long>(state - 40)
    }

    mut long now = 0
    if !sys.Now(mut now) {
        now = 0
    }

    raw {
        now = now + ahead
    }

    LogLine(4, "Kurz.Actor", "{name}#{number} crashed: {what}", CrashFields(file, fileCount, line, hasText, text, count), now)
}

// The fields of the log line of a crash after its id (U24): where `hasText` holds, the text that follows its error line, `count` bytes at
// `text`, in double quotes as a `string` field is written (P7), then its place, ` at <file>:<n>`, where it has one, `fileCount` bytes
// at `file` and the line `line`.
string CrashFields(byte* file, long fileCount, long line, bool hasText, byte* text, long count) {
    mut string place = ""
    mut string thrown = ""
    raw {
        place = TextAt(file, fileCount)
        thrown = TextAt(text, count)
    }

    mut string fields = ""
    if hasText {
        fields = " {LogQuoted(thrown)}"
    }

    if fileCount > 0 {
        fields = "{fields} at {place}:{line}"
    }

    return fields
}

// ---- the block of `on crash` (chapter 19, U28 to U34) ---------------------------------------------------

// A block that decides, `on crash (c) { ... }`, runs as a message of the supervisor, after its current
// message and before its queued ones, and at a `spawn` of the top-level code in the top-level code's wait
// (design record, section 6, Q2 of comment 6902210646; the owner, 2026-11-16, #519, comment 6919351399,
// "Root's wait runs it"), as Akka's `Failed` system message reaches the supervisor before its mailbox. The
// emitted `throw` names the value it throws first (`Thrown`), which the crash's copy brings into the
// supervisor's heap, and the block's decision is a word the emitted `restart`, `stop` and `escalate` set
// (`Decide`).

// The value of the `throw` that runs: the number of its type in the program, one more, 0 for none, the
// slot that holds it and the emitted function that copies it into a heap, read where the crash is taken
// (`Fell`), and the stack that raised, which a block keeps (`Crashed`).
thread static mut long thrownNumber = 0
thread static mut byte* thrownSlot = null
thread static mut byte* thrownCopy = null
thread static mut byte* raising = null

// The decision of the block that runs: 1 `restart`, 2 `stop`, 3 `escalate`.
thread static mut long decision = 0

// The blocks the top-level code's wait runs, in the order of the crashes, a list as an inbox is (`Append`),
// in the own heap of the thread that posted the first, null until then, which a thread's `Post` changes and the
// main thread's wait takes from under the lock of the root's blocks (`RootLock`), so that a block posted on any
// thread reaches the main thread at its following turn, since `Post` wakes nothing for the top-level code, a null
// parent; the one that runs there, null where none does; and the block whose escalation
// ends the process on the stack its child raised on (`Escalate`).
static mut byte* rootBlocks = null
thread static mut byte* rootRunning = null
thread static mut byte* escalated = null

// The value a `throw` throws, of the type numbered `number` in the program, in the slot `slot`, and the
// function `copy` that copies it into a heap (U30), which the emitted code names before `Throw` where a block
// of the program reads a `Reason` with that type.
pub void Thrown(long number, byte* slot, byte* copy) {
    raw {
        thrownNumber = number + 1
        thrownSlot = slot
        thrownCopy = copy
    }
}

// The decision of the block that runs, `word`: 1 `restart`, 2 `stop`, 3 `escalate` (U29).
pub void Decide(long word) {
    raw {
        decision = word
    }
}

// The message of the block of the policy of the actor whose state is `taker`, made in the heap `above`
// of its supervisor (U28): the message after it, the blocks' table, no reply, a chain of its own, as a
// restart's message has (U34; assumed: S11 of comment 6907441402), with no deadline and no block's (U45;
// assumed: T9 of comment 6967625156), the actor, its stack that raised, `kept`,
// null for none, then a copy of the crash's id and its count, the file, a constant of the emitted code, and
// its count, the line, whether the text stands below the error line, a copy of the text and its count, the
// chain of the activation `header` that crashed, the number of the thrown value's type, one more, 0 for none,
// the copy of that value, made by `copy` from `slot`, null where `copy` is null, as for a thrown `null`,
// which holds no value, and that copy's function, and whether the block escalated the crash (`Escalate`),
// 184 bytes.
byte* Pending(byte* taker, byte* above, byte* kept, byte* header, bool hasText, byte* id, long idCount, byte* file, long fileCount, long line, byte* from, long count, long number, byte* slot, byte* copy) {
    raw {
        byte* message = AllocateIn(above, 184)
        *Ptr<byte*>(message) = null
        *Ptr<byte*>(message + 8) = BlockTable()
        *Ptr<byte*>(message + 16) = null
        NewChain(message + 24)
        *Ptr<long>(message + 40) = Never()
        *Ptr<long>(message + 48) = 0
        *Ptr<byte*>(message + 56) = taker
        *Ptr<byte*>(message + 64) = kept
        *Ptr<byte*>(message + 72) = Copied(id, idCount, above)
        *Ptr<long>(message + 80) = idCount
        *Ptr<byte*>(message + 88) = file
        *Ptr<long>(message + 96) = fileCount
        *Ptr<long>(message + 104) = line
        *Ptr<long>(message + 112) = 0
        if hasText {
            *Ptr<long>(message + 112) = 1
        }

        *Ptr<byte*>(message + 120) = Copied(from, count, above)
        *Ptr<long>(message + 128) = count
        *Ptr<long>(message + 136) = 0
        *Ptr<long>(message + 144) = 0
        if header != null {
            *Ptr<long>(message + 136) = *Ptr<long>(header + 344)
            *Ptr<long>(message + 144) = *Ptr<long>(header + 352)
        }

        *Ptr<long>(message + 152) = number
        *Ptr<byte*>(message + 160) = null
        *Ptr<byte*>(message + 168) = copy
        *Ptr<long>(message + 176) = 0
        if number != 0 && copy != null {
            extern "C" (byte*, byte*) => byte* made = *Ptr<extern "C" (byte*, byte*) => byte*>(message + 168)
            mut byte* into = above
            if into == null {
                into = RootHeap()
            }

            *Ptr<byte*>(message + 160) = made(slot, into)
        }

        return message
    }
}

// The `count` bytes at `bytes` copied into the heap `heap`, null for none.
byte* Copied(byte* bytes, long count, byte* heap) {
    raw {
        if count == 0 {
            return null
        }

        byte* p = AllocateIn(heap, count)
        mut long i = 0
        while i < count {
            p[i] = bytes[i]
            i = i + 1
        }

        return p
    }
}

// The heap of the top-level code, the thread's own, which a copy of a crash crosses into where the
// top-level code's wait runs the block.
byte* RootHeap() {
    byte* before = std.HeapUse(null)
    byte* own = std.HeapCurrent()
    std.HeapUse(before)
    return own
}

// The message `message` of a block to the supervisor whose state is `parent`: on its queue of the blocks
// (`Pushed`), which its holder moves to the front of its inbox, after the blocks already there (`Moved`), so that
// it runs after the current message and before the queued ones in the order of the crashes, and the supervisor
// woken where it can run it (`Wake`; U28, U34), which its life says, read by a plain load after the push, as
// `Enqueue` reads it, and which holds while one thread runs every program (U35); for the top-level code, null, at
// the end of the blocks its wait runs (U33), which wakes nothing, so that the main thread's wait finds the block
// at its following turn.
void Post(byte* parent, byte* message) {
    raw {
        if parent == null {
            Lock(RootLock())
            if rootBlocks == null {
                rootBlocks = AllocateOwn(16)
                *Ptr<byte*>(rootBlocks) = null
                *Ptr<byte*>(rootBlocks + 8) = null
            }

            Append(rootBlocks, message)
            Unlock(RootLock())
            return
        }

        Pushed(parent - 120, message)
        int life = *Ptr<int>(parent - 88)
        if life != 1 && life != 3 && life != 5 {
            Wake(parent)
        }
    }
}

// The table of every block's message, one for the process, in the shared words, made with them (`SharedCleared`):
// the function that runs it, and no copy, since a block that waits in the inbox of an actor that crashes is
// dropped (`BlockLeft`).
byte* BlockTable() {
    raw {
        return Shared() + 32
    }
}

// The lock of the blocks the top-level code's wait runs.
int* RootLock() {
    raw {
        return Ptr<int>(Shared() + 16)
    }
}

// The first block the top-level code's wait runs, taken off its list, null where none stands.
byte* RootTaken() {
    mut byte* message = null
    raw {
        if sharedWords != null {
            Lock(RootLock())
            if rootBlocks != null && *Ptr<byte*>(rootBlocks) != null {
                message = Taken(rootBlocks)
            }

            Unlock(RootLock())
        }
    }

    return message
}

// The run of the block's message `message` in an activation of the supervisor whose state is `state`
// (`RunBlock`).
extern "C" void BlockRun(byte* state, byte* message) {
    RunBlock(message)
}

// The run of the block's message `message`, in an activation of the supervisor or in the top-level code's
// wait: the emitted function of the block, which the restart's block of the child names, builds `c` and runs
// the block, and the decision it set is acted on (`Decided`). The block's record stands at byte 56 of the
// child's side, its eighth word on every target, each 64-bit, where the emitter's `Deciding` writes it.
void RunBlock(byte* message) {
    raw {
        byte* child = *Ptr<byte*>(message + 56)
        byte* side = *Ptr<byte*>(child - 80)
        extern "C" (byte*, byte*) => void entry = *Ptr<extern "C" (byte*, byte*) => void>(*Ptr<byte*>(side + 56))
        decision = 0
        entry(side, message)
        Decided(child, message, decision)
    }
}

// The block `message` the top-level code's wait took off its list (`RootTaken`) run on the top-level code's
// stack (U33), with no deadline of a `within` block of the top-level code over its calls, as a block's
// message has none (U45; assumed: T9 of comment 6967625156).
void RootBlock(byte* message) {
    raw {
        byte* before = rootRunning
        long within = rootBlock
        rootRunning = message
        rootBlock = 0
        RunBlock(message)
        rootBlock = within
        rootRunning = before
    }
}

// The decision `word` of the block of the message `message` acted on for the actor whose state is
// `child`, as the words of a policy act (U29): `restart` restarts it after its pause and `stop` ends it,
// each after the crash's log line, written at the decision (U34; assumed: S10 of comment 6907441402), the
// stack it raised on given back to the pool and the message freed; the restart and the end alone run under the
// child's hold (`HeldAlone`, `LetGo`), as one actor acts on another (`EndChildren`); `escalate` crashes the
// supervisor (`Escalate`). The log line, which reads the child's record, the stack's return and the message's free
// come before that hold, which holds while one thread runs every program (U35): on more than one, a thread that
// ends the supervisor meanwhile with no hold of it, as a crash it takes ends it (`EndActor`), could end the child
// and free the record the log line reads (`EndChildren`; inferred).
void Decided(byte* child, byte* message, long word) {
    raw {
        if word == 3 {
            Escalate(message)
        }

        BlockLogged(message)
        BlockLeft(message)
        PendingLeft(message)
        HeldAlone(child)
        if word == 1 {
            *Ptr<int>(child - 88) = 1
            Pause(child)
        } else {
            EndActor(child)
        }

        LetGo(child, false)
    }
}

// The escalation of the crash of the block's message `message` (U25, U29): the crash of the supervisor
// whose activation runs the block, with the child's id, place, text and thrown value, as the child's crash
// would have passed up under `escalate`; where the top-level code takes it, the block running in its wait
// among it, the process ends with the child's error line and the trace of the stack the child raised on,
// switched back to (`EndsEscalated`), or of this one where none is kept (U29, U25; design record, section 6, the trace
// from the stack of the actor that raised).
void Escalate(byte* message) {
    raw {
        *Ptr<long>(message + 176) = 1
        byte* header = running
        byte* kept = *Ptr<byte*>(message + 64)
        if header == null || Taker(*Ptr<byte*>(header + 320)) == null {
            escalated = message
            if kept == null {
                EndsEscalated()
            }

            mut byte* from = header
            if from == null {
                from = threadSide
            }

            sys.StackGuard(kept + 512, *Ptr<long>(kept + 400))
            sys.Switch(from, kept)
        }

        BlockLeft(message)
        thrownNumber = *Ptr<long>(message + 152)
        thrownSlot = *Ptr<byte*>(message + 160)
        thrownCopy = *Ptr<byte*>(message + 168)
        *Ptr<long>(header + 448) = 1
        if *Ptr<long>(message + 112) != 0 {
            *Ptr<long>(header + 448) = 2
        }

        *Ptr<byte*>(header + 456) = *Ptr<byte*>(message + 72)
        *Ptr<long>(header + 464) = *Ptr<long>(message + 80)
        *Ptr<byte*>(header + 472) = *Ptr<byte*>(message + 88)
        *Ptr<long>(header + 480) = *Ptr<long>(message + 96)
        *Ptr<long>(header + 488) = *Ptr<long>(message + 104)
        *Ptr<byte*>(header + 496) = *Ptr<byte*>(message + 120)
        *Ptr<long>(header + 504) = *Ptr<long>(message + 128)
        sys.Switch(header, threadSide)
    }
}

// The end of the process at a crash that a block escalated to the top-level code (U29, U25): the error line of
// the crash, as the copy in the block's message holds it, the trace of the stack this runs on, and the exit
// code 1 (`Ends`).
void EndsEscalated() {
    raw {
        byte* m = escalated
        Ends(*Ptr<long>(m + 112) != 0, *Ptr<byte*>(m + 72), *Ptr<long>(m + 80), *Ptr<byte*>(m + 88), *Ptr<long>(m + 96), *Ptr<long>(m + 104), *Ptr<byte*>(m + 120), *Ptr<long>(m + 128))
    }
}

// The log line of the crash that the block's message `message` decides on, for its child (U24).
void BlockLogged(byte* message) {
    raw {
        Logged(*Ptr<byte*>(message + 56), *Ptr<byte*>(message + 72), *Ptr<long>(message + 80), *Ptr<byte*>(message + 88), *Ptr<long>(message + 96), *Ptr<long>(message + 104), *Ptr<long>(message + 112) != 0, *Ptr<byte*>(message + 120), *Ptr<long>(message + 128))
    }
}

// The stack the child of the block's message `message` raised on given back to the pool, once, where the
// message keeps one (U34).
void BlockLeft(byte* message) {
    raw {
        byte* kept = *Ptr<byte*>(message + 64)
        if kept != null {
            *Ptr<byte*>(message + 64) = null
            Give(kept)
        }
    }
}

// The chain ID of 16 bytes at `at` as the block reads it (U30): 32 lowercase hexadecimal digits, a byte's two
// in the order of the bytes, as OpenTelemetry writes a trace-id (assumed: S4 of comment 6907441402).
pub string ChainText(byte* at) {
    mut string text = ""
    raw {
        byte* p = string.Allocate(32)
        mut long i = 0
        while i < 16 {
            int b = int(at[i])
            p[i * 2] = std.HexDigit(b >> 4)
            p[i * 2 + 1] = std.HexDigit(b & 15)
            i = i + 1
        }

        text = string.FromRaw(p, 32)
    }

    return text
}

// The `count` bytes at `bytes` as a string of its own, which the emitted block of `on crash` reads too (U30).
pub string TextAt(byte* bytes, long count) {
    mut string text = ""
    if count == 0 {
        return text
    }

    raw {
        byte* p = string.Allocate(count)
        mut long i = 0
        while i < count {
            p[i] = bytes[i]
            i = i + 1
        }

        text = string.FromRaw(p, count)
    }

    return text
}

// The copies of the crash's id and text that the message `message` of a block or of an `attempt` holds, and the
// message itself, freed (`Pending`), once its block decided or its `Crashed` was read (U30, U46).
pub void PendingLeft(byte* message) {
    raw {
        long idCount = *Ptr<long>(message + 80)
        long count = *Ptr<long>(message + 128)
        if idCount > 0 {
            std.Free(*Ptr<byte*>(message + 72), idCount)
        }

        if count > 0 {
            std.Free(*Ptr<byte*>(message + 120), count)
        }

        std.Free(message, 184)
    }
}

// ---- the block `attempt { ... }` (chapter 19, U46 to U50) ----------------------------------------------

// The child actor of an `attempt` (U46), named `name` for the log line of its crash: an actor of its own heap
// and its pooled stack of 2 MiB, as a `spawn` without a `stack` clause makes one (U1), supervised by the actor
// that runs the code or by the top-level code (`Supervisor`), whose state of 64 bytes holds no field, and whose
// policy word names its own state, so that its crash is its own to take (`Taker`, whose test it passes as a
// `restart` passes it) and is taken as an `attempt` takes it (`Fell`); built at once, and ending after its first
// message (`Run`), as Erlang's `spawn_monitor` starts a process that ends with its function (not checked at
// source).
pub byte* AttemptNew(byte* name) {
    byte* heap = ActorHeapNew(64)
    byte* state = ActorNew(heap, 64, 2097152, null, name)
    raw {
        mut long word = 0
        while word < 64 {
            *Ptr<long>(state + word) = 0
            word = word + 8
        }

        *Ptr<long>(state) = 1
        *Ptr<byte*>(state - 80) = state
    }

    ActorBuilt(state)
    raw {
        StateWord(state).FetchOr(16, MemoryOrder.AcqRel)
    }

    return state
}

// The wait of the `attempt` whose child is `child` for the reply `reply` of the block's message `message`, at the
// line `line` of the file `file`, as a call waits (`Answer`; U49) but with no deadline of its own, the block's
// calls carrying the chain's (`Enqueue`): null where the block's value stands in the reply, and where the child
// crashed the message of its crash, which `Fell` set in the reply at 88 and which the emitted code reads `Crashed`
// from and frees (`PendingLeft`; U46, U50). A message dropped at its deadline, at its queueing (`Enqueue`) or
// before the child took it (`Dropped`), raises `call-timeout` at the line, a call's (U37), whose crash of the
// code that waits ends the child, a child of that code, as it ends every child (U13).
pub byte* Attempted(byte* reply, byte* message, string file, int line) {
    raw {
        *Ptr<long>(reply + 16) = Never()
    }

    int kind = Answer(reply, message, file, line)
    if kind == 1 {
        return null
    }

    if kind == 2 {
        raw {
            return *Ptr<byte*>(reply + 88)
        }
    }

    if kind == 3 {
        Raise("actor-gone", file, line)
    }

    Raise("call-timeout", file, line)
    return null
}

// ---- the stacks of actors (design record, section 6) ---------------------------------------------

// A message runs on a stack of the actor's own, reserved whole and given memory by the system as it is
// touched, with a guard page below it (section 6, "Own stack", "Keep guard page", "2 MiB + clause"): the
// size the actor's clause asked for, or 2 MiB, rounded up to the system's page and raised to the floor
// of 64 KiB with no message (U1; the owner, 2026-11-15, #519, comment 6892835500, Q7, "Rust/C#: round up
// silently"). A stack is held only while a message runs or waits in it, and then goes back to a pool of
// its thread, which keeps at most 64 stacks, each kept for a message that asks its size, and gives back a
// stack past that (section 6, "Only while running", "Bound pool + trim deep", and Q12 of comment
// 6880404917; the owner, 2026-11-15, #519, comment 6892812780, Q3, "Build it now", for the sizes); a stack
// that goes back to the pool has its pages past a depth of 64 KiB given back to the system where a
// message went past it (`StackTrim` of the target). A stack the system refuses ends the process with
// `error: allocation-failed (<n> bytes)`, the stack's size (section 6, 2026-10-09).
//
// At the stack's base, its highest addresses, 512 bytes hold its header, and the stack's frames start
// below it: from 0 the save area of the switch, where the switch keeps the registers of the stack's side
// it leaves, the stack pointer among them (the owner, 2026-11-15, #519, comment 6892812780, Q1, "Save area
// at stack base"), each architecture's layout of them its own (`Switch` of the architecture's directory),
// with the four words of the thread environment block at 288 on Windows; then the activation that runs
// or waits on the stack: at 320 the actor's state, at 328 the message, at 336 whether the stack has not
// run yet, at 344 the chain ID, at 360 the reply the activation waits on, null while it runs, at 368 the
// activation below it, at 376 the first and at 384 the last call of its side list; at 392 the next stack
// of the pool, at 400 the stack's size, and from 408 the target's words of the trim; at 424 the actor whose
// constructor the activation runs (`Building`), at 432 the message it waits on, at 440 the first of its open
// copy sessions (`CopyOpen`), and from 448 its crash: 1 where it crashed, 2 where a text stands below the
// error line, 3 where its stack overflowed (`ActorOverflow`), then the id, the file, the line and that text,
// each text its address and its count of bytes (`CrashActor`). The thread's own
// side of the switch, its save area, is in the thread's record, `threadSide`, 320 bytes of the thread's
// own heap, made at the thread's first message.
thread static mut byte* threadSide = null
thread static mut byte* pooled = null
thread static mut long pooledCount = 0

// The header of a stack of `asked` bytes, rounded up to the page and raised to the floor (above): the
// first of that size the thread's pool holds, taken off it, or a new one.
byte* Held(long asked) {
    raw {
        if threadSide == null {
            threadSide = AllocateOwn(320)
            sys.Overflowed(ActorOverflow)
        }

        long size = StackSize(asked)
        mut byte* before = null
        mut byte* at = pooled
        while at != null {
            if *Ptr<long>(at + 400) == size {
                if before == null {
                    pooled = *Ptr<byte*>(at + 392)
                } else {
                    *Ptr<byte*>(before + 392) = *Ptr<byte*>(at + 392)
                }

                pooledCount = pooledCount - 1
                return at
            }

            before = at
            at = *Ptr<byte*>(at + 392)
        }

        byte* top = sys.StackNew(size)
        if top == null {
            AllocationFailed(size)
        }

        *Ptr<long>(top - 512 + 336) = 1
        *Ptr<long>(top - 512 + 400) = size
        return top - 512
    }
}

// The stack whose header is `header` back in the thread's pool, trimmed by the target, or given back to
// the system where the pool holds 64 stacks already.
void Give(byte* header) {
    raw {
        long size = *Ptr<long>(header + 400)
        if pooledCount >= 64 {
            sys.StackFree(header + 512, size)
            return
        }

        sys.StackTrim(header + 512, size)
        *Ptr<byte*>(header + 392) = pooled
        pooled = header
        pooledCount = pooledCount + 1
    }
}

// The size of a stack asked for `asked` bytes: at least 64 KiB, rounded up to the system's page (U1). A
// size past 2^62 bytes, which no system maps, is refused as it stands, before the rounding could pass
// the largest `long`.
long StackSize(long asked) {
    mut long size = asked
    if size < 65536 {
        size = 65536
    }

    if size > 4611686018427387904 {
        AllocationFailed(size)
    }

    long page = sys.PageSize()
    if size % page != 0 {
        size = size + page - size % page
    }

    return size
}

// The first frame of an activation, which the switch enters with a return address of zero, so that a
// walk of the stack ends here (design record, section 2): at the stack's first run the target's first
// act on a stack, the guarantee of its room for an overflow on Windows (round 17, "Fiber layout +
// guarantee"); then the message, run to its end, its waits parking it (`Wait`); then the switch back to
// the thread's side, which never comes back here: the stack's next activation enters it afresh.
extern "C" void ActorStart() {
    raw {
        byte* header = running
        if *Ptr<long>(header + 336) != 0 {
            *Ptr<long>(header + 336) = 0
            sys.StackFirst()
        }

        byte* state = *Ptr<byte*>(header + 320)
        byte* message = *Ptr<byte*>(header + 328)
        extern "C" (byte*, byte*) => void run = *Ptr<extern "C" (byte*, byte*) => void>(*Ptr<byte*>(message + 8))
        run(state, message)
        sys.Switch(header, threadSide)
    }
}

// ---- the tests of `kurz test` (chapter 20, Y2, Y3, Y5) -------------------------------------------------------

// The actor the running test runs in, null outside `kurz test` and between its tests, whose own crash writes no log line and keeps
// its words for the line under the test's `FAILED` (`Fell`, `TestCrashKept`); those words, in the thread's own heap, their count and
// the room they were given, null and 0 where the test's actor did not crash.
thread static mut byte* testActor = null
thread static mut byte* testWords = null
thread static mut long testWordsCount = 0
thread static mut long testWordsRoom = 0

// The run of the tests of a program under `kurz test`, which the emitted top-level code calls in place of the program's statements,
// which do not run (Y2, D1): the `count` tests of the table `table` in its order, the order of the file, each entry 32 bytes, the
// test's function, its name as written, a `string`'s two words, and its line in the file `file`. Each test runs in an actor of its
// own, a child of the top-level code with the policy `stop`, named `test` (Q2, F2), as Rust's harness runs each test on a thread of
// its own and catches its panic (`TestRan`). It passes where its actor answered, and fails where that actor crashed, the words of the
// crash under its `FAILED` line (`TestCrashKept`), or where the wait found nothing left that could answer it, `deadlock at
// <file>:<the test's line>` under it, since a parked wait keeps no place of its own (F5), or the place of the call an actor's start
// keeps out where that call closes the loop, as the top-level code's wait names it (`Kept`; Y5; section 11, the owner,
// 2026-11-21, #599, comment 7063693195, Y5's line 1), in any file (the same comment 7067131310, the file 1), and where more than
// one closes it, the first place in source order so and the further lines of `KeptLines` under it, each indented by four spaces
// (comment 7067131310, several 2, and comment 7067139953, the form 1; comment 7067639209, the order 1, the same place 1, the cap 1
// and the indent 1), and where no such call closes it and one walk from the test's call runs into a loop, the test's line so and
// the loop's waits under it in U63's form, with each wait's chain ID, as a program run outside `kurz test` gets them under its
// error line (`LoopFirst`, `LoopLines`; the owner, 2026-11-23, #622, comment 7095825069, 1), each indented by four spaces as the
// calls kept out are *(assumed: the form of those calls' lines, comment 7067139953)*; then every actor the test made ends at once
// (`TestEnded`; F6). The line of its result is written on standard output after the lines the test printed (F4), `test "name" ...
// ok` or `test "name" ... FAILED`, the words indented by four spaces under a failed one, and after the last test the counts, `2 tests:
// 1 passed, 1 failed`, `1 test:` for one (Q3, F21); the process then ends with the exit code 0 where every test passed, else 1 (Q4).
// A line the runner cannot write raises `print-failed` at the line of the test it reports, the counts at the last test's line (A17).
pub void RunTests(byte* table, long count, string file) {
    mut byte* name = null
    mut byte* run = null
    mut byte* reply = null
    raw {
        name = AllocateOwn(16)
        *Ptr<byte*>(name) = "test".Pointer
        *Ptr<long>(name + 8) = 4
        run = AllocateOwn(24)
        *Ptr<extern "C" (byte*, byte*) => void>(run) = TestRun
        *Ptr<byte*>(run + 8) = null
        *Ptr<byte*>(run + 16) = null
        reply = AllocateOwn(80)
    }

    mut long passed = 0
    mut long index = 0
    mut int line = 0
    while index < count {
        mut string written = ""
        mut byte* test = null
        raw {
            byte* entry = table + index * 32
            test = *Ptr<byte*>(entry)
            written = TextAt(*Ptr<byte*>(entry + 8), *Ptr<long>(entry + 16))
            line = int(*Ptr<long>(entry + 24))
        }

        mut kept = List<long>()
        mut long hops = 0
        mut byte* first = null
        int kind = TestRan(test, name, run, reply, file, line, mut kept, mut first, mut hops)
        if kind == 1 {
            passed = passed + 1
            Print(1, "test {written} ... ok", file, line)
        } else {
            mut string words = "deadlock at {file}:{line}"
            mut lines = List<string>()
            if kind != 0 {
                raw {
                    words = TextAt(testWords, testWordsCount)
                }
            } else if kept.Count > 0 {
                lines = KeptLines(KeptSorted(kept))
                words = "deadlock at {lines[0]}"
            } else if first != null {
                lines.Add(words)
                for wait in LoopLines(first, hops) {
                    lines.Add(wait)
                }
            }

            Print(1, "test {written} ... FAILED", file, line)
            Print(1, "    {words}", file, line)
            mut int further = 1
            while further < lines.Count {
                Print(1, "    {lines[further]}", file, line)
                further = further + 1
            }
        }

        TestEnded()
        index = index + 1
    }

    mut string tests = "tests"
    if count == 1 {
        tests = "test"
    }

    Print(1, "{count} {tests}: {passed} passed, {count - passed} failed", file, line)
    EndActors()
    if passed < count {
        sys.Exit(1)
    }

    sys.Exit(0)
}

// The test whose function is `test` run in an actor of its own, a child of the top-level code, of no state, with a stack of 2 MiB (U1),
// the policy `stop`, which its null block of a restart says, and the name `name` (`RunTests`): one message to it, in its heap, whose
// table `run` names the runtime's `TestRun` and whose function stands at 56, queued as a call of the top-level code is, its reply
// `reply` in the thread's own heap, with no deadline (D6), and the top-level code's wait for it (`RootWait`), which runs the messages
// of the test's actors meanwhile; the reply's word once the wait ended, 1 where the test answered and 2 where its actor crashed (U20),
// and 0 where nothing was left that could answer it, the replies of the calls an actor's start keeps out then added to `kept`, none
// where none closes the loop, looked for with the chain of the test's message read before the wait, as `Wait` reads its call's (`Kept`),
// and where none is added, the first actor of the loop that one walk from the test's call runs into set in `first` and the count of
// its waits in `hops`, as the top-level code's wait finds them (`LoopFirst`; U64; the owner, 2026-11-23, #622, comment 7095825069, 1),
// `first` left null where the line ends. The runner builds the lines from `first` before `TestEnded` ends the test's actors, and
// `sys.Left` frees nothing, so that every record and reply the lines read stands.
int TestRan(byte* test, byte* name, byte* run, byte* reply, string file, int line, mut List<long> kept, mut byte* first, mut long hops) {
    byte* heap = ActorHeapNew(0)
    byte* state = ActorNew(heap, 0, 2097152, null, name)
    ActorBuilt(state)
    mut long high = 0
    mut long low = 0
    raw {
        byte* message = AllocateIn(heap, 64)
        *Ptr<byte*>(message + 8) = run
        *Ptr<byte*>(message + 16) = reply
        *Ptr<byte*>(message + 56) = test
        *Ptr<int>(reply) = 0
        *Ptr<long>(reply + 40) = 0
        testActor = state
        ReplyWaiter(reply)
        Enqueue(*Ptr<long>(state - 56), *Ptr<long>(state - 40), message, true, Never(), file, line)
        high = *Ptr<long>(message + 24)
        low = *Ptr<long>(message + 32)
    }

    sys.Entered()
    bool answered = RootWait(reply)
    if !answered {
        Kept(high, low, mut kept)
        if kept.Count == 0 {
            first = LoopFirst(reply, mut hops)
        }
    }

    sys.Left()
    raw {
        testActor = null
    }

    if !answered {
        return 0
    }

    return ReplyState(reply)
}

// The function of a test's one message (`TestRan`), which the scheduler runs on the test's actor as a message's function
// (`ActorStart`): the test's function, at 56 of the message, called, then the reply taken off the message (`ReplyTaken`), the message
// freed and the reply set (`Replied`), as the emitted function of a method's messages answers a call that waits (U4); a crash in the
// test never returns here, and its actor's fall sets the reply `callee crashed` (`Fall`; U20). The message is the one message its actor
// gets, which no reference of the program names and which has no deadline, so its table names no copy and no drop: no crash copies
// it, the crash of its actor dropping the message that runs (U21), and no deadline drops it (U37).
extern "C" void TestRun(byte* state, byte* message) {
    raw {
        extern "C" () => void test = *Ptr<extern "C" () => void>(message + 56)
        test()
        byte* reply = ReplyTaken(message)
        std.Free(message, 64)
        if reply != null {
            Replied(reply)
        }
    }
}

// The crash of the test's own actor (`Fell`; F1, F3): the words its log line would carry after its `crashed: `, the id and the fields
// after it (`CrashFields`), a line break as `\n` as `LogLine` writes the fields, kept in the thread's own heap for the line under the
// test's `FAILED` whatever the filter of the log says (P4), and no line on standard error.
void TestCrashKept(byte* id, long idCount, byte* file, long fileCount, long line, bool hasText, byte* text, long count) {
    mut string what = ""
    raw {
        what = TextAt(id, idCount)
    }

    string words = "{what}{CrashFields(file, fileCount, line, hasText, text, count)}"
    long size = 2 * long(words.Bytes.Count)
    raw {
        testWords = AllocateOwn(size)
        testWordsRoom = size
        testWordsCount = LogEscaped(testWords, 0, words, false)
    }
}

// The end of every actor of a test once its result stands (`RunTests`; F6), at once, parked ones too, as `EndActors` ends them at the
// end of a program (U13), and of what their activations and messages hold of the thread, so that the test after it starts with no
// actor, no timer, no pause and no block of the one before it: the records of the actors that ended while they stood in the run queue
// freed and the queue emptied; for each actor of the table, the stack a block that waits in its inbox keeps given back (`BlockLeft`),
// and each activation, from the top down, its open copy sessions ended (`CopyAbort`), its stack back in the pool; once no session is
// open, each actor's heaps freed whole, the heaps of their own that messages were built in freed (`MessageHeapNew`), and each slot freed
// for the actors spawned after it, whose numbers go on counting (U2); the timers, whose replies stood on those stacks, the queue of the
// pauses, the clock the scheduler read, the deadline of the top-level code's `within` block, and the value of a `throw` and the
// decision of a block that ran left at none; and the words of the test's crash freed.
void TestEnded() {
    raw {
        mut byte* queued = runFirst
        while queued != null {
            byte* after = *Ptr<byte*>(queued - 16)
            if *Ptr<int>(queued - 88) == 3 {
                std.HeapFree(queued - 192)
            }

            queued = after
        }

        runFirst = null
        runLast = null
        long used = SlotsUsed()
        mut long index = 0
        while index < used {
            byte* slot = Slot(index)
            if *Ptr<long>(slot + 8) != 0 {
                byte* at = *Ptr<byte*>(slot)
                Moved(at)
                mut byte* m = *Ptr<byte*>(at - 32)
                while m != null {
                    if *Ptr<byte*>(m + 8) == BlockTable() {
                        BlockLeft(m)
                    }

                    m = *Ptr<byte*>(m)
                }

                mut byte* header = *Ptr<byte*>(at - 8)
                while header != null {
                    while *Ptr<byte*>(header + 440) != null {
                        byte* session = *Ptr<byte*>(header + 440)
                        CopyAbort(session)
                        if *Ptr<byte*>(header + 440) == session {
                            *Ptr<byte*>(header + 440) = *Ptr<byte*>(session + 72)
                        }
                    }

                    byte* under = *Ptr<byte*>(header + 368)
                    Give(header)
                    header = under
                }

                *Ptr<byte*>(at - 8) = null
            }

            index = index + 1
        }

        index = 0
        while index < used {
            byte* slot = Slot(index)
            if *Ptr<long>(slot + 8) != 0 {
                byte* at = *Ptr<byte*>(slot)
                byte* heap = *Ptr<byte*>(at - 64)
                if heap != at - 192 {
                    std.HeapFree(heap)
                }

                std.HeapFree(at - 192)
                SlotFree(index)
            }

            index = index + 1
        }

        while messageHeaps != null {
            MessageHeapFree(messageHeaps)
        }

        timers = null
        timersLast = null
        if sharedWords != null {
            Lock(PauseLock())
            paused = null
            Unlock(PauseLock())
        }

        tick = 0
        ahead = 0
        rootBlock = 0
        thrownNumber = 0
        thrownSlot = null
        thrownCopy = null
        raising = null
        decision = 0
        if testWords != null {
            std.Free(testWords, testWordsRoom)
        }

        testWords = null
        testWordsCount = 0
        testWordsRoom = 0
    }
}

// ---- the copy of a value that crosses (design record, section 6) -------------------------------------

// A value that reaches a class instance crosses into an actor, or back to the caller as a result, as a
// copy of its own, and a value after `copy` is one at any call (U12; the owner, 2026-11-15, #519, comment
// 6896192351, Q6, "Rust: deep copy anywhere"). The emitted copy of each type calls these, and they run no
// program code. A crossing copies every counted block the value reaches into the heap of the actor it
// crosses into, or of the caller its result goes to (design record, section 6; the owner, 2026-11-15,
// #519, comment 6902210646, Q5, "Copy all, share big unbuilt"); a value after `copy` at a call that is
// no crossing has every block on a path to a class instance that passes through no function value and no
// actor's reference copied into the heap the allocation entry serves, the instance among them, and shares by
// its count every other block (`CopyWhole`).
// The copies one call makes of its arguments share one memo, so
// that a block two paths of the call reach arrives as one block (Q2, "Sharing kept"), and a result has a
// memo of its own: the session of the call, eleven words in the caller's frame, the memo, its slots and its
// count, the `weak` references the copies hold, their room and their count, the copies the call has left
// to make, whether every block goes into the memo, the heap the copies go into, null for a `copy` at
// a call that is no crossing, and, for a session of more than one copy, the next open session of the
// activation that runs it and that activation's header (`CopyOpen`). The memo maps each block the copies reached that a later path
// may reach again to its copy and to the function that lets go of it, open addressing on the block's
// address, three words a slot, and holds a count of the block until the session's end, so that no block
// made before then takes its address; a `weak` reference is kept with its place, its target, whether it is
// the pair of a class with derived classes, and the function that lets go of the weak count it holds of
// its target until the session's end. The session a copy works in is the one its run named (`CopyUse`),
// since a run runs no program code and so never waits, while another call's session may run between two
// runs of a call, a later argument's call that waits among them. The work list of the blocks whose items
// or fields wait to be copied is the thread's, three words each, the block, its copy and the function that
// fills the copy, emptied by every run, so that the copy never recurses, as a release works its lists off
// (the owner, 2026-11-01, "Iterative, never crashes"). The copies of the maps whose keys reach a class
// instance wait on a list of their own, the thread's too, two words each, the copy and the function that
// places its entries again under their keys' new hashes, which a run empties once its work list is empty,
// when every key the copy holds is filled (`CopyAfter`; U12, the owner, 2026-11-16, #519, comment
// 6923513534, "Rehash each key (Recommended)"). The memo, the work list, that list and the room of the
// `weak` references are blocks of the thread's own heap (`AllocateOwn`), and a run of a crossing has the
// allocation entry serve the session's heap until its end, the heap it served before then served again.
thread static mut byte* copySession = null
thread static mut byte* copyWork = null
thread static mut long copyWorkRoom = 0
thread static mut long copyWorkCount = 0
thread static mut byte* copyAfter = null
thread static mut long copyAfterRoom = 0
thread static mut long copyAfterCount = 0
thread static mut byte* copyBefore = null

// The session `session` of more than one copy listed among the open sessions of the running activation, the
// first of them, so that a crash between two of its copies ends it (U19, `Crashed`); nothing in the
// top-level code, whose crash ends the process.
pub void CopyOpen(byte* session) {
    sys.Entered()
    raw {
        if running != null {
            *Ptr<byte*>(session + 72) = *Ptr<byte*>(running + 440)
            *Ptr<byte*>(session + 80) = running
            *Ptr<byte*>(running + 440) = session
        }
    }

    sys.Left()
}

// The session the copy of the run under way works in, and its heap, where it has one, the one the
// allocation entry serves until the run's end (`CopyLeft`).
pub void CopyUse(byte* session) {
    sys.Entered()
    raw {
        copySession = session
        byte* heap = *Ptr<byte*>(session + 64)
        if heap != null {
            copyBefore = std.HeapUse(heap)
        }
    }
}

// Whether the copy under way is a crossing's, which copies every counted block it reaches, where a `copy`
// at a call that is no crossing shares every block but a class instance by its count (Q5).
pub bool CopyWhole() {
    mut bool whole = false
    raw {
        whole = *Ptr<byte*>(copySession + 64) != null
    }

    return whole
}

// The copy of the `count` bytes of a string at `bytes`, which hold a block, in a block of its own of the
// heap the allocation entry serves, held by one value: the address of its bytes. A crossing copies a
// string's block as it copies every other counted block (Q5); no program can tell the copy from a block
// shared by its count, as a string never changes.
pub byte* CopyBytes(byte* bytes, long count) {
    byte* copy = std.StringBlock(count)
    if copy == null {
        AllocationFailed(16 + count)
    }

    raw {
        mut long i = 0
        while i < count {
            copy[i] = bytes[i]
            i = i + 1
        }
    }

    std.StringTakeOver(copy, count)
    return copy
}

// Whether every block the copy reaches goes into the memo: in a call with more than one copied argument,
// where a later argument may reach a block by a path that holds no count of it, the argument itself.
pub bool CopyEvery() {
    mut bool every = false
    raw {
        every = *Ptr<long>(copySession + 56) != 0
    }

    return every
}

// The slot of `source` in a memo of `slots` slots of three words, a power of two: the one that holds it,
// or the first empty one on its probe, which a memo at most half full always has.
byte* CopySlot(byte* memo, long slots, byte* source) {
    mut byte* slot = null
    raw {
        mut long i = (long(source) >> 4) & (slots - 1)
        mut bool going = true
        while going {
            slot = memo + i * 24
            byte* held = *Ptr<byte*>(slot)
            if held == null || held == source {
                going = false
            } else {
                i = (i + 1) & (slots - 1)
            }
        }
    }

    return slot
}

// The copy of the block at `source` that the session's copies made, or null where they made none.
pub byte* CopyFind(byte* source) {
    mut byte* copy = null
    raw {
        if *Ptr<long>(copySession + 16) > 0 {
            copy = *Ptr<byte*>(CopySlot(*Ptr<byte*>(copySession), *Ptr<long>(copySession + 8), source) + 8)
        }
    }

    return copy
}

// `copy` kept in the session's memo as the copy of the block at `source`, which takes one more count of the
// block, at its first word as every block a copy makes anew has it, which `release` lets go of at the
// session's end; the memo doubles its slots before it would be more than half full.
pub void CopyKeep(byte* source, byte* copy, byte* release) {
    raw {
        byte* session = copySession
        *Ptr<long>(source) = *Ptr<long>(source) + 1
        long slots = *Ptr<long>(session + 8)
        long used = *Ptr<long>(session + 16)
        if (used + 1) * 2 > slots {
            mut long more = 64
            if slots > 0 {
                more = slots * 2
            }

            byte* bigger = AllocateOwn(more * 24)
            mut long i = 0
            while i < more * 3 {
                *Ptr<long>(bigger + i * 8) = 0
                i = i + 1
            }

            byte* memo = *Ptr<byte*>(session)
            i = 0
            while i < slots {
                byte* old = memo + i * 24
                byte* held = *Ptr<byte*>(old)
                if held != null {
                    byte* moved = CopySlot(bigger, more, held)
                    *Ptr<byte*>(moved) = held
                    *Ptr<byte*>(moved + 8) = *Ptr<byte*>(old + 8)
                    *Ptr<byte*>(moved + 16) = *Ptr<byte*>(old + 16)
                }

                i = i + 1
            }

            if memo != null {
                std.Free(memo, slots * 24)
            }

            *Ptr<byte*>(session) = bigger
            *Ptr<long>(session + 8) = more
        }

        byte* slot = CopySlot(*Ptr<byte*>(session), *Ptr<long>(session + 8), source)
        *Ptr<byte*>(slot) = source
        *Ptr<byte*>(slot + 8) = copy
        *Ptr<byte*>(slot + 16) = release
        *Ptr<long>(session + 16) = used + 1
    }
}

// The table `table` of `held` entries of `size` bytes, `count` of them used, with room for one more: the
// table itself, or a new one of twice the entries that holds its entries.
byte* CopyRoom(byte* table, long held, long count, long size, mut long grown) {
    grown = held
    if count < held {
        return table
    }

    mut long more = 64
    if held > 0 {
        more = held * 2
    }

    grown = more
    byte* bigger = AllocateOwn(more * size)
    raw {
        mut long i = 0
        while i < count * size / 8 {
            *Ptr<long>(bigger + i * 8) = *Ptr<long>(table + i * 8)
            i = i + 1
        }

        if table != null {
            std.Free(table, held * size)
        }
    }

    return bigger
}

// The block at `source` and its copy at `copy` put on the work list, with `fill`, the function that fills
// the copy from the block.
pub void CopyPush(byte* source, byte* copy, byte* fill) {
    raw {
        mut long grown = 0
        copyWork = CopyRoom(copyWork, copyWorkRoom, copyWorkCount, 24, mut grown)
        copyWorkRoom = grown
        byte* entry = copyWork + copyWorkCount * 24
        *Ptr<byte*>(entry) = source
        *Ptr<byte*>(entry + 8) = copy
        *Ptr<byte*>(entry + 16) = fill
        copyWorkCount = copyWorkCount + 1
    }
}

// The entry taken off the end of the work list, its three words, which the caller reads before it fills
// the copy, or null where the list is empty.
pub byte* CopyNext() {
    mut byte* entry = null
    raw {
        if copyWorkCount > 0 {
            copyWorkCount = copyWorkCount - 1
            entry = copyWork + copyWorkCount * 24
        }
    }

    return entry
}

// The copy at `copy` of a map whose keys reach a class instance put on the list of the copies the run
// places again, with `place`, the function that places its entries under their keys' new hashes: the run
// calls it once its work list is empty, since a key's hash reads the fields of the instances it reaches,
// which a copy the memo gave can still wait to be filled while the map is filled. The maps are placed before
// the session's last copy points the `weak` references of its copies (`CopyLeft`), and no key the checker
// admits hashes a `weak` slot: a `weak` reference as a map's key or value is `not supported` (the checker's
// `WeakUnread`), a key type that reaches one through what `==` compares by content, a `data` value's field, an item or
// a case, is no key it reads (its `KeyOf`), and a class with a `weak` field
// compares and hashes by identity (K4), by its copy's address, which the pointing does not change, and an
// `equal by` that names such a field is `not supported` (K8).
pub void CopyAfter(byte* copy, byte* place) {
    raw {
        mut long grown = 0
        copyAfter = CopyRoom(copyAfter, copyAfterRoom, copyAfterCount, 16, mut grown)
        copyAfterRoom = grown
        byte* entry = copyAfter + copyAfterCount * 16
        *Ptr<byte*>(entry) = copy
        *Ptr<byte*>(entry + 8) = place
        copyAfterCount = copyAfterCount + 1
    }
}

// The entry taken off the end of the list of the copies the run places again, its two words, which the
// caller reads before it places the copy, or null where the list is empty.
pub byte* CopyAfterNext() {
    mut byte* entry = null
    raw {
        if copyAfterCount > 0 {
            copyAfterCount = copyAfterCount - 1
            entry = copyAfter + copyAfterCount * 16
        }
    }

    return entry
}

// The `weak` reference at `slot` of a copy, which still points at `target`, its target in the value
// copied, kept for the session's end with one more weak count of the target, which `release` lets go of
// then; `wide` where the slot is the pair of an address and a table.
pub void CopyWeak(byte* slot, byte* target, bool wide, byte* release) {
    raw {
        byte* session = copySession
        *Ptr<long>(target + 8) = *Ptr<long>(target + 8) + 1
        mut long grown = 0
        long kept = *Ptr<long>(session + 40)
        byte* weaks = CopyRoom(*Ptr<byte*>(session + 24), *Ptr<long>(session + 32), kept, 32, mut grown)
        *Ptr<byte*>(session + 24) = weaks
        *Ptr<long>(session + 32) = grown
        byte* entry = weaks + kept * 32
        *Ptr<byte*>(entry) = slot
        *Ptr<byte*>(entry + 8) = target
        mut long pair = 0
        if wide {
            pair = 1
        }

        *Ptr<long>(entry + 16) = pair
        *Ptr<byte*>(entry + 24) = release
        *Ptr<long>(session + 40) = kept + 1
    }
}

// One copy of the session made, at the end of its run, which has the allocation entry serve the heap it
// served before the run; its last ends the session.
pub void CopyLeft(byte* session) {
    raw {
        if *Ptr<byte*>(session + 64) != null {
            std.HeapUse(copyBefore)
        }

        long remaining = *Ptr<long>(session + 48) - 1
        *Ptr<long>(session + 48) = remaining
        if remaining == 0 {
            CopyEnd(session)
        }
    }

    sys.Left()
}

// A session left before its last copy, by a case propagated out of a later argument or another jump out
// of the call: it ends as after its last copy, so that its copies point their `weak` references as a
// whole copy does before the region lets go of them; nothing for a session that ended.
pub void CopyAbort(byte* session) {
    sys.Entered()
    raw {
        if *Ptr<long>(session + 48) != 0 {
            *Ptr<long>(session + 48) = 0
            CopyEnd(session)
        }
    }

    sys.Left()
}

// The end of a session: each `weak` reference its copies hold pointed at the copy of its target, which then
// holds one more weak count, where the copies hold that target, else null, as a reference whose target was
// freed reads (R3), and the weak count the session held of the target let go of; then the count the memo
// held of each block let go of, and the session's tables freed, the session taken off the list of the
// activation that holds it open, and its words cleared.
void CopyEnd(byte* session) {
    raw {
        byte* listed = *Ptr<byte*>(session + 80)
        if listed != null {
            mut byte* before = null
            mut byte* at = *Ptr<byte*>(listed + 440)
            while at != null && at != session {
                before = at
                at = *Ptr<byte*>(at + 72)
            }

            if at != null {
                if before == null {
                    *Ptr<byte*>(listed + 440) = *Ptr<byte*>(session + 72)
                } else {
                    *Ptr<byte*>(before + 72) = *Ptr<byte*>(session + 72)
                }
            }
        }

        copySession = session
        byte* weaks = *Ptr<byte*>(session + 24)
        long kept = *Ptr<long>(session + 40)
        mut long i = 0
        while i < kept {
            byte* entry = weaks + i * 32
            byte* slot = *Ptr<byte*>(entry)
            byte* target = *Ptr<byte*>(entry + 8)
            bool wide = *Ptr<long>(entry + 16) != 0
            mut byte* table = null
            if wide {
                table = *Ptr<byte*>(slot + 8)
            }

            byte* copy = CopyFind(target)
            *Ptr<byte*>(slot) = copy
            if copy != null {
                *Ptr<long>(copy + 8) = *Ptr<long>(copy + 8) + 1
            } else {
                if wide {
                    *Ptr<byte*>(slot + 8) = null
                }
            }

            extern "C" (byte*, byte*) => void release = *Ptr<extern "C" (byte*, byte*) => void>(entry + 24)
            release(target, table)
            i = i + 1
        }

        byte* memo = *Ptr<byte*>(session)
        long slots = *Ptr<long>(session + 8)
        i = 0
        while i < slots {
            byte* held = *Ptr<byte*>(memo + i * 24)
            if held != null {
                // the release of a class instance, a list, a map or a `data` block, which reads no table: only a `weak`
                // reference's reads one, which no memo slot holds, and an instance's names its own class (`CopyLetGo`)
                extern "C" (byte*, byte*) => void letGo = *Ptr<extern "C" (byte*, byte*) => void>(memo + i * 24 + 16)
                letGo(held, null)
            }

            i = i + 1
        }

        if memo != null {
            std.Free(memo, slots * 24)
        }

        if weaks != null {
            std.Free(weaks, *Ptr<long>(session + 32) * 32)
        }

        i = 0
        while i < 11 {
            *Ptr<long>(session + i * 8) = 0
            i = i + 1
        }
    }
}
