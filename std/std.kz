// The standard library's Kurz code (design record, section 2; the owner, 2026-10-24, "A std/ directory
// now"), which the compiler compiles with every program, as it compiles the runtime: the allocator of
// section 3 and the blocks of a list and of a string. It takes its memory from the system through the
// runtime's boundary call, reached as the folder `sys`, the directory of the target the program is
// built for, and the runtime reaches it as the folder `std`, through its allocation entry, `Allocate`
// (the owner, 2026-10-24, "As built"; compiler/README.md, "The runtime"). The emitted code calls the
// functions of a list's block and of a string's.
use sys

// The memory the allocator carves blocks from, and the bytes left behind it, of each thread (R13).
thread static mut byte* chunk = null
thread static mut long left = 0

// The first free block of each size class of each thread, as its address, 0 where the class has none:
// fifteen classes, the powers of two from 16 to 262144 bytes, in a table carved at the thread's first
// allocation of no more than 262144 bytes. A free block holds the address of the next free block of
// its class in its first 8 bytes.
thread static mut long* heads = null

// The blocks of more than 262144 bytes that each thread freed and keeps (the owner, 2026-10-30, "Keep
// them, as glibc"): the first of them, null where it keeps none, and the bytes they take, at most
// 33554432, 32 mebibytes, as glibc's malloc serves from its heap, where it keeps what is freed, the
// requests below a threshold that a freed block of up to that size raises. Such a block starts with a
// header of 16 bytes, the bytes the system gave it and, while it is kept, the address of the kept block
// after it; what the allocation entry gives out starts after the header.
thread static mut byte* kept = null
thread static mut long keptBytes = 0

// The size class of a request of at most 262144 bytes, counted from 0: the smallest power of two from
// 16 that holds it.
long Class(long size) {
    mut long k = 0
    mut long room = 16
    while room < size {
        room = room * 2
        k = k + 1
    }

    return k
}

// `room` bytes carved from the thread's memory, which takes a new piece of a mebibyte from the system
// where the rest of the piece is too small; null where the system refuses. The rest of a piece left
// behind is not carved again.
byte* Carve(long room) {
    mut byte* p = null
    raw {
        if room > left {
            chunk = sys.Memory(1048576)
            left = 1048576
            if chunk == null {
                left = 0
            }
        }

        if chunk != null {
            p = chunk
            chunk = chunk + room
            left = left - room
        }
    }

    return p
}

// The table of the thread's size classes, carved at its first use from memory the system gave
// zeroed, so every class starts without a free block; null where the system refuses.
long* Heads() {
    mut long* table = null
    raw {
        if heads == null {
            heads = Ptr<long>(Carve(128))
        }

        table = heads
    }

    return table
}

// The smallest block the thread keeps that holds `bytes` bytes, its header among them, and takes no
// more than twice them, its own header among its bytes, taken out of the kept blocks, as glibc's malloc
// takes the smallest free chunk that holds a large request; null where none does, and the request takes
// memory of its own from the system (the owner, 2026-10-30, "Only if at least half used"). glibc splits
// the chunk and keeps its rest; Kurz gives the block out whole, its header naming its size, since a
// block the system gave goes back to it only whole on Windows, and a list grown into it grows without
// the system, so a request takes a kept block only where it uses at least half of it.
byte* Reused(long bytes) {
    mut byte* best = null
    raw {
        mut byte* before = null
        mut byte* previous = null
        mut byte* at = kept
        while at != null {
            long room = *Ptr<long>(at)
            if room >= bytes && room <= bytes * 2 && (best == null || room < *Ptr<long>(best)) {
                best = at
                before = previous
            }

            previous = at
            at = Ptr<byte>(*Ptr<long>(at + 8))
        }

        if best != null {
            if before == null {
                kept = Ptr<byte>(*Ptr<long>(best + 8))
            } else {
                *Ptr<long>(before + 8) = *Ptr<long>(best + 8)
            }

            keptBytes = keptBytes - *Ptr<long>(best)
        }
    }

    return best
}

// The allocation entry (design record, section 2): `size` bytes, at an address that is a multiple of
// 16. A request of more than 262144 bytes takes the smallest block the thread keeps that holds it and
// takes no more than twice its bytes, else memory of its own from the system, each with its header in
// front. A smaller one takes a block of its size class: the one of that class freed last, or one carved
// from the thread's memory, whose pieces the system gives a mebibyte at a time. A block used again holds
// what was written into it before. Null where the system refuses, for which the runtime's `Allocate`
// ends the process (the owner, 2026-10-24, "Null, runtime ends it"), as Rust's `GlobalAlloc::alloc`
// returns null and its callers that cease execution are encouraged to call `handle_alloc_error`.
pub byte* Allocate(long size) {
    mut byte* p = null
    if size > 262144 {
        long bytes = (size + 15) / 16 * 16 + 16
        p = Reused(bytes)
        raw {
            if p == null {
                p = sys.Memory(bytes)
                if p != null {
                    *Ptr<long>(p) = bytes
                }
            }

            if p != null {
                p = p + 16
            }
        }

        return p
    }

    long* table = Heads()
    raw {
        if table != null {
            long k = Class(size)
            long head = table[k]
            if head != 0 {
                p = Ptr<byte>(head)
                table[k] = *Ptr<long>(p)
            } else {
                mut long room = 16
                mut long i = 0
                while i < k {
                    room = room * 2
                    i = i + 1
                }

                p = Carve(room)
            }
        }
    }

    return p
}

// A block the allocation entry gave, given back with the `size` it was asked for, as Rust's
// `GlobalAlloc::dealloc` takes the layout a block was allocated with: a block of more than 262144
// bytes to the front of the blocks the thread keeps, where its bytes, as its header names them, fit
// within the 33554432 the kept blocks may take, else to the system; a smaller one to the front of its
// size class's free blocks, where a request of that class takes it first. Where the table of size
// classes cannot be carved, the block is not used again.
pub void Free(byte* p, long size) {
    if size > 262144 {
        raw {
            byte* block = p - 16
            long bytes = *Ptr<long>(block)
            if keptBytes + bytes <= 33554432 {
                *Ptr<long>(block + 8) = long(kept)
                kept = block
                keptBytes = keptBytes + bytes
            } else {
                sys.Release(block, bytes)
            }
        }

        return
    }

    long* table = Heads()
    raw {
        if table != null {
            long k = Class(size)
            *Ptr<long>(p) = table[k]
            table[k] = long(p)
        }
    }
}

// A block the allocation entry gave for `size` bytes, grown to `grown` bytes with the bytes it holds, as
// Rust's `GlobalAlloc::realloc`: a block of more than 262144 bytes is itself where its header names
// room enough, as a kept block given out whole may, as glibc's `realloc` leaves a mapped chunk that
// holds the size, else grown by the target's `Resize`, which can grow it without a copy, as the C
// library's `realloc` grows a block it mapped; else, and where `Resize` gives null, a new block with the
// bytes copied and the old one freed. Null where the system refuses, the block then left as it was.
pub byte* Reallocate(byte* p, long size, long grown) {
    if size > 262144 {
        long bytes = (grown + 15) / 16 * 16 + 16
        mut byte* moved = null
        raw {
            byte* block = p - 16
            long room = *Ptr<long>(block)
            if bytes <= room {
                moved = p
            } else {
                byte* q = sys.Resize(block, room, bytes)
                if q != null {
                    *Ptr<long>(q) = bytes
                    moved = q + 16
                }
            }
        }

        if moved != null {
            return moved
        }
    }

    byte* q = Allocate(grown)
    if q == null {
        return null
    }

    raw {
        mut long i = 0
        while i < size {
            q[i] = p[i]
            i = i + 1
        }
    }

    Free(p, size)
    return q
}

// The block of a list (M9, R15). A list value is the address of its block, null for a list without
// items, which takes no block, as Rust's `Vec::new` allocates nothing. A block holds the count of the
// list values that hold it, 8 bytes, the count of its items and the count it has room for, 4 bytes
// each, and from its 16th byte the items, each `item` bytes, as the item's type is laid out. A list
// value is copied without its items, and a write into a block that other values hold first copies
// the block (M3: storage is shared until one side writes; section 3: the counting is inserted by the
// compiler). The emitted code holds the counts of the items' own blocks.

// The count of the list's items.
pub int ListCount(byte* block) {
    mut int count = 0
    raw {
        if block != null {
            count = *Ptr<int>(block + 8)
        }
    }

    return count
}

// The address of the list's first item, of a list that has one.
pub byte* ListItems(byte* block) {
    mut byte* items = null
    raw {
        items = block + 16
    }

    return items
}

// One more list value holds the block.
pub void ListRetain(byte* block) {
    raw {
        if block != null {
            *Ptr<long>(block) = *Ptr<long>(block) + 1
        }
    }
}

// One list value less holds the block: whether it was the last, after which the caller lets go of
// the items' own blocks and frees the block with `ListFree`.
pub bool ListRelease(byte* block) {
    mut bool last = false
    raw {
        if block != null {
            long count = *Ptr<long>(block) - 1
            *Ptr<long>(block) = count
            last = count == 0
        }
    }

    return last
}

// The block given back to the allocator, its room counted in items of `item` bytes.
pub void ListFree(byte* block, long item) {
    mut long room = 0
    raw {
        room = long(*Ptr<int>(block + 12))
    }

    Free(block, 16 + room * item)
}

// Whether the list can take one more item in place: it has a block, no other list value holds it,
// and it has room.
pub bool ListHasRoom(byte* block) {
    mut bool room = false
    raw {
        if block != null {
            room = *Ptr<long>(block) == 1 && *Ptr<int>(block + 8) < *Ptr<int>(block + 12)
        }
    }

    return room
}

// Whether another list value holds the block too.
pub bool ListShared(byte* block) {
    mut bool shared = false
    raw {
        if block != null {
            shared = *Ptr<long>(block) > 1
        }
    }

    return shared
}

// The room a full block grows to, as Rust's `Vec` grows: twice its room, at least 8 items of a byte,
// 4 of up to a kibibyte and 1 of more, at most the largest `int`.
long Grown(long room, long item) {
    mut long first = 1
    if item == 1 {
        first = 8
    } else if item <= 1024 {
        first = 4
    }

    mut long grown = room * 2
    if grown < first {
        grown = first
    }

    if grown > 2147483647 {
        grown = 2147483647
    }

    return grown
}

// A new block, held by one list value, with the `count` items of `block` and room for one more: its
// room where it has room left, else the grown room. A list holds at most the largest `int` of items
// (M9): one more gives null, with `asked` set to the count after the `Add` times `item` (the owner,
// 2026-10-24, "Items after the Add"); a block the system refuses gives null, with `asked` set to the
// bytes asked for.
byte* Moved(byte* block, long count, long room, long item, mut long asked) {
    if count == 2147483647 {
        asked = (count + 1) * item
        return null
    }

    mut long grown = room
    if count == room {
        grown = Grown(room, item)
    }

    long bytes = 16 + grown * item
    mut byte* p = null
    raw {
        p = Allocate(bytes)
        if p == null {
            asked = bytes
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(grown)
            long n = count * item
            mut long i = 0
            while i < n {
                p[16 + i] = block[16 + i]
                i = i + 1
            }
        }
    }

    return p
}

// For an `Add` to a list no other value holds: a block with room for one more item, the block itself
// where it has room, else the block grown by `Reallocate`, as Rust's `Vec` grows its buffer by
// `realloc`; a first block for a list without one, as `Moved` gives it. Null, with `asked` set, as
// `Moved` gives it.
pub byte* ListGrow(byte* block, long item, mut long asked) {
    mut long count = 0
    mut long room = 0
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
        }
    }

    if count < room {
        return block
    }

    if block == null || count == 2147483647 {
        return Moved(block, count, room, item, mut asked)
    }

    long grown = Grown(room, item)
    long bytes = 16 + grown * item
    byte* p = Reallocate(block, 16 + room * item, bytes)
    raw {
        if p == null {
            asked = bytes
        } else {
            *Ptr<int>(p + 12) = int(grown)
        }
    }

    return p
}

// For a write to a block other list values hold (M3): a copy of its items' bytes with room for one
// more, the old block held by one value less, which never frees it. The caller counts the copied
// items' own blocks. Null, with `asked` set, as `Moved` gives it.
pub byte* ListCopy(byte* block, long item, mut long asked) {
    mut long count = 0
    mut long room = 0
    raw {
        count = long(*Ptr<int>(block + 8))
        room = long(*Ptr<int>(block + 12))
    }

    byte* p = Moved(block, count, room, item, mut asked)
    if p != null {
        raw {
            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// The address the next item goes to, in a block with room for it, whose count of items it raises by
// one. The count is read as a `uint`, which it never exceeds, so that the item's offset widens without
// a sign: in a loop of `Add`s the count the `Add` before stored is then read back by a plain load, not a
// sign-extending one (`EmitterTests` pins the widening).
pub byte* ListPush(byte* block, long item) {
    mut byte* slot = null
    raw {
        uint count = *Ptr<uint>(block + 8)
        *Ptr<uint>(block + 8) = count + 1
        slot = block + 16 + long(count) * item
    }

    return slot
}

// For a read into a list of bytes (S3): a block with room for `more` bytes after its own that no other
// list value holds, as Rust's `Vec::reserve` makes room before a read: the block itself where it has the
// room and no other value holds it, else a new block with its bytes, the old block freed, or held by one
// value less where other values hold it (M3). A new block has the room of the old one where that holds
// `more` bytes after them, else the larger of the room a full block grows to and the count and `more`.
// Null for a list without a block and `more` 0, which needs none. A count and `more` past the largest
// `int` give null with `asked` set to their sum, the bytes of the items, as an `Add` past it does (M9);
// a block the system refuses gives null with `asked` set to the bytes asked for.
pub byte* BytesReserve(byte* block, long more, mut long asked) {
    mut long count = 0
    mut long room = 0
    mut bool shared = false
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
            shared = *Ptr<long>(block) > 1
        }
    }

    if count + more > 2147483647 {
        asked = count + more
        return null
    }

    if !shared && room - count >= more {
        return block
    }

    mut long grown = room
    if room - count < more {
        grown = Grown(room, 1)
        if grown < count + more {
            grown = count + more
        }
    }

    long size = 16 + grown
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(grown)
            mut long i = 0
            while i < count {
                p[16 + i] = block[16 + i]
                i = i + 1
            }
        }
    }

    if p != null && block != null {
        if shared {
            raw {
                *Ptr<long>(block) = *Ptr<long>(block) - 1
            }
        } else {
            Free(block, 16 + room)
        }
    }

    return p
}

// The bytes the next read of a whole file asks for (S6): the room a list of bytes has after its own,
// else `piece` more, as Rust's `read_to_end` reads into the room its `Vec` has before it grows it, and
// no more than the largest `int` of items leaves, so that a file a list holds is read whole; 0 for a
// list that holds that many.
pub long BytesPiece(byte* block, long piece) {
    mut long count = 0
    mut long room = 0
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
        }
    }

    if room > count {
        return room - count
    }

    if piece > 2147483647 - count {
        return 2147483647 - count
    }

    return piece
}

// The address after the last byte of a list of bytes, where a read puts the bytes it adds; null for a
// list without a block.
pub byte* BytesEnd(byte* block) {
    mut byte* end = null
    raw {
        if block != null {
            end = block + 16 + long(*Ptr<int>(block + 8))
        }
    }

    return end
}

// The count of a list of bytes raised by the `count` bytes a read put after its own, in its room; a
// list without a block takes no byte.
pub void BytesAdded(byte* block, long count) {
    raw {
        if block != null {
            *Ptr<int>(block + 8) = *Ptr<int>(block + 8) + int(count)
        }
    }
}

// The count of the list's items set to 0 and its room kept, for `Clear` (M9) on a list no other value
// holds, whose items' own blocks the caller let go of; nothing for a list without a block.
pub void ListClear(byte* block) {
    raw {
        if block != null {
            *Ptr<int>(block + 8) = 0
        }
    }
}

// A new block, held by one list value, with a copy of the `count` items at `items`, each `item` bytes,
// and room for them: the part of a list (M9) and the bytes of a literal string (T15), whose items' own
// blocks the caller counts. Null for no items, and null with `asked` set to the bytes asked for where
// the system refuses.
pub byte* ListOf(byte* items, long count, long item, mut long asked) {
    if count == 0 {
        return null
    }

    long size = 16 + count * item
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(count)
            long n = count * item
            mut long i = 0
            while i < n {
                p[16 + i] = items[i]
                i = i + 1
            }
        }
    }

    return p
}

// The room for `count` items of `item` bytes in a new block, held by one list value, with no items,
// which `List<T>.FromRaw` takes over (R15): the address of its first item. More items than the
// largest `int` give null with `asked` set to the bytes of those items (M9); a block the system
// refuses gives null with `asked` set to the bytes asked for.
pub byte* ListAllocate(long count, long item, mut long asked) {
    if count > 2147483647 {
        asked = count * item
        return null
    }

    long size = 16 + count * item
    mut byte* p = null
    raw {
        byte* block = Allocate(size)
        if block == null {
            asked = size
        } else {
            *Ptr<long>(block) = 1
            *Ptr<int>(block + 8) = 0
            *Ptr<int>(block + 12) = int(count)
            p = block + 16
        }
    }

    return p
}

// The block of the items at `items`, which `ListAllocate` gave, holding `count` items: the list
// `List<T>.FromRaw` makes (R15).
pub byte* ListTakeOver(byte* items, long count) {
    mut byte* block = null
    raw {
        block = items - 16
        *Ptr<int>(block + 8) = int(count)
    }

    return block
}

// The address of the first item of a list's block, as a string's bytes, held by one more value: the
// string `string.FromUtf8` makes of a list of bytes, which shares its block (T15). Null for a list
// without a block.
pub byte* ListString(byte* block) {
    if block == null {
        return null
    }

    ListRetain(block)
    return ListItems(block)
}

// The block of a string (T15, R15), laid out as the block of a list of bytes, so that `s.Bytes` and a
// string made of a list share it (section 4): the count of the values that hold it, 8 bytes, the count
// of its bytes and the count of bytes it has room for, 4 bytes each, and from its 16th byte the bytes.
// A string value is the address of its bytes and their count, whose highest bit marks a string that
// holds such a block; a literal and the empty string hold none and are never freed (design record,
// section 3). A string never changes, so no write copies a block; the emitted code counts the values
// that hold one, and a list value that holds one copies it before it writes, as for any block other
// values hold (M3).

// A block of room for `size` bytes, held by one string value: the address of its bytes, null where
// the system refuses.
pub byte* StringBlock(long size) {
    mut byte* bytes = null
    raw {
        byte* block = Allocate(16 + size)
        if block != null {
            *Ptr<long>(block) = 1
            *Ptr<int>(block + 8) = 0
            *Ptr<int>(block + 12) = int(size)
            bytes = block + 16
        }
    }

    return bytes
}

// One more string value holds the block of the bytes.
pub void StringRetain(byte* bytes) {
    raw {
        *Ptr<long>(bytes - 16) = *Ptr<long>(bytes - 16) + 1
    }
}

// One string value less holds the block of the bytes: whether it was the last, after which the caller
// frees it with `StringFree`.
pub bool StringRelease(byte* bytes) {
    mut bool last = false
    raw {
        long count = *Ptr<long>(bytes - 16) - 1
        *Ptr<long>(bytes - 16) = count
        last = count == 0
    }

    return last
}

// The count of the `count` bytes at `bytes`, which `string.Allocate` gave, written into their block:
// what `string.FromRaw` takes over (R15).
pub void StringTakeOver(byte* bytes, long count) {
    raw {
        *Ptr<int>(bytes - 8) = int(count)
    }
}

// The block of a string's bytes, held by one more value, as a list of bytes: `s.Bytes` of a string that
// holds a block (T15).
pub byte* StringList(byte* bytes) {
    mut byte* block = null
    raw {
        block = bytes - 16
    }

    ListRetain(block)
    return block
}

// The block of the bytes given back to the allocator.
pub void StringFree(byte* bytes) {
    mut long room = 0
    raw {
        room = long(*Ptr<int>(bytes - 4))
    }

    Free(bytes - 16, 16 + room)
}
