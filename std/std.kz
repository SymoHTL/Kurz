        t[22] = 0xd8a1e681
        t[23] = 0xe7d3fbc8
        t[24] = 0x21e1cde6
        t[25] = 0xc33707d6
        t[26] = 0xf4d50d87
        t[27] = 0x455a14ed
        t[28] = 0xa9e3e905
        t[29] = 0xfcefa3f8
        t[30] = 0x676f02d9
        t[31] = 0x8d2a4c8a
        t[32] = 0xfffa3942
        t[33] = 0x8771f681
        t[34] = 0x6d9d6122
        t[35] = 0xfde5380c
        t[36] = 0xa4beea44
        t[37] = 0x4bdecfa9
        t[38] = 0xf6bb4b60
        t[39] = 0xbebfbc70
        t[40] = 0x289b7ec6
        t[41] = 0xeaa127fa
        t[42] = 0xd4ef3085
        t[43] = 0x04881d05
        t[44] = 0xd9d4d039
        t[45] = 0xe6db99e5
        t[46] = 0x1fa27cf8
        t[47] = 0xc4ac5665
        t[48] = 0xf4292244
        t[49] = 0x432aff97
        t[50] = 0xab9423a7
        t[51] = 0xfc93a039
        t[52] = 0x655b59c3
