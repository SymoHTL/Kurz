// The block of a map (M9). A map value is the address of its block, null for a map that holds none: one
// that never took one, and one whose `Clear` let go of a block other values held; the `Remove` of its last
// entry and the `Clear` of a block it alone held keep the block, its count of entries 0. A block holds
// the count of the map values that hold it, 8 bytes, the count of its entries and the count of slots it
// has room for, a power of two from 8, 4 bytes each, the two keys
// of its hash, 8 bytes each, the count of slots without an entry that entries can still take before the
// block grows, 4 bytes, the hash it takes, 4 bytes, 0 for the fast hash and 1 for SipHash-1-3 under its
// keys (`MapHash`), whether an insert's probe passed the bound, 4 bytes (`MapEmpty`), and 4 bytes unused,
// from its 48th byte a control byte for each slot, padded to a
// multiple of 16 bytes, and after them the slots, each `entry` bytes, as the emitted code lays out an
// entry: the hash of its key, 8 bytes, then the key and the value; a slot without an entry holds what its
// bytes held before. A slot's control byte is 255 where the slot holds no entry and a probe ends at its
// group: never filled since the block was made or cleared, or emptied by `MapErase` in a group that
// holds a 255 still; 128 where its entry was removed in a group with no 255, which a probe passes; and
// else bits 56 to 62 of its entry's hash, as
// Rust's `HashMap` (hashbrown's SwissTable) keeps a control byte per slot, EMPTY, DELETED or the hash's
// seven bits. The slots are probed in groups of 8, whose 8 control bytes the emitted code reads as one
// word, as hashbrown's generic groups: first the group the hash's low bits give, then each group one
// group further on than the stride before, the last group followed by the first; an entry stands in the
// first group of its hash's probe that had a slot without an entry when it was added, so that a probe for
// a key ends at a group with a slot of 255. A map value is copied without its entries, and a write into a
// block that other values hold first copies the block (M3), as a list's. The emitted code holds the counts
// of the entries' own blocks.

// The keys of the hash of the thread's next map: random bytes of the system at its first map, the
// first key raised by one for each map after it, as Rust's `RandomState::new` takes and raises them;
// where the system gives none, `MapKeys` says so and the program ends (M9).
thread static mut ulong mapKey0 = 0
thread static mut ulong mapKey1 = 0
thread static mut bool mapKeyed = false

// The count of the map's entries.
pub int MapCount(byte* block) {
    mut int count = 0
    raw {
        if block != null {
            count = *Ptr<int>(block + 8)
        }
    }

    return count
}

// The count of slots of a map's block.
pub int MapRoom(byte* block) {
    mut int room = 0
    raw {
        room = *Ptr<int>(block + 12)
    }

    return room
}

// The bytes of the control bytes of a map's block of `room` slots: a multiple of 16, so that the slots
// after them stay at a multiple of 16.
long MapControlBytes(long room) {
    return (room + 15) / 16 * 16
}

// The entries a block of `room` slots holds before it grows: seven of each eight, the load at which
// Rust's `HashMap` grows its table.
long MapCapacity(long room) {
    return room / 8 * 7
}

// The address of the first control byte of a map's block.
pub byte* MapControl(byte* block) {
    mut byte* control = null
    raw {
        control = block + 48
    }

    return control
}

// The address of the first slot of a map's block.
pub byte* MapSlots(byte* block) {
    mut byte* slots = null
    long control = MapControlBytes(long(MapRoom(block)))
    raw {
        slots = block + 48 + control
    }

    return slots
}

// The bytes of a map's block of `room` slots of `entry` bytes.
long MapBytes(long room, long entry) {
    return 48 + MapControlBytes(room) + room * entry
}

// One more map value holds the block.
pub void MapRetain(byte* block) {
    ListRetain(block)
}

// One map value less holds the block: whether it was the last, after which the caller lets go of the
// entries' own blocks and frees the block with `MapFree`.
pub bool MapRelease(byte* block) {
    return ListRelease(block)
}

// Whether another map value holds the block too.
pub bool MapShared(byte* block) {
    return ListShared(block)
}

// The block given back to the allocator, its slots each `entry` bytes.
pub void MapFree(byte* block, long entry) {
    Free(block, MapBytes(long(MapRoom(block)), entry))
}

// A block of `room` slots of `entry` bytes, held by one map value, with no entry and the keys `key0`
// and `key1`, every control byte 255 and the slots as the allocator gave them, as hashbrown writes the
// control bytes of a new table alone; null with `asked` set to the bytes asked for where the system
// refuses.
byte* MapBlock(long room, long entry, ulong key0, ulong key1, mut long asked) {
    long size = MapBytes(room, entry)
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = 0
            *Ptr<int>(p + 12) = int(room)
            *Ptr<ulong>(p + 16) = key0
            *Ptr<ulong>(p + 24) = key1
            *Ptr<int>(p + 32) = int(MapCapacity(room))
            *Ptr<int>(p + 36) = 0
            *Ptr<int>(p + 40) = 0
            mut long i = 0
            while i < room {
                p[48 + i] = 255
                i = i + 1
            }
        }
    }

    return p
}

// The keys of the thread's maps, taken from the system's randomness at its first map: true where the
// thread has them, and false where the system gave none, the keys then not taken, which the emitted
// code ends the program for with `random-failed` before it makes the map (M9; the owner, 2026-10-30,
// "End with an error, as Rust").
pub bool MapKeys() {
    mut bool keyed = true
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        if !mapKeyed {
            keyed = sys.Random(Ptr<byte>(&key0), 8) && sys.Random(Ptr<byte>(&key1), 8)
            if keyed {
                mapKey0 = key0
                mapKey1 = key1
                mapKeyed = true
            }
        }
    }

    return keyed
}

// The first block of a map, of 8 slots of `entry` bytes, with the thread's next keys, which `MapKeys`
// took; null with `asked` set to the bytes asked for where the system refuses.
pub byte* MapNew(long entry, mut long asked) {
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = mapKey0
        key1 = mapKey1
        mapKey0 = mapKey0 +% 1
    }

    return MapBlock(8, entry, key0, key1, mut asked)
}

// For a write to a block other map values hold (M3): a copy of its slots and its keys, held by one map
// value, the old block held by one value less, which never frees it. The caller counts the copied
// entries' own blocks. Null with `asked` set to the bytes asked for where the system refuses.
pub byte* MapCopy(byte* block, long entry, mut long asked) {
    long size = MapBytes(long(MapRoom(block)), entry)
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            mut long i = 8
            while i < size {
                p[i] = block[i]
                i = i + 1
            }

            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// The slot an entry of the hash goes to, the first in the hash's probe whose control byte is 255 or 128,
// its control byte set to the hash's, as hashbrown's `find_insert_slot` takes it; null, with nothing
// written, where that slot is of 255 and the block can take no more such slots, which
// `MapGrow` then makes room for, as hashbrown's `insert` calls `reserve` where `growth_left` is 0.
// Where the probe passed more than 512 slots of full groups, 64 groups of 8, in a block on the fast hash,
// the block is marked, and the insert moves the map onto SipHash-1-3 (`MapTripped`, `MapSwitched`), as
// .NET's `Dictionary` switches to a randomized hash where one insert walks more than 100 entries of a
// chain (section 4, the owner, 2026-11-01, "Switch, as .NET"; the bound, assumed there: a table filled to
// 7 slots of 8 passes full groups as a rule, so that 100 slots would switch maps no key was made for).
pub byte* MapEmpty(byte* block, ulong hash, long entry) {
    long mask = long(MapRoom(block)) - 1
    byte* control = MapControl(block)
    byte* slots = MapSlots(block)
    mut long at = long(hash & ulong(mask)) / 8 * 8
    mut long step = 0
    mut long i = -1
    mut byte* slot = null
    raw {
        while i < 0 {
            mut long b = 0
            while b < 8 && i < 0 {
                if control[at + b] >= 128 {
                    i = at + b
                }

                b = b + 1
            }

            step = step + 8
            at = (at + step) & mask
        }

        if control[i] == 255 {
            if *Ptr<int>(block + 32) == 0 {
                return null
            }

            *Ptr<int>(block + 32) = *Ptr<int>(block + 32) - 1
        }

        if step - 8 > 512 && *Ptr<int>(block + 36) == 0 {
            *Ptr<int>(block + 40) = 1
        }

        control[i] = byte((hash >> 56) & 127UL)
        slot = slots + i * entry
    }

    return slot
}

// For an entry added to a block no other value holds and that has no room left: a block with its
// entries and its keys, the old block freed, as hashbrown's `reserve_rehash` makes one: of the same
// slots where the entries and the one added fill no more than half of the entries it holds, so that
// the slots of removed entries are taken again, else of twice its slots. Null with `asked` set to the
// bytes asked for where the system refuses, and with the bytes of the grown block where its slots would
// be more than the largest `int` counts.
pub byte* MapGrow(byte* block, long entry, mut long asked) {
    long room = long(MapRoom(block))
    mut long slots = room * 2
    if long(MapCount(block)) + 1 <= MapCapacity(room) / 2 {
        slots = room
    }

    if slots > 2147483647 {
        asked = MapBytes(slots, entry)
        return null
    }

    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    byte* p = MapBlock(slots, entry, key0, key1, mut asked)
    if p == null {
        return null
    }

    byte* control = MapControl(block)
    byte* from = MapSlots(block)
    raw {
        *Ptr<int>(p + 8) = *Ptr<int>(block + 8)
        *Ptr<int>(p + 36) = *Ptr<int>(block + 36)
        mut long i = 0
        while i < room {
            if control[i] < 128 {
                byte* old = from + i * entry
                byte* to = MapEmpty(p, *Ptr<ulong>(old), entry)
                mut long j = 0
                while j < entry {
                    to[j] = old[j]
                    j = j + 1
                }
            }

            i = i + 1
        }
    }

    Free(block, MapBytes(room, entry))
    return p
}

// The entry in `slot` taken out of a block no other value holds, whose caller let go of its key and
// took its value: its control byte 255 where its group of 8 has a slot of 255 still, which ends every
// probe that reaches the group, so that the slot is one of 255 again, else 128, which
// a probe passes, as hashbrown's `erase` marks a slot EMPTY or DELETED.
pub void MapErase(byte* block, byte* slot, long entry) {
    byte* control = MapControl(block)
    mut long i = 0
    raw {
        i = (slot - MapSlots(block)) / entry
        long group = i / 8 * 8
        mut bool open = false
        mut long b = 0
        while b < 8 {
            if control[group + b] == 255 {
                open = true
            }

            b = b + 1
        }

        if open {
            control[i] = 255
            *Ptr<int>(block + 32) = *Ptr<int>(block + 32) + 1
        } else {
            control[i] = 128
        }

        *Ptr<int>(block + 8) = *Ptr<int>(block + 8) - 1
    }
}

// A block no other value holds without its entries, whose caller let go of their own blocks: every
// control byte 255 and the count 0, its slots and its keys kept, as hashbrown's `clear` keeps its table.
pub void MapClear(byte* block) {
    long room = long(MapRoom(block))
    raw {
        *Ptr<int>(block + 8) = 0
        *Ptr<int>(block + 32) = int(MapCapacity(room))
        mut long i = 0
        while i < room {
            block[48 + i] = 255
            i = i + 1
        }
    }
}

// The count of the map's entries raised by one.
pub void MapAdded(byte* block) {
    raw {
        *Ptr<int>(block + 8) = *Ptr<int>(block + 8) + 1
    }
}

// Whether an insert's probe in the map's block passed the bound, the block still on the fast hash.
pub bool MapTripped(byte* block) {
    mut bool tripped = false
    raw {
        tripped = *Ptr<int>(block + 40) != 0
    }

    return tripped
}

// For a map whose insert's probe passed the bound: a block of its slots and its count, under SipHash-1-3
// with its keys, with no entry in a slot, which the emitted code moves every entry of the old block into
// under its new hash and then frees the old block. Null with `asked` set to the bytes asked for where
// the system refuses.
pub byte* MapSwitched(byte* block, long entry, mut long asked) {
    long room = long(MapRoom(block))
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    byte* p = MapBlock(room, entry, key0, key1, mut asked)
    if p == null {
        return null
    }

    raw {
        *Ptr<int>(p + 8) = *Ptr<int>(block + 8)
        *Ptr<int>(p + 36) = 1
    }

    return p
}

// The hash of the `count` bytes at `bytes` under the map's block: the fast hash, or SipHash-1-3 under
// its keys once the map switched.
pub ulong MapHash(byte* block, byte* bytes, long count) {
    mut bool keyed = false
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        keyed = *Ptr<int>(block + 36) != 0
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    if !keyed {
        return FoldHash(bytes, count)
    }

    return SipHash13(key0, key1, bytes, count)
}

// The fast hash of the `count` bytes at `bytes`: foldhash's `fast::FixedState`, its seeds fixed, as its
// `FoldHasher::write` hashes bytes, the accumulator turned right by the count, 16 bytes and fewer in one
// folded multiply, more in its lanes.
ulong FoldHash(byte* bytes, long count) {
    ulong turn = ulong(count & 63)
    ulong seed = 0x082efa98ec4e6c89UL
    ulong accumulator = seed >> int(turn) | seed << int((64UL - turn) & 63UL)
    if count > 16 {
        return FoldLong(bytes, count, accumulator)
    }

    mut ulong s0 = accumulator
    mut ulong s1 = 0x3f84d5b5b5470917UL
    raw {
        if count >= 8 {
            s0 = s0 ^ WordAt(bytes)
            s1 = s1 ^ WordAt(bytes + count - 8)
        } else if count >= 4 {
            s0 = s0 ^ QuarterAt(bytes)
            s1 = s1 ^ QuarterAt(bytes + count - 4)
        } else if count > 0 {
            s0 = s0 ^ ulong(bytes[0])
            s1 = s1 ^ (ulong(bytes[count - 1]) << 8 | ulong(bytes[count / 2]))
        }
    }

    return FoldMultiply(s0, s1)
}

// foldhash's `hash_bytes_long` for more than 16 bytes: two lanes, four over 128 bytes and six over 256,
// each folding a word of the front with one further on.
ulong FoldLong(byte* bytes, long count, ulong accumulator) {
    ulong k0 = 0xc0ac29b7c97c50ddUL
    mut ulong s0 = accumulator
    mut ulong s1 = accumulator +% 0x3f84d5b5b5470917UL
    mut byte* v = bytes
    mut long n = count
    raw {
        if n > 128 {
            mut ulong s2 = accumulator +% 0x9216d5d98979fb1bUL
            mut ulong s3 = accumulator +% 0xd1310ba698dfb5acUL
            if n > 256 {
                mut ulong s4 = accumulator +% 0x2ffd72dbd01adfb7UL
                mut ulong s5 = accumulator +% 0xb8e1afed6a267e96UL
                mut bool going = true
                while going {
                    s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + 48) ^ k0)
                    s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + 56) ^ k0)
                    s2 = FoldMultiply(WordAt(v + 16) ^ s2, WordAt(v + 64) ^ k0)
                    s3 = FoldMultiply(WordAt(v + 24) ^ s3, WordAt(v + 72) ^ k0)
                    s4 = FoldMultiply(WordAt(v + 32) ^ s4, WordAt(v + 80) ^ k0)
                    s5 = FoldMultiply(WordAt(v + 40) ^ s5, WordAt(v + 88) ^ k0)
                    v = v + 96
                    n = n - 96
                    going = n > 256
                }

                s0 = s0 ^ s4
                s1 = s1 ^ s5
            }

            mut bool going = true
            while going {
                s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + 32) ^ k0)
                s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + 40) ^ k0)
                s2 = FoldMultiply(WordAt(v + 16) ^ s2, WordAt(v + 48) ^ k0)
                s3 = FoldMultiply(WordAt(v + 24) ^ s3, WordAt(v + 56) ^ k0)
                v = v + 64
                n = n - 64
                going = n > 128
            }

            s0 = s0 ^ s2
            s1 = s1 ^ s3
        }

        s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + n - 16) ^ k0)
        s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + n - 8) ^ k0)
        if n >= 32 {
            s0 = FoldMultiply(WordAt(v + 16) ^ s0, WordAt(v + n - 32) ^ k0)
            s1 = FoldMultiply(WordAt(v + 24) ^ s1, WordAt(v + n - 24) ^ k0)
            if n >= 64 {
                s0 = FoldMultiply(WordAt(v + 32) ^ s0, WordAt(v + n - 48) ^ k0)
                s1 = FoldMultiply(WordAt(v + 40) ^ s1, WordAt(v + n - 40) ^ k0)
                if n >= 96 {
                    s0 = FoldMultiply(WordAt(v + 48) ^ s0, WordAt(v + n - 64) ^ k0)
                    s1 = FoldMultiply(WordAt(v + 56) ^ s1, WordAt(v + n - 56) ^ k0)
                }
            }
        }
    }

    return s0 ^ s1
}

// foldhash's `folded_multiply` where no product of 128 bits is at hand: the four products of the halves
// of `x` and `y`, the low and the high one folded with the two across turned by 32 bits.
ulong FoldMultiply(ulong x, ulong y) {
    ulong lx = x & 4294967295UL
    ulong hx = x >> 32
    ulong ly = y & 4294967295UL
    ulong hy = y >> 32
    ulong across = (hx *% ly) ^ (lx *% hy)
    return (hx *% hy) ^ (lx *% ly) ^ (across >> 32 | across << 32)
}

// One word into the state of the fast hash whose count of bytes, its highest bit set, is `count`, as
// `FoldHasher::write_num` takes a `u64`: into the sponge's low word where it is empty, into its high word
// where it holds one, and where it holds two the sponge folded into the accumulator first.
void FoldWord(byte* state, ulong word, long count) {
    long words = (count & 9223372036854775807) / 8
    raw {
        if words % 2 == 1 {
            *Ptr<ulong>(state + 16) = word
        } else {
            if words > 0 {
                ulong accumulator = *Ptr<ulong>(state)
                *Ptr<ulong>(state) = FoldMultiply(*Ptr<ulong>(state + 8) ^ accumulator, *Ptr<ulong>(state + 16) ^ 0xc0ac29b7c97c50ddUL)
            }

            *Ptr<ulong>(state + 8) = word
            *Ptr<ulong>(state + 16) = 0UL
        }

        *Ptr<long>(state + 32) = count + 8
    }
}

// The fast hash of the words added, as `FoldHasher::finish`: the sponge folded into the accumulator where
// it holds a word, else the accumulator.
ulong FoldEnd(byte* state, long count) {
    mut ulong hash = 0
    raw {
        hash = *Ptr<ulong>(state)
        if (count & 9223372036854775807) > 0 {
            hash = FoldMultiply(*Ptr<ulong>(state + 8) ^ hash, *Ptr<ulong>(state + 16) ^ 0xc0ac29b7c97c50ddUL)
        }
    }

    return hash
}

// The hash of a key made of words, a `data` value's fields or a list's items, each the hash of a field or
// an item, kept in the 40 bytes at `state` while they are added, as Rust's `Hash` of a struct writes each
// field into one hasher. `HashStart` takes the hash of the map's block, `HashWord` adds one word and
// `HashEnd` gives the hash of the words added. Under SipHash-1-3 the state is its four words and the count
// of bytes, and the hash is SipHash-1-3 of the bytes of the words, the first byte of each word lowest.
// Under the fast hash the state is foldhash's accumulator and its sponge of two words, and the count of
// bytes with its highest bit set, which marks the fast hash; each word goes in as `FoldHasher::write_u64`
// takes it and the end is `FoldHasher::finish`.
pub void HashStart(byte* block, byte* state) {
    raw {
        if *Ptr<int>(block + 36) == 0 {
            *Ptr<ulong>(state) = 0x082efa98ec4e6c89UL
            *Ptr<ulong>(state + 8) = 0UL
            *Ptr<ulong>(state + 16) = 0UL
            *Ptr<long>(state + 32) = -9223372036854775807 - 1
            return
        }

        ulong key0 = *Ptr<ulong>(block + 16)
        ulong key1 = *Ptr<ulong>(block + 24)
        *Ptr<ulong>(state) = key0 ^ 8317987319222330741UL
        *Ptr<ulong>(state + 8) = key1 ^ 7237128888997146477UL
        *Ptr<ulong>(state + 16) = key0 ^ 7816392313619706465UL
        *Ptr<ulong>(state + 24) = key1 ^ 8387220255154660723UL
        *Ptr<long>(state + 32) = 0
    }
}

pub void HashWord(byte* state, ulong word) {
    mut long count = 0
    raw {
        count = *Ptr<long>(state + 32)
    }

    if count < 0 {
        FoldWord(state, word, count)
        return
    }

    mut ulong v0 = 0
    mut ulong v1 = 0
    mut ulong v2 = 0
    mut ulong v3 = 0
    raw {
        v0 = *Ptr<ulong>(state)
        v1 = *Ptr<ulong>(state + 8)
        v2 = *Ptr<ulong>(state + 16)
        v3 = *Ptr<ulong>(state + 24)
    }

    v3 = v3 ^ word
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ word
    raw {
        *Ptr<ulong>(state) = v0
        *Ptr<ulong>(state + 8) = v1
        *Ptr<ulong>(state + 16) = v2
        *Ptr<ulong>(state + 24) = v3
        *Ptr<long>(state + 32) = *Ptr<long>(state + 32) + 8
    }
}

pub ulong HashEnd(byte* state) {
    mut long count = 0
    raw {
        count = *Ptr<long>(state + 32)
    }

    if count < 0 {
        return FoldEnd(state, count)
    }

    mut ulong v0 = 0
    mut ulong v1 = 0
    mut ulong v2 = 0
    mut ulong v3 = 0
    mut ulong word = 0
    raw {
        v0 = *Ptr<ulong>(state)
        v1 = *Ptr<ulong>(state + 8)
        v2 = *Ptr<ulong>(state + 16)
        v3 = *Ptr<ulong>(state + 24)
        word = ulong(*Ptr<long>(state + 32)) << 56
    }

    v3 = v3 ^ word
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ word
    v2 = v2 ^ 255UL
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    return v0 ^ v1 ^ v2 ^ v3
}

// SipHash-1-3 of the `count` bytes at `bytes` under the keys `key0` and `key1`, the hash Rust's
// `HashMap` takes by default and a map's once it switched (M9, section 4): one round for each word of eight bytes, read with its first byte lowest,
// and three after the last word, which holds the bytes left and the count in its highest byte. A whole
// word is read in one load and the bytes left four, two and one at a time, as Rust's `SipHasher13`
// reads them (`load_int_le` and `u8to64_le`).
ulong SipHash13(ulong key0, ulong key1, byte* bytes, long count) {
    mut ulong v0 = key0 ^ 8317987319222330741UL
    mut ulong v1 = key1 ^ 7237128888997146477UL
    mut ulong v2 = key0 ^ 7816392313619706465UL
    mut ulong v3 = key1 ^ 8387220255154660723UL
    long whole = count / 8 * 8
    mut long at = 0
    while at < whole {
        mut ulong word = 0
        raw {
            word = WordAt(bytes + at)
        }

        v3 = v3 ^ word
        SipRound(mut v0, mut v1, mut v2, mut v3)
        v0 = v0 ^ word
        at = at + 8
    }

    mut ulong last = ulong(count) << 56
    raw {
        last = last | SipTail(bytes + whole, count - whole)
    }

    v3 = v3 ^ last
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ last
    v2 = v2 ^ 255UL
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    return v0 ^ v1 ^ v2 ^ v3
}

// The 8 bytes at `p` as a word, the first byte lowest, at any address: LLVM joins the bytes into one
// load with no alignment assumed, where a read through a `Ptr<ulong>` is a load LLVM takes to be at a
// multiple of 8, which a key's bytes need not be.
pub ulong WordAt(byte* p) {
    mut ulong word = 0
    raw {
        word = ulong(p[0]) | ulong(p[1]) << 8 | ulong(p[2]) << 16 | ulong(p[3]) << 24 | ulong(p[4]) << 32 | ulong(p[5]) << 40 | ulong(p[6]) << 48 | ulong(p[7]) << 56
    }

    return word
}

// The 4 bytes at `p` as a word, the first byte lowest, at any address, which LLVM joins into one load.
ulong QuarterAt(byte* p) {
    mut ulong word = 0
    raw {
        word = ulong(p[0]) | ulong(p[1]) << 8 | ulong(p[2]) << 16 | ulong(p[3]) << 24
    }

    return word
}

// The `n` bytes at `p`, fewer than 8, as a word, the first byte lowest: four, two and one at a time, as
// Rust's `u8to64_le` reads them.
ulong SipTail(byte* p, long n) {
    mut ulong word = 0
    mut long i = 0
    raw {
        if n >= 4 {
            word = QuarterAt(p)
            i = 4
        }

        if n - i >= 2 {
            word = word | (ulong(p[i]) | ulong(p[i + 1]) << 8) << int(8 * i)
            i = i + 2
        }

        if i < n {
            word = word | ulong(p[i]) << int(8 * i)
        }
    }

    return word
}

// One round of SipHash over its four words.
void SipRound(mut ulong v0, mut ulong v1, mut ulong v2, mut ulong v3) {
    v0 = v0 +% v1
    v1 = v1 << 13 | v1 >> 51
    v1 = v1 ^ v0
    v0 = v0 << 32 | v0 >> 32
    v2 = v2 +% v3
    v3 = v3 << 16 | v3 >> 48
    v3 = v3 ^ v2
    v0 = v0 +% v3
    v3 = v3 << 21 | v3 >> 43
    v3 = v3 ^ v0
    v2 = v2 +% v1
    v1 = v1 << 17 | v1 >> 47
    v1 = v1 ^ v2
    v2 = v2 << 32 | v2 >> 32
}

// SHA-256 (FIPS 180-4), MD5 (RFC 1321), CRC-32/ISO-HDLC and HMAC-SHA256 (RFC 2104), written in Kurz as
// RustCrypto's crates are written in Rust (design record, section 12, "In Kurz, as RustCrypto"), which the
// emitted code calls for `Sha256`, `Md5`, `Crc32`, `Hmac`, `Hex` and `FixedTime` (H1 to H4). A hasher's
// state is the block of a list of bytes (M9) whose count is fixed: the emitted code counts and copies it as
// a list's block, and the functions here read and write its bytes after the block's 16 bytes of counts.
// A state holds every table its hash reads, so that a hasher needs nothing else, on whatever thread.

// A new block of a list of `size` bytes, held by one value, whose bytes are what the allocator left there:
// a hasher's state or a digest. Null, with `asked` set to the bytes asked for, where the system refuses.
byte* ByteBlock(long size, mut long asked) {
    long bytes = 16 + size
    mut byte* p = null
    raw {
        p = Allocate(bytes)
        if p == null {
            asked = bytes
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(size)
            *Ptr<int>(p + 12) = int(size)
        }
    }

    return p
}

// The block a hasher's `Update` or `Finish` writes: the block itself where no other value holds it, else
// a copy of its bytes held by one value, the old block held by one value less, which never frees it, as a
// list copies its block before a write (M3). Null, with `asked` set, where the system refuses.
pub byte* HasherOwned(byte* block, mut long asked) {
    if !ListShared(block) {
        return block
    }

    long size = long(ListCount(block))
    byte* p = ByteBlock(size, mut asked)
    if p != null {
        raw {
            mut long i = 0
            while i < size {
                p[16 + i] = block[16 + i]
                i = i + 1
            }

            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// SHA-256's state at `s`, 616 bytes: the eight words of the hash (0), the count of bytes added (32), the
// block of 64 bytes being filled (40), the 64 words of the message schedule (104) and the 64 words of
// FIPS 180-4's constants K (360). MD5's, 408 bytes: its four words A, B, C and D (0), the count of bytes
// added (16), the block being filled (24), RFC 1321's 64 words T (88) and the 16 shifts of its rounds,
// four for each round (344).

// The state of a new hasher of SHA-256 at `s`: FIPS 180-4's initial hash (5.3.3) and K (4.2.2).
void Sha256Start(byte* s) {
    raw {
        uint* hash = Ptr<uint>(s)
        hash[0] = 0x6a09e667
        hash[1] = 0xbb67ae85
        hash[2] = 0x3c6ef372
        hash[3] = 0xa54ff53a
        hash[4] = 0x510e527f
        hash[5] = 0x9b05688c
        hash[6] = 0x1f83d9ab
        hash[7] = 0x5be0cd19
        *Ptr<long>(s + 32) = 0
        uint* k = Ptr<uint>(s + 360)
        k[0] = 0x428a2f98
        k[1] = 0x71374491
        k[2] = 0xb5c0fbcf
        k[3] = 0xe9b5dba5
        k[4] = 0x3956c25b
        k[5] = 0x59f111f1
        k[6] = 0x923f82a4
        k[7] = 0xab1c5ed5
        k[8] = 0xd807aa98
        k[9] = 0x12835b01
        k[10] = 0x243185be
        k[11] = 0x550c7dc3
        k[12] = 0x72be5d74
        k[13] = 0x80deb1fe
        k[14] = 0x9bdc06a7
        k[15] = 0xc19bf174
        k[16] = 0xe49b69c1
        k[17] = 0xefbe4786
        k[18] = 0x0fc19dc6
        k[19] = 0x240ca1cc
        k[20] = 0x2de92c6f
        k[21] = 0x4a7484aa
        k[22] = 0x5cb0a9dc
        k[23] = 0x76f988da
        k[24] = 0x983e5152
        k[25] = 0xa831c66d
        k[26] = 0xb00327c8
        k[27] = 0xbf597fc7
        k[28] = 0xc6e00bf3
        k[29] = 0xd5a79147
        k[30] = 0x06ca6351
        k[31] = 0x14292967
        k[32] = 0x27b70a85
        k[33] = 0x2e1b2138
        k[34] = 0x4d2c6dfc
        k[35] = 0x53380d13
        k[36] = 0x650a7354
        k[37] = 0x766a0abb
        k[38] = 0x81c2c92e
        k[39] = 0x92722c85
        k[40] = 0xa2bfe8a1
        k[41] = 0xa81a664b
        k[42] = 0xc24b8b70
        k[43] = 0xc76c51a3
        k[44] = 0xd192e819
        k[45] = 0xd6990624
        k[46] = 0xf40e3585
        k[47] = 0x106aa070
        k[48] = 0x19a4c116
        k[49] = 0x1e376c08
        k[50] = 0x2748774c
        k[51] = 0x34b0bcb5
        k[52] = 0x391c0cb3
        k[53] = 0x4ed8aa4a
        k[54] = 0x5b9cca4f
        k[55] = 0x682e6ff3
        k[56] = 0x748f82ee
        k[57] = 0x78a5636f
        k[58] = 0x84c87814
        k[59] = 0x8cc70208
        k[60] = 0x90befffa
        k[61] = 0xa4506ceb
        k[62] = 0xbef9a3f7
        k[63] = 0xc67178f2
    }
}

// One block of 64 bytes at `p` through the 64 rounds of SHA-256 into the hash at `s` (FIPS 180-4,
// 6.2.2), each word of the block read with its highest byte first.
void Sha256Block(byte* s, byte* p) {
    raw {
        uint* hash = Ptr<uint>(s)
        uint* w = Ptr<uint>(s + 104)
        uint* k = Ptr<uint>(s + 360)
        mut int t = 0
        while t < 16 {
            w[t] = uint(p[4 * t]) << 24 | uint(p[4 * t + 1]) << 16 | uint(p[4 * t + 2]) << 8 | uint(p[4 * t + 3])
            t = t + 1
        }

        while t < 64 {
            uint x = w[t - 15]
            uint y = w[t - 2]
            uint small0 = (x >> 7 | x << 25) ^ (x >> 18 | x << 14) ^ x >> 3
            uint small1 = (y >> 17 | y << 15) ^ (y >> 19 | y << 13) ^ y >> 10
            w[t] = small1 +% w[t - 7] +% small0 +% w[t - 16]
            t = t + 1
        }

        mut uint a = hash[0]
        mut uint b = hash[1]
        mut uint c = hash[2]
        mut uint d = hash[3]
        mut uint e = hash[4]
        mut uint f = hash[5]
        mut uint g = hash[6]
        mut uint h = hash[7]
        t = 0
        while t < 64 {
            uint big1 = (e >> 6 | e << 26) ^ (e >> 11 | e << 21) ^ (e >> 25 | e << 7)
            uint choose = (e & f) ^ (~e & g)
            uint first = h +% big1 +% choose +% k[t] +% w[t]
            uint big0 = (a >> 2 | a << 30) ^ (a >> 13 | a << 19) ^ (a >> 22 | a << 10)
            uint majority = (a & b) ^ (a & c) ^ (b & c)
            h = g
            g = f
            f = e
            e = d +% first
            d = c
            c = b
            b = a
            a = first +% big0 +% majority
            t = t + 1
        }

        hash[0] = hash[0] +% a
        hash[1] = hash[1] +% b
        hash[2] = hash[2] +% c
        hash[3] = hash[3] +% d
        hash[4] = hash[4] +% e
        hash[5] = hash[5] +% f
        hash[6] = hash[6] +% g
        hash[7] = hash[7] +% h
    }
}

// The digest of the message of SHA-256's state at `s`, its eight words with the highest byte of each
// first, written at `out`; the state is then a new hasher's.
void Sha256Close(byte* s, byte* out) {
    HashPad(s, false)
    raw {
        uint* hash = Ptr<uint>(s)
        mut int i = 0
        while i < 8 {
            uint word = hash[i]
            out[4 * i] = byte(word >> 24)
            out[4 * i + 1] = byte(word >> 16 & 255)
            out[4 * i + 2] = byte(word >> 8 & 255)
            out[4 * i + 3] = byte(word & 255)
            i = i + 1
        }
    }

    Sha256Start(s)
}

// The state of a new hasher of MD5 at `s`: RFC 1321's initial words (3.3), T (3.4) and the shifts of its
// four rounds.
void Md5Start(byte* s) {
    raw {
        uint* words = Ptr<uint>(s)
        words[0] = 0x67452301
        words[1] = 0xefcdab89
        words[2] = 0x98badcfe
        words[3] = 0x10325476
        *Ptr<long>(s + 16) = 0
        uint* t = Ptr<uint>(s + 88)
        t[0] = 0xd76aa478
        t[1] = 0xe8c7b756
        t[2] = 0x242070db
        t[3] = 0xc1bdceee
        t[4] = 0xf57c0faf
        t[5] = 0x4787c62a
        t[6] = 0xa8304613
        t[7] = 0xfd469501
        t[8] = 0x698098d8
        t[9] = 0x8b44f7af
        t[10] = 0xffff5bb1
        t[11] = 0x895cd7be
        t[12] = 0x6b901122
        t[13] = 0xfd987193
        t[14] = 0xa679438e
        t[15] = 0x49b40821
        t[16] = 0xf61e2562
        t[17] = 0xc040b340
        t[18] = 0x265e5a51
        t[19] = 0xe9b6c7aa
        t[20] = 0xd62f105d
        t[21] = 0x02441453
        t[22] = 0xd8a1e681
        t[23] = 0xe7d3fbc8
        t[24] = 0x21e1cde6
        t[25] = 0xc33707d6
        t[26] = 0xf4d50d87
        t[27] = 0x455a14ed
        t[28] = 0xa9e3e905
        t[29] = 0xfcefa3f8
        t[30] = 0x676f02d9
        t[31] = 0x8d2a4c8a
        t[32] = 0xfffa3942
        t[33] = 0x8771f681
        t[34] = 0x6d9d6122
        t[35] = 0xfde5380c
        t[36] = 0xa4beea44
        t[37] = 0x4bdecfa9
        t[38] = 0xf6bb4b60
        t[39] = 0xbebfbc70
        t[40] = 0x289b7ec6
        t[41] = 0xeaa127fa
        t[42] = 0xd4ef3085
        t[43] = 0x04881d05
        t[44] = 0xd9d4d039
        t[45] = 0xe6db99e5
        t[46] = 0x1fa27cf8
        t[47] = 0xc4ac5665
        t[48] = 0xf4292244
        t[49] = 0x432aff97
        t[50] = 0xab9423a7
        t[51] = 0xfc93a039
        t[52] = 0x655b59c3
        t[53] = 0x8f0ccc92
        t[54] = 0xffeff47d
        t[55] = 0x85845dd1
        t[56] = 0x6fa87e4f
        t[57] = 0xfe2ce6e0
        t[58] = 0xa3014314
        t[59] = 0x4e0811a1
        t[60] = 0xf7537e82
        t[61] = 0xbd3af235
        t[62] = 0x2ad7d2bb
        t[63] = 0xeb86d391
        uint* shifts = Ptr<uint>(s + 344)
        shifts[0] = 7
        shifts[1] = 12
        shifts[2] = 17
        shifts[3] = 22
        shifts[4] = 5
        shifts[5] = 9
        shifts[6] = 14
        shifts[7] = 20
        shifts[8] = 4
        shifts[9] = 11
        shifts[10] = 16
        shifts[11] = 23
        shifts[12] = 6
        shifts[13] = 10
        shifts[14] = 15
        shifts[15] = 21
    }
}

// One block of 64 bytes at `p` through the 64 steps of MD5 into the words at `s` (RFC 1321, 3.4), each
// word of the block read with its lowest byte first.
void Md5Block(byte* s, byte* p) {
    raw {
        uint* words = Ptr<uint>(s)
        uint* t = Ptr<uint>(s + 88)
        uint* shifts = Ptr<uint>(s + 344)
        mut uint a = words[0]
        mut uint b = words[1]
        mut uint c = words[2]
        mut uint d = words[3]
        mut int i = 0
        while i < 64 {
            mut uint f = 0
            mut int g = 0
            if i < 16 {
                f = (b & c) | (~b & d)
                g = i
            } else if i < 32 {
                f = (d & b) | (~d & c)
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | ~d)
                g = 7 * i % 16
            }

            uint m = uint(p[4 * g]) | uint(p[4 * g + 1]) << 8 | uint(p[4 * g + 2]) << 16 | uint(p[4 * g + 3]) << 24
            uint sum = f +% a +% t[i] +% m
            int r = int(shifts[i / 16 * 4 + i % 4])
            a = d
            d = c
            c = b
            b = b +% (sum << r | sum >> (32 - r))
            i = i + 1
        }

        words[0] = words[0] +% a
        words[1] = words[1] +% b
        words[2] = words[2] +% c
        words[3] = words[3] +% d
    }
}

// The digest of the message of MD5's state at `s`, its four words with the lowest byte of each first,
// written at `out`; the state is then a new hasher's.
void Md5Close(byte* s, byte* out) {
    HashPad(s, true)
    raw {
        uint* words = Ptr<uint>(s)
        mut int i = 0
        while i < 4 {
            uint word = words[i]
            out[4 * i] = byte(word & 255)
            out[4 * i + 1] = byte(word >> 8 & 255)
            out[4 * i + 2] = byte(word >> 16 & 255)
            out[4 * i + 3] = byte(word >> 24)
            i = i + 1
        }
    }

    Md5Start(s)
}

// One block of 64 bytes at `p` through the rounds of MD5 or of SHA-256 into the state at `s`.
void HashBlock(byte* s, byte* p, bool md5) {
    if md5 {
        Md5Block(s, p)
    } else {
        Sha256Block(s, p)
    }
}

// The `n` bytes at `p` added to the message of the state of MD5 or of SHA-256 at `s`: each block of 64
// bytes the message fills goes through the hash's rounds, and the bytes after the last whole block wait
// in the state's block.
void HashFeed(byte* s, byte* p, long n, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        *Ptr<long>(s + counted) = total + n
        mut long pending = total % 64
        mut long at = 0
        if pending > 0 {
            while pending < 64 && at < n {
                s[buffer + pending] = p[at]
                pending = pending + 1
                at = at + 1
            }

            if pending == 64 {
                HashBlock(s, s + buffer, md5)
                pending = 0
            }
        }

        while n - at >= 64 {
            HashBlock(s, p + at, md5)
            at = at + 64
        }

        while at < n {
            s[buffer + pending] = p[at]
            pending = pending + 1
            at = at + 1
        }
    }
}

// The padding of MD5 (RFC 1321, 3.1 and 3.2) or of SHA-256 (FIPS 180-4, 5.1.1) put through the state at
// `s`: the byte 0x80, zeros up to 8 bytes before the end of a block, and the count of bits of the
// message, its lowest byte first for MD5 and its highest first for SHA-256.
void HashPad(byte* s, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        ulong bits = ulong(total) << 3
        mut long pending = total % 64
        s[buffer + pending] = 128
        pending = pending + 1
        if pending > 56 {
            while pending < 64 {
                s[buffer + pending] = 0
                pending = pending + 1
            }

            HashBlock(s, s + buffer, md5)
            pending = 0
        }

        while pending < 56 {
            s[buffer + pending] = 0
            pending = pending + 1
        }

        mut int i = 0
        while i < 8 {
            mut int shift = 56 - 8 * i
            if md5 {
                shift = 8 * i
            }

            s[buffer + 56 + long(i)] = byte(bits >> shift & 255UL)
            i = i + 1
        }

        HashBlock(s, s + buffer, md5)
    }
}

// A new hasher of SHA-256 (H3): the block of its state; null, with `asked` set, where the system refuses.
pub byte* Sha256New(mut long asked) {
    byte* block = ByteBlock(616, mut asked)
    if block != null {
        Sha256Start(block + 16)
    }

    return block
}

// The bytes of the list `message` added to the hasher of SHA-256 whose block, which no other value holds,
// is `block`.
pub void Sha256Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), false)
    }
}

// The digest of the hasher of SHA-256 whose block, which no other value holds, is `block`: a new list of
// 32 bytes, after which the hasher starts over; null, with `asked` set and the hasher as it was, where the
// system refuses.
pub byte* Sha256Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        Sha256Close(block + 16, digest + 16)
    }

    return digest
}

// SHA-256 of the bytes of the list `message` (H1): a new list of 32 bytes, made on a state of its own, which
// it frees; null, with `asked` set, where the system refuses.
pub byte* Sha256Hash(byte* message, mut long asked) {
    byte* block = Sha256New(mut asked)
    if block == null {
        return null
    }

    Sha256Update(block, message)
    byte* digest = Sha256Finish(block, mut asked)
    Free(block, 632)
    return digest
}

// A new hasher of MD5 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Md5New(mut long asked) {
    byte* block = ByteBlock(408, mut asked)
    if block != null {
        Md5Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for MD5.
pub void Md5Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), true)
    }
}

// As `Sha256Finish`, for MD5: a new list of 16 bytes.
pub byte* Md5Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(16, mut asked)
    if digest != null {
        Md5Close(block + 16, digest + 16)
    }

    return digest
}

// MD5 of the bytes of the list `message` (H1), as `Sha256Hash` gives SHA-256: a new list of 16 bytes.
pub byte* Md5Hash(byte* message, mut long asked) {
    byte* block = Md5New(mut asked)
    if block == null {
        return null
    }

    Md5Update(block, message)
    byte* digest = Md5Finish(block, mut asked)
    Free(block, 424)
    return digest
}

// CRC-32/ISO-HDLC's state at `s`, 1028 bytes: the register (0) and the remainders of the 256 bytes under
// the reflected polynomial 0xEDB88320 (4), as zlib's `crc32` reads a byte at a time; the register starts
// at all ones, and the CRC is the register with every bit flipped.
void Crc32Start(byte* s) {
    raw {
        *Ptr<uint>(s) = 0xffffffff
        uint* table = Ptr<uint>(s + 4)
        mut int i = 0
        while i < 256 {
            mut uint c = uint(i)
            mut int k = 0
            while k < 8 {
                if (c & 1) != 0 {
                    c = 0xedb88320 ^ c >> 1
                } else {
                    c = c >> 1
                }

                k = k + 1
            }

            table[i] = c
            i = i + 1
        }
    }
}

// The `n` bytes at `p` through the register of the state at `s`.
void Crc32Feed(byte* s, byte* p, long n) {
    raw {
        uint* table = Ptr<uint>(s + 4)
        mut uint c = *Ptr<uint>(s)
        mut long i = 0
        while i < n {
            c = table[long((c ^ uint(p[i])) & 255)] ^ c >> 8
            i = i + 1
        }

        *Ptr<uint>(s) = c
    }
}

// A new hasher of CRC-32 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Crc32New(mut long asked) {
    byte* block = ByteBlock(1028, mut asked)
    if block != null {
        Crc32Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for CRC-32.
pub void Crc32Update(byte* block, byte* message) {
    if message != null {
        Crc32Feed(block + 16, ListItems(message), long(ListCount(message)))
    }
}

// The CRC of the hasher of CRC-32 whose block, which no other value holds, is `block`, after which the
// hasher starts over.
pub uint Crc32Finish(byte* block) {
    mut uint c = 0
    raw {
        c = *Ptr<uint>(block + 16) ^ 0xffffffff
        *Ptr<uint>(block + 16) = 0xffffffff
    }

    return c
}

// CRC-32 of the bytes of the list `message` (H1), made on a state of its own, which it frees; 0, with
// `asked` set, where the system refuses.
pub uint Crc32Hash(byte* message, mut long asked) {
    byte* block = Crc32New(mut asked)
    if block == null {
        return 0
    }

    Crc32Update(block, message)
    uint c = Crc32Finish(block)
    Free(block, 1044)
    return c
}

// HMAC-SHA256's state at `s`, 1296 bytes (RFC 2104): the key K0 (0), 64 bytes, the state of the inner
// hash, which has taken K0 ^ ipad (64), and the state of the outer hash, which `HmacClose` starts (680)
// and whose block of 64 bytes being filled, at 720, nothing reads between two calls of it.

// The state of a new hasher of HMAC-SHA256 at `s` on the `n` bytes of the key at `key`: K0 is the key,
// or SHA-256 of a key longer than a block of 64 bytes, with zeros after it to 64 bytes.
void HmacStart(byte* s, byte* key, long n) {
    raw {
        mut long i = 0
        if n > 64 {
            byte* outer = s + 680
            Sha256Start(outer)
            HashFeed(outer, key, n, false)
            Sha256Close(outer, s)
            i = 32
        } else {
            while i < n {
                s[i] = key[i]
                i = i + 1
            }
        }

        while i < 64 {
            s[i] = 0
            i = i + 1
        }
    }

    HmacKeyed(s)
}

// The inner hash of the state at `s` started over on K0 ^ ipad, K0 with every byte xored with 0x36.
void HmacKeyed(byte* s) {
    byte* pad = s + 720
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 54)
            i = i + 1
        }
    }

    Sha256Start(s + 64)
    HashFeed(s + 64, pad, 64, false)
}

// The tag of the message of the state at `s`, SHA-256 of K0 ^ opad, K0 with every byte xored with 0x5C,
// and of the inner hash's digest, written at `out`, 32 bytes; the inner hash then starts over on K0 ^ ipad,
// as `HmacKeyed` starts it.
void HmacClose(byte* s, byte* out) {
    byte* outer = s + 680
    byte* pad = s + 720
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 92)
            i = i + 1
        }
    }

    Sha256Start(outer)
    HashFeed(outer, pad, 64, false)
    Sha256Close(s + 64, out)
    HashFeed(outer, out, 32, false)
    Sha256Close(outer, out)
    HmacKeyed(s)
}

// A new hasher of HMAC-SHA256 on the bytes of the list `key` (H3), as `Sha256New` makes one of SHA-256; the
// null block of an empty list is a key of no bytes, of which `ListCount` gives 0 and `HmacStart` reads none.
pub byte* HmacNew(byte* key, mut long asked) {
    byte* block = ByteBlock(1296, mut asked)
    if block != null {
        HmacStart(block + 16, ListItems(key), long(ListCount(key)))
    }

    return block
}

// As `Sha256Update`, for HMAC-SHA256.
pub void HmacUpdate(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 80, ListItems(message), long(ListCount(message)), false)
    }
}

// As `Sha256Finish`, for HMAC-SHA256: the tag, a new list of 32 bytes.
pub byte* HmacFinish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        HmacClose(block + 16, digest + 16)
    }

    return digest
}

// HMAC-SHA256 of the bytes of the list `message` under the bytes of the list `key` (H1), as `Sha256Hash`
// gives SHA-256: a new list of 32 bytes.
pub byte* HmacSha256(byte* key, byte* message, mut long asked) {
    byte* block = HmacNew(key, mut asked)
    if block == null {
        return null
    }

    HmacUpdate(block, message)
    byte* digest = HmacFinish(block, mut asked)
    Free(block, 1312)
    return digest
}

// Whether the tag of the message `message` under the key `key` is the bytes of `tag` (H4), compared by
// `FixedTimeEqual`; false, with `asked` set, where the system refuses.
pub bool HmacVerifySha256(byte* key, byte* message, byte* tag, mut long asked) {
    byte* digest = HmacSha256(key, message, mut asked)
    if digest == null {
        return false
    }

    bool same = FixedTimeEqual(digest, tag)
    Free(digest, 48)
    return same
}

// Whether the lists of bytes `a` and `b` hold the same bytes (H4): false where their counts differ, and
// else every byte is read, and the code stops at no difference, as C#'s `FixedTimeEquals` reads them.
pub bool FixedTimeEqual(byte* a, byte* b) {
    int n = ListCount(a)
    if n != ListCount(b) {
        return false
    }

    mut int differ = 0
    raw {
        mut long i = 0
        while i < long(n) {
            differ = differ | (int(a[16 + i]) ^ int(b[16 + i]))
            i = i + 1
        }
    }

    return differ == 0
}

// The digit of `d`, 0 to 15, in lower-case hexadecimal.
byte HexDigit(int d) {
    if d < 10 {
        return byte(48 + d)
    }

    return byte(87 + d)
}

// The lower-case hexadecimal of the bytes of the list `message`, two digits for each byte, the higher half
// first (H2), as the bytes of a new string's block; null for a list without bytes, which is the empty
// string, and null with `asked` set where the system refuses or where the text would pass the largest
// `int` of bytes, as a list does past it (M9).
pub byte* HexEncode(byte* message, mut long asked) {
    long n = long(ListCount(message))
    if n == 0 {
        return null
    }

    long size = 2 * n
    if size > 2147483647 {
        asked = size
        return null
    }

    byte* text = StringBlock(size)
    if text == null {
        asked = 16 + size
        return null
    }

    raw {
        mut long i = 0
        while i < n {
            int b = int(message[16 + i])
            text[2 * i] = HexDigit(b >> 4)
            text[2 * i + 1] = HexDigit(b & 15)
            i = i + 1
        }
    }

    StringTakeOver(text, size)
    return text
}

// The value of the hexadecimal digit `b`, 0 to 15, in upper or lower case, or -1 for a byte that is no
// digit (H7), as the `hex` crate's `val` reads one.
int HexValue(int b) {
    if b >= 48 && b <= 57 {
        return b - 48
    }

    if b >= 65 && b <= 70 {
        return b - 55
    }

    if b >= 97 && b <= 102 {
        return b - 87
    }

    return -1
}

// The bytes the hexadecimal digits of the `count` bytes at `text` give (H7): -1 with a new list of
// `count / 2` bytes in `made`, two digits for each byte, the higher half first, null for no bytes, as the
// `hex` crate's `decode`; else the position `HexError` holds, with null in `made`: `count` where it is
// odd, read before the digits, and else the position of the first byte that is no digit; and -1 with
// null in `made` and `asked` set where the system refuses.
pub long HexDecode(byte* text, long count, mut byte* made, mut long asked) {
    made = null
    if count % 2 != 0 {
        return count
    }

    if count == 0 {
        return -1
    }

    long size = count / 2
    byte* list = ByteBlock(size, mut asked)
    if list == null {
        return -1
    }

    mut long bad = -1
    raw {
        mut long at = 0
        while at < count {
            int high = HexValue(int(text[at]))
            int low = HexValue(int(text[at + 1]))
            if high < 0 {
                bad = at
                break
            }

            if low < 0 {
                bad = at + 1
                break
            }

            list[16 + at / 2] = byte(high << 4 | low)
            at = at + 2
        }
    }

    if bad >= 0 {
        Free(list, 16 + size)
        return bad
    }

    made = list
    return -1
}
