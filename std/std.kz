        uint* hash = Ptr<uint>(s)
        hash[0] = 0x6a09e667
        hash[1] = 0xbb67ae85
        hash[2] = 0x3c6ef372
        hash[3] = 0xa54ff53a
        hash[4] = 0x510e527f
        hash[5] = 0x9b05688c
        hash[6] = 0x1f83d9ab
        hash[7] = 0x5be0cd19
        *Ptr<long>(s + 32) = 0
        uint* k = Ptr<uint>(s + 360)
        k[0] = 0x428a2f98
        k[1] = 0x71374491
        k[2] = 0xb5c0fbcf
        k[3] = 0xe9b5dba5
        k[4] = 0x3956c25b
        k[5] = 0x59f111f1
        k[6] = 0x923f82a4
        k[7] = 0xab1c5ed5
        k[8] = 0xd807aa98
        k[9] = 0x12835b01
        k[10] = 0x243185be
        k[11] = 0x550c7dc3
        k[12] = 0x72be5d74
        k[13] = 0x80deb1fe
        k[14] = 0x9bdc06a7
        k[15] = 0xc19bf174
        k[16] = 0xe49b69c1
        k[17] = 0xefbe4786
        k[18] = 0x0fc19dc6
        k[19] = 0x240ca1cc
        k[20] = 0x2de92c6f
        k[21] = 0x4a7484aa
        k[22] = 0x5cb0a9dc
        k[23] = 0x76f988da
        k[24] = 0x983e5152
        k[25] = 0xa831c66d
        k[26] = 0xb00327c8
        k[27] = 0xbf597fc7
        k[28] = 0xc6e00bf3
        k[29] = 0xd5a79147
        k[30] = 0x06ca6351
        k[31] = 0x14292967
        k[32] = 0x27b70a85
        k[33] = 0x2e1b2138
        k[34] = 0x4d2c6dfc
        k[35] = 0x53380d13
        k[36] = 0x650a7354
        k[37] = 0x766a0abb
        k[38] = 0x81c2c92e
        k[39] = 0x92722c85
        k[40] = 0xa2bfe8a1
        k[41] = 0xa81a664b
        k[42] = 0xc24b8b70
        k[43] = 0xc76c51a3
        k[44] = 0xd192e819
        k[45] = 0xd6990624
        k[46] = 0xf40e3585
        k[47] = 0x106aa070
        k[48] = 0x19a4c116
        k[49] = 0x1e376c08
        k[50] = 0x2748774c
        k[51] = 0x34b0bcb5
        k[52] = 0x391c0cb3
        k[53] = 0x4ed8aa4a
        k[54] = 0x5b9cca4f
        k[55] = 0x682e6ff3
        k[56] = 0x748f82ee
        k[57] = 0x78a5636f
        k[58] = 0x84c87814
        k[59] = 0x8cc70208
        k[60] = 0x90befffa
        k[61] = 0xa4506ceb
        k[62] = 0xbef9a3f7
        k[63] = 0xc67178f2
    }
}

// One block of 64 bytes at `p` through the 64 rounds of SHA-256 into the hash at `s` (FIPS 180-4,
// 6.2.2), each word of the block read with its highest byte first.
void Sha256Block(byte* s, byte* p) {
    raw {
        uint* hash = Ptr<uint>(s)
        uint* w = Ptr<uint>(s + 104)
        uint* k = Ptr<uint>(s + 360)
        mut int t = 0
        while t < 16 {
            w[t] = uint(p[4 * t]) << 24 | uint(p[4 * t + 1]) << 16 | uint(p[4 * t + 2]) << 8 | uint(p[4 * t + 3])
            t = t + 1
        }

        while t < 64 {
            uint x = w[t - 15]
            uint y = w[t - 2]
            uint small0 = (x >> 7 | x << 25) ^ (x >> 18 | x << 14) ^ x >> 3
            uint small1 = (y >> 17 | y << 15) ^ (y >> 19 | y << 13) ^ y >> 10
            w[t] = small1 +% w[t - 7] +% small0 +% w[t - 16]
            t = t + 1
        }

        mut uint a = hash[0]
        mut uint b = hash[1]
        mut uint c = hash[2]
        mut uint d = hash[3]
        mut uint e = hash[4]
        mut uint f = hash[5]
        mut uint g = hash[6]
        mut uint h = hash[7]
        t = 0
        while t < 64 {
            uint big1 = (e >> 6 | e << 26) ^ (e >> 11 | e << 21) ^ (e >> 25 | e << 7)
            uint choose = (e & f) ^ (~e & g)
            uint first = h +% big1 +% choose +% k[t] +% w[t]
            uint big0 = (a >> 2 | a << 30) ^ (a >> 13 | a << 19) ^ (a >> 22 | a << 10)
            uint majority = (a & b) ^ (a & c) ^ (b & c)
            h = g
            g = f
            f = e
            e = d +% first
            d = c
            c = b
            b = a
            a = first +% big0 +% majority
            t = t + 1
        }

        hash[0] = hash[0] +% a
        hash[1] = hash[1] +% b
        hash[2] = hash[2] +% c
        hash[3] = hash[3] +% d
        hash[4] = hash[4] +% e
        hash[5] = hash[5] +% f
        hash[6] = hash[6] +% g
        hash[7] = hash[7] +% h
    }
}

// The digest of the message of SHA-256's state at `s`, its eight words with the highest byte of each
// first, written at `out`; the state is then a new hasher's.
void Sha256Close(byte* s, byte* out) {
    HashPad(s, false)
    raw {
        uint* hash = Ptr<uint>(s)
        mut int i = 0
        while i < 8 {
            uint word = hash[i]
            out[4 * i] = byte(word >> 24)
            out[4 * i + 1] = byte(word >> 16 & 255)
            out[4 * i + 2] = byte(word >> 8 & 255)
            out[4 * i + 3] = byte(word & 255)
            i = i + 1
        }
    }

    Sha256Start(s)
}

