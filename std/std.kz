// The block of a map (M9). A map value is the address of its block, null for a map that holds none: one
// that never took one, and one whose `Clear` let go of a block other values held; the `Remove` of its last
// entry and the `Clear` of a block it alone held keep the block, its count of entries 0. A block holds
// the count of the map values that hold it, 8 bytes, the count of its entries and the count of slots it
// has room for, a power of two from 8, 4 bytes each, the two keys
// of its hash, 8 bytes each, the count of slots without an entry that entries can still take before the
// block grows, 4 bytes, the hash it takes, 4 bytes, 0 for the fast hash and 1 for SipHash-1-3 under its
// keys (`MapHash`), whether an insert's probe passed the bound, 4 bytes (`MapEmpty`), the count of the
// loops over a map and the texts of a map that hold the block, 4 bytes (`MapWalk`),
// from its 48th byte a control byte for each slot, padded to a
// multiple of 16 bytes, and after them the slots, each `entry` bytes, as the emitted code lays out an
// entry: the hash of its key, 8 bytes, then the key and the value, for a key of a kind the emitter's
// `KeepsHash` names, and the key and the value alone for the others; a slot without an entry holds what its
// bytes held before. A slot's control byte is 255 where the slot holds no entry and a probe ends at its
// group: never filled since the block was made or cleared, or emptied by `MapErase` in a group that
// holds a 255 still; 128 where its entry was removed in a group with no 255, which a probe passes; and
// else bits 56 to 62 of its entry's hash, as
// Rust's `HashMap` (hashbrown's SwissTable) keeps a control byte per slot, EMPTY, DELETED or the hash's
// seven bits. The slots are probed in groups of 8, whose 8 control bytes the emitted code reads as one
// word, as hashbrown's generic groups: first the group the hash's low bits give, then each group one
// group further on than the stride before, the last group followed by the first; an entry stands in the
// first group of its hash's probe that had a slot without an entry when it was added, so that a probe for
// a key ends at a group with a slot of 255. A map value is copied without its entries, and a write into a
// block that other values hold first copies the block (M3), as a list's. The emitted code holds the counts
// of the entries' own blocks.

// The keys of the hash of the thread's next map: random bytes of the system at its first map, the
// first key raised by one for each map after it, as Rust's `RandomState::new` takes and raises them;
// where the system gives none, `MapKeys` says so and the program ends (M9).
thread static mut ulong mapKey0 = 0
thread static mut ulong mapKey1 = 0
thread static mut bool mapKeyed = false

// The count of the map's entries.
pub int MapCount(byte* block) {
    mut int count = 0
    raw {
        if block != null {
            count = *Ptr<int>(block + 8)
        }
    }

    return count
}

// The count of slots of a map's block.
pub int MapRoom(byte* block) {
    mut int room = 0
    raw {
        room = *Ptr<int>(block + 12)
    }

    return room
}

// The bytes of the control bytes of a map's block of `room` slots: a multiple of 16, so that the slots
// after them stay at a multiple of 16.
long MapControlBytes(long room) {
    return (room + 15) / 16 * 16
}

// The entries a block of `room` slots holds before it grows: seven of each eight, the load at which
// Rust's `HashMap` grows its table.
long MapCapacity(long room) {
    return room / 8 * 7
}

// The address of the first control byte of a map's block.
pub byte* MapControl(byte* block) {
    mut byte* control = null
    raw {
        control = block + 48
    }

    return control
}

// The address of the first slot of a map's block.
pub byte* MapSlots(byte* block) {
    mut byte* slots = null
    long control = MapControlBytes(long(MapRoom(block)))
    raw {
        slots = block + 48 + control
    }

    return slots
}

// The bytes of a map's block of `room` slots of `entry` bytes.
long MapBytes(long room, long entry) {
    return 48 + MapControlBytes(room) + room * entry
}

// One more map value holds the block.
pub void MapRetain(byte* block) {
    ListRetain(block)
}

// One map value less holds the block: whether it was the last, after which the caller lets go of the
// entries' own blocks and frees the block with `MapFree`.
pub bool MapRelease(byte* block) {
    return ListRelease(block)
}

// Whether another map value holds the block too.
pub bool MapShared(byte* block) {
    return ListShared(block)
}

// The block given back to the allocator, its slots each `entry` bytes.
pub void MapFree(byte* block, long entry) {
    Free(block, MapBytes(long(MapRoom(block)), entry))
}

// A block of `room` slots of `entry` bytes, held by one map value, with no entry and the keys `key0`
// and `key1`, every control byte 255 and the slots as the allocator gave them, as hashbrown writes the
// control bytes of a new table alone; null with `asked` set to the bytes asked for where the system
// refuses.
byte* MapBlock(long room, long entry, ulong key0, ulong key1, mut long asked) {
    long size = MapBytes(room, entry)
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = 0
            *Ptr<int>(p + 12) = int(room)
            *Ptr<ulong>(p + 16) = key0
            *Ptr<ulong>(p + 24) = key1
            *Ptr<int>(p + 32) = int(MapCapacity(room))
            *Ptr<int>(p + 36) = 0
            *Ptr<int>(p + 40) = 0
            *Ptr<int>(p + 44) = 0
            mut long i = 0
            while i < room {
                p[48 + i] = 255
                i = i + 1
            }
        }
    }

    return p
}

// The keys of the thread's maps, taken from the system's randomness at its first map: true where the
// thread has them, and false where the system gave none, the keys then not taken, which the emitted
// code ends the program for with `random-failed` before it makes the map (M9; the owner, 2026-10-30,
// "End with an error, as Rust").
pub bool MapKeys() {
    mut bool keyed = true
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        if !mapKeyed {
            keyed = sys.Random(Ptr<byte>(&key0), 8) && sys.Random(Ptr<byte>(&key1), 8)
            if keyed {
                mapKey0 = key0
                mapKey1 = key1
                mapKeyed = true
            }
        }
    }

    return keyed
}

// The first block of a map, of 8 slots of `entry` bytes, with the thread's next keys, which `MapKeys`
// took; null with `asked` set to the bytes asked for where the system refuses.
pub byte* MapNew(long entry, mut long asked) {
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = mapKey0
        key1 = mapKey1
        mapKey0 = mapKey0 +% 1
    }

    return MapBlock(8, entry, key0, key1, mut asked)
}

// For a write to a block other map values hold (M3): a copy of its slots and its keys, held by one map
// value, the old block held by one value less, which never frees it. The caller counts the copied
// entries' own blocks. Null with `asked` set to the bytes asked for where the system refuses.
pub byte* MapCopy(byte* block, long entry, mut long asked) {
    long size = MapBytes(long(MapRoom(block)), entry)
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            mut long i = 8
            while i < size {
                p[i] = block[i]
                i = i + 1
            }

            *Ptr<int>(p + 44) = 0
            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// The slot an entry of the hash goes to, the first in the hash's probe whose control byte is 255 or 128,
// its control byte set to the hash's, as hashbrown's `find_insert_slot` takes it; null, with nothing
// written, where that slot is of 255 and the block can take no more such slots, which
// `MapGrow` then makes room for, as hashbrown's `insert` calls `reserve` where `growth_left` is 0.
// Where the insert's lookup of its key passed more than 512 slots, 64 groups of 8 without a slot of 255, in
// a block on the fast hash, the block is marked, the walk the lookup pays counted as .NET counts the chain its
// insert walks: the full groups before the slot, and where the slot is a removed entry's in a group without a
// slot of 255, that group and those after it up to the first group with one, which ends the lookup; and the
// insert moves the map onto SipHash-1-3 (`MapTripped`, `MapSwitched`), as .NET's `Dictionary` switches to a
// randomized hash where one insert walks more than 100 entries of a chain (section 4, the owner, 2026-11-01,
// "Switch, as .NET"; the bound, assumed there: a table filled to 7 slots of 8 passes full groups as a rule,
// so that 100 slots would switch maps no key was made for). A group's 8 control bytes are read as one word,
// as the emitted code reads them, and its slots of 255 and of 128 are the bytes whose high bit is set, as
// hashbrown's `match_empty_or_deleted` marks them.
pub byte* MapEmpty(byte* block, ulong hash, long entry) {
    long mask = long(MapRoom(block)) - 1
    byte* control = MapControl(block)
    byte* slots = MapSlots(block)
    mut long at = long(hash & ulong(mask)) / 8 * 8
    mut long step = 0
    mut long i = -1
    mut byte* slot = null
    raw {
        while i < 0 {
            ulong free = *Ptr<ulong>(control + at) & 0x8080808080808080UL
            if free != 0 {
                i = at + FirstFlag(free)
            }

            step = step + 8
            at = (at + step) & mask
        }

        if control[i] == 255 {
            if *Ptr<int>(block + 32) == 0 {
                return null
            }

            *Ptr<int>(block + 32) = *Ptr<int>(block + 32) - 1
        } else {
            // the slot of a removed entry: where its group has no slot of 255, the lookup of the key passed it, and
            // each group after it up to the first with a slot of 255, which ends the lookup, and the bound counts them
            mut long g = i / 8 * 8
            while !MapOpen(control + g) {
                g = at
                step = step + 8
                at = (at + step) & mask
            }
        }

        if step - 8 > 512 && *Ptr<int>(block + 36) == 0 {
            *Ptr<int>(block + 40) = 1
        }

        control[i] = byte((hash >> 56) & 127UL)
        slot = slots + i * entry
    }

    return slot
}

// Whether a group of 8 control bytes at `group`, an address that is a multiple of 8, holds a slot of 255,
// which ends a probe: the bytes whose two high bits are set, as hashbrown's generic `match_empty` marks
// them, since 128 has its second bit clear and an entry's byte its first.
bool MapOpen(byte* group) {
    mut ulong word = 0
    raw {
        word = *Ptr<ulong>(group)
    }

    return (word & (word << 1) & 0x8080808080808080UL) != 0
}

// For an entry added to a block no other value holds and that has no room left: a block with its count
// and its keys and no entry in a slot, which the entries of the old block go into, as hashbrown's
// `reserve_rehash` makes one: of the same slots where the entries and the one added fill no more than
// half of the entries it holds, so that the slots of removed entries are taken again, else of twice its
// slots. Null with `asked` set to the bytes asked for where the system refuses, and with the bytes of the
// grown block where its slots would be more than the largest `int` counts. A map whose slots keep their
// entries' hashes moves them with `MapGrow`; the emitted code moves the entries of one that keeps none
// under their keys' hashes taken again, as hashbrown does.
pub byte* MapGrown(byte* block, long entry, mut long asked) {
    long room = long(MapRoom(block))
    mut long slots = room * 2
    if long(MapCount(block)) + 1 <= MapCapacity(room) / 2 {
        slots = room
    }

    if slots > 2147483647 {
        asked = MapBytes(slots, entry)
        return null
    }

    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    byte* p = MapBlock(slots, entry, key0, key1, mut asked)
    if p != null {
        raw {
            *Ptr<int>(p + 8) = *Ptr<int>(block + 8)
            *Ptr<int>(p + 36) = *Ptr<int>(block + 36)
        }
    }

    return p
}

// For an entry added to a block no other value holds and that has no room left, of a map whose slots keep
// their entries' hashes: the block `MapGrown` makes, with the entries moved into it under the hashes their
// slots keep, and the old block freed. Null as `MapGrown` gives it.
pub byte* MapGrow(byte* block, long entry, mut long asked) {
    long room = long(MapRoom(block))
    byte* p = MapGrown(block, entry, mut asked)
    if p == null {
        return null
    }

    byte* control = MapControl(block)
    byte* from = MapSlots(block)
    raw {
        // the entries in the order of their slots, a group's 8 control bytes read as one word and its slots with an
        // entry, whose bytes have the high bit clear, taken lowest first, as hashbrown's `RawIter` takes them by
        // `match_full`; an entry's bytes moved a word at a time, since the emitted code lays out an entry from a word
        mut long g = 0
        while g < room {
            mut ulong full = ~*Ptr<ulong>(control + g) & 0x8080808080808080UL
            while full != 0 {
                byte* old = from + (g + FirstFlag(full)) * entry
                full = full & (full -% 1UL)
                byte* to = MapEmpty(p, *Ptr<ulong>(old), entry)
                mut long j = 0
                while j < entry {
                    *Ptr<ulong>(to + j) = *Ptr<ulong>(old + j)
                    j = j + 8
                }
            }

            g = g + 8
        }
    }

    Free(block, MapBytes(room, entry))
    return p
}

// The entry in `slot` taken out of a block no other value holds, whose caller let go of its key and
// took its value: its control byte 255 where its group of 8 has a slot of 255 still, which ends every
// probe that reaches the group, so that the slot is one of 255 again, else 128, which
// a probe passes, as hashbrown's `erase` marks a slot EMPTY or DELETED.
pub void MapErase(byte* block, byte* slot, long entry) {
    byte* control = MapControl(block)
    mut long i = 0
    raw {
        i = (slot - MapSlots(block)) / entry
        if MapOpen(control + i / 8 * 8) {
            control[i] = 255
            *Ptr<int>(block + 32) = *Ptr<int>(block + 32) + 1
        } else {
            control[i] = 128
        }

        *Ptr<int>(block + 8) = *Ptr<int>(block + 8) - 1
    }
}

// A block no other value holds without its entries, whose caller let go of their own blocks: every
// control byte 255 and the count 0, its slots and its keys kept, as hashbrown's `clear` keeps its table.
pub void MapClear(byte* block) {
    long room = long(MapRoom(block))
    raw {
        *Ptr<int>(block + 8) = 0
        *Ptr<int>(block + 32) = int(MapCapacity(room))
        mut long i = 0
        while i < room {
            block[48 + i] = 255
            i = i + 1
        }
    }
}

// The count of the map's entries raised by one.
pub void MapAdded(byte* block) {
    raw {
        *Ptr<int>(block + 8) = *Ptr<int>(block + 8) + 1
    }
}

// Whether an insert's probe in the map's block passed the bound, the block still on the fast hash.
pub bool MapTripped(byte* block) {
    mut bool tripped = false
    raw {
        tripped = *Ptr<int>(block + 40) != 0
    }

    return tripped
}

// One loop over a map more (`change` 1) or less (-1) holds the block, nothing for a map that holds none:
// a loop walks the block's slots by their index, so a lookup inside it must rehash no block it holds
// (`MapLongLookup`; section 4, the owner, 2026-11-03). A loop counts itself where it starts and lets go
// where it ends: at its end, a `break`, a `return` or a case propagated out of its body. The text of a map
// counts itself so while it walks the block, since a class's `Text()` it calls for a key or a value can
// look a key up in a map that holds the block (section 4, assumed there: the reading of the answer of
// 2026-11-03 for the text, #39, comment 6688570158). A write inside either finds the block shared and
// copies it first, the copy counting no loop (`MapCopy`): the loop holds the block with a count of its
// own, and the text walks a value that holds one besides the map the write reaches, as a read of a field
// takes a count of its own (K2).
pub void MapWalk(byte* block, int change) {
    raw {
        if block != null {
            *Ptr<int>(block + 44) = *Ptr<int>(block + 44) + change
        }
    }
}

// For a lookup whose probe passed more than 512 slots, 65 groups of 8 without a slot of 255: whether the
// block rehashes in place onto SipHash-1-3, which it does where it is still on the fast hash and no loop
// over a map and no text of a map holds it (section 4: a read's lookup, the owner, 2026-11-02, "lookups
// count too"; the bound and the lookups of `m[k] = v` and `Remove` assumed there; the loop's hold the
// owner's answer of 2026-11-03, and the text's assumed there); the
// block is then marked as on SipHash-1-3, so that `MapHash` hashes under its keys, and the emitted code
// moves the entries under their new hashes (`MapRehashMark`, `MapRehashPlace`).
pub bool MapLongLookup(byte* block) {
    mut bool rehash = false
    raw {
        if *Ptr<int>(block + 36) == 0 && *Ptr<int>(block + 44) == 0 {
            *Ptr<int>(block + 36) = 1
            rehash = true
        }
    }

    return rehash
}

// Whether the block hashes with the fast hash, not yet with SipHash-1-3.
pub bool MapFastHash(byte* block) {
    mut bool fast = false
    raw {
        fast = *Ptr<int>(block + 36) == 0
    }

    return fast
}

// The first step of the rehash in place onto SipHash-1-3, as hashbrown's `prepare_rehash_in_place` takes
// it: every entry's control byte made 128 and every removed entry's 255, so that 128 marks an entry not
// yet placed under its new hash, and the slots entries can still take made the block's
// capacity less its count, which gives the removed entries' slots to new entries. The emitted code then
// calls `MapRehashPlace` for each slot marked 128 with the new hash of the key in it, until the slot holds
// no entry marked 128, as hashbrown's `rehash_in_place` calls its hasher for the slot.
pub void MapRehashMark(byte* block) {
    long room = long(MapRoom(block))
    byte* control = MapControl(block)
    raw {
        mut long i = 0
        while i < room {
            if control[i] == 128 {
                control[i] = 255
            } else if control[i] < 128 {
                control[i] = 128
            }

            i = i + 1
        }

        *Ptr<int>(block + 32) = int(MapCapacity(room)) - MapCount(block)
    }
}

// One step of the rehash in place, as hashbrown's `rehash_in_place` takes it, with nothing allocated: the
// entry marked 128 in the slot `i`, of `entry` bytes, whose key's new hash is `hash`, put in the first
// slot of its probe whose control byte is 255 or 128. It stays in the slot `i` where `i` is in the group
// of 8 of that first slot, takes the slot of 255 and leaves its own 255, or changes places with the entry
// marked 128 there,
// which the slot `i` then holds. An entry changes places word by word where its bytes are a multiple of 8,
// and byte by byte where they are not, as an entry of a key of one word and a value of 12 bytes is.
pub void MapRehashPlace(byte* block, long entry, long i, ulong hash) {
    long mask = long(MapRoom(block)) - 1
    byte* control = MapControl(block)
    byte* slots = MapSlots(block)
    raw {
        mut long at = long(hash & ulong(mask)) / 8 * 8
        mut long step = 0
        mut long j = -1
        while j < 0 {
            mut long b = 0
            while b < 8 && j < 0 {
                if control[at + b] >= 128 {
                    j = at + b
                }

                b = b + 1
            }

            step = step + 8
            at = (at + step) & mask
        }

        byte mark = byte((hash >> 56) & 127UL)
        if j / 8 == i / 8 {
            control[i] = mark
        } else {
            byte taken = control[j]
            control[j] = mark
            mut long w = 0
            if entry % 8 == 0 {
                while w < entry {
                    ulong moved = *Ptr<ulong>(slots + i * entry + w)
                    *Ptr<ulong>(slots + i * entry + w) = *Ptr<ulong>(slots + j * entry + w)
                    *Ptr<ulong>(slots + j * entry + w) = moved
                    w = w + 8
                }
            } else {
                while w < entry {
                    byte moved = slots[i * entry + w]
                    slots[i * entry + w] = slots[j * entry + w]
                    slots[j * entry + w] = moved
                    w = w + 1
                }
            }

            if taken == 255 {
                control[i] = 255
            }
        }
    }
}

// For a map whose insert's probe passed the bound: a block of its slots and its count, under SipHash-1-3
// with its keys, with no entry in a slot, which the emitted code moves every entry of the old block into
// under its new hash and then frees the old block. Null with `asked` set to the bytes asked for where
// the system refuses.
pub byte* MapSwitched(byte* block, long entry, mut long asked) {
    long room = long(MapRoom(block))
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    byte* p = MapBlock(room, entry, key0, key1, mut asked)
    if p == null {
        return null
    }

    raw {
        *Ptr<int>(p + 8) = *Ptr<int>(block + 8)
        *Ptr<int>(p + 36) = 1
    }

    return p
}

// The hash of the `count` bytes at `bytes` under the map's block: the fast hash, or SipHash-1-3 under
// its keys once the map switched.
pub ulong MapHash(byte* block, byte* bytes, long count) {
    mut bool keyed = false
    mut ulong key0 = 0
    mut ulong key1 = 0
    raw {
        keyed = *Ptr<int>(block + 36) != 0
        key0 = *Ptr<ulong>(block + 16)
        key1 = *Ptr<ulong>(block + 24)
    }

    if !keyed {
        return FoldHash(bytes, count)
    }

    return SipHash13(key0, key1, bytes, count)
}

// The fast hash of the `count` bytes at `bytes`: foldhash's `fast::FixedState`, its seeds fixed, as its
// `FoldHasher::write` hashes bytes, the accumulator turned right by the count, 16 bytes and fewer in one
// folded multiply, more in its lanes.
ulong FoldHash(byte* bytes, long count) {
    ulong turn = ulong(count & 63)
    ulong seed = 0x082efa98ec4e6c89UL
    ulong accumulator = seed >> int(turn) | seed << int((64UL - turn) & 63UL)
    if count > 16 {
        return FoldLong(bytes, count, accumulator)
    }

    mut ulong s0 = accumulator
    mut ulong s1 = 0x3f84d5b5b5470917UL
    raw {
        if count >= 8 {
            s0 = s0 ^ WordAt(bytes)
            s1 = s1 ^ WordAt(bytes + count - 8)
        } else if count >= 4 {
            s0 = s0 ^ QuarterAt(bytes)
            s1 = s1 ^ QuarterAt(bytes + count - 4)
        } else if count > 0 {
            s0 = s0 ^ ulong(bytes[0])
            s1 = s1 ^ (ulong(bytes[count - 1]) << 8 | ulong(bytes[count / 2]))
        }
    }

    return FoldMultiply(s0, s1)
}

// foldhash's `hash_bytes_long` for more than 16 bytes: two lanes, four over 128 bytes and six over 256,
// each folding a word of the front with one further on.
ulong FoldLong(byte* bytes, long count, ulong accumulator) {
    ulong k0 = 0xc0ac29b7c97c50ddUL
    mut ulong s0 = accumulator
    mut ulong s1 = accumulator +% 0x3f84d5b5b5470917UL
    mut byte* v = bytes
    mut long n = count
    raw {
        if n > 128 {
            mut ulong s2 = accumulator +% 0x9216d5d98979fb1bUL
            mut ulong s3 = accumulator +% 0xd1310ba698dfb5acUL
            if n > 256 {
                mut ulong s4 = accumulator +% 0x2ffd72dbd01adfb7UL
                mut ulong s5 = accumulator +% 0xb8e1afed6a267e96UL
                mut bool going = true
                while going {
                    s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + 48) ^ k0)
                    s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + 56) ^ k0)
                    s2 = FoldMultiply(WordAt(v + 16) ^ s2, WordAt(v + 64) ^ k0)
                    s3 = FoldMultiply(WordAt(v + 24) ^ s3, WordAt(v + 72) ^ k0)
                    s4 = FoldMultiply(WordAt(v + 32) ^ s4, WordAt(v + 80) ^ k0)
                    s5 = FoldMultiply(WordAt(v + 40) ^ s5, WordAt(v + 88) ^ k0)
                    v = v + 96
                    n = n - 96
                    going = n > 256
                }

                s0 = s0 ^ s4
                s1 = s1 ^ s5
            }

            mut bool going = true
            while going {
                s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + 32) ^ k0)
                s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + 40) ^ k0)
                s2 = FoldMultiply(WordAt(v + 16) ^ s2, WordAt(v + 48) ^ k0)
                s3 = FoldMultiply(WordAt(v + 24) ^ s3, WordAt(v + 56) ^ k0)
                v = v + 64
                n = n - 64
                going = n > 128
            }

            s0 = s0 ^ s2
            s1 = s1 ^ s3
        }

        s0 = FoldMultiply(WordAt(v) ^ s0, WordAt(v + n - 16) ^ k0)
        s1 = FoldMultiply(WordAt(v + 8) ^ s1, WordAt(v + n - 8) ^ k0)
        if n >= 32 {
            s0 = FoldMultiply(WordAt(v + 16) ^ s0, WordAt(v + n - 32) ^ k0)
            s1 = FoldMultiply(WordAt(v + 24) ^ s1, WordAt(v + n - 24) ^ k0)
            if n >= 64 {
                s0 = FoldMultiply(WordAt(v + 32) ^ s0, WordAt(v + n - 48) ^ k0)
                s1 = FoldMultiply(WordAt(v + 40) ^ s1, WordAt(v + n - 40) ^ k0)
                if n >= 96 {
                    s0 = FoldMultiply(WordAt(v + 48) ^ s0, WordAt(v + n - 64) ^ k0)
                    s1 = FoldMultiply(WordAt(v + 56) ^ s1, WordAt(v + n - 56) ^ k0)
                }
            }
        }
    }

    return s0 ^ s1
}

// foldhash's `folded_multiply` where no product of 128 bits is at hand: the four products of the halves
// of `x` and `y`, the low and the high one folded with the two across turned by 32 bits.
ulong FoldMultiply(ulong x, ulong y) {
    ulong lx = x & 4294967295UL
    ulong hx = x >> 32
    ulong ly = y & 4294967295UL
    ulong hy = y >> 32
    ulong across = (hx *% ly) ^ (lx *% hy)
    return (hx *% hy) ^ (lx *% ly) ^ (across >> 32 | across << 32)
}

// One word into the state of the fast hash whose count of bytes, its highest bit set, is `count`, as
// `FoldHasher::write_num` takes a `u64`: into the sponge's low word where it is empty, into its high word
// where it holds one, and where it holds two the sponge folded into the accumulator first.
void FoldWord(byte* state, ulong word, long count) {
    long words = (count & 9223372036854775807) / 8
    raw {
        if words % 2 == 1 {
            *Ptr<ulong>(state + 16) = word
        } else {
            if words > 0 {
                ulong accumulator = *Ptr<ulong>(state)
                *Ptr<ulong>(state) = FoldMultiply(*Ptr<ulong>(state + 8) ^ accumulator, *Ptr<ulong>(state + 16) ^ 0xc0ac29b7c97c50ddUL)
            }

            *Ptr<ulong>(state + 8) = word
            *Ptr<ulong>(state + 16) = 0UL
        }

        *Ptr<long>(state + 32) = count + 8
    }
}

// The fast hash of the words added, as `FoldHasher::finish`: the sponge folded into the accumulator where
// it holds a word, else the accumulator.
ulong FoldEnd(byte* state, long count) {
    mut ulong hash = 0
    raw {
        hash = *Ptr<ulong>(state)
        if (count & 9223372036854775807) > 0 {
            hash = FoldMultiply(*Ptr<ulong>(state + 8) ^ hash, *Ptr<ulong>(state + 16) ^ 0xc0ac29b7c97c50ddUL)
        }
    }

    return hash
}

// The hash of a key made of words, a `data` value's fields or a list's items, each the hash of a field or
// an item, kept in the 40 bytes at `state` while they are added, as Rust's `Hash` of a struct writes each
// field into one hasher. `HashStart` takes the hash of the map's block, `HashWord` adds one word and
// `HashEnd` gives the hash of the words added. Under SipHash-1-3 the state is its four words and the count
// of bytes, and the hash is SipHash-1-3 of the bytes of the words, the first byte of each word lowest.
// Under the fast hash the state is foldhash's accumulator and its sponge of two words, and the count of
// bytes with its highest bit set, which marks the fast hash; each word goes in as `FoldHasher::write_u64`
// takes it and the end is `FoldHasher::finish`.
pub void HashStart(byte* block, byte* state) {
    raw {
        if *Ptr<int>(block + 36) == 0 {
            *Ptr<ulong>(state) = 0x082efa98ec4e6c89UL
            *Ptr<ulong>(state + 8) = 0UL
            *Ptr<ulong>(state + 16) = 0UL
            *Ptr<long>(state + 32) = -9223372036854775807 - 1
            return
        }

        ulong key0 = *Ptr<ulong>(block + 16)
        ulong key1 = *Ptr<ulong>(block + 24)
        *Ptr<ulong>(state) = key0 ^ 8317987319222330741UL
        *Ptr<ulong>(state + 8) = key1 ^ 7237128888997146477UL
        *Ptr<ulong>(state + 16) = key0 ^ 7816392313619706465UL
        *Ptr<ulong>(state + 24) = key1 ^ 8387220255154660723UL
        *Ptr<long>(state + 32) = 0
    }
}

pub void HashWord(byte* state, ulong word) {
    mut long count = 0
    raw {
        count = *Ptr<long>(state + 32)
    }

    if count < 0 {
        FoldWord(state, word, count)
        return
    }

    mut ulong v0 = 0
    mut ulong v1 = 0
    mut ulong v2 = 0
    mut ulong v3 = 0
    raw {
        v0 = *Ptr<ulong>(state)
        v1 = *Ptr<ulong>(state + 8)
        v2 = *Ptr<ulong>(state + 16)
        v3 = *Ptr<ulong>(state + 24)
    }

    v3 = v3 ^ word
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ word
    raw {
        *Ptr<ulong>(state) = v0
        *Ptr<ulong>(state + 8) = v1
        *Ptr<ulong>(state + 16) = v2
        *Ptr<ulong>(state + 24) = v3
        *Ptr<long>(state + 32) = *Ptr<long>(state + 32) + 8
    }
}

pub ulong HashEnd(byte* state) {
    mut long count = 0
    raw {
        count = *Ptr<long>(state + 32)
    }

    if count < 0 {
        return FoldEnd(state, count)
    }

    mut ulong v0 = 0
    mut ulong v1 = 0
    mut ulong v2 = 0
    mut ulong v3 = 0
    mut ulong word = 0
    raw {
        v0 = *Ptr<ulong>(state)
        v1 = *Ptr<ulong>(state + 8)
        v2 = *Ptr<ulong>(state + 16)
        v3 = *Ptr<ulong>(state + 24)
        word = ulong(*Ptr<long>(state + 32)) << 56
    }

    v3 = v3 ^ word
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ word
    v2 = v2 ^ 255UL
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    return v0 ^ v1 ^ v2 ^ v3
}

// SipHash-1-3 of the `count` bytes at `bytes` under the keys `key0` and `key1`, the hash Rust's
// `HashMap` takes by default and a map's once it switched (M9, section 4): one round for each word of eight bytes, read with its first byte lowest,
// and three after the last word, which holds the bytes left and the count in its highest byte. A whole
// word is read in one load and the bytes left four, two and one at a time, as Rust's `SipHasher13`
// reads them (`load_int_le` and `u8to64_le`).
ulong SipHash13(ulong key0, ulong key1, byte* bytes, long count) {
    mut ulong v0 = key0 ^ 8317987319222330741UL
    mut ulong v1 = key1 ^ 7237128888997146477UL
    mut ulong v2 = key0 ^ 7816392313619706465UL
    mut ulong v3 = key1 ^ 8387220255154660723UL
    long whole = count / 8 * 8
    mut long at = 0
    while at < whole {
        mut ulong word = 0
        raw {
            word = WordAt(bytes + at)
        }

        v3 = v3 ^ word
        SipRound(mut v0, mut v1, mut v2, mut v3)
        v0 = v0 ^ word
        at = at + 8
    }

    mut ulong last = ulong(count) << 56
    raw {
        last = last | SipTail(bytes + whole, count - whole)
    }

    v3 = v3 ^ last
    SipRound(mut v0, mut v1, mut v2, mut v3)
    v0 = v0 ^ last
    v2 = v2 ^ 255UL
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    SipRound(mut v0, mut v1, mut v2, mut v3)
    return v0 ^ v1 ^ v2 ^ v3
}

// The 8 bytes at `p` as a word, the first byte lowest, at any address: LLVM joins the bytes into one
// load with no alignment assumed, where a read through a `Ptr<ulong>` is a load LLVM takes to be at a
// multiple of 8, which a key's bytes need not be.
pub ulong WordAt(byte* p) {
    mut ulong word = 0
    raw {
        word = ulong(p[0]) | ulong(p[1]) << 8 | ulong(p[2]) << 16 | ulong(p[3]) << 24 | ulong(p[4]) << 32 | ulong(p[5]) << 40 | ulong(p[6]) << 48 | ulong(p[7]) << 56
    }

    return word
}

// The 4 bytes at `p` as a word, the first byte lowest, at any address, which LLVM joins into one load.
ulong QuarterAt(byte* p) {
    mut ulong word = 0
    raw {
        word = ulong(p[0]) | ulong(p[1]) << 8 | ulong(p[2]) << 16 | ulong(p[3]) << 24
    }

    return word
}

// The `n` bytes at `p`, fewer than 8, as a word, the first byte lowest: four, two and one at a time, as
// Rust's `u8to64_le` reads them.
ulong SipTail(byte* p, long n) {
    mut ulong word = 0
    mut long i = 0
    raw {
        if n >= 4 {
            word = QuarterAt(p)
            i = 4
        }

        if n - i >= 2 {
            word = word | (ulong(p[i]) | ulong(p[i + 1]) << 8) << int(8 * i)
            i = i + 2
        }

        if i < n {
            word = word | ulong(p[i]) << int(8 * i)
        }
    }

    return word
}

// One round of SipHash over its four words.
void SipRound(mut ulong v0, mut ulong v1, mut ulong v2, mut ulong v3) {
    v0 = v0 +% v1
    v1 = v1 << 13 | v1 >> 51
    v1 = v1 ^ v0
    v0 = v0 << 32 | v0 >> 32
    v2 = v2 +% v3
    v3 = v3 << 16 | v3 >> 48
    v3 = v3 ^ v2
    v0 = v0 +% v3
    v3 = v3 << 21 | v3 >> 43
    v3 = v3 ^ v0
    v2 = v2 +% v1
    v1 = v1 << 17 | v1 >> 47
    v1 = v1 ^ v2
    v2 = v2 << 32 | v2 >> 32
}

// SHA-256 (FIPS 180-4), MD5 (RFC 1321), CRC-32/ISO-HDLC and HMAC-SHA256 (RFC 2104), written in Kurz as
// RustCrypto's crates are written in Rust (design record, section 12, "In Kurz, as RustCrypto"), which the
// emitted code calls for `Sha256`, `Md5`, `Crc32`, `Hmac`, `Hex` and `FixedTime` (H1 to H4). A hasher's
// state is the block of a list of bytes (M9) whose count is fixed: the emitted code counts and copies it as
// a list's block, and the functions here read and write its bytes after the block's 16 bytes of counts.
// A state holds every table its hash reads, so that a hasher needs nothing else, on whatever thread.

// A new block of a list of `size` bytes, held by one value, whose bytes are what the allocator left there:
// a hasher's state or a digest. Null, with `asked` set to the bytes asked for, where the system refuses.
byte* ByteBlock(long size, mut long asked) {
    long bytes = 16 + size
    mut byte* p = null
    raw {
        p = Allocate(bytes)
        if p == null {
            asked = bytes
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(size)
            *Ptr<int>(p + 12) = int(size)
        }
    }

    return p
}

// The block a hasher's `Update` or `Finish` writes: the block itself where no other value holds it, else
// a copy of its bytes held by one value, the old block held by one value less, which never frees it, as a
// list copies its block before a write (M3). Null, with `asked` set, where the system refuses.
pub byte* HasherOwned(byte* block, mut long asked) {
    if !ListShared(block) {
        return block
    }

    long size = long(ListCount(block))
    byte* p = ByteBlock(size, mut asked)
    if p != null {
        raw {
            mut long i = 0
            while i < size {
                p[16 + i] = block[16 + i]
                i = i + 1
            }

            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// SHA-256's state at `s`, 104 bytes: the eight words of the hash (0), the count of bytes added (32) and the
// block of 64 bytes being filled (40). MD5's, 88 bytes: its four words A, B, C and D (0), the count of bytes
// added (16) and the block being filled (24). The rounds take their constants in the code, so that a state
// holds no table.

// The state of a new hasher of SHA-256 at `s`: FIPS 180-4's initial hash (5.3.3).
void Sha256Start(byte* s) {
    raw {
        uint* hash = Ptr<uint>(s)
        hash[0] = 0x6a09e667
        hash[1] = 0xbb67ae85
        hash[2] = 0x3c6ef372
        hash[3] = 0xa54ff53a
        hash[4] = 0x510e527f
        hash[5] = 0x9b05688c
        hash[6] = 0x1f83d9ab
        hash[7] = 0x5be0cd19
        *Ptr<long>(s + 32) = 0
    }
}

// The word of the four bytes at `p`, the highest first, as SHA-256 reads a word (FIPS 180-4, 3.1), read a
// byte at a time, which LLVM joins into one load of four bytes at any address.
pub uint BigEndianWord(byte* p) {
    mut uint word = 0
    raw {
        word = uint(p[0]) << 24 | uint(p[1]) << 16 | uint(p[2]) << 8 | uint(p[3])
    }

    return word
}

// The 8 bytes at `p` as a word, the first byte highest, at any address: the order of two such words is
// the order of their bytes, read from the first. LLVM joins the bytes into one load and a swap.
pub ulong HighWordAt(byte* p) {
    mut ulong word = 0
    raw {
        word = ulong(p[0]) << 56 | ulong(p[1]) << 48 | ulong(p[2]) << 40 | ulong(p[3]) << 32 | ulong(p[4]) << 24 | ulong(p[5]) << 16 | ulong(p[6]) << 8 | ulong(p[7])
    }

    return word
}

// The word of the schedule of a round t from round 16 on (FIPS 180-4, 6.2.2, step 1), of the words `w16`,
// `w15`, `w7` and `w2` of the rounds t - 16, t - 15, t - 7 and t - 2.
uint Sha256Word(uint w16, uint w15, uint w7, uint w2) {
    uint small0 = (w15 >> 7 | w15 << 25) ^ (w15 >> 18 | w15 << 14) ^ w15 >> 3
    uint small1 = (w2 >> 17 | w2 << 15) ^ (w2 >> 19 | w2 << 13) ^ w2 >> 10
    return w16 +% small0 +% w7 +% small1
}

// One round of SHA-256 (FIPS 180-4, 6.2.2, step 3) with its constant `k` and its word `w`, on the working
// variables in the order a to h that the round gives them: T1 is added to d, which is the next round's e,
// and T1 + T2 is written to h, which is the next round's a. The next round takes the eight in the order
// h, a, b, c, d, e, f, g, so that they move by the names of the call, where `sha2` writes the copies
// `h = g` to `b = a`, which LLVM turns into the same renaming.
void Sha256Round(uint a, uint b, uint c, mut uint d, uint e, uint f, uint g, mut uint h, uint k, uint w) {
    uint big1 = (e >> 6 | e << 26) ^ (e >> 11 | e << 21) ^ (e >> 25 | e << 7)
    uint choose = (e & f) ^ (~e & g)
    uint first = big1 +% choose +% k +% w +% h
    uint big0 = (a >> 2 | a << 30) ^ (a >> 13 | a << 19) ^ (a >> 22 | a << 10)
    uint majority = (a & b) ^ (a & c) ^ (b & c)
    d = d +% first
    h = first +% big0 +% majority
}

// One block of 64 bytes at `p` through the 64 rounds of SHA-256 into the hash at `s` (FIPS 180-4,
// 6.2.2): with the SHA instructions where the CPU has them (R18), else in the form of RustCrypto's `sha2`
// 0.11.1 without the CPU's instructions (`soft/unroll.rs`): the 16 words of the block, each read with its
// highest byte first, before the first round; the 64 rounds written out, each with its constant K (4.2.2)
// in the code, as `sha2` gives it on x86; and the word of the schedule of a round from round 16 on written
// in place of the word of the round 16 before it, so that the schedule is 16 words and takes no room in
// the state.
void Sha256Block(byte* s, byte* p) {
    if X86.Sha.IsSupported && X86.Sse41.IsSupported {
        Sha256Instructions(s, p, 1)
        return
    }

    raw {
        uint* hash = Ptr<uint>(s)
        mut uint w0 = BigEndianWord(p)
        mut uint w1 = BigEndianWord(p + 4)
        mut uint w2 = BigEndianWord(p + 8)
        mut uint w3 = BigEndianWord(p + 12)
        mut uint w4 = BigEndianWord(p + 16)
        mut uint w5 = BigEndianWord(p + 20)
        mut uint w6 = BigEndianWord(p + 24)
        mut uint w7 = BigEndianWord(p + 28)
        mut uint w8 = BigEndianWord(p + 32)
        mut uint w9 = BigEndianWord(p + 36)
        mut uint w10 = BigEndianWord(p + 40)
        mut uint w11 = BigEndianWord(p + 44)
        mut uint w12 = BigEndianWord(p + 48)
        mut uint w13 = BigEndianWord(p + 52)
        mut uint w14 = BigEndianWord(p + 56)
        mut uint w15 = BigEndianWord(p + 60)
        mut uint a = hash[0]
        mut uint b = hash[1]
        mut uint c = hash[2]
        mut uint d = hash[3]
        mut uint e = hash[4]
        mut uint f = hash[5]
        mut uint g = hash[6]
        mut uint h = hash[7]
        Sha256Round(a, b, c, mut d, e, f, g, mut h, 0x428a2f98, w0)
        Sha256Round(h, a, b, mut c, d, e, f, mut g, 0x71374491, w1)
        Sha256Round(g, h, a, mut b, c, d, e, mut f, 0xb5c0fbcf, w2)
        Sha256Round(f, g, h, mut a, b, c, d, mut e, 0xe9b5dba5, w3)
        Sha256Round(e, f, g, mut h, a, b, c, mut d, 0x3956c25b, w4)
        Sha256Round(d, e, f, mut g, h, a, b, mut c, 0x59f111f1, w5)
        Sha256Round(c, d, e, mut f, g, h, a, mut b, 0x923f82a4, w6)
        Sha256Round(b, c, d, mut e, f, g, h, mut a, 0xab1c5ed5, w7)
        Sha256Round(a, b, c, mut d, e, f, g, mut h, 0xd807aa98, w8)
        Sha256Round(h, a, b, mut c, d, e, f, mut g, 0x12835b01, w9)
        Sha256Round(g, h, a, mut b, c, d, e, mut f, 0x243185be, w10)
        Sha256Round(f, g, h, mut a, b, c, d, mut e, 0x550c7dc3, w11)
        Sha256Round(e, f, g, mut h, a, b, c, mut d, 0x72be5d74, w12)
        Sha256Round(d, e, f, mut g, h, a, b, mut c, 0x80deb1fe, w13)
        Sha256Round(c, d, e, mut f, g, h, a, mut b, 0x9bdc06a7, w14)
        Sha256Round(b, c, d, mut e, f, g, h, mut a, 0xc19bf174, w15)
        w0 = Sha256Word(w0, w1, w9, w14)
        Sha256Round(a, b, c, mut d, e, f, g, mut h, 0xe49b69c1, w0)
        w1 = Sha256Word(w1, w2, w10, w15)
        Sha256Round(h, a, b, mut c, d, e, f, mut g, 0xefbe4786, w1)
        w2 = Sha256Word(w2, w3, w11, w0)
        Sha256Round(g, h, a, mut b, c, d, e, mut f, 0x0fc19dc6, w2)
        w3 = Sha256Word(w3, w4, w12, w1)
        Sha256Round(f, g, h, mut a, b, c, d, mut e, 0x240ca1cc, w3)
        w4 = Sha256Word(w4, w5, w13, w2)
        Sha256Round(e, f, g, mut h, a, b, c, mut d, 0x2de92c6f, w4)
        w5 = Sha256Word(w5, w6, w14, w3)
        Sha256Round(d, e, f, mut g, h, a, b, mut c, 0x4a7484aa, w5)
        w6 = Sha256Word(w6, w7, w15, w4)
        Sha256Round(c, d, e, mut f, g, h, a, mut b, 0x5cb0a9dc, w6)
        w7 = Sha256Word(w7, w8, w0, w5)
        Sha256Round(b, c, d, mut e, f, g, h, mut a, 0x76f988da, w7)
        w8 = Sha256Word(w8, w9, w1, w6)
        Sha256Round(a, b, c, mut d, e, f, g, mut h, 0x983e5152, w8)
        w9 = Sha256Word(w9, w10, w2, w7)
        Sha256Round(h, a, b, mut c, d, e, f, mut g, 0xa831c66d, w9)
        w10 = Sha256Word(w10, w11, w3, w8)
        Sha256Round(g, h, a, mut b, c, d, e, mut f, 0xb00327c8, w10)
        w11 = Sha256Word(w11, w12, w4, w9)
        Sha256Round(f, g, h, mut a, b, c, d, mut e, 0xbf597fc7, w11)
        w12 = Sha256Word(w12, w13, w5, w10)
        Sha256Round(e, f, g, mut h, a, b, c, mut d, 0xc6e00bf3, w12)
        w13 = Sha256Word(w13, w14, w6, w11)
        Sha256Round(d, e, f, mut g, h, a, b, mut c, 0xd5a79147, w13)
        w14 = Sha256Word(w14, w15, w7, w12)
        Sha256Round(c, d, e, mut f, g, h, a, mut b, 0x06ca6351, w14)
        w15 = Sha256Word(w15, w0, w8, w13)
        Sha256Round(b, c, d, mut e, f, g, h, mut a, 0x14292967, w15)
        w0 = Sha256Word(w0, w1, w9, w14)
