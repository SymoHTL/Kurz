        t[60] = 0xf7537e82
        t[61] = 0xbd3af235
        t[62] = 0x2ad7d2bb
        t[63] = 0xeb86d391
        uint* shifts = Ptr<uint>(s + 344)
        shifts[0] = 7
        shifts[1] = 12
        shifts[2] = 17
        shifts[3] = 22
        shifts[4] = 5
        shifts[5] = 9
        shifts[6] = 14
        shifts[7] = 20
