// The standard library's Kurz code (design record, section 2; the owner, 2026-10-24, "A std/ directory
// now"), which the compiler compiles with every program, as it compiles the runtime: the allocator of
// section 3, the blocks of a list and of a string, the searches of a string and of a list of bytes, the
// trimming, the splitting, the replacing, the joining and the change of ASCII case of a string, and the
// hashes of section 12. It takes its memory from the system through the runtime's boundary call, reached
// as the folder `sys`, the directory of the target the program is built for, and the runtime reaches it
// as the folder `std`, through its allocation entry, `Allocate` (the owner, 2026-10-24, "As built";
// compiler/README.md, "The runtime"). The emitted code calls the functions of a list's block and of a
// string's.
use sys

// The memory the allocator carves blocks from, and the bytes left behind it, of each thread (R13).
thread static mut byte* chunk = null
thread static mut long left = 0

// The first free block of each size class of each thread, as its address, 0 where the class has none:
// fifteen classes, the powers of two from 16 to 262144 bytes, in a table carved at the thread's first
// allocation of no more than 262144 bytes. A free block holds the address of the next free block of
// its class in its first 8 bytes.
thread static mut long* heads = null

// The blocks of more than 262144 bytes that each thread freed and keeps (the owner, 2026-10-30, "Keep
// them, as glibc"): the first of them, null where it keeps none, and the bytes they take, at most
// 33554432, 32 mebibytes, as glibc's malloc serves from its heap, where it keeps what is freed, the
// requests below a threshold that a freed block of up to that size raises. Such a block starts with a
// header of 16 bytes, the bytes the system gave it and, while it is kept, the address of the kept block
// after it; what the allocation entry gives out starts after the header.
thread static mut byte* kept = null
thread static mut long keptBytes = 0

// The size class of a request of at most 262144 bytes, counted from 0: the smallest power of two from
// 16 that holds it.
long Class(long size) {
    mut long k = 0
    mut long room = 16
    while room < size {
        room = room * 2
        k = k + 1
    }

    return k
}

// `room` bytes carved from the thread's memory, which takes a new piece of a mebibyte from the system
// where the rest of the piece is too small; null where the system refuses. The rest of a piece left
// behind is not carved again.
byte* Carve(long room) {
    mut byte* p = null
    raw {
        if room > left {
            chunk = sys.Memory(1048576)
            left = 1048576
            if chunk == null {
                left = 0
            }
        }

        if chunk != null {
            p = chunk
            chunk = chunk + room
            left = left - room
        }
    }

    return p
}

// The table of the thread's size classes, carved at its first use from memory the system gave
// zeroed, so every class starts without a free block; null where the system refuses.
long* Heads() {
    mut long* table = null
    raw {
        if heads == null {
            heads = Ptr<long>(Carve(128))
        }

        table = heads
    }

    return table
}

// The smallest block the thread keeps that holds `bytes` bytes, its header among them, and takes no
// more than twice them, its own header among its bytes, taken out of the kept blocks, as glibc's malloc
// takes the smallest free chunk that holds a large request; null where none does, and the request takes
// memory of its own from the system (the owner, 2026-10-30, "Only if at least half used"). glibc splits
// the chunk and keeps its rest; Kurz gives the block out whole, its header naming its size, since a
// block the system gave goes back to it only whole on Windows, and a list grown into it grows without
// the system, so a request takes a kept block only where it uses at least half of it.
byte* Reused(long bytes) {
    mut byte* best = null
    raw {
        mut byte* before = null
        mut byte* previous = null
        mut byte* at = kept
        while at != null {
            long room = *Ptr<long>(at)
            if room >= bytes && room <= bytes * 2 && (best == null || room < *Ptr<long>(best)) {
                best = at
                before = previous
            }

            previous = at
            at = Ptr<byte>(*Ptr<long>(at + 8))
        }

        if best != null {
            if before == null {
                kept = Ptr<byte>(*Ptr<long>(best + 8))
            } else {
                *Ptr<long>(before + 8) = *Ptr<long>(best + 8)
            }

            keptBytes = keptBytes - *Ptr<long>(best)
        }
    }

    return best
}

// The allocation entry (design record, section 2): `size` bytes, at an address that is a multiple of
// 16. A request of more than 262144 bytes takes the smallest block the thread keeps that holds it and
// takes no more than twice its bytes, else memory of its own from the system, each with its header in
// front. A smaller one takes a block of its size class: the one of that class freed last, or one carved
// from the thread's memory, whose pieces the system gives a mebibyte at a time. A block used again holds
// what was written into it before. Null where the system refuses, for which the runtime's `Allocate`
// ends the process (the owner, 2026-10-24, "Null, runtime ends it"), as Rust's `GlobalAlloc::alloc`
// returns null and its callers that cease execution are encouraged to call `handle_alloc_error`.
pub byte* Allocate(long size) {
    mut byte* p = null
    if size > 262144 {
        long bytes = (size + 15) / 16 * 16 + 16
        p = Reused(bytes)
        raw {
            if p == null {
                p = sys.Memory(bytes)
                if p != null {
                    *Ptr<long>(p) = bytes
                }
            }

            if p != null {
                p = p + 16
            }
        }

        return p
    }

    long* table = Heads()
    raw {
        if table != null {
            long k = Class(size)
            long head = table[k]
            if head != 0 {
                p = Ptr<byte>(head)
                table[k] = *Ptr<long>(p)
            } else {
                mut long room = 16
                mut long i = 0
                while i < k {
                    room = room * 2
                    i = i + 1
                }

                p = Carve(room)
            }
        }
    }

    return p
}

// A block the allocation entry gave, given back with the `size` it was asked for, as Rust's
// `GlobalAlloc::dealloc` takes the layout a block was allocated with: a block of more than 262144
// bytes to the front of the blocks the thread keeps, where its bytes, as its header names them, fit
// within the 33554432 the kept blocks may take, else to the system; a smaller one to the front of its
// size class's free blocks, where a request of that class takes it first. Where the table of size
// classes cannot be carved, the block is not used again.
pub void Free(byte* p, long size) {
    if size > 262144 {
        raw {
            byte* block = p - 16
            long bytes = *Ptr<long>(block)
            if keptBytes + bytes <= 33554432 {
                *Ptr<long>(block + 8) = long(kept)
                kept = block
                keptBytes = keptBytes + bytes
            } else {
                sys.Release(block, bytes)
            }
        }

        return
    }

    long* table = Heads()
    raw {
        if table != null {
            long k = Class(size)
            *Ptr<long>(p) = table[k]
            table[k] = long(p)
        }
    }
}

// A block the allocation entry gave for `size` bytes, grown to `grown` bytes with the bytes it holds, as
// Rust's `GlobalAlloc::realloc`: a block of more than 262144 bytes is itself where its header names
// room enough, as a kept block given out whole may, as glibc's `realloc` leaves a mapped chunk that
// holds the size, else grown by the target's `Resize`, which can grow it without a copy, as the C
// library's `realloc` grows a block it mapped; else, and where `Resize` gives null, a new block with the
// bytes copied and the old one freed. Null where the system refuses, the block then left as it was.
pub byte* Reallocate(byte* p, long size, long grown) {
    if size > 262144 {
        long bytes = (grown + 15) / 16 * 16 + 16
        mut byte* moved = null
        raw {
            byte* block = p - 16
            long room = *Ptr<long>(block)
            if bytes <= room {
                moved = p
            } else {
                byte* q = sys.Resize(block, room, bytes)
                if q != null {
                    *Ptr<long>(q) = bytes
                    moved = q + 16
                }
            }
        }

        if moved != null {
            return moved
        }
    }

    byte* q = Allocate(grown)
    if q == null {
        return null
    }

    raw {
        mut long i = 0
        while i < size {
            q[i] = p[i]
            i = i + 1
        }
    }

    Free(p, size)
    return q
}

// The block of a list (M9, R15). A list value is the address of its block, null for a list without
// items, which takes no block, as Rust's `Vec::new` allocates nothing. A block holds the count of the
// list values that hold it, 8 bytes, the count of its items and the count it has room for, 4 bytes
// each, and from its 16th byte the items, each `item` bytes, as the item's type is laid out. A list
// value is copied without its items, and a write into a block that other values hold first copies
// the block (M3: storage is shared until one side writes; section 3: the counting is inserted by the
// compiler). The emitted code holds the counts of the items' own blocks.

// The count of the list's items.
pub int ListCount(byte* block) {
    mut int count = 0
    raw {
        if block != null {
            count = *Ptr<int>(block + 8)
        }
    }

    return count
}

// The address of the list's first item, of a list that has one.
pub byte* ListItems(byte* block) {
    mut byte* items = null
    raw {
        items = block + 16
    }

    return items
}

// One more list value holds the block.
pub void ListRetain(byte* block) {
    raw {
        if block != null {
            *Ptr<long>(block) = *Ptr<long>(block) + 1
        }
    }
}

// One list value less holds the block: whether it was the last, after which the caller lets go of
// the items' own blocks and frees the block with `ListFree`.
pub bool ListRelease(byte* block) {
    mut bool last = false
    raw {
        if block != null {
            long count = *Ptr<long>(block) - 1
            *Ptr<long>(block) = count
            last = count == 0
        }
    }

    return last
}

// The block given back to the allocator, its room counted in items of `item` bytes.
pub void ListFree(byte* block, long item) {
    mut long room = 0
    raw {
        room = long(*Ptr<int>(block + 12))
    }

    Free(block, 16 + room * item)
}

// Whether the list can take one more item in place: it has a block, no other list value holds it,
// and it has room.
pub bool ListHasRoom(byte* block) {
    mut bool room = false
    raw {
        if block != null {
            room = *Ptr<long>(block) == 1 && *Ptr<int>(block + 8) < *Ptr<int>(block + 12)
        }
    }

    return room
}

// Whether another list value holds the block too.
pub bool ListShared(byte* block) {
    mut bool shared = false
    raw {
        if block != null {
            shared = *Ptr<long>(block) > 1
        }
    }

    return shared
}

// The room a full block grows to, as Rust's `Vec` grows: twice its room, at least 8 items of a byte,
// 4 of up to a kibibyte and 1 of more, at most the largest `int`.
long Grown(long room, long item) {
    mut long first = 1
    if item == 1 {
        first = 8
    } else if item <= 1024 {
        first = 4
    }

    mut long grown = room * 2
    if grown < first {
        grown = first
    }

    if grown > 2147483647 {
        grown = 2147483647
    }

    return grown
}

// A new block, held by one list value, with the `count` items of `block` and room for one more: its
// room where it has room left, else the grown room. A list holds at most the largest `int` of items
// (M9): one more gives null, with `asked` set to the count after the `Add` times `item` (the owner,
// 2026-10-24, "Items after the Add"); a block the system refuses gives null, with `asked` set to the
// bytes asked for.
byte* Moved(byte* block, long count, long room, long item, mut long asked) {
    if count == 2147483647 {
        asked = (count + 1) * item
        return null
    }

    mut long grown = room
    if count == room {
        grown = Grown(room, item)
    }

    long bytes = 16 + grown * item
    mut byte* p = null
    raw {
        p = Allocate(bytes)
        if p == null {
            asked = bytes
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(grown)
            long n = count * item
            mut long i = 0
            while i < n {
                p[16 + i] = block[16 + i]
                i = i + 1
            }
        }
    }

    return p
}

// For an `Add` to a list no other value holds: a block with room for one more item, the block itself
// where it has room, else the block grown by `Reallocate`, as Rust's `Vec` grows its buffer by
// `realloc`; a first block for a list without one, as `Moved` gives it. Null, with `asked` set, as
// `Moved` gives it.
pub byte* ListGrow(byte* block, long item, mut long asked) {
    mut long count = 0
    mut long room = 0
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
        }
    }

    if count < room {
        return block
    }

    if block == null || count == 2147483647 {
        return Moved(block, count, room, item, mut asked)
    }

    long grown = Grown(room, item)
    long bytes = 16 + grown * item
    byte* p = Reallocate(block, 16 + room * item, bytes)
    raw {
        if p == null {
            asked = bytes
        } else {
            *Ptr<int>(p + 12) = int(grown)
        }
    }

    return p
}

// For a write to a block other list values hold (M3): a copy of its items' bytes with room for one
// more, the old block held by one value less, which never frees it. The caller counts the copied
// items' own blocks. Null, with `asked` set, as `Moved` gives it.
pub byte* ListCopy(byte* block, long item, mut long asked) {
    mut long count = 0
    mut long room = 0
    raw {
        count = long(*Ptr<int>(block + 8))
        room = long(*Ptr<int>(block + 12))
    }

    byte* p = Moved(block, count, room, item, mut asked)
    if p != null {
        raw {
            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// The address the next item goes to, in a block with room for it, whose count of items it raises by
// one. The count, never negative, is read as a `uint`, so that the item's offset widens without
// a sign: in a loop of `Add`s the count the `Add` before stored is then read back by a plain load, not a
// sign-extending one (`EmitterTests` pins the widening).
pub byte* ListPush(byte* block, long item) {
    mut byte* slot = null
    raw {
        uint count = *Ptr<uint>(block + 8)
        *Ptr<uint>(block + 8) = count + 1
        slot = block + 16 + long(count) * item
    }

    return slot
}

// For a read into a list of bytes (S3): a block with room for `more` bytes after its own that no other
// list value holds, as Rust's `Vec::reserve` makes room before a read: the block itself where it has the
// room and no other value holds it, else a new block with its bytes, the old block freed, or held by one
// value less where other values hold it (M3). A new block has the room of the old one where that holds
// `more` bytes after them, else the larger of the room a full block grows to and the count and `more`.
// Null for a list without a block and `more` 0, which needs none. A count and `more` past the largest
// `int` give null with `asked` set to their sum, the bytes of the items, as an `Add` past it does (M9);
// a block the system refuses gives null with `asked` set to the bytes asked for.
pub byte* BytesReserve(byte* block, long more, mut long asked) {
    mut long count = 0
    mut long room = 0
    mut bool shared = false
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
            shared = *Ptr<long>(block) > 1
        }
    }

    if count + more > 2147483647 {
        asked = count + more
        return null
    }

    if !shared && room - count >= more {
        return block
    }

    mut long grown = room
    if room - count < more {
        grown = Grown(room, 1)
        if grown < count + more {
            grown = count + more
        }
    }

    long size = 16 + grown
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(grown)
            mut long i = 0
            while i < count {
                p[16 + i] = block[16 + i]
                i = i + 1
            }
        }
    }

    if p != null && block != null {
        if shared {
            raw {
                *Ptr<long>(block) = *Ptr<long>(block) - 1
            }
        } else {
            Free(block, 16 + room)
        }
    }

    return p
}

// The room a read of a whole file makes before its first read (S6): the size the system names for the
// open file, as Rust's `fs::read` reserves the size the file's metadata gives, no more than the largest
// `int` of items, so that a larger file is read up to the list's limit and the byte after it raises
// `allocation-failed` (M9). A size of 0, and a failure, below 0, make no room, as no size does in Rust's.
pub long BytesHint(long size) {
    if size > 2147483647 {
        return 2147483647
    }

    return size
}

// The bytes the next read of a whole file asks for (S6): the room a list of bytes has after its own;
// 0 for a list full at `hint`, the size `BytesHint` gave, as Rust's `read_to_end` reads a probe
// into a buffer of its own where its `Vec` is full at the room it started with, so that a file of that
// size is read without the list grown; else `piece` more, as Rust's `read_to_end` reads into the room
// its `Vec` has before it grows it, and no more than the largest `int` of items leaves, so that a file
// a list holds is read whole; 0 for a list that holds that many.
pub long BytesPiece(byte* block, long piece, long hint) {
    mut long count = 0
    mut long room = 0
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
        }
    }

    if room > count {
        return room - count
    }

    if hint > 0 && count == hint {
        return 0
    }

    if piece > 2147483647 - count {
        return 2147483647 - count
    }

    return piece
}

// The address after the last byte of a list of bytes, where a read puts the bytes it adds; null for a
// list without a block.
pub byte* BytesEnd(byte* block) {
    mut byte* end = null
    raw {
        if block != null {
            end = block + 16 + long(*Ptr<int>(block + 8))
        }
    }

    return end
}

// The count of a list of bytes raised by the `count` bytes a read put after its own, in its room; a
// list without a block takes no byte.
pub void BytesAdded(byte* block, long count) {
    raw {
        if block != null {
            *Ptr<int>(block + 8) = *Ptr<int>(block + 8) + int(count)
        }
    }
}

// The count of the list's items set to 0 and its room kept, for `Clear` (M9) on a list no other value
// holds, whose items' own blocks the caller let go of; nothing for a list without a block.
pub void ListClear(byte* block) {
    raw {
        if block != null {
            *Ptr<int>(block + 8) = 0
        }
    }
}

// For an `AddRange` (X9): a block with room for `more` items of `item` bytes after its own that no
// other list value holds, as Rust's `Vec::reserve` makes room before `extend_from_slice` copies: the
// block itself where it has the room and no other value holds it; a block no other value holds grown by
// `Reallocate`; else a new block with its items, the old block held by one value less (M3), never freed
// here, whose caller counts the copied items' own blocks. A new or grown block has the room of the old
// one where that holds `more` items after them, else the larger of the room a full block grows to and
// the count and `more`. A count and `more` past the largest `int` give null with `asked` set to the
// bytes of that many items, as an `Add` past it does (M9); a block the system refuses gives null with
// `asked` set to the bytes asked for.
pub byte* ListReserve(byte* block, long more, long item, mut long asked) {
    mut long count = 0
    mut long room = 0
    mut bool shared = false
    raw {
        if block != null {
            count = long(*Ptr<int>(block + 8))
            room = long(*Ptr<int>(block + 12))
            shared = *Ptr<long>(block) > 1
        }
    }

    if count + more > 2147483647 {
        asked = (count + more) * item
        return null
    }

    if !shared && room - count >= more {
        return block
    }

    mut long grown = room
    if room - count < more {
        grown = Grown(room, item)
        if grown < count + more {
            grown = count + more
        }
    }

    long bytes = 16 + grown * item
    if block != null && !shared {
        byte* q = Reallocate(block, 16 + room * item, bytes)
        raw {
            if q == null {
                asked = bytes
            } else {
                *Ptr<int>(q + 12) = int(grown)
            }
        }

        return q
    }

    mut byte* p = null
    raw {
        p = Allocate(bytes)
        if p == null {
            asked = bytes
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(grown)
            long n = count * item
            mut long i = 0
            while i < n {
                p[16 + i] = block[16 + i]
                i = i + 1
            }
        }
    }

    if p != null && shared {
        raw {
            *Ptr<long>(block) = *Ptr<long>(block) - 1
        }
    }

    return p
}

// The `count` items of `item` bytes at `items` put after the items of a block with room for them,
// whose count of items it raises by `count` (X9); the caller counts the items' own blocks.
pub void ListAppend(byte* block, byte* items, long count, long item) {
    raw {
        long at = 16 + long(*Ptr<int>(block + 8)) * item
        long n = count * item
        mut long i = 0
        while i < n {
            block[at + i] = items[i]
            i = i + 1
        }

        *Ptr<int>(block + 8) = *Ptr<int>(block + 8) + int(count)
    }
}

// A new block, held by one list value, with a copy of the `count` items at `items`, each `item` bytes,
// and room for them: the part of a list (M9) and the bytes of a literal string (T15), whose items' own
// blocks the caller counts. Null for no items, and null with `asked` set to the bytes asked for where
// the system refuses.
pub byte* ListOf(byte* items, long count, long item, mut long asked) {
    if count == 0 {
        return null
    }

    long size = 16 + count * item
    mut byte* p = null
    raw {
        p = Allocate(size)
        if p == null {
            asked = size
        } else {
            *Ptr<long>(p) = 1
            *Ptr<int>(p + 8) = int(count)
            *Ptr<int>(p + 12) = int(count)
            long n = count * item
            mut long i = 0
            while i < n {
                p[16 + i] = items[i]
                i = i + 1
            }
        }
    }

    return p
}

// The room for `count` items of `item` bytes in a new block, held by one list value, with no items,
// which `List<T>.FromRaw` takes over (R15): the address of its first item. More items than the
// largest `int` give null with `asked` set to the bytes of those items (M9); a block the system
// refuses gives null with `asked` set to the bytes asked for.
pub byte* ListAllocate(long count, long item, mut long asked) {
    if count > 2147483647 {
        asked = count * item
        return null
    }

    long size = 16 + count * item
    mut byte* p = null
    raw {
        byte* block = Allocate(size)
        if block == null {
            asked = size
        } else {
            *Ptr<long>(block) = 1
            *Ptr<int>(block + 8) = 0
            *Ptr<int>(block + 12) = int(count)
            p = block + 16
        }
    }

    return p
}

// The block of the items at `items`, which `ListAllocate` gave, holding `count` items: the list
// `List<T>.FromRaw` makes (R15).
pub byte* ListTakeOver(byte* items, long count) {
    mut byte* block = null
    raw {
        block = items - 16
        *Ptr<int>(block + 8) = int(count)
    }

    return block
}

// The address of the first item of a list's block, as a string's bytes, held by one more value: the
// string `string.FromUtf8` makes of a list of bytes, which shares its block (T15). Null for a list
// without a block.
pub byte* ListString(byte* block) {
    if block == null {
        return null
    }

    ListRetain(block)
    return ListItems(block)
}

// The block of a string (T15, R15), laid out as the block of a list of bytes, so that `s.Bytes` and a
// string made of a list share it (section 4): the count of the values that hold it, 8 bytes, the count
// of its bytes and the count of bytes it has room for, 4 bytes each, and from its 16th byte the bytes.
// A string value is the address of its bytes and their count, whose highest bit marks a string that
// holds such a block; a literal and the empty string hold none and are never freed (design record,
// section 4). A string never changes, so no write copies a block; the emitted code counts the values
// that hold one, and a list value that holds one copies it before it writes, as for any block other
// values hold (M3).

// A block of room for `size` bytes, held by one string value: the address of its bytes, null where
// the system refuses.
pub byte* StringBlock(long size) {
    mut byte* bytes = null
    raw {
        byte* block = Allocate(16 + size)
        if block != null {
            *Ptr<long>(block) = 1
            *Ptr<int>(block + 8) = 0
            *Ptr<int>(block + 12) = int(size)
            bytes = block + 16
        }
    }

    return bytes
}

// One more string value holds the block of the bytes.
pub void StringRetain(byte* bytes) {
    raw {
        *Ptr<long>(bytes - 16) = *Ptr<long>(bytes - 16) + 1
    }
}

// One string value less holds the block of the bytes: whether it was the last, after which the caller
// frees it with `StringFree`.
pub bool StringRelease(byte* bytes) {
    mut bool last = false
    raw {
        long count = *Ptr<long>(bytes - 16) - 1
        *Ptr<long>(bytes - 16) = count
        last = count == 0
    }

    return last
}

// The count of the `count` bytes at `bytes`, which `string.Allocate` gave, written into their block:
// what `string.FromRaw` takes over (R15).
pub void StringTakeOver(byte* bytes, long count) {
    raw {
        *Ptr<int>(bytes - 8) = int(count)
    }
}

// The block of a string's bytes, held by one more value, as a list of bytes: `s.Bytes` of a string that
// holds a block (T15).
pub byte* StringList(byte* bytes) {
    mut byte* block = null
    raw {
        block = bytes - 16
    }

    ListRetain(block)
    return block
}

// The block of the bytes given back to the allocator.
pub void StringFree(byte* bytes) {
    mut long room = 0
    raw {
        room = long(*Ptr<int>(bytes - 4))
    }

    Free(bytes - 16, 16 + room)
}

// The searches of a string and of a list of bytes (X1, X9), over the bytes of each, as Rust's
// `str::find` searches a string's: the position of the first `m` bytes at `needle` among the `n` bytes
// at `hay`, or -1 where they stand nowhere there; an `m` of 0 is found at 0. One byte is looked for
// byte by byte, as `memchr` looks; more take the two-way search of `TwoWay`, which reads no byte of
// `hay` more than a bounded number of times, so that no input makes a search slower than linear.
pub long Find(byte* hay, long n, byte* needle, long m) {
    if m == 0 {
        return 0
    }

    if m > n {
        return -1
    }

    if m > 1 {
        return TwoWay(hay, n, needle, m)
    }

    mut long found = -1
    raw {
        byte b = needle[0]
        mut long i = 0
        while i < n {
            if hay[i] == b {
                found = i
                break
            }

            i = i + 1
        }
    }

    return found
}

// Whether the `m` bytes at `needle` stand at the position `at` among the `n` bytes at `hay`: false
// for a position below 0 and one after which fewer than `m` bytes stand (X1).
pub bool BytesAt(byte* hay, long n, byte* needle, long m, long at) {
    if at < 0 || at > n - m {
        return false
    }

    mut bool same = true
    raw {
        mut long i = 0
        while i < m {
            if hay[at + i] != needle[i] {
                same = false
                break
            }

            i = i + 1
        }
    }

    return same
}

// The UTF-8 bytes of the code point `point` written at `bytes`, one to four, as `TextOfChar` writes
// them: their count. A `char` searched for is searched for as these bytes (X1).
pub long Utf8(uint point, byte* bytes) {
    mut long count = 4
    if point < 128 {
        count = 1
    } else if point < 2048 {
        count = 2
    } else if point < 65536 {
        count = 3
    }

    raw {
        if count == 1 {
            bytes[0] = byte(point)
        } else if count == 2 {
            bytes[0] = byte(192 | (point >> 6))
            bytes[1] = byte(128 | (point & 63))
        } else if count == 3 {
            bytes[0] = byte(224 | (point >> 12))
            bytes[1] = byte(128 | ((point >> 6) & 63))
            bytes[2] = byte(128 | (point & 63))
        } else {
            bytes[0] = byte(240 | (point >> 18))
            bytes[1] = byte(128 | ((point >> 12) & 63))
            bytes[2] = byte(128 | ((point >> 6) & 63))
            bytes[3] = byte(128 | (point & 63))
        }
    }

    return count
}

// The start of the maximal suffix of the `m` bytes at `x` under the order of bytes, or under its
// reverse where `greater` is set, as Crochemore and Perrin compute it, with its period in `period`.
long MaximalSuffix(byte* x, long m, bool greater, mut long period) {
    mut long start = 0
    mut long other = 1
    mut long offset = 0
    period = 1
    raw {
        while other + offset < m {
            byte a = x[other + offset]
            byte b = x[start + offset]
            if (a < b && !greater) || (a > b && greater) {
                other = other + offset + 1
                offset = 0
                period = other - start
            } else if a == b {
                if offset + 1 == period {
                    other = other + offset + 1
                    offset = 0
                } else {
                    offset = offset + 1
                }
            } else {
                start = other
                other = other + 1
                offset = 0
                period = 1
            }
        }
    }

    return start
}

// The two-way search of Crochemore and Perrin, as Rust's `TwoWaySearcher` runs it, for `m` bytes,
// from 2 to `n`. The needle is cut at its critical position, the later start of its two maximal
// suffixes. A window of `hay` is compared right of the cut first, and a mismatch there moves the
// window past it; then left of the cut, and a mismatch there moves the window by the period. Where
// the part left of the cut repeats at the period, the search remembers how much of the needle the last
// move kept matched and compares it no more; else it moves by more than either part. A set of the low
// six bits of the needle's bytes, of its first period where it repeats, moves the window by the whole
// needle where its last byte is none of them.
long TwoWay(byte* hay, long n, byte* needle, long m) {
    mut long periodLess = 0
    mut long periodGreater = 0
    long critLess = MaximalSuffix(needle, m, false, mut periodLess)
    long critGreater = MaximalSuffix(needle, m, true, mut periodGreater)
    mut long crit = critGreater
    mut long period = periodGreater
    if critLess > critGreater {
        crit = critLess
        period = periodLess
    }

    mut bool periodic = period + crit <= m
    mut ulong set = 0UL
    mut long found = -1
    raw {
        mut long k = 0
        while periodic && k < crit {
            if needle[k] != needle[period + k] {
                periodic = false
            }

            k = k + 1
        }

        mut long setEnd = m
        if periodic {
            setEnd = period
        }

        mut long s = 0
        while s < setEnd {
            set = set | 1UL << int(needle[s] & 63)
            s = s + 1
        }

        if !periodic {
            period = crit
            if m - crit > period {
                period = m - crit
            }

            period = period + 1
        }

        mut long position = 0
        mut long memory = 0
        while found < 0 && position + m <= n {
            byte tail = hay[position + m - 1]
            if ((set >> int(tail & 63)) & 1UL) == 0UL {
                position = position + m
                memory = 0
            } else {
                mut long i = crit
                if periodic && memory > i {
                    i = memory
                }

                while i < m && needle[i] == hay[position + i] {
                    i = i + 1
                }

                if i < m {
                    position = position + i - crit + 1
                    memory = 0
                } else {
                    mut long j = crit
                    mut long low = 0
                    if periodic {
                        low = memory
                    }

                    while j > low && needle[j - 1] == hay[position + j - 1] {
                        j = j - 1
                    }

                    if j > low {
                        position = position + period
                        if periodic {
                            memory = m - period
                        }
                    } else {
                        found = position
                    }
                }
            }
        }
    }

    return found
}

// The trimming, the splitting, the replacing, the joining and the change of ASCII case of a string (X3,
// X4, X5, X6), over its bytes, as Rust's `str` methods work on a string's bytes. A trim gives the positions of the
// part it keeps, of which the emitted code makes a string: the string itself where it keeps every byte,
// the bytes in place where the string holds no block, a literal, whose bytes are never freed, else a
// copy (`StringOf`). The others give the bytes of a new string's block, or the block of a list of
// strings, and count what they make before they make it, as Rust's `join` sums the lengths before it
// copies, so that each block is asked for once.

// The count of a string value's bytes with the mark of a string that holds a block in its highest bit,
// as a string value is laid out (T15).
long Marked(long count) {
    return count | (-9223372036854775807 - 1)
}

// The `count` bytes at `from` written at `to`.
void Copy(byte* to, byte* from, long count) {
    raw {
        mut long i = 0
        while i < count {
            to[i] = from[i]
            i = i + 1
        }
    }
}

// The length of the character of Unicode's White_Space that starts at `at` among the `n` bytes at
// `bytes`, as Rust's `char::is_whitespace` reads it: the tab, the line feed, the vertical tab, the form
// feed, the carriage return, the space, U+0085, U+00A0, U+1680, U+2000 to U+200A, U+2028, U+2029, U+202F,
// U+205F and U+3000; where `ascii` is set, of ASCII's whitespace, the five of Rust's
// `u8::is_ascii_whitespace`, which leave out the vertical tab (X4). 0 where none starts there.
long WhiteAt(byte* bytes, long n, long at, bool ascii) {
    mut long length = 0
    raw {
        int b = int(bytes[at])
        if b == 32 || b == 9 || b == 10 || b == 12 || b == 13 || (b == 11 && !ascii) {
            length = 1
        } else if !ascii && b == 194 && at + 1 < n {
            int c = int(bytes[at + 1])
            if c == 133 || c == 160 {
                length = 2
            }
        } else if !ascii && b >= 225 && b <= 227 && at + 2 < n {
            int c = int(bytes[at + 1])
            int d = int(bytes[at + 2])
            if b == 225 && c == 154 && d == 128 {
                length = 3
            } else if b == 226 && c == 128 && ((d >= 128 && d <= 138) || d == 168 || d == 169 || d == 175) {
                length = 3
            } else if b == 226 && c == 129 && d == 159 {
                length = 3
            } else if b == 227 && c == 128 && d == 128 {
                length = 3
            }
        }
    }

    return length
}

// The length of the character of `WhiteAt` that ends at `end` among the bytes at `bytes`, and starts no
// earlier than `start`; 0 where none ends there. A byte below 128 is a character of its own and a byte
// from 192 starts one, so the bytes of a whole character that end at `end` start where it starts.
long WhiteBefore(byte* bytes, long start, long end, bool ascii) {
    mut long length = 0
    mut long k = 1
    while k <= 3 && end - k >= start {
        if WhiteAt(bytes, end, end - k, ascii) == k {
            length = k
            break
        }

        k = k + 1
    }

    return length
}

// `s.TrimStart()` and `s.TrimStartAscii()` (X4): the position of the first byte after the whitespace that
// starts the `n` bytes at `bytes`, as Rust's `trim_start` and `trim_ascii_start`.
pub long TrimStart(byte* bytes, long n, bool ascii) {
    mut long at = 0
    while at < n {
        long length = WhiteAt(bytes, n, at, ascii)
        if length == 0 {
            break
        }

        at = at + length
    }

    return at
}

// `s.TrimEnd()` and `s.TrimEndAscii()` (X4): the position after the last byte before the whitespace that
// ends the bytes from `start` to `end` at `bytes`, as Rust's `trim_end` and `trim_ascii_end`.
pub long TrimEnd(byte* bytes, long start, long end, bool ascii) {
    mut long at = end
    while at > start {
        long length = WhiteBefore(bytes, start, at, ascii)
        if length == 0 {
            break
        }

        at = at - length
    }

    return at
}

// `s.Trim(c)` (X4): the position of the first byte after the repeats of the `m` bytes at `run`, the UTF-8
// bytes of a character, that start the `n` bytes at `bytes`, as Rust's `trim_start_matches(c)`.
pub long RunStart(byte* bytes, long n, byte* run, long m) {
    mut long at = 0
    while BytesAt(bytes, n, run, m, at) {
        at = at + m
    }

    return at
}

// `s.Trim(c)` (X4): the position after the last byte before the repeats of the `m` bytes at `run` that end
// the bytes from `start` to `end` at `bytes`, as Rust's `trim_end_matches(c)`.
pub long RunEnd(byte* bytes, long start, long end, byte* run, long m) {
    mut long at = end
    while at - m >= start && BytesAt(bytes, end, run, m, at - m) {
        at = at - m
    }

    return at
}

// A new string's block with a copy of the `count` bytes at `bytes`, held by one string value: the address
// of its bytes; null with `asked` set where the system refuses (M9).
pub byte* StringOf(byte* bytes, long count, mut long asked) {
    byte* text = StringBlock(count)
    if text == null {
        asked = 16 + count
        return null
    }

    Copy(text, bytes, count)
    StringTakeOver(text, count)
    return text
}

// `s.Split(separator)` (X5): the block of a new list of the pieces of the `n` bytes at `bytes` between the
// `m` bytes at `separator`, from the left, an empty piece kept, as Rust's `split`, each a string laid out
// as a string value is, 16 bytes, which the list holds. A piece is the string itself, held once more,
// where the separator stands nowhere or is empty (the owner, 2026-10-31, "No piece, no change"); an empty
// piece holds no bytes; a piece of a string that holds no block, a literal, is its bytes in place, which
// are never freed; else it is a copy (`StringOf`). `block` says whether the string holds one. Null with
// `asked` set where the system refuses, after the blocks made for the list are given back, and for more
// pieces than the largest `int`, with `asked` set to the bytes of their list (M9).
pub byte* Split(byte* bytes, long n, bool block, byte* separator, long m, mut long asked) {
    mut long count = 1
    raw {
        mut long at = 0
        while m > 0 && at <= n {
            long found = Find(bytes + at, n - at, separator, m)
            if found < 0 {
                break
            }

            count = count + 1
            at = at + found + m
        }
    }

    byte* items = ListAllocate(count, 16, mut asked)
    if items == null {
        return null
    }

    mut long made = 0
    raw {
        mut long start = 0
        while made < count {
            mut long end = n
            if made < count - 1 {
                end = start + Find(bytes + start, n - start, separator, m)
            }

            long length = end - start
            mut byte* piece = bytes + start
            mut long marked = length
            if length == n && block {
                StringRetain(bytes)
                marked = Marked(n)
            } else if length > 0 && block {
                piece = StringOf(bytes + start, length, mut asked)
                if piece == null {
                    break
                }

                marked = Marked(length)
            }

            *Ptr<long>(items + made * 16) = long(piece)
            *Ptr<long>(items + made * 16 + 8) = marked
            made = made + 1
            start = end + m
        }
    }

    if made == count {
        return ListTakeOver(items, count)
    }

    raw {
        mut long i = 0
        while i < made {
            if *Ptr<long>(items + i * 16 + 8) < 0 {
                byte* piece = Ptr<byte>(*Ptr<long>(items + i * 16))
                if StringRelease(piece) {
                    StringFree(piece)
                }
            }

            i = i + 1
        }

        ListFree(items - 16, 16)
    }

    return null
}

// `s.Replace(old, replacement)` (X5): the bytes of a new string's block, the `n` bytes at `bytes` with each
// `m` bytes at `old`, found from the left, none overlapping the one before, replaced by the `k` bytes at
// `replacement`, as Rust's `replace`, with their count in `made`. `made` is -1 where the string stays as
// it is, for an empty `old` (the owner, 2026-10-31, "No piece, no change") and for one found nowhere, and 0
// for an empty result, each with null. More bytes than the largest `int` give null with `asked` set to
// their count, as a string past it does (T15); a block the system refuses gives null with `asked` set to
// the bytes asked for. A caller reads `asked` first: where it is set, `made` is -1 and means nothing.
pub byte* Replace(byte* bytes, long n, byte* old, long m, byte* replacement, long k, mut long made, mut long asked) {
    made = -1
    mut long count = 0
    raw {
        mut long at = 0
        while m > 0 && at <= n {
            long found = Find(bytes + at, n - at, old, m)
            if found < 0 {
                break
            }

            count = count + 1
            at = at + found + m
        }
    }

    if count == 0 {
        return null
    }

    long size = n + count * (k - m)
    if size > 2147483647 {
        asked = size
        return null
    }

    if size == 0 {
        made = 0
        return null
    }

    byte* text = StringBlock(size)
    if text == null {
        asked = 16 + size
        return null
    }

    raw {
        mut long at = 0
        mut long to = 0
        mut long found = Find(bytes, n, old, m)
        while found >= 0 {
            Copy(text + to, bytes + at, found)
            Copy(text + to + found, replacement, k)
            to = to + found + k
            at = at + found + m
            found = Find(bytes + at, n - at, old, m)
        }

        Copy(text + to, bytes + at, n - at)
    }

    StringTakeOver(text, size)
    made = size
    return text
}

// `string.Join(separator, values)` (X6): the bytes of a new string's block with the `count` texts at
// `texts`, each laid out as a string value is, 16 bytes, and the `m` bytes at `separator` between two of
// them, as Rust's `join`, with their count in `made`: 0, with null, for an empty result. More bytes than
// the largest `int` give null with `asked` set to their count (T15); a block the system refuses gives null
// with `asked` set to the bytes asked for.
pub byte* Join(byte* texts, long count, byte* separator, long m, mut long made, mut long asked) {
    made = 0
    if count == 0 {
        return null
    }

    mut long size = m * (count - 1)
    raw {
        mut long i = 0
        while i < count {
            size = size + (*Ptr<long>(texts + i * 16 + 8) & 9223372036854775807)
            i = i + 1
        }
    }

    if size > 2147483647 {
        asked = size
        return null
    }

    if size == 0 {
        return null
    }

    byte* text = StringBlock(size)
    if text == null {
        asked = 16 + size
        return null
    }

    raw {
        mut long to = 0
        mut long i = 0
        while i < count {
            if i > 0 {
                Copy(text + to, separator, m)
                to = to + m
            }

            long length = *Ptr<long>(texts + i * 16 + 8) & 9223372036854775807
            Copy(text + to, Ptr<byte>(*Ptr<long>(texts + i * 16)), length)
            to = to + length
            i = i + 1
        }
    }

    StringTakeOver(text, size)
    made = size
    return text
}

// `s.ToLowerAscii()` and `s.ToUpperAscii()` (X3): the bytes of a new string's block, the `n` bytes at
// `bytes` with `A` to `Z` lowered, or `a` to `z` raised where `upper` is set, every other byte as it is, as
// Rust's `to_ascii_lowercase` and `to_ascii_uppercase`. Null where no byte changes, for the string as it
// is, and null with `asked` set where the system refuses.
pub byte* AsciiCase(byte* bytes, long n, bool upper, mut long asked) {
    mut int low = 65
    if upper {
        low = 97
    }

    mut bool changes = false
    raw {
        mut long i = 0
        while i < n {
            int b = int(bytes[i])
            if b >= low && b < low + 26 {
                changes = true
                break
            }

            i = i + 1
        }
    }

    if !changes {
        return null
    }

    byte* text = StringBlock(n)
    if text == null {
        asked = 16 + n
        return null
    }

    raw {
        mut long i = 0
        while i < n {
            int b = int(bytes[i])
            if b >= low && b < low + 26 {
                text[i] = byte(b ^ 32)
            } else {
                text[i] = bytes[i]
            }

            i = i + 1
        }
    }

    StringTakeOver(text, n)
    return text
}

// `s.ToLower()` and `s.ToUpper()` (X3): the bytes of a new string's block, the `n` bytes at `bytes` with each
// code point changed by Unicode's full mapping, as Rust's `to_lowercase` and `to_uppercase`, and their number
// in `made`. `table` is the emitter's table of the direction (`CaseMapped`). The bytes before the first code
// point that changes are copied as they are into a block of the input's size, as Rust's `convert_while_ascii`
// takes `Vec::with_capacity(slice.len())` for `to_lowercase` and `to_uppercase`, and the code points after them
// are looked up and written one at a time, as Rust's walk of the rest pushes them, up to one whose mapping makes
// more bytes than the block has room for: from that one on, `CaseWalk` sizes the rest, the block is grown once
// by `Reallocate`, and `CaseWalk` writes the rest, each walk looking those code points up again. Null where no
// code point changes, for the string as it is, and null with `asked` set where the system refuses.
pub byte* UnicodeCase(byte* bytes, long n, bool upper, int* table, mut long made, mut long asked) {
    mut long at = 0
    mut long width = 0
    mut int c = 0
    mut int first = 0
    mut int second = 0
    mut int third = 0
    while at < n {
        c = CaseCodeAt(bytes, at, mut width)
        second = 0
        third = 0
        if c < 128 {
            first = CaseAscii(c, upper)
        } else if c < 256 {
            first = CaseLatin(c, upper, mut second)
        } else {
            first = CaseOf(bytes, n, at, c, upper, table, mut second, mut third)
        }

        if first != c || second != 0 {
            break
        }

        at = at + width
    }

    if at == n {
        return null
    }

    mut long room = n
    mut byte* text = StringBlock(room)
    if text == null {
        asked = 16 + room
        return null
    }

    Copy(text, bytes, at)
    mut long length = at
    while at < n {
        mut long size = CaseWrite(first, null, 0)
        if second != 0 {
            size = size + CaseWrite(second, null, 0)
        }

        if third != 0 {
            size = size + CaseWrite(third, null, 0)
        }

        if length + size > room {
            // the rest sized and written by `CaseWalk`, the block grown once to hold it
            long rest = CaseWalk(bytes, n, at, upper, table, null)
            byte* grown = CaseGrow(text, room, length + rest)
            if grown == null {
                StringFree(text)
                asked = 16 + length + rest
                return null
            }

            text = grown
            room = length + rest
            raw {
                CaseWalk(bytes, n, at, upper, table, text + length)
            }

            length = room
            break
        }

        length = length + CaseWrite(first, text, length)
        if second != 0 {
            length = length + CaseWrite(second, text, length)
        }

        if third != 0 {
            length = length + CaseWrite(third, text, length)
        }

        at = at + width
        if at < n {
            c = CaseCodeAt(bytes, at, mut width)
            second = 0
            third = 0
            if c < 128 {
                first = CaseAscii(c, upper)
            } else if c < 256 {
                first = CaseLatin(c, upper, mut second)
            } else {
                first = CaseOf(bytes, n, at, c, upper, table, mut second, mut third)
            }
        }
    }

    StringTakeOver(text, length)
    made = length
    return text
}

// The block of the string bytes at `text`, which has room for `room` bytes, grown by `Reallocate` to room for
// `grown`, its bytes kept: the address of the bytes, null where the system refuses, the block then left as it was.
byte* CaseGrow(byte* text, long room, long grown) {
    mut byte* moved = null
    raw {
        byte* block = Reallocate(text - 16, 16 + room, 16 + grown)
        if block != null {
            *Ptr<int>(block + 12) = int(grown)
            moved = block + 16
        }
    }

    return moved
}

// The first code point Unicode's full mapping of one direction gives the code point `c` above Latin-1, which
// starts at `at` among the `n` bytes at `bytes`, with the second and the third in `second` and `third`
// (`CaseMapped`). A
// capital sigma lowers to the final form where it ends a word (`CaseFinalSigma`), the one mapping of Unicode's
// that reads the characters around it and no language.
int CaseOf(byte* bytes, long n, long at, int c, bool upper, int* table, mut int second, mut int third) {
    if upper || c != 931 {
        return CaseMapped(c, upper, table, mut second, mut third)
    }

    if CaseFinalSigma(bytes, n, at, table) {
        return 962
    }

    return 963
}

// The number of bytes `UnicodeCase` makes of the `n` bytes at `bytes` from `from` on, written to `out` where it
// is not null.
long CaseWalk(byte* bytes, long n, long from, bool upper, int* table, byte* out) {
    mut long at = from
    mut long length = 0
    while at < n {
        mut long width = 0
        int c = CaseCodeAt(bytes, at, mut width)
        mut int second = 0
        mut int third = 0
        mut int first = 0
        if c < 128 {
            first = CaseAscii(c, upper)
        } else if c < 256 {
            first = CaseLatin(c, upper, mut second)
        } else {
            first = CaseOf(bytes, n, at, c, upper, table, mut second, mut third)
        }

        length = length + CaseWrite(first, out, length)
        if second != 0 {
            length = length + CaseWrite(second, out, length)
        }

        if third != 0 {
            length = length + CaseWrite(third, out, length)
        }

        at = at + width
    }

    return length
}

// The code point whose UTF-8 starts at `at` among the bytes at `bytes`, and the number of its bytes in
// `width`. A string holds valid UTF-8 (T15), so the bytes after the first are there.
int CaseCodeAt(byte* bytes, long at, mut long width) {
    mut int c = 0
    raw {
        int b = int(bytes[at])
        if b < 128 {
            c = b
            width = 1
        } else if b < 224 {
            c = ((b & 31) << 6) | (int(bytes[at + 1]) & 63)
            width = 2
        } else if b < 240 {
            c = ((b & 15) << 12) | ((int(bytes[at + 1]) & 63) << 6) | (int(bytes[at + 2]) & 63)
            width = 3
        } else {
            c = ((b & 7) << 18) | ((int(bytes[at + 1]) & 63) << 12) | ((int(bytes[at + 2]) & 63) << 6) | (int(bytes[at + 3]) & 63)
            width = 4
        }
    }

    return c
}

// The number of bytes of the code point `c` in UTF-8, written to `out` from `at` where `out` is not null.
long CaseWrite(int c, byte* out, long at) {
    mut long width = 4
    if c < 128 {
        width = 1
    } else if c < 2048 {
        width = 2
    } else if c < 65536 {
        width = 3
    }

    if out != null {
        raw {
            if width == 1 {
                out[at] = byte(c)
            } else if width == 2 {
                out[at] = byte(192 | (c >> 6))
                out[at + 1] = byte(128 | (c & 63))
            } else if width == 3 {
                out[at] = byte(224 | (c >> 12))
                out[at + 1] = byte(128 | ((c >> 6) & 63))
                out[at + 2] = byte(128 | (c & 63))
            } else {
                out[at] = byte(240 | (c >> 18))
                out[at + 1] = byte(128 | ((c >> 12) & 63))
                out[at + 2] = byte(128 | ((c >> 6) & 63))
                out[at + 3] = byte(128 | (c & 63))
            }
        }
    }

    return width
}

// The ASCII code point `c` in one direction, its letters changed: what `CaseMapped` gives it, and what the walks
// take before they call `CaseOf`, which stays a call (knowledge/a-helper-of-several-callers-stays-a-call.md).
int CaseAscii(int c, bool upper) {
    if upper && c >= 97 && c <= 122 {
        return c - 32
    }

    if !upper && c >= 65 && c <= 90 {
        return c + 32
    }

    return c
}

// The first code point Unicode's full mapping of one direction gives the code point `c` of Latin-1 above ASCII,
// from 128 to 255, and the second in `second`, as Rust's `conversions::to_lower` and `to_upper` give them without
// their table: lowered, U+00C0 to U+00DE but U+00D7 32 up; raised, U+00B5 into U+039C, U+00DF into two `S`,
// U+00E0 to U+00FE but U+00F7 32 down and U+00FF into U+0178; every other code point itself. What `CaseMapped`
// gives it, and what the walks take before they call `CaseOf`.
int CaseLatin(int c, bool upper, mut int second) {
    if !upper {
        if c >= 192 && c <= 222 && c != 215 {
            return c + 32
        }

        return c
    }

    if c >= 224 && c <= 254 && c != 247 {
        return c - 32
    }

    if c == 181 {
        return 924
    }

    if c == 223 {
        second = 83
        return 83
    }

    if c == 255 {
        return 376
    }

    return c
}

// The first code point Unicode's full mapping of one direction gives `c`, and the second and the third in
// `second` and `third`, 0 where there are none, as Rust's `conversions::to_lower` and `to_upper` look them up:
// ASCII by its letters; above it, the run of `table` that holds `c`, found by a binary search, where `c` is a
// code point of the run's step, else the mapping to several code points, found by a second search, else `c`
// itself. `table` holds four counts, of the runs, of those mappings and of the ranges of Cased and
// Case_Ignorable, then the runs, four numbers each (the first and the last code point, the step, 1 or 2, and
// the delta), the mappings, four each (the code point and the code points it gives, 0 after the last), and the
// ranges, two each (`CaseIn`).
int CaseMapped(int c, bool upper, int* table, mut int second, mut int third) {
    if c < 128 {
        return CaseAscii(c, upper)
    }

    if c < 256 {
        return CaseLatin(c, upper, mut second)
    }

    mut int result = c
    raw {
        long runs = long(table[0])
        mut long low = 0
        mut long high = runs
        mut bool found = false
        while low < high {
            long middle = (low + high) / 2
            long run = 4 + 4 * middle
            if c < table[run] {
                high = middle
            } else if c > table[run + 1] {
                low = middle + 1
            } else {
                if table[run + 2] == 1 || (c - table[run]) % 2 == 0 {
                    result = c + table[run + 3]
                    found = true
                }

                break
            }
        }

        if !found {
            long multis = 4 + 4 * runs
            low = 0
            high = long(table[1])
            while low < high {
                long middle = (low + high) / 2
                long entry = multis + 4 * middle
                if c < table[entry] {
                    high = middle
                } else if c > table[entry] {
                    low = middle + 1
                } else {
                    result = table[entry + 1]
                    second = table[entry + 2]
                    third = table[entry + 3]
                    break
                }
            }
        }
    }

    return result
}

// Whether `c` is in a property of `table` (`CaseMapped`): the ranges of Cased where `ignorable` is false, of
// Case_Ignorable where it is set, found by a binary search.
bool CaseIn(int c, int* table, bool ignorable) {
    mut bool found = false
    raw {
        mut long start = 4 + 4 * long(table[0]) + 4 * long(table[1])
        mut long high = long(table[2])
        if ignorable {
            start = start + 2 * high
            high = long(table[3])
        }

        mut long low = 0
        while low < high {
            long middle = (low + high) / 2
            long range = start + 2 * middle
            if c < table[range] {
                high = middle
            } else if c > table[range + 1] {
                low = middle + 1
            } else {
                found = true
                break
            }
        }
    }

    return found
}

// Whether the capital sigma whose two bytes start at `at` among the `n` bytes at `bytes` ends a word, as
// Rust's `map_uppercase_sigma` reads Unicode's Final_Sigma: past the case-ignorable characters, a cased one
// before it and none after it.
bool CaseFinalSigma(byte* bytes, long n, long at, int* table) {
    mut long end = at
    mut bool before = false
    while end > 0 {
        mut long start = end - 1
        raw {
            while start > 0 && (int(bytes[start]) & 192) == 128 {
                start = start - 1
            }
        }

        mut long width = 0
        int c = CaseCodeAt(bytes, start, mut width)
        if !CaseIn(c, table, true) {
            before = CaseIn(c, table, false)
            break
        }

        end = start
    }

    if !before {
        return false
    }

    mut long next = at + 2
    while next < n {
        mut long width = 0
        int c = CaseCodeAt(bytes, next, mut width)
        if !CaseIn(c, table, true) {
            return !CaseIn(c, table, false)
        }

        next = next + width
    }

    return true
}

// Where `s.Substring(startIndex, length)` cannot cut the string whose bytes are at `bytes`, `count` of
// them (X2): -2 where the part reaches outside the string, a `startIndex` or a `length` below 0 among
// them, which is read first; else the position, the start before the end, that falls inside a code
// point, on a byte of the form 10xxxxxx, which a UTF-8 sequence has after its first byte alone (T15), as
// Rust's `&s[a..b]` reads a cut; and -1 where the cut stands.
pub long SubstringCut(byte* bytes, long count, long startIndex, long length) {
    if startIndex < 0 || length < 0 || startIndex > count || length > count - startIndex {
        return -2
    }

    long end = startIndex + length
    mut long inside = -1
    raw {
        if startIndex < count && (int(bytes[startIndex]) & 192) == 128 {
            inside = startIndex
        } else if end < count && (int(bytes[end]) & 192) == 128 {
            inside = end
        }
    }

    return inside
}

// Whether the byte `b` is whitespace around a number (X7): the tab, the line feed, the vertical tab, the
// form feed, the carriage return and the space, as C#'s `NumberStyles.Integer` takes them.
bool NumberWhite(int b) {
    return b == 32 || (b >= 9 && b <= 13)
}

// An integer read from the `count` bytes at `text` in C#'s Integer style with the invariant culture (X7):
// whitespace around it, a leading `+` or `-`, and one decimal digit or more. `most` is the largest value
// of the type and `least` the magnitude of its smallest, 0 for an unsigned type, so that `-0` reads as 0
// and `-1` lies below the range. -1 with the number in `magnitude`, or -2 with its magnitude there where
// a leading `-` was read, `"-0"` among them, whose magnitude is 0; else the index of the failure's `ParseKind`: 0, `Empty`, where the bytes hold nothing
// but whitespace; 1, `InvalidDigit`, where a byte stands that the form does not take, or no digit,
// which is read before the range, as C#'s `Parse` reads the whole string before it reports an overflow;
// 2, `TooLarge`, and 3, `TooSmall`, where the number lies past the largest or below the smallest value.
// Each digit is checked against the range before it is added, as Rust's `from_str_radix` checks its
// multiplication, so that no arithmetic leaves the range of a `ulong`.
pub int ParseInteger(byte* text, long count, ulong most, ulong least, mut ulong magnitude) {
    magnitude = 0
    mut long at = 0
    mut bool negative = false
    mut bool past = false
    mut long start = 0
    raw {
        while at < count && NumberWhite(int(text[at])) {
            at = at + 1
        }

        if at == count {
            return 0
        }

        if text[at] == 43 {
            at = at + 1
        } else if text[at] == 45 {
            negative = true
            at = at + 1
        }

        mut ulong limit = most
        if negative {
            limit = least
        }

        start = at
        while at < count && text[at] >= 48 && text[at] <= 57 {
            ulong digit = ulong(int(text[at]) - 48)
            if !past {
                if magnitude > limit / 10 || (magnitude == limit / 10 && digit > limit % 10) {
                    past = true
                } else {
                    magnitude = magnitude * 10 + digit
                }
            }

            at = at + 1
        }

        if at > start {
            while at < count && NumberWhite(int(text[at])) {
                at = at + 1
            }
        }
    }

    if at == start || at != count {
        return 1
    }

    if past && negative {
        return 3
    }

    if past {
        return 2
    }

    if negative {
        return -2
    }

    return -1
}

// Whether the `length` bytes at `p` spell, in any case, the lower-case ASCII letters packed in `word`, the
// first in its highest byte: `Infinity` and `NaN`, as C#'s `Parse` reads them with the invariant culture (X7).
bool Spells(byte* p, ulong word, int length) {
    mut int i = 0
    raw {
        while i < length {
            if (int(p[i]) | 32) != int((word >> ((length - 1 - i) * 8)) & 255UL) {
                return false
            }

            i = i + 1
        }
    }

    return true
}

// A floating-point number read from the `count` bytes at `text` in C#'s invariant form (X7): whitespace
// around it, a leading `+` or `-`, then digits, with `,` anywhere after the first of them before the point, a
// point and the digits after it, one digit at least, and an `e` or `E` with a sign and one digit or more; or
// the words `Infinity` and `NaN` in any case after the sign, as C#'s `double.Parse` reads them with the
// invariant culture. 0, `Empty`, where the bytes hold whitespace alone; 1, `InvalidDigit`, for any other form;
// 2 for `Infinity` and 3 for `NaN`; else -1, with the sign in `negative`, the first 19 significant digits in
// `mantissa`, the power of ten they stand at in `exponent`, and in `many` whether a digit that is not 0 follows
// them, as Rust's `parse_number` reads the digits; for the slow path, where the digits start and end, `from`
// and `to`, and the written exponent, `power`, whose digits stop counting past 65536, as Rust's stop.
int ScanFloating(byte* text, long count, mut bool negative, mut ulong mantissa, mut long exponent, mut bool many, mut long from, mut long to, mut long power) {
    mut long at = 0
    mut int taken = 0
    mut bool digits = false
    mut bool point = false
    raw {
        while at < count && NumberWhite(int(text[at])) {
            at = at + 1
        }

        if at == count {
            return 0
        }

        if text[at] == 43 {
            at = at + 1
        } else if text[at] == 45 {
            negative = true
            at = at + 1
        }

        from = at
        while at < count {
            int b = int(text[at])
            if b >= 48 && b <= 57 {
                digits = true
                if taken == 0 && b == 48 {
                    if point {
                        exponent = exponent - 1
                    }
                } else if taken < 19 {
                    mantissa = mantissa * 10UL + ulong(b - 48)
                    taken = taken + 1
                    if point {
                        exponent = exponent - 1
                    }
                } else {
                    many = many || b != 48
                    if !point {
                        exponent = exponent + 1
                    }
                }
            } else if b == 46 && !point {
                point = true
            } else if b != 44 || !digits || point {
                break
            }

            at = at + 1
        }

        to = at
        if !digits {
            if point {
                return 1
            }

            mut int kind = 1
            if count - at >= 8 && Spells(text + at, 0x696E66696E697479UL, 8) {
                kind = 2
                at = at + 8
            } else if count - at >= 3 && Spells(text + at, 0x6E616EUL, 3) {
                kind = 3
                at = at + 3
            }

            while at < count && NumberWhite(int(text[at])) {
                at = at + 1
            }

            if kind == 1 || at != count {
                return 1
            }

            return kind
        }

        if at < count && (text[at] == 101 || text[at] == 69) {
            at = at + 1
            mut bool down = false
            if at < count && text[at] == 43 {
                at = at + 1
            } else if at < count && text[at] == 45 {
                down = true
                at = at + 1
            }

            long start = at
            while at < count && text[at] >= 48 && text[at] <= 57 {
                if power < 65536 {
                    power = power * 10 + long(int(text[at]) - 48)
                }

                at = at + 1
            }

            if at == start {
                return 1
            }

            if down {
                power = -power
            }

            exponent = exponent + power
        }

        while at < count && NumberWhite(int(text[at])) {
            at = at + 1
        }
    }

    if at != count {
        return 1
    }

    return -1
}

// `double.Parse` (X7): -1 with the bits of the `double` nearest to the number the `count` bytes at `text`
// hold, ties to even, as Rust's `f64::from_str` and .NET Core 3.0's `double.Parse` round it, an infinity past
// the largest and a zero below the smallest, each with the number's sign, and for `NaN`, with a sign or
// without, the NaN C# reads; else the index of the failure's `ParseKind`, 0 or 1 (`ScanFloating`). `digits` is
// the 768 bytes of the slow path, which the emitted code keeps on its stack, as Rust keeps its `Decimal`, and
// `fives` the table of the 128-bit powers of five Eisel-Lemire takes, two words for each power from 5^-342 to
// 5^308, the high one first, which the compiler writes into the program, as Rust's `POWER_OF_FIVE_128`.
pub int ParseDouble(byte* text, long count, byte* digits, ulong* fives, mut ulong bits) {
    mut bool negative = false
    mut ulong mantissa = 0UL
    mut long exponent = 0
    mut bool many = false
    mut long from = 0
    mut long to = 0
    mut long power = 0
    int read = ScanFloating(text, count, mut negative, mut mantissa, mut exponent, mut many, mut from, mut to, mut power)
    if read == 0 || read == 1 {
        return read
    }

    mut ulong sign = 0UL
    if negative {
        sign = 9223372036854775808UL
    }

    if read == 3 {
        bits = 0xFFF8000000000000UL
        return -1
    }

    if read == 2 {
        bits = sign | 0x7FF0000000000000UL
        return -1
    }

    // Clinger's fast path, as Rust's `try_fast_path`: a significand of 53 bits at most times or over a power of
    // ten a `double` holds exactly, 10^22 at most, rounds once; a power up to 10^37 is moved into the
    // significand first where it stays within 53 bits
    if !many && exponent >= -22 && exponent <= 37 && mantissa <= 9007199254740992UL {
        mut ulong whole = mantissa
        mut long ten = exponent
        if ten > 22 {
            ulong moved = TenPower(int(ten - 22))
            if whole <= 9007199254740992UL / moved {
                whole = whole * moved
                ten = 22
            }
        }

        if ten <= 22 {
            mut double value = double(whole)
            if ten < 0 {
                value = value / DoublePower(int(-ten))
            } else {
                value = value * DoublePower(int(ten))
            }

            raw {
                bits = sign | *Ptr<ulong>(&value)
            }

            return -1
        }
    }

    mut ulong f = 0UL
    int e = Nearest(mantissa, exponent, many, text, from, to, power, digits, fives, false, mut f)
    bits = sign | f | (ulong(e) << 52)
    return -1
}

// `float.Parse` (X7), as `ParseDouble` reads a `double`, with the bits of the `float` nearest to the number,
// rounded once, from its digits.
pub int ParseFloat(byte* text, long count, byte* digits, ulong* fives, mut uint bits) {
    mut bool negative = false
    mut ulong mantissa = 0UL
    mut long exponent = 0
    mut bool many = false
    mut long from = 0
    mut long to = 0
    mut long power = 0
    int read = ScanFloating(text, count, mut negative, mut mantissa, mut exponent, mut many, mut from, mut to, mut power)
    if read == 0 || read == 1 {
        return read
    }

    mut uint sign = 0U
    if negative {
        sign = 2147483648U
    }

    if read == 3 {
        bits = 0xFFC00000U
        return -1
    }

    if read == 2 {
        bits = sign | 0x7F800000U
        return -1
    }

    // Clinger's fast path for a `float`: 24 bits and 10^10, a power up to 10^17 moved into the significand
    if !many && exponent >= -10 && exponent <= 17 && mantissa <= 16777216UL {
        mut ulong whole = mantissa
        mut long ten = exponent
        if ten > 10 {
            ulong moved = TenPower(int(ten - 10))
            if whole <= 16777216UL / moved {
                whole = whole * moved
                ten = 10
            }
        }

        if ten <= 10 {
            mut float value = float(whole)
            if ten < 0 {
                value = value / FloatPower(int(-ten))
            } else {
                value = value * FloatPower(int(ten))
            }

            raw {
                bits = sign | *Ptr<uint>(&value)
            }

            return -1
        }
    }

    mut ulong f = 0UL
    int e = Nearest(mantissa, exponent, many, text, from, to, power, digits, fives, true, mut f)
    bits = sign | uint(f | (ulong(e) << 23))
    return -1
}

// 10^k as a `double`, k from 0 to 22, each exact.
double DoublePower(int k) => match k {
    0 => 1.0
    1 => 10.0
    2 => 100.0
    3 => 1000.0
    4 => 10000.0
    5 => 100000.0
    6 => 1000000.0
    7 => 10000000.0
    8 => 100000000.0
    9 => 1000000000.0
    10 => 10000000000.0
    11 => 100000000000.0
    12 => 1000000000000.0
    13 => 10000000000000.0
    14 => 100000000000000.0
    15 => 1000000000000000.0
    16 => 10000000000000000.0
    17 => 100000000000000000.0
    18 => 1000000000000000000.0
    19 => 10000000000000000000.0
    20 => 100000000000000000000.0
    21 => 1000000000000000000000.0
    else => 10000000000000000000000.0
}

// 10^k as a `float`, k from 0 to 10, each exact.
float FloatPower(int k) => match k {
    0 => 1f
    1 => 10f
    2 => 100f
    3 => 1000f
    4 => 10000f
    5 => 100000f
    6 => 1000000f
    7 => 10000000f
    8 => 100000000f
    9 => 1000000000f
    else => 10000000000f
}

// 10^k, k from 0 to 15.
ulong TenPower(int k) {
    mut ulong p = 1UL
    mut int i = 0
    while i < k {
        p = p * 10UL
        i = i + 1
    }

    return p
}

// The significand of the floating-point number nearest to `mantissa` times 10^`exponent`, ties to even, without
// its first bit, in `f`, and its biased exponent returned, the format's largest for an infinity: Eisel-Lemire
// on the 19 digits, and where it cannot settle the rounding, or where digits that are not 0 follow them and
// `mantissa + 1` would round otherwise, the slow path over every digit, as Rust's `dec2flt`. A `double` where
// `single` is false, a `float` where it is true.
int Nearest(ulong mantissa, long exponent, bool many, byte* text, long from, long to, long power, byte* digits, ulong* fives, bool single, mut ulong f) {
    mut int e = Lemire(exponent, mantissa, fives, single, mut f)
    if many && e >= 0 {
        mut ulong g = 0UL
        int above = Lemire(exponent, mantissa + 1UL, fives, single, mut g)
        if above != e || g != f {
            e = -1
        }
    }

    if e < 0 {
        e = Slow(text, from, to, power, digits, single, mut f)
    }

    return e
}

// The count of the zero bits above the first bit that is set, of a number that is not 0.
int LeadingZeros(ulong w) {
    mut int n = 0
    mut ulong v = w
    if v >> 32 == 0UL {
        n = n + 32
        v = v << 32
    }

    if v >> 48 == 0UL {
        n = n + 16
        v = v << 16
    }

    if v >> 56 == 0UL {
        n = n + 8
        v = v << 8
    }

    if v >> 60 == 0UL {
        n = n + 4
        v = v << 4
    }

    if v >> 62 == 0UL {
        n = n + 2
        v = v << 2
    }

    if v >> 63 == 0UL {
        n = n + 1
    }

    return n
}

// The 128-bit product of two 64-bit numbers, from the products of their 32-bit halves: the low 64 bits
// returned, the high 64 into `high`.
ulong Product(ulong a, ulong b, mut ulong high) {
    ulong a0 = a & 4294967295UL
    ulong a1 = a >> 32
    ulong b0 = b & 4294967295UL
    ulong b1 = b >> 32
    ulong b00 = a0 * b0
    ulong mid1 = a1 * b0 + (b00 >> 32)
    ulong mid2 = a0 * b1 + (mid1 & 4294967295UL)
    high = a1 * b1 + (mid1 >> 32) + (mid2 >> 32)
    return (mid2 << 32) | (b00 & 4294967295UL)
}

// Eisel-Lemire (Lemire, "Number Parsing at a Gigabyte per Second", 2021), as Rust's `compute_float`: the
// significand without its first bit in `f` and the biased exponent returned, of the floating-point number
// nearest to `w` times 10^`q`, ties to even, from the product of `w` and the 128-bit power of five of `q` in
// `fives` (`ParseDouble`); -1 where that product cannot settle the rounding. A `double` where `single` is false,
// a `float` where it is true.
int Lemire(long q, ulong w, ulong* fives, bool single, mut ulong f) {
    mut int explicit = 52
    mut int minimum = -1023
    mut int infinite = 2047
    mut long smallest = -342
    mut long largest = 308
    mut long evenLow = -4
    mut long evenHigh = 23
    if single {
        explicit = 23
        minimum = -127
        infinite = 255
        smallest = -65
        largest = 38
        evenLow = -17
        evenHigh = 10
    }

    f = 0UL
    if w == 0UL || q < smallest {
        return 0
    }

    if q > largest {
        return infinite
    }

    int lz = LeadingZeros(w)
    ulong v = w << lz
    // the product to explicit + 3 bits, as Rust's `compute_product_approx`: a second product, with the low
    // half of the power, where the first leaves those bits all set
    int row = int(q) + 342
    mut ulong upperFive = 0UL
    mut ulong lowerFive = 0UL
    raw {
        upperFive = fives[2 * row]
        lowerFive = fives[2 * row + 1]
    }

    ulong mask = 0xFFFFFFFFFFFFFFFFUL >> (explicit + 3)
    mut ulong high = 0UL
    mut ulong low = Product(v, upperFive, mut high)
    if (high & mask) == mask {
        mut ulong second = 0UL
        Product(v, lowerFive, mut second)
        low = low +% second
        if second > low {
            high = high + 1UL
        }
    }

    // the product may lie a unit too low only outside 5^-27 to 5^55, where it is not exact
    if low == 0xFFFFFFFFFFFFFFFFUL && (q < -27 || q > 55) {
        return -1
    }

    int upper = int(high >> 63)
    mut ulong m = high >> (upper + 64 - explicit - 3)
    mut int power = (((int(q) * 217706) >> 16) + 63) + upper - lz - minimum
    if power <= 0 {
        // a number below the smallest normal one: shifted into place and rounded, the smallest normal one where
        // the rounding carries
        if -power + 1 >= 64 {
            return 0
        }

        m = m >> (-power + 1)
        m = m + (m & 1UL)
        m = m >> 1
        f = m & ((1UL << explicit) - 1UL)
        if m >= 1UL << explicit {
            return 1
        }

        return 0
    }

    // a tie, which 5^q of 64 bits alone makes exact, rounds to the even significand
    if low <= 1UL && q >= evenLow && q <= evenHigh && (m & 3UL) == 1UL && (m << (upper + 64 - explicit - 3)) == high {
        m = m ^ 1UL
    }

    m = m + (m & 1UL)
    m = m >> 1
    if m >= 2UL << explicit {
        m = 1UL << explicit
        power = power + 1
    }

    if power >= infinite {
        return infinite
    }

    f = m & ((1UL << explicit) - 1UL)
    return power
}

// Rust's `parse_long_mantissa`, Nigel Tao's simple decimal conversion: the digits between `from` and `to` as a
// decimal of up to 768 digits in `d`, shifted by powers of two until it lies in [1/2, 1), then by the bits of
// the significand, and rounded, ties to even, the digits past the 768th counted as one that is not 0; the
// significand without its first bit in `f` and the biased exponent returned, as `Lemire` gives them.
int Slow(byte* text, long from, long to, long power, byte* d, bool single, mut ulong f) {
    mut int explicit = 52
    mut int minimum = -1023
    mut int infinite = 2047
    if single {
        explicit = 23
        minimum = -127
        infinite = 255
    }

    f = 0UL
    mut int n = 0
    mut int point = 0
    mut bool truncated = false
    ReadDigits(text, from, to, power, d, mut n, mut point, mut truncated)
    if n == 0 || point < -324 {
        return 0
    }

    if point >= 310 {
        return infinite
    }

    mut int exp2 = 0
    while point > 0 {
        int shift = Shift(point)
        RightShift(d, mut n, mut point, mut truncated, shift)
        if point < -2047 {
            return 0
        }

        exp2 = exp2 + shift
    }

    while point <= 0 {
        mut int shift = 0
        if point == 0 {
            mut int first = 0
            raw {
                first = int(d[0])
            }

            if first >= 5 {
                break
            }

            shift = 1
            if first < 2 {
                shift = 2
            }
        } else {
            shift = Shift(-point)
        }

        LeftShift(d, mut n, mut point, mut truncated, shift)
        if point > 2047 {
            return infinite
        }

        exp2 = exp2 - shift
    }

    exp2 = exp2 - 1
    while minimum + 1 > exp2 {
        mut int shift = minimum + 1 - exp2
        if shift > 60 {
            shift = 60
        }

        RightShift(d, mut n, mut point, mut truncated, shift)
        exp2 = exp2 + shift
    }

    if exp2 - minimum >= infinite {
        return infinite
    }

    LeftShift(d, mut n, mut point, mut truncated, explicit + 1)
    mut ulong m = RoundDecimal(d, n, point, truncated)
    if m >= 1UL << (explicit + 1) {
        RightShift(d, mut n, mut point, mut truncated, 1)
        exp2 = exp2 + 1
        m = RoundDecimal(d, n, point, truncated)
        if exp2 - minimum >= infinite {
            return infinite
        }
    }

    mut int e = exp2 - minimum
    if m < 1UL << explicit {
        e = e - 1
    }

    f = m & ((1UL << explicit) - 1UL)
    return e
}

// Rust's `get_shift`: a shift of the decimal by powers of two that moves its point by `n` digits at most.
int Shift(int n) => match n {
    0 => 0
    1 => 3
    2 => 6
    3 => 9
    4 => 13
    5 => 16
    6 => 19
    7 => 23
    8 => 26
    9 => 29
    10 => 33
    11 => 36
    12 => 39
    13 => 43
    14 => 46
    15 => 49
    16 => 53
    17 => 56
    18 => 59
    else => 60
}

// The digits between `from` and `to`, past a `,` and the point, as Rust's `parse_decimal` reads them: in `d`
// the significant ones, from the first that is not 0 to the last that is not 0, 768 at most, with `truncated`
// where more stand; in `n` their count; in `point` the power of ten the number is 0.d times, the written
// exponent `power` among it, held within 100000 either way.
void ReadDigits(byte* text, long from, long to, long power, byte* d, mut int n, mut int point, mut bool truncated) {
    mut long at = from
    mut long read = 0
    mut long last = 0
    mut long place = power
    mut bool before = true
    raw {
        while at < to {
            int b = int(text[at])
            if b == 46 {
                before = false
            } else if b != 44 {
                if read == 0 && b == 48 {
                    if !before {
                        place = place - 1
                    }
                } else {
                    if read < 768 {
                        d[read] = byte(b - 48)
                    }

                    read = read + 1
                    if b != 48 {
                        last = read
                    }

                    if before {
                        place = place + 1
                    }
                }
            }

            at = at + 1
        }
    }

    truncated = last > 768
    n = 768
    if last < 768 {
        n = int(last)
    }

    if place > 100000 {
        place = 100000
    } else if place < -100000 {
        place = -100000
    }

    point = int(place)
}

// Rust's `Decimal::round`: the integer part of the decimal, rounded half to even, the digits past the 768th
// counted as one that is not 0; all bits set where it has more than 18 digits.
ulong RoundDecimal(byte* d, int n, int point, bool truncated) {
    if n == 0 || point < 0 {
        return 0UL
    }

    if point > 18 {
        return 0xFFFFFFFFFFFFFFFFUL
    }

    mut ulong m = 0UL
    mut bool up = false
    raw {
        mut int i = 0
        while i < point {
            m = m * 10UL
            if i < n {
                m = m + ulong(d[i])
            }

            i = i + 1
        }

        if point < n {
            up = d[point] >= 5
            if d[point] == 5 && point + 1 == n {
                up = truncated || (point != 0 && (int(d[point - 1]) & 1) != 0)
            }
        }
    }

    if up {
        m = m + 1UL
    }

    return m
}

// Rust's `Decimal::left_shift`: the decimal times 2^`shift`, `shift` from 1 to 60, from its last digit to its
// first, the digits it adds counted first; a digit that is not 0 past the 768th sets `truncated`.
void LeftShift(byte* d, mut int n, mut int point, mut bool truncated, int shift) {
    if n == 0 {
        return
    }

    int added = NewDigits(d, n, shift)
    mut int read = n
    mut int write = n + added
    mut ulong carry = 0UL
    raw {
        while read != 0 {
            read = read - 1
            write = write - 1
            carry = carry + (ulong(d[read]) << shift)
            ulong quotient = carry / 10UL
            ulong remainder = carry - 10UL * quotient
            if write < 768 {
                d[write] = byte(remainder)
            } else if remainder > 0UL {
                truncated = true
            }

            carry = quotient
        }

        while carry > 0UL {
            write = write - 1
            ulong quotient = carry / 10UL
            ulong remainder = carry - 10UL * quotient
            if write < 768 {
                d[write] = byte(remainder)
            } else if remainder > 0UL {
                truncated = true
            }

            carry = quotient
        }
    }

    n = n + added
    if n > 768 {
        n = 768
    }

    point = point + added
    Trim(d, mut n)
}

// Rust's `number_of_digits_decimal_left_shift`: the digits a left shift by `shift` adds, one fewer where the
// decimal's digits lie below those of 5^`shift`.
int NewDigits(byte* d, int n, int shift) {
    int a = ShiftDigits(shift)
    int start = a & 2047
    int end = ShiftDigits(shift + 1) & 2047
    int added = a >> 11
    mut int i = 0
    raw {
        while i < end - start {
            if i >= n {
                return added - 1
            }

            int five = FiveDigit(start + i)
            if int(d[i]) != five {
                if int(d[i]) < five {
                    return added - 1
                }

                return added
            }

            i = i + 1
        }
    }

    return added
}

// The decimal digit at `at` of the digits `FiveDigits` holds, one after another.
int FiveDigit(int at) => int((FiveDigits(at / 16) >> ((15 - at % 16) * 4)) & 15UL)

// Rust's `Decimal::right_shift`: the decimal over 2^`shift`, `shift` from 1 to 60, from its first digit to its
// last; a digit that is not 0 past the 768th sets `truncated`, and a decimal whose point falls below -2047 is 0.
void RightShift(byte* d, mut int n, mut int point, mut bool truncated, int shift) {
    mut int read = 0
    mut int write = 0
    mut ulong carry = 0UL
    raw {
        while (carry >> shift) == 0UL {
            if read < n {
                carry = 10UL * carry + ulong(d[read])
                read = read + 1
            } else if carry == 0UL {
                return
            } else {
                while (carry >> shift) == 0UL {
                    carry = carry * 10UL
                    read = read + 1
                }

                break
            }
        }

        point = point - read + 1
        if point < -2047 {
            n = 0
            point = 0
            truncated = false
            return
        }

        ulong mask = (1UL << shift) - 1UL
        while read < n {
            byte digit = byte(carry >> shift)
            carry = 10UL * (carry & mask) + ulong(d[read])
            read = read + 1
            d[write] = digit
            write = write + 1
        }

        while carry > 0UL {
            byte digit = byte(carry >> shift)
            carry = 10UL * (carry & mask)
            if write < 768 {
                d[write] = digit
                write = write + 1
            } else if digit > 0 {
                truncated = true
            }
        }
    }

    n = write
    Trim(d, mut n)
}

// The decimal without the zeros after its last digit that is not 0.
void Trim(byte* d, mut int n) {
    raw {
        while n != 0 && d[n - 1] == 0 {
            n = n - 1
        }
    }
}

// The next digit at `at` or after it and before `to`, past a `,` and the point, with `at` moved after it; -1
// where none is left.
int NextDigit(byte* text, long to, mut long at) {
    raw {
        while at < to {
            int b = int(text[at])
            at = at + 1
            if b >= 48 && b <= 57 {
                return b - 48
            }
        }
    }

    return -1
}

// `decimal.Parse` (X7): -1 with the `decimal` the `count` bytes at `text` hold in its two words, `low`, the low
// 64 bits of its integer, and `high`, its high 32 bits with System.Decimal's flags above them, the scale in
// bits 48 to 55 and the sign in bit 63; else the index of the failure's `ParseKind`. The form is C#'s `Number`
// style with the invariant culture without its trailing sign: whitespace around the number, a leading `+` or
// `-`, digits with `,` anywhere after the first of them before the point, a point and the digits after it, one
// digit at least. The digits that fit in 96 bits at a scale of 28 at most are taken, and the number is rounded
// at the first digit that does not fit, half to even, every digit after it counted, as C#'s `decimal.Parse`
// rounds it (Number.NumberToDecimal); past the range after the rounding it is 2, `TooLarge`, or 3, `TooSmall`,
// where it is below 0. A zero keeps its scale, 28 at most, and its sign (§12, the owner, 2026-10-31, "-0.00,
// keep the sign").
pub int ParseDecimal(byte* text, long count, mut ulong low, mut ulong high) {
    mut long at = 0
    mut bool negative = false
    mut long first = -1
    mut long to = 0
    mut long e = 0
    mut long fraction = 0
    mut bool digits = false
    mut bool point = false
    raw {
        while at < count && NumberWhite(int(text[at])) {
            at = at + 1
        }

        if at == count {
            return 0
        }

        if text[at] == 43 {
            at = at + 1
        } else if text[at] == 45 {
            negative = true
            at = at + 1
        }

        // `e` counts the significant digits before the point, or else, below 0, the zeros after it before the
        // first digit that is not 0, as the scale of .NET's number buffer counts them
        while at < count {
            int b = int(text[at])
            if b >= 48 && b <= 57 {
                digits = true
                if point {
                    fraction = fraction + 1
                }

                if first < 0 && b == 48 {
                    if point {
                        e = e - 1
                    }
                } else {
                    if first < 0 {
                        first = at
                    }

                    if !point {
                        e = e + 1
                    }
                }
            } else if b == 46 && !point {
                point = true
            } else if b != 44 || !digits || point {
                break
            }

            at = at + 1
        }

        to = at
        while at < count && NumberWhite(int(text[at])) {
            at = at + 1
        }
    }

    if !digits || at != count {
        return 1
    }

    mut ulong sign = 0UL
    if negative {
        sign = 9223372036854775808UL
    }

    if first < 0 {
        mut long scale = fraction
        if scale > 28 {
            scale = 28
        }

        low = 0UL
        high = sign | (ulong(scale) << 48)
        return -1
    }

    mut int failed = 2
    if negative {
        failed = 3
    }

    if e > 29 {
        return failed
    }

    // the digits into 64 bits while the scale stays within 28, then into 96 bits while they fit, the integer
    // digits all, the first digit left over in `c`, as Number.NumberToDecimal takes them
    mut long position = first
    mut int c = NextDigit(text, to, mut position)
    mut ulong lo = 0UL
    while e > -28 {
        e = e - 1
        lo = lo * 10UL + ulong(c)
        c = NextDigit(text, to, mut position)
        if lo >= 1844674407370955161UL {
            break
        }

        if c < 0 {
            while e > 0 {
                e = e - 1
                lo = lo * 10UL
                if lo >= 1844674407370955161UL {
                    break
                }
            }

            break
        }
    }

    mut ulong hi = 0UL
    while (e > 0 || (c >= 0 && e > -28)) && (hi < 429496729UL || (hi == 429496729UL && (lo < 0x9999999999999999UL || (lo == 0x9999999999999999UL && c <= 5)))) {
        ulong part = (lo & 4294967295UL) * 10UL
        ulong carried = (lo >> 32) * 10UL + (part >> 32)
        lo = (part & 4294967295UL) + (carried << 32)
        hi = (carried >> 32) + hi * 10UL
        if c >= 0 {
            lo = lo +% ulong(c)
            if lo < ulong(c) {
                hi = hi + 1UL
            }

            c = NextDigit(text, to, mut position)
        }

        e = e - 1
    }

    // half to even: a 5 with nothing but zeros after it rounds to the even number
    if c >= 5 {
        mut bool up = true
        if c == 5 && (lo & 1UL) == 0UL {
            mut bool zeros = true
            c = NextDigit(text, to, mut position)
            while c >= 0 && zeros {
                zeros = c == 0
                c = NextDigit(text, to, mut position)
            }

            up = !zeros
        }

        if up {
            lo = lo +% 1UL
            if lo == 0UL {
                hi = hi + 1UL
                if hi == 4294967296UL {
                    // past 96 bits: the number one digit shorter, 2^96 / 10 rounded
                    lo = 0x999999999999999AUL
                    hi = 429496729UL
                    e = e + 1
                }
            }
        }
    }

    if e > 0 {
        return failed
    }

    if e <= -29 {
        lo = 0UL
        hi = 0UL
        e = -28
    }

    low = lo
    high = sign | (ulong(-e) << 48) | hi
    return -1
}

// For a left shift by `shift` bits, 1 to 60, the count of digits it adds, or one more than it adds
// where the digits of the number lie below those of 5^shift, in bits 11 up, and where the digits of
// 5^shift start in the sequence of `FiveDigits`, in bits 0 to 10, as Rust's `number_of_digits_decimal_left_shift`.
// A shift of 60 reads the start of entry 61 as the end of its digits, Rust's 0x051C, 1308; the count of 19 in
// bits 11 up of entry 61 belongs to 5^61, which no shift reads.
int ShiftDigits(int shift) => match shift {
    0 => 0
    1 => 2048
    2 => 2049
    3 => 2051
    4 => 4102
    5 => 4105
    6 => 4109
    7 => 6162
    8 => 6167
    9 => 6173
    10 => 8228
    11 => 8235
    12 => 8243
    13 => 8252
    14 => 10310
    15 => 10320
    16 => 10331
    17 => 12391
    18 => 12403
    19 => 12416
    20 => 14478
    21 => 14492
    22 => 14507
    23 => 14523
    24 => 16588
    25 => 16605
    26 => 16623
    27 => 18690
    28 => 18709
    29 => 18729
    30 => 20798
    31 => 20819
    32 => 20841
    33 => 20864
    34 => 22936
    35 => 22960
    36 => 22985
    37 => 25059
    38 => 25085
    39 => 25112
    40 => 27188
    41 => 27216
    42 => 27245
    43 => 27275
    44 => 29354
    45 => 29385
    46 => 29417
    47 => 31498
    48 => 31531
    49 => 31565
    50 => 33648
    51 => 33683
    52 => 33719
    53 => 33756
    54 => 35842
    55 => 35880
    56 => 35919
    57 => 38007
    58 => 38047
    59 => 38088
    60 => 40178
    61 => 40220
    else => 0
}

// The decimal digits of 5^1 to 5^61 one after another, 1351 of them, sixteen to a word, one to
// four bits, the first in the highest four: the hexadecimal digits of each word are the decimal ones. A
// left shift reads the 1308 digits of 5^1 to 5^60, as Rust's `TABLE_POW5` holds them; the 43 of 5^61
// after them are read by no shift.
ulong FiveDigits(int word) => match word {
