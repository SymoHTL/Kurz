        hash[1] = hash[1] +% b
        hash[2] = hash[2] +% c
        hash[3] = hash[3] +% d
        hash[4] = hash[4] +% e
        hash[5] = hash[5] +% f
        hash[6] = hash[6] +% g
        hash[7] = hash[7] +% h
    }
}

// Four rounds of SHA-256 with the SHA instructions (R18), as `sha2`'s `shani` backend writes them: the four
// words `w` with their constants `k` added, two rounds to an instruction, on the halves ABEF and CDGH.
void Sha256FourRounds(mut Vector128<uint> abef, mut Vector128<uint> cdgh, Vector128<uint> w, Vector128<uint> k) {
    raw {
        Vector128<uint> words = X86.Sse2.Add(w, k)
        cdgh = X86.Sha.Sha256TwoRounds(cdgh, abef, words)
        abef = X86.Sha.Sha256TwoRounds(abef, cdgh, X86.Sse2.Shuffle(words, 0x0E))
    }
}

// The next four words of SHA-256's schedule with the SHA instructions (R18), from the 16 before them, the
// oldest four in `w0` (FIPS 180-4, 6.2.2, step 1).
Vector128<uint> Sha256Schedule(Vector128<uint> w0, Vector128<uint> w1, Vector128<uint> w2, Vector128<uint> w3) {
    mut Vector128<uint> next = w3
    raw {
        next = X86.Sha.Sha256MessageSchedule2(X86.Sse2.Add(X86.Sha.Sha256MessageSchedule1(w0, w1), X86.Ssse3.AlignRight(w3, w2, 4)), w3)
    }

    return next
}

// The `count` blocks of 64 bytes at `p` through SHA-256's rounds into the hash at `s` with the SHA
// instructions (R18), as RustCrypto's `sha2` takes them in its `shani` backend: the hash held as the two
// halves the instructions take, ABEF and CDGH; each block's 16 words with their bytes turned to the highest
// first; the 16 rounds of four words written out, each with its four constants K (4.2.2) in the code, two
// rounds to an instruction; and from the fifth round of four on, its words made from the 16 before them in
// place of the oldest four (FIPS 180-4, 6.2.2). The caller tests the CPU for SHA and SSE4.1, which hold
// every instruction here.
void Sha256Instructions(byte* s, byte* p, long count) {
    raw {
        uint* hash = Ptr<uint>(s)
        Vector128<byte> turn = Vector128.Create(byte(3), byte(2), byte(1), byte(0), byte(7), byte(6), byte(5), byte(4), byte(11), byte(10), byte(9), byte(8), byte(15), byte(14), byte(13), byte(12))
        Vector128<uint> cdab = X86.Sse2.Shuffle(X86.Sse2.LoadVector128(hash), 0xB1)
        Vector128<uint> efgh = X86.Sse2.Shuffle(X86.Sse2.LoadVector128(hash + 4), 0x1B)
        mut Vector128<uint> abef = X86.Ssse3.AlignRight(cdab, efgh, 8)
        mut Vector128<uint> cdgh = X86.Sse41.Blend(efgh.AsUInt16(), cdab.AsUInt16(), 0xF0).AsUInt32()
        mut long b = 0
        while b < count {
            Vector128<uint> abefBefore = abef
            Vector128<uint> cdghBefore = cdgh
            byte* block = p + 64 * b
            mut Vector128<uint> w0 = X86.Ssse3.Shuffle(X86.Sse2.LoadVector128(block), turn).AsUInt32()
            mut Vector128<uint> w1 = X86.Ssse3.Shuffle(X86.Sse2.LoadVector128(block + 16), turn).AsUInt32()
            mut Vector128<uint> w2 = X86.Ssse3.Shuffle(X86.Sse2.LoadVector128(block + 32), turn).AsUInt32()
            mut Vector128<uint> w3 = X86.Ssse3.Shuffle(X86.Sse2.LoadVector128(block + 48), turn).AsUInt32()
            Sha256FourRounds(mut abef, mut cdgh, w0, Vector128.Create(uint(0x428a2f98), uint(0x71374491), uint(0xb5c0fbcf), uint(0xe9b5dba5)))
            Sha256FourRounds(mut abef, mut cdgh, w1, Vector128.Create(uint(0x3956c25b), uint(0x59f111f1), uint(0x923f82a4), uint(0xab1c5ed5)))
            Sha256FourRounds(mut abef, mut cdgh, w2, Vector128.Create(uint(0xd807aa98), uint(0x12835b01), uint(0x243185be), uint(0x550c7dc3)))
            Sha256FourRounds(mut abef, mut cdgh, w3, Vector128.Create(uint(0x72be5d74), uint(0x80deb1fe), uint(0x9bdc06a7), uint(0xc19bf174)))
            w0 = Sha256Schedule(w0, w1, w2, w3)
            Sha256FourRounds(mut abef, mut cdgh, w0, Vector128.Create(uint(0xe49b69c1), uint(0xefbe4786), uint(0x0fc19dc6), uint(0x240ca1cc)))
            w1 = Sha256Schedule(w1, w2, w3, w0)
            Sha256FourRounds(mut abef, mut cdgh, w1, Vector128.Create(uint(0x2de92c6f), uint(0x4a7484aa), uint(0x5cb0a9dc), uint(0x76f988da)))
            w2 = Sha256Schedule(w2, w3, w0, w1)
            Sha256FourRounds(mut abef, mut cdgh, w2, Vector128.Create(uint(0x983e5152), uint(0xa831c66d), uint(0xb00327c8), uint(0xbf597fc7)))
            w3 = Sha256Schedule(w3, w0, w1, w2)
            Sha256FourRounds(mut abef, mut cdgh, w3, Vector128.Create(uint(0xc6e00bf3), uint(0xd5a79147), uint(0x06ca6351), uint(0x14292967)))
            w0 = Sha256Schedule(w0, w1, w2, w3)
            Sha256FourRounds(mut abef, mut cdgh, w0, Vector128.Create(uint(0x27b70a85), uint(0x2e1b2138), uint(0x4d2c6dfc), uint(0x53380d13)))
            w1 = Sha256Schedule(w1, w2, w3, w0)
            Sha256FourRounds(mut abef, mut cdgh, w1, Vector128.Create(uint(0x650a7354), uint(0x766a0abb), uint(0x81c2c92e), uint(0x92722c85)))
            w2 = Sha256Schedule(w2, w3, w0, w1)
            Sha256FourRounds(mut abef, mut cdgh, w2, Vector128.Create(uint(0xa2bfe8a1), uint(0xa81a664b), uint(0xc24b8b70), uint(0xc76c51a3)))
            w3 = Sha256Schedule(w3, w0, w1, w2)
            Sha256FourRounds(mut abef, mut cdgh, w3, Vector128.Create(uint(0xd192e819), uint(0xd6990624), uint(0xf40e3585), uint(0x106aa070)))
            w0 = Sha256Schedule(w0, w1, w2, w3)
            Sha256FourRounds(mut abef, mut cdgh, w0, Vector128.Create(uint(0x19a4c116), uint(0x1e376c08), uint(0x2748774c), uint(0x34b0bcb5)))
            w1 = Sha256Schedule(w1, w2, w3, w0)
            Sha256FourRounds(mut abef, mut cdgh, w1, Vector128.Create(uint(0x391c0cb3), uint(0x4ed8aa4a), uint(0x5b9cca4f), uint(0x682e6ff3)))
            w2 = Sha256Schedule(w2, w3, w0, w1)
            Sha256FourRounds(mut abef, mut cdgh, w2, Vector128.Create(uint(0x748f82ee), uint(0x78a5636f), uint(0x84c87814), uint(0x8cc70208)))
            w3 = Sha256Schedule(w3, w0, w1, w2)
            Sha256FourRounds(mut abef, mut cdgh, w3, Vector128.Create(uint(0x90befffa), uint(0xa4506ceb), uint(0xbef9a3f7), uint(0xc67178f2)))
            abef = X86.Sse2.Add(abef, abefBefore)
            cdgh = X86.Sse2.Add(cdgh, cdghBefore)
            b = b + 1
        }

        Vector128<uint> feba = X86.Sse2.Shuffle(abef, 0x1B)
        Vector128<uint> dchg = X86.Sse2.Shuffle(cdgh, 0xB1)
        X86.Sse2.Store(hash, X86.Sse41.Blend(feba.AsUInt16(), dchg.AsUInt16(), 0xF0).AsUInt32())
        X86.Sse2.Store(hash + 4, X86.Ssse3.AlignRight(dchg, feba, 8))
    }
}

// The digest of the message of SHA-256's state at `s`, its eight words with the highest byte of each
// first, written at `out`; the state is then a new hasher's.
void Sha256Close(byte* s, byte* out) {
    HashPad(s, false)
    raw {
        uint* hash = Ptr<uint>(s)
        mut int i = 0
        while i < 8 {
            uint word = hash[i]
            out[4 * i] = byte(word >> 24)
            out[4 * i + 1] = byte(word >> 16 & 255)
            out[4 * i + 2] = byte(word >> 8 & 255)
            out[4 * i + 3] = byte(word & 255)
            i = i + 1
        }
    }

    Sha256Start(s)
}

// The state of a new hasher of MD5 at `s`: RFC 1321's initial words (3.3).
void Md5Start(byte* s) {
    raw {
        uint* words = Ptr<uint>(s)
        words[0] = 0x67452301
        words[1] = 0xefcdab89
        words[2] = 0x98badcfe
        words[3] = 0x10325476
        *Ptr<long>(s + 16) = 0
    }
}

// The word of the four bytes at `p`, the lowest first, as MD5 reads a word (RFC 1321, 2), read a byte at a
// time, which LLVM joins into one load of four bytes at any address.
pub uint LittleEndianWord(byte* p) {
    mut uint word = 0
    raw {
        word = uint(p[0]) | uint(p[1]) << 8 | uint(p[2]) << 16 | uint(p[3]) << 24
    }

    return word
}

// A step of each of MD5's four rounds (RFC 1321, 3.4) on a, b, c and d in the order the step gives them,
// with its word `m`, its constant `t` and its shift `r`: the new value of a, as `md-5`'s `op_f` to `op_i`
// give it, but for the terms of F and G. The two terms of each share no bit, so an or of them, their sum
// and each added into the sum give the same number, and so does F's select below. F is the select
// OpenSSL's x86-64 assembly writes (`md5-x86_64.pl`), `((c ^ d) & b) ^ d`, the bit of c where b's is 1
// and the bit of d where it is 0: of the or that RFC 1321 and `op_f` write, LLVM (clang 23) makes that
// select in 14 of the 16 steps and keeps the or in the last two. MD5 of 16 MiB hashed three times took
// 51.76 ms so, 52.14 with the or and 53.28 with the two terms added into the sum one at a time (issue
// 157, 2026-11-03, the best of 9). G adds each of its two terms into the sum, where RFC 1321 joins them
// with an or and `op_g` adds them together first: with F as above, MD5 took 51.81 ms so, 56.37 with the
// or and 56.43 in `op_g`'s form (the best of 9, each beside a copy of its build), and 56.41 with G as the
// select `((b ^ c) & d) ^ c`. LLVM's code generator adds a constant `t` it knows after the round's function,
// one add more on the path from b than in OpenSSL's code
// (knowledge/the-code-generator-adds-a-sums-constant-last.md), so `Md5Block` hands each step its constant
// through `Hint.BlackBox` (below).
uint Md5F(uint a, uint b, uint c, uint d, uint m, uint t, int r) {
    uint sum = a +% m +% t +% (((c ^ d) & b) ^ d)
    return (sum << r | sum >> (32 - r)) +% b
}

uint Md5G(uint a, uint b, uint c, uint d, uint m, uint t, int r) {
    uint sum = a +% m +% t +% (b & d) +% (c & ~d)
    return (sum << r | sum >> (32 - r)) +% b
}

uint Md5H(uint a, uint b, uint c, uint d, uint m, uint t, int r) {
    uint sum = (b ^ c ^ d) +% a +% m +% t
    return (sum << r | sum >> (32 - r)) +% b
}

uint Md5I(uint a, uint b, uint c, uint d, uint m, uint t, int r) {
    uint sum = (c ^ (b | ~d)) +% a +% m +% t
    return (sum << r | sum >> (32 - r)) +% b
}

// One block of 64 bytes at `p` through the 64 steps of MD5 into the words at `s` (RFC 1321, 3.4), in the
// form of RustCrypto's `md-5` 0.11.0 (`compress/soft.rs`): the 16 words of the block, each read with its
// lowest byte first, before the first step; and the 64 steps written out, each with its word, its constant
// T and its shift in the code. Each constant passes through `Hint.BlackBox` (F18) in its call, so that LLVM
// adds it to a and m before the round's function, off the path from b, as OpenSSL's `lea` does: one
// operation fewer on that path than a constant LLVM knows leaves. With the hint inside `Md5F` to `Md5I`
// instead, the optimised IR adds the value read back last, after the round's function, and the operation
// stays (clang 23.1.4, 2026-11-03).
void Md5Block(byte* s, byte* p) {
    raw {
        uint* words = Ptr<uint>(s)
        uint m0 = LittleEndianWord(p)
        uint m1 = LittleEndianWord(p + 4)
        uint m2 = LittleEndianWord(p + 8)
        uint m3 = LittleEndianWord(p + 12)
        uint m4 = LittleEndianWord(p + 16)
        uint m5 = LittleEndianWord(p + 20)
        uint m6 = LittleEndianWord(p + 24)
        uint m7 = LittleEndianWord(p + 28)
        uint m8 = LittleEndianWord(p + 32)
        uint m9 = LittleEndianWord(p + 36)
        uint m10 = LittleEndianWord(p + 40)
        uint m11 = LittleEndianWord(p + 44)
        uint m12 = LittleEndianWord(p + 48)
        uint m13 = LittleEndianWord(p + 52)
        uint m14 = LittleEndianWord(p + 56)
        uint m15 = LittleEndianWord(p + 60)
        mut uint a = words[0]
        mut uint b = words[1]
        mut uint c = words[2]
        mut uint d = words[3]
        a = Md5F(a, b, c, d, m0, Hint.BlackBox(0xd76aa478U), 7)
        d = Md5F(d, a, b, c, m1, Hint.BlackBox(0xe8c7b756U), 12)
        c = Md5F(c, d, a, b, m2, Hint.BlackBox(0x242070dbU), 17)
        b = Md5F(b, c, d, a, m3, Hint.BlackBox(0xc1bdceeeU), 22)
        a = Md5F(a, b, c, d, m4, Hint.BlackBox(0xf57c0fafU), 7)
        d = Md5F(d, a, b, c, m5, Hint.BlackBox(0x4787c62aU), 12)
        c = Md5F(c, d, a, b, m6, Hint.BlackBox(0xa8304613U), 17)
        b = Md5F(b, c, d, a, m7, Hint.BlackBox(0xfd469501U), 22)
        a = Md5F(a, b, c, d, m8, Hint.BlackBox(0x698098d8U), 7)
        d = Md5F(d, a, b, c, m9, Hint.BlackBox(0x8b44f7afU), 12)
        c = Md5F(c, d, a, b, m10, Hint.BlackBox(0xffff5bb1U), 17)
        b = Md5F(b, c, d, a, m11, Hint.BlackBox(0x895cd7beU), 22)
        a = Md5F(a, b, c, d, m12, Hint.BlackBox(0x6b901122U), 7)
        d = Md5F(d, a, b, c, m13, Hint.BlackBox(0xfd987193U), 12)
        c = Md5F(c, d, a, b, m14, Hint.BlackBox(0xa679438eU), 17)
        b = Md5F(b, c, d, a, m15, Hint.BlackBox(0x49b40821U), 22)
        a = Md5G(a, b, c, d, m1, Hint.BlackBox(0xf61e2562U), 5)
        d = Md5G(d, a, b, c, m6, Hint.BlackBox(0xc040b340U), 9)
        c = Md5G(c, d, a, b, m11, Hint.BlackBox(0x265e5a51U), 14)
        b = Md5G(b, c, d, a, m0, Hint.BlackBox(0xe9b6c7aaU), 20)
        a = Md5G(a, b, c, d, m5, Hint.BlackBox(0xd62f105dU), 5)
        d = Md5G(d, a, b, c, m10, Hint.BlackBox(0x02441453U), 9)
        c = Md5G(c, d, a, b, m15, Hint.BlackBox(0xd8a1e681U), 14)
        b = Md5G(b, c, d, a, m4, Hint.BlackBox(0xe7d3fbc8U), 20)
        a = Md5G(a, b, c, d, m9, Hint.BlackBox(0x21e1cde6U), 5)
        d = Md5G(d, a, b, c, m14, Hint.BlackBox(0xc33707d6U), 9)
        c = Md5G(c, d, a, b, m3, Hint.BlackBox(0xf4d50d87U), 14)
        b = Md5G(b, c, d, a, m8, Hint.BlackBox(0x455a14edU), 20)
        a = Md5G(a, b, c, d, m13, Hint.BlackBox(0xa9e3e905U), 5)
        d = Md5G(d, a, b, c, m2, Hint.BlackBox(0xfcefa3f8U), 9)
        c = Md5G(c, d, a, b, m7, Hint.BlackBox(0x676f02d9U), 14)
        b = Md5G(b, c, d, a, m12, Hint.BlackBox(0x8d2a4c8aU), 20)
        a = Md5H(a, b, c, d, m5, Hint.BlackBox(0xfffa3942U), 4)
        d = Md5H(d, a, b, c, m8, Hint.BlackBox(0x8771f681U), 11)
        c = Md5H(c, d, a, b, m11, Hint.BlackBox(0x6d9d6122U), 16)
        b = Md5H(b, c, d, a, m14, Hint.BlackBox(0xfde5380cU), 23)
        a = Md5H(a, b, c, d, m1, Hint.BlackBox(0xa4beea44U), 4)
        d = Md5H(d, a, b, c, m4, Hint.BlackBox(0x4bdecfa9U), 11)
        c = Md5H(c, d, a, b, m7, Hint.BlackBox(0xf6bb4b60U), 16)
        b = Md5H(b, c, d, a, m10, Hint.BlackBox(0xbebfbc70U), 23)
        a = Md5H(a, b, c, d, m13, Hint.BlackBox(0x289b7ec6U), 4)
        d = Md5H(d, a, b, c, m0, Hint.BlackBox(0xeaa127faU), 11)
        c = Md5H(c, d, a, b, m3, Hint.BlackBox(0xd4ef3085U), 16)
        b = Md5H(b, c, d, a, m6, Hint.BlackBox(0x04881d05U), 23)
        a = Md5H(a, b, c, d, m9, Hint.BlackBox(0xd9d4d039U), 4)
        d = Md5H(d, a, b, c, m12, Hint.BlackBox(0xe6db99e5U), 11)
        c = Md5H(c, d, a, b, m15, Hint.BlackBox(0x1fa27cf8U), 16)
        b = Md5H(b, c, d, a, m2, Hint.BlackBox(0xc4ac5665U), 23)
        a = Md5I(a, b, c, d, m0, Hint.BlackBox(0xf4292244U), 6)
        d = Md5I(d, a, b, c, m7, Hint.BlackBox(0x432aff97U), 10)
        c = Md5I(c, d, a, b, m14, Hint.BlackBox(0xab9423a7U), 15)
        b = Md5I(b, c, d, a, m5, Hint.BlackBox(0xfc93a039U), 21)
        a = Md5I(a, b, c, d, m12, Hint.BlackBox(0x655b59c3U), 6)
        d = Md5I(d, a, b, c, m3, Hint.BlackBox(0x8f0ccc92U), 10)
        c = Md5I(c, d, a, b, m10, Hint.BlackBox(0xffeff47dU), 15)
        b = Md5I(b, c, d, a, m1, Hint.BlackBox(0x85845dd1U), 21)
        a = Md5I(a, b, c, d, m8, Hint.BlackBox(0x6fa87e4fU), 6)
        d = Md5I(d, a, b, c, m15, Hint.BlackBox(0xfe2ce6e0U), 10)
        c = Md5I(c, d, a, b, m6, Hint.BlackBox(0xa3014314U), 15)
        b = Md5I(b, c, d, a, m13, Hint.BlackBox(0x4e0811a1U), 21)
        a = Md5I(a, b, c, d, m4, Hint.BlackBox(0xf7537e82U), 6)
        d = Md5I(d, a, b, c, m11, Hint.BlackBox(0xbd3af235U), 10)
        c = Md5I(c, d, a, b, m2, Hint.BlackBox(0x2ad7d2bbU), 15)
        b = Md5I(b, c, d, a, m9, Hint.BlackBox(0xeb86d391U), 21)
        words[0] = words[0] +% a
        words[1] = words[1] +% b
        words[2] = words[2] +% c
        words[3] = words[3] +% d
    }
}

// The digest of the message of MD5's state at `s`, its four words with the lowest byte of each first,
// written at `out`; the state is then a new hasher's.
void Md5Close(byte* s, byte* out) {
    HashPad(s, true)
    raw {
        uint* words = Ptr<uint>(s)
        mut int i = 0
        while i < 4 {
            uint word = words[i]
            out[4 * i] = byte(word & 255)
            out[4 * i + 1] = byte(word >> 8 & 255)
            out[4 * i + 2] = byte(word >> 16 & 255)
            out[4 * i + 3] = byte(word >> 24)
            i = i + 1
        }
    }

    Md5Start(s)
}

// One block of 64 bytes at `p` through the rounds of MD5 or of SHA-256 into the state at `s`.
void HashBlock(byte* s, byte* p, bool md5) {
    if md5 {
        Md5Block(s, p)
    } else {
        Sha256Block(s, p)
    }
}

// The `n` bytes at `p` added to the message of the state of MD5 or of SHA-256 at `s`: each block of 64
// bytes the message fills goes through the hash's rounds, and the bytes after the last whole block wait
// in the state's block.
void HashFeed(byte* s, byte* p, long n, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        *Ptr<long>(s + counted) = total + n
        mut long pending = total % 64
        mut long at = 0
        if pending > 0 {
            while pending < 64 && at < n {
                s[buffer + pending] = p[at]
                pending = pending + 1
                at = at + 1
            }

            if pending == 64 {
                HashBlock(s, s + buffer, md5)
                pending = 0
            }
        }

        if !md5 && X86.Sha.IsSupported && X86.Sse41.IsSupported {
            // SHA-256's whole blocks through the SHA instructions in one run, the hash held in them between blocks (R18)
            long whole = (n - at) / 64
            Sha256Instructions(s, p + at, whole)
            at = at + 64 * whole
        }

        while n - at >= 64 {
            HashBlock(s, p + at, md5)
            at = at + 64
        }

        while at < n {
            s[buffer + pending] = p[at]
            pending = pending + 1
            at = at + 1
        }
    }
}

// The padding of MD5 (RFC 1321, 3.1 and 3.2) or of SHA-256 (FIPS 180-4, 5.1.1) put through the state at
// `s`: the byte 0x80, zeros up to 8 bytes before the end of a block, and the count of bits of the
// message, its lowest byte first for MD5 and its highest first for SHA-256.
void HashPad(byte* s, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        ulong bits = ulong(total) << 3
        mut long pending = total % 64
        s[buffer + pending] = 128
        pending = pending + 1
        if pending > 56 {
            while pending < 64 {
                s[buffer + pending] = 0
                pending = pending + 1
            }

            HashBlock(s, s + buffer, md5)
            pending = 0
        }

        while pending < 56 {
            s[buffer + pending] = 0
            pending = pending + 1
        }

        mut int i = 0
        while i < 8 {
            mut int shift = 56 - 8 * i
            if md5 {
                shift = 8 * i
            }

            s[buffer + 56 + long(i)] = byte(bits >> shift & 255UL)
            i = i + 1
        }

        HashBlock(s, s + buffer, md5)
    }
}

// A new hasher of SHA-256 (H3): the block of its state; null, with `asked` set, where the system refuses.
pub byte* Sha256New(mut long asked) {
    byte* block = ByteBlock(104, mut asked)
    if block != null {
        Sha256Start(block + 16)
    }

    return block
}

// The bytes of the list `message` added to the hasher of SHA-256 whose block, which no other value holds,
// is `block`.
pub void Sha256Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), false)
    }
}

// The digest of the hasher of SHA-256 whose block, which no other value holds, is `block`: a new list of
// 32 bytes, after which the hasher starts over; null, with `asked` set and the hasher as it was, where the
// system refuses.
pub byte* Sha256Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        Sha256Close(block + 16, digest + 16)
    }

    return digest
}

// SHA-256 of the bytes of the list `message` (H1): a new list of 32 bytes, made on a state of its own, which
// it frees; null, with `asked` set, where the system refuses.
pub byte* Sha256Hash(byte* message, mut long asked) {
    byte* block = Sha256New(mut asked)
    if block == null {
        return null
    }

    Sha256Update(block, message)
    byte* digest = Sha256Finish(block, mut asked)
    Free(block, 120)
    return digest
}

// A new hasher of MD5 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Md5New(mut long asked) {
    byte* block = ByteBlock(88, mut asked)
    if block != null {
        Md5Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for MD5.
pub void Md5Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), true)
    }
}

// As `Sha256Finish`, for MD5: a new list of 16 bytes.
pub byte* Md5Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(16, mut asked)
    if digest != null {
        Md5Close(block + 16, digest + 16)
    }

    return digest
}

// MD5 of the bytes of the list `message` (H1), as `Sha256Hash` gives SHA-256: a new list of 16 bytes.
pub byte* Md5Hash(byte* message, mut long asked) {
    byte* block = Md5New(mut asked)
    if block == null {
        return null
    }

    Md5Update(block, message)
    byte* digest = Md5Finish(block, mut asked)
    Free(block, 104)
    return digest
}

// CRC-32/ISO-HDLC's state at `s`, 1028 bytes: the register (0), which starts at all ones, the CRC being the
// register with every bit flipped, and 1024 bytes that nothing reads, which keep the hasher's block at the
// size `allocation-failed` names for it (H1). The remainders of the reflected polynomial 0xEDB88320 are the
// emitter's table `crc32.table`, 16 rows of 256, which each call takes, as crc32fast's `CRC32_TABLE`.
void Crc32Start(byte* s) {
    raw {
        *Ptr<uint>(s) = 0xffffffff
    }
}

// The register `start` after the `n` bytes at `p`, by the table at `table` (`crc32.table`): 64 bytes at a time,
// as 4 steps of 16, each byte by the row of its distance from the step's end and the first four with the
// register's bytes, then each byte after the last 64 by row 0, as crc32fast's `update_fast_16` and
// `update_slow` take them.
uint Crc32Bytes(uint start, byte* p, long n, uint* table) {
    mut uint c = start
    raw {
        mut long i = 0
        while n - i >= 64 {
            long end = i + 64
            while i < end {
                c = table[long(p[i + 15])] ^ table[256 + long(p[i + 14])] ^ table[512 + long(p[i + 13])] ^
                    table[768 + long(p[i + 12])] ^ table[1024 + long(p[i + 11])] ^ table[1280 + long(p[i + 10])] ^
                    table[1536 + long(p[i + 9])] ^ table[1792 + long(p[i + 8])] ^ table[2048 + long(p[i + 7])] ^
                    table[2304 + long(p[i + 6])] ^ table[2560 + long(p[i + 5])] ^ table[2816 + long(p[i + 4])] ^
                    table[3072 + long((uint(p[i + 3]) ^ c >> 24) & 255)] ^
                    table[3328 + long((uint(p[i + 2]) ^ c >> 16) & 255)] ^
                    table[3584 + long((uint(p[i + 1]) ^ c >> 8) & 255)] ^
                    table[3840 + long((uint(p[i]) ^ c) & 255)]
                i = i + 16
            }
        }

        while i < n {
            c = table[long((c ^ uint(p[i])) & 255)] ^ c >> 8
            i = i + 1
        }
    }

    return c
}

// A new hasher of CRC-32 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Crc32New(mut long asked) {
    byte* block = ByteBlock(1028, mut asked)
    if block != null {
        Crc32Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for CRC-32, by the emitter's table at `table`.
pub void Crc32Update(byte* block, byte* message, uint* table) {
    if message != null {
        raw {
            *Ptr<uint>(block + 16) = Crc32Bytes(*Ptr<uint>(block + 16), ListItems(message), long(ListCount(message)), table)
        }
    }
}

// The CRC of the hasher of CRC-32 whose block, which no other value holds, is `block`, after which the
// hasher starts over.
pub uint Crc32Finish(byte* block) {
    mut uint c = 0
    raw {
        c = *Ptr<uint>(block + 16) ^ 0xffffffff
        *Ptr<uint>(block + 16) = 0xffffffff
    }

    return c
}

// CRC-32 of the bytes of the list `message` (H1), by the emitter's table at `table`, its register a local, as
// crc32fast's `hash` keeps its state: it asks the system for no block, so no refusal ends it.
pub uint Crc32Hash(byte* message, uint* table) {
    mut uint c = 0xffffffff
    if message != null {
        raw {
            c = Crc32Bytes(c, ListItems(message), long(ListCount(message)), table)
        }
    }

    return c ^ 0xffffffff
}

// HMAC-SHA256's state at `s`, 272 bytes (RFC 2104): the key K0 (0), 64 bytes, the state of the inner
// hash, which has taken K0 ^ ipad (64), and the state of the outer hash, which `HmacClose` starts (168)
// and whose block of 64 bytes being filled, at 208, nothing reads between two calls of it.

// The state of a new hasher of HMAC-SHA256 at `s` on the `n` bytes of the key at `key`: K0 is the key,
// or SHA-256 of a key longer than a block of 64 bytes, with zeros after it to 64 bytes.
void HmacStart(byte* s, byte* key, long n) {
    raw {
        mut long i = 0
        if n > 64 {
            byte* outer = s + 168
            Sha256Start(outer)
            HashFeed(outer, key, n, false)
            Sha256Close(outer, s)
            i = 32
        } else {
            while i < n {
                s[i] = key[i]
                i = i + 1
            }
        }

        while i < 64 {
            s[i] = 0
            i = i + 1
        }
    }

    HmacKeyed(s)
}

// The inner hash of the state at `s` started over on K0 ^ ipad, K0 with every byte xored with 0x36.
void HmacKeyed(byte* s) {
    byte* pad = s + 208
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 54)
            i = i + 1
        }
    }

    Sha256Start(s + 64)
    HashFeed(s + 64, pad, 64, false)
}

// The tag of the message of the state at `s`, SHA-256 of K0 ^ opad, K0 with every byte xored with 0x5C,
// and of the inner hash's digest, written at `out`, 32 bytes; the inner hash then starts over on K0 ^ ipad,
// as `HmacKeyed` starts it.
void HmacClose(byte* s, byte* out) {
    byte* outer = s + 168
    byte* pad = s + 208
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 92)
            i = i + 1
        }
    }

    Sha256Start(outer)
    HashFeed(outer, pad, 64, false)
    Sha256Close(s + 64, out)
    HashFeed(outer, out, 32, false)
    Sha256Close(outer, out)
    HmacKeyed(s)
}

// A new hasher of HMAC-SHA256 on the bytes of the list `key` (H3), as `Sha256New` makes one of SHA-256; the
// null block of an empty list is a key of no bytes, of which `ListCount` gives 0 and `HmacStart` reads none.
pub byte* HmacNew(byte* key, mut long asked) {
    byte* block = ByteBlock(272, mut asked)
    if block != null {
        HmacStart(block + 16, ListItems(key), long(ListCount(key)))
    }

    return block
}

// As `Sha256Update`, for HMAC-SHA256.
pub void HmacUpdate(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 80, ListItems(message), long(ListCount(message)), false)
    }
}

// As `Sha256Finish`, for HMAC-SHA256: the tag, a new list of 32 bytes.
pub byte* HmacFinish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        HmacClose(block + 16, digest + 16)
    }

    return digest
}

// HMAC-SHA256 of the bytes of the list `message` under the bytes of the list `key` (H1), as `Sha256Hash`
// gives SHA-256: a new list of 32 bytes.
pub byte* HmacSha256(byte* key, byte* message, mut long asked) {
    byte* block = HmacNew(key, mut asked)
    if block == null {
        return null
    }

    HmacUpdate(block, message)
    byte* digest = HmacFinish(block, mut asked)
    Free(block, 288)
    return digest
}

// Whether the tag of the message `message` under the key `key` is the bytes of `tag` (H4), compared by
// `FixedTimeEqual`; false, with `asked` set, where the system refuses.
pub bool HmacVerifySha256(byte* key, byte* message, byte* tag, mut long asked) {
    byte* digest = HmacSha256(key, message, mut asked)
    if digest == null {
        return false
    }

    bool same = FixedTimeEqual(digest, tag)
    Free(digest, 48)
    return same
}

// Whether the lists of bytes `a` and `b` hold the same bytes (H4): false where their counts differ, and
// else every byte is read, and the code stops at no difference, as C#'s `FixedTimeEquals` reads them.
pub bool FixedTimeEqual(byte* a, byte* b) {
    int n = ListCount(a)
    if n != ListCount(b) {
        return false
    }

    mut int differ = 0
    raw {
        mut long i = 0
        while i < long(n) {
            differ = differ | (int(a[16 + i]) ^ int(b[16 + i]))
            i = i + 1
        }
    }

    return differ == 0
}

// The digit of `d`, 0 to 15, in lower-case hexadecimal.
byte HexDigit(int d) {
    if d < 10 {
        return byte(48 + d)
    }

    return byte(87 + d)
}

// The lower-case hexadecimal of the bytes of the list `message`, two digits for each byte, the higher half
// first (H2), as the bytes of a new string's block; null for a list without bytes, which is the empty
// string, and null with `asked` set where the system refuses or where the text would pass the largest
// `int` of bytes, as a list does past it (M9).
pub byte* HexEncode(byte* message, mut long asked) {
    long n = long(ListCount(message))
    if n == 0 {
        return null
    }

    long size = 2 * n
    if size > 2147483647 {
        asked = size
        return null
    }

    byte* text = StringBlock(size)
    if text == null {
        asked = 16 + size
        return null
    }

    raw {
        mut long i = 0
        while i < n {
            int b = int(message[16 + i])
            text[2 * i] = HexDigit(b >> 4)
            text[2 * i + 1] = HexDigit(b & 15)
            i = i + 1
        }
    }

    StringTakeOver(text, size)
    return text
}

// The bytes the hexadecimal digits of the `count` bytes at `text` give (H7): -1 with a new list of
// `count / 2` bytes in `made`, two digits for each byte, the higher half first, null for no bytes, as the
// `hex` crate's `decode`; else the position `HexError` holds, with null in `made`: `count` where it is
// odd, read before the digits, and else the position of the first byte that is no digit; and -1 with
// null in `made` and `asked` set where the system refuses. `digits` is the emitter's table of the value
// of each byte as a digit, 255 for a byte that is no digit, read as .NET's scalar `FromHexString` reads
// its table: the two digits of a pair and one test of both. Where the test fails, the position is H7's,
// the high byte of the pair where that is no digit, else the low one; where both are no digit, .NET's
// scalar form names the low one.
pub long HexDecode(byte* text, long count, byte* digits, mut byte* made, mut long asked) {
    made = null
    if count % 2 != 0 {
        return count
    }

    if count == 0 {
        return -1
    }

    long size = count / 2
    byte* list = ByteBlock(size, mut asked)
    if list == null {
        return -1
    }

    mut long bad = -1
    raw {
        mut long at = 0
        while at < count {
            int low = int(digits[int(text[at + 1])])
            int high = int(digits[int(text[at])])
            if (low | high) == 255 {
                bad = at
                if high != 255 {
                    bad = at + 1
                }

                break
            }

            list[16 + at / 2] = byte(high << 4 | low)
            at = at + 2
        }
    }

    if bad >= 0 {
        Free(list, 16 + size)
        return bad
    }

    made = list
    return -1
}

// The failure of HTTP, a case of its own beside the network's `IoError`, and its kinds (design record,
// section 12: the owner, 2026-10-31, "HttpError + record's rule", and 2026-11-01, Q4 (a)), types every
// file sees (W1, W2). Its text is its detail alone, which the body gives (the owner, 2026-11-02, Q15 (a):
// "`data HttpError` declares `Text()`, which prints its detail"; A5, D16).
pub enum HttpKind { Protocol, TooLarge, Status, Unsupported }

pub data HttpError(HttpKind Kind, string Detail) {
    pub string Text() => Detail
}

// The headers of a request or a response, one ordered list of names and values (design record, section 12:
// the owner, 2026-10-31, "Ordered list type"): a name compares without regard to ASCII case and stays as it
// was spelled, and a repeated name, `Set-Cookie`, keeps each of its values apart, in the order they came
// (W1, W4). hyper's `HeaderMap` keeps a name's values apart and in order but lowercases the name, and
// ASP.NET Core's `IHeaderDictionary` holds a name's values as one `StringValues`: neither keeps one list.
// A CR or a LF in a name or a value is refused where it is set, as the http crate's `HeaderValue` refuses
// it, so that no header splits the head a writer writes (section 12: the owner, 2026-11-02, Q5).
pub class HttpHeaders {
    mut List<string> names = List<string>()
    mut List<string> values = List<string>()

    // The first value of the name, or null where the headers do not hold it.
    pub string? Get(string name) {
        for i in 0..<names.Count {
            if SameName(names[i], name) {
                return values[i]
            }
        }

        return null
    }

    // Every value of the name, in the order they came; empty where the headers do not hold it.
    pub List<string> GetAll(string name) {
        mut all = List<string>()
        for i in 0..<names.Count {
            if SameName(names[i], name) {
                all.Add(values[i])
            }
        }

        return all
    }

    // A value of the name after every value the headers hold, as a repeated header of a message.
    pub void | HttpError Add(string name, string value) {
        if Breaks(name) || Breaks(value) {
            return Refused()
        }

        names.Add(name)
        values.Add(value)
    }

    // A name and a value the parse of a head read and proved free of CR and LF, after every value the headers hold, with no second
    // walk of either for them (W5, W14).
    internal void Append(string name, string value) {
        names.Add(name)
        values.Add(value)
    }

    // The one value of the name, as hyper's `HeaderMap::insert` keeps the entry and its key (section 12: the owner,
    // 2026-11-02, the headers' pass, Q4 (a), Q5 and Q6 (b), at their defaults): the value takes the place of the name's
    // first header, which keeps its spelling, and the name's other headers are taken out; a name the headers do not
    // hold goes after every value they hold. A refused value changes nothing.
    pub void | HttpError Set(string name, string value) {
        if Breaks(name) || Breaks(value) {
            return Refused()
        }

        mut first = -1
        mut i = 0
        while i < names.Count {
            if !SameName(names[i], name) {
                i = i + 1
            } else if first < 0 {
                first = i
                i = i + 1
            } else {
                names.RemoveAt(i)
                values.RemoveAt(i)
            }
        }

        if first < 0 {
            names.Add(name)
            values.Add(value)
        } else {
            values[first] = value
        }
    }

    // Takes out every value of the name.
    pub void Remove(string name) {
        mut i = 0
        while i < names.Count {
            if SameName(names[i], name) {
                names.RemoveAt(i)
                values.RemoveAt(i)
            } else {
                i = i + 1
            }
        }
    }

    // How many names and values the headers hold, each value of a repeated name counted: a read-only property (K7; section 12:
    // the owner, 2026-11-03).
    pub int Count => names.Count

    // The name at the index, in the order the headers hold them: an index outside 0 to `Count - 1` stops the program
    // with index-out-of-range, as a list's index does (W4; section 12: the owner, 2026-11-03).
    pub string NameAt(int i) => names[i]

    // The value at the index, the value of the name `NameAt(i)` gives, and outside them the same stop.
    pub string ValueAt(int i) => values[i]

    // Whether a name or a value holds a CR or a LF, which would end its line in the head.
    static bool Breaks(string text) {
        for i in 0..<text.Bytes.Count {
            if text.Bytes[i] == 13 || text.Bytes[i] == 10 {
                return true
            }
        }

        return false
    }

    // The refusal of a name or a value that holds a CR or a LF (section 12: the owner, 2026-11-03).
    static HttpError Refused() {
        return HttpError(HttpKind.Protocol, "invalid header: CR or LF")
    }

    // Whether two names are the same without regard to ASCII case, byte by byte, as Rust's `eq_ignore_ascii_case`.
    static bool SameName(string a, string b) {
        if a.Bytes.Count != b.Bytes.Count {
            return false
        }

        for i in 0..<a.Bytes.Count {
            if Lower(a.Bytes[i]) != Lower(b.Bytes[i]) {
                return false
            }
        }

        return true
    }

    static int Lower(byte c) {
        if c >= 65 && c <= 90 {
            return c + 32
        }

        return c
    }
}

// The parameters of a request's query, its names and values in their order, as `r.QueryValues()` reads them from `r.Query`, a type
// every file sees (design record, section 12: the owner, 2026-11-06, G2 (a); W1, W19), read as Rust's `url::form_urlencoded::parse`
// reads them: a name compares exactly, byte for byte, where a header's name compares without regard to ASCII case (W4), and a
// repeated name keeps each of its values apart, in their order. ASP.NET Core's `QueryHelpers.ParseQuery` reads a `+` as a space
// as the crate does, and differs in the rest: it compares names without regard to case and folds a repeated name into one value.
pub class HttpQuery {
    mut List<string> names = List<string>()
    mut List<string> values = List<string>()

    // The first value of the name, or null where the query does not hold it.
    pub string? Get(string name) {
        for i in 0..<names.Count {
            if names[i] == name {
                return values[i]
            }
        }

        return null
    }

    // Every value of the name, in their order, in a new list; empty where the query does not hold it.
    pub List<string> GetAll(string name) {
        mut all = List<string>()
        for i in 0..<names.Count {
            if names[i] == name {
                all.Add(values[i])
            }
        }

        return all
    }

    // How many names and values the query holds, each value of a repeated name counted: a read-only property (K7).
    pub int Count => names.Count

    // The name at the index, in their order: an index outside 0 to `Count - 1` stops the program with index-out-of-range, as a
    // list's index does (W4).
    pub string NameAt(int i) => names[i]

    // The value at the index, the value of the name `NameAt(i)` gives, and outside them the same stop.
    pub string ValueAt(int i) => values[i]

    // The pairs of a query's text, as the crate reads them: split at each `&`, an empty piece skipped, each piece split at its first
    // `=`, and a piece without one the name with the empty value (W19).
    internal void ReadText(string query) {
        b = query.Bytes
        mut start = 0
        mut i = 0
        while i <= b.Count {
            if i == b.Count || b[i] == 38 {
                if i > start {
                    mut equals = start
                    while equals < i && b[equals] != 61 {
                        equals = equals + 1
                    }

                    names.Add(HttpQueryText(b, start, equals))
                    if equals < i {
                        values.Add(HttpQueryText(b, equals + 1, i))
                    } else {
                        values.Add("")
                    }
                }

                start = i + 1
            }

            i = i + 1
        }
    }
}

// A name or a value of a query, the bytes of `b` from `from` up to `to`: a `+` read as a space before the escapes, each `%` with two
// hex digits after it within them the byte they name, a `%` without them kept, and the bytes read as UTF-8 with each maximal part
// of a sequence that is no UTF-8 read as U+FFFD, as the crate decodes them lossily (`string.FromUtf8Lossy`, T15; W19).
string HttpQueryText(Bytes b, int from, int to) {
    mut out = Bytes()
    mut i = from
    while i < to {
        if b[i] == 43 {
            out.Add(byte(32))
            i = i + 1
            continue
        }

        if b[i] == 37 && i + 2 < to {
            high = UrlHexValue(b[i + 1])
            low = UrlHexValue(b[i + 2])
            if high >= 0 && low >= 0 {
                out.Add(byte(high * 16 + low))
                i = i + 3
                continue
            }
        }

        out.Add(b[i])
        i = i + 1
    }

    return string.FromUtf8Lossy(out)
}

// A lowest rate of data, in bytes a second after a grace, as Kestrel's `MinDataRate` holds both (design record, section 12: the
// owner, 2026-11-03, "`HttpLimits` takes Kestrel's types"), a type every file sees (W1, W5).
pub data HttpRate(int BytesPerSecond, duration Grace)

// The limits of a request, a type every file sees (W1, W5): the first seven with the names, types and defaults of Kestrel's
// `KestrelServerLimits`, and the four numbers the server held fixed made members, `KeepAliveTimeout` with Kestrel's name and the
// owner's 5 seconds, where Kestrel waits 130, and the other three with names of their own (design record, section 12: the owner,
// 2026-10-31, "HttpLimits data" and "Persistent, 100 req, 5 s", and 2026-11-03, Kestrel's member names and types, the four fixed
// numbers made members). The server's loop holds the bounds of time by the monotonic clock (W10).
pub data HttpLimits(
    int MaxRequestLineSize = 8kb,
    int MaxRequestHeadersTotalSize = 32kb,
    int MaxRequestHeaderCount = 100,
    long MaxRequestBodySize = 30_000_000,
    duration RequestHeadersTimeout = 30s,
    HttpRate MinRequestBodyDataRate = HttpRate(240, 5s),
    HttpRate MinResponseDataRate = HttpRate(240, 5s),
    int MaxRequestsPerConnection = 100,
    duration KeepAliveTimeout = 5s,
    int MaxDrainSize = 64kb,
    int MaxChunkSizeLine = 4096)

// A request a server reads from a stream: its method, its target split at the first `?`, its headers and its body, each as the
// client sent it (design record, section 12; W1, W5). `HttpRequest.Read(stream)` reads one with the limits of `HttpLimits()`, and a
// server's loop with the limits it is given (W7).
pub class HttpRequest(string Method, string Path, string Query, HttpHeaders Headers, HttpBody Body) {
    // The minor version of the request, 0 for HTTP/1.0 and 1 for HTTP/1.1, for the server's loop (F9).
    internal mut int minor = 1

    // Whether the request has no body and the head of the next request stood whole in the stream's buffer after its own, so
    // that the loop reads the next one without a wait and may hold this one's response until it writes the next (F9).
    internal mut bool next = false

    // The parameters of `Query`, read anew at each call, as `HttpQuery` reads them, while `Query` stays the raw text (design record,
    // section 12: the owner, 2026-11-06, G2 (a); W5, W19).
    pub HttpQuery QueryValues() {
        q = HttpQuery()
        q.ReadText(Query)
        return q
    }

    // The next request of the stream, its head read whole through the stream's buffer and its body left there for `Body`, or the
    // failure of the network, or the request the server refuses (W5), read under the limits of `HttpLimits()`: the limits a server
    // is given reach the parser through `HttpReadRequest`, which no program calls, with no second public form (W7; section 12, Q3).
    pub static HttpRequest | IoError | HttpError Read(TcpStream stream) {
        match HttpReadRequest(stream, HttpLimits()) {
            HttpRequest r => return r
            IoError e => return e
            HttpRefused no => return no.Error
        }
    }
}

// The body of a request, read from its stream as the client sends it, or of a response a client reads (W14): `Read` appends at most
// `max` bytes and gives 0 at the end,
// `ReadAll` the whole body up to a bound and `ReadAllText` the same as text (design record, section 12; W6). The first read that needs a byte from a client that
// expects `100-continue` sends `HTTP/1.1 100 Continue` before it, as hyper sends it, and none once the head of a response a function
// writes has gone out, as hyper sends it only before the response begins. A failure of HTTP stays: every read after it gives it again, but for the refusal of `ReadAll` for its own `max`, after which the body is still readable (W6).
pub class HttpBody {
    mut TcpStream? stream = null
    mut long remaining = 0
    mut bool chunked = false
    mut bool atChunkEnd = false
    mut bool ended = true
    mut bool expects = false
    mut long taken = 0
    mut long most = 0
    mut int sizeLine = 4096
    mut HttpError? failed = null
    mut bool timed = false
    mut HttpRate rate = HttpRate(240, 5s)
    mut long waited = 0
    mut long arrived = 0
    mut bool timedOut = false
    mut bool begun = false
    mut string side = "request"
    mut bool toEnd = false
    mut int trailerBytes = 0
    mut int trailerLines = 0

    // The connection of a client's response, told once when the body ends or fails, so that the pool takes it back (W13).
    internal mut HttpConnection? home = null
    internal mut HttpCall? call = null

    // The body a head declares, read from `s`: a declared length, chunks, or none, a trailer of chunks held to what the head left of
    // its limits, `headBytes` and `headLines` (section 12, the owner, 2026-11-05, Q8) (F9: `internal`, the maker std/'s reader calls).
    internal static HttpBody Make(TcpStream s, long length, bool isChunked, bool expectsContinue, HttpLimits limits, bool isTimed, int headBytes, int headLines) {
        b = HttpBody()
        b.stream = s
        b.remaining = length
        b.chunked = isChunked
        b.ended = !isChunked && length == 0
        b.expects = expectsContinue && (isChunked || length > 0)
        b.most = limits.MaxRequestBodySize
        b.sizeLine = limits.MaxChunkSizeLine
        b.timed = isTimed
        b.rate = limits.MinRequestBodyDataRate
        b.trailerBytes = limits.MaxRequestHeadersTotalSize - headBytes
        b.trailerLines = limits.MaxRequestHeaderCount - headLines
        return b
    }

    // The body of a response a client reads from `s`: a declared length, chunks, or the bytes up to the stream's end where the head
    // declares neither (RFC 9112, section 6.3), each failure in the words of a response, and no bound but the one a helper takes (W12).
    internal static HttpBody MakeResponse(TcpStream s, long length, bool isChunked, bool isToEnd, int chunkLine) {
        b = HttpBody()
        b.stream = s
        b.remaining = length
        b.chunked = isChunked
        b.toEnd = isToEnd && !isChunked
        b.ended = !isChunked && !isToEnd && length == 0
        b.most = 9223372036854775807
        b.sizeLine = chunkLine
        b.side = "response"
        return b
    }

    // Whether the body is empty or read to its end (F9).
    internal bool Ended => ended

    // Whether the request expects `100-continue` and no read has sent it, so that the client may not have sent the body (F9).
    internal bool AwaitsContinue => expects

    // Whether a read of the body ran out of its time, which the server answers `408` where no head of a response went out (F9).
    internal bool TimedOut => timedOut

    // The response's head on its way to the client, after which no read sends `100 Continue` (F9).
    internal void Begin() {
        begun = true
    }

    // Whether a read of the body failed, so that what the stream holds after it is not known (F9).
    internal bool Failed => failed != null

    // Reads and drops what is left of the body, at most `bound` bytes: true where the body ended within them, so that the stream
    // holds the connection's next request (F9).
    internal bool | IoError | HttpError Drain(int bound) {
        mut dropped = Bytes()
        mut room = long(bound) + 1
        while room > 0 {
            dropped.Clear()
            mut piece = 65536
            if room < piece {
                piece = int(room)
            }

            n = Read(mut dropped, piece)
            if n == 0 {
                return true
            }

            room = room - n
        }

        return false
    }

    // Appends at most `max` bytes of the body to `into` and gives their count, 0 at the end of the body.
    pub int | IoError | HttpError Read(mut Bytes into, int max) {
        s = stream
        if !timed || s == null || ended || failed != null || max <= 0 {
            return Take(mut into, max, null)
        }

        // the rate, as Kestrel holds `MinRequestBodyDataRate`: after the grace, the bytes that arrived over the time the reads
        // waited, so that a read may wait until that falls under the rate (section 12, Q11 (a)); below it the read gives the
        // server's own `request timed out` (Q12 (b))
        bound = HttpNanosAt(arrived, rate.BytesPerSecond)
        mut allowed = HttpNanosOf(rate.Grace)
        if bound > allowed {
            allowed = bound
        }

        spare = allowed - waited
        if spare <= 0 {
            timedOut = true
            return HttpTimedOut()
        }

        // what remains of `spare` set before each refill the read makes, the size line and the trailer of a chunk among them, as
        // the head's reads set what remains of its time (section 12, the owner, 2026-11-04, Q9 (a))
        start = instant.Now
        n = Take(mut into, max, start + HttpNanos(spare)) else {
            IoError e => {
                waited = waited + HttpNanosOf(instant.Now - start)
                if e.Kind == IoKind.TimedOut {
                    timedOut = true
                    return HttpTimedOut()
                }

                return e
            }
            HttpError e => return e
        }

        waited = waited + HttpNanosOf(instant.Now - start)
        arrived = arrived + n
        return n
    }

    // `Read`, with no bound of time where `deadline` is null, which tells a client's connection when the body ends or fails (W13).
    int | IoError | HttpError Take(mut Bytes into, int max, instant? deadline) {
        n = Pull(mut into, max, deadline) else {
            HttpError e => {
                Tell()
                return e
            }
        }

        Tell()
        return n
    }

    // Tells the connection of a client's response, once, that the body ended, or failed, so that what the stream holds after it is
    // not known.
    void Tell() {
        h = home
        if h == null {
            return
        }

        if ended || failed != null {
            h.Ends(failed == null)
            home = null
        }
    }

    // `Take` without the telling.
    int | IoError | HttpError Pull(mut Bytes into, int max, instant? deadline) {
        f = failed
        if f != null {
            return f
        }

        s = stream
        if s == null || ended || max <= 0 {
            return 0
        }

        if expects {
            expects = false
            if !begun {
                s.Write("HTTP/1.1 100 Continue\r\n\r\n".Bytes)
            }
        }

        if toEnd {
            HttpCallReads(s, call)
            n = s.Read(mut into, max) else {
                IoError e => return HttpCallFailed(e, call)
            }

            if n == 0 {
                ended = true
            }

            return n
        }

        if chunked && remaining == 0 {
            NextChunk(s, deadline) else {
                HttpError e => {
                    failed = e
                    return e
                }
            }

            if ended {
                return 0
            }
        }

        mut want = max
        if remaining < want {
            want = int(remaining)
        }

        if deadline != null {
            HttpWaitUntil(s, deadline)
        }

        HttpCallReads(s, call)
        n = s.Read(mut into, want) else {
            IoError e => return HttpCallFailed(e, call)
        }

        if n == 0 {
            e = HttpError(HttpKind.Protocol, "malformed {side}: unexpected end of body")
            failed = e
            return e
        }

        remaining = remaining - n
        if remaining == 0 {
            if chunked {
                atChunkEnd = true
            } else {
                ended = true
            }
        }

        return n
    }

    // The whole body, or `request body over limit` where it holds more than `max` bytes, `response body over limit` for a response:
    // a declared length before its first byte is
    // read, so that the body stays for the reads after it, and a chunked body once more than `max` of its bytes were read, which are
    // dropped; a `max` below zero refuses every body, an empty one among them, as it refuses every declared length (section 12,
    // assumed).
    pub Bytes | IoError | HttpError ReadAll(int max) {
        if max < 0 || !chunked && !toEnd && remaining > max {
            return HttpError(HttpKind.TooLarge, "{side} body over limit")
        }

        mut all = Bytes()
        while true {
            mut piece = 65536
            room = long(max) - all.Count + 1
            if room < piece {
                piece = int(room)
            }

            n = Read(mut all, piece)
            if n == 0 {
                return all
            }

            if all.Count > max {
                return HttpError(HttpKind.TooLarge, "{side} body over limit")
            }
        }

        return all
    }

    // The whole body as text, or `InvalidUtf8` where it is no UTF-8, as `string.FromUtf8` gives it.
    pub string | IoError | HttpError | InvalidUtf8 ReadAllText(int max) {
        all = ReadAll(max)
        return string.FromUtf8(all)
    }

    // The size of the next chunk, read past the line end of the chunk before it, and at the last chunk its trailer, whose lines are
    // read and dropped (RFC 9112, section 7.1), held to what the head left of `MaxRequestHeadersTotalSize` and
    // `MaxRequestHeaderCount` (section 12, the owner, 2026-11-05, Q8); a chunk's extensions are ignored. Each refill by `deadline`.
    bool | IoError | HttpError NextChunk(TcpStream s, instant? deadline) {
        bad = HttpError(HttpKind.Protocol, "malformed {side}: bad chunk")
        if atChunkEnd {
            end = HttpLine(s, 2, bad, deadline, side, call)
            if end.Count != 0 {
                return bad
            }

            atChunkEnd = false
        }

        line = HttpLine(s, sizeLine, bad, deadline, side, call) else {
            HttpError e => return HttpError(HttpKind.Protocol, "malformed {side}: bad chunk size")
        }

        mut size = 0L
        mut digits = 0
        for i in 0..<line.Count {
            c = line[i]
            mut d = -1
            if c >= 48 && c <= 57 {
                d = c - 48
            } else if c >= 97 && c <= 102 {
                d = c - 87
            } else if c >= 65 && c <= 70 {
                d = c - 55
            } else if c == 59 || c == 32 || c == 9 {
                break
            } else {
                return HttpError(HttpKind.Protocol, "malformed {side}: bad chunk size")
            }

            if most - taken - d < 0 || size > (most - taken - d) / 16 {
                return HttpError(HttpKind.TooLarge, "{side} body over limit")
            }

            size = size * 16 + d
            digits = digits + 1
        }

        if digits == 0 {
            return HttpError(HttpKind.Protocol, "malformed {side}: bad chunk size")
        }

        taken = taken + size
        remaining = size
        if size == 0 && side == "response" {
            // a response's trailer: its lines read and dropped, each held to the size line, as a chunk's (W14)
            while true {
                trailer = HttpLine(s, sizeLine, bad, deadline, side, call)
                if trailer.Count == 0 {
                    ended = true
                    return true
                }
            }
        }

        if size == 0 {
            // one budget with the head's, each line counted with its CR LF and the empty line that ends the trailer, as the head's,
            // beside the budget (section 12, assumed)
            large = HttpError(HttpKind.TooLarge, "request header too large")
            while true {
                mut fits = trailerBytes
                if fits < 2 {
                    fits = 2
                }

                trailer = HttpLine(s, fits, large, deadline, side, call)
                if trailer.Count == 0 {
                    ended = true
                    return true
                }

                trailerBytes = trailerBytes - trailer.Count - 2
                trailerLines = trailerLines - 1
                if trailerLines < 0 {
                    return large
                }
            }
        }

        return true
    }
}

// A response: its status, its headers and its body, a text or bytes held whole, a file read as it is written, chunks a function
// writes, or none (design record, section 12; W8, W11). The functions that make one hold the status to 200 to 599, stopping the program otherwise, as an index
// out of range does, since a status is a literal in code, and set the `Content-Type` ASP.NET Core's `Results` sets, which the
// headers can replace. `Write` writes the response, and `WriteHead` its head alone, for a `HEAD`; neither adds `Date` or
// `Connection`, which the server's loop adds where the handler set none.
pub class HttpResponse {
    mut int code = 200
    mut HttpHeaders headers = HttpHeaders()
    mut bool isFile = false
    mut Bytes held = HttpNoBytes()
    mut string filePath = ""
    mut ((HttpWriter) => void | IoError)? streamer = null

    // The status, from 200 to 599.
    pub int Status => code

    // The headers, which a handler changes with `Add`, `Set` and `Remove` (W4).
    pub HttpHeaders Headers => headers

    // A response whose body is `text` in UTF-8, as `text/plain; charset=utf-8`.
    pub static HttpResponse Text(int status, string text) {
        r = Of(status, "text/plain; charset=utf-8")
        r.held = text.Bytes
        r.NoBodyOn205()
        return r
    }

    // A response whose body is `bytes`, as `application/octet-stream`.
    pub static HttpResponse Bytes(int status, Bytes bytes) {
        r = Of(status, "application/octet-stream")
        r.held = bytes
        r.NoBodyOn205()
        return r
    }

    // A response whose body is the file at `path`, as `application/octet-stream`, its length taken and its bytes read when the
    // response is written.
    pub static HttpResponse File(int status, string path) {
        r = Of(status, "application/octet-stream")
        r.isFile = true
        r.filePath = path
        return r
    }

    // A response with no body and no `Content-Type`.
    pub static HttpResponse Empty(int status) => Of(status, "")

    // A response whose body `body` writes, as `application/octet-stream`: the writer calls `body` with an `HttpWriter`, the head
    // goes out with its first write of bytes, or at its return where it wrote none, each `w.Write` a chunk, and the function's return
    // ends the body (W11). A status that has no body, 100 to 199,
    // `204`, `205` or `304`, stops the program, as a status outside 200 to 599 does, with its own text for 100 to 199.
    pub static HttpResponse Stream(int status, (HttpWriter) => void | IoError body) {
        if status < 200 && status >= 100 || status == 204 || status == 205 || status == 304 {
            throw "status {status} has no body to stream"
        }

        r = Of(status, "application/octet-stream")
        r.streamer = body
        return r
    }

    // Writes the status line, the headers and the body to `stream` (W8).
    pub void | IoError Write(TcpStream stream) {
        mut none = HttpNoBytes()
        mut refused = false
        Send(stream, true, "", false, false, null, mut none, false, null, mut refused)
    }

    // Writes the status line and the headers alone, with the `Content-Length` the body would have, the answer to a `HEAD` (W8).
    pub void | IoError WriteHead(TcpStream stream) {
        mut none = HttpNoBytes()
        mut refused = false
        Send(stream, false, "", false, false, null, mut none, false, null, mut refused)
    }

    // The response as the server's loop writes it: `date` its `Date` line or empty, a `Connection: close` where `close`, and to a
    // request of HTTP/1.0 no `Transfer-Encoding` where `plain`, its body framed by its length, or by the close where a function writes it; false where the writer wrote its
    // own `500` in its place, or where the writer of a body a function writes announced a close because the request's body still
    // awaited `100 Continue`, after which the loop closes the connection. The responses `pending` holds go out first, in the same
    // write, and where `hold` a response of 64 KiB or less, with them, or the end of a body a function writes, is held there in place
    // of a write; `request` the body of the request it answers, which sends no `100 Continue` once the head of a body a function
    // writes has gone out (F9); and `refused` set where the writer wrote its own `500` in its place and then gives an `IoError`, that
    // of a file whose size cannot be read or of a function before its first write, after which the loop closes the connection in
    // stages (design record, section 12: the owner, 2026-11-09, "In stages").
    internal bool | IoError Serve(TcpStream stream, bool withBody, string date, bool close, bool plain, HttpRate pace, mut Bytes pending, bool hold, HttpBody request, mut bool refused) => Send(stream, withBody, date, close, plain, pace, mut pending, hold, request, mut refused)

    // Whether a function writes the body, which the loop calls before it drains the request's body, since the function may read it (F9).
    internal bool Streams => streamer != null

    // A response of `status` with its `Content-Type`, none where `type` is empty.
    static HttpResponse Of(int status, string type) {
        if status < 200 || status > 599 {
            throw "status {status} is outside 200 to 599"
        }

        r = HttpResponse()
        r.code = status
        if type != "" {
            r.headers.Add("Content-Type", type) else {
                HttpError e => return r
            }
        }

        return r
    }

    // A `205` given a body stops the program, as a status outside the range does: the function that makes the response sees the
    // status and the body (design record, section 12: the owner, 2026-11-02, the writer's pass, Q14, and the reading said back with
    // it, assumed). A `File`'s length is taken when it is written, so a `205` whose file holds bytes reaches `Send`'s `500`.
    void NoBodyOn205() {
        if code == 205 && held.Count > 0 {
            throw "status 205 takes no body"
        }
    }

    // The response written to `s`, its body with it where `withBody`. A response that cannot be written, a `205` whose file holds
    // bytes or a `Content-Length` its body contradicts, is answered `500` with no body and a close; a `Transfer-Encoding` beside a
    // `Content-Length`, and a `Content-Length` beside a body a function writes that holds anything but digits, or differs from
    // another, are answered with nothing, `InvalidInput`, as hyper ends such a response. A body a function writes under a
    // `Content-Length` goes as it is, not in chunks, held to that count (W11).
    bool | IoError Send(TcpStream s, bool withBody, string date, bool close, bool plain, HttpRate? pace, mut Bytes pending, bool hold, HttpBody? request, mut bool refused) {
        bodiless = code == 204 || code == 304
        body = streamer
        mut length = 0L
        if !bodiless && isFile {
            length = HttpFileSize(filePath) else {
                IoError e => {
                    HttpUnwritable(s, mut pending, date, pace)
                    refused = true
                    return e
                }
            }
        } else if !bodiless {
            length = held.Count
        }

        codings = headers.GetAll("Transfer-Encoding")
        lengths = headers.GetAll("Content-Length")
        mut count = -1L
        if body != null && lengths.Count > 0 && codings.Count == 0 {
            count = HttpLength(lengths[0])
            for text in lengths {
                if HttpLength(text) != count {
                    count = -1
                }
            }
        }

        chunked = !bodiless && !plain && (codings.Count > 0 || (body != null && count < 0))
        if (chunked || body != null) && lengths.Count > 0 && count < 0 {
            HttpFlush(s, mut pending, pace)
            return IoError(IoKind.InvalidInput, 0, "")
        }

        if code == 205 && length > 0 {
            HttpUnwritable(s, mut pending, date, pace)
            return false
        }

        if !bodiless && body == null {
            for text in lengths {
                if HttpLength(text) != length {
                    HttpUnwritable(s, mut pending, date, pace)
                    return false
                }
            }
        }

        mut out = "HTTP/1.1 {code} {HttpReason(code)}\r\n".Bytes
        mut codingsLeft = codings.Count
        for i in 0..<headers.Count {
            name = headers.NameAt(i)
            value = headers.ValueAt(i)
            // a `Content-Length` the handler set is dropped on a `204` and kept on a `304`, as RFC 9110, section 8.6, has it (design
            // record, section 12: the owner, 2026-11-09, pull request 413, comment 6735967569), unchecked against the `304`'s empty
            // body (assumed)
            if code == 204 && name.ToLowerAscii() == "content-length" {
                continue
            }

            if name.ToLowerAscii() == "transfer-encoding" {
                if bodiless || plain {
                    continue
                }

                codingsLeft = codingsLeft - 1
                if codingsLeft == 0 && !HttpEndsInChunked(value) {
                    out.AddRange("{name}: {value}, chunked\r\n".Bytes)
                    continue
                }
            }

            out.AddRange("{name}: {value}\r\n".Bytes)
        }

        if chunked && codings.Count == 0 {
            out.AddRange("Transfer-Encoding: chunked\r\n".Bytes)
        }

        if !bodiless && !chunked && lengths.Count == 0 && body == null {
            out.AddRange("Content-Length: {length}\r\n".Bytes)
        }

        out.AddRange(date.Bytes)
        if close {
            out.AddRange("Connection: close\r\n".Bytes)
        }

        // the head of a body a function writes ends where it goes out, with the writer's first write
        streamed = withBody && !bodiless && body != null
        if !streamed {
            out.AddRange("\r\n".Bytes)
        }

        before = pending.Count
        if pending.Count > 0 {
            pending.AddRange(out)
            out = pending
            pending = HttpNoBytes()
        }

        if !withBody || bodiless {
            if hold && out.Count <= 65536 {
                pending = out
                return true
            }

            HttpWrite(s, pace, out)
            return true
        }

        if body != null {
            // the head goes out with the first chunk, in one write up to 64 KiB of it, so that the chunk does not wait for the
            // acknowledgement of the head, and the last chunk after the function's return, held as a response is where `hold`; the
            // writer's own `Connection: close` before the loop's close, beside a handler's `Connection` that does not say it (section
            // 12, the owner, 2026-11-05, Q6)
            w = HttpWriter.Make(s, out, before, date, chunked, count, pace, request, !close && !HttpCloses(headers))
            body(w) else {
                IoError e => {
                    w.Abort()
                    refused = w.Refused
                    return e
                }
            }

            w.End(mut pending, hold) else {
                IoError e => {
                    refused = w.Refused
                    return e
                }
            }

            return !w.Closes
        }

        if isFile {
            HttpSendFile(s, out, filePath, length, chunked, pace)
            return true
        }

        if chunked && held.Count > 0 {
            out.AddRange("{HttpHex(held.Count)}\r\n".Bytes)
        }

        if held.Count <= 65536 {
            out.AddRange(held)
        } else {
            HttpWrite(s, pace, out)
            out = HttpNoBytes()
            HttpWrite(s, pace, held)
        }

        if chunked {
            if held.Count > 0 {
                out.AddRange("\r\n".Bytes)
            }

            out.AddRange("0\r\n\r\n".Bytes)
        }

        if hold && held.Count <= 65536 && out.Count <= 65536 {
            pending = out
            return true
        }

        if out.Count > 0 {
            HttpWrite(s, pace, out)
        }

        return true
    }
}

// The writer of a streamed response, which `HttpResponse.Stream` gives its function (design record, section 12; W11): `Write` sends
// a `Bytes` or a `string` as one chunk of the body, or as it is to a peer of HTTP/1.0, each write held to the response's rate where
// the server's loop writes it, and gives the socket's `IoError`; a write of no bytes writes nothing, the head neither. The head goes
// out with the first write of bytes, or at the end of the body where the function wrote none, and the `CR LF` that ends a chunk with
// the write after it, so that no write of a few bytes waits for the acknowledgement of the one before. Once the function returned, a
// write gives `IoError(InvalidInput)` and writes nothing, that of a failed writer too. A write that failed leaves the writer failed:
// every later write while the function runs, and the end of the body, gives its `IoError` again and writes nothing, so that a client
// of HTTP/1.1 sees the body cut, never a chunk that a failed write left part of followed by another, while one of HTTP/1.0, whose
// body the close ends, cannot tell it from a whole one. Under a `Content-Length` the handler set the body goes as it is, not in
// chunks, held to that count, as Kestrel holds a body to `Response.ContentLength`: a write that would pass it writes none of its bytes
// and gives `IoError(InvalidData)`, which leaves the writer failed, and a body short of it at a return without an `IoError` of the
// function's own gives that error too, the body cut where a write sent the head (design record, section 12: G5). A function that
// gives an `IoError` before its first write of bytes, when nothing was written yet, is answered `500` with no body and `Connection:
// close` in place of the head, the `500` as Kestrel answers a handler that fails before its response started, which keeps the
// connection open there (its `HttpProtocol.ProduceEnd` writes no `Connection: close`; issue 39, comment 6762818536), whatever
// `Content-Length` the handler set (design record, section 12: the owner, 2026-11-09, "500 + close"), and so is one that returns after
// a write that failed while nothing was written, a write that would pass the `Content-Length` among them (the owner, 2026-11-09, "Fix
// in #411 FU"), and one that returns having written nothing under a `Content-Length` above 0 (the owner, 2026-11-09, "500 + close, as
// #411"); the server's loop then closes the connection in stages, as after its own `500` (the owner, 2026-11-09, "In stages").
pub class HttpWriter {
    mut TcpStream? stream = null
    mut Bytes ahead = Bytes()
    mut int before = 0
    mut string date = ""
    mut bool chunked = true
    mut long left = -1
    mut bool ended = false
    mut bool sent = false
    mut HttpRate? pace = null
    mut HttpBody? request = null
    mut bool announce = false
    mut bool closes = false
    mut bool refused = false
    mut IoError? failure = null

    // The writer of a body on `s`, the head `head`, all but the empty line that ends it, going out with its first write, before which
    // a read of the body `answered` may still send `100 Continue`; where `mayClose`, a head that goes out while that body still
    // awaits `100 Continue` says `Connection: close` (F9: `internal`, the maker std/'s writer calls). The stream is set to
    // `TCP_NODELAY` at each streamed response, one call of the system each, and the option stays set on it after the response, as
    // Kestrel sets every connection, so that a chunk, and the end of the body after it, goes out at once and not after the client's
    // acknowledgement of the write before, which a client that waits for the whole body gives only at its delayed-ACK timer.
    // A stream the option cannot be set on is written as it is, the option only a matter of time.
    // `count` is the `Content-Length` the body is held to, or -1 where it has none, `held` the bytes at the start of `head` that the
    // responses held before it take, and `dated` the `Date` line or empty, for the `500` that answers an `IoError` before the first write.
    internal static HttpWriter Make(TcpStream s, Bytes head, int held, string dated, bool isChunked, long count, HttpRate? rate, HttpBody? answered, bool mayClose) {
        s.SetNoDelay(true) else {
            IoError e => {
            }
        }

        w = HttpWriter()
        w.stream = s
        w.ahead = head
        w.before = held
        w.date = dated
        w.chunked = isChunked
        w.left = count
        w.pace = rate
        w.request = answered
        w.announce = mayClose
        return w
    }

    // Whether the head announced a close the server's loop makes after the function (F9).
    internal bool Closes => closes

    // Whether the writer wrote its own `500` in place of the response, after which the loop closes the connection in stages.
    internal bool Refused => refused

    // The head on its way, once: its empty line, after a `Connection: close` where the request's body still awaits `100 Continue`,
    // since the server's loop closes such a connection after the function; no read of the request's body sends `100 Continue` after it.
    void Started() {
        if sent {
            return
        }

        sent = true
        b = request
        if b != null {
            if announce && b.AwaitsContinue {
                ahead.AddRange("Connection: close\r\n".Bytes)
                closes = true
            }

            b.Begin()
        }

        ahead.AddRange("\r\n".Bytes)
    }

    // Writes `bytes` as one chunk of the body.
    pub void | IoError Write(Bytes bytes) {
        s = stream
        if ended || s == null {
            return IoError(IoKind.InvalidInput, 0, "writer used after its response ended")
        }

        f = failure
        if f != null {
            return f
        }

        if bytes.Count == 0 {
            return
        }

        if left >= 0 {
            if bytes.Count > left {
                e = IoError(IoKind.InvalidData, 0, "")
                failure = e
                return e
            }

            left = left - bytes.Count
        }

        Put(s, bytes) else {
            IoError e => {
                failure = e
                return e
            }
        }
    }

    // The head where it has not gone out, and `bytes` as one chunk.
    void | IoError Put(TcpStream s, Bytes bytes) {
        Started()
        mut out = ahead
        ahead = Bytes()
        if chunked {
            out.AddRange("{HttpHex(bytes.Count)}\r\n".Bytes)
        }

        if bytes.Count <= 65536 {
            out.AddRange(bytes)
        } else {
            if out.Count > 0 {
                HttpWrite(s, pace, out)
                out = Bytes()
            }

            HttpWrite(s, pace, bytes)
        }

        if out.Count > 0 {
            HttpWrite(s, pace, out)
        }

        if chunked {
            ahead.AddRange("\r\n".Bytes)
        }
    }

    // Writes `text` in UTF-8 as one chunk of the body.
    pub void | IoError Write(string text) => Write(text.Bytes)

    // The function returned: what is left of the head, the end of the last chunk and the chunk of no bytes that ends the body,
    // written, or where `hold` held in `pending`, which the head emptied, up to 64 KiB, to go out with the next response; after a
    // write that failed, its `IoError`, with nothing more written where the head went out, so that the loop closes the connection on a
    // body cut (F9), and the writer's own `500` where it did not, as for an `IoError` of the function (`Abort`), and for a body
    // short of its `Content-Length`, `IoError(InvalidData)`, after the writer's own `500` where no write sent the head (design record,
    // section 12: the owner, 2026-11-09, "500 + close, as #411"), and a body cut the same way where one did. A head that
    // says `Connection: close` is never held: the loop holds only where it keeps the connection and the request's body has no chunks
    // and a length of 0, while the loop's own close and a handler's `Connection: close` come only where it does not keep it, and the
    // writer announces its own only where that body, chunked or of a length above 0, still awaits `100 Continue`.
    internal void | IoError End(mut Bytes pending, bool hold) {
        ended = true
        f = failure
        if f != null {
            Abort()
            return f
        }

        s = stream
        if s == null {
            return
        }

        if left > 0 {
            Abort()
            return IoError(IoKind.InvalidData, 0, "")
        }

        Started()
        mut out = ahead
        ahead = Bytes()
        if chunked {
            out.AddRange("0\r\n\r\n".Bytes)
        }

        if hold && out.Count <= 65536 {
            pending = out
            return
        }

        if out.Count > 0 {
            HttpWrite(s, pace, out)
        }
    }

    // The function gave an `IoError`, or returned after a write that failed or short of its `Content-Length`: where no write sent the
    // head, nothing of the response was written, so the responses held before it go out with a `500` in its place, with no body and a
    // close, as a response the writer cannot write is answered (W8; design record, section 12: the owner, 2026-11-09, "500 + close",
    // "Fix in #411 FU" and "500 + close, as #411"), marked
    // `Refused` for the loop's close in stages; else no end of the body, so that a client of HTTP/1.1 sees it cut, while one of
    // HTTP/1.0, whose body the close ends, cannot tell it from a whole one (F9).
    internal void Abort() {
        ended = true
        s = stream
        if s == null || sent {
            return
        }

        mut out = ahead[0..<before]
        ahead = Bytes()
        HttpUnwritable(s, mut out, date, pace) else {
            IoError e => return
        }

        refused = true
    }
}

// An empty `Bytes`, for a place inside `HttpResponse`, where the name `Bytes` in an expression is the function that makes a response.
Bytes HttpNoBytes() => Bytes()

// The length of the file at `path`, for `HttpResponse`, where the name `File` in an expression is the function that makes a response.
long | IoError HttpFileSize(string path) => File.Size(path)

// What the writer answers a response that it cannot write: `500` with no body and a close (W8).
void | IoError HttpUnwritable(TcpStream s, mut Bytes pending, string date, HttpRate? pace) {
    pending.AddRange("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n{date}\r\n".Bytes)
    HttpFlush(s, mut pending, pace)
}

// The responses `pending` holds written, held to `pace` where it is given, and `pending` emptied.
void | IoError HttpFlush(TcpStream s, mut Bytes pending, HttpRate? pace) {
    if pending.Count > 0 {
        out = pending
        pending = HttpNoBytes()
        HttpWrite(s, pace, out)
    }
}

// The head `out` and then the file at `path` of `length` bytes, in pieces of 64 KiB, each a chunk where `chunked`; a file that
// gives fewer bytes than its length had, or more, is `InvalidData` once its head is out, and the connection is the caller's to close.
void | IoError HttpSendFile(TcpStream s, Bytes out, string path, long length, bool chunked) => HttpSendFile(s, out, path, length, chunked, null)

// The same, each write held to `pace` where it is given (W10).
void | IoError HttpSendFile(TcpStream s, Bytes out, string path, long length, bool chunked, HttpRate? pace) {
    f = File.Open(path)
    mut sent = 0L
    mut piece = out
    while true {
        mut read = Bytes()
        n = f.Read(mut read, 65536)
        if n == 0 {
            break
        }

        sent = sent + n
        if sent > length {
            f.Close()
            return IoError(IoKind.InvalidData, 0, path)
        }

        if chunked {
            piece.AddRange("{HttpHex(n)}\r\n".Bytes)
        }

        piece.AddRange(read)
        if chunked {
            piece.AddRange("\r\n".Bytes)
        }

        if sent == length {
            // the last piece goes out in one write with the end of the body, as hyper flushes the end with its last data: written
            // on its own after the piece, the end waits under Nagle's algorithm for the client's acknowledgement (W8)
            mut more = Bytes()
            extra = f.Read(mut more, 1)
            if extra > 0 {
                f.Close()
                return IoError(IoKind.InvalidData, 0, path)
            }

            break
        }

        HttpWrite(s, pace, piece)
        piece = Bytes()
    }

    f.Close()
    if sent != length {
        return IoError(IoKind.InvalidData, 0, path)
    }

    if chunked {
        piece.AddRange("0\r\n\r\n".Bytes)
    }

    if piece.Count > 0 {
        HttpWrite(s, pace, piece)
    }
}

// The number a `Content-Length` of a handler's holds, the white space `Trim` takes around its digits aside, or -1 where it holds
// anything else but digits, where it is empty, and where its number passes 10^18 + 9, so that the count stays inside a `long` (design
// record, section 12, assumed).
long HttpLength(string text) {
    b = text.Trim().Bytes
    if b.Count == 0 {
        return -1
    }

    mut n = 0L
    for c in b {
        if c < 48 || c > 57 || n > 100_000_000_000_000_000 {
            return -1
        }

        n = n * 10 + (c - 48)
    }

    return n
}

// Whether a `Transfer-Encoding`'s last coding is `chunked`.
bool HttpEndsInChunked(string value) {
    codings = value.Split(",")
    return codings[codings.Count - 1].Trim().ToLowerAscii() == "chunked"
}

// A size of a chunk in hexadecimal, as RFC 9112, section 7.1, writes it.
string HttpHex(long n) {
    if n == 0 {
        return "0"
    }

    digits = "0123456789abcdef".Bytes
    mut out = Bytes()
    mut rest = n
    while rest > 0 {
        out.Insert(0, digits[int(rest % 16)])
        rest = rest / 16
    }

    return string.FromUtf8(out) else {
        InvalidUtf8 => "0"
    }
}

// The reason phrase of a status, RFC 9110's, and RFC 6585's for `428`, `429`, `431` and `511`, empty for a status neither names.
string HttpReason(int status) {
    match status {
        100 => return "Continue"
        101 => return "Switching Protocols"
        200 => return "OK"
        201 => return "Created"
        202 => return "Accepted"
        203 => return "Non-Authoritative Information"
        204 => return "No Content"
        205 => return "Reset Content"
        206 => return "Partial Content"
        300 => return "Multiple Choices"
        301 => return "Moved Permanently"
        302 => return "Found"
        303 => return "See Other"
        304 => return "Not Modified"
        305 => return "Use Proxy"
        307 => return "Temporary Redirect"
        308 => return "Permanent Redirect"
        400 => return "Bad Request"
        401 => return "Unauthorized"
        402 => return "Payment Required"
        403 => return "Forbidden"
        404 => return "Not Found"
        405 => return "Method Not Allowed"
        406 => return "Not Acceptable"
        407 => return "Proxy Authentication Required"
        408 => return "Request Timeout"
        409 => return "Conflict"
        410 => return "Gone"
        411 => return "Length Required"
        412 => return "Precondition Failed"
        413 => return "Content Too Large"
        414 => return "URI Too Long"
        415 => return "Unsupported Media Type"
        416 => return "Range Not Satisfiable"
        417 => return "Expectation Failed"
        421 => return "Misdirected Request"
        422 => return "Unprocessable Content"
        426 => return "Upgrade Required"
        428 => return "Precondition Required"
        429 => return "Too Many Requests"
        431 => return "Request Header Fields Too Large"
        500 => return "Internal Server Error"
        501 => return "Not Implemented"
        502 => return "Bad Gateway"
        503 => return "Service Unavailable"
        504 => return "Gateway Timeout"
        505 => return "HTTP Version Not Supported"
        511 => return "Network Authentication Required"
        else => return ""
    }
}

// The server of HTTP/1.1 (design record, section 12; W9): `Serve` accepts each connection of a listener and serves it, one at a time,
// and `ServeConnection` serves every request of one accepted connection with the handler, in their order, and closes it, so that a
// program can write its own loop of `Accept`, as hyper's `serve_connection` lets it.
pub class HttpServer {
    // Every connection of the listener served with the handler within `HttpLimits()`, until an `Accept` fails other than for one
    // connection: a connection aborted, reset or refused before it was accepted goes on, as hyper's accept loop goes on past it.
    pub static void | IoError Serve(TcpListener listener, (HttpRequest) => HttpResponse handler) {
        return Serve(listener, handler, HttpLimits())
    }

    // The same, within `limits` (W7).
    pub static void | IoError Serve(TcpListener listener, (HttpRequest) => HttpResponse handler, HttpLimits limits) {
        HttpCheckLimits(limits)
        while true {
            match listener.Accept() {
                TcpStream stream => {
                    ServeConnection(stream, handler, limits) else {
                        IoError e => {
                        }
                        HttpError e => {
                        }
                    }
                }
                IoError e => {
                    if e.Kind != IoKind.ConnectionAborted && e.Kind != IoKind.ConnectionReset && e.Kind != IoKind.ConnectionRefused {
                        return e
                    }
                }
            }
        }
    }

    // Every request of the connection served with the handler within `HttpLimits()`, and the connection closed: `void` where it
    // ended between two requests, the `IoError` of the network, or the `HttpError` of a request the server refused.
    pub static void | IoError | HttpError ServeConnection(TcpStream stream, (HttpRequest) => HttpResponse handler) {
        return ServeConnection(stream, handler, HttpLimits())
    }

    // The same, within `limits` (W7).
    pub static void | IoError | HttpError ServeConnection(TcpStream stream, (HttpRequest) => HttpResponse handler, HttpLimits limits) {
        HttpCheckLimits(limits) else {
            IoError e => {
                stream.Close()
                return e
            }
        }

        HttpServeRequests(stream, handler, limits) else {
            IoError e => {
                stream.Close()
                return e
            }
            HttpError e => {
                stream.Close()
                return e
            }
        }

        stream.Close()
    }
}

// The kinds of a failed parse of a `Uri` (design record, section 12; W12): a scheme that is missing or holds a byte a scheme does
// not take; a host that is missing, `//` before it among it, or holds a byte a host does not take; a port that is no number from 0
// to 65535; and a byte no part of a `Uri` takes, a space, a control byte or one past ASCII among them, or a `%` without two hex
// digits after it (RFC 3986, section 2).
pub enum UriKind { Scheme, Host, Port, Character }

// A failed parse of a `Uri`: its kind, and the position of the first byte the parse refused, counted in bytes from 0, as `HexError`
// holds its `At`; it holds no input (design record, section 12; W12).
pub data UriError(UriKind Kind, int At)

// An address of HTTP made from text, `scheme://host:port/path?query#fragment`, as .NET's `Uri` (design record, section 12; W12):
// `Uri.Parse` gives it, and its parts are held as the text writes them, with no escaping and no unescaping.
pub class Uri {
    mut string scheme = ""
    mut string host = ""
    mut int port = -1
    mut string path = "/"
    mut string query = ""

    // The scheme as written, `http` or `HTTP`.
    pub string Scheme => scheme

    // The host as written: a name, an IPv4 address, or an IPv6 address between its brackets, `[::1]`.
    pub string Host => host

    // The port written after the host, or the scheme's own where none is: 80 for `http`, 443 for `https` and -1 for another.
    pub int Port => port

    // The path from its first `/`, and `/` where the text has none.
    pub string Path => path

    // The query after the `?`, without it, as `HttpRequest.Query` holds it, and empty where the text has none.
    pub string Query => query

    // The `Uri` of `text`, or the `UriError` of the first byte the parse refuses; a fragment after `#` is read and is no part, and
    // so is a user's part before an `@` of the host.
    pub static Uri | UriError Parse(string text) {
        b = text.Bytes
        for i in 0..<b.Count {
            if !UriByte(b[i]) {
                return UriError(UriKind.Character, i)
            }

            if b[i] == 37 && (i + 2 >= b.Count || !UriHex(b[i + 1]) || !UriHex(b[i + 2])) {
                return UriError(UriKind.Character, i)
            }
        }

        if b.Count == 0 || !UriLetter(b[0]) {
            return UriError(UriKind.Scheme, 0)
        }

        mut at = 1
        while at < b.Count && b[at] != 58 {
            c = b[at]
            if !UriLetter(c) && !(c >= 48 && c <= 57) && c != 43 && c != 45 && c != 46 {
                return UriError(UriKind.Scheme, at)
            }

            at = at + 1
        }

        if at == b.Count {
            return UriError(UriKind.Scheme, at)
        }

        u = Uri()
        u.scheme = text.Substring(0, at)
        at = at + 1
        if at + 1 >= b.Count || b[at] != 47 || b[at + 1] != 47 {
            return UriError(UriKind.Host, at)
        }

        at = at + 2
        mut stop = at
        while stop < b.Count && b[stop] != 47 && b[stop] != 63 && b[stop] != 35 {
            stop = stop + 1
        }

        mut hostStart = at
        for i in at..<stop {
            if b[i] == 64 {
                hostStart = i + 1
            }
        }

        mut hostEnd = hostStart
        if hostStart < stop && b[hostStart] == 91 {
            hostEnd = hostStart + 1
            while hostEnd < stop && b[hostEnd] != 93 {
                c = b[hostEnd]
                if !(c >= 48 && c <= 58 || c >= 97 && c <= 102 || c >= 65 && c <= 70 || c == 46) {
                    return UriError(UriKind.Host, hostEnd)
                }

                hostEnd = hostEnd + 1
            }

            if hostEnd == stop || hostEnd == hostStart + 1 {
                return UriError(UriKind.Host, hostEnd)
            }

            hostEnd = hostEnd + 1
            if hostEnd < stop && b[hostEnd] != 58 {
                return UriError(UriKind.Host, hostEnd)
            }
        } else {
            while hostEnd < stop && b[hostEnd] != 58 {
                if b[hostEnd] == 91 || b[hostEnd] == 93 {
                    return UriError(UriKind.Host, hostEnd)
                }

                hostEnd = hostEnd + 1
            }
        }

        if hostEnd == hostStart {
            return UriError(UriKind.Host, hostStart)
        }

        u.host = text.Substring(hostStart, hostEnd - hostStart)
        lower = u.scheme.ToLowerAscii()
        if lower == "http" {
            u.port = 80
        } else if lower == "https" {
            u.port = 443
        }

        if hostEnd + 1 < stop {
            mut number = 0
            for i in hostEnd + 1..<stop {
                c = b[i]
                if c < 48 || c > 57 {
                    return UriError(UriKind.Port, i)
                }

                number = number * 10 + (c - 48)
                if number > 65535 {
                    return UriError(UriKind.Port, i)
                }
            }

            u.port = number
        }

        mut q = stop
        while q < b.Count && b[q] != 63 && b[q] != 35 {
            q = q + 1
        }

        if q > stop {
            u.path = text.Substring(stop, q - stop)
        }

        if q < b.Count && b[q] == 63 {
            mut f = q + 1
            while f < b.Count && b[f] != 35 {
                f = f + 1
            }

            u.query = text.Substring(q + 1, f - q - 1)
        }

        return u
    }

    // `reference` resolved against `base` as RFC 3986, section 5.2.2, resolves it, its path's dot segments removed (section 5.2.4):
    // a reference with a scheme stands alone, one that starts with `//` takes the base's scheme, one that starts with `/` its host and
    // port too, one that starts with `?` its path too, and any other its path up to its last `/` as well; null where the result is
    // no `Uri` (W15).
    internal static Uri? Resolve(Uri base, string reference) {
        mut text = reference
        if !UriHasScheme(reference) {
            prefix = "{base.Scheme}://{base.Host}:{base.Port}"
            if reference.StartsWith("//") {
                text = "{base.Scheme}:{reference}"
            } else if reference.StartsWith("/") {
                text = "{prefix}{reference}"
            } else if reference.StartsWith("?") {
                text = "{prefix}{base.Path}{reference}"
            } else if reference == "" || reference.StartsWith("#") {
                text = "{prefix}{base.Path}"
                if base.Query != "" {
                    text = "{prefix}{base.Path}?{base.Query}"
                }
            } else {
                text = "{prefix}{UriDirectory(base.Path)}{reference}"
            }
        }

        match Parse(text) {
            Uri u => {
                u.path = UriDotless(u.path)
                return u
            }
            UriError e => return null
        }
    }
}

// The escapes of RFC 3986, section 2.1, read and written by functions shaped as C#'s `Uri.UnescapeDataString` and
// `Uri.EscapeDataString`, and made as Rust's `percent-encoding` crate makes them (design record, section 12; W17): `Decode` refuses
// decoded bytes that are no UTF-8, as the crate's `decode_utf8` does, where C# leaves their escapes as they are. `r.Path` stays
// as the request gave it (W5), and a program decodes it where it wants the text.
pub class Url {
    // The text with each `%` that has two hex digits after it, of either case, read as the byte they name, and the bytes then read
    // as UTF-8: the string, or `InvalidUtf8` at the first position of the decoded bytes that is no UTF-8, as `string.FromUtf8`
    // gives it. A `%` without two hex digits after it stays as it is, and a `+` stays a `+`. No path is checked, so `%2F` gives
    // a `/` and `%00` the character U+0000. A text without a `%` is given back as it is, as the crate borrows it.
    pub static string | InvalidUtf8 Decode(string text) {
        if !text.Contains('%') {
            return text
        }

        b = text.Bytes
        mut out = Bytes()
        mut i = 0
        while i < b.Count {
            if b[i] == 37 && i + 2 < b.Count {
                high = UrlHexValue(b[i + 1])
                low = UrlHexValue(b[i + 2])
                if high >= 0 && low >= 0 {
                    out.Add(byte(high * 16 + low))
                    i = i + 3
                    continue
                }
            }

            out.Add(b[i])
            i = i + 1
        }

        return string.FromUtf8(out)
    }

    // The text with each byte of its UTF-8 other than RFC 3986's unreserved ones, the ASCII letters, the digits and `-._~`, written
    // as `%` and two upper-case hex digits, as C#'s `EscapeDataString` writes it, so that `Decode` gives the text back. A text
    // with no other byte is given back as it is, as the crate borrows it.
    pub static string Encode(string text) {
        b = text.Bytes
        mut i = 0
        while i < b.Count && UrlUnreserved(b[i]) {
            i = i + 1
        }

        if i == b.Count {
            return text
        }

        mut out = Bytes()
        for j in 0..<b.Count {
            c = b[j]
            if UrlUnreserved(c) {
                out.Add(c)
            } else {
                out.Add(byte(37))
                out.Add(UrlHexDigit(int(c) >> 4))
                out.Add(UrlHexDigit(int(c) & 15))
            }
        }

        // every byte written is ASCII, so the bytes are UTF-8 and the arm is never taken
        encoded = string.FromUtf8(out) else {
            InvalidUtf8 => ""
        }

        return encoded
    }
}

// The value of the hex digit `c`, of either case, or -1 where `c` is none.
int UrlHexValue(byte c) {
    if c >= 48 && c <= 57 {
        return int(c) - 48
    }

    if c >= 97 && c <= 102 {
        return int(c) - 87
    }

    if c >= 65 && c <= 70 {
        return int(c) - 55
    }

    return -1
}

// The digit of `d`, 0 to 15, in upper-case hexadecimal, as RFC 3986, section 2.1, writes an escape.
byte UrlHexDigit(int d) {
    if d < 10 {
        return byte(48 + d)
    }

    return byte(55 + d)
}

// Whether `c` is one of RFC 3986's unreserved bytes, which `Url.Encode` leaves as they are: an ASCII letter, a digit, `-`, `.`, `_`
// or `~`.
bool UrlUnreserved(byte c) => c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 45 || c == 46 || c == 95 || c == 126

// A date of HTTP, RFC 9110, section 5.6.7, the form of a `Date`, a `Last-Modified` and an `If-Modified-Since`, written and read
// as Rust's `httpdate` crate, which hyper uses, writes and reads it (design record, section 12; W18).
pub class HttpDate {
    // The IMF-fixdate of `at`, `Sun, 06 Nov 1994 08:49:37 GMT`, its second taken towards the past, as the crate drops the
    // fraction; the server writes its own `Date` by `HttpDateOf`, the function this one writes by.
    pub static string Format(timestamp at) => HttpDateOf(HttpSecondOf(at))

    // The instant of a date in one of the three forms RFC 9110 has a recipient read, after ASCII's whitespace is taken from
    // both ends, as the crate trims it: the IMF-fixdate, RFC 850's `Sunday, 06-Nov-94 08:49:37 GMT`, whose two digits of the year
    // name 1970 to 2069 as the crate reads them, and asctime's `Sun Nov  6 08:49:37 1994`. Names are compared with their case,
    // and the weekday must be the date's, as the crate checks it. `Empty` for a text of whitespace alone; `TooSmall` for a year
    // before 1970, which the crate refuses; `TooLarge` past the last second a `timestamp` holds, 2262-04-11 23:47:16; and
    // `InvalidDigit` for every other text, one in none of the three forms, a time past 23:59:59, a day the month does not have
    // and a weekday that is not the date's among them.
    pub static timestamp | ParseError Parse(string text) {
        b = text.TrimAscii().Bytes
        if b.Count == 0 {
            return ParseError(ParseKind.Empty)
        }

        mut f = HttpImfFixdate(b)
        if f.Year < 0 {
            f = HttpRfc850Date(b)
        }

        if f.Year < 0 {
            f = HttpAsctime(b)
        }

        if f.Year < 0 {
            return ParseError(ParseKind.InvalidDigit)
        }

        if f.Year < 1970 {
            return ParseError(ParseKind.TooSmall)
        }

        if f.Hour > 23 || f.Minute > 59 || f.Second > 59 || f.Day < 1 || f.Day > HttpDaysIn(f.Month, f.Year) {
            return ParseError(ParseKind.InvalidDigit)
        }

        long days = HttpDaysFrom(f.Year, f.Month, f.Day)
        if int((days + 3) % 7) != f.Weekday {
            return ParseError(ParseKind.InvalidDigit)
        }

        long second = days * 86400 + long(f.Hour) * 3600 + long(f.Minute) * 60 + long(f.Second)
        if second > 9223372036 {
            return ParseError(ParseKind.TooLarge)
        }

        long bits = second * 1_000_000_000
        raw {
            return *Ptr<timestamp>(&bits)
        }
    }
}

// The fields of a date of HTTP as one of its forms writes them, before they are checked: the weekday from 0 for Monday, the
// month from 1, and a `Year` of -1 where the text is not that form.
data HttpDateFields(int Weekday, int Day, int Month, int Year, int Hour, int Minute, int Second)

HttpDateFields HttpDateNone() => HttpDateFields(0, 0, 0, -1, 0, 0, 0)

// `Sun, 06 Nov 1994 08:49:37 GMT`, the IMF-fixdate.
HttpDateFields HttpImfFixdate(Bytes b) {
    if b.Count != 29 || b[3] != 44 || b[4] != 32 || b[7] != 32 || b[11] != 32 || b[16] != 32 || b[19] != 58 || b[22] != 58 || !HttpDateWord(b, 25, " GMT") {
        return HttpDateNone()
    }

    weekday = HttpDateName(b, 0, ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])
    month = HttpDateName(b, 8, ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"])
    day = HttpDateNumber(b, 5, 2)
    year = HttpDateNumber(b, 12, 4)
    hour = HttpDateNumber(b, 17, 2)
    minute = HttpDateNumber(b, 20, 2)
    second = HttpDateNumber(b, 23, 2)
    if weekday < 0 || month < 0 || day < 0 || year < 0 || hour < 0 || minute < 0 || second < 0 {
        return HttpDateNone()
    }

    return HttpDateFields(weekday, day, month + 1, year, hour, minute, second)
}

// `Sunday, 06-Nov-94 08:49:37 GMT`, RFC 850's form, whose year of two digits is 1970 to 2069, 70 to 99 the 1900s, as the crate
// reads it.
HttpDateFields HttpRfc850Date(Bytes b) {
    names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    mut weekday = -1
    mut at = 0
    for i in 0..<names.Count {
        n = names[i].Bytes.Count
        if weekday < 0 && b.Count == n + 24 && HttpDateWord(b, 0, names[i]) && HttpDateWord(b, n, ", ") {
            weekday = i
            at = n + 2
        }
    }

    if weekday < 0 || b[at + 2] != 45 || b[at + 6] != 45 || b[at + 9] != 32 || b[at + 12] != 58 || b[at + 15] != 58 || !HttpDateWord(b, at + 18, " GMT") {
        return HttpDateNone()
    }

    month = HttpDateName(b, at + 3, ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"])
    day = HttpDateNumber(b, at, 2)
    mut year = HttpDateNumber(b, at + 7, 2)
    hour = HttpDateNumber(b, at + 10, 2)
    minute = HttpDateNumber(b, at + 13, 2)
    second = HttpDateNumber(b, at + 16, 2)
    if month < 0 || day < 0 || year < 0 || hour < 0 || minute < 0 || second < 0 {
        return HttpDateNone()
    }

    if year < 70 {
        year = year + 2000
    } else {
        year = year + 1900
    }

    return HttpDateFields(weekday, day, month + 1, year, hour, minute, second)
}

// `Sun Nov  6 08:49:37 1994`, asctime's form, whose day is two digits or a space and one digit.
HttpDateFields HttpAsctime(Bytes b) {
    if b.Count != 24 || b[3] != 32 || b[7] != 32 || b[10] != 32 || b[13] != 58 || b[16] != 58 || b[19] != 32 {
        return HttpDateNone()
    }

    weekday = HttpDateName(b, 0, ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])
    month = HttpDateName(b, 4, ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"])
    mut day = HttpDateNumber(b, 8, 2)
    if b[8] == 32 {
        day = HttpDateNumber(b, 9, 1)
    }

    year = HttpDateNumber(b, 20, 4)
    hour = HttpDateNumber(b, 11, 2)
    minute = HttpDateNumber(b, 14, 2)
    second = HttpDateNumber(b, 17, 2)
    if weekday < 0 || month < 0 || day < 0 || year < 0 || hour < 0 || minute < 0 || second < 0 {
        return HttpDateNone()
    }

    return HttpDateFields(weekday, day, month + 1, year, hour, minute, second)
}

// Whether the bytes of `word` stand in `b` from `at`.
bool HttpDateWord(Bytes b, int at, string word) {
    w = word.Bytes
    if at + w.Count > b.Count {
        return false
    }

    for i in 0..<w.Count {
        if b[at + i] != w[i] {
            return false
        }
    }

    return true
}

// The position in `names` of the name of three bytes that stands in `b` from `at`, or -1 where none does.
int HttpDateName(Bytes b, int at, List<string> names) {
    for i in 0..<names.Count {
        if HttpDateWord(b, at, names[i]) {
            return i
        }
    }

    return -1
}

// The number the `count` decimal digits of `b` from `at` write, or -1 where one of them is no digit.
int HttpDateNumber(Bytes b, int at, int count) {
    mut n = 0
    for i in 0..<count {
        c = b[at + i]
        if c < 48 || c > 57 {
            return -1
        }

        n = n * 10 + int(c) - 48
    }

    return n
}

// The days of `month` in `year` of the Gregorian calendar.
int HttpDaysIn(int month, int year) {
    if month == 2 {
        if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) {
            return 29
        }

        return 28
    }

    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }

    return 31
}

// The days from 1970-01-01 to the date, a year from 1970 on, by the algorithm `days_from_civil`, the inverse of the
// `civil_from_days` that `HttpDateOf` writes a day by.
long HttpDaysFrom(int year, int month, int day) {
    mut long y = long(year)
    if month <= 2 {
        y = y - 1
    }

    era = y / 400
    yoe = y - era * 400
    mut long mp = long(month) - 3
    if month <= 2 {
        mp = long(month) + 9
    }

    doy = (153 * mp + 2) / 5 + long(day) - 1
    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// The options of a client, with .NET's names and, but for the redirects, its defaults (design record, section 12; W13): the
// connections to one host, which no number bounds, `int.MaxValue` as .NET's; the time an idle connection is kept, 1 minute; the
// life of a connection, which no time bounds, the largest `duration`, since no member of `HttpLimits` turns off; the redirects
// followed, 20, as browsers allow, where .NET follows 50 (W15), and 0 for none; the
// limits of a response's head, a request's (W7); and the time of a call, 100 seconds, as .NET's `HttpClient.Timeout` (W16).
pub data HttpClientOptions(
    int MaxConnectionsPerServer = 2147483647,
    duration PooledConnectionIdleTimeout = 1min,
    duration PooledConnectionLifetime = 9223372036854775807ns,
    int MaxAutomaticRedirections = 20,
    HttpLimits Limits = HttpLimits(),
    duration Timeout = 100s)

// A response a client got: its status, its headers, and its body, read as a stream as a request's is, which holds its connection
// until it ends (design record, section 12; W14).
pub class HttpResponseMessage(int Status, HttpHeaders Headers, HttpBody Body) {
    // Whether the status is a success, from 200 to 299, as .NET's `IsSuccessStatusCode`.
    pub bool IsSuccess => Status >= 200 && Status <= 299

    // `void` for a success, and the `HttpError` of the kind `Status` for any other status, as .NET's `EnsureSuccessStatusCode`
    // throws one.
    pub void | HttpError EnsureSuccess() {
        if !IsSuccess {
            return HttpError(HttpKind.Status, "response status {Status}")
        }
    }
}

// A connection of a client's pool: its stream, its host and port, when it opened and when it last went idle, and, while a response
// holds it, that response's body, held weakly, so that a body let go of unread closes the connection at the next call (W13).
class HttpConnection(TcpStream Stream, string Key, instant Opened) {
    internal mut instant idleSince = Opened
    internal mut weak HttpBody? body = null
    internal mut bool keep = true
    internal mut bool ended = false
    internal mut bool clean = false

    // Marks the connection's body ended, `clean` where it ended with no failure, so that the stream holds what follows it, and
    // idle from now, as hyper-util's pool takes the time a connection goes back.
    internal void Ends(bool isClean) {
        ended = true
        clean = isClean
        idleSince = instant.Now
    }
}

// A client of HTTP/1.1, as .NET's `HttpClient` (design record, section 12; W13): `HttpClient()` with `HttpClientOptions()`, and
// `HttpClient(options)`; it keeps a pool of connections, several to each host, as .NET's `SocketsHttpHandler` keeps one, each
// connection carrying one request at a time, as hyper's client `conn` carries it, and held by its response until the body ends.
// While the compiler builds no actors, the pool lives in the program's one actor (section 12).
pub class HttpClient(HttpClientOptions Options = HttpClientOptions()) {
    mut List<HttpConnection> idle = List<HttpConnection>()
    mut List<HttpConnection> busy = List<HttpConnection>()

    // The response to a `GET` of `uri`, with its redirects followed up to `MaxAutomaticRedirections` (W15), or the failure of the
    // network or of HTTP.
    pub HttpResponseMessage | IoError | HttpError Get(Uri uri) {
        call = HttpCall(instant.Now, Options.Timeout)
        mut target = uri
        mut followed = 0
        while true {
            response = Exchange(target, call)
            next = HttpRedirect(target, response)
            if next == null || Options.MaxAutomaticRedirections <= 0 {
                return response
            }

            Let(response)
            if followed >= Options.MaxAutomaticRedirections {
                return HttpError(HttpKind.Protocol, "too many redirects")
            }

            followed = followed + 1
            target = next
        }

        return HttpError(HttpKind.Protocol, "too many redirects")
    }

    // One request and its response, on the connection the pool holds for the host and port that went idle last, or on a new one: a
    // connection of the pool that ends before the first byte of a response carries the request again on a new one, once, as .NET
    // sends a request again on a connection the server shut down (W13); all of it within what remains of the `call` (W16).
    HttpResponseMessage | IoError | HttpError Exchange(Uri uri, HttpCall call) {
        scheme = uri.Scheme.ToLowerAscii()
        if scheme == "https" {
            return HttpError(HttpKind.Unsupported, "https is not supported: no TLS")
        }

        if scheme != "http" {
            return HttpError(HttpKind.Unsupported, "unsupported scheme")
        }

        key = "{uri.Host.ToLowerAscii()}:{uri.Port}"
        request = HttpGetHead(uri).Bytes
        pooled = Checkout(key)
        if pooled != null {
            match Carry(pooled, request, call) {
                HttpResponseMessage r => return r
                IoError e => return e
                HttpError e => return e
                HttpSilent quiet => {
                }
            }
        }

        c = Open(uri, key, call)
        match Carry(c, request, call) {
            HttpResponseMessage r => return r
            IoError e => return e
            HttpError e => return e
            HttpSilent quiet => {
                e = quiet.Error
                if e != null {
                    return e
                }

                return HttpError(HttpKind.Protocol, "malformed response: no status line")
            }
        }
    }

    // The request written on the connection and the head of its response read, each under what remains of the `call`, whose time
    // the body's reads keep (W16): the connection is busy while the response's body is open, `HttpSilent` where it ended before the
    // first byte of a head, and closed then, as on every failure; the call's time running out is no such end.
    HttpResponseMessage | IoError | HttpError | HttpSilent Carry(HttpConnection c, Bytes request, HttpCall call) {
        s = c.Stream
        HttpCallWrites(s, call) else {
            IoError e => {
                HttpShut(s)
                return e
            }
        }

        s.Write(request) else {
            IoError e => {
                HttpShut(s)
                if e.Kind == IoKind.TimedOut {
                    return HttpCallTimedOut()
                }

                return HttpSilent(e)
            }
        }

        match HttpReadResponse(s, Options.Limits, call) {
            HttpResponseHead h => {
                body = HttpBody.MakeResponse(s, h.Length, h.Chunked, h.ToEnd, Options.Limits.MaxChunkSizeLine)
                body.call = call
                c.body = body
                c.keep = h.Keep
                if body.Ended {
                    c.Ends(true)
                } else {
                    body.home = c
                }

                busy.Add(c)
                return HttpResponseMessage(h.Status, h.Headers, body)
            }
            IoError e => {
                HttpShut(s)
                return e
            }
            HttpError e => {
                HttpShut(s)
                return e
            }
            HttpSilent quiet => {
                HttpShut(s)
                return quiet
            }
        }
    }

    // The connection of `key` that went idle last, or null. First each busy connection whose body ended goes idle, or closes where its
    // response said so, its body failed or its life is over, and each whose body was let go of unread closes; then each idle
    // connection idle longer than `PooledConnectionIdleTimeout`, or open longer than `PooledConnectionLifetime`, closes, as
    // hyper-util's pool passes over expired connections at its checkout (W13).
    HttpConnection? Checkout(string key) {
        now = instant.Now
        mut i = 0
        while i < busy.Count {
            c = busy[i]
            if c.ended {
                busy.RemoveAt(i)
                if c.keep && c.clean && now - c.Opened <= Options.PooledConnectionLifetime {
                    idle.Add(c)
                } else {
                    HttpShut(c.Stream)
                }
            } else if c.body == null {
                busy.RemoveAt(i)
                HttpShut(c.Stream)
            } else {
                i = i + 1
            }
        }

        mut j = 0
        while j < idle.Count {
            c = idle[j]
            if now - c.idleSince > Options.PooledConnectionIdleTimeout || now - c.Opened > Options.PooledConnectionLifetime {
                idle.RemoveAt(j)
                HttpShut(c.Stream)
            } else {
                j = j + 1
            }
        }

        mut pick = -1
        mut k = 0
        while k < idle.Count {
            c = idle[k]
            if c.Key == key && (pick < 0 || c.idleSince - idle[pick].idleSince >= 0s) {
                pick = k
            }

            k = k + 1
        }

        if pick < 0 {
            return null
        }

        chosen = idle[pick]
        idle.RemoveAt(pick)
        chosen.ended = false
        chosen.clean = false
        return chosen
    }

    // A new connection to the host and port of `uri`, its connect bounded by what remains of the `call` (W16), or the `HttpError` of
    // a host whose connections reach `MaxConnectionsPerServer`, since in a program of one actor no other actor gives one back (W13).
    HttpConnection | IoError | HttpError Open(Uri uri, string key, HttpCall call) {
        mut count = 0
        for c in busy {
            if c.Key == key {
                count = count + 1
            }
        }

        if count >= Options.MaxConnectionsPerServer {
            return HttpError(HttpKind.TooLarge, "too many connections to the host")
        }

        remains = HttpCallLeft(call)
        s = TcpStream.Connect("{uri.Host}:{uri.Port}", remains) else {
            IoError e => return HttpCallFailed(e, call)
        }

        return HttpConnection(s, key, instant.Now)
    }

    // Lets go of a response the client follows past: its body read and dropped up to `MaxDrainSize`, so that its connection goes idle,
    // and the connection closed where the body is longer or fails (W15).
    void Let(HttpResponseMessage response) {
        drained = response.Body.Drain(Options.Limits.MaxDrainSize) else {
            IoError e => false
            HttpError e => false
        }

        if drained {
            return
        }

        mut i = 0
        while i < busy.Count {
            c = busy[i]
            if c.body == response.Body {
                busy.RemoveAt(i)
                HttpShut(c.Stream)
                return
            }

            i = i + 1
        }
    }
}

// A limit of zero or below, `InvalidInput` naming the member, as a time of zero or below is at `Connect`.
void | IoError HttpCheckLimits(HttpLimits limits) {
    if limits.MaxRequestLineSize <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxRequestLineSize")
    }

    if limits.MaxRequestHeadersTotalSize <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxRequestHeadersTotalSize")
    }

    if limits.MaxRequestHeaderCount <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxRequestHeaderCount")
    }

    if limits.MaxRequestBodySize <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxRequestBodySize")
    }

    if limits.RequestHeadersTimeout <= 0s {
        return IoError(IoKind.InvalidInput, 0, "RequestHeadersTimeout")
    }

    if limits.MinRequestBodyDataRate.BytesPerSecond <= 0 || limits.MinRequestBodyDataRate.Grace <= 0s {
        return IoError(IoKind.InvalidInput, 0, "MinRequestBodyDataRate")
    }

    if limits.MinResponseDataRate.BytesPerSecond <= 0 || limits.MinResponseDataRate.Grace <= 0s {
        return IoError(IoKind.InvalidInput, 0, "MinResponseDataRate")
    }

    if limits.MaxRequestsPerConnection <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxRequestsPerConnection")
    }

    if limits.KeepAliveTimeout <= 0s {
        return IoError(IoKind.InvalidInput, 0, "KeepAliveTimeout")
    }

    if limits.MaxDrainSize <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxDrainSize")
    }

    if limits.MaxChunkSizeLine <= 0 {
        return IoError(IoKind.InvalidInput, 0, "MaxChunkSizeLine")
    }
}

// The requests of one connection, each read, given to the handler and answered before the next is read, as hyper's dispatcher
// serves them: the loop ends where the connection ends between two requests, where a response or a request closes it, and at a
// request the server refuses, which it answers with its status alone.
void | IoError | HttpError HttpServeRequests(TcpStream s, (HttpRequest) => HttpResponse handler, HttpLimits limits) {
    mut served = 0
    mut second = -1L
    mut date = ""
    mut pending = HttpNoBytes()
    mut ahead = false
    while true {
        // the wait for the first byte of each request, the first of the connection among them, `KeepAliveTimeout`, as Kestrel
        // arms it (section 12); none where the head of the next request stands whole in the buffer already, which the `Fill` takes
        // with no call of the system
        if !ahead {
            s.SetReadTimeout(limits.KeepAliveTimeout)
        }

        mut first = Bytes()
        n = s.Fill(mut first) else {
            IoError e => {
                if e.Kind == IoKind.TimedOut || e.Kind == IoKind.ConnectionReset {
                    return
                }

                return e
            }
        }

        if n == 0 {
            return
        }

        // the head's time counts from its first byte, by the monotonic clock, and the `Date` reads the civil one
        begun = instant.Now
        now = HttpSecondOf(timestamp.Now)
        if now != second {
            second = now
            date = "Date: {HttpDateOf(now)}\r\n"
        }

        pace = limits.MinResponseDataRate
        match HttpReadRequest(s, limits, begun + limits.RequestHeadersTimeout) {
            HttpRefused no => {
                HttpRefuse(s, mut pending, no.Status, date, pace) else {
                    IoError e => return no.Error
                }

                HttpLinger(s, limits)
                return no.Error
            }
            IoError e => {
                if e.Kind == IoKind.TimedOut {
                    HttpRefuse(s, mut pending, 408, date, pace) else {
                        IoError lost => return HttpTimedOut()
                    }

                    HttpLinger(s, limits)
                    return HttpTimedOut()
                }

                return e
            }
            HttpRequest r => {
                served = served + 1
                if pending.Count > 0 && !r.Body.Ended {
                    // a handler that reads a body may wait for it, and its first read may send `100 Continue`: the responses
                    // before it go out first
                    HttpFlush(s, mut pending, pace)
                }

                response = handler(r)
                headers = response.Headers
                mut keep = r.minor == 1 && served < limits.MaxRequestsPerConnection && response.Status != 500
                if HttpCloses(r.Headers) || HttpCloses(headers) {
                    keep = false
                }

                body = r.Body
                if body.TimedOut {
                    HttpRefuse(s, mut pending, 408, date, pace) else {
                        IoError lost => return HttpTimedOut()
                    }

                    HttpLinger(s, limits)
                    return HttpTimedOut()
                }

                streams = response.Streams
                if body.Failed || (body.AwaitsContinue && !streams) {
                    keep = false
                } else if keep && !streams {
                    drained = body.Drain(limits.MaxDrainSize) else {
                        IoError e => return e
                        HttpError e => {
                            // a body under its rate gives the server's own `request timed out` (section 12, Q12 (b)), answered `408`
                            if body.TimedOut {
                                HttpRefuse(s, mut pending, 408, date, pace) else {
                                    IoError lost => return HttpTimedOut()
                                }

                                HttpLinger(s, limits)
                                return HttpTimedOut()
                            }

                            return e
                        }
                    }

                    if !drained {
                        keep = false
                    }
                }

                mut dated = date
                if headers.Get("Date") != null {
                    dated = ""
                }

                // the server's own `Connection: close` before a close, beside a handler's `Connection` that does not say it (section
                // 12, the owner, 2026-11-05, Q6)
                close = !keep && !HttpCloses(headers)
                mut refused = false
                written = response.Serve(s, r.Method != "HEAD", dated, close, r.minor == 0, pace, mut pending, keep && r.next, body, mut refused) else {
                    IoError e => {
                        // the writer's own `500` before its `IoError` closes in stages, as the loop's own does (section 12, the owner,
                        // 2026-11-09, "In stages")
                        if refused {
                            HttpLinger(s, limits)
                        }

                        return e
                    }
                }

                if !keep || !written {
                    HttpLinger(s, limits)
                    return
                }

                if streams {
                    // the function may read the request's body while it writes, as hyper reads one while its response goes out,
                    // so that what it left is drained after it
                    if body.TimedOut {
                        return HttpTimedOut()
                    }

                    if body.Failed || body.AwaitsContinue {
                        return
                    }

                    // a body under its rate gives the server's own `request timed out`, as Q12 (b) of section 12 gives it to a read of
                    // the function, with no `408`, since the head has gone out (W11, assumed)
                    drained = body.Drain(limits.MaxDrainSize) else {
                        IoError e => return e
                        HttpError e => return e
                    }

                    if !drained {
                        return
                    }
                }

                ahead = r.next
            }
        }
    }
}

// The status line alone that answers a request the server refuses, with an empty body, its `Date` and a close, and nothing where the
// status is 0 (section 12, "Status line only"), after the responses `pending` holds and in the same write, held to `pace`.
void | IoError HttpRefuse(TcpStream s, mut Bytes pending, int status, string date, HttpRate pace) {
    if status != 0 {
        pending.AddRange("HTTP/1.1 {status} {HttpReason(status)}\r\nContent-Length: 0\r\nConnection: close\r\n{date}\r\n".Bytes)
    }

    HttpFlush(s, mut pending, pace)
}

// The close in stages of a connection the server closes once it has written a response or a refusal, as RFC 9112, section 9.6, has a
// server close one (section 12, the owner, 2026-11-02, "a half-close on `TcpStream`"): its writes ended, so that the client reads the
// end of what was written, then what the client still sends read and dropped, at most `MaxDrainSize` bytes within `KeepAliveTimeout`,
// so that a close with bytes unread sends no reset that takes the response from the client; a half-close the system refuses, or a read
// that fails, ends it at once (section 12, assumed). `ServeConnection` then closes the stream.
void HttpLinger(TcpStream s, HttpLimits limits) {
    s.ShutdownWrite() else {
        IoError e => return
    }

    deadline = instant.Now + limits.KeepAliveTimeout
    mut room = long(limits.MaxDrainSize)
    mut dropped = Bytes()
    while room > 0 {
        HttpWaitUntil(s, deadline) else {
            IoError e => return
        }

        dropped.Clear()
        mut piece = 65536
        if room < piece {
            piece = int(room)
        }

        n = s.Read(mut dropped, piece) else {
            IoError e => return
        }

        if n == 0 {
            return
        }

        room = room - n
    }
}

// The error a connection gives where the server answered its request `408 Request Timeout`, among the server's texts of the kind
// `Protocol` (W10; section 12, the owner, 2026-11-03, "The server's error texts mirror the client's").
HttpError HttpTimedOut() => HttpError(HttpKind.Protocol, "request timed out")

// Sets the time of the stream's next read to what is left until `deadline`, the head's time alone, with no 5 seconds of a read on a
// socket inside the server (section 12, Q10 (b)), and gives `TimedOut` where nothing is left, with no call of the system (W10).
void | IoError HttpWaitUntil(TcpStream s, instant deadline) {
    spare = deadline - instant.Now
    if spare <= 0s {
        return IoError(IoKind.TimedOut, 0, "")
    }

    s.SetReadTimeout(spare)
}

// `bytes` written to `s`, where a rate is given within the longer of the grace of `pace` and the time `bytes.Count` bytes take at its
// rate, as Kestrel holds a response to `MinResponseDataRate` for each write, and with no time of its own where none is given (W10).
// The bound holds across the calls of the system the write makes: the runtime sets what remains of it before each, through a member
// of the stream that the checker admits in `std/` alone (section 12, the default of the follow-up's product pass, Q10).
void | IoError HttpWrite(TcpStream s, HttpRate? pace, Bytes bytes) {
    if pace == null {
        s.Write(bytes)
        return
    }

    mut bound = HttpNanosAt(bytes.Count, pace.BytesPerSecond)
    grace = HttpNanosOf(pace.Grace)
    if bound < grace {
        bound = grace
    }

    s.WriteWithin(bytes, HttpNanos(bound))
}

// The nanoseconds `count` bytes take at `perSecond` bytes a second, without passing the range of a `long` on the way.
long HttpNanosAt(long count, int perSecond) => count / perSecond * 1_000_000_000 + count % perSecond * 1_000_000_000 / perSecond

// A `duration` of `nanoseconds`, a bound the server takes in proportion to a count of bytes, which no operator gives.
duration HttpNanos(long nanoseconds) {
    long bits = nanoseconds
    mut duration d = 0s
    raw {
        d = *Ptr<duration>(&bits)
    }

    return d
}

// The nanoseconds of `d`.
long HttpNanosOf(duration d) {
    duration copy = d
    mut long n = 0
    raw {
        n = *Ptr<long>(&copy)
    }

    return n
}

// Whether headers say `Connection: close`, among the options of every `Connection` line, without regard to ASCII case (RFC 9110,
// section 7.6.1).
bool HttpCloses(HttpHeaders headers) => HttpConnectionSays(headers, "close")

// Whether headers name `option`, in lower case, among the options of every `Connection` line, without regard to ASCII case.
bool HttpConnectionSays(HttpHeaders headers, string option) {
    for value in headers.GetAll("Connection") {
        for one in value.Split(",") {
            if one.Trim().ToLowerAscii() == option {
                return true
            }
        }
    }

    return false
}

// The whole seconds of `at` since 1970-01-01, rounded down, so that the loop writes its `Date` once a second, as hyper caches it.
long HttpSecondOf(timestamp at) {
    timestamp copy = at
    mut long nanoseconds = 0
    raw {
        nanoseconds = *Ptr<long>(&copy)
    }

    mut second = nanoseconds / 1_000_000_000
    if nanoseconds < 0 && second * 1_000_000_000 != nanoseconds {
        second = second - 1
    }

    return second
}

// The second `second` since 1970-01-01 as HTTP's `Date` writes it, RFC 9110's IMF-fixdate, `Sun, 06 Nov 1994 08:49:37 GMT`
// (section 5.6.7), the civil date of its day by the algorithm `civil_from_days`, which chrono's dates follow too.
string HttpDateOf(long second) {
    mut days = second / 86400
    if second < 0 && days * 86400 != second {
        days = days - 1
    }

    inDay = second - days * 86400
    z = days + 719468
    mut era = z / 146097
    if z < 0 && era * 146097 != z {
        era = era - 1
    }

    doe = z - era * 146097
    yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp = (5 * doy + 2) / 153
    day = doy - (153 * mp + 2) / 5 + 1
    mut month = mp + 3
    if mp >= 10 {
        month = mp - 9
    }

    mut year = yoe + era * 400
    if month <= 2 {
        year = year + 1
    }

    weekdays = ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]
    months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    weekday = weekdays[int((days % 7 + 7) % 7)]
    hour = inDay / 3600
    minute = inDay / 60 % 60
    sec = inDay % 60
    return "{weekday}, {HttpTwo(day)} {months[int(month) - 1]} {year} {HttpTwo(hour)}:{HttpTwo(minute)}:{HttpTwo(sec)} GMT"
}

// `n`, from 0 to 99, in two digits.
string HttpTwo(long n) {
    if n < 10 {
        return "0{n}"
    }

    return "{n}"
}

// What std/'s reader refuses: the status the server answers, 0 where it answers none, beside the error a program sees (W5).
data HttpRefused(int Status, HttpError Error)

// The next line of the stream without its CR LF, of at most `most` bytes with them, `tooLong` past them, taken through the stream's
// buffer (S24), what remains until `deadline` set before each refill where one is given (section 12, the owner, 2026-11-04, Q9 (a)),
// its other failures in the words of the `side`, `request` or `response`, whose body it reads, each read under what remains of a
// client's `call` where one is given (W16).
Bytes | IoError | HttpError HttpLine(TcpStream s, int most, HttpError tooLong, instant? deadline, string side, HttpCall? call) {
    mut line = Bytes()
    while true {
        if deadline != null {
            HttpWaitUntil(s, deadline)
        }

        start = line.Count
        HttpCallReads(s, call)
        n = s.Fill(mut line) else {
            IoError e => return HttpCallFailed(e, call)
        }

        if n == 0 {
            return HttpError(HttpKind.Protocol, "malformed {side}: unexpected end of body")
        }

        for i in start..<line.Count {
            if line[i] == 10 {
                s.Consume(i + 1 - start)
                if i + 1 > most {
                    return tooLong
                }

                if i == 0 || line[i - 1] != 13 {
                    return HttpError(HttpKind.Protocol, "malformed {side}: bad chunk")
                }

                return line[0..<i - 1]
            }
        }

        s.Consume(n)
        if line.Count >= most {
            return tooLong
        }
    }

    return line
}

HttpRefused HttpBad(string what) => HttpRefused(400, HttpError(HttpKind.Protocol, "malformed request: {what}"))

// The request of a stream with these limits, the entry of the server's loop (W5): the head is taken through the stream's buffer
// (S24) line by line, each line ended by CR LF, and held to its limits as Kestrel holds it, a request line of at most
// `MaxRequestLineSize` bytes with its CR LF and header lines of at most `MaxRequestHeadersTotalSize` bytes with theirs and the empty
// line's, at most `MaxRequestHeaderCount` of them; what follows the head stays in the stream's buffer for the body.
HttpRequest | IoError | HttpRefused HttpReadRequest(TcpStream s, HttpLimits limits) => HttpReadRequest(s, limits, null)

// The same, and where a `deadline` is given, as the server's loop reads: the head by the deadline, which the loop sets
// `RequestHeadersTimeout` after the request's first byte, each read of it after the first, which takes the bytes the loop's wait
// for that byte left in the buffer, waiting what is left, and the body held to its rate (W10). Without one it reads the clock nowhere, so that a call on the socket is the first thing a build for Windows
// says `not supported` to.
HttpRequest | IoError | HttpRefused HttpReadRequest(TcpStream s, HttpLimits limits, instant? deadline) {
    mut head = Bytes()
    mut lineStart = 0
    mut firstEnd = -1
    mut count = 0
    while true {
        start = head.Count
        n = s.Fill(mut head)
        if n == 0 {
            if start == 0 {
                return HttpRefused(0, HttpError(HttpKind.Protocol, "malformed request: no request line"))
            }

            return HttpBad("incomplete")
        }

        mut i = start
        while i < head.Count {
            if head[i] == 10 {
                if i == 0 || head[i - 1] != 13 {
                    s.Consume(i + 1 - start)
                    return HttpBad("line not ended by CR LF")
                }

                if firstEnd < 0 {
                    if i + 1 > limits.MaxRequestLineSize {
                        s.Consume(i + 1 - start)
                        return HttpRefused(414, HttpError(HttpKind.TooLarge, "request line too long"))
                    }

                    firstEnd = i - 1
                } else if i - 1 == lineStart {
                    s.Consume(i + 1 - start)
                    if i + 1 - (firstEnd + 2) > limits.MaxRequestHeadersTotalSize + 2 {
                        return HttpRefused(431, HttpError(HttpKind.TooLarge, "request header too large"))
                    }

                    match HttpParseHead(head, firstEnd, i - 1, limits) {
                        HttpHead h => {
                            // the bytes and the lines of the head's headers, without its empty line, which a trailer counts on from
                            body = HttpBody.Make(s, h.Length, h.Chunked, h.Continue, limits, deadline != null, i - firstEnd - 3, count)
                            r = HttpRequest(h.Method, h.Path, h.Query, h.Headers, body)
                            r.minor = h.Minor
                            r.next = !h.Chunked && h.Length == 0 && HttpHeadFollows(head, i + 1)
                            return r
                        }
                        HttpRefused no => return no
                    }
                } else {
                    count = count + 1
                    if count > limits.MaxRequestHeaderCount {
                        s.Consume(i + 1 - start)
                        return HttpRefused(431, HttpError(HttpKind.TooLarge, "request header too large"))
                    }
                }

                lineStart = i + 1
            }

            i = i + 1
        }

        s.Consume(n)
        if firstEnd < 0 && head.Count >= limits.MaxRequestLineSize {
            return HttpRefused(414, HttpError(HttpKind.TooLarge, "request line too long"))
        }

        if firstEnd >= 0 && head.Count - (firstEnd + 2) > limits.MaxRequestHeadersTotalSize + 2 {
            return HttpRefused(431, HttpError(HttpKind.TooLarge, "request header too large"))
        }

        if deadline != null {
            HttpWaitUntil(s, deadline)
        }
    }

    return HttpBad("incomplete")
}

// Whether the bytes from `from` on hold the end of a head, a CR LF CR LF.
bool HttpHeadFollows(Bytes b, int from) {
    mut i = from
    while i + 3 < b.Count {
        if b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10 {
            return true
        }

        i = i + 1
    }

    return false
}

// What a head says of its request, for its body and the server's loop.
data HttpHead(string Method, string Path, string Query, HttpHeaders Headers, int Minor, long Length, bool Chunked, bool Continue)

// A byte of a token, the characters of a method and a header's name (RFC 9110, section 5.6.2), as httparse's `TOKEN_MAP` holds
// them: the bits of the bytes 0 to 63 and of the bytes 64 to 127, and no byte above.
bool HttpTokenByte(byte c) {
    if c < 64 {
        return (0x03FF6CFA00000000UL >> int(c) & 1UL) != 0
    }

    if c < 128 {
        return (0x57FFFFFFC7FFFFFEUL >> int(c - 64) & 1UL) != 0
    }

    return false
}

// The string of the `n` bytes at `p`, which the parse of a head proved ASCII and so UTF-8, made once from them, with no second
// check (R15's `string.Allocate` and `string.FromRaw`).
string HttpAscii(byte* p, long n) {
    if n == 0 {
        return ""
    }

    mut made = ""
    raw {
        byte* q = string.Allocate(n)
        Copy(q, p, n)
        made = string.FromRaw(q, n)
    }

    return made
}

// Whether the `n` bytes at `p`, a header's name and so a token, are the name `lower`, of as many bytes and spelled in lowercase, in
// any case of ASCII, as `HttpHeaders` compares names: a byte of a token with its bit 0x20 set is a letter's lowercase only where it
// was that letter in either case, and is `-` only where it was `-`.
bool HttpNamed(byte* p, long n, string lower) {
    raw {
        byte* q = lower.Pointer
        for i in 0..<n {
            if (p[i] | 32) != q[i] {
                return false
            }
        }
    }

    return true
}

// Whether a `Host` is a host and an optional port, a name of the bytes RFC 3986 allows in one or an address between brackets.
bool HttpHostValid(string host) {
    b = host.Bytes
    mut at = 0
    if b.Count > 0 && b[0] == 91 {
        at = 1
        while at < b.Count && b[at] != 93 {
            c = b[at]
            if !(c >= 48 && c <= 58 || c >= 97 && c <= 102 || c >= 65 && c <= 70 || c == 46) {
                return false
            }

            at = at + 1
        }

        if at == b.Count {
            return false
        }

        at = at + 1
    } else {
        while at < b.Count && b[at] != 58 {
            c = b[at]
            if !(c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 45 || c == 46 || c == 95 || c == 126 || c == 37 || c == 33 || c == 36 || c >= 38 && c <= 44 || c == 59 || c == 61) {
                return false
            }

            at = at + 1
        }
    }

    if at == b.Count {
        return true
    }

    if b[at] != 58 {
        return false
    }

    for p in at + 1..<b.Count {
        if b[p] < 48 || b[p] > 57 {
            return false
        }
    }

    return true
}

// The header lines of a head, from `from` to the CR at `end`, each a name, a colon and a value, or the words of what is wrong
// with the first that is not, which the server puts after `malformed request: ` and the client after `malformed response: `
// (W5, W12).
// A header line ends only at CR LF: a CR alone stays in its line and is refused there, as a control byte in a value, as httparse
// refuses it (RFC 9112, section 2.2), so that no byte after it is read as the start of another header.
HttpHeaders | string HttpParseHeaderLines(Bytes head, int from, int end) {
    lines = HttpReadHeaderLines(head, from, end) else {
        string what => return what
    }

    return lines.Headers
}

// The headers of a head's lines, and of the four names the server judges after them, `Host`, `Content-Length`,
// `Transfer-Encoding` and `Expect` in any case of ASCII, the place of the first among the headers, -1 where the lines have none,
// and how many the lines have (W5).
data HttpLines(HttpHeaders Headers, int Host, int Hosts, int Length, int Lengths, int Coding, int Codings, int Expect)

// The header lines of a head, as `HttpParseHeaderLines` gives them, each line read once with the mechanism of httparse 1.10.1's
// `parse_headers_iter`, a table of tokens for the name and eight bytes at a time for the value; the faults, their words and their
// order, and where a line ends are this parser's own, as they were before. Each fault is named where the line first shows it: a
// line that starts with a space or a tab is folded; the name's bytes are tokens up to the colon, a space or a tab before it its
// own fault, a CR LF before it a line
// with none, and a CR alone no token; the spaces and tabs after the colon are skipped; and the value's bytes up to the CR LF are
// read eight at a time while eight are left before `end`, as httparse's `match_header_value_char_8_swar` (`src/simd/swar.rs`)
// tests them, a byte below 0x20 or 0x7F ending the words, a tab among them taken and the words going on, a CR before a LF the
// value's end, and any other, a CR alone among them, a control byte; the spaces and tabs before the CR LF are dropped. Each name,
// and each value of ASCII alone, is made a string once from its bytes; a value with a byte from 0x80 up is checked as
// `string.FromUtf8` checks it. A line ends at its first CR LF, as RFC 9112, section 2.2, ends one, and the next starts after it.
HttpLines | string HttpReadHeaderLines(Bytes head, int from, int end) {
    headers = HttpHeaders()
    mut count = 0
    mut host = -1
    mut hosts = 0
    mut length = -1
    mut lengths = 0
    mut coding = -1
    mut codings = 0
    mut expect = -1
    mut at = from
    raw {
        byte* p = head.Pointer
        while at < end {
            lineStart = at
            if p[at] == 32 || p[at] == 9 {
                return "folded header"
            }

            while p[at] != 58 {
                c = p[at]
                if !HttpTokenByte(c) {
                    if c == 13 && p[at + 1] == 10 {
                        return "header without a colon"
                    }

                    if c == 32 || c == 9 {
                        return "space before a header's colon"
                    }

                    return "bad header name"
                }

                at = at + 1
            }

            if at == lineStart {
                return "bad header name"
            }

            nameEnd = at
            at = at + 1
            while p[at] == 32 || p[at] == 9 {
                at = at + 1
            }

            valueStart = at
            mut ulong high = 0
            while true {
                while at + 8 <= end {
                    ulong x = WordAt(p + at)
                    ulong low = (x -% 0x2020202020202020UL) & ~x & 0x8080808080808080UL
                    ulong d = x ^ 0x7F7F7F7F7F7F7F7FUL
                    ulong stop = low | (d -% 0x0101010101010101UL) & ~d & 0x8080808080808080UL
                    if stop != 0 {
                        long k = FirstFlag(stop)
                        high = high | x & (1UL << int(8 * k)) -% 1UL
                        at = at + int(k)
                        break
                    }

                    high = high | x
                    at = at + 8
                }

                c = p[at]
                if c == 13 && p[at + 1] == 10 {
                    break
                }

                if c < 32 && c != 9 || c == 127 {
                    return "control byte in a header"
                }

                high = high | ulong(c)
                at = at + 1
            }

            mut valueEnd = at
            while valueEnd > valueStart && (p[valueEnd - 1] == 32 || p[valueEnd - 1] == 9) {
                valueEnd = valueEnd - 1
            }

            long n = long(nameEnd - lineStart)
            name = HttpAscii(p + lineStart, n)
            mut value = ""
            if (high & 0x8080808080808080UL) == 0 {
                value = HttpAscii(p + valueStart, long(valueEnd - valueStart))
            } else {
                value = string.FromUtf8(head[valueStart..<valueEnd]) else {
                    InvalidUtf8 => return "header not UTF-8"
                }
            }

            if n == 4 && HttpNamed(p + lineStart, n, "host") {
                if hosts == 0 {
                    host = count
                }

                hosts = hosts + 1
            } else if n == 14 && HttpNamed(p + lineStart, n, "content-length") {
                if lengths == 0 {
                    length = count
                }

                lengths = lengths + 1
            } else if n == 17 && HttpNamed(p + lineStart, n, "transfer-encoding") {
                if codings == 0 {
                    coding = count
                }

                codings = codings + 1
            } else if n == 6 && expect < 0 && HttpNamed(p + lineStart, n, "expect") {
                expect = count
            }

            headers.Append(name, value)
            count = count + 1
            at = at + 2
        }
    }

    return HttpLines(headers, host, hosts, length, lengths, coding, codings, expect)
}

// The head of a request, its request line ending at the CR at `lineEnd` and its header lines at the CR at `end` (W5).
HttpHead | HttpRefused HttpParseHead(Bytes head, int lineEnd, int end, HttpLimits limits) {
    if head[0] == 32 {
        return HttpBad("empty method")
    }

    mut at = 0
    while at < lineEnd && head[at] != 32 {
        if !HttpTokenByte(head[at]) {
            return HttpBad("bad request line")
        }

        at = at + 1
    }

    if at == lineEnd {
        return HttpBad("bad request line")
    }

    // the method's bytes are tokens, and so ASCII; a target of ASCII alone is made into its path and its query from its bytes,
    // split at its first `?`, and any other is checked as `string.FromUtf8` checks it, where it was before
    mut byte* p = null
    raw {
        p = head.Pointer
    }

    mut method = ""
    raw {
        method = HttpAscii(p, long(at))
    }

    targetStart = at + 1
    at = targetStart
    mut ascii = true
    mut question = -1
    while at < lineEnd && head[at] != 32 {
        if head[at] < 33 || head[at] == 127 {
            return HttpBad("bad request line")
        }

        if head[at] >= 128 {
            ascii = false
        } else if head[at] == 63 && question < 0 {
            question = at
        }

        at = at + 1
    }

    if at == targetStart || at == lineEnd {
        return HttpBad("bad request line")
    }

    targetEnd = at
    mut target = ""
    if !ascii {
        target = string.FromUtf8(head[targetStart..<targetEnd]) else {
            InvalidUtf8 => return HttpBad("target not UTF-8")
        }
    }

    v = targetEnd + 1
    if lineEnd - v != 8 || head[v] != 72 || head[v + 1] != 84 || head[v + 2] != 84 || head[v + 3] != 80 || head[v + 4] != 47 || head[v + 6] != 46 || head[v + 5] < 48 || head[v + 5] > 57 || head[v + 7] < 48 || head[v + 7] > 57 {
        return HttpBad("bad request line")
    }

    if head[v + 5] != 49 || head[v + 7] > 49 {
        return HttpRefused(505, HttpError(HttpKind.Unsupported, "unsupported HTTP version"))
    }

    minor = head[v + 7] - 48
    if method == "CONNECT" {
        return HttpRefused(501, HttpError(HttpKind.Unsupported, "unsupported method"))
    }

    // a target in absolute form gives its path, and its authority stands as the `Host` (section 12, the owner, 2026-11-05, Q2)
    // only a target that starts with a letter can be in absolute form, and no other is copied out to be asked
    mut form = target
    mut authority = ""
    mut begins = -1
    if head[targetStart] >= 65 && head[targetStart] <= 90 || head[targetStart] >= 97 && head[targetStart] <= 122 {
        begins = HttpAuthorityStart(head[targetStart..<at])
    }

    absolute = begins >= 0
    if absolute {
        mut stop = targetStart + begins
        while stop < at && head[stop] != 47 && head[stop] != 63 {
            stop = stop + 1
        }

        authority = string.FromUtf8(head[targetStart + begins..<stop]) else {
            InvalidUtf8 => ""
        }

        rest = string.FromUtf8(head[stop..<at]) else {
            InvalidUtf8 => ""
        }

        form = rest
        if stop == at || head[stop] == 63 {
            form = "/{rest}"
        }
    }

    mut path = form
    mut query = ""
    if ascii && !absolute {
        raw {
            if question < 0 {
                path = HttpAscii(p + targetStart, long(targetEnd - targetStart))
            } else {
                path = HttpAscii(p + targetStart, long(question - targetStart))
                query = HttpAscii(p + question + 1, long(targetEnd - question - 1))
            }
        }
    } else {
        split = form.IndexOf("?")
        if split != null {
            path = form.Substring(0, split)
            query = form.Substring(split + 1, form.Bytes.Count - split - 1)
        }
    }

    lines = HttpReadHeaderLines(head, lineEnd + 2, end) else {
        string what => return HttpBad(what)
    }

    // the four names the server judges, noted while the lines were read, are judged once every line has been read
    headers = lines.Headers
    if lines.Hosts > 1 {
        return HttpBad("two Host headers")
    }

    if lines.Hosts == 0 && minor == 1 {
        return HttpBad("no Host")
    }

    if lines.Hosts == 1 && !HttpHostValid(headers.ValueAt(lines.Host)) {
        return HttpBad("bad Host")
    }

    if absolute {
        if authority == "" || !HttpHostValid(authority) {
            return HttpBad("bad Host")
        }

        // the one `Host` line takes the authority in its place, or a new one goes after every line, so the places noted stay right
        headers.Set("Host", authority) else {
            HttpError e => return HttpBad("bad Host")
        }
    }

    mut lengths = List<string>()
    if lines.Lengths == 1 {
        lengths.Add(headers.ValueAt(lines.Length))
    } else if lines.Lengths > 1 {
        lengths = headers.GetAll("Content-Length")
    }

    mut length = -1L
    mut over = false
    for text in lengths {
        mut n = 0L
        if text.Bytes.Count == 0 {
            return HttpBad("bad Content-Length")
        }

        for c in text.Bytes {
            if c < 48 || c > 57 {
                return HttpBad("bad Content-Length")
            }

            if limits.MaxRequestBodySize - (c - 48) < 0 || n > (limits.MaxRequestBodySize - (c - 48)) / 10 {
                over = true
            } else {
                n = n * 10 + (c - 48)
            }
        }

        if length >= 0 && n != length {
            return HttpBad("bad Content-Length")
        }

        length = n
    }

    if lines.Codings > 0 && lines.Lengths > 0 {
        return HttpBad("Content-Length beside Transfer-Encoding")
    }

    // the lines of `Transfer-Encoding` one list in their order: in HTTP/1.0 none, a last coding other than `chunked` malformed, and
    // another coding before a last `chunked` not served (section 12, the owner, 2026-11-05, Q1 and Q7)
    mut last = ""
    mut named = 0
    if lines.Codings > 0 {
        for line in headers.GetAll("Transfer-Encoding") {
            for part in line.Split(",") {
                coding = part.TrimAscii()
                if coding != "" {
                    last = coding.ToLowerAscii()
                    named = named + 1
                }
            }
        }
    }

    if lines.Codings > 0 && minor == 0 {
        return HttpBad("transfer encoding in HTTP/1.0")
    }

    if lines.Codings > 0 && last != "chunked" {
        return HttpBad("transfer encoding not ending in chunked")
    }

    if named > 1 {
        return HttpRefused(501, HttpError(HttpKind.Unsupported, "unsupported transfer encoding"))
    }

    if over {
        return HttpRefused(413, HttpError(HttpKind.TooLarge, "request body over limit"))
    }

    mut expects = false
    if lines.Expect >= 0 {
        if headers.ValueAt(lines.Expect).ToLowerAscii() != "100-continue" {
            return HttpRefused(417, HttpError(HttpKind.Unsupported, "unsupported expectation"))
        }

        expects = minor == 1
    }

    mut sized = length
    if sized < 0 {
        sized = 0
    }

    return HttpHead(method, path, query, headers, minor, sized, lines.Codings > 0, expects)
}

// Where the authority of a target in absolute form starts, after its scheme and `://`, or -1 for a target in another form (RFC 9112,
// section 3.2.2): a scheme is a letter and then letters, digits, `+`, `-` and `.` (RFC 3986, section 3.1) (section 12, assumed).
int HttpAuthorityStart(Bytes t) {
    if t.Count == 0 || !(t[0] >= 97 && t[0] <= 122 || t[0] >= 65 && t[0] <= 90) {
        return -1
    }

    mut i = 1
    while i < t.Count && (t[i] >= 97 && t[i] <= 122 || t[i] >= 65 && t[i] <= 90 || t[i] >= 48 && t[i] <= 57 || t[i] == 43 || t[i] == 45 || t[i] == 46) {
        i = i + 1
    }

    if i + 2 < t.Count && t[i] == 58 && t[i + 1] == 47 && t[i + 2] == 47 {
        return i + 3
    }

    return -1
}

// Whether a byte stands in a `Uri`: a letter, a digit, one of `-._~`, of the delimiters `:/?#[]@!$&'()*+,;=`, or `%` (RFC 3986,
// section 2).
bool UriByte(byte c) {
    return c >= 33 && c <= 126 && c != 34 && c != 60 && c != 62 && c != 92 && c != 94 && c != 96 && c != 123 && c != 124 && c != 125
}

// Whether a byte is a hex digit, as one of the two after a `%`.
bool UriHex(byte c) => c >= 48 && c <= 57 || c >= 97 && c <= 102 || c >= 65 && c <= 70

// Whether a byte is an ASCII letter, the first byte of a scheme.
bool UriLetter(byte c) => c >= 97 && c <= 122 || c >= 65 && c <= 90

// Whether `text` starts with a scheme and its `:`, a letter and then letters, digits, `+`, `-` and `.`.
bool UriHasScheme(string text) {
    b = text.Bytes
    if b.Count == 0 || !UriLetter(b[0]) {
        return false
    }

    for i in 1..<b.Count {
        c = b[i]
        if c == 58 {
            return true
        }

        if !UriLetter(c) && !(c >= 48 && c <= 57) && c != 43 && c != 45 && c != 46 {
            return false
        }
    }

    return false
}

// The path up to its last `/`, with it, where a relative reference is merged (RFC 3986, section 5.2.3).
string UriDirectory(string path) {
    b = path.Bytes
    mut last = 0
    for i in 0..<b.Count {
        if b[i] == 47 {
            last = i
        }
    }

    return path.Substring(0, last + 1)
}

// The path without its dot segments, `.` and `..`, as RFC 3986, section 5.2.4, removes them: `/a/b/../c/./d` is `/a/c/d`, and a
// path that ends in one ends in `/`.
string UriDotless(string path) {
    pieces = path.Split("/")
    mut segments = List<string>()
    for i in 1..<pieces.Count {
        piece = pieces[i]
        if piece == "." || piece == ".." {
            if piece == ".." && segments.Count > 0 {
                segments.RemoveAt(segments.Count - 1)
            }

            if i == pieces.Count - 1 {
                segments.Add("")
            }
        } else {
            segments.Add(piece)
        }
    }

    joined = string.Join("/", segments)
    return "/{joined}"
}

// The head of a `GET` of `uri`: its path and query as written, and `Host` with the port where it is not 80, `http`'s own, and no
// other header (section 12, the client's product pass).
string HttpGetHead(Uri uri) {
    mut host = uri.Host
    if uri.Port != 80 {
        host = "{uri.Host}:{uri.Port}"
    }

    mut target = uri.Path
    if uri.Query != "" {
        target = "{uri.Path}?{uri.Query}"
    }

    return "GET {target} HTTP/1.1\r\nHost: {host}\r\n\r\n"
}

// The address a redirect leads to, its `Location` resolved against the address `from` it answers, or null where the response is
// no `301`, `302`, `303`, `307` or `308`, has no `Location`, or one that resolves to no `Uri`, so that the client gives that response,
// as .NET gives it (W15).
Uri? HttpRedirect(Uri from, HttpResponseMessage response) {
    code = response.Status
    if code != 301 && code != 302 && code != 303 && code != 307 && code != 308 {
        return null
    }

    location = response.Headers.Get("Location")
    if location == null {
        return null
    }

    return Uri.Resolve(from, location)
}

// Closes a stream whose connection the client lets go of, an error of that close dropped, as the close at the last count drops it
// (S5).
void HttpShut(TcpStream s) {
    s.Close() else {
        IoError e => {
        }
    }
}

// What the head of a response says, for its body and the client's pool (W14): its status and headers, the length of its body, or
// that it is chunked, or read to the close, and whether its connection may carry another request.
data HttpResponseHead(int Status, HttpHeaders Headers, long Length, bool Chunked, bool ToEnd, bool Keep)

// The end of a connection before the first byte of a response's head, with the network's error where it gave one (W13).
data HttpSilent(IoError? Error)

// A response's head past the limits of a request's head, the status line or the headers (section 12).
HttpError HttpHeadTooLarge() => HttpError(HttpKind.TooLarge, "response header too large")

// The head of the next response of `s` that is no `1xx`, the `1xx` before it read past, as hyper reads past it (W14): taken through
// the stream's buffer line by line, each line ended by CR LF, and held to the limits of a request's head, the status line to
// `MaxRequestLineSize` bytes with its CR LF, the header lines to `MaxRequestHeadersTotalSize` bytes with theirs and the empty line's,
// at most `MaxRequestHeaderCount` of them; what follows the head stays in the stream's buffer for the body. Each read waits what
// remains of the `call`, and its time running out is the call's `TimedOut` (W16).
HttpResponseHead | IoError | HttpError | HttpSilent HttpReadResponse(TcpStream s, HttpLimits limits, HttpCall call) {
    mut any = false
    while true {
        mut head = Bytes()
        mut lineStart = 0
        mut lineEnd = -1
        mut end = -1
        mut count = 0
        while end < 0 {
            start = head.Count
            HttpCallReads(s, call)
            n = s.Fill(mut head) else {
                IoError e => {
                    if e.Kind == IoKind.TimedOut {
                        return HttpCallTimedOut()
                    }

                    if start == 0 && !any {
                        return HttpSilent(e)
                    }

                    return e
                }
            }

            if n == 0 {
                if start == 0 && !any {
                    return HttpSilent(null)
                }

                return HttpError(HttpKind.Protocol, "malformed response: incomplete")
            }

            mut i = start
            while end < 0 && i < head.Count {
                if head[i] == 10 {
                    if i == 0 || head[i - 1] != 13 {
                        s.Consume(i + 1 - start)
                        return HttpError(HttpKind.Protocol, "malformed response: line not ended by CR LF")
                    }

                    if lineEnd < 0 {
                        if i + 1 > limits.MaxRequestLineSize {
                            s.Consume(i + 1 - start)
                            return HttpHeadTooLarge()
                        }

                        lineEnd = i - 1
                    } else if i - 1 == lineStart {
                        s.Consume(i + 1 - start)
                        if i + 1 - (lineEnd + 2) > limits.MaxRequestHeadersTotalSize + 2 {
                            return HttpHeadTooLarge()
                        }

                        end = i - 1
                    } else {
                        count = count + 1
                        if count > limits.MaxRequestHeaderCount {
                            s.Consume(i + 1 - start)
                            return HttpHeadTooLarge()
                        }
                    }

                    lineStart = i + 1
                }

                i = i + 1
            }

            if end < 0 {
                s.Consume(n)
                if lineEnd < 0 && head.Count >= limits.MaxRequestLineSize {
                    return HttpHeadTooLarge()
                }

                if lineEnd >= 0 && head.Count - (lineEnd + 2) > limits.MaxRequestHeadersTotalSize + 2 {
                    return HttpHeadTooLarge()
                }
            }
        }

        any = true
        match HttpParseResponseHead(head, lineEnd, end) {
            HttpResponseHead h => {
                if h.Status == 101 {
                    return HttpError(HttpKind.Protocol, "malformed response: unexpected 101")
                }

                if h.Status >= 200 {
                    return h
                }
            }
            HttpError e => return e
        }
    }

    return HttpError(HttpKind.Protocol, "malformed response: incomplete")
}

// The head of a response, its status line ending at the CR at `lineEnd` and its header lines at the CR at `end`: `HTTP/1.0` or
// `HTTP/1.1`, a status of three digits from 100, and a reason that may be empty or left out, as httparse reads it; the body framed
// as RFC 9112, section 6.3, frames a response's, none for `1xx`, `204` and `304`, chunks where `Transfer-Encoding` is `chunked`, the
// length of `Content-Length`, and otherwise the bytes up to the close; and the connection kept where the response is of HTTP/1.1 or
// says `Connection: keep-alive`, does not say `Connection: close`, and is not read to the close (W14).
HttpResponseHead | HttpError HttpParseResponseHead(Bytes head, int lineEnd, int end) {
    if lineEnd < 12 || head[0] != 72 || head[1] != 84 || head[2] != 84 || head[3] != 80 || head[4] != 47 || head[6] != 46 || head[5] < 48 || head[5] > 57 || head[7] < 48 || head[7] > 57 || head[8] != 32 {
        return HttpError(HttpKind.Protocol, "malformed response: bad status line")
    }

    if head[5] != 49 || head[7] > 49 {
        return HttpError(HttpKind.Unsupported, "unsupported HTTP version")
    }

    minor = head[7] - 48
    mut status = 0
    for i in 9..<12 {
        if head[i] < 48 || head[i] > 57 {
            return HttpError(HttpKind.Protocol, "malformed response: bad status line")
        }

        status = status * 10 + (head[i] - 48)
    }

    if status < 100 || lineEnd > 12 && head[12] != 32 {
        return HttpError(HttpKind.Protocol, "malformed response: bad status line")
    }

    for i in 12..<lineEnd {
        if head[i] < 32 && head[i] != 9 || head[i] == 127 {
            return HttpError(HttpKind.Protocol, "malformed response: bad status line")
        }
    }

    headers = HttpParseHeaderLines(head, lineEnd + 2, end) else {
        string what => return HttpError(HttpKind.Protocol, "malformed response: {what}")
    }

    keep = !HttpCloses(headers) && (minor == 1 || HttpConnectionSays(headers, "keep-alive"))
    if status < 200 || status == 204 || status == 304 {
        return HttpResponseHead(status, headers, 0, false, false, keep)
    }

    codings = headers.GetAll("Transfer-Encoding")
    lengths = headers.GetAll("Content-Length")
    if codings.Count > 0 && lengths.Count > 0 {
        return HttpError(HttpKind.Protocol, "malformed response: Content-Length beside Transfer-Encoding")
    }

    if codings.Count > 1 || codings.Count == 1 && codings[0].ToLowerAscii() != "chunked" {
        return HttpError(HttpKind.Unsupported, "unsupported transfer encoding")
    }

    if codings.Count == 1 {
        return HttpResponseHead(status, headers, 0, true, false, keep)
    }

    if lengths.Count == 0 {
        return HttpResponseHead(status, headers, 0, false, true, false)
    }

    mut length = -1L
    for text in lengths {
        mut n = 0L
        if text.Bytes.Count == 0 {
            return HttpError(HttpKind.Protocol, "malformed response: bad Content-Length")
        }

        for c in text.Bytes {
            if c < 48 || c > 57 || n > (9223372036854775807L - (c - 48)) / 10 {
                return HttpError(HttpKind.Protocol, "malformed response: bad Content-Length")
            }

            n = n * 10 + (c - 48)
        }

        if length >= 0 && n != length {
            return HttpError(HttpKind.Protocol, "malformed response: bad Content-Length")
        }

        length = n
    }

    return HttpResponseHead(status, headers, length, false, false, keep)
}

// The time of one call of a client (W16): when it began, read from the monotonic clock, and its bound, the options' `Timeout`.
data HttpCall(instant Start, duration Limit)

// The failure of a call whose time ran out, `TimedOut` with the number 0, as the bound of `Connect` and the server's own timeout
// give it (S9, W10).
IoError HttpCallTimedOut() => IoError(IoKind.TimedOut, 0, "")

// What remains of the call's time, or the call's `TimedOut` where nothing does: what has passed is held against the bound, and
// never the start and the bound added, which can pass the clock's range (T36).
duration | IoError HttpCallLeft(HttpCall call) {
    passed = instant.Now - call.Start
    if passed >= call.Limit {
        return HttpCallTimedOut()
    }

    return call.Limit - passed
}

// The stream's next read set to wait what remains of the `call`, where one is given, or the call's `TimedOut`, with no call of the
// system, where nothing remains (W16).
void | IoError HttpCallReads(TcpStream s, HttpCall? call) {
    if call == null {
        return
    }

    remains = HttpCallLeft(call)
    s.SetReadTimeout(remains)
}

// The stream's next write set the same way (W16).
void | IoError HttpCallWrites(TcpStream s, HttpCall call) {
    remains = HttpCallLeft(call)
    s.SetWriteTimeout(remains)
}

// A failure of a read or a connect under a `call`: the call's own `TimedOut` where the time the client set ran out (W16).
IoError HttpCallFailed(IoError e, HttpCall? call) {
    if call != null && e.Kind == IoKind.TimedOut {
        return HttpCallTimedOut()
    }

    return e
}

// ---- regular expressions (G1 to G4) ---------------------------------------------------------------------------------------

// The kinds of a pattern's error (G3): one that does not parse, a construct the linear engine does not take, and an automaton
// above the bound (G2).
pub enum RegexKind { Syntax, Unsupported, TooBig }

// A pattern's error: its kind, and the position in the pattern, counted in bytes, where the construct starts, as Rust's error gives
// its span, 0 for `TooBig`; it holds nothing of the pattern or of a text (G3). Its text is the words of its kind in lower case and
// the position, `syntax at 1`, as a `HexError`'s (H7).
pub data RegexError(RegexKind Kind, int At) {
    pub string Text() {
        if Kind == RegexKind.Syntax {
            return "syntax at {At}"
        }

        if Kind == RegexKind.Unsupported {
            return "unsupported at {At}"
        }

        return "too big at {At}"
    }
}

// A match of a `Regex` in a text, or a group of one, a `Match` too, as Rust's `Captures::get` gives one (G1, G4): its text, its
// position and its length, counted in bytes (X2). A group's `Match` holds no group but itself, its `Group(0)`.
pub class Match {
    string text
    List<int> slots
    List<string> names

    // The text the match covers, copied out of the text when the match is made: a field, which a chain of `?.` reads (N5).
    pub string Value

    // Its position in the text, in bytes from 0 (X2).
    pub int Index

    // Its length in bytes.
    pub int Length

    Match(string t, int s, int e, List<int> found, List<string> named) {
        text = t
        slots = found
        names = named
        Value = t.Substring(s, e - s)
        Index = s
        Length = e - s
    }

    // A match of `t` from `s` to `e`, its groups' positions in `found` and their names in `named`, which a `Regex` makes.
    internal static Match Of(string t, int s, int e, List<int> found, List<string> named) => Match(t, s, e, found, named)

    // The group `n`, the whole match for 0, and null for a group that did not take part and for one the pattern does not have (G4).
    pub Match? Group(int n) {
        if n < 0 || 2 * n + 1 >= slots.Count || slots[2 * n] < 0 {
            return null
        }

        return Match(text, slots[2 * n], slots[2 * n + 1], [slots[2 * n], slots[2 * n + 1]], [""])
    }

    // The group the pattern names `name`, as `Group(n)` gives the group of its number, and null where none has the name (G4).
    pub Match? Group(string name) {
        for i in 1..<names.Count {
            if names[i] == name {
                return Group(i)
            }
        }

        return null
    }

    // The text of a match is its `Value`, as C#'s `Match.ToString()` gives it.
    pub string Text() => Value
}

// A pattern built for one of G2's two engines. For the linear engine, as Rust's `regex` builds one: the pattern parsed into a
// tree (`RegexParser`), the tree compiled into a Thompson automaton, and a search a Pike VM that runs the automaton over the text
// once, its time in proportion to the text's length times the automaton's states times one more than the positions a thread
// carries, which it copies from thread to thread as Rust's `PikeVM` copies its slots: none for `IsMatch`, and two for the whole
// match and two for each group for the members that give a match (G2). For the backtracking engine, the same automaton, whose ways a search tries
// one after another (`Backtrack`). `Regex.New` of a literal the compiler checked gives a `Regex`, and of any other string
// `Regex | RegexError` (G3); the compiler calls `RegexNew` and `RegexChecked` with the tables of G4's classes. Its text is its
// pattern, as Rust's `Display` gives it (G1).
pub class Regex {
    string pattern
    // the automaton: each state's operation (`RegexParser.State`) and its two operands
    List<int> ops
    List<int> xs
    List<int> ys
    // the ranges the classes of the automaton read, the first and the last code point of each
    List<int> ranges
    // each group's name, "" for a group without one, the whole match's first
    List<string> names
    // where the ranges of `\w` stand among `ranges` for a word boundary, and how many there are, 0 where the pattern has none
    int wordAt
    int wordCount
    // whether the pattern runs on the backtracking engine (G2), and the simple case folding its backreferences under `(?i)`
    // compare by, empty where none does
    bool backtracking
    List<int> fold
    // the lazy DFA's classes of characters (`RegexParser.Classes`): the first code point of each piece of the code points,
    // ascending from 0, the class of each piece, the class of each ASCII character and the first code point of each class, all
    // empty for the backtracking engine; and whether the automaton has an assertion
    List<int> bounds
    List<int> classes
    List<int> ascii
    List<int> firsts
    bool looks

    Regex(string p, RegexParser parsed) {
        pattern = p
        ops = parsed.ops
        xs = parsed.xs
        ys = parsed.ys
        ranges = parsed.ranges
        names = parsed.names
        wordAt = parsed.wordAt
        wordCount = parsed.wordCount
        backtracking = parsed.backtracking
        fold = parsed.RefFold()
        looks = parsed.Looks()
        bounds = parsed.Bounds(looks)
        classes = parsed.Classes(bounds, looks)
        ascii = RegexAscii(bounds, classes)
        firsts = RegexFirsts(bounds, classes)
    }

    // The pattern built, or the error of the first construct the parse refuses, of an automaton above the bound (G2, G3).
    internal static Regex | RegexError Make(string text, byte* tables, bool backtrack) {
        parsed = RegexParser()
        parsed.Build(text, tables, backtrack)
        if parsed.failKind == 0 {
            return RegexError(RegexKind.Syntax, parsed.failAt)
        }

        if parsed.failKind == 1 {
            return RegexError(RegexKind.Unsupported, parsed.failAt)
        }

        if parsed.failKind == 2 {
            return RegexError(RegexKind.TooBig, 0)
        }

        return Regex(text, parsed)
    }

    // Whether the pattern matches anywhere in `s` (G4).
    pub bool IsMatch(string s) {
        b = s.Bytes
        mut found = List<int>()
        return Search(b, 0, mut found, 0, RegexThreads(ops.Count, 0))
    }

    // The first match in `s`, the leftmost and, among the alternatives at its start, the first that matches, or null (G2, G4).
    pub Match? Match(string s) {
        b = s.Bytes
        mut found = List<int>()
        if !Search(b, 0, mut found, 2 * names.Count, RegexThreads(ops.Count, 2 * names.Count)) {
            return null
        }

        return RegexFound(s, found[0], found[1], found, names)
    }

    // Every match in `s`, none overlapping another, as Rust's `find_iter` gives them: each search starts where the last match
    // ended, and an empty match that ends where the last one ended is passed over by one character (G4).
    pub List<Match> Matches(string s) {
        b = s.Bytes
        mut all = List<Match>()
        threads = RegexThreads(ops.Count, 2 * names.Count)
        mut at = 0
        mut last = -1
        while true {
            mut found = List<int>()
            if !Next(b, mut at, mut last, mut found, threads) {
                break
            }

            all.Add(RegexFound(s, found[0], found[1], found, names))
        }

        return all
    }

    // `s` with every match replaced by `replacement`, as Rust's `replace_all` replaces the matches `Matches` gives (G4, G5): the
    // replacement read once into its pieces (`RegexReplacement`), and the result written once, into a string of the length its
    // parts count. A text with no match is given back as it is.
    pub string Replace(string s, string replacement) {
        b = s.Bytes
        pieces = RegexReplacement(replacement, names)
        threads = RegexThreads(ops.Count, 2 * names.Count)
        // each part of the result, three numbers: the text it is cut from, 0 for `s` and 1 for the replacement, its start and its
        // length
        mut parts = List<int>()
        mut total = 0L
        mut matched = false
        mut done = 0
        mut at = 0
        mut last = -1
        while true {
            mut found = List<int>()
            if !Next(b, mut at, mut last, mut found, threads) {
                break
            }

            matched = true
            total = total + RegexPart(mut parts, 0, done, found[0] - done)
            mut p = 0
            while p < pieces.Count {
                a = pieces[p + 1] // a text's start, or a group's number
                if pieces[p] == 0 {
                    total = total + RegexPart(mut parts, 1, a, pieces[p + 2])
                } else if 2 * a + 1 < found.Count && found[2 * a] >= 0 {
                    total = total + RegexPart(mut parts, 0, found[2 * a], found[2 * a + 1] - found[2 * a])
                }

                p = p + 3
            }

            done = found[1]
        }

        if !matched {
            return s
        }

        total = total + RegexPart(mut parts, 0, done, b.Count - done)
        return RegexJoined(s, replacement, parts, total)
    }

    // The pieces of `s` between the matches `Matches` gives, with the text of each group of a match between them: a group that did
    // not take part left out, as C#'s `Regex.Split` leaves it out, and the groups in the order of their numbers, as Python's
    // `re.split` gives them (G5); a text with no match is one piece.
    pub List<string> Split(string s) {
        b = s.Bytes
        mut pieces = List<string>()
        threads = RegexThreads(ops.Count, 2 * names.Count)
        mut done = 0
        mut at = 0
        mut last = -1
        while true {
            mut found = List<int>()
            if !Next(b, mut at, mut last, mut found, threads) {
                break
            }

            pieces.Add(s.Substring(done, found[0] - done))
            for g in 1..<names.Count {
                if found[2 * g] >= 0 {
                    pieces.Add(s.Substring(found[2 * g], found[2 * g + 1] - found[2 * g]))
                }
            }

            done = found[1]
        }

        pieces.Add(s.Substring(done, b.Count - done))
        return pieces
    }

    // The next match of the walk `Matches`, `Replace` and `Split` take, as Rust's `find_iter` walks: the search starts at `at`, where
    // the last match ended, and an empty match that ends where the last one ended, at `last`, is passed over by one character. Its
    // slots are written into `found`, and `at` and `last` moved to its end; false where no match is left (G4).
    bool Next(Bytes b, mut int at, mut int last, mut List<int> found, RegexThreads t) {
        while at <= b.Count {
            if !Search(b, at, mut found, 2 * names.Count, t) {
                return false
            }

            if found[0] == found[1] && found[1] == last {
                if at >= b.Count {
                    return false
                }

                at = at + RegexLength(b[at])
                continue
            }

            last = found[1]
            at = found[1]
            return true
        }

        return false
    }

    // The text of a `Regex` is its pattern (G1).
    pub string Text() => pattern

    // The Pike VM: the threads of the automaton from `from` on, each with its groups' positions, in the order of their priority,
    // a new thread at each position until a match is found, so that the first match is the leftmost, and among the alternatives at
    // its start the first, as Rust's `PikeVM` searches. A thread that reaches the match ends every thread after it. The positions of
    // the match's `count` slots are written into `found`; with no slot, the first match ends the search.
    bool Search(Bytes b, int from, mut List<int> found, int count, RegexThreads t) {
        if backtracking {
            return Backtrack(b, from, mut found, count)
        }

        // the lazy DFA first, as Rust's meta engine runs its hybrid DFA before the `PikeVM`: where it finds no match left, there
        // is none; where it finds one, `IsMatch` has its answer and a search for the groups goes on in the Pike VM from the
        // position before which the DFA saw no match start, as Rust's runs it over the match's bounds alone (G2)
        if t.dfa == null {
            t.dfa = Lazy()
        }

        ahead = Ahead(b, from, t.dfa)
        if ahead == 0 {
            return false
        }

        if ahead > 0 && count == 0 {
            return true
        }

        n = b.Count
        t.Clear(0)
        mut matched = false
        mut at = from
        if ahead > 0 {
            at = ahead - 1
        }
        while true {
            if !matched {
                for k in 0..<count {
                    t.work[k] = -1
                }

                Add(t, 0, 0, at, b, count)
            }

            if t.size[0] == 0 {
                if matched || at >= n {
                    break
                }

                at = at + RegexLength(b[at])
                continue
            }

            mut c = -1
            mut width = 0
            if at < n {
                c = RegexDecode(b, at)
                width = RegexLength(b[at])
            }

            t.Clear(1)
            mut i = 0
            while i < t.size[0] {
                pc = t.dense0[i]
                op = ops[pc]
                if op == 0 {
                    for k in 0..<count {
                        if found.Count <= k {
                            found.Add(t.slots0[pc * count + k])
                        } else {
                            found[k] = t.slots0[pc * count + k]
                        }
                    }

                    matched = true
                    if count == 0 {
                        return true
                    }

                    break
                }

                if c >= 0 && (op == 1 && c == xs[pc] || op == 2 && RegexIn(ranges, xs[pc], ys[pc], c)) {
                    for k in 0..<count {
                        t.work[k] = t.slots0[pc * count + k]
                    }

                    Add(t, 1, pc + 1, at + width, b, count)
                }

                i = i + 1
            }

            t.Swap()
            if at >= n {
                break
            }

            at = at + width
        }

        return matched
    }

    // Adds the thread at `pc` to list `which` at position `at` with the slots of `t.work`, and every state it reaches without a
    // character, in the order of their priority, by a stack in place of recursion, as Rust's `epsilon_closure`: a state already in
    // the list is passed over, so that a loop that reads no character ends; a slot a `Save` sets is set back once its branch is done.
    void Add(RegexThreads t, int which, int pc0, int at, Bytes b, int count) {
        t.stack.Add(pc0)
        while t.stack.Count > 0 {
            top = t.stack[t.stack.Count - 1]
            t.stack.RemoveAt(t.stack.Count - 1)
            if top < 0 {
                slot = -top - 1
                t.work[slot] = t.stack[t.stack.Count - 1]
                t.stack.RemoveAt(t.stack.Count - 1)
                continue
            }

            mut pc = top
            while true {
                if t.Has(which, pc) {
                    break
                }

                t.Put(which, pc)
                op = ops[pc]
                if op == 4 {
                    pc = xs[pc]
                    continue
                }

                if op == 3 {
                    t.stack.Add(ys[pc])
                    pc = xs[pc]
                    continue
                }

                if op == 5 {
                    slot = xs[pc]
                    if slot < count {
                        t.stack.Add(t.work[slot])
                        t.stack.Add(-slot - 1)
                        t.work[slot] = at
                    }

                    pc = pc + 1
                    continue
                }

                if op == 6 {
                    if !Looks(xs[pc], b, at) {
                        break
                    }

                    pc = pc + 1
                    continue
                }

                t.Keep(which, pc, count)
                break
            }
        }
    }

    // The backtracking engine (G2): from each start on from `from`, the ways of the automaton one after another in the order of
    // their priority, as .NET's interpreter and Rust's `fancy-regex` walk them, so that the first match is the leftmost and, among
    // the alternatives at its start, the first, as the Pike VM gives it. The ways it may come back to are frames of a stack in
    // memory, not calls, and no time is bounded (G2). A group's positions are set when it closes, its start kept aside until then,
    // so that a backreference inside its own group reads the group's last text, as .NET's does; the first `count` positions are
    // written into `found`. `slots` holds the groups' positions, two for each, then each group's start kept aside, then for each
    // state the position the way last came to it at, which only a split reads.
    bool Backtrack(Bytes b, int from, mut List<int> found, int count) {
        n = b.Count
        mut slots = List<int>()
        for k in 0..<3 * names.Count + ops.Count {
            slots.Add(-1)
        }

        mut stack = List<int>()
        mut start = from
        while start <= n {
            if Run(b, 0, start, -1, mut slots, mut stack) >= 0 {
                for k in 0..<count {
                    if found.Count <= k {
                        found.Add(slots[k])
                    } else {
                        found[k] = slots[k]
                    }
                }

                return true
            }

            if start == n {
                return false
            }

            start = start + RegexLength(b[start])
        }

        return false
    }

    // The first way from state `first` at `from` to the match, or to the end of the look-around or the atomic group it starts in,
    // there at `end` where `end` is not -1: the position it ends at, with `slots` holding its groups; -1 where no way gets there,
    // with `slots` as they were. A frame of `stack` is three numbers: 0, a state and the position to try it at; or 1, a slot and
    // the position it held before the way changed it. A split the way comes back to at the position it last came to it at closes
    // a loop that read no character since, and that way fails, as the Pike VM's thread that comes back to a state at the same
    // position ends; so `(a*)*` ends, and the loop's other way is tried. The way that gets there keeps its groups, and gives the
    // positions of the splits back, so that a look-around tried again at the same position starts afresh.
    int Run(Bytes b, int first, int from, int end, mut List<int> slots, mut List<int> stack) {
        n = b.Count
        marked = 3 * names.Count
        base = stack.Count
        stack.Add(0)
        stack.Add(first)
        stack.Add(from)
        while stack.Count > base {
            top = stack.Count - 3
            tag = stack[top]
            mut pc = stack[top + 1]
            mut at = stack[top + 2]
            stack.RemoveAt(top + 2)
            stack.RemoveAt(top + 1)
            stack.RemoveAt(top)
            if tag == 1 {
                slots[pc] = at
                continue
            }

            mut going = true
            while going {
                op = ops[pc]
                if op == 0 || op == 9 || op == 11 {
                    if end < 0 || at == end {
                        while stack.Count > base {
                            last = stack.Count - 3
                            if stack[last] == 1 && stack[last + 1] >= marked {
                                slots[stack[last + 1]] = stack[last + 2]
                            }

                            stack.RemoveAt(last + 2)
                            stack.RemoveAt(last + 1)
                            stack.RemoveAt(last)
                        }

                        return at
                    }

                    going = false
                } else if op == 1 || op == 2 {
                    mut c = -1
                    if at < n {
                        c = RegexDecode(b, at)
                    }

                    if c >= 0 && (op == 1 && c == xs[pc] || op == 2 && RegexIn(ranges, xs[pc], ys[pc], c)) {
                        at = at + RegexLength(b[at])
                        pc = pc + 1
                    } else {
                        going = false
                    }
                } else if op == 3 {
                    if slots[marked + pc] == at {
                        going = false
                    } else {
                        Set(marked + pc, at, mut slots, mut stack)
                        stack.Add(0)
                        stack.Add(ys[pc])
                        stack.Add(at)
                        pc = xs[pc]
                    }
                } else if op == 4 {
                    pc = xs[pc]
                } else if op == 5 {
                    slot = xs[pc]
                    if slot % 2 == 0 {
                        Set(2 * names.Count + slot / 2, at, mut slots, mut stack)
                    } else {
                        Set(slot - 1, slots[2 * names.Count + slot / 2], mut slots, mut stack)
                        Set(slot, at, mut slots, mut stack)
                    }

                    pc = pc + 1
                } else if op == 6 {
                    if Looks(xs[pc], b, at) {
                        pc = pc + 1
                    } else {
                        going = false
                    }
                } else if op == 7 {
                    to = Same(b, xs[pc], ys[pc] == 1, at, slots)
                    if to < 0 {
                        going = false
                    } else {
                        at = to
                        pc = pc + 1
                    }
                } else if op == 8 {
                    if Around(b, pc, at, mut slots, mut stack) {
                        pc = ys[pc]
                    } else {
                        going = false
                    }
                } else {
                    saved = RegexHead(slots, marked)
                    to = Run(b, pc + 1, at, -1, mut slots, mut stack)
                    if to < 0 {
                        going = false
                    } else {
                        Keep(saved, slots, mut stack)
                        at = to
                        pc = ys[pc]
                    }
                }
            }
        }

        return -1
    }

    // Slot `slot` set to `value`, with a frame that gives it its old position back when the search comes back past it.
    void Set(int slot, int value, mut List<int> slots, mut List<int> stack) {
        stack.Add(1)
        stack.Add(slot)
        stack.Add(slots[slot])
        slots[slot] = value
    }

    // Frames that give each group's slot a look-around or an atomic group changed the position `saved` holds for it back.
    void Keep(List<int> saved, List<int> slots, mut List<int> stack) {
        for k in 0..<saved.Count {
            if slots[k] != saved[k] {
                stack.Add(1)
                stack.Add(k)
                stack.Add(saved[k])
            }
        }
    }

    // Whether the look-around at state `pc` holds at `at`: `(?=` and `(?!` from `at` on, `(?<=` and `(?<!` from a start before
    // `at` to `at` itself, the nearest start first, as .NET takes a look-behind of any length (G2). A positive one that holds keeps
    // the groups its way took, with frames that give them back when the search comes back past it; a negative one keeps none.
    bool Around(Bytes b, int pc, int at, mut List<int> slots, mut List<int> stack) {
        kind = xs[pc]
        saved = RegexHead(slots, 3 * names.Count)
        mut to = -1
        if kind < 2 {
            to = Run(b, pc + 1, at, -1, mut slots, mut stack)
        } else {
            mut start = at
            while true {
                to = Run(b, pc + 1, start, at, mut slots, mut stack)
                if to >= 0 || start == 0 {
                    break
                }

                start = start - 1
                while start > 0 && (int(b[start]) & 192) == 128 {
                    start = start - 1
                }
            }
        }

        if kind == 0 || kind == 2 {
            if to < 0 {
                return false
            }

            Keep(saved, slots, mut stack)
            return true
        }

        if to < 0 {
            return true
        }

        for k in 0..<saved.Count {
            slots[k] = saved[k]
        }

        return false
    }

    // Where the text of group `group` ends when it is read again at `at`, byte by byte, or under `(?i)` character by character by
    // the simple case folding (G2, G4); -1 where it is not there, and where the group has no text, so that `\1` of a group that
    // took no part fails, as .NET's does.
    int Same(Bytes b, int group, bool folded, int at, List<int> slots) {
        start = slots[2 * group]
        end = slots[2 * group + 1]
        if start < 0 || end < 0 {
            return -1
        }

        n = b.Count
        mut i = start
        mut j = at
        while i < end {
            if j >= n {
                return -1
            }

            if folded {
                c = RegexDecode(b, i)
                d = RegexDecode(b, j)
                if c != d && !Folds(c, d) {
                    return -1
                }

                i = i + RegexLength(b[i])
                j = j + RegexLength(b[j])
            } else {
                if b[i] != b[j] {
                    return -1
                }

                i = i + 1
                j = j + 1
            }
        }

        return j
    }

    // Whether `d` is in the cycle of the simple case folding that `c` is in.
    bool Folds(int c, int d) {
        count = fold.Count / 2
        mut e = RegexNextFold(fold, count, c)
        mut steps = 0
        while e != c && steps < 8 {
            if e == d {
                return true
            }

            e = RegexNextFold(fold, count, e)
            steps = steps + 1
        }

        return false
    }

    // Whether the assertion `kind` holds at `at`: the text's start, its end, a line's start and end under `(?m)`, where a line ends
    // at `\n` alone (G4), a word's boundary and no boundary, its start and its end (`\b{start}` and `\<`, `\b{end}` and `\>`),
    // and the halves `\b{start-half}`, no word's character before, and `\b{end-half}`, none after; a word's characters `\w`'s.
    // Under `(?mR)` a line's start and end, 10 and 11, take `\r`, `\n` and `\r\n` as a line's end, as Rust's `StartCRLF` and
    // `EndCRLF` do; 12 to 17 are the word's assertions of `(?-u)`, 4 to 9 with ASCII's word characters.
    bool Looks(int kind, Bytes b, int at) {
        n = b.Count
        if kind == 10 {
            return at == 0 || b[at - 1] == 10 || (b[at - 1] == 13 && (at >= n || b[at] != 10))
        }

        if kind == 11 {
            return at == n || b[at] == 13 || (b[at] == 10 && (at == 0 || b[at - 1] != 13))
        }

        if kind >= 12 {
            before = at > 0 && RegexAsciiWord(int(b[at - 1]))
            after = at < n && RegexAsciiWord(int(b[at]))
            return RegexWordLook(kind - 8, before, after)
        }

        if kind == 0 {
            return at == 0
        }

        if kind == 1 {
            return at == n
        }

        if kind == 2 {
            return at == 0 || b[at - 1] == 10
        }

        if kind == 3 {
            return at == n || b[at] == 10
        }

        mut before = false
        if at > 0 {
            mut start = at - 1
            while start > 0 && (int(b[start]) & 192) == 128 {
                start = start - 1
            }

            before = RegexIn(ranges, wordAt, wordCount, RegexDecode(b, start))
        }

        mut after = false
        if at < n {
            after = RegexIn(ranges, wordAt, wordCount, RegexDecode(b, at))
        }

        return RegexWordLook(kind, before, after)
    }

    // The lazy DFA of the automaton, with no state yet: a cache of a call's searches over the pattern's classes of characters.
    RegexDfa Lazy() {
        return RegexDfa(ops.Count, bounds, classes, ascii, firsts, looks)
    }

    // Whether a match is left from `from` on, by the lazy DFA `d`: where one is, as soon as a match ends, 1 + the last position
    // up to there at which the DFA's state held no thread of an earlier start, before which no match starts, since every match
    // that started before it would have ended there; 0 where none is, at the end of the text; -1 where the DFA gave the search up
    // (`RegexDfa.Empty`).
    int Ahead(Bytes b, int from, RegexDfa d) {
        if d.off {
            return -1
        }

        n = b.Count
        mut s = d.Intern(Context(d, b, from), List<int>())
        if s < 0 {
            return -1
        }

        mut at = from
        mut start = from
        while at < n {
            if d.info[4 * s + 2] == 0 {
                start = at
            }

            k = d.ClassOf(RegexDecode(b, at))
            mut e = d.table[s * d.width + k]
            if e < 0 {
                e = Step(d, s, k)
                if e < 0 {
                    return -1
                }
            }

            if e % 2 == 1 {
                return start + 1
            }

            width = RegexLength(b[at])
            d.read = d.read + long(width)
            s = e / 2
            at = at + width
        }

        if d.info[4 * s + 2] == 0 {
            start = n
        }

        mut end = d.table[s * d.width + d.width - 1]
        if end < 0 {
            end = Step(d, s, d.width - 1)
        }

        if end == 1 {
            return start + 1
        }

        return end
    }

    // The transition of the DFA's state `s` on the class `k`, or on the end of the text where `k` is its last column, made as
    // Rust's lazy DFA makes one: every state the members and a new thread at the automaton's start reach without a character,
    // each assertion read from the character before, which the state holds, and from the one of the class; a match among them
    // ends before the character, and the states after it are those whose character or class takes it. Kept in the state's row,
    // but where the cache was emptied for the next state; 2 * the next state, + 1 where a match ends, or for the end of the text
    // 1 or 0; -1 where the DFA gives the search up.
    int Step(RegexDfa d, int s, int k) {
        before = d.info[4 * s]
        mut next = -1
        if k < d.width - 1 {
            next = d.firsts[k]
        }

        if d.generation >= 1073741824 {
            for i in 0..<d.seen.Count {
                d.seen[i] = 0
            }

            d.generation = 0
        }

        d.generation = d.generation + 1
        d.stack.Clear()
        d.next.Clear()
        d.stack.Add(0)
        for i in 0..<d.info[4 * s + 2] {
            d.stack.Add(d.members[d.info[4 * s + 1] + i])
        }

        mut matched = 0
        while d.stack.Count > 0 {
            mut pc = d.stack[d.stack.Count - 1]
            d.stack.RemoveAt(d.stack.Count - 1)
            while d.seen[pc] != d.generation {
                d.seen[pc] = d.generation
                op = ops[pc]
                if op == 4 {
                    pc = xs[pc]
                } else if op == 3 {
                    d.stack.Add(ys[pc])
                    pc = xs[pc]
                } else if op == 5 {
                    pc = pc + 1
                } else if op == 6 && LooksAt(xs[pc], before, next) {
                    pc = pc + 1
                } else {
                    if op == 0 {
                        matched = 1
                    } else if next >= 0 && (op == 1 && next == xs[pc] || op == 2 && RegexIn(ranges, xs[pc], ys[pc], next)) {
                        d.next.Add(pc + 1)
                    }

                    break
                }
            }
        }

        if next < 0 {
            d.table[s * d.width + k] = matched
            return matched
        }

        d.next.Sort()
        mut context = 0
        if d.looks {
            context = Bits(next)
        }

        clears = d.clears
        to = d.Intern(context, d.next)
        if to < 0 {
            return -1
        }

        e = 2 * to + matched
        if d.clears == clears {
            d.table[s * d.width + k] = e
        }

        return e
    }

    // What a state at `at` holds of the character before it: -1 at the text's start, else its `Bits`; 0 for every state of an
    // automaton with no assertion.
    int Context(RegexDfa d, Bytes b, int at) {
        if !d.looks {
            return 0
        }

        if at == 0 {
            return -1
        }

        mut start = at - 1
        while start > 0 && (int(b[start]) & 192) == 128 {
            start = start - 1
        }

        return Bits(RegexDecode(b, start))
    }

    // What the character `c` is to the assertions: 1 `\n`, 2 `\r`, 4 a word's character of ASCII, 8 a word's character of `\w`.
    int Bits(int c) {
        mut bits = 0
        if c == 10 {
            bits = 1
        } else if c == 13 {
            bits = 2
        }

        if RegexAsciiWord(c) {
            bits = bits + 4
        }

        if wordCount > 0 && RegexIn(ranges, wordAt, wordCount, c) {
            bits = bits + 8
        }

        return bits
    }

    // `Looks` for the DFA: whether the assertion `kind` holds between the character `before` stands for (`Context`) and the code
    // point `next`, -1 at the end of the text.
    bool LooksAt(int kind, int before, int next) {
        if kind == 10 {
            return before < 0 || before % 2 == 1 || (before / 2 % 2 == 1 && next != 10)
        }

        if kind == 11 {
            return next < 0 || next == 13 || (next == 10 && (before < 0 || before / 2 % 2 == 0))
        }

        if kind >= 12 {
            return RegexWordLook(kind - 8, before >= 0 && before / 4 % 2 == 1, next >= 0 && RegexAsciiWord(next))
        }

        if kind == 0 {
            return before < 0
        }

        if kind == 1 {
            return next < 0
        }

        if kind == 2 {
            return before < 0 || before % 2 == 1
        }

        if kind == 3 {
            return next < 0 || next == 10
        }

        return RegexWordLook(kind, before >= 0 && before / 8 % 2 == 1, next >= 0 && RegexIn(ranges, wordAt, wordCount, next))
    }
}

// Whether the word's assertion `kind`, 4 to 9 of `Regex.Looks`, holds between a character that is a word's or not and another.
bool RegexWordLook(int kind, bool before, bool after) {
    if kind == 4 {
        return before != after
    }

    if kind == 5 {
        return before == after
    }

    if kind == 6 {
        return !before && after
    }

    if kind == 7 {
        return before && !after
    }

    if kind == 8 {
        return !before
    }

    return !after
}

// Whether the byte `c` is a word's character of ASCII, `\w` under `(?-u)`.
bool RegexAsciiWord(int c) => c >= 48 && c <= 57 || c >= 65 && c <= 90 || c == 95 || c >= 97 && c <= 122

// The ranges of `\d`, `\w` and `\s` under `(?-u)`, `which` 0, 1 and 2, ASCII's, as Rust's translator takes them.
List<int> RegexAsciiPerl(int which) {
    if which == 0 {
        return [48, 57]
    }

    if which == 1 {
        return [48, 57, 65, 90, 95, 95, 97, 122]
    }

    return [9, 13, 32, 32]
}

// `set` with every number moved by `shift`.
List<int> RegexShift(List<int> set, int shift) {
    mut out = List<int>()
    for x in set {
        out.Add(x + shift)
    }

    return out
}

// The two lists of threads of a search, each a sparse set of states with the slots of each thread, and the stack and the slots of
// the thread being added, as Rust's `PikeVM` holds its `ActiveStates`; made once for a search, and for every search of `Matches`.
// They take the automaton's states times one more than the positions a thread carries, beside the automaton and outside its
// bound, as Rust's `size_limit` does not count the `PikeVM`'s cache (G2).
class RegexThreads {
    internal mut List<int> dense0 = List<int>()
    internal mut List<int> sparse0 = List<int>()
    internal mut List<int> slots0 = List<int>()
    internal mut List<int> dense1 = List<int>()
    internal mut List<int> sparse1 = List<int>()
    internal mut List<int> slots1 = List<int>()
    internal mut List<int> size = [0, 0]
    internal mut List<int> work = List<int>()
    internal mut List<int> stack = List<int>()
    // the lazy DFA of the call's searches, made at its first search (`Regex.Lazy`)
    internal mut RegexDfa? dfa = null

    pub RegexThreads(int states, int count) {
        for i in 0..<states {
            dense0.Add(0)
            sparse0.Add(0)
            dense1.Add(0)
            sparse1.Add(0)
        }

        for i in 0..<states * count {
            slots0.Add(-1)
            slots1.Add(-1)
        }

        for i in 0..<count {
            work.Add(-1)
        }
    }

    internal void Clear(int which) {
        size[which] = 0
    }

    internal bool Has(int which, int pc) {
        if which == 0 {
            k = sparse0[pc]
            return k < size[0] && dense0[k] == pc
        }

        k = sparse1[pc]
        return k < size[1] && dense1[k] == pc
    }

    internal void Put(int which, int pc) {
        if which == 0 {
            sparse0[pc] = size[0]
            dense0[size[0]] = pc
        } else {
            sparse1[pc] = size[1]
            dense1[size[1]] = pc
        }

        size[which] = size[which] + 1
    }

    // The slots of the thread at `pc`, from the slots of the thread being added.
    internal void Keep(int which, int pc, int count) {
        for k in 0..<count {
            if which == 0 {
                slots0[pc * count + k] = work[k]
            } else {
                slots1[pc * count + k] = work[k]
            }
        }
    }

    // The next position's list becomes the list of the position, and the list of the position the next one's.
    internal void Swap() {
        d = dense0
        dense0 = dense1
        dense1 = d
        s = sparse0
        sparse0 = sparse1
        sparse1 = s
        l = slots0
        slots0 = slots1
        slots1 = l
        n = size[0]
        size[0] = size[1]
        size[1] = n
    }
}

// The lazy DFA of the linear engine (G2), as Rust's `regex-automata` builds its hybrid DFA over the automaton the Pike VM runs: a
// state is a set of the automaton's states and what the character before its position is to the assertions, each transition is
// made once, on the first character of its class that needs it (`Regex.Step`), and read from a table after that. It is made for
// one call of `IsMatch`, `Match`, `Matches`, `Replace` or `Split`, beside the automaton and outside its bound. Its states are
// bounded by 2 MiB, Rust's `dfa_size_limit`, each counted as 4 bytes for every column of its row and for every member and 32
// bytes of its own, and it is emptied when the next state does not fit; it gives the search to the Pike VM where it was emptied
// three times and read fewer than 10 bytes for each of its states since, as Rust's meta engine sets `minimum_cache_clear_count`
// and `minimum_bytes_per_state`; and it is not used where the cache cannot hold two states of every member of the automaton beside
// its marks, as Rust's `minimum_cache_capacity` asks room for two beside its three sentinel states.
// The class of each ASCII character, of the pieces that start at `bounds` and their `classes`; empty where there are none.
List<int> RegexAscii(List<int> bounds, List<int> classes) {
    mut ascii = List<int>()
    if bounds.Count == 0 {
        return ascii
    }

    mut k = 0
    for c in 0..<128 {
        while k + 1 < bounds.Count && bounds[k + 1] <= c {
            k = k + 1
        }

        ascii.Add(classes[k])
    }

    return ascii
}

// The first code point of each class, of the pieces that start at `bounds` and their `classes`, which are numbered in the order
// of their first piece.
List<int> RegexFirsts(List<int> bounds, List<int> classes) {
    mut firsts = List<int>()
    for i in 0..<bounds.Count {
        if classes[i] == firsts.Count {
            firsts.Add(bounds[i])
        }
    }

    return firsts
}

// The piece of the code point `c` among the pieces that start at `bounds`: the last that starts at `c` or before.
int RegexPiece(List<int> bounds, int c) {
    mut lo = 0
    mut hi = bounds.Count - 1
    while lo < hi {
        m = (lo + hi + 1) / 2
        if bounds[m] <= c {
            lo = m
        } else {
            hi = m - 1
        }
    }

    return lo
}

class RegexDfa {
    // the pattern's classes of characters (`Regex.bounds`, `Regex.classes`, `Regex.ascii` and `Regex.firsts`)
    internal mut List<int> bounds = List<int>()
    internal mut List<int> classes = List<int>()
    internal mut List<int> ascii = List<int>()
    internal mut List<int> firsts = List<int>()
    // the columns of a row, one for each class and one for the end of the text
    internal mut int width = 0
    // whether the automaton has an assertion, so that a state holds what the character before it is
    internal mut bool looks = false
    // four numbers for each state: its context (`Regex.Context`), the first of its members in `members`, their count and its
    // hash
    internal mut List<int> info = List<int>()
    internal mut List<int> members = List<int>()
    // each state's row: per column 2 * the next state, + 1 where a match ends before the character (for the end of the text 1 or
    // 0), -1 where it is not made yet
    internal mut List<int> table = List<int>()
    // the states by their hash, open addressing: a state + 1, 0 where none is
    internal mut List<int> slots = List<int>()
    // the bytes the states take, the times the cache was emptied, the bytes the searches read since the last time, and whether
    // the DFA gave the searches up
    internal mut int used = 0
    internal mut int clears = 0
    internal mut long read = 0
    internal mut bool off = false
    // the marks of the states a transition reaches, by the number of the transition, and its stack and its next states
    internal mut List<int> seen = List<int>()
    internal mut int generation = 0
    internal mut List<int> stack = List<int>()
    internal mut List<int> next = List<int>()

    // The cache of an automaton of `states` states over its classes of characters.
    pub RegexDfa(int states, List<int> starts, List<int> pieces, List<int> low, List<int> leads, bool assertions) {
        looks = assertions
        bounds = starts
        classes = pieces
        ascii = low
        firsts = leads
        width = firsts.Count + 1
        if 2 * (4 * (width + states) + 32) + 8 * states > 2097152 {
            off = true
        }

        for i in 0..<states {
            seen.Add(0)
        }

        for i in 0..<64 {
            slots.Add(0)
        }
    }

    // The class of the code point `c`: the class of its piece.
    internal int ClassOf(int c) {
        if c < 128 {
            return ascii[c]
        }

        return classes[RegexPiece(bounds, c)]
    }

    // The state of the context `ctx` and the sorted states `set`, made where it is not there yet, after the cache is emptied
    // where it does not fit; -1 where the DFA gives the search up.
    internal int Intern(int ctx, List<int> set) {
        mut h = long(ctx + 2)
        for x in set {
            h = (h * 131 + long(x)) % 1000000007
        }

        mut i = int(h % long(slots.Count))
        while slots[i] != 0 {
            s = slots[i] - 1
            if info[4 * s + 3] == int(h) && Same(s, ctx, set) {
                return s
            }

            i = (i + 1) % slots.Count
        }

        cost = 4 * (width + set.Count) + 32
        if used + cost > 2097152 {
            if !Empty() {
                return -1
            }

            i = int(h % long(slots.Count))
        }

        s = info.Count / 4
        info.Add(ctx)
        info.Add(members.Count)
        info.Add(set.Count)
        info.Add(int(h))
        members.AddRange(set)
        for k in 0..<width {
            table.Add(-1)
        }

        slots[i] = s + 1
        used = used + cost
        if 2 * (s + 1) > slots.Count {
            Grow()
        }

        return s
    }

    // Whether the state `s` is the one of `ctx` and `set`.
    internal bool Same(int s, int ctx, List<int> set) {
        if info[4 * s] != ctx || info[4 * s + 2] != set.Count {
            return false
        }

        at = info[4 * s + 1]
        for i in 0..<set.Count {
            if members[at + i] != set[i] {
                return false
            }
        }

        return true
    }

    // The slots doubled, every state put in again.
    internal void Grow() {
        size = 2 * slots.Count
        slots.Clear()
        for i in 0..<size {
            slots.Add(0)
        }

        for s in 0..<info.Count / 4 {
            mut i = info[4 * s + 3] % size
            while slots[i] != 0 {
                i = (i + 1) % size
            }

            slots[i] = s + 1
        }
    }

    // Empties the cache, as Rust's `try_clear_cache` does: false, and the DFA off, where it was emptied three times before and
    // the searches read fewer than 10 bytes for each of its states since the last time.
    internal bool Empty() {
        if clears >= 3 && read < 10L * long(info.Count / 4) {
            off = true
            return false
        }

        info.Clear()
        members.Clear()
        table.Clear()
        slots.Clear()
        for i in 0..<64 {
            slots.Add(0)
        }

        used = 0
        clears = clears + 1
        read = 0
        return true
    }
}

// The parse of a pattern into a tree and the compilation of the tree into the automaton a `Regex` runs, as Rust's `regex-syntax`
// parses and `regex-automata` compiles one, with the syntax of Rust's crate (G4): an error is the kind and the position of the
// first construct the parse refuses (G3). The tree's nodes: 0 empty, 1 a character (`na` its code point), 2 a class (`na` the
// first of its ranges in `ranges`, `nb` their count), 3 an assertion (`na` its kind, as `Regex.Looks` reads it), 4 a group (`na`
// its number, `nb` its node), 5 a sequence and 6 an alternation (`na` the first of their nodes in `kids`, `nb` their count), and
// 7 a greedy and 8 a lazy repetition (`na` its node, `nb` the least count and `nc` the most, -1 for no most). The automaton's
// states: 0 the match, 1 a character (`xs` its code point), 2 a class (`xs` the first of its ranges, `ys` their count), 3 a split
// (`xs` the state tried first, `ys` the other), 4 a jump (`xs`), 5 a save of the position into slot `xs`, and 6 an assertion
// (`xs` its kind).
class RegexParser {
    internal mut string text = ""
    internal mut Bytes p = Bytes()
    internal mut int n = 0
    internal mut int at = 0
    internal mut long tables = 0
    // the flags in force: 1 `i`, 2 `m`, 4 `s`, 8 `x`, 16 `U`, 32 `R` and 64 `u`, which is in force from the start, as in Rust's
    // crate
    internal mut int mode = 64
    // the position of the first construct Rust's translator refuses, which it reads after the parse and the levels: -1 for none
    internal mut int laterAt = -1
    // the error: -1 none, 0 `Syntax`, 1 `Unsupported` and 2 `TooBig`, and its position
    internal mut int failKind = -1
    internal mut int failAt = 0
    internal mut List<int> kind = List<int>()
    internal mut List<int> na = List<int>()
    internal mut List<int> nb = List<int>()
    internal mut List<int> nc = List<int>()
    // whether the most a node matches is no character, Rust's `maximum_len` of `Some(0)`
    internal mut List<bool> zero = List<bool>()
    internal mut List<int> kids = List<int>()
    internal mut List<int> ops = List<int>()
    internal mut List<int> xs = List<int>()
    internal mut List<int> ys = List<int>()
    internal mut List<int> ranges = List<int>()
    internal mut List<string> names = List<string>()
    internal mut bool usesWord = false
    internal mut int wordAt = 0
    internal mut int wordCount = 0
    // what an escape, an ASCII class, a group's opening and a count gave
    internal mut int escCp = 0
    internal mut List<int> escSet = List<int>()
    internal mut List<int> asciiSet = List<int>()
    internal mut int capture = 0
    internal mut int decimalAt = 0
    // the levels of Rust's `NestLimiter`: each node of Rust's syntax tree that counts one, by its start, its height and its children
    internal mut List<int> nestStart = List<int>()
    internal mut List<int> nestHeight = List<int>()
    internal mut List<int> nestFirst = List<int>()
    internal mut List<int> nestCount = List<int>()
    internal mut List<int> nestKids = List<int>()
    internal mut int lastNest = -1
    // the items of the open sequences, the innermost last, as Rust's `Concat`s on its stack: the node of each (-1 for flags), its
    // level and its start; the branches of the open alternations; and the open groups, each with what its opening put aside
    internal mut List<int> itemNode = List<int>()
    internal mut List<int> itemNest = List<int>()
    internal mut List<int> itemStart = List<int>()
    internal mut List<int> branchNode = List<int>()
    internal mut List<int> branchNest = List<int>()
    internal mut List<int> groupOpen = List<int>()
    internal mut List<int> groupCapture = List<int>()
    internal mut List<int> groupFlags = List<int>()
    internal mut List<int> groupItems = List<int>()
    internal mut List<int> groupConcat = List<int>()
    internal mut List<int> groupBranches = List<int>()
    internal mut List<int> groupAlt = List<int>()
    internal mut int items0 = 0
    internal mut int concatAt = 0
    internal mut int branches0 = 0
    internal mut int altAt = -1
    // the open brackets of a class, the innermost last, as Rust's `ClassState`s: where each opened, whether it is negated, its union
    // of items so far with their count, the start of the first and their levels, and the operation waiting for its right side
    internal mut List<int> classOpen = List<int>()
    internal mut List<bool> classNegated = List<bool>()
    internal mut List<List<int>> classUnion = List<List<int>>()
    internal mut List<int> classCount = List<int>()
    internal mut List<int> classFirst = List<int>()
    internal mut List<int> classItems = List<int>()
    internal mut List<int> unionNest = List<int>()
    internal mut List<int> classOp = List<int>()
    internal mut List<List<int>> classLhs = List<List<int>>()
    internal mut List<int> classLhsNest = List<int>()
    internal mut List<int> classLhsStart = List<int>()
    internal mut List<int> setValue = List<int>()
    internal mut int setNest = -1
    internal mut int setStart = 0
    // the tables of G4, `\d`, `\w`, `\s`, the folding and the characters of a group's name, read from the compiler's table where
    // first needed
    internal mut List<int> digit = List<int>()
    internal mut List<int> word = List<int>()
    internal mut List<int> space = List<int>()
    internal mut List<int> fold = List<int>()
    internal mut List<int> alpha = List<int>()
    internal mut List<int> number = List<int>()
    internal mut List<bool> loaded = [false, false, false, false, false, false]
    // the backtracking engine's (G2): whether the pattern is built for it; its backreferences, each by its node, the position of
    // its `\`, and the group's number, or -1 with its name; whether one compares under `(?i)`; and what an escape that is one gave
    internal mut bool backtracking = false
    internal mut List<int> refNode = List<int>()
    internal mut List<int> refAt = List<int>()
    internal mut List<int> refNumber = List<int>()
    internal mut List<string> refName = List<string>()
    internal mut bool foldRefs = false
    internal mut int escStart = 0
    internal mut int escRef = 0
    internal mut string escName = ""

    // The automaton of `pattern`, or the error in `failKind` and `failAt`. Its size is counted from the tree before it is built,
    // each state 16 bytes and each number of a range 4, and one above 10 MiB, the default of Rust's `size_limit`, is `TooBig`
    // (G2); the count and the states built are the same, or the program stops, a defect of the standard library.
    internal void Build(string pattern, byte* t, bool flag) {
        backtracking = flag
        text = pattern
        p = pattern.Bytes
        n = p.Count
        tables = long(t)
        names.Add("")
        root = Parse()
        if failKind >= 0 {
            Refs(failAt)
            return
        }

        Refs(n + 1)
        if failKind >= 0 {
            return
        }

        if usesWord {
            w = Table(1)
            wordAt = ranges.Count
            wordCount = w.Count / 2
            for x in w {
                ranges.Add(x)
            }
        }

        size = 3 + Size(root)
        if 16 * size + 4 * long(ranges.Count) > 10485760 {
            Fail(2, 0)
            return
        }

        State(5, 0, 0)
        Emit(root)
        State(5, 1, 0)
        State(0, 0, 0)
        if long(ops.Count) != size {
            throw "the automaton of a pattern has {ops.Count} states where its size counted {size}"
        }
    }

    // The backreferences before `before`, resolved once every group is known, as .NET resolves `\2(a)(b)`: a number no group has
    // and a name no group has are `Syntax` at the `\`, the first such one in the pattern. Where the parse refused a construct, at
    // `before`, a backreference before it to no group the parse read is the error instead, as .NET, which counts the groups before
    // it parses, reports `\9(`; a group after that construct is not read, so that `\2(a)\q(b)` is `Syntax` at 0 (G2).
    internal void Refs(int before) {
        for i in 0..<refNode.Count {
            if refAt[i] >= before {
                return
            }

            mut group = refNumber[i]
            if group < 0 {
                for j in 1..<names.Count {
                    if group < 0 && names[j] == refName[i] {
                        group = j
                    }
                }
            }

            if group < 0 || group >= names.Count {
                failKind = 0
                failAt = refAt[i]
                return
            }

            na[refNode[i]] = group
            if nb[refNode[i]] == 1 {
                foldRefs = true
            }
        }
    }

    // The simple case folding a backreference under `(?i)` compares by, empty where none does.
    // Whether the automaton has an assertion.
    internal bool Looks() {
        for op in ops {
            if op == 6 {
                return true
            }
        }

        return false
    }

    // The pieces of the code points for the lazy DFA, the first code point of each, ascending from 0: the code points split where
    // an operation that reads one, or an assertion, can tell two apart, as Rust's `ByteClasses` split the bytes, but over code
    // points, which the automaton reads; empty for the backtracking engine, which runs no DFA.
    internal List<int> Bounds(bool looks) {
        mut bounds = List<int>()
        if backtracking {
            return bounds
        }

        mut points = [0]
        for pc in 0..<ops.Count {
            op = ops[pc]
            if op == 1 {
                points.Add(xs[pc])
                points.Add(xs[pc] + 1)
            } else if op == 2 {
                for m in 0..<ys[pc] {
                    points.Add(ranges[xs[pc] + 2 * m])
                    points.Add(ranges[xs[pc] + 2 * m + 1] + 1)
                }
            }
        }

        if looks {
            // `\n` and `\r` for the lines, ASCII's word characters and those of `\w` for the words
            marks = [10, 11, 13, 14, 48, 58, 65, 91, 95, 96, 97, 123]
            for mark in marks {
                points.Add(mark)
            }

            for m in 0..<wordCount {
                points.Add(ranges[wordAt + 2 * m])
                points.Add(ranges[wordAt + 2 * m + 1] + 1)
            }
        }

        points.Sort()
        for point in points {
            if bounds.Count == 0 || point != bounds[bounds.Count - 1] {
                bounds.Add(point)
            }
        }

        return bounds
    }

    // The class of each piece that starts at `bounds`: the pieces that every operation that reads a character and every
    // assertion read alike are one class, numbered in the order of their first piece, so that a row of the DFA has a column for
    // each way the automaton can read a character rather than for each piece (`Regex.Step`).
    internal List<int> Classes(List<int> bounds, bool looks) {
        mut classes = List<int>()
        mut taken = List<bool>()
        for i in 0..<bounds.Count {
            classes.Add(0)
            taken.Add(false)
        }

        if bounds.Count == 0 {
            return classes
        }

        // each test once: a character as -1 - its code point, a class as its first range * 2^32 + its count of ranges
        mut tests = List<long>()
        for pc in 0..<ops.Count {
            if ops[pc] == 1 {
                tests.Add(-1L - long(xs[pc]))
            } else if ops[pc] == 2 {
                tests.Add(long(xs[pc]) * 4294967296L + long(ys[pc]))
            }
        }

        tests.Sort()
        mut count = 1
        mut ids = List<int>()
        for i in 0..<tests.Count + 4 {
            if i < tests.Count {
                probe = tests[i]
                if i > 0 && probe == tests[i - 1] {
                    continue
                }

                if probe < 0L {
                    taken[RegexPiece(bounds, int(-1L - probe))] = true
                } else {
                    at = int(probe / 4294967296L)
                    for m in 0..<int(probe % 4294967296L) {
                        Take(bounds, mut taken, ranges[at + 2 * m], ranges[at + 2 * m + 1])
                    }
                }
            } else if !looks {
                break
            } else if i == tests.Count {
                Take(bounds, mut taken, 10, 10)
            } else if i == tests.Count + 1 {
                Take(bounds, mut taken, 13, 13)
            } else if i == tests.Count + 2 {
                Take(bounds, mut taken, 48, 57)
                Take(bounds, mut taken, 65, 90)
                Take(bounds, mut taken, 95, 95)
                Take(bounds, mut taken, 97, 122)
            } else {
                for m in 0..<wordCount {
                    Take(bounds, mut taken, ranges[wordAt + 2 * m], ranges[wordAt + 2 * m + 1])
                }
            }

            // each class split in two by the test, the classes numbered again in the order of their first piece
            ids.Clear()
            for j in 0..<2 * count {
                ids.Add(-1)
            }

            mut made = 0
            for k in 0..<bounds.Count {
                mut key = 2 * classes[k]
                if taken[k] {
                    key = key + 1
                }

                if ids[key] < 0 {
                    ids[key] = made
                    made = made + 1
                }

                classes[k] = ids[key]
                taken[k] = false
            }

            count = made
        }

        return classes
    }

    // Marks the pieces of the code points `a` to `b` in `taken`; `a` and `b` + 1 start pieces.
    internal void Take(List<int> bounds, mut List<bool> taken, int a, int b) {
        for k in RegexPiece(bounds, a)..RegexPiece(bounds, b) {
            taken[k] = true
        }
    }

    internal List<int> RefFold() {
        if foldRefs {
            return Table(3)
        }

        return List<int>()
    }

    internal void Fail(int k, int position) {
        if failKind < 0 {
            failKind = k
            failAt = position
        }
    }

    // A node, with whether the most it matches is no character, as Rust's `maximum_len` of `Some(0)`: the empty node and an
    // assertion; a group of such a node; a sequence or an alternation of such nodes only; and a repetition of such a node or of
    // at most 0. A lookaround is such a node, and an atomic group as its content; a backreference is not, even to a group that
    // reads no character (`()\1`), since its group is resolved after the parse, so that its repetition is counted in full.
    internal int Node(int k, int a, int b, int c) {
        mut none = false
        if k == 0 || k == 3 {
            none = true
        } else if k == 4 {
            none = zero[b]
        } else if k == 5 || k == 6 {
            none = true
            end = a + b
            for i in a..<end {
                if !zero[kids[i]] {
                    none = false
                }
            }
        } else if k == 7 || k == 8 {
            none = c == 0 || zero[a]
        } else if k == 10 {
            none = true
        } else if k == 11 {
            none = zero[b]
        }

        kind.Add(k)
        na.Add(a)
        nb.Add(b)
        nc.Add(c)
        zero.Add(none)
        return kind.Count - 1
    }

    internal int Kids(List<int> items) {
        start = kids.Count
        for k in items {
            kids.Add(k)
        }

        return start
    }

    internal int ClassNode(List<int> set) {
        start = ranges.Count
        for x in set {
            ranges.Add(x)
        }

        return Node(2, start, set.Count / 2, 0)
    }

    // A character, and under `(?i)` the class of every character that folds with it (G4).
    internal int Literal(int cp) {
        if (mode & 1) != 0 {
            set = Folded([cp, cp])
            if set.Count > 2 {
                return ClassNode(set)
            }
        }

        return Node(1, cp, 0, 0)
    }

    // The table `which` of G4: 0 `\d`, 1 `\w`, 2 `\s`, 3 the folding, 4 Alphabetic and 5 the categories Nd, Nl and No, of a
    // group's name.
    internal List<int> Table(int which) {
        if !loaded[which] {
            part = RegexTablePart(tables, which)
            if which == 0 {
                digit = part
            } else if which == 1 {
                word = part
            } else if which == 2 {
                space = part
            } else if which == 3 {
                fold = part
            } else if which == 4 {
                alpha = part
            } else {
                number = part
            }

            loaded[which] = true
        }

        if which == 0 {
            return digit
        }

        if which == 1 {
            return word
        }

        if which == 2 {
            return space
        }

        if which == 3 {
            return fold
        }

        if which == 4 {
            return alpha
        }

        return number
    }

    // Rust's `char::is_whitespace`: the property White_Space.
    internal bool White(int cp) {
        return cp == 32 || cp >= 9 && cp <= 13 || cp >= 128 && RegexIn(Table(2), 0, Table(2).Count / 2, cp)
    }

    // Rust's `bump_space`: under `(?x)`, the white space and the comments from `#` to the line's end, which the pattern does not
    // match.
    internal void Skip() {
        if (mode & 8) == 0 {
            return
        }

        while at < n {
            if p[at] == 35 {
                while at < n && p[at] != 10 {
                    at = at + 1
                }

                continue
            }

            if !White(RegexDecode(p, at)) {
                return
            }

            at = at + RegexLength(p[at])
        }
    }

    internal bool Starts(string s) {
        b = s.Bytes
        if at + b.Count > n {
            return false
        }

        for i in 0..<b.Count {
            if p[at + i] != b[i] {
                return false
            }
        }

        return true
    }

    // Rust's `parse_with_comments`: one pass over the pattern with a stack of the open groups and alternations instead of the call
    // stack, so that no depth of nesting runs out of it; then the end of the open groups (`pop_group_end`) and the count of the
    // levels (`NestLimiter`), each only once the whole pattern was read.
    internal int Parse() {
        while true {
            Skip()
            if at >= n {
                break
            }

            c = int(p[at])
            start = at
            if c == 40 {
                if !Open() {
                    return -1
                }
            } else if c == 41 {
                if !Close() {
                    return -1
                }
            } else if c == 124 {
                Alternate()
                at = at + 1
                concatAt = at
            } else if c == 91 {
                set = Class()
                if failKind >= 0 {
                    return -1
                }

                node = ClassNode(set)
                Push(node, setNest, start)
            } else if c == 42 || c == 43 || c == 63 {
                if !Repeat() {
                    return -1
                }
            } else if c == 123 {
                if !Counted() {
                    return -1
                }
            } else {
                node = Primitive()
                if failKind >= 0 {
                    return -1
                }

                Push(node, -1, start)
            }
        }

        root = Level()
        if groupOpen.Count > 0 {
            Fail(0, groupOpen[groupOpen.Count - 1])
            return -1
        }

        deep = Deep(lastNest)
        if deep >= 0 {
            Fail(0, deep)
            return -1
        }

        if laterAt >= 0 {
            Fail(0, laterAt)
            return -1
        }

        return root
    }

    internal void Push(int node, int nest, int start) {
        itemNode.Add(node)
        itemNest.Add(nest)
        itemStart.Add(start)
    }

    // The sequence being read, as Rust's `Concat::into_ast`, its level in `lastNest`.
    internal int Sequence() {
        mut nodes = List<int>()
        mut nests = List<int>()
        count = itemNode.Count - items0
        for i in items0..<itemNode.Count {
            if itemNode[i] >= 0 {
                nodes.Add(itemNode[i])
            }

            nests.Add(itemNest[i])
        }

        while itemNode.Count > items0 {
            last = itemNode.Count - 1
            itemNode.RemoveAt(last)
            itemNest.RemoveAt(last)
            itemStart.RemoveAt(last)
        }

        if count == 0 {
            lastNest = -1
        } else if count == 1 {
            lastNest = nests[0]
        } else {
            lastNest = NestOf(concatAt, nests)
        }

        if nodes.Count == 0 {
            return Node(0, 0, 0, 0)
        }

        if nodes.Count == 1 {
            return nodes[0]
        }

        return Node(5, Kids(nodes), nodes.Count, 0)
    }

    // A `|`: the sequence before it is a branch of the alternation, which starts where its first branch does.
    internal void Alternate() {
        node = Sequence()
        if altAt < 0 {
            altAt = concatAt
        }

        branchNode.Add(node)
        branchNest.Add(lastNest)
    }

    // The sequence being read, or the alternation of it and the branches before it.
    internal int Level() {
        node = Sequence()
        if altAt < 0 {
            return node
        }

        mut nodes = List<int>()
        mut nests = List<int>()
        for i in branches0..<branchNode.Count {
            nodes.Add(branchNode[i])
            nests.Add(branchNest[i])
        }

        nodes.Add(node)
        nests.Add(lastNest)
        while branchNode.Count > branches0 {
            branchNode.RemoveAt(branchNode.Count - 1)
            branchNest.RemoveAt(branchNest.Count - 1)
        }

        lastNest = NestOf(altAt, nests)
        altAt = -1
        return Node(6, Kids(nodes), nodes.Count, 0)
    }

    // Rust's `push_group`: a group opens a sequence of its own, and flags alone are an item of the one being read.
    internal bool Open() {
        open = at
        saved = mode
        r = Group()
        if r < 0 {
            return false
        }

        if r == 0 {
            Push(-1, -1, open)
            return true
        }

        groupOpen.Add(open)
        groupCapture.Add(capture)
        groupFlags.Add(saved)
        groupItems.Add(items0)
        groupConcat.Add(concatAt)
        groupBranches.Add(branches0)
        groupAlt.Add(altAt)
        items0 = itemNode.Count
        concatAt = at
        branches0 = branchNode.Count
        altAt = -1
        return true
    }

    // Rust's `pop_group`: a `)` no group opened is `Syntax` at it.
    internal bool Close() {
        if groupOpen.Count == 0 {
            Fail(0, at)
            return false
        }

        child = Level()
        childNest = lastNest
        at = at + 1
        g = groupOpen.Count - 1
        open = groupOpen[g]
        index = groupCapture[g]
        mode = groupFlags[g]
        items0 = groupItems[g]
        concatAt = groupConcat[g]
        branches0 = groupBranches[g]
        altAt = groupAlt[g]
        groupOpen.RemoveAt(g)
        groupCapture.RemoveAt(g)
        groupFlags.RemoveAt(g)
        groupItems.RemoveAt(g)
        groupConcat.RemoveAt(g)
        groupBranches.RemoveAt(g)
        groupAlt.RemoveAt(g)
        mut node = child
        if index >= 0 {
            node = Node(4, index, child, 0)
        } else if index == -6 {
            node = Node(11, 0, child, 0)
        } else if index <= -2 {
            node = Node(10, -2 - index, child, 0)
        }

        nest = NestOf(open, [childNest])
        Push(node, nest, open)
        return true
    }

    // Rust's `parse_group`: a look-around is `Unsupported` at the `(`, as Kurz reads an atomic group `(?>` (G4), but for the
    // backtracking engine, which takes them (G2); 1 for a group, its capture in `capture` (-1 for none, and for the backtracking
    // engine -2 for `(?=`, -3 `(?!`, -4 `(?<=`, -5 `(?<!` and -6 `(?>`), 0 for flags alone and -1 for an error.
    internal int Group() {
        open = at
        at = at + 1
        Skip()
        if Starts("?=") || Starts("?!") || Starts("?<=") || Starts("?<!") || Starts("?>") {
            if !backtracking {
                Fail(1, open)
                return -1
            }

            mut look = 4
            if Starts("?=") {
                look = 0
            } else if Starts("?!") {
                look = 1
            } else if Starts("?<=") {
                look = 2
            } else if Starts("?<!") {
                look = 3
            }

            if look == 2 || look == 3 {
                at = at + 3
            } else {
                at = at + 2
            }

            capture = -2 - look
            return 1
        }

        inner = at
        if Starts("?P<") || Starts("?<") {
            if p[at + 1] == 80 {
                at = at + 3
            } else {
                at = at + 2
            }

            name = Name(true)
            if failKind >= 0 {
                return -1
            }

            capture = names.Count
            names.Add(name)
            return 1
        }

        if at < n && p[at] == 63 {
            at = at + 1
            if at >= n {
                Fail(0, open)
                return -1
            }

            return Flags(inner)
        }

        capture = names.Count
        names.Add("")
        return 1
    }

    // Rust's `parse_capture_name`: the name's first character is `_` or alphabetic, and a later one also `.`, `[`, `]` or numeric
    // (`is_capture_char`); an empty name, and a group's name given twice, are `Syntax` at its start. A backreference's name,
    // `fresh` false, names a group that has it.
    internal string Name(bool fresh) {
        if at >= n {
            Fail(0, at)
            return ""
        }

        start = at
        while p[at] != 62 {
            cp = RegexDecode(p, at)
            mut named = cp == 95 || RegexIn(Table(4), 0, Table(4).Count / 2, cp)
            if !named && at > start {
                named = cp == 46 || cp == 91 || cp == 93 || RegexIn(Table(5), 0, Table(5).Count / 2, cp)
            }

            if !named {
                Fail(0, at)
                return ""
            }

            at = at + RegexLength(p[at])
            if at >= n {
                Fail(0, at)
                return ""
            }
        }

        empty = at == start
        name = text.Substring(start, at - start)
        at = at + 1
        if empty {
            Fail(0, start)
            return ""
        }

        if fresh {
            for given in names {
                if given == name {
                    Fail(0, start)
                    return ""
                }
            }
        }

        return name
    }

    // Rust's `parse_flags`: the flags up to `:` or `)`; a second `-` and a flag given twice are `Syntax` at it, the end of the
    // pattern at the end, a `-` with no flag after it at the `-`, and `(?)` at its `?`.
    internal int Flags(int inner) {
        mut negation = -1
        mut dangling = -1
        mut seen = 0
        while p[at] != 58 && p[at] != 41 {
            c = int(p[at])
            if c == 45 {
                if negation >= 0 {
                    Fail(0, at)
                    return -1
                }

                negation = at
                dangling = at
            } else {
                dangling = -1
                mut bit = 0
                if c == 105 {
                    bit = 1
                } else if c == 109 {
                    bit = 2
                } else if c == 115 {
                    bit = 4
                } else if c == 120 {
                    bit = 8
                } else if c == 85 {
                    bit = 16
                } else if c == 82 {
                    bit = 32
                } else if c == 117 {
                    bit = 64
                }

                if bit == 0 || (seen & bit) != 0 {
                    Fail(0, at)
                    return -1
                }

                seen = seen | bit
                if negation >= 0 {
                    mode = mode & (127 - bit)
                } else {
                    mode = mode | bit
                }
            }

            at = at + 1
            if at >= n {
                Fail(0, at)
                return -1
            }
        }

        if dangling >= 0 {
            Fail(0, dangling)
            return -1
        }

        alone = p[at] == 41
        at = at + 1
        if alone && seen == 0 && negation < 0 {
            Fail(0, inner)
            return -1
        }

        capture = -1
        if alone {
            return 0
        }

        return 1
    }

    // Rust's `parse_uncounted_repetition`: `*`, `+` or `?` of the item before it, lazy with a `?` right after it; with no item
    // before it, or flags, `Syntax` at it.
    internal bool Repeat() {
        last = itemNode.Count - 1
        if last < items0 || itemNode[last] < 0 {
            Fail(0, at)
            return false
        }

        d = int(p[at])
        at = at + 1
        lazy = at < n && p[at] == 63
        if lazy {
            at = at + 1
        }

        mut long min = 0
        mut long max = -1
        if d == 43 {
            min = 1
        } else if d == 63 {
            max = 1
        }

        Repeated(min, max, lazy)
        return true
    }

    // The last item repeated, the other way round under `(?U)`; a node that matches no character is repeated at most once, as
    // Rust's `Hir::repetition` does, so that `(?:){4294967295}` builds.
    internal void Repeated(long least, long most, bool lazy) {
        last = itemNode.Count - 1
        child = itemNode[last]
        mut min = least
        mut max = most
        if zero[child] {
            if min > 1 {
                min = 1
            }

            if max < 0 || max > 1 {
                max = 1
            }
        }

        if min > 2147483647 {
            min = 2147483647
        }

        if max > 2147483647 {
            max = 2147483647
        }

        mut k = 8
        if lazy == ((mode & 16) != 0) {
            k = 7
        }

        node = Node(k, child, int(min), int(max))
        nest = NestOf(itemStart[last], [itemNest[last]])
        itemNode[last] = node
        itemNest[last] = nest
    }

    // Rust's `parse_counted_repetition`: `{n}`, `{n,}` or `{n,m}`, each count up to 4294967295; the end of the pattern, and a brace
    // not closed, are `Syntax` at the brace, a missing or too large count at its digits, and a most below the least at the brace.
    internal bool Counted() {
        open = at
        last = itemNode.Count - 1
        if last < items0 || itemNode[last] < 0 {
            Fail(0, at)
            return false
        }

        at = at + 1
        Skip()
        if at >= n {
            Fail(0, open)
            return false
        }

        lo = Decimal()
        loAt = decimalAt
        if at >= n {
            Fail(0, open)
            return false
        }

        mut hi = lo
        if p[at] == 44 {
            at = at + 1
            Skip()
            if at >= n {
                Fail(0, open)
                return false
            }

            if lo < 0 {
                Fail(0, loAt)
                return false
            }

            hi = -1
            if p[at] != 125 {
                hi = Decimal()
                if hi < 0 {
                    Fail(0, decimalAt)
                    return false
                }
            }
        } else if lo < 0 {
            Fail(0, loAt)
            return false
        }

        if at >= n || p[at] != 125 {
            Fail(0, open)
            return false
        }

        at = at + 1
        Skip()
        lazy = at < n && p[at] == 63
        if lazy {
            at = at + 1
        }

        if hi >= 0 && lo > hi {
            Fail(0, open)
            return false
        }

        Repeated(lo, hi, lazy)
        return true
    }

    // Rust's `parse_decimal`: white space before and after the digits whether or not `(?x)` holds, the digits' start in
    // `decimalAt`; -1 for no digit and -2 for a count above 4294967295, Rust's `u32`.
    internal long Decimal() {
        while at < n && White(RegexDecode(p, at)) {
            at = at + RegexLength(p[at])
        }

        decimalAt = at
        mut long value = 0
        mut digits = false
        mut big = false
        while at < n && p[at] >= 48 && p[at] <= 57 {
            value = value * 10 + long(int(p[at]) - 48)
            if value > 4294967295 {
                big = true
                value = 4294967295
            }

            digits = true
            at = at + 1
            Skip()
        }

        while at < n && White(RegexDecode(p, at)) {
            at = at + RegexLength(p[at])
            Skip()
        }

        if !digits {
            return -1
        }

        if big {
            return -2
        }

        return value
    }

    // `.`, `^`, `$`, an escape or a character.
    internal int Primitive() {
        c = int(p[at])
        if c == 46 {
            if (mode & 64) == 0 {
                Later(at)
            }

            at = at + 1
            if (mode & 4) != 0 {
                return ClassNode([0, 1114111])
            }

            if (mode & 32) != 0 {
                return ClassNode([0, 9, 11, 12, 14, 1114111])
            }

            return ClassNode([0, 9, 11, 1114111])
        }

        if c == 94 {
            at = at + 1
            if (mode & 2) != 0 {
                if (mode & 32) != 0 {
                    return Node(3, 10, 0, 0)
                }

                return Node(3, 2, 0, 0)
            }

            return Node(3, 0, 0, 0)
        }

        if c == 36 {
            at = at + 1
            if (mode & 2) != 0 {
                if (mode & 32) != 0 {
                    return Node(3, 11, 0, 0)
                }

                return Node(3, 3, 0, 0)
            }

            return Node(3, 1, 0, 0)
        }

        if c == 92 {
            r = Escape()
            if r == 0 {
                return -1
            }

            if r == 1 {
                if (mode & 64) == 0 && Byte() {
                    Later(escStart)
                }

                return Literal(escCp)
            }

            if r == 2 {
                return ClassNode(escSet)
            }

            if r == 4 {
                mut folded = 0
                if (mode & 1) != 0 {
                    folded = 1
                }

                node = Node(9, 0, folded, 0)
                refNode.Add(node)
                refAt.Add(escStart)
                refNumber.Add(escRef)
                refName.Add(escName)
                return node
            }

            if (mode & 64) == 0 && escCp >= 4 {
                return Node(3, escCp + 8, 0, 0)
            }

            return Node(3, escCp, 0, 0)
        }

        cp = RegexDecode(p, at)
        at = at + RegexLength(p[at])
        return Literal(cp)
    }

    // Whether the escape just read is `\xNN` above 7F, which under `(?-u)` Rust's translator reads as a byte, and refuses: a byte
    // above ASCII is no character. A character above ASCII written another way is taken as its UTF-8.
    internal bool Byte() => escCp > 127 && p[escStart + 1] == 120 && p[at - 1] != 125

    // A construct Rust's translator refuses, at `start`: the first one is the error once the parse and the levels found none.
    internal void Later(int start) {
        if laterAt < 0 {
            laterAt = start
        }
    }

    // `set` folded as `(?i)` folds it: by the simple case folding of G4's table, or under `(?-u)` ASCII's letters alone.
    internal List<int> Folded(List<int> set) {
        if (mode & 64) != 0 {
            return Fold(set)
        }

        return RegexUnion(set, RegexUnion(RegexShift(RegexIntersect(set, [97, 122]), -32), RegexShift(RegexIntersect(set, [65, 90]), 32)))
    }

    // A class that is a set of bytes under `(?-u)`, at `start`: one that holds a character above ASCII, after its negation, is
    // refused there, since it would match a byte of no character, as Rust's translator refuses it.
    internal void Bytewise(List<int> set, int start) {
        if (mode & 64) == 0 && set.Count > 0 && set[set.Count - 1] > 127 {
            Later(start)
        }
    }

    // Rust's `parse_unicode_class` and its translation (G4): `\p` or `\P` at `start`, then one letter, or in braces a name,
    // `name=value`, `name:value` or `name!=value`, which negates once more, the white space and the comments of `(?x)` passed over.
    // The end of the pattern is `Syntax` at the end, and a `\` for the letter at that `\`. The class is `escSet`, folded under
    // `(?i)` before it is negated; a name Rust's crate does not know, and any `\p` under `(?-u)`, is `Syntax` at `start` once the
    // parse and the levels found no error, as its translator refuses it.
    internal bool Property(bool negated, int start) {
        at = at + 1
        Skip()
        if at >= n {
            Fail(0, at)
            return false
        }

        mut spelled = List<int>()
        if p[at] == 123 {
            at = at + 1
            Skip()
            while at < n && p[at] != 125 {
                stop = at + RegexLength(p[at])
                while at < stop {
                    spelled.Add(int(p[at]))
                    at = at + 1
                }

                Skip()
            }

            if at >= n {
                Fail(0, at)
                return false
            }

            at = at + 1
        } else {
            if p[at] == 92 {
                Fail(0, at)
                return false
            }

            past = at + RegexLength(p[at])
            while at < past {
                spelled.Add(int(p[at]))
                at = at + 1
            }

            Skip()
        }

        mut split = RegexFind(spelled, 33, 61)
        mut width = 2
        if split < 0 {
            width = 1
            split = RegexFind(spelled, 58, -1)
        }

        if split < 0 {
            split = RegexFind(spelled, 61, -1)
        }

        escSet = List<int>()
        if (mode & 64) == 0 {
            Later(start)
            return true
        }

        mut query = RegexKey(0, spelled, 0, spelled.Count)
        if split >= 0 {
            kindOf = RegexProperty(tables, RegexKey(8, spelled, 0, split))
            if kindOf.Count == 1 && kindOf[0] < 0 {
                query = RegexKey(-1 - kindOf[0], spelled, split + width, spelled.Count)
            } else {
                query = List<int>()
            }
        }

        mut set = List<int>()
        if query.Count > 0 {
            set = RegexProperty(tables, query)
        }

        if set.Count == 0 || set[0] < 0 {
            Later(start)
            return true
        }

        if (mode & 1) != 0 {
            set = Folded(set)
        }

        if negated != (split >= 0 && width == 2) {
            set = RegexNegate(set)
        }

        escSet = set
        return true
    }

    // Rust's `parse_escape`: 1 for a character in `escCp`, 2 for a class in `escSet`, 3 for an assertion in `escCp` (0 `\A`, 1 `\z`,
    // 4 `\b`, 5 `\B`, 6 `\b{start}` and `\<`, 7 `\b{end}` and `\>`, 8 `\b{start-half}`, 9 `\b{end-half}`) and 0 for an error; a
    // backreference is `Unsupported` at the `\`, the backtracking engine's (G4), and so is `\k`. For the backtracking
    // engine (G2), 4 for a backreference: `\` and a digit from 1 on, the group of the number its digits write, or `\k<name>`, in
    // `escRef`, -1 with the name in `escName`.
    internal int Escape() {
        start = at
        escStart = at
        at = at + 1
        if at >= n {
            Fail(0, start)
            return 0
        }

        c = int(p[at])
        if backtracking && c >= 49 && c <= 57 {
            mut written = 0
            while at < n && int(p[at]) >= 48 && int(p[at]) <= 57 {
                if written < 100000000 {
                    written = written * 10 + int(p[at]) - 48
                }

                at = at + 1
            }

            escRef = written
            escName = ""
            return 4
        }

        if backtracking && c == 107 {
            at = at + 1
            if at >= n || p[at] != 60 {
                Fail(0, start)
                return 0
            }

            at = at + 1
            name = Name(false)
            if failKind >= 0 {
                return 0
            }

            escRef = -1
            escName = name
            return 4
        }

        if c >= 48 && c <= 57 || c == 107 {
            Fail(1, start)
            return 0
        }

        if c == 112 || c == 80 {
            if Property(c == 80, start) {
                return 2
            }

            return 0
        }

        if c == 120 || c == 117 || c == 85 {
            if HexEscape(c) {
                return 1
            }

            return 0
        }

        if c == 100 || c == 68 || c == 119 || c == 87 || c == 115 || c == 83 {
            at = at + 1
            mut which = 0
            if c == 119 || c == 87 {
                which = 1
            } else if c == 115 || c == 83 {
                which = 2
            }

            mut set = List<int>()
            if (mode & 64) == 0 {
                set = RegexAsciiPerl(which)
            } else {
                set = Table(which)
            }

            if c < 97 {
                escSet = RegexNegate(set)
                Bytewise(escSet, start)
            } else {
                escSet = set
            }

            return 2
        }

        at = at + RegexLength(p[at])
        if c < 128 && !(c >= 65 && c <= 90 || c >= 97 && c <= 122) && c != 60 && c != 62 {
            escCp = c
            return 1
        }

        mut simple = -1
        if c == 97 {
            simple = 7
        } else if c == 102 {
            simple = 12
        } else if c == 116 {
            simple = 9
        } else if c == 110 {
            simple = 10
        } else if c == 114 {
            simple = 13
        } else if c == 118 {
            simple = 11
        }

        if simple >= 0 {
            escCp = simple
            return 1
        }

        escCp = -1
        if c == 65 {
            escCp = 0
        } else if c == 122 {
            escCp = 1
        } else if c == 98 {
            escCp = 4
        } else if c == 66 {
            escCp = 5
        } else if c == 60 {
            escCp = 6
        } else if c == 62 {
            escCp = 7
        }

        if escCp < 0 {
            Fail(0, start)
            return 0
        }

        if escCp >= 4 && (mode & 64) != 0 {
            usesWord = true
        }

        if c == 98 && at < n && p[at] == 123 {
            if Boundary(start) {
                return 3
            }

            return 0
        }

        return 3
    }

    // Rust's `maybe_parse_special_word_boundary`: `\b{start}`, `\b{end}`, `\b{start-half}` or `\b{end-half}`; a brace whose next
    // character is no letter and no `-` is a counted repetition of `\b`.
    internal bool Boundary(int start) {
        brace = at
        at = at + 1
        Skip()
        if at >= n {
            Fail(0, start)
            return false
        }

        contents = at
        if !RegexBoundaryLetter(p[at]) {
            at = brace
            return true
        }

        mut letters = List<int>()
        while at < n && RegexBoundaryLetter(p[at]) {
            letters.Add(int(p[at]))
            at = at + 1
            Skip()
        }

        if at >= n || p[at] != 125 {
            Fail(0, brace)
            return false
        }

        at = at + 1
        escCp = -1
        if RegexSame(letters, "start") {
            escCp = 6
        } else if RegexSame(letters, "end") {
            escCp = 7
        } else if RegexSame(letters, "start-half") {
            escCp = 8
        } else if RegexSame(letters, "end-half") {
            escCp = 9
        }

        if escCp < 0 {
            Fail(0, contents)
            return false
        }

        return true
    }

    // Rust's `parse_hex`: `\x` of two digits, `\u` of four, `\U` of eight, or any of them with any number of digits in braces; a
    // value that is no scalar value is `Syntax` at its first digit.
    internal bool HexEscape(int c) {
        at = at + 1
        Skip()
        if at >= n {
            Fail(0, at)
            return false
        }

        mut long value = 0
        mut first = at
        if p[at] == 123 {
            brace = at
            first = at + 1
            mut count = 0
            while true {
                at = at + 1
                Skip()
                if at >= n || p[at] == 125 {
                    break
                }

                h = RegexHex(p[at])
                if h < 0 {
                    Fail(0, at)
                    return false
                }

                value = value * 16 + long(h)
                if value > 1114112 {
                    value = 1114112
                }

                count = count + 1
            }

            if at >= n {
                Fail(0, brace)
                return false
            }

            at = at + 1
            Skip()
            if count == 0 {
                Fail(0, brace)
                return false
            }
        } else {
            mut digits = 2
            if c == 117 {
                digits = 4
            } else if c == 85 {
                digits = 8
            }

            for i in 0..<digits {
                if i > 0 {
                    at = at + 1
                    Skip()
                    if at >= n {
                        Fail(0, at)
                        return false
                    }
                }

                h = RegexHex(p[at])
                if h < 0 {
                    Fail(0, at)
                    return false
                }

                value = value * 16 + long(h)
            }

            at = at + 1
            Skip()
        }

        if value > 1114111 || value >= 55296 && value <= 57343 {
            Fail(0, first)
            return false
        }

        escCp = int(value)
        return true
    }

    // Rust's `parse_set_class`: a bracketed class and every class nested in it in one pass, with a stack of the open brackets; its
    // level in `setNest`. The end of the pattern inside it is `Syntax` at the innermost open bracket.
    internal List<int> Class() {
        OpenClass()
        while failKind < 0 {
            Skip()
            if at >= n {
                Fail(0, classOpen[classOpen.Count - 1])
                break
            }

            c = int(p[at])
            start = at
            if c == 91 {
                if Ascii() {
                    set = asciiSet
                    AddItem(set, -1, start)
                } else {
                    OpenClass()
                }

                continue
            }

            if c == 93 {
                if CloseClass() {
                    return setValue
                }

                continue
            }

            if at + 1 < n && (c == 38 || c == 45 || c == 126) && int(p[at + 1]) == c {
                at = at + 2
                k = classOpen.Count - 1
                IntoItem(k)
                classLhs[k] = setValue
                classLhsNest[k] = setNest
                classLhsStart[k] = setStart
                classOp[k] = c
                classUnion[k] = List<int>()
                classCount[k] = 0
                classFirst[k] = at
                continue
            }

            Range()
        }

        return List<int>()
    }

    // Rust's `parse_set_class_open`: a `[`, its `^`, every `-` right after them as a character, then a `]` as a character where no
    // item came before it.
    internal void OpenClass() {
        open = at
        at = at + 1
        Skip()
        if at >= n {
            Fail(0, open)
            return
        }

        mut negated = false
        if p[at] == 94 {
            negated = true
            at = at + 1
            Skip()
            if at >= n {
                Fail(0, open)
                return
            }
        }

        classOpen.Add(open)
        classNegated.Add(negated)
        classUnion.Add(List<int>())
        classCount.Add(0)
        classFirst.Add(at)
        classItems.Add(unionNest.Count)
        classOp.Add(-1)
        classLhs.Add(List<int>())
        classLhsNest.Add(-1)
        classLhsStart.Add(0)
        while p[at] == 45 {
            AddItem([45, 45], -1, at)
            at = at + 1
            Skip()
            if at >= n {
                Fail(0, open)
                return
            }
        }

        if classCount[classCount.Count - 1] == 0 && p[at] == 93 {
            AddItem([93, 93], -1, at)
            at = at + 1
            Skip()
            if at >= n {
                Fail(0, open)
            }
        }
    }

    internal void AddItem(List<int> set, int nest, int start) {
        k = classOpen.Count - 1
        united = RegexUnion(classUnion[k], set)
        classUnion[k] = united
        if classCount[k] == 0 {
            classFirst[k] = start
        }

        classCount[k] = classCount[k] + 1
        unionNest.Add(nest)
    }

    // Rust's `ClassSetUnion::into_item` and `pop_class_op`: the items of the innermost bracket since its opening or its last
    // operation, then that operation applied, each side folded first under `(?i)` as Rust's translator folds them; the set, its
    // level and its start in `setValue`, `setNest` and `setStart`.
    internal void IntoItem(int k) {
        count = classCount[k]
        b = classItems[k]
        setValue = classUnion[k]
        setStart = classFirst[k]
        if count == 0 {
            setNest = -1
        } else if count == 1 {
            setNest = unionNest[b]
        } else {
            mut items = List<int>()
            for i in b..<unionNest.Count {
                items.Add(unionNest[i])
            }

            setNest = NestOf(setStart, items)
        }

        while unionNest.Count > b {
            unionNest.RemoveAt(unionNest.Count - 1)
        }

        op = classOp[k]
        if op < 0 {
            return
        }

        mut lhs = classLhs[k]
        mut rhs = setValue
        if (mode & 1) != 0 {
            lhs = Folded(lhs)
            rhs = Folded(rhs)
        }

        if op == 38 {
            setValue = RegexIntersect(lhs, rhs)
        } else if op == 45 {
            setValue = RegexIntersect(lhs, RegexNegate(rhs))
        } else {
            setValue = RegexUnion(RegexIntersect(lhs, RegexNegate(rhs)), RegexIntersect(rhs, RegexNegate(lhs)))
        }

        setNest = NestOf(classLhsStart[k], [classLhsNest[k], setNest])
        setStart = classLhsStart[k]
    }

    // Rust's `pop_class`: a `]`, true where it closes the outermost bracket.
    internal bool CloseClass() {
        k = classOpen.Count - 1
        IntoItem(k)
        at = at + 1
        mut set = setValue
        if (mode & 1) != 0 {
            set = Folded(set)
        }

        if classNegated[k] {
            set = RegexNegate(set)
        }

        open = classOpen[k]
        Bytewise(set, open)
        nest = NestOf(open, [setNest])
        classOpen.RemoveAt(k)
        classNegated.RemoveAt(k)
        classUnion.RemoveAt(k)
        classCount.RemoveAt(k)
        classFirst.RemoveAt(k)
        classItems.RemoveAt(k)
        classOp.RemoveAt(k)
        classLhs.RemoveAt(k)
        classLhsNest.RemoveAt(k)
        classLhsStart.RemoveAt(k)
        if k == 0 {
            setValue = set
            setNest = nest
            return true
        }

        AddItem(set, nest, open)
        return false
    }

    // Rust's `parse_set_class_range`: an item, or two joined by `-` where the next character past white space under `(?x)` is no
    // `]` and no `-`. An assertion is `Syntax` at its start, a side that is no character at that side, and a range whose end is
    // below its start at its start.
    internal void Range() {
        first = at
        k1 = ClassItem()
        if k1 == 0 {
            return
        }

        lo = escCp
        set = escSet
        Skip()
        if at >= n {
            Fail(0, classOpen[classOpen.Count - 1])
            return
        }

        if p[at] != 45 || PeekSpace() == 93 || PeekSpace() == 45 {
            if k1 == 3 {
                Fail(0, first)
                return
            }

            if k1 == 2 {
                AddItem(set, -1, first)
            } else {
                AddItem([lo, lo], -1, first)
            }

            return
        }

        at = at + 1
        Skip()
        if at >= n {
            Fail(0, classOpen[classOpen.Count - 1])
            return
        }

        second = at
        k2 = ClassItem()
        if k2 == 0 {
            return
        }

        if k1 != 1 {
            Fail(0, first)
            return
        }

        if k2 != 1 {
            Fail(0, second)
            return
        }

        hi = escCp
        if hi < lo {
            Fail(0, first)
            return
        }

        AddItem([lo, hi], -1, first)
    }

    // A backreference inside a class is `Unsupported` at its `\`, as Rust's parse reads one there.
    internal int ClassItem() {
        start = at
        if p[at] == 92 {
            r = Escape()
            if r == 4 {
                Fail(1, escStart)
                return 0
            }

            if r == 1 && (mode & 64) == 0 && escCp > 127 {
                Later(start)
            }

            return r
        }

        escCp = RegexDecode(p, at)
        at = at + RegexLength(p[at])
        if (mode & 64) == 0 && escCp > 127 {
            Later(start)
        }

        return 1
    }

    // Rust's `peek_space`: the character after the one being read, past white space and one `#` under `(?x)`; -1 at the pattern's
    // end.
    internal int PeekSpace() {
        mut k = at + RegexLength(p[at])
        if (mode & 8) != 0 {
            mut comment = false
            while k < n {
                cp = RegexDecode(p, k)
                if White(cp) {
                    k = k + RegexLength(p[k])
                } else if !comment && cp == 35 {
                    comment = true
                    k = k + 1
                } else {
                    break
                }
            }
        }

        if k < n {
            return RegexDecode(p, k)
        }

        return -1
    }

    // `[:name:]` or `[:^name:]` at `[`, its set in `asciiSet`; a name Rust's crate does not know leaves the `[` a class in brackets,
    // as Rust's parse does.
    internal bool Ascii() {
        mut k = at + 2
        mut negated = false
        if k < n && p[k] == 94 {
            negated = true
            k = k + 1
        }

        nameAt = k
        while k < n && p[k] >= 97 && p[k] <= 122 {
            k = k + 1
        }

        if k == nameAt || k + 1 >= n || p[k] != 58 || p[k + 1] != 93 || at + 1 >= n || p[at + 1] != 58 {
            return false
        }

        mut set = RegexAsciiClass(text.Substring(nameAt, k - nameAt))
        if set.Count == 0 {
            return false
        }

        // Rust's `unicode_fold_and_negate`: under `(?i)` the class is folded before it is negated, so that `(?i)[[:^lower:]]`
        // takes no letter of either case.
        if (mode & 1) != 0 {
            set = Folded(set)
        }

        begin = at
        at = k + 2
        if negated {
            asciiSet = RegexNegate(set)
            Bytewise(asciiSet, begin)
        } else {
            asciiSet = set
        }

        return true
    }

    // A level of Rust's `NestLimiter` that starts at `start`, over its children, -1 for none.
    internal int NestOf(int start, List<int> children) {
        first = nestKids.Count
        mut height = 0
        for child in children {
            if child >= 0 {
                nestKids.Add(child)
                if nestHeight[child] > height {
                    height = nestHeight[child]
                }
            }
        }

        nestStart.Add(start)
        nestHeight.Add(height + 1)
        nestFirst.Add(first)
        nestCount.Add(nestKids.Count - first)
        return nestStart.Count - 1
    }

    // Rust's `NestLimiter` over the whole tree: the start of the first node, in the order it visits them, that is more than 250
    // levels deep, its `nest_limit`, or -1 where none is.
    internal int Deep(int root) {
        if root < 0 || nestHeight[root] <= 250 {
            return -1
        }

        mut node = root
        for depth in 1..<251 {
            count = nestCount[node]
            from = nestFirst[node]
            for i in 0..<count {
                child = nestKids[from + i]
                if nestHeight[child] >= 251 - depth {
                    node = child
                    break
                }
            }
        }

        return nestStart[node]
    }

    // `set` with every character that folds with one of it, by the simple case folding of G4's table, whose sets are cycles.
    internal List<int> Fold(List<int> set) {
        f = Table(3)
        count = f.Count / 2
        mut extra = List<int>()
        mut r = 0
        while r < set.Count {
            lo = set[r]
            hi = set[r + 1]
            mut a = 0
            mut b = count
            while a < b {
                m = (a + b) / 2
                if f[2 * m] < lo {
                    a = m + 1
                } else {
                    b = m
                }
            }

            while a < count && f[2 * a] <= hi {
                mut c = f[2 * a + 1]
                mut steps = 0
                while c != f[2 * a] && steps < 8 {
                    extra.Add(c)
                    c = RegexNextFold(f, count, c)
                    steps = steps + 1
                }

                a = a + 1
            }

            r = r + 2
        }

        if extra.Count == 0 {
            return set
        }

        extra.Sort()
        mut add = List<int>()
        for c in extra {
            k = add.Count
            if k > 0 && c <= add[k - 1] + 1 {
                if c > add[k - 1] {
                    add[k - 1] = c
                }
            } else {
                add.Add(c)
                add.Add(c)
            }
        }

        return RegexUnion(set, add)
    }

    // The states of the node, as `Emit` builds them, the count capped at 2^40 so that no product of counts overflows.
    internal long Size(int node) {
        k = kind[node]
        if k == 0 {
            return 0
        }

        if k <= 3 || k == 9 {
            return 1
        }

        if k == 4 || k == 10 || k == 11 {
            return RegexCap(2 + Size(nb[node]))
        }

        if k == 5 || k == 6 {
            mut long total = 0
            for i in 0..<nb[node] {
                total = RegexCap(total + Size(kids[na[node] + i]))
            }

            if k == 6 {
                total = RegexCap(total + 2 * long(nb[node] - 1))
            }

            return total
        }

        child = Size(na[node])
        min = long(nb[node])
        if nc[node] < 0 {
            if min == 0 {
                return RegexCap(child + 2)
            }

            return RegexCap(RegexTimes(min, child) + 1)
        }

        return RegexCap(RegexTimes(min, child) + RegexTimes(long(nc[node]) - min, child + 1))
    }

    internal int State(int op, int x, int y) {
        ops.Add(op)
        xs.Add(x)
        ys.Add(y)
        return ops.Count - 1
    }

    // The states of a node, as Thompson's construction builds them and Rust's `regex-automata` compiles a pattern: an alternation
    // a split before each but the last, which jumps past the rest; a look-around and an atomic group a state before their content,
    // which names the state past them, and one after it; `x*` a split, `x` and a jump back; `x{n,}` n - 1 copies of `x`,
    // then `x` and a split back; `x{n,m}` n copies, then m - n of a split and `x`, each split past all of them. A greedy split tries
    // `x` first, a lazy one the way past it.
    internal void Emit(int node) {
        k = kind[node]
        if k == 0 {
            return
        }

        if k == 1 {
            State(1, na[node], 0)
            return
        }

        if k == 2 {
            State(2, na[node], nb[node])
            return
        }

        if k == 3 {
            State(6, na[node], 0)
            return
        }

        if k == 9 {
            State(7, na[node], nb[node])
            return
        }

        if k == 10 || k == 11 {
            mut op = 10
            if k == 10 {
                op = 8
            }

            opened = State(op, na[node], 0)
            Emit(nb[node])
            State(op + 1, 0, 0)
            ys[opened] = ops.Count
            return
        }

        if k == 4 {
            State(5, 2 * na[node], 0)
            Emit(nb[node])
            State(5, 2 * na[node] + 1, 0)
            return
        }

        if k == 5 {
            for i in 0..<nb[node] {
                Emit(kids[na[node] + i])
            }

            return
        }

        if k == 6 {
            mut jumps = List<int>()
            count = nb[node]
            for i in 0..<count {
                if i < count - 1 {
                    split = State(3, ops.Count + 1, 0)
                    Emit(kids[na[node] + i])
                    jumps.Add(State(4, 0, 0))
                    ys[split] = ops.Count
                } else {
                    Emit(kids[na[node] + i])
                }
            }

            for j in jumps {
                xs[j] = ops.Count
            }

            return
        }

        child = na[node]
        min = nb[node]
        max = nc[node]
        greedy = k == 7
        if max < 0 {
            if min == 0 {
                split = State(3, 0, 0)
                Emit(child)
                State(4, split, 0)
                Branch(split, split + 1, ops.Count, greedy)
                return
            }

            for i in 0..<min - 1 {
                Emit(child)
            }

            body = ops.Count
            Emit(child)
            split = State(3, 0, 0)
            Branch(split, body, ops.Count, greedy)
            return
        }

        for i in 0..<min {
            Emit(child)
        }

        mut splits = List<int>()
        for i in 0..<max - min {
            splits.Add(State(3, 0, 0))
            Emit(child)
        }

        end = ops.Count
        for s in splits {
            Branch(s, s + 1, end, greedy)
        }
    }

    internal void Branch(int split, int body, int end, bool greedy) {
        if greedy {
            xs[split] = body
            ys[split] = end
        } else {
            xs[split] = end
            ys[split] = body
        }
    }
}

// `Regex.New(pattern, backtracking)` of a string the compiler did not check: the `Regex`, on the engine the flag names, or the error
// of the pattern (G2, G3). The compiler calls it with the table of G4's classes and folding it writes into the program
// (`Emitter.RegexTable`).
pub Regex | RegexError RegexNew(string pattern, byte* tables, bool backtracking) => Regex.Make(pattern, tables, backtracking)

// `Regex.New(pattern, backtracking)` of a literal the compiler checked (G3), which builds: an error stops the program, a defect of
// the compiler.
pub Regex RegexChecked(string pattern, byte* tables, bool backtracking) {
    match Regex.Make(pattern, tables, backtracking) {
        Regex r => return r
        RegexError e => throw "the pattern of a literal the compiler checked gives `{e}`"
    }
}

// A copy of the first `count` items of `a`.
List<int> RegexHead(List<int> a, int count) {
    mut out = List<int>()
    for k in 0..<count {
        out.Add(a[k])
    }

    return out
}

// A `Match` of the text `s`, which a `Regex` makes: its own name is a method there.
Match RegexFound(string s, int start, int end, List<int> slots, List<string> names) => Match.Of(s, start, end, slots, names)

// The numbers of part `which` of the compiler's table: seven counts of 32 bits, of the numbers of `\d`, `\w`, `\s`, the
// folding, the characters of a group's name, Alphabetic and the categories Nd, Nl and No, and the classes of `\p`, then those
// numbers, 32 bits each (`Emitter.RegexTable`).
List<int> RegexTablePart(long tables, int which) {
    mut out = List<int>()
    raw {
        int* t = Ptr<int>(tables)
        mut long start = 7
        mut long k = 0
        while k < long(which) {
            start = start + long(t[k])
            k = k + 1
        }

        long count = long(t[long(which)])
        mut long i = 0
        while i < count {
            out.Add(t[start + i])
            i = i + 1
        }
    }

    return out
}

// Where `spelled` first holds the byte `a`, and `b` after it where `b` is not -1; -1 where nowhere.
int RegexFind(List<int> spelled, int a, int b) {
    mut i = 0
    while i < spelled.Count {
        if spelled[i] == a && (b < 0 || i + 1 < spelled.Count && spelled[i + 1] == b) {
            return i
        }

        i = i + 1
    }

    return -1
}

// The key of a name of `\p` (G4): `sort`, then the bytes of `spelled` from `lo` to `hi` as Rust's `symbolic_name_normalize`
// gives them: a first `is` of any case dropped, ` `, `_`, `-` and every byte above ASCII dropped, ASCII's capitals made small,
// and `is` with `c` alone after it kept as `isc`.
List<int> RegexKey(int sort, List<int> spelled, int lo, int hi) {
    prefixed = hi - lo >= 2 && (spelled[lo] == 105 || spelled[lo] == 73) && (spelled[lo + 1] == 115 || spelled[lo + 1] == 83)
    mut out = [sort]
    mut i = lo
    if prefixed {
        i = lo + 2
    }

    while i < hi {
        b = spelled[i]
        if b != 32 && b != 95 && b != 45 && b <= 127 {
            if b >= 65 && b <= 90 {
                out.Add(b + 32)
            } else {
                out.Add(b)
            }
        }

        i = i + 1
    }

    if prefixed && out.Count == 2 && out[1] == 99 {
        return [sort, 105, 115, 99]
    }

    return out
}

// The classes of `\p` (G4), from part 6 of the compiler's table, the bytes of `CaseTables.RegexProperties` four to each number,
// the first the lowest: the length of the keys' part as a varint, then each key, its length in one byte, its bytes, the offset of
// its first set in the sets' part as a varint and its number of sets in one byte, then the sets, each its number of ranges and
// each range's gap from the last end and its length, as varints. The union of the sets of `key`, or for the name of a property its
// values' kind as `-1 - kind`, or none where the table has no such key or no classes.
List<int> RegexProperty(long tables, List<int> key) {
    mut parts = List<int>()
    mut ends = List<int>()
    raw {
        int* t = Ptr<int>(tables)
        mut long start = 7
        mut long k = 0
        while k < 6 {
            start = start + long(t[k])
            k = k + 1
        }

        if t[6] > 0 {
            byte* d = Ptr<byte>(tables + 4 * start)
            mut long at = 0
            mut long value = 0
            mut long scale = 1
            mut long b = 128
            while b >= 128 {
                b = long(d[at])
                at = at + 1
                value = value + (b & 127) * scale
                scale = scale * 128
            }

            long keysEnd = at + value
            long setsAt = keysEnd
            mut long found = -1
            mut long count = 0
            while at < keysEnd && found < 0 {
                long size = long(d[at])
                mut bool same = size == long(key.Count)
                mut long i = 0
                while same && i < size {
                    same = long(d[at + 1 + i]) == long(key[int(i)])
                    i = i + 1
                }

                at = at + 1 + size
                value = 0
                scale = 1
                b = 128
                while b >= 128 {
                    b = long(d[at])
                    at = at + 1
                    value = value + (b & 127) * scale
                    scale = scale * 128
                }

                if same {
                    found = value
                    count = long(d[at])
                }

                at = at + 1
            }

            if found >= 0 && count == 0 {
                parts.Add(-1 - int(found))
            } else if found >= 0 {
                at = setsAt + found
                mut long s = 0
                while s < count {
                    value = 0
                    scale = 1
                    b = 128
                    while b >= 128 {
                        b = long(d[at])
                        at = at + 1
                        value = value + (b & 127) * scale
                        scale = scale * 128
                    }

                    mut long r = value
                    mut long last = -1
                    while r > 0 {
                        mut long field = 0
                        while field < 2 {
                            value = 0
                            scale = 1
                            b = 128
                            while b >= 128 {
                                b = long(d[at])
                                at = at + 1
                                value = value + (b & 127) * scale
                                scale = scale * 128
                            }

                            if field == 0 {
                                last = last + 1 + value
                                parts.Add(int(last))
                            } else {
                                last = last + value
                                parts.Add(int(last))
                            }

                            field = field + 1
                        }

                        r = r - 1
                    }

                    ends.Add(parts.Count)
                    s = s + 1
                }
            }
        }
    }

    if ends.Count < 2 {
        return parts
    }

    mut out = List<int>()
    mut cursor = 0
    mut e = 0
    while e < ends.Count {
        mut one = List<int>()
        while cursor < ends[e] {
            one.Add(parts[cursor])
            cursor = cursor + 1
        }

        out = RegexUnion(out, one)
        e = e + 1
    }

    return out
}

// The code point of the UTF-8 sequence at `at`, which a string holds whole.
int RegexDecode(Bytes b, int at) {
    c = int(b[at])
    if c < 128 {
        return c
    }

    if c < 224 {
        return ((c & 31) << 6) | (int(b[at + 1]) & 63)
    }

    if c < 240 {
        return ((c & 15) << 12) | ((int(b[at + 1]) & 63) << 6) | (int(b[at + 2]) & 63)
    }

    return ((c & 7) << 18) | ((int(b[at + 1]) & 63) << 12) | ((int(b[at + 2]) & 63) << 6) | (int(b[at + 3]) & 63)
}

// The pieces of a replacement as Rust's `replace_all` reads it (G5), three numbers each: 0, the start and the length of a text copied
// as it is, or 1, the number of a group and 0. `$$` is a `$`; `$` and the longest run of letters, digits and `_` after it, or `${`,
// the text to the next `}` and that brace, name a group (`RegexGroupOf`); a `$` that names none, at the end, before a byte of no name,
// or before a `{` without its `}`, is a text; and a name no group has gives no piece.
List<int> RegexReplacement(string replacement, List<string> names) {
    r = replacement.Bytes
    n = r.Count
    mut pieces = List<int>()
    mut text = 0 // where the text not yet a piece starts
    mut i = 0
    while i < n {
        if r[i] != 36 {
            i = i + 1
            continue
        }

        RegexText(mut pieces, text, i - text)
        if i + 1 < n && r[i + 1] == 36 {
            RegexText(mut pieces, i, 1)
            i = i + 2
            text = i
            continue
        }

        mut start = i + 1
        mut end = start
        mut brace = 0
        if start < n && r[start] == 123 {
            start = start + 1
            end = start
            while end < n && r[end] != 125 {
                end = end + 1
            }

            brace = 1
        } else {
            while end < n && RegexNameByte(r[end]) {
                end = end + 1
            }
        }

        if end >= n && brace == 1 || end == start && brace == 0 {
            text = i // the `$` names no group: it is a text, and so is what follows it
            i = i + 1
            continue
        }

        g = RegexGroupOf(replacement, start, end, names)
        if g >= 0 {
            pieces.Add(1)
            pieces.Add(g)
            pieces.Add(0)
        }

        i = end + brace
        text = i
    }

    RegexText(mut pieces, text, n - text)
    return pieces
}

// A text of `length` bytes of the replacement from `start`, as a piece of `RegexReplacement`; none where it is empty.
void RegexText(mut List<int> pieces, int start, int length) {
    if length > 0 {
        pieces.Add(0)
        pieces.Add(start)
        pieces.Add(length)
    }
}

// Whether `c` is a byte of a group's name after a `$`: an ASCII letter, a digit or `_`, as Rust's `replace_all` reads one (G5).
bool RegexNameByte(byte c) {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95
}

// The number of the group that the bytes of `replacement` from `start` to `end` name, as Rust's `replace_all` reads them (G5):
// digits, with a `+` before them or not, a number, as Rust's `usize` parse reads one, and any other text a name, which `names`
// holds at the group's number; -1 where no group has the number or the name, the empty name among them.
int RegexGroupOf(string replacement, int start, int end, List<string> names) {
    r = replacement.Bytes
    mut d = start
    if d < end && r[d] == 43 {
        d = d + 1
    }

    if d < end {
        mut number = 0L
        mut k = d
        while k < end && r[k] >= 48 && r[k] <= 57 {
            if number < 1000000000L {
                number = number * 10L + long(r[k] - 48)
            }

            k = k + 1
        }

        if k == end {
            if number < long(names.Count) {
                return int(number)
            }

            return -1
        }
    }

    name = replacement.Substring(start, end - start)
    for g in 1..<names.Count {
        if names[g] != "" && names[g] == name {
            return g
        }
    }

    return -1
}

// A part of the result of `Replace`, `length` bytes from `start` of `s` (`from` 0) or of the replacement (1), none where it is empty;
// its length.
long RegexPart(mut List<int> parts, int from, int start, int length) {
    if length > 0 {
        parts.Add(from)
        parts.Add(start)
        parts.Add(length)
    }

    return long(length)
}

// The string the `parts` of `s` and of `replacement` give, `total` bytes, written once into its block (R15): each part is cut at
// a match's or a group's bounds, which fall between two characters, or at a `$`, a `{` or a `}` of the replacement, so that the
// bytes are UTF-8 and need no second check.
string RegexJoined(string s, string replacement, List<int> parts, long total) {
    if total == 0L {
        return ""
    }

    mut made = ""
    raw {
        byte* q = string.Allocate(total)
        byte* text = s.Pointer
        byte* given = replacement.Pointer
        mut long at = 0
        mut int p = 0
        while p < parts.Count {
            mut byte* source = text
            if parts[p] == 1 {
                source = given
            }

            Copy(q + at, source + long(parts[p + 1]), long(parts[p + 2]))
            at = at + long(parts[p + 2])
            p = p + 3
        }

        made = string.FromRaw(q, total)
    }

    return made
}

// The length of the UTF-8 sequence its first byte starts.
int RegexLength(byte c) {
    if c < 128 {
        return 1
    }

    if c < 224 {
        return 2
    }

    if c < 240 {
        return 3
    }

    return 4
}

int RegexHex(byte c) {
    if c >= 48 && c <= 57 {
        return int(c) - 48
    }

    if c >= 65 && c <= 70 {
        return int(c) - 55
    }

    if c >= 97 && c <= 102 {
        return int(c) - 87
    }

    return -1
}

// A character of the name of a special word boundary, `\b{start}`, as Rust's parse reads one: a letter or `-`.
bool RegexBoundaryLetter(byte b) {
    return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 45
}

// Whether the characters of `letters` are those of `word`.
bool RegexSame(List<int> letters, string word) {
    w = word.Bytes
    if letters.Count != w.Count {
        return false
    }

    for i in 0..<w.Count {
        if letters[i] != int(w[i]) {
            return false
        }
    }

    return true
}

// Whether `c` is in the `count` ranges from `start` of `ranges`, by a binary search.
bool RegexIn(List<int> ranges, int start, int count, int c) {
    mut lo = 0
    mut hi = count
    while lo < hi {
        m = (lo + hi) / 2
        if c < ranges[start + 2 * m] {
            hi = m
        } else if c > ranges[start + 2 * m + 1] {
            lo = m + 1
        } else {
            return true
        }
    }

    return false
}

// The code point after `c` in its set of the folding.
int RegexNextFold(List<int> f, int count, int c) {
    mut lo = 0
    mut hi = count
    while lo < hi {
        m = (lo + hi) / 2
        if f[2 * m] < c {
            lo = m + 1
        } else if f[2 * m] > c {
            hi = m
        } else {
            return f[2 * m + 1]
        }
    }

    return c
}

// The union of two sets of ranges, each in order with no two ranges that touch.
List<int> RegexUnion(List<int> a, List<int> b) {
    mut out = List<int>()
    mut i = 0
    mut j = 0
    while i < a.Count || j < b.Count {
        mut lo = 0
        mut hi = 0
        if j >= b.Count || i < a.Count && a[i] <= b[j] {
            lo = a[i]
            hi = a[i + 1]
            i = i + 2
        } else {
            lo = b[j]
            hi = b[j + 1]
            j = j + 2
        }

        k = out.Count
        if k > 0 && lo <= out[k - 1] + 1 {
            if hi > out[k - 1] {
                out[k - 1] = hi
            }
        } else {
            out.Add(lo)
            out.Add(hi)
        }
    }

    return out
}

List<int> RegexIntersect(List<int> a, List<int> b) {
    mut out = List<int>()
    mut i = 0
    mut j = 0
    while i < a.Count && j < b.Count {
        mut lo = a[i]
        if b[j] > lo {
            lo = b[j]
        }

        mut hi = a[i + 1]
        if b[j + 1] < hi {
            hi = b[j + 1]
        }

        if lo <= hi {
            out.Add(lo)
            out.Add(hi)
        }

        if a[i + 1] < b[j + 1] {
            i = i + 2
        } else {
            j = j + 2
        }
    }

    return out
}

// Every code point the set does not hold.
List<int> RegexNegate(List<int> a) {
    mut out = List<int>()
    mut next = 0
    mut i = 0
    while i < a.Count {
        if a[i] > next {
            out.Add(next)
            out.Add(a[i] - 1)
        }

        next = a[i + 1] + 1
        i = i + 2
    }

    if next <= 1114111 {
        out.Add(next)
        out.Add(1114111)
    }

    return out
}

// The ASCII class of the name, as Rust's crate gives it; empty for a name it does not know.
List<int> RegexAsciiClass(string name) {
    if name == "alnum" {
        return [48, 57, 65, 90, 97, 122]
    }

    if name == "alpha" {
        return [65, 90, 97, 122]
    }

    if name == "ascii" {
        return [0, 127]
    }

    if name == "blank" {
        return [9, 9, 32, 32]
    }

    if name == "cntrl" {
        return [0, 31, 127, 127]
    }

    if name == "digit" {
        return [48, 57]
    }

    if name == "graph" {
        return [33, 126]
    }

    if name == "lower" {
        return [97, 122]
    }

    if name == "print" {
        return [32, 126]
    }

    if name == "punct" {
        return [33, 47, 58, 64, 91, 96, 123, 126]
    }

    if name == "space" {
        return [9, 13, 32, 32]
    }

    if name == "upper" {
        return [65, 90]
    }

    if name == "word" {
        return [48, 57, 65, 90, 95, 95, 97, 122]
    }

    if name == "xdigit" {
        return [48, 57, 65, 70, 97, 102]
    }

    return List<int>()
}

long RegexCap(long x) {
    if x > 1099511627776 {
        return 1099511627776
    }

    return x
}

long RegexTimes(long a, long b) {
    if b != 0 && a > 1099511627776 / b {
        return 1099511627776
    }

    return a * b
}
