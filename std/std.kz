        shifts[11] = 23
        shifts[12] = 6
        shifts[13] = 10
        shifts[14] = 15
        shifts[15] = 21
    }
}

// One block of 64 bytes at `p` through the 64 steps of MD5 into the words at `s` (RFC 1321, 3.4), each
// word of the block read with its lowest byte first.
void Md5Block(byte* s, byte* p) {
    raw {
        uint* words = Ptr<uint>(s)
        uint* t = Ptr<uint>(s + 88)
        uint* shifts = Ptr<uint>(s + 344)
        mut uint a = words[0]
        mut uint b = words[1]
        mut uint c = words[2]
        mut uint d = words[3]
        mut int i = 0
        while i < 64 {
            mut uint f = 0
            mut int g = 0
            if i < 16 {
                f = (b & c) | (~b & d)
                g = i
            } else if i < 32 {
                f = (d & b) | (~d & c)
                g = (5 * i + 1) % 16
            } else if i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } else {
                f = c ^ (b | ~d)
                g = 7 * i % 16
            }

            uint m = uint(p[4 * g]) | uint(p[4 * g + 1]) << 8 | uint(p[4 * g + 2]) << 16 | uint(p[4 * g + 3]) << 24
            uint sum = f +% a +% t[i] +% m
            int r = int(shifts[i / 16 * 4 + i % 4])
            a = d
            d = c
            c = b
            b = b +% (sum << r | sum >> (32 - r))
            i = i + 1
        }

        words[0] = words[0] +% a
        words[1] = words[1] +% b
        words[2] = words[2] +% c
        words[3] = words[3] +% d
    }
}

// The digest of the message of MD5's state at `s`, its four words with the lowest byte of each first,
// written at `out`; the state is then a new hasher's.
void Md5Close(byte* s, byte* out) {
    HashPad(s, true)
    raw {
        uint* words = Ptr<uint>(s)
        mut int i = 0
        while i < 4 {
            uint word = words[i]
            out[4 * i] = byte(word & 255)
            out[4 * i + 1] = byte(word >> 8 & 255)
            out[4 * i + 2] = byte(word >> 16 & 255)
            out[4 * i + 3] = byte(word >> 24)
            i = i + 1
        }
    }

    Md5Start(s)
}

// One block of 64 bytes at `p` through the rounds of MD5 or of SHA-256 into the state at `s`.
void HashBlock(byte* s, byte* p, bool md5) {
    if md5 {
        Md5Block(s, p)
    } else {
        Sha256Block(s, p)
    }
}

// The `n` bytes at `p` added to the message of the state of MD5 or of SHA-256 at `s`: each block of 64
// bytes the message fills goes through the hash's rounds, and the bytes after the last whole block wait
// in the state's block.
void HashFeed(byte* s, byte* p, long n, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        *Ptr<long>(s + counted) = total + n
        mut long pending = total % 64
        mut long at = 0
        if pending > 0 {
            while pending < 64 && at < n {
                s[buffer + pending] = p[at]
                pending = pending + 1
                at = at + 1
            }

            if pending == 64 {
                HashBlock(s, s + buffer, md5)
                pending = 0
            }
        }

        while n - at >= 64 {
            HashBlock(s, p + at, md5)
            at = at + 64
        }

        while at < n {
            s[buffer + pending] = p[at]
            pending = pending + 1
            at = at + 1
        }
    }
}

// The padding of MD5 (RFC 1321, 3.1 and 3.2) or of SHA-256 (FIPS 180-4, 5.1.1) put through the state at
// `s`: the byte 0x80, zeros up to 8 bytes before the end of a block, and the count of bits of the
// message, its lowest byte first for MD5 and its highest first for SHA-256.
void HashPad(byte* s, bool md5) {
    mut long counted = 32
    if md5 {
        counted = 16
    }

    long buffer = counted + 8
    raw {
        long total = *Ptr<long>(s + counted)
        ulong bits = ulong(total) << 3
        mut long pending = total % 64
        s[buffer + pending] = 128
        pending = pending + 1
        if pending > 56 {
            while pending < 64 {
                s[buffer + pending] = 0
                pending = pending + 1
            }

            HashBlock(s, s + buffer, md5)
            pending = 0
        }

        while pending < 56 {
            s[buffer + pending] = 0
            pending = pending + 1
        }

        mut int i = 0
        while i < 8 {
            mut int shift = 56 - 8 * i
            if md5 {
                shift = 8 * i
            }

            s[buffer + 56 + long(i)] = byte(bits >> shift & 255UL)
            i = i + 1
        }

        HashBlock(s, s + buffer, md5)
    }
}

// A new hasher of SHA-256 (H3): the block of its state; null, with `asked` set, where the system refuses.
pub byte* Sha256New(mut long asked) {
    byte* block = ByteBlock(616, mut asked)
    if block != null {
        Sha256Start(block + 16)
    }

    return block
}

// The bytes of the list `message` added to the hasher of SHA-256 whose block, which no other value holds,
// is `block`.
pub void Sha256Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), false)
    }
}

// The digest of the hasher of SHA-256 whose block, which no other value holds, is `block`: a new list of
// 32 bytes, after which the hasher starts over; null, with `asked` set and the hasher as it was, where the
// system refuses.
pub byte* Sha256Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        Sha256Close(block + 16, digest + 16)
    }

    return digest
}

// SHA-256 of the bytes of the list `message` (H1): a new list of 32 bytes, made on a state of its own, which
// it frees; null, with `asked` set, where the system refuses.
pub byte* Sha256Hash(byte* message, mut long asked) {
    byte* block = Sha256New(mut asked)
    if block == null {
        return null
    }

    Sha256Update(block, message)
    byte* digest = Sha256Finish(block, mut asked)
    Free(block, 632)
    return digest
}

// A new hasher of MD5 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Md5New(mut long asked) {
    byte* block = ByteBlock(408, mut asked)
    if block != null {
        Md5Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for MD5.
pub void Md5Update(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 16, ListItems(message), long(ListCount(message)), true)
    }
}

// As `Sha256Finish`, for MD5: a new list of 16 bytes.
pub byte* Md5Finish(byte* block, mut long asked) {
    byte* digest = ByteBlock(16, mut asked)
    if digest != null {
        Md5Close(block + 16, digest + 16)
    }

    return digest
}

// MD5 of the bytes of the list `message` (H1), as `Sha256Hash` gives SHA-256: a new list of 16 bytes.
pub byte* Md5Hash(byte* message, mut long asked) {
    byte* block = Md5New(mut asked)
    if block == null {
        return null
    }

    Md5Update(block, message)
    byte* digest = Md5Finish(block, mut asked)
    Free(block, 424)
    return digest
}

// CRC-32/ISO-HDLC's state at `s`, 1028 bytes: the register (0) and the remainders of the 256 bytes under
// the reflected polynomial 0xEDB88320 (4), as zlib's `crc32` reads a byte at a time; the register starts
// at all ones, and the CRC is the register with every bit flipped.
void Crc32Start(byte* s) {
    raw {
        *Ptr<uint>(s) = 0xffffffff
        uint* table = Ptr<uint>(s + 4)
        mut int i = 0
        while i < 256 {
            mut uint c = uint(i)
            mut int k = 0
            while k < 8 {
                if (c & 1) != 0 {
                    c = 0xedb88320 ^ c >> 1
                } else {
                    c = c >> 1
                }

                k = k + 1
            }

            table[i] = c
            i = i + 1
        }
    }
}

// The `n` bytes at `p` through the register of the state at `s`.
void Crc32Feed(byte* s, byte* p, long n) {
    raw {
        uint* table = Ptr<uint>(s + 4)
        mut uint c = *Ptr<uint>(s)
        mut long i = 0
        while i < n {
            c = table[long((c ^ uint(p[i])) & 255)] ^ c >> 8
            i = i + 1
        }

        *Ptr<uint>(s) = c
    }
}

// A new hasher of CRC-32 (H3), as `Sha256New` makes one of SHA-256.
pub byte* Crc32New(mut long asked) {
    byte* block = ByteBlock(1028, mut asked)
    if block != null {
        Crc32Start(block + 16)
    }

    return block
}

// As `Sha256Update`, for CRC-32.
pub void Crc32Update(byte* block, byte* message) {
    if message != null {
        Crc32Feed(block + 16, ListItems(message), long(ListCount(message)))
    }
}

// The CRC of the hasher of CRC-32 whose block, which no other value holds, is `block`, after which the
// hasher starts over.
pub uint Crc32Finish(byte* block) {
    mut uint c = 0
    raw {
        c = *Ptr<uint>(block + 16) ^ 0xffffffff
        *Ptr<uint>(block + 16) = 0xffffffff
    }

    return c
}

// CRC-32 of the bytes of the list `message` (H1), made on a state of its own, which it frees; 0, with
// `asked` set, where the system refuses.
pub uint Crc32Hash(byte* message, mut long asked) {
    byte* block = Crc32New(mut asked)
    if block == null {
        return 0
    }

    Crc32Update(block, message)
    uint c = Crc32Finish(block)
    Free(block, 1044)
    return c
}

// HMAC-SHA256's state at `s`, 1296 bytes (RFC 2104): the key K0 (0), 64 bytes, the state of the inner
// hash, which has taken K0 ^ ipad (64), and the state of the outer hash, which `HmacClose` starts (680)
// and whose block of 64 bytes being filled, at 720, nothing reads between two calls of it.

// The state of a new hasher of HMAC-SHA256 at `s` on the `n` bytes of the key at `key`: K0 is the key,
// or SHA-256 of a key longer than a block of 64 bytes, with zeros after it to 64 bytes.
void HmacStart(byte* s, byte* key, long n) {
    raw {
        mut long i = 0
        if n > 64 {
            byte* outer = s + 680
            Sha256Start(outer)
            HashFeed(outer, key, n, false)
            Sha256Close(outer, s)
            i = 32
        } else {
            while i < n {
                s[i] = key[i]
                i = i + 1
            }
        }

        while i < 64 {
            s[i] = 0
            i = i + 1
        }
    }

    HmacKeyed(s)
}

// The inner hash of the state at `s` started over on K0 ^ ipad, K0 with every byte xored with 0x36.
void HmacKeyed(byte* s) {
    byte* pad = s + 720
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 54)
            i = i + 1
        }
    }

    Sha256Start(s + 64)
    HashFeed(s + 64, pad, 64, false)
}

// The tag of the message of the state at `s`, SHA-256 of K0 ^ opad, K0 with every byte xored with 0x5C,
// and of the inner hash's digest, written at `out`, 32 bytes; the inner hash then starts over on K0 ^ ipad,
// as `HmacKeyed` starts it.
void HmacClose(byte* s, byte* out) {
    byte* outer = s + 680
    byte* pad = s + 720
    raw {
        mut long i = 0
        while i < 64 {
            pad[i] = byte(int(s[i]) ^ 92)
            i = i + 1
        }
    }

    Sha256Start(outer)
    HashFeed(outer, pad, 64, false)
    Sha256Close(s + 64, out)
    HashFeed(outer, out, 32, false)
    Sha256Close(outer, out)
    HmacKeyed(s)
}

// A new hasher of HMAC-SHA256 on the bytes of the list `key` (H3), as `Sha256New` makes one of SHA-256; the
// null block of an empty list is a key of no bytes, of which `ListCount` gives 0 and `HmacStart` reads none.
pub byte* HmacNew(byte* key, mut long asked) {
    byte* block = ByteBlock(1296, mut asked)
    if block != null {
        HmacStart(block + 16, ListItems(key), long(ListCount(key)))
    }

    return block
}

// As `Sha256Update`, for HMAC-SHA256.
pub void HmacUpdate(byte* block, byte* message) {
    if message != null {
        HashFeed(block + 80, ListItems(message), long(ListCount(message)), false)
    }
}

// As `Sha256Finish`, for HMAC-SHA256: the tag, a new list of 32 bytes.
pub byte* HmacFinish(byte* block, mut long asked) {
    byte* digest = ByteBlock(32, mut asked)
    if digest != null {
        HmacClose(block + 16, digest + 16)
    }

    return digest
}

// HMAC-SHA256 of the bytes of the list `message` under the bytes of the list `key` (H1), as `Sha256Hash`
// gives SHA-256: a new list of 32 bytes.
pub byte* HmacSha256(byte* key, byte* message, mut long asked) {
    byte* block = HmacNew(key, mut asked)
    if block == null {
        return null
    }

    HmacUpdate(block, message)
    byte* digest = HmacFinish(block, mut asked)
    Free(block, 1312)
    return digest
}

// Whether the tag of the message `message` under the key `key` is the bytes of `tag` (H4), compared by
// `FixedTimeEqual`; false, with `asked` set, where the system refuses.
pub bool HmacVerifySha256(byte* key, byte* message, byte* tag, mut long asked) {
    byte* digest = HmacSha256(key, message, mut asked)
    if digest == null {
        return false
    }

    bool same = FixedTimeEqual(digest, tag)
    Free(digest, 48)
    return same
}

// Whether the lists of bytes `a` and `b` hold the same bytes (H4): false where their counts differ, and
// else every byte is read, and the code stops at no difference, as C#'s `FixedTimeEquals` reads them.
pub bool FixedTimeEqual(byte* a, byte* b) {
    int n = ListCount(a)
    if n != ListCount(b) {
        return false
    }

    mut int differ = 0
    raw {
        mut long i = 0
        while i < long(n) {
            differ = differ | (int(a[16 + i]) ^ int(b[16 + i]))
            i = i + 1
        }
    }

    return differ == 0
}

// The digit of `d`, 0 to 15, in lower-case hexadecimal.
byte HexDigit(int d) {
    if d < 10 {
        return byte(48 + d)
    }

    return byte(87 + d)
}

// The lower-case hexadecimal of the bytes of the list `message`, two digits for each byte, the higher half
// first (H2), as the bytes of a new string's block; null for a list without bytes, which is the empty
// string, and null with `asked` set where the system refuses or where the text would pass the largest
// `int` of bytes, as a list does past it (M9).
pub byte* HexEncode(byte* message, mut long asked) {
    long n = long(ListCount(message))
    if n == 0 {
        return null
    }

    long size = 2 * n
    if size > 2147483647 {
        asked = size
        return null
    }

    byte* text = StringBlock(size)
    if text == null {
        asked = 16 + size
        return null
    }

    raw {
        mut long i = 0
        while i < n {
            int b = int(message[16 + i])
            text[2 * i] = HexDigit(b >> 4)
            text[2 * i + 1] = HexDigit(b & 15)
            i = i + 1
        }
    }

    StringTakeOver(text, size)
    return text
}
