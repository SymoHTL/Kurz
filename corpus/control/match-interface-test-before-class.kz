// expect: error unreachable-arm at 19
// rules: C4

interface Shape {
    int Area()
}

interface Named {
    string Name()
}

class Dot : Shape, Named {
    pub int Area() => 1
    pub string Name() => "dot"
}

string Show(Named | int v) => match v {
    Shape s => "shape {s.Area()}"
    Dot d => "dot"
    Named n => "named {n.Name()}"
    int i => "int {i}"
}

print(Show(Dot()))
