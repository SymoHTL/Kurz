// expect: output
// | 2
// | true
// | invalid
// rules: D18

enum Plan { Free = 1, Pro = 2 }

print(Plan.Pro.Number)
match Plan.From(1) {
    Plan p => print(p == Plan.Free)
    Invalid => print("invalid")
}
match Plan.From(7) {
    Plan p => print(p == Plan.Free)
    Invalid => print("invalid")
}
