// expect: output
// | B { X = 1, Y = 2, Own = 2 }
// | 2
// | 4
// | 11
// | 300
// | 11
// | 11
// rules: D16

data A(int X) {
    int Own() => X + 10

    pub int Shown() => Own()
}

data B(int Y) : A {
    pub int Own = Y

    pub int Twice() => Own * 2
}

data C(int Z) : A {
    pub int Own() => Z * 100
}

b = B(1, 2)
print(b)
print(b.Own)
print(b.Twice())
print(b.Shown())
c = C(1, 3)
print(c.Own())
print(c.Shown())
A held = c
print(held.Shown())
