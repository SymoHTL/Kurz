// expect: output
// | B { X = 1, Hidden = 2, Y = 5 }
// | 5
// | 2
// | 10
// rules: D16, F9

data A(int X) {
    int Hidden = X + 1

    pub int Shown() => Hidden
}

data B(int Y) : A {
    pub int Hidden() => Y

    pub int Twice() => Hidden() * 2
}

b = B(1, 5)
print(b)
print(b.Hidden())
print(b.Shown())
print(b.Twice())
