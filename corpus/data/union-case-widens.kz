// expect: output
// | 10
// | user a
// rules: D9, O1

data User(string Name)
data Admin(int Level) : User
data NotFound

int | NotFound Find(int id) {
    if id == 1 {
        return 10
    }
    return NotFound
}

long | NotFound r = Find(1)
match r {
    long n => print(n)
    NotFound => print("none")
}
Admin | NotFound a = Admin("a", 2)
User | NotFound u = a
match u {
    User x => print("user {x.Name}")
    NotFound => print("none")
}
