// rules: H6

mut h = Sha256.New()
h.Update("ab".Bytes)
mut other = h
h.Update("c".Bytes)
other.Update("d".Bytes)
print(Hex.Encode(h.Finish()))
print(Hex.Encode(other.Finish()))
print(h)
c = Crc32.New()
m = Hmac.NewSha256("key".Bytes)
print("{c} {m}")
print([Md5.New()])
