// expect: error type-mismatch at 17
// rules: T19

interface Shape {
    int Area()
}

class Square(int Side) : Shape {
    pub int Area() => Side * Side
}

int AreaOf<T: Shape>(T item) => item.Area()

int Measure<T>(List<T> items) {
    print(T.Kind)
    List<T> xs = items
    return AreaOf(xs[0])
}

print(Measure([Square(3)]))
