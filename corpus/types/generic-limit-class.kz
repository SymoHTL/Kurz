// expect: output
// | woof
// | quiet
// | woof
// rules: T19

class Animal {
    pub virtual string Sound() => "quiet"
}

class Dog : Animal {
    pub override string Sound() => "woof"
}

string Speak<T: Animal>(T a) => a.Sound()

Animal pet = Dog()
print(Speak(Dog()))
print(Speak(Animal()))
print(Speak(pet))
