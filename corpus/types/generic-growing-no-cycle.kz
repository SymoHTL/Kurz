// expect: output
// | 1
// | done
// rules: T34

void Same<T>(T x, int n) {
    if n > 0 {
        Same(x, n - 1)
    }
}

void Swap<A, B>(A a, B b, int n) {
    if n > 0 {
        Swap(b, a, n - 1)
    }
}

void Widen<T>(T x, int n) {
    if n > 0 {
        T | string y = x
        Widen(y, n - 1)
    }
}

void Down<T>(T x, int n) {
    if n > 0 {
        Up([x], n - 1)
    }
}

void Up<U>(List<U> ys, int n) {
    Down(ys[0], n)
}

List<T> Wrap<T>(T x) => [x]

Same(1, 3)
Swap(1, "a", 3)
Widen(1, 3)
Down(1, 3)
print(Wrap(Wrap(1)).Count)
print("done")
