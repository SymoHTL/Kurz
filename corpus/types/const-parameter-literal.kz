// expect: output
// | 128
// | true
// | x
// | 4
// | -3
// | 7
// rules: T35

int Scaled<const int N>(int x) => x * N
bool Flag<const bool B>() => B
char Mark<const char C>() => C

void Show<const int N = 4>() {
    print("{N}")
}

void Pass<const int L>() {
    Show<L>()
}

print(Scaled<64>(2))
print(Flag<true>())
print(Mark<'x'>())
Show()
Show<-3>()
Pass<7>()
