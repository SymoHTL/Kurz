// expect: error type-mismatch at 18
// rules: T19

interface Shape {
    int Area()
}

class Square(int Side) : Shape {
    pub int Area() => Side * Side
}

int AreaOf<T: Shape>(T item) => item.Area()

data Box<T>(T Item)

int Measure<T>(Box<T> b) {
    print(T.Kind)
    return AreaOf(b.Item)
}

print(Measure(Box(Square(3))))
