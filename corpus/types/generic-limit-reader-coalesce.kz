// expect: error type-mismatch at 16
// rules: T19

interface Shape {
    int Area()
}

class Square(int Side) : Shape {
    pub int Area() => Side * Side
}

int AreaOf<T: Shape>(T item) => item.Area()

int Measure<T>(T? item, T other) {
    print(T.Kind)
    return AreaOf(item ?? other)
}

print(Measure(null, Square(2)))
