// expect: output
// | 3
// | 0
// allow: raw
// rules: R11

mut long n = 3
mut long steps = 0
raw {
    asm("2:", "inc {s}", "dec {n}", "jnz 2b", n = inout(reg) n, s = inout(reg) steps)
}
print(steps)
print(n)
// a local label, `2:` with `2b`, takes the place of a label by name, which a copy of the `asm` LLVM makes would define a second time (R11)
