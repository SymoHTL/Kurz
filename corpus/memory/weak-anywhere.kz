// expect: output
// | Ann
// | gone
// | Ann
// rules: R3

class Owner(string Name)

weak Owner? Remember(weak Owner? r) {
    return r
}

string NameOf(weak Owner? r) {
    return r?.Name ?? "gone"
}

o = Owner("Ann")
weak Owner? a = Remember(o)
print(NameOf(a))
weak Owner? b = Remember(Owner("Bob"))
print(NameOf(b))
mut keepers = Map<string, weak Owner?>()
keepers["ann"] = o
print(keepers["ann"]?.Name ?? "gone")
