// expect: output
// | [1, 2, 3]
// | 2
// | 3
// | [[1], [2, 3]]
// | 0
// | [1, 2]
// | 2
// rules: M11, L4

int Sum(List<int> numbers) {
    mut total = 0
    for x in numbers {
        total = total + x
    }

    return total
}

List<int> xs = [1, 2, 3]
print(xs)
ys = [4, 5]
print(ys.Count)
print(Sum([1, 2]))
nested = [[1], [2, 3]]
print(nested)
List<string> none = []
print(none.Count)
lines = [
    1,
    2,
]
print(lines)
List<int | string> mixed = [1, "a"]
print(mixed.Count)
