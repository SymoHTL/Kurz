// expect: output
// | [1, 2]
// | [2, 3]
// | [4]
// | [5, 6]
// | [7]
// rules: M11

List<long> Made() {
    return [1, 2]
}

List<long>? Missing(bool b) => null

List<long> Arm(int x) {
    return match x {
        1 => [8]
        else => [5, 6]
    }
}

print(Made())
mut List<long> xs = [0]
xs = [2, 3]
print(xs)
ys = Missing(true) ?? [4]
List<long> zs = ys
print(zs)
print(Arm(2))
(int) => List<long> f = n => [7]
print(f(1))
