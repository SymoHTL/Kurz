// expect: output
// | [1]
// | [2]
// | [2]
// | [2, 3]
// | [7]
// | [2]
// | []
// rules: M11, T27

List<T> Pair<T>(T a, List<T> b) => b
List<T> Pick<T>(List<T> a, List<T> b) => b

r1 = Pair(1L, [1])
List<long> y1 = r1
print(y1)
r2 = Pair(1, [2L])
List<long> y2 = r2
print(y2)
r3 = Pick([1], [2L])
List<long> y3 = r3
print(y3)
r4 = Pair(1, [2, 3])
List<int> y4 = r4
print(y4)
List<long> xs = [1]
r5 = Pick(xs, [7])
List<long> y5 = r5
print(y5)
byte small = 1
r6 = Pair(small, [2])
List<byte> y6 = r6
print(y6)
r7 = Pair(1L, [])
List<long> y7 = r7
print(y7)
