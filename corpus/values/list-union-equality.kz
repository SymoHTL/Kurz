// expect: output
// | true
// | false
// rules: M9, D3

// two lists of union items compare by their counts and their items, each pair by its case, then its value (M9)
mut xs = List<int | string>()
xs.Add(1)
xs.Add("a")
mut ys = List<int | string>()
ys.Add(1)
ys.Add("a")
mut zs = List<int | string>()
zs.Add(1)
zs.Add(1)
print(xs == ys)
print(xs == zs)
