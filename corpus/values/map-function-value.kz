// expect: output
// | 10
// | true
// rules: M9, N1

// a map's value of a function type is read as that type's nullable form (M9, N1): the function where the key has an entry, `null`
// where it has none
mut ops = Map<string, (int) => int>()
ops["double"] = x => x * 2
f = ops["double"]
if f != null {
    print(f(5))
}
print(ops["none"] == null)
