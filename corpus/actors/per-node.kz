// expect: output
// | 6
// rules: U51

actor Counter per node {
    mut int count = 0

    pub void Add(int n) {
        count = count + n
    }

    pub int Get() => count
}

void AddTwo() {
    send Counter.Add(2)
}

actor Worker {
    pub void Work() {
        Counter.Add(3)
    }
}

send Counter.Add(1)
AddTwo()
w = spawn Worker()
w.Work()
print(Counter.Get())
