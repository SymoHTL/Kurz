// expect: output
// | first 1
// | 1
// threads: 1
// rules: U28, U31, U35

// `Worker`'s `Fail` runs before `Boss` takes the call the top-level code makes after `Go`, as one thread runs the ready actors
// first in, first out (U35)

actor Worker {
    pub void Fail() {
        throw "worker fails"
    }
}

actor Boss {
    mut int crashes = 0

    pub void Go() {
        name = "first"
        w = spawn Worker() on crash (c) {
            crashes = crashes + 1
            print("{name} {crashes}")
            stop
        }

        send w.Fail()
    }

    pub int Crashes() => crashes
}

b = spawn Boss()
b.Go()
print(b.Crashes())
