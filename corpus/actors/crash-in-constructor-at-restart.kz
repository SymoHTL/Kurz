// expect: output
// | 1
// | 3
// rules: U22

actor Tally {
    mut int count = 0

    pub int Next() {
        count = count + 1
        return count
    }
}

int Checked(int n) {
    if n == 2 {
        throw "second start"
    }

    return n
}

actor Worker(Tally T) {
    mut int start = Checked(T.Next())

    pub void Fail() {
        throw "fail"
    }

    pub int Start() => start
}

t = spawn Tally()
w = spawn Worker(t)
print(w.Start())
send w.Fail()
print(w.Start())
