// expect: output
// | escalating
// | 0
// rules: U21, U22, U25, U29

// `Worker`'s `Fail` runs before `Boss` takes the call the top-level code makes after `Go`, in the order the build's run queue
// holds them, which no rule of chapter 19 fixes

actor Worker {
    pub void Fail() {
        throw "worker fails"
    }
}

actor Boss {
    mut int n = 0

    pub void Go() {
        n = n + 1
        w = spawn Worker() on crash (c) {
            print("escalating")
            escalate
        }

        send w.Fail()
    }

    pub int Count() => n
}

b = spawn Boss()
b.Go()
print(b.Count())
