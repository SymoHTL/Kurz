// expect: output
// | escalating
// | 0
// threads: 1
// rules: U21, U22, U25, U29, U35

// `Worker`'s `Fail` runs before `Boss` takes the call the top-level code makes after `Go`, as one thread runs the ready actors
// first in, first out (U35)

actor Worker {
    pub void Fail() {
        throw "worker fails"
    }
}

actor Boss {
    mut int n = 0

    pub void Go() {
        n = n + 1
        w = spawn Worker() on crash (c) {
            print("escalating")
            escalate
        }

        send w.Fail()
    }

    pub int Count() => n
}

b = spawn Boss()
b.Go()
print(b.Count())
