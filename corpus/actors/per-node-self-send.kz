// expect: output
// | 0
// | 1
// rules: U55

actor Counter per node {
    mut int count = 0

    pub int Bump() {
        send Counter.Add(1)
        return Counter.Get()
    }

    pub void Add(int n) {
        count = count + n
    }

    pub int Get() => count
}

print(Counter.Bump())
print(Counter.Get())
