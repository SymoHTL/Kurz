// expect: throws actor-gone at 36
// | 0
// threads: 1
// rules: U21, U22, U28, U32, U35

// `Worker`'s `Fail` runs before `Boss` takes the call the top-level code makes after `Go`, as one thread runs the ready actors
// first in, first out (U35)

actor Worker {
    pub void Fail() {
        throw "worker fails"
    }

    pub int Ping() => 1
}

actor Boss {
    mut int count = 0

    pub Worker Go() {
        count = count + 1
        kid = spawn Worker() on crash (c) {
            throw "block fails"
        }

        send kid.Fail()
        return kid
    }

    pub int Count() => count
}

b = spawn Boss()
w = b.Go()
print(b.Count())
print(w.Ping())
