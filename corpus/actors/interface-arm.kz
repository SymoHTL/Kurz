// expect: output
// | cache 3
// | store 7
// | int 3
// rules: U1

// an arm of the actor's type in a `match` over the interface takes the values that hold its references, as a class's arm takes its instances
interface Store {
    long Get(string key)
}

actor Cache : Store {
    pub long Get(string key) => key.Bytes.Count
}

class Fixed : Store {
    pub long Get(string key) => 7
}

string Kind(Store | int s) => match s {
    Cache c => "cache {c.Get("abc")}"
    Store o => "store {o.Get("a")}"
    int n => "int {n}"
}

a = spawn Cache()
print(Kind(a))
print(Kind(Fixed()))
print(Kind(3))
