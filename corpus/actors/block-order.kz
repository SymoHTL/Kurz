// expect: output
// | 1
// | go ends
// | first's block
// | queued
// | 2
// threads: 1
// rules: U28, U35

// `first`'s `Fail` runs before `Other` answers `Go`'s call, so that its block stands ahead of `Queued` in `Boss`'s inbox, as one
// thread runs the ready actors first in, first out (U35)

actor Other {
    pub int Ping() => 1
}

actor Worker {
    pub void Fail() {
        throw "worker fails"
    }
}

actor Boss {
    pub void Go(Other other) {
        first = spawn Worker() on crash (c) {
            print("first's block")
            stop
        }

        send this.Queued()
        send first.Fail()
        print(other.Ping())
        print("go ends")
    }

    pub void Queued() {
        print("queued")
    }

    pub int Ping() => 2
}

o = spawn Other()
b = spawn Boss()
b.Go(o)
print(b.Ping())
