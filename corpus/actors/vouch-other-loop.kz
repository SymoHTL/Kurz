// expect: error call-loop at 23
// rules: U58

actor Node {
    mut List<Node> children = []

    pub void Add(Node child) {
        children.Add(child)
    }

    pub int Size() {
        mut n = 1
        for c in children {
            n = n + vouch c.Size()
        }

        return n
    }

    pub int Depth() {
        mut most = 0
        for c in children {
            d = c.Depth()
            if d > most {
                most = d
            }
        }

        return most + 1
    }
}

root = spawn Node()
leaf = spawn Node()
root.Add(leaf)
print(root.Size() + root.Depth())
