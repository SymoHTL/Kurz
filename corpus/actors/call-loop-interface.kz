// expect: error call-loop at 9
// rules: U56

interface Getter {
    int Get()
}

class Via(Right Peer) : Getter {
    pub int Get() => Peer.Value()
}

int Read(Getter g) => g.Get()

actor Left {
    pub int Ask(Right other) => Read(Via(other)) + 1

    pub int Value() => 1
}

actor Right {
    pub int Ask(Left other) => other.Value() + 2

    pub int Value() => 2
}

l = spawn Left()
r = spawn Right()
print(l.Ask(r))
print(r.Ask(l))
