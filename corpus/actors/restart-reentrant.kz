// expect: throws deadlock at 19
// | 0
// threads: 1
// rules: U22

// at its restart `A`'s constructor waits on `B.Ask`, whose call of `Peek` waits in `A`'s inbox for that constructor, so that the
// top-level code's wait on `Get` finds nothing left to run, and the error names that call of `Peek`, which closes the loop

actor B {
    mut A? a = null

    pub void Set(A x) {
        a = x
    }

    pub int Ask() {
        x = a
        if x != null {
            return vouch x.Peek()
        }

        return 0
    }
}

actor A(B Other) {
    int first = Other.Ask()
    List<int> items = [1, 2, 3]

    pub int Peek() => items.Count

    pub void Fail() {
        throw "a fails"
    }

    pub int Get() => first
}

b = spawn B()
a = spawn A(b)
print(a.Get())
b.Set(a)
send a.Fail()
print(a.Get())
