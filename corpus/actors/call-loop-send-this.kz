// expect: error call-loop at 6
// rules: U57

actor A(B Other) {
    pub void Save() {
        Other.Check(this)
    }

    pub void Tell() {
        send Other.Check(this)
    }

    pub int Load() => 7
}

actor B {
    pub void Check(A x) {
        print(x.Load())
    }
}

b = spawn B()
a = spawn A(b)
a.Save()
a.Tell()
