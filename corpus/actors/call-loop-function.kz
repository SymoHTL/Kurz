// expect: error call-loop at 4
// rules: U56

int AskOf(Right right, Left back) => right.Ask(back)

actor Left {
    pub int Ask(Right other, Left back) => AskOf(other, back) + 1

    pub int Value() => 1
}

actor Right {
    pub int Ask(Left other) => other.Value() + 2
}

l = spawn Left()
r = spawn Right()
print(l.Ask(r, l))
