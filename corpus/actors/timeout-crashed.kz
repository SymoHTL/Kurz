// expect: throws call-timeout at 21
// threads: 1
// rules: U43, U20

// the thread held for `d`, with no call and no wait
void Hold(duration d) {
    instant start = instant.Now
    while start.Elapsed < d {
    }
}

actor Worker {
    pub int Work() {
        Hold(300ms)
        throw "late"
    }
}

w = spawn Worker()
within 100ms {
    print(w.Work())
}
