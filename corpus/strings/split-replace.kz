// expect: output
// | [a, b, , c]
// | 2
// | 1
// | [a, b]
// | ba
// | abc
// | a+b+c
// rules: X5

print("a,b,,c".Split(","))
print("a, b".Split(", ").Count)
print("abc".Split("").Count)
print("a-b".Split('-'))
print("aaa".Replace("aa", "b"))
print("abc".Replace("", "x"))
print("a-b-c".Replace('-', '+'))
