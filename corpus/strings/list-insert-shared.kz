// expect: output
// | [2, 1, 2]
// | [1, 2]
// | 2
// | [1, 2]
// | [1]
// rules: X11

mut xs = [1, 2]
ys = xs
// the item is read before the list changes, and the list another value holds is copied first
xs.Insert(0, xs[1])
print(xs)
print(ys)
mut zs = ys
print(zs.RemoveAt(1))
print(ys)
print(zs)
