// expect: output
// | example.com
// | example.com
// | none
// rules: W4

void | HttpError Fill(HttpHeaders headers) {
    headers.Add("Host", "example.com")
}

h = HttpHeaders()
Fill(h) else {
    HttpError e => print(e.Detail)
}
print(h.Get("HOST") ?? "none")
print(h.Get("host") ?? "none")
print(h.Get("Accept") ?? "none")
