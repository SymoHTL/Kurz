// expect: output
// | HTTP/1.1 204 No Content||
// | HTTP/1.1 304 Not Modified|Content-Type: text/plain; charset=utf-8||
// | HTTP/1.1 205 Reset Content|Content-Length: 0||
// | HTTP/1.1 204 No Content|Content-Type: text/plain; charset=utf-8||
// | HTTP/1.1 204 No Content||
// | HTTP/1.1 304 Not Modified|Content-Length: 7||
// | HTTP/1.1 204 No Content||
// | HTTP/1.1 304 Not Modified|Content-Length: abc||
// | HTTP/1.1 304 Not Modified|Content-Length: 9||
// rules: W8

// a `204` and a `304` have no body, so neither a body nor its length nor a `Transfer-Encoding` is written; a `Content-Length` the
// handler set is dropped on a `204` and kept on a `304`, unchecked against its empty body; an empty `205` says
// `Content-Length: 0`
void | IoError Wire(HttpResponse r) {
    listener = TcpListener.Bind("127.0.0.1:0")
    client = TcpStream.Connect("127.0.0.1:{listener.Port}")
    server = listener.Accept()
    r.Write(server)
    server.ShutdownWrite()
    mut got = Bytes()
    while client.Read(mut got, 65536) > 0 {
    }

    text = string.FromUtf8(got) else {
        InvalidUtf8 => "?"
    }

    print(text.Replace("\r\n", "|"))
}

void | IoError | HttpError All() {
    Wire(HttpResponse.Empty(204))
    Wire(HttpResponse.Text(304, "dropped"))
    Wire(HttpResponse.Empty(205))
    coded = HttpResponse.Text(204, "dropped")
    coded.Headers.Set("Transfer-Encoding", "gzip")
    Wire(coded)
    sized = HttpResponse.Empty(204)
    sized.Headers.Set("Content-Length", "7")
    Wire(sized)
    cached = HttpResponse.Empty(304)
    cached.Headers.Set("Content-Length", "7")
    Wire(cached)
    // a `204` and a `304` reach none of the writer's checks of a handler's `Content-Length`: one that is no number is dropped on a
    // `204` and kept on a `304`, and on a `304` one beside a `Transfer-Encoding` is kept and the `Transfer-Encoding` dropped
    unread = HttpResponse.Empty(204)
    unread.Headers.Set("Content-Length", "abc")
    Wire(unread)
    kept = HttpResponse.Empty(304)
    kept.Headers.Set("Content-Length", "abc")
    Wire(kept)
    framed = HttpResponse.Empty(304)
    framed.Headers.Set("Transfer-Encoding", "chunked")
    framed.Headers.Set("Content-Length", "9")
    Wire(framed)
}

All() else {
    IoError e => print(e)
    HttpError e => print(e.Detail)
}
