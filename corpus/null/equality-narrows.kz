// expect: output
// | 13
// | 13
// | 13
// rules: N3, N10

string? Email(int id) {
    if id == 1 {
        return "a@example.com"
    }
    return null
}

email = Email(1)
if email == "a@example.com" {
    print(email.Bytes.Count)
}
if "a@example.com" == email {
    print(email.Bytes.Count)
}
other = Email(1)
if other != null {
    if email == other {
        print(email.Bytes.Count)
    }
}
