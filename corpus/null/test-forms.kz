// expect: output
// | Ann
// | 13
// | Ann
// rules: N3

data User(string Name, string? Email)

User? Find(int id) {
    if id == 1 {
        return User("Ann", "a@example.com")
    }
    return null
}

u = Find(1)
if u?.Email != null {
    print(u.Name)
    print(u?.Email.Bytes.Count ?? 0)
}
if !(u == null) {
    print(u.Name)
}
