// expect: output
// | [1, 3]
// | []
// | [1]
// | [1, 2]
// | [1, 3]
// | [1, 3]
// rules: N5

// a `mut` call after `?.` on a path of fields through a nullable value changes the field's place where the chain did not stop,
// through a nullable variable, a nullable field and a nullable `mut` parameter, and a value another variable holds keeps what it
// held
data Config(List<int> Items)
data Box(Config? Cfg)

Config? Find(int id) {
    if id == 1 {
        return Config([1])
    }
    return null
}

void Grow(mut Config? c) {
    c?.Items.Add(3)
}

mut cfg = Find(1)
cfg?.Items.Add(3)
print(cfg?.Items ?? [])

mut none = Find(2)
none?.Items.Add(3)
print(none?.Items ?? [])

mut kept = Find(1)
before = kept
kept?.Items.Add(2)
print(before?.Items ?? [])
print(kept?.Items ?? [])

mut b = Box(Find(1))
b.Cfg?.Items.Add(3)
print(b.Cfg?.Items ?? [])

mut p = Find(1)
Grow(mut p)
print(p?.Items ?? [])
