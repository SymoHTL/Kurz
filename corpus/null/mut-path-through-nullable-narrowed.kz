// expect: output
// | [1, 2]
// | [1]
// | [1, 2]
// | [1, 2]
// | [1, 2]
// rules: N3

// a `mut` call on a path of fields through a nullable value changes the field's place where a test's branch knows the value not
// null, through a nullable variable, a nullable field and a nullable `mut` parameter, and a value another variable holds keeps
// what it held
data Config(List<int> Items)
data Box(Config? Cfg)

Config? Find(int id) {
    if id == 1 {
        return Config([1])
    }
    return null
}

void Grow(mut Config? c) {
    if c != null {
        c.Items.Add(2)
    }
}

mut cfg = Find(1)
if cfg != null {
    cfg.Items.Add(2)
}
print(cfg?.Items ?? [])

mut kept = Find(1)
before = kept
if kept != null {
    kept.Items.Add(2)
}
print(before?.Items ?? [])
print(kept?.Items ?? [])

mut b = Box(Find(1))
if b.Cfg != null {
    b.Cfg.Items.Add(2)
}
print(b.Cfg?.Items ?? [])

mut p = Find(1)
Grow(mut p)
print(p?.Items ?? [])
