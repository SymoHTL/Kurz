// expect: output
// | the union
// | 1
// rules: O4

data NotFound

int | NotFound Find(int id) {
    if id == 1 {
        return 10
    }
    return NotFound
}

void Show(List<int> xs) {
    print("the items")
}

void Show(List<int | NotFound> xs) {
    print("the union")
}

int | NotFound Run() {
    // a list literal of calls is read as such a call: the function whose item type keeps the cases fits it exactly, and wins
    Show([Find(1)])
    return 1
}

match Run() {
    int n => print(n)
    NotFound => print("none")
}
