// expect: error ambiguous-call at 22
// rules: O4

data NotFound

int | NotFound Find(int id) {
    if id == 1 {
        return 10
    }
    return NotFound
}

void Show(long | NotFound x) {
    print("long")
}

void Show(double | NotFound x) {
    print("double")
}

// both functions keep the cases with a widening, and neither fits exactly
Show(Find(1))
