// expect: output
// | 10
// | none
// rules: O4

data NotFound

int | NotFound Find(int id) {
    if id == 1 {
        return 10
    }
    return NotFound
}

void Report(int | NotFound found) {
    match found {
        int n => print(n)
        NotFound => print("none")
    }
}

// the list's written item type is a union, which each item of the literal holds
List<int | NotFound> items = [Find(1), Find(2)]
for f in items {
    Report(f)
}
