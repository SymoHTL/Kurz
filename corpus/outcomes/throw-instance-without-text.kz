// expect: throws thrown at 27
// | 3
// | 0
// | seen note 1
// rules: O7, A4

data Missing

class Note(string Body, List<int> Marks)

int | Note | Missing Find(int id) {
    if id == 1 {
        return Note("note {id}", [id, id])
    }

    if id == 2 {
        return Missing
    }

    return id
}

int Rethrown(int id) {
    v = Find(id) else {
        Note n => {
            print("seen {n.Body}")
            throw n
        }
        Missing => 0
    }

    return v
}

print(Rethrown(3))
print(Rethrown(2))
print(Rethrown(1))
