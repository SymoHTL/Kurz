// expect: throws thrown at 24
// | 3
// | seen 3
// rules: O7

data Missing

int | List<int> | Missing Plain(int id) {
    if id == 1 {
        return [id, 7, 9]
    }

    if id == 2 {
        return Missing
    }

    return id
}

int Rethrown(int id) {
    v = Plain(id) else {
        List<int> n => {
            print("seen {n.Count}")
            throw
        }
        Missing => 0
    }

    return v
}

print(Rethrown(3))
print(Rethrown(1))
