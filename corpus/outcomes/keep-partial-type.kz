// expect: error type-mismatch at 17
// rules: O4

data NotFound
data Invalid

int | NotFound | Invalid Find(int id) {
    if id == 1 {
        return 10
    }
    if id == 2 {
        return Invalid
    }
    return NotFound
}

int | NotFound result = Find(1)
match result {
    int n => print(n)
    NotFound => print("none")
}
