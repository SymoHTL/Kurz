// expect: output
// | circle 2
// | none
// rules: F3

data Circle(int R)

string Show((bool) => Circle | void f, bool b) {
    return match f(b) {
        Circle c => "circle {c.R}"
        void => "none"
    }
}

// a lambda's bare `return` gives the `void` case of the lambda's result, as a function's does
(bool) => Circle | void find = (b) => {
    if b {
        return Circle(2)
    }

    return
}

print(Show(find, true))
print(Show(find, false))
