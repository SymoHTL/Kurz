// expect: output
// | child open Other 125
// | parent open
// allow: raw native
// threads: 1
// rules: S10

// `Opener`'s opening of a FIFO runs on the pool of threads for blocking calls (S10) and waits for a writer, and the top-level code
// forks while it waits. The child of a `fork` drops the pool, whose threads it has none of, and the opening's wait in the child
// ends with `Other` and the number 125, `ECANCELED`, so that the child's call of `Got`, queued behind it, gets its answer; a child
// that kept the wait would wait without end, the wait counted among the registrations of the poller, which raises no `deadlock`
// (U18). The parent waits for the child, then opens the FIFO to write, so that its own opening ends. The case rests on a margin of
// time that no rule fixes: the top-level code's sleep of 0.1 seconds lets the opening reach the pool before the `fork`, and a `fork`
// before it would leave the child's opening waiting for a writer to the limit of the run. S10 alone is the subject, the waits on the
// pool in the child of a `fork`; R7 and U18 it passes through
extern "C" {
    int fork()
    int waitpid(int pid, int* status, int options)
    void _exit(int code)
}

actor Opener {
    mut string got = "none"

    pub void Open() {
        f = File.Open("park-file-fork-wait") else {
            IoError e => {
                got = "open {e.Kind} {e.Code}"
                return
            }
        }

        got = "open"
        f.Close() else {
            IoError e => got = "close {e.Kind}"
        }
    }

    pub string Got() => got
}

void | IoError | ExitError Main() {
    Command.New("mkfifo").Arg("park-file-fork-wait").Status()
    o = spawn Opener()
    send o.Open()
    Environment.Sleep(100ms)
    mut int child = 0
    raw {
        child = fork()
    }

    // a fork that failed ends the case before the writer, so that no `waitpid` takes a pid below 0
    if child < 0 {
        print("fork failed")
        return
    }

    if child == 0 {
        print("child {o.Got()}")
        raw {
            _exit(0)
        }
    }

    raw {
        waitpid(child, null, 0)
    }

    w = File.Create("park-file-fork-wait")
    w.Close()
    print("parent {o.Got()}")
    File.Delete("park-file-fork-wait")
}

Main() else {
    IoError e => print(e)
    ExitError e => print(e)
}
