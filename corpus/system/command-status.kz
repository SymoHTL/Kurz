// expect: output
// | true ended
// | exit status 1: false
// | 0
// rules: S18

void | IoError | ExitError Run() {
    Command.New("true").Status()
    print("true ended")
    Command.New("false").Status()
    print("not reached")
}

Run() else {
    IoError e => print(e)
    ExitError e => {
        print(e)
        print(e.Output.Stdout.Count)
    }
}
