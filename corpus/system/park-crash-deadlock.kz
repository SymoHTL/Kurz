// expect: throws deadlock at 57
// | CalleeCrashed
// | done
// threads: 1
// rules: S10, U18, U20, U22, U42

// `Boom`'s crash takes `Outer`'s wait on its read out of the poller, which `park-read-crash.kz` holds (S10, U20). Then the restart
// of `Holder` runs its constructor, whose call of `Ask` waits on `Taker`, whose call of `Peek` waits in `Holder`'s inbox for that
// constructor, a loop that layer 3 does not see (U22), its calls' bounds standing (U42): the top-level code's wait on `Get` finds
// no actor left to run, no timer pending and nothing registered with the poller, so that it is `deadlock`, at the line of the
// call kept out (U18, U22), and not a wait in the poller without end.
// U18 alone is the subject, the end of the top-level code's wait once nothing is registered; S10, U20, U22 and U42 it passes through
actor Helper {
    pub void Poke(Napper n) {
        print(n.Boom())
    }
}

actor Napper {
    pub int Outer(Helper helper, int port) {
        stream = TcpStream.Connect("127.0.0.1:{port}") else {
            IoError e => return -1
        }

        send helper.Poke(this)
        mut buffer = Bytes()
        n = stream.Read(mut buffer, 1) else {
            IoError e => return -2
        }

        return n
    }

    pub int Boom() {
        throw "boom"
    }
}

actor Caller(Napper N, Helper H) {
    pub void Go(int port) {
        print(N.Outer(H, port))
    }

    pub string Done() => "done"
}

actor Taker {
    mut Holder? h = null

    pub void Set(Holder x) {
        h = x
    }

    pub int Ask() {
        x = h
        if x != null {
            return vouch x.Peek()
        }

        return 0
    }
}

actor Holder(Taker Other) {
    int first = Other.Ask()

    pub int Peek() => first

    pub void Fail() {
        throw "holder fails"
    }

    pub int Get() => first
}

void | IoError Main() {
    listener = TcpListener.Bind("127.0.0.1:0")
    poker = spawn Helper() on crash stop
    napper = spawn Napper()
    c = spawn Caller(napper, poker) on crash (e) {
        match e.Reason {
            RuntimeError r => print(r.Kind)
        }

        restart
    }

    send c.Go(listener.Port)
    server = listener.Accept()
    print(c.Done())
    server.Write("x".Bytes)
    t = spawn Taker()
    h = spawn Holder(t)
    t.Set(h)
    send h.Fail()
    print(h.Get())
}

Main() else {
    IoError e => print(e)
}
