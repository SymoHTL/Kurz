// expect: output
// | other (os error 9): seek-closed.txt
// rules: S5

// a seek after a `Close` gives the closed handle's error
void | IoError Closed() {
    f = File.Create("seek-closed.txt")
    File.Delete("seek-closed.txt")
    f.Close()
    f.Seek(0) else {
        IoError e => print(e)
    }
}

Closed() else {
    IoError e => print(e)
}
