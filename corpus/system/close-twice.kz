// expect: output
// | other (os error 9): twice.txt
// | 9
// rules: S5

void | IoError Twice() {
    f = File.Create("twice.txt")
    File.Delete("twice.txt")
    f.Close()
    f.Close() else {
        IoError e => {
            print(e)
            print(e.Code)
        }
    }
}

Twice() else {
    IoError e => print(e)
}
