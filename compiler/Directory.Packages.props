<Project>

  <!-- Every package at an exact version, in NuGet's bracket form: a bare version is a lower bound, which a
       re-lock could move. A change here changes every project's lock file. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[17.14.0]" />
    <PackageVersion Include="xunit" Version="[2.9.3]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[3.0.2]" />
  </ItemGroup>

</Project>
