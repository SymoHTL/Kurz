<?xml version="1.0" encoding="utf-8"?>
<!-- One package source for every restore, here and in CI: the machine's own sources are cleared, so a
     restore never reads a feed that only one machine knows. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
