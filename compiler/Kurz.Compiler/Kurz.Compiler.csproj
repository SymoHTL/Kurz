<Project Sdk="Microsoft.NET.Sdk">

  <!-- The compiler as a library: source text, lexer, parser, syntax tree, checker and code generator, with
       the runtime's source embedded. The test project and the command reference it. -->
  <PropertyGroup>
    <RootNamespace>Kurz.Compiler</RootNamespace>
    <AssemblyName>Kurz.Compiler</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurz.Compiler.Tests" />
  </ItemGroup>

  <!-- The runtime's C source travels inside the compiler: a build of a Kurz program compiles it
       beside the emitted IR with the same clang (design record, section 2). -->
  <ItemGroup>
    <EmbeddedResource Include="Runtime\kurz_rt.c" LogicalName="Kurz.Compiler.Runtime.kurz_rt.c" />
  </ItemGroup>

</Project>
