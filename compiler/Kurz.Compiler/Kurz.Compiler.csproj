<Project Sdk="Microsoft.NET.Sdk">

  <!-- The compiler as a library: source text, lexer, parser and the syntax tree. The test project
       references it. -->
  <PropertyGroup>
    <RootNamespace>Kurz.Compiler</RootNamespace>
    <AssemblyName>Kurz.Compiler</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kurz.Compiler.Tests" />
  </ItemGroup>

  <!-- The runtime's Kurz, carried in the compiler (design record, section 2, round 20): every file under
       runtime/ at the top of the repository, by its path from there, runtime/common/runtime.kz; and the
       standard library's, every file under std/, as std/std.kz (the owner, 2026-10-24, "A std/ directory now"). -->
  <ItemGroup>
    <EmbeddedResource Include="../../runtime/**/*.kz" LogicalName="runtime/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../std/**/*.kz" LogicalName="std/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
